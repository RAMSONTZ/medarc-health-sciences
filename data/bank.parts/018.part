","text":"Hyperprolactenemia can cause infertility."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a28a4b41f752","stem":"Regarding Hyperprolactenemia all are true EXCEPT","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Can be drug induced"},{"label":"B","text":"Stress can play role"},{"label":"C","text":"Can cause infertility"},{"label":"D","text":"In case of pituitary adenoma surgical removal is the best choice"},{"label":"E","text":"Dopamine agonist is the treatment of the choice"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-06bc8563e8e4","stem":"Galactorrhea (non-gestational lactation) may result from all of the following EXCEPT","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"pituitary adenoma"},{"label":"B","text":"Hypothyroidism"},{"label":"C","text":"Renal failure"},{"label":"D","text":"Intrapartum hemorrhage"},{"label":"E","text":"Bronchogenic carcinoma"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"p