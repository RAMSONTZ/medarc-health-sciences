ral","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"UTI."},{"label":"B","text":"Pre-eclamptic toxemia."},{"label":"C","text":"Nephrotic syndrome."},{"label":"D","text":"Contaminated with vaginal discharge."},{"label":"E","text":"All the above."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4e08e9575eeb","stem":"Markedly obese pregnant patients often experience all the following complications, EXCEPT","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Hypertension."},{"label":"B","text":"Diabetes mellitus."},{"label":"C","text":"Thromboembolism."},{"label":"D","text":"Fetal growth restriction."},{"label":"E","text":"Difficult intubation during anesthesia. 114 All OB-GYN MCQs Second rearranged Edition 2011"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-1191b64bb7d5","stem":"What is the mechanism of action of alpha methyl dopa?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Increase peripheral vascular resistance."},{"label":"B","text":"Increase sodium and water retention."},{"label":"C","text":"Acts centrally to decrease sympathetic activity."},{"label":"D","text":"Relaxes arterial smooth muscle."},{"label":"E","text":"Decrease the cardiac output. 115 All OB-GYN MCQs Second rearranged Edition 2011 Diabetes in Pregnancy:"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-6f355964e9e4","stem":"Gestational diabetes is associated with an increase risk of all the following, EXCEPT","type":"OSCE / Practical Station","subject":"Internal Medicine","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"Diabet","suggestedTopic":null,"options":[{"label":"A","text":"Cesarean section"},{"label":"B","text":"Shoulder dystocia"},{"label":"C","text":"Fetal macrosomia"},{"label":"D","text":"Intrauterine fetal death"},{"label":"E","text":"Intrauterine growth restriction"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Endocrinology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d15963200d36","stem":"Control of gestational diabetes is accomplished with the following, EXCEPT","type":"OSCE / Practical Station","subject":"Internal Medicine","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"Diabet","suggestedTopic":null,"options":[{"label":"A","text":"Insulin"},{"label":"B","text":"Diet"},{"label":"C","text":"Oral hypoglycemic agents"},{"label":"D","text":"Exercise"},{"label":"E","text":"Insulin and diet"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Endocrinology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-338500ee345e","stem":"Infants of mother with gestational diabetes have an increased risk of the following, EXCEPT","type":"OSCE / Practical Station","subject":"Internal Medicine","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"Diabet","suggestedTopic":null,"options":[{"label":"A","text":"Hypoglycemia"},{"label":"B","text":"Hypoinsulinemia"},{"label":"C","text":"Hypocalcemia"},{"label":"D","text":"Hyper bilirubine"},{"label":"E","text":"Polycythemia"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Endocrinology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-510c2ea10979","stem":"The best screening test for gestational diabetes","type":"OSCE / Practical Station","subject":"Internal Medicine","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"Diabet","suggestedTopic":null,"options":[{"label":"A","text":"Fasting blood sugar"},{"label":"B","text":"Random blood sugar"},{"label":"C","text":"Glucose challenge test"},{"label":"D","text":"Glucose tolerance test"},{"label":"E","text":"Blood sugar series"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Endocrinology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a68f1176aec2","stem":"Glucose tolerance test","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Is used as a screening test for diabetes."},{"label":"B","text":"Is considered to be a diagnostic test for diabetes."},{"label":"C","text":"Is performed in a non-fasting state."},{"label":"D","text":"Should be avoided during pregnancy as it needs a loading dose of glucose."},{"label":"E","text":"50 mg of glucose should be given to the patient."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f5a4f82382f5","stem":"Indications of glucose tolerance test GTT in pregnancy include all the following EXCEPT","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Previous Hx of gestational diabetes mellitus."},{"label":"B","text":"Hx of macrosomic baby. 116 All OB-GYN MCQs Second rearranged Edition 2011"},{"label":"C","text":"Glycosuria in one occasion."},{"label":"D","text":"Hx of unexplained fetal death."},{"label":"E","text":"Hx of babies with congenital sacral agenesis."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-0c2b7f896b50","stem":"Regarding Good control of diabetes in pregnancy","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"Diabet","suggestedTopic":null,"options":[{"label":"A","text":"Maintains blood sugar level between 8 and 12 mmol/L."},{"label":"B","text":"Is achieved by twice daily injection of insulin."},{"label":"C","text":"Increases the incidence of polyhydramnios."},{"label":"D","text":"Has no effect on the incidence of congenital abnormalities."},{"label":"E","text":"Is aimed of increasing fetal hyperinsulinisim."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Endocrinology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-8064a5be5d05","stem":"In the Saudi population, the most common problem during pregnancy is","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Diabetes."},{"label":"B","text":"Toxemia."},{"label":"C","text":"Heart disease."},{"label":"D","text":"UTI."},{"label":"E","text":"Iron deficiency anemia."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4144214c40bc","stem":"Maternal complications associated with polyhydramnios include","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"High blood pressure."},{"label":"B","text":"Urinary tract anomalies."},{"label":"C","text":"Diabetes."},{"label":"D","text":"Postmature pregnancy."},{"label":"E","text":"All of the above."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f8d0c06d71fa","stem":"Which of the following items in a pregnant patient's History suggests the possibility of her having diabetes","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"Diabet","suggestedTopic":null,"options":[{"label":"A","text":"IUGR."},{"label":"B","text":"Past Hx of twins."},{"label":"C","text":"1st trimester bleeding."},{"label":"D","text":"Diabetic husband."},{"label":"E","text":"Unexplained stillbirths."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Endocrinology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-04be8fcc2075","stem":"During pregnancy, blood tests for diabetes are more abnormal than in nonpregnant state. This is due to","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Decreased insulin."},{"label":"B","text":"Increased absorption from the GI tract."},{"label":"C","text":"Increased placental lactogen."},{"label":"D","text":"Estrogen decreases and progesterone increases."},{"label":"E","text":"Hemoconcentration."}],"priority":1,"status":"practice_draft","flags":["topic_generic"]