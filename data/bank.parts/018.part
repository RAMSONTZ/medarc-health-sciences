x weeks gestation","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Vaginal examination is contraindicated."},{"label":"B","text":"Right iliac fossa pain is diagnostic of appendicitis."},{"label":"C","text":"Placental abruption should be considered."},{"label":"D","text":"Could be gallstones. 62 All OB-GYN MCQs Second rearranged Edition 2011"},{"label":"E","text":"USS has reliable diagnostic information."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-020f9ed84ba5","stem":"The endometrial change of ectopic pregnancy","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Glandular cystic hyperplasia"},{"label":"B","text":"Decidual transformation"},{"label":"C","text":"Secroteraty changes with chorial cell"},{"label":"D","text":"Atypical hyperplasia"},{"label":"E","text":"Proliferation endometrium"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c53dae05102b","stem":"In ectopic pregnancy","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"The ovarian ectopic pregnancy is the most common site"},{"label":"B","text":"More than 90% of ectopic pregnancies occurs in the fallopian tube"},{"label":"C","text":"The majority of tubal pregnancies occurs in the fimbria"},{"label":"D","text":"The most common symptoms of ectopic pregnancy is vaginal bleeding without abdominal pain"},{"label":"E","text":"Pregnancy test is negative more than 90% of the cases"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"f198bfcf6412cb176b647f0c88d37c47d6a81fd8"},{"id":"q-fafffed4bed7","stem":"Which of the following is a contraindication to medical treatment in ectopic pregnancy?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"An intact tubal pregnancy."},{"label":"B","text":"The size is less than 3cm."},{"label":"C","text":"The presence of hemoperitonium."},{"label":"D","text":"The absence of fetal cardiac activity."},{"label":"E","text":"A serum β-hCG of 1500."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e1f0cc9a5dda","stem":"The quantitative β subunit of HCG in a serum of patient with ectopic pregnancy will","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Rise in a rate greater than expected."},{"label":"B","text":"Rise at rate consistent with the normal curve."},{"label":"C","text":"Rise at a slower than expected."},{"label":"D","text":"Plateau."},{"label":"E","text":"Progressively fall. 63 All OB-GYN MCQs Second rearranged Edition 2011 Antepartum Hemorrhage:"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-7061b79fdd6d","stem":"Antepartum haemorrhage may be caused by the following, EXCEPT","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Placenta previa"},{"label":"B","text":"Cervical cancer"},{"label":"C","text":"Abruptio placenta"},{"label":"D","text":"Ectopic pregnancy"},{"label":"E","text":"Vasa praevia"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f10648b40778","stem":"Each of the following typical feature of placenta previa, EXCEPT","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Painless bleeding"},{"label":"B","text":"First episode of bleeding is usually self limited"},{"label":"C","text":"May be associated with post coital bleeding"},{"label":"D","text":"Commonly associated with coagulopathy"},{"label":"E","text":"The uterus tends to be soft and non-tender"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-676992e719de","stem":"A 33 year old woman at 37 weeks gestation confirmed by early sonogram presents with moderate to sever vaginal bleeding, and is note by sonogram to have placenta previa, which of the following is the best management for her.","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Induction of labor"},{"label":"B","text":"Give tocolytic drugs"},{"label":"C","text":"Caesarean section"},{"label":"D","text":"Expectant management"},{"label":"E","text":"Artificial rupture of the membrane"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-728bc37f188a","stem":"Regarding Abruptio placenta","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Postpartum hemorrhage occurs only when there in hypofibrinogenemia"},{"label":"B","text":"Maternal anemia is a major cause for abruptio placenta"},{"label":"C","text":"Fetus is not usually affected"},{"label":"D","text":"Associated with antecedent hypertension"},{"label":"E","text":"On Examination the abdomen is usually soft and lax"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"b298ea7ceed2244b5ca91cc88f50be66e846fb99"},{"id":"q-d3ff16349cef","stem":"Regarding Placenta previa","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Is diagnosed when the placenta occupies the funds and start to bleed"},{"label":"B","text":"Recognized to be complicated by postpartum hemorrhage"},{"label":"C","text":"The fetal heart rate is usually abnormal."},{"label":"D","text":"Less common in patients with repeat caesarian section"},{"label":"E","text":"Diagnosis is confirmed when bleeding starts at 13 weeks of gestation"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-54ee151e7557","stem":"In placenta previa: Which is true?","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It is common primigravida"},{"label":"B","text":"May cause abnormal lie"},{"label":"C","text":"Causes recurrent painful bleeding 64 All OB-GYN MCQs Second rearranged Edition 2011"},{"label":"D","text":"All patients should be induced with prostaglandin pessaries"},{"label":"E","text":"Digital examination is mandatory to exclude local causes"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-fefa5cff58de","stem":"Antepartum hemorrhage: Which is true?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Is any bleeding from the genital tract during any stage of pregnancy"},{"label":"B","text":"Requires assessment by vaginal examination"},{"label":"C","text":"May be caused by cervical carcinoma"},{"label":"D","text":"Is always painless"},{"label":"E","text":"All patients should be delivered by Caesarian Section"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-57d280113a7a","stem":"A pregnant woman presents with a placenta praevia of a major defect and fetus is malformed. Which of the following will be the best management?","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Caesarian section"},{"label":"B","text":"Oxytocin drip"},{"label":"C","text":"Rupture of membranes"},{"label":"D","text":"Induce with PG E2"},{"label":"E","text":"Forceps delivery in the second stage to accelerate delivery."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1fa9eaf1dc04","stem":"Abruptio placenta","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Is defined as premature separation of low lying placenta."},{"label":"B","text":"There is no increase risk of recurrence."},{"label":"C","text":"The etiology of placental abruption is usually known."},{"label":"D","text":"The diagnosis of placental abruption is frequently confirmed by ultrasound."},{"label":"E","text":"The most predisposing condition is chronic maternal Hypertension."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ef4846221c09","stem":"Management of Placental Abruption includes all of the following EXCEPT","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Coagulation studies."},{"label":"B","text":"Expectant management in cases of IUFD."},{"label":"C","text":"Augmentation of labor."},{"label":"D","text":"Artificial rupture of Amniotic membrane."},{"label":"E","text":"Intensive I.V. fluid replacement."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"83829a6796f6f08c06cd2f4e888edf50cb4bdd06"},{"id":"q-63106a2a4a77","stem":"The most common risk factors for placental abruption","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Diabetes."},{"label":"B","text":"Increased maternal age, Multiparity, hypertension & cigarette smoking."},{"label":"C","text":"Intrauterine growth retardation."},{"label":"D","text":"Rh isoimmunization."},{"label":"E","text":"Multiple pregnancy."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b7518bc7b6ee","stem":"The following is a contraindication for the use of amnio-hook","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Plcenta previa"},{"label":"B","text":"Abruptio placenta"},{"label":"C","text":"Breech presentation 65 All OB-GYN MCQs Second rearranged Edition 2011"},{"label":"D","text":"IUGR"},{"label":"E","text":"Face presentation"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","a