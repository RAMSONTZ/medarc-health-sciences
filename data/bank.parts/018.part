"label":"E","text":"20 units oxytocin in a 500 ml of D5W given IV"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7ce3d8e46a67","stem":"Of the following, the most common cause of maternal death from eclampsia is","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Infection."},{"label":"B","text":"Uremia. 112 All OB-GYN MCQs Second rearranged Edition 2011"},{"label":"C","text":"Congestive heart failure."},{"label":"D","text":"Fever."},{"label":"E","text":"Cerebral hemorrhage."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-2e1285634d37","stem":"The criteria for severe pre-eclampsia include all the following, EXCEPT","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Diastolic blood pressure of 110 mmhg or more."},{"label":"B","text":"Proteinuria more than 5g/24 hours."},{"label":"C","text":"Presence of epigastric pain ."},{"label":"D","text":"Decreased hematocrit."},{"label":"E","text":"Oliguria."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-45cf823d9d80","stem":"The immediate appropriate response to an eclamptic seizure includes all the following, EXCEPT","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Monitor the fetal heart rate."},{"label":"B","text":"US done for fetal growth."},{"label":"C","text":"Administer Mg sulphate."},{"label":"D","text":"Maintain adequate oxygenation."},{"label":"E","text":"Prevent maternal injury."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8c93f9880f5a","stem":"All the following factors increase the risk of the development of pre-eclampsia, EXCEPT","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Closed spaced pregnancies."},{"label":"B","text":"Pre-existing diabetes."},{"label":"C","text":"Multiple gestation."},{"label":"D","text":"Pre-eclampsia with a previous pregnancy."},{"label":"E","text":"Pre-existing renal disease."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d4bc76c28212","stem":"Risk factors to preeclampsia include all the following EXCEPT","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Premature delivery."},{"label":"B","text":"Placenta abruption."},{"label":"C","text":"Renal failure."},{"label":"D","text":"DIC."},{"label":"E","text":"Polycythemia."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-cb679c0b2fc6","stem":"Pregnancy induced hypertension is more common in all the following EXCEPT","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Cardiology","topicOriginal":"Cardiology","subtopic":"Hypertension","suggestedTopic":null,"options":[{"label":"A","text":"Primigravida."},{"label":"B","text":"Multiple pregnancy."},{"label":"C","text":"Patients with pre-existing hypertension."},{"label":"D","text":"Women with UTI."},{"label":"E","text":"Women with diabetes mellitus."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Cardiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f4f106e48f87","stem":"Which of the following laboratory tests would be most suggestive of preeclampsia?","type":"Single Best Answer MCQ","subj