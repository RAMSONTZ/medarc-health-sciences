":"Regarding Androgen insensitivity syndrome all true EXCEPT","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The chromosomal sex is 46XX."},{"label":"B","text":"Scant or no pubic and axillary hair."},{"label":"C","text":"No uterus"},{"label":"D","text":"Normal female external genetailia"},{"label":"E","text":"Breast are usually well develop"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d2468488fe80","stem":"Which is not true about Turner's syndrome","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Short stature"},{"label":"B","text":"Buccal smear is chromatin positive"},{"label":"C","text":"The majority are 45XO"},{"label":"D","text":"Very low urinary estrogen titer"},{"label":"E","text":"High pituitary gonadotropin titer."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-557cc7ab3645","stem":"Androgen Insensitivity Syndrome","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The characteristic features include normal uterus and breast development, and ambiguous genitalia."},{"label":"B","text":"The Karyotyping is 46XX."},{"label":"C","text":"They have normal female testosterone level."},{"label":"D","text":"Gonadectomy must be performed after puberty because of the increased risk of malignancy."},{"label":"E","text":"Estrogen replacement therapy is not indicated because they have enough estrogens to produce breast development."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f0f7a4677968","stem":"While evaluating a 30-year-old woman for infertility, you diagnosed a bicornuate uterus. You explain that additional testing is necessary because of the woman's increased risk of congenital anomalies in which system?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Skeletal."},{"label":"B","text":"Hematopoietic."},{"label":"C","text":"Urinary. 19 All OB-GYN MCQs Second rearranged Edition 2011"},{"label":"D","text":"Central nervous."},{"label":"E","text":"Tracheoesophageal."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-5277b3f09251","stem":"Development stage","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Testosterone is secreted by Sertoli cells."},{"label":"B","text":"Anti-müllerian hormone is secreted by Leydig cells."},{"label":"C","text":"Anti-müllerian hormone is responsible for involution of normal müllerian system."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7b369bec5f4c","stem":"Bicornuate uterus can cause all of the following EXCEPT","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Abortions"},{"label":"B","text":"Abnormal fetal lie."},{"label":"C","text":"Infertility."},{"label":"D","text":"Retained placenta."},{"label":"E","text":"Congenital anomalies of the baby."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-135e9f27754d","stem":"In Turner’s syndrome patients, all of the following are true EXCEPT","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The streak ovaries should be removed surgically due to 25% tendency to be malignant."},{"label":"B","text":"Are usually less than 5 feet tall."},{"label":"C","text":"Have raised FSH levels."},{"label":"D","text":"Have female internal genitalia."},{"label":"E","text":"Have normal but infertile external genitalia."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"has