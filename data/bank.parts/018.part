 estrogen"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8a9e311891ec","stem":"Regarding renal tract during pregnancy, the following are true EXCEPT","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"The ureters are dilated."},{"label":"B","text":"The renal pelvis calyces are dilated."},{"label":"C","text":"The right side is affected more then the left side."},{"label":"D","text":"The primigravida shows more changes then multigravida."},{"label":"E","text":"The bladder tone increases."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8d81a2f82f21","stem":"As pregnancy advances, which of the following hematological changes occurs?","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Plasma volume increases proportionally more than red cell volume."},{"label":"B","text":"Red cell volume increases proportionally more than plasma volume."},{"label":"C","text":"Plasma volume increases & red cell volume remains constant."},{"label":"D","text":"Red cell volume decreases & plasma volume remains constant."},{"label":"E","tex