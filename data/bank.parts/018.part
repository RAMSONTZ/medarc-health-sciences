ed topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Diabetes"},{"label":"B","text":"Multiple pregnancy"},{"label":"C","text":"Fetus with hydrops fetalis"},{"label":"D","text":"Fetus with duodenal atresia or neural tube defect"},{"label":"E","text":"IUGR 35 All OB-GYN MCQs Second rearranged Edition 2011"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-467a9ce3ef66","stem":"Which of the following causes of polyhydramnios is more common","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Twin pregnancy."},{"label":"B","text":"Diabetes."},{"label":"C","text":"Hydrops fetalis."},{"label":"D","text":"Anencephaly."},{"label":"E","text":"Idiopathic."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a6001f004e38","stem":"Using your knowledge of normal maternal physiology, which of the following would employ if a 38 weeks’ pregnant patient become faint while lying supine on your examination table","type":"Single Best Answer MCQ","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Blood transfusion."},{"label":"B","text":"Turning the patient on her side."},{"label":"C","text":"Oxygen by face mask."},{"label":"D","text":"I.V. saline solution."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2ff0cb1706e2","stem":"Skin changes during pregnancy should include","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Chloasma."},{"label":"B","text":"Striae."},{"label":"C","text":"Palmer erythema."},{"label":"D","text":"Vascular spiders."},{"label":"E","text":"All of the above. 36 All OB-GYN MCQs Second rearranged Edition 2011 Reproductive Biology:"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-7a17d869828b","stem":"The number of chromosomes in the human somatic cell is","type":"Single Best Answer MCQ","subject":"Medical Genetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"24."},{"label":"B","text":"44."},{"label":"C","text":"46."},{"label":"D","text":"48."},{"label":"E","text":"23."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Genetics","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4196880dd774","stem":"Regarding Oogenesis & ovulation","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Primary oocytes are formed after birth until puberty."},{"label":"B","text":"The 1ST meiotic division is arrested in the diplotene stage until just before ovulation."},{"label":"C","text":"Oogenesis is completed in 72 hours."},{"label":"D","text":"The ova survive for 3 days after ovulation."},{"label":"E","text":"Ovulation occurs 36 hours after FSH surge."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-49cfd9b51c8b","stem":"Regarding Fertilization & implantation","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Fertilization occurs in the inner third of the fallopian tube."},{"label":"B","text":"The sperm head penetrates through the corona radiata & zona pellucida while the tail remains outside."},{"label":"C","text":"The 2ND meiotic division is completed before fertilization."},{"label":"D","text":"Implantation occurs at the morula stage."},{"label":"E","text":"The trophoblast invades the endometrium & differentiate into an outer cytotrophoblast & an inner cyncytiotrophoblast."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7e31bcf64b8f","stem":"The second meiotic division of the oocyte is normally completed","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"at the stage of the primary follicle."},{"label":"B","text":"At the stage of the Graafian follicle."},{"label":"C","text":"In the peritoneal cavity."},{"label":"D","text":"In the uterus at the time of implantation."},{"label":"E","text":"After the sperm penetrates the secondary oocyte"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6ba1b4482f62","stem":"Physiological changes in the reproductive system include","type":"Single Best Answer MCQ","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"There is no change in the vagina."},{"label":"B","text":"The uterus 1st enlarges by hyperplasia then by hypertrophy."},{"label":"C","text":"There is no change in the cervix."},{"label":"D","text":"Estrogen has no role in the changes that occur during pregnancy."},{"label":"E","text":"Lower segment of the uterus will be formed in the 1st trimester. 37 All OB-GYN MCQs Second rearranged Edition 2011 Antenatal Care:"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publica