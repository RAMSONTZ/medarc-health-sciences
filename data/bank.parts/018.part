otonic uterine dysfunction."},{"label":"D","text":"Twin gestation."},{"label":"E","text":"Prior history of LSCS. 97 All OB-GYN MCQs Second rearranged Edition 2011 Abnormal Presentation and Breech:"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-91fd6dcb80b7","stem":"Compound presentation is most consistently associated with","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Prematurity."},{"label":"B","text":"Advanced maternal age."},{"label":"C","text":"Uncoordinated uterine contractions."},{"label":"D","text":"Diabetic pregnant woman."},{"label":"E","text":"Large pelvic vessels."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-96ededfb2917","stem":"Complete breech means","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Flexion at hip joint and extension in knee joint"},{"label":"B","text":"Flexion at hip joint and flexion at knee joint"},{"label":"C","text":"Extension at the hip joint"},{"label":"D","text":"Flexion at knee joint and extension at the hip joint"},{"label":"E","text":"Flexion of one leg at hip joint and extension of the other leg at the hip joint"}],"priority":1,"st