e · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8f7d2ded7bfb","stem":"Regarding twin pregnancies all of the following are correct EXCEPT","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"It has a higher incidence of preterm labor"},{"label":"B","text":"Mal-presentation of one of the main factors leading to increase incidence of C/S"},{"label":"C","text":"Abruptio placenta may occur with the sudden decompression of the uterus immediately after delivery of the first twin"},{"label":"D","text":"Dexamethasone is useful in case preterm labor"},{"label":"E","text":"Identical or monozygotic twin arise from fertilization of two ovum"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0e9c580c62a6","stem":"All are true about monozygotic pregnancy, EXCEPT","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"The 1st commonly presents as breech."},{"label":"B","text":"Pregnancy induced hypertension is common."},{"label":"C","text":"There is only one placenta."},{"label":"D","text":"Polyhydramnios is frequently present."},{"label":"E","text":"Anemia is common."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-292d534c9c74","stem":"Excessive increased level of β-HCG is expected in","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ectopic pregnancy."},{"label":"B","text":"Pregnancy of diabetic mothers."},{"label":"C","text":"Twin pregnancy."},{"label":"D","text":"Incomplete abortion."},{"label":"E","text":"Cervical carcinoma. 50 All OB-GYN MCQs Second rearranged Edition 2011"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-6cd15c6aa623","stem":"Regarding multiple pregnancy. All the following are true, EXCEPT","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Is frequently complicated by premature labor."},{"label":"B","text":"Is associated with an increased risk of post partum hemorrhage."},{"label":"C","text":"Occurs in approximately 1 in 80 pregnancies."},{"label":"D","text":"Often causes prolonged labor."},{"label":"E","text":"Is often diagnosed early by US."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-cd8ca4e6e258","stem":"Multiple Gestation is frequently associated with all of the following EXCEPT","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Hypertension."},{"label":"B","text":"Hydramnios."},{"label":"C","text":"Fertility drugs."},{"label":"D","text":"Post-maturity."},{"label":"E","text":"Pre-term labor. 51 All OB-GYN MCQs Second rearranged Edition 2011 Bleeding in early pregnancy: Abortions:"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-fb773084fd58","stem":"Regarding missed abortion, all of the following are CORRECT, EXCEPT","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Patient may present with loss of the symptoms of pregnancy"},{"label":"B","text":"Per vaginal bleeding may be one of the presenting symptom"},{"label":"C","text":"Immediate evacuation should be done once the diagnosis is made"},{"label":"D","text":"Disseminated intra-vascular coagulation may occur as a sequele of missed abortion"},{"label":"E","text":"Ultrasound should be done to confirm the diagnosis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6653eadb6559","stem":"14 weeks pregnant woman had abortion and she was told that it is a complete abortion. This is true regarding complete abortion","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Uterus is usually bigger than date"},{"label":"B","text":"Cervical OS is opened with tissue inside the cervix"},{"label":"C","text":"Need to have evacuation of the uterus"},{"label":"D","text":"After complete abortion there is minimal or no pain and minimal or no bleeding"},{"label":"E","text":"Follow up with β-hCG for one year."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-eeb0858df795","stem":"In patients with three consecutive spontaneous abortion in the second trimester the most useful investigation is","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Chromosomal analysis"},{"label":"B","text":"Hysterosalpingogram"},{"label":"C","text":"Endometrial biopsy"},{"label":"D","text":"Post coital test"},{"label":"E","text":"Prolactin level"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"cb2592a63f6340bd932a3f7a35f4d0139f797e08"},{"id":"q-c4c197653d5a","stem":"Regarding cervical incompetence, all of the following are true, EXCEPT","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Typically causes painful abortions"},{"label":"B","text":"Typically causes mid-trimester abortions"},{"label":"C","text":"Is treated by Shirodkar suture (cervical cerculage) which is best preformed early in the second trimester"},{"label":"D","text":"May lead to premature rupture of the membrane"},{"label":"E","text":"Can occur in patient with history of cone biopsy"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-613e7caefc27","stem":"Causes of first trimester abortion","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Chromosomal abnormalities"},{"label":"B","text":"Cervical incompetence"},{"label":"C","text":"Bicornuate uterus"},{"label":"D","text":"Gestational hypertension"},{"label":"E","text":"Pre-eclampsia 52 All OB-GYN MCQs Second rearranged Edition 2011"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-2de10e1810c6","stem":"Management of a patient with threatened abortion includes all of the following, EXCEPT","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ultrasound"},{"label":"B","text":"Physical examination"},{"label":"C","text":"CBC"},{"label":"D","text":"Derailed menstrual history"},{"label":"E","text":"Dilatation and curettage."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-36af20edd57b","stem":"A 25-year-old primigravida with 8 weeks threatened abortion, ultrasound would most likely reveal","type":"Radiological Interpretation","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Thickened endometrium with no gestational sac"},{"label":"B","text":"Feral heart motion in the adnexia"},{"label":"C","text":"Empty gestational sac"},{"label":"D","text":"Collapsed gestational sac"},{"label":"E","text":"An intact gestational sac with fetal"}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-75135756f8f5","stem":"Regarding incomplete abortion, all are true, EXCEPT","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"There is a history of tissue passed per vagina"},{"label":"B","text":"The cervix is open on vaginal examination"},{"label":"C","text":"Ultrasound shows retained product of conception"},{"label":"D","text":"Ultrasound shows intact gestational sac non- viable fetus"},{"label":"E","text":"Management include evacuation"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-51433426f519","stem":"Most common cause of first trimester abortion","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Chromosomal abnormalities"},{"label":"B","text":"Syphilis"},{"label":"C","text":"Rhesus isoimmunization"},{"label":"D","text":"Cervical incompetence"},{"label":"E","text":"Bifurcate uterus"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-05b2192b077a","stem":"Incompetent cervix","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Is a cause for early pregnancy loss"},{"label":"B","text":"Is best diagnosed by history"},{"label":"C","text":"Is a cause for fetal congenital abnormalities"},{"label":"D","text":"Is not encounted with uterine anomities"},{"label":"E","text":"Can be treated with tocolytics"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3ecc6b4ef3a7","stem":"Of the proposed etiologies for recurrent pregnancy wastage, the least likely is","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Maternal trauma."},{"label":"B","text":"Maternal balanced translocation."},{"label":"C","text":"Paternal balanced translocation."},{"label":"D","text":"Luteal phase deficiency."},{"label":"E","text":"Autoimmune disease. 53 All OB-GYN MCQs Second rearranged Edition 2011"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-87a0faec5ea7","stem":"The most common etiology for spontaneous abortion of a recognized first trimester gestation","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Chromosomal anomaly in 50-60% of gestations."},{"label":"B","text":"Chromosomal anomaly in 20-30% of gestations."},{"label":"C","text":"Maternal hypothyroidism."},{"label":"D","text":"Maternal Diabetes."},{"label":"E","text":"Progesterone deficiency."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0f8fc34094ed","stem":"In threatened abortion, which one of the following items is TRUE?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The cervix is open"},{"label":"B","text":"Evacuation is the best treatment"},{"label":"C","text":"All patients should be admitted"},{"label":"D","text":"In the majority of cases pregnancy will continue without any complication"},{"label":"E","text":"Does not necessitate giving Anti-D for Rh-negative mother"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-fa50f3789379","stem":"In case of threatened abortion","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Fetal heart is present"},{"label":"B","text":"Cervix is dilated"},{"label":"C","text":"There is a history of passing tissue per vagina."},{"label":"D","text":"Patients needs immediate evacuation"},{"label":"E","text":"No need to give anti-D for Rhesus negative mothers"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleanin