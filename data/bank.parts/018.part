options":[{"label":"A","text":"Drug abuse."},{"label":"B","text":"SLE."},{"label":"C","text":"Pre-eclampsia and eclampsia."},{"label":"D","text":"Sickle cell disease."},{"label":"E","text":"Placenta previa."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Nephrology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-353573b30dc3","stem":"Regarding essential hypertension in pregnancy, all the following is true, EXCEPT","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Cardiology","topicOriginal":"Cardiology","subtopic":"Hypertension","suggestedTopic":null,"options":[{"label":"A","text":"Commonly associated with +ve family Hx of hypertension."},{"label":"B","text":"Usually diagnosed in the 3rd trimester.*"},{"label":"C","text":"More common in women over the age of 35."},{"label":"D","text":"It's usually not associated with significant proteinuria."},{"label":"E","text":"Will develop pre-eclampsia more commonly than normotensive women . 108 All OB-GYN MCQs Second rearranged Edition 2011"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Cardiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-451a020c4a0d","stem":"A pre-eclamptic patient has just delivered and has a soft uterus with moderate bleeding. Examination reveals no laceration. Of the options below, the BEST choice is","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"0.2 mg IV ergometrine."},{"label":"B","text":"0.5 mg oral ergometrine."},{"label":"C","text":"5 units of oral oxytocin."},{"label":"D","text":"0.5 mg IM ergometrine."},{"label":"E","text":"20 units Oxytocin in a 500 ml of D5W given IV."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-06e96b4412da","stem":"Pregnancy induced proteinuric hypertension is associated with all the following, EXCEPT","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Cardiology","topicOriginal":"Cardiology","subtopic":"Hypertension","suggestedTopic":null,"options":[{"label":"A","text":"An increase in serum uric acid level."},{"label":"B","text":"Plasma volume decreases."},{"label":"C","text":"An increase in the incidence of IUGR."},{"label":"D","text":"An increase in creatinine clearance."},{"label":"E","text":"Hb concentration increases."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Cardiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-683869963654","stem":"Regarding pre-eclampsia, proteinuria is defined as","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"100 mg/24 hour urine."},{"label":"B","text":"200 mg/24 hour urine."},{"label":"C","text":"300 mg/24 hour urine."},{"label":"D","text":"> 500 mg/24 hour urine."},{"label":"E","text":"< 300 mg/34 hour urine."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-cce3fc9b56db","stem":"Which adverse pregnancy outcome isn't increased in pregnancies complicated by chronic hypertension","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Fetal growth restriction."},{"label":"B","text":"Preterm birth."},{"label":"C","text":"Spontaneous preterm rupture of membranes."},{"label":"D","text":"Perinatal death."},{"label":"E","text":"Post term birth"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8af81edccb2c","stem":"A syndrome seen in pre-eclampsia called HELLP syndrome is characterized by all of the following EXCEPT","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Elevation of Liver enzymes."},{"label":"B","text":"Hemolysis."},{"label":"C","text":"Low platelet count."},{"label":"D","text":"Prolongation of the Prothrombin time."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-01680bc20c94","stem":"The most common presenting prodromal sign or symptom in patient with eclampsia is","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Right upper quadrant pain."},{"label":"B","text":"Edema."},{"label":"C","text":"Headache. 109 All OB-GYN MCQs Second rearranged Edition 2011"},{"label":"D","text":"Visual disturbance."},{"label":"E","text":"Severe hypertension."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-da37a3ca9078","stem":"Appropriate response to an initial eclamptic seizure include all of the following EXCEPT","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Attempt to abolish the seizure by administrating I.M. diazepam."},{"label":"B","text":"Maintain adequate Oxygenation."},{"label":"C","text":"Administer Mg sulphate by either the I.M. or I.V. route."},{"label":"D","text":"Prevent maternal injury."},{"label":"E","text":"Monitor the fetal heart rate."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2995f9e792c2","stem":"The most consistent finding in Eclampsia patients is","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Hyperreflexia."},{"label":"B","text":"4+ proteinuria."},{"label":"C","text":"Generalized edema."},{"label":"D","text":"Diastolic blood pressure greater than 110 mmHg."},{"label":"E","text":"Convulsions."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1431b6280534","stem":"Eclampsia occurring prior to 20 weeks of gestation is most commonly seen in women with","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"A history of chronic hypertension."},{"label":"B","text":"Multiple gestation."},{"label":"C","text":"Gestational trophoblastic diseases."},{"label":"D","text":"A history of seizure disorder."},{"label":"E","text":"A history of choric renal diseases."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-18947b83fe63","stem":"Of the following, the most common complication of eclampsia is","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Mg intoxication."},{"label":"B","text":"Recurrent seizures following administration of Mg sulphate."},{"label":"C","text":"Intracranial hemorrhage."},{"label":"D","text":"Maternal death."},{"label":"E","text":"Pulmonary edema"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7b3cb0b953bc","stem":"If a woman with pre-eclampsia is not treated prophylcatically to prevent eclampsia, her risk of seizing is approximately","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"1/10."},{"label":"B","text":"1/25."},{"label":"C","text":"1/75."},{"label":"D","text":"1/200."},{"label":"E","text":"1/500. 110 All OB-GYN MCQs Second rearranged Edition 2011"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-a03f355cc128","stem":"Likely contributory mechanism of the anticonvulsant action of Mg sulphate includes all the following EXCEPT","ty