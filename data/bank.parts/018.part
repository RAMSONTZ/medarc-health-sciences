d Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-fe49e1071865","stem":"After an initial pregnancy resulted in a spontaneous loss in the first trimester, your patient is concerned about the possibility of this recurring. An appropriate answer would be that the chance of recurrence","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Depends on the genetic makeup of the prior abortus"},{"label":"B","text":"Is no different than it was prior to the miscarriage"},{"label":"C","text":"Is increased to approximately 50%"},{"label":"D","text":"Is increased most likely to greater than 50%"},{"label":"E","text":"Depends on the sex of the prior abortus"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f42ed73e95d9","stem":"A 24-year-old woman has had three first-trimester spontaneous abor- tions. Which of the following statements concerning chromosomal aberra- tions in abortions is true?","type":"Single Best Answer MCQ","subject":"Medical Genetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"45,X is more prevalent in chromosomally abnormal term babies than in abor- tus products"},{"label":"B","text":"Approximately 20% of first-trimester spontaneous abortions have chromoso- mal abnormalities"},{"label":"C","text":"Trisomy 21 is the most common trisomy in abortuses"},{"label":"D","text":"Despite the relatively high frequency of Down syndrome at term, most Down fetuses abort spontaneously"},{"label":"E","text":"Stillbirths have twice the incidence of chromosomal abnormalities as live births 1 Copyright © 2004 by the McGraw-Hill Companies, Inc. Click here for Terms of Use. 2 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Genetics","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","source_attribution_in_option","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"91b6e001281b868978f0b1a0bb8bbd9cc4ac8a8d"},{"id":"q-a67df4e148a6","stem":"Rates of successful pregnancy following three spontaneous losses (habit- ual abortion) are","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Very poor"},{"label":"B","text":"Slightly worse than those in the baseline population"},{"label":"C","text":"No different from those in the baseline population"},{"label":"D","text":"Just under 50%"},{"label":"E","text":"Good unless cervical incompetence is diagnosed"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4c86e5cccd50","stem":"A 26-year-old patient has had three consecutive spontaneous abortions early in the second trimester. As part of an evaluation for this problem, the least useful test would be","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Hysterosalpinogram"},{"label":"B","text":"Chromosomal analysis of the couple"},{"label":"C","text":"Endometrial biopsy in the luteal phase"},{"label":"D","text":"Postcoital test"},{"label":"E","text":"Tests of thyroid function"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f2aa6868f1ed","stem":"The risk of having a baby with Down syndrome for a 30-year-old woman increases","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"If the father of the baby is age 40"},{"label":"B","text":"If her pregnancy has been achieved by induction of ovulation by menotropins (e.g., Follistin, Gonal F)"},{"label":"C","text":"If she has had a previous baby with Turner syndrome (45,X)"},{"label":"D","text":"If she has had a previous baby with triploidy"},{"label":"E","text":"If she has had three first-trimester spontaneous abortions"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5f63f09da9bf","stem":"In terms of birth defect potential, the safest of the following drugs is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Alcohol"},{"label":"B","text":"Isotretinoin (Accutane)"},{"label":"C","text":"Tetracyclines"},{"label":"D","text":"Progesterones"},{"label":"E","text":"Phenytoin (Dilantin) Preconception Counseling, Genetics, and Prenatal Diagnosis 3"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-57d579af57d7","stem":"A 24-year-old woman is in a car accident and is taken to an emergency room, where she receives a chest x-ray and a film of her lower spine. It is later discovered that she is 10 weeks pregnant. She should be counseled that","type":"Radiological Interpretation","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"The fetus has received 50 rads"},{"label":"B","text":"Either chorionic villus sampling (CVS) or amniocentesis is advisable to check for fetal chromosomal abnormalities"},{"label":"C","text":"At 10 weeks, the fetus is particularly susceptible to derangements of the central nervous system"},{"label":"D","text":"The fetus has received less than the assumed threshold for radiation damage"},{"label":"E","text":"The risk that this fetus will develop leukemia as a child is raised"}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-38b172c7eabb","stem":"One of your patients, a 25-year-old G0, comes to your office for pre- conception counseling. She is a long-distance runner and wants to con- tinue to train during her pregnancy. This patient wants to know if there are any potential adverse effects to her fetus if she pursues a program of regu- lar exercise throughout gestation. You advise her of which of the following true statements regarding exercise and pregnancy?","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"During pregnancy, women should stop exercising because such activity is com- monly associated with intrauterine growth retardation in the fetus"},{"label":"B","text":"Exercise is best performed in the supine position to maximize venous return and cardiac output"},{"label":"C","text":"It is acceptable to continue to exercise throughout pregnancy as long as the maternal pulse does not exceed 160"},{"label":"D","text":"Non-weight-bearing exercises are optimal because they minimize the risks of maternal and fetal injuries"},{"label":"E","text":"Immediately following delivery, patients can continue to exercise at prepreg- nancy levels 4 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-e17ad4937d16","stem":"A 47-year-old woman has achieved a pregnancy via in vitro fertilization (IVF) using donor eggs from a 21-year-old donor and sperm from her 46- year-old husband. She has a sonogram performed at 7 weeks gestational age that shows a quintuplet pregnancy. A 5-mm nuchal translucency is dis- covered in one of the embryos. Implications of this include which of the following?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The embryo has a high risk of neural tube defect"},{"label":"B","text":"The embryo has a high risk of cardiac malformation"},{"label":"C","text":"The nuchal translucency will enlarge by 20 weeks"},{"label":"D","text":"If the nuchal translucency resolves, the risk of a chromosome abnormality is comparable to that of other embryos"},{"label":"E","text":"If the embryo is aneuploid, the most likely diagnosis is Turner syndrome Preconception Counseling, Genetics, and Prenatal Diagnosis 5 DIRECTIONS: Each group of questions below consists of lettered options followed by a set of numbered items. For each numbered item, select the one lettered option with which it is most closely associated. Each lettered option may be used once, more than once, or not at all. Items 10–13 For each situation, select the appropriate inheritance pattern."},{"label":"A","text":"Autosomal dominant"},{"label":"B","text":"Autosomal recessive"},{"label":"C","text":"X-linked recessive"},{"label":"D","text":"Codominant"},{"label":"E","text":"Multifactorial"}],"priority":1,"status":"review","flags":["topic_generic","too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["duplicate_option_labels","long_option_manual_review","prior_structural_review_flag","too_many_options_possible_merge","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-da2713674def","stem":"Achondroplasia is characterized by which of the following statements?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The inheritance pattern is autosomal recessive"},{"label":"B","text":"New mutations account for 50% of all cases"},{"label":"C","text":"Cesarean section is rarely necessary"},{"label":"D","text":"Affected women rarely live to reproductive age"},{"label":"E","text":"Spinal deformities lead to cord compression"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-de94b224efce","stem":"The third-trimester fetus of a mother with a balanced 13;13 translo- cation would have what likelihood of having an abnormal chromosome karyotype?","type":"Single Best Answer MCQ","subject":"Medical Genetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"2%"},{"label":"B","text":"10%"},{"label":"C","text":"25%"},{"label":"D","text":"50%"},{"label":"E","text":"100% 6 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Genetics","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-4b3a7d508e5c","stem":"The ultrasound image below is representative of","type":"Radiological Interpretation","subject":"Radiography and Medical Imaging","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A cystic hygroma"},{"label":"B","text":"An encephalocele"},{"label":"C","text":"Hydrocephalus"},{"label":"D","text":"Anencephaly"},{"label":"E","text":"None of the above"}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Radiography and Medical Imaging","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","repeated_question_stem","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":[],"duplicateStemGroup":"b4d0634d883e65fe6b5ae5dd480f975449d46cca"},{"id":"q-72b0a5a31417","stem":"A 24-year-old white woman has a maternal serum α-fetoprotein (MSAFP) at 17 weeks gestation of 6.0 multiples of the median (MOM). The next step should be","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A second MSAFP test"},{"label":"B","text":"Ultrasound examination"},{"label":"C","text":"Amniocentesis"},{"label":"D","text":"Amniography"},{"label":"E","text":"Recommendation of termination Preconception Counseling, Genetics, and Prenatal Diagnosis 7"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-17b8b7f20a7b","stem":"Advantages of ultrasound nuchal translucency over biochemical screening for Down syndrome include","type":"Radiological Interpretation","subject":"Medical Biochemistry","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Uses transvaginal approach"},{"label":"B","text":"More consistent measurements than lab tests"},{"label":"C","text":"Better in multiple gestation"},{"label":"D","text":"Wide gestational age range"},{"label":"E","text":"More convenient for patients"}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Medical Biochemistry","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-bf5119569f4f","stem":"A 41-year-old had a baby with Down syndrome 10 years ago. She is anxious to know the chromosome status of her fetus in a current preg- nancy. The test that has the fastest lab processing time for karyotype is","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Amniocentesis"},{"label":"B","text":"Cordocentesis"},{"label":"C","text":"Chorionic villus sampling (CVS)"},{"label":"D","text":"Doppler flow ultrasound"},{"label":"E","text":"Cystic hygroma aspiration"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-821ea515f6a9","stem":"A 39-year-old wants first-trimester prenatal diagnosis. Advantages of early amniocentesis over CVS include","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Amniocentesis can be performed earlier in pregnancy"},{"label":"B","text":"Amniocentesis is usually less painful"},{"label":"C","text":"Second-trimester diagnosis allows for safer termination of pregnancy when ter- mination is chosen by the patient"},{"label":"D","text":"CVS has a higher complication rate than midtrimester amniocentesis"},{"label":"E","text":"CVS has a higher complication rate than first-trimester amniocentesis Items 21–29 For each ultrasonogram, select one diagnosis or diagnostic indicator."},{"label":"A","text":"Obstructed urethra and bladder"},{"label":"B","text":"Nonspinal marker for spina bifida"},{"label":"C","text":"Indication of highest likelihood of a chromosomal abnormality"},{"label":"D","text":"Marker for Down syndrome (trisomy 21)"},{"label":"E","text":"Common marker for trisomies 18 and 21"},{"label":"F","text":"Osteogenesis imperfecta"},{"label":"G","text":"Mesomelic dwarfism"},{"label":"H","text":"Anencephaly i. Prune belly syndrome j. Hydrocephalus k. Spina bifida with meningocele 8 Obstetrics and Gynecology 21. 22. Preconception Counseling, Genetics, and Prenatal Diagnosis 9 23. 24. 10 Obstetrics and Gynecology 25. 26. Preconception Counseling, Genetics, and Prenatal Diagnosis 11 27. 28. 12 Obstetrics and Gynecology 29."}],"priority":1,"status":"review","flags":["topic_generic","too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","too_many_options","too_many_options_possible_merge","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-6052696a6387","stem":"Vaccines are contraindicated in pregnancy, even following maternal exposure, for which of the following diseases?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Rabies"},{"label":"B","text":"Tetanus"},{"label":"C","text":"Typhoid"},{"label":"D","text":"Hepatitis B"},{"label":"E","text":"Measles"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e9e189a1f54f","stem":"True statements concerning vaccines include","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Inactivated vaccines are hazardous to the mother"},{"label":"B","text":"Cases of congenital rubella syndrome have been reported in fetuses born to mothers who were immunized early in pregnancy"},{"label":"C","text":"Inactivated vaccines are hazardous to the fetus"},{"label":"D","text":"The polio virus has the ability to spread from the vaccine to susceptible persons in the immediate environment"},{"label":"E","text":"Nonimmune pregnant women who are exposed to children who recently received the measles-mumps-rubella (MMR) vaccine are at high risk of delivery of an infected fetus Preconception Counseling, Genetics, and Prenatal Diagnosis 13 Items 32–35 Select the antibiotic most frequently associated with the following fetal side effects."},{"label":"A","text":"Tetracycline"},{"label":"B","text":"Streptomycin"},{"label":"C","text":"Nitrofurantoin"},{"label":"D","text":"Chloramphenicol"},{"label":"E","text":"Sulfonamides"}],"priority":1,"status":"review","flags":["topic_generic","too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","too_many_options","too_many_options_possible_merge","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-303bc38a0e54","stem":"Gray baby syndrome (SELECT 1 ANTIBIOTIC) Items 36–40 The safety of immunization during pregnancy is a matter of concern and controversy that has prompted the American College of Obstetri- cians and Gynecologists to offer specific recommendations for the use of immunization therapy for pregnant women. For each disease, select the recommendation regarding vaccination with which it is most likely to be associated.","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Recommended if the underlying disease is serious"},{"label":"B","text":"Recommended after exposure or before travel to endemic areas"},{"label":"C","text":"Not routinely recommended, but mandatory during an epidemic"},{"label":"D","text":"Contraindicated unless exposure to the disease is unavoidable"},{"label":"E","text":"Contraindicated"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ba914a9f145d","stem":"A syndrome of multiple congenital anomalies including microcephaly, cardiac anomalies, and growth retardation has been described in children of women who are heavy users of","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Amphetamines"},{"label":"B","text":"Barbiturates"},{"label":"C","text":"Heroin"},{"label":"D","text":"Methadone"},{"label":"E","text":"Ethyl alcohol Items 42–43 Match each description with the correct drug."},{"label":"A","text":"Erythromycin"},{"label":"B","text":"Tetracycline"},{"label":"C","text":"Penicillin"},{"label":"D","text":"Chloramphenicol"},{"label":"E","text":"Ampicillin"},{"label":"F","text":"Trimethoprim-sulfamethoxazole (Bactrim)"}],"priority":1,"status":"review","flags":["topic_generic","too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","too_many_options","too_many_options_possible_merge","topic_generic"],"cleaningOperations":[]},{"id":"q-4783fdbef192","stem":"You see a healthy 40-year-old multiparous patient for preconception counseling. She is extremely worried about her risk of having a baby with spina bifida. Five years ago, this patient delivered a baby with anencephaly who died shortly after birth. How would you counsel this woman regard- ing future pregnancies?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"She does not have a recurrence risk of a neural tube defect above that of the general population"},{"label":"B","text":"She has an increased risk of having another baby with anencephaly because she is over 35 years old"},{"label":"C","text":"When she becomes pregnant, she should undergo diagnostic testing for fetal neural tube defects with a first-trimester chorionic villus sampling"},{"label":"D","text":"When she becomes pregnant, she should avoid hyperthermia in the first trimester because both maternal fevers and the use of hot tubs have been asso- ciated with an increased risk of neural tube defects"},{"label":"E","text":"She has a recurrence risk of having another baby with a neural tube defect of less than 1%"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-bcd249331fa3","stem":"A 36-year-old G1 undergoes a triple screen test at 16 weeks of preg- nancy to evaluate her risk of having a baby with Down syndrome because she is worried about being of “advanced maternal age.” Her maternal serum AFP level comes back elevated. This patient is extremely concerned and comes into your office to get additional counseling and recommenda- tions. All of the following are true statements that you can tell her except","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"An elevated serum AFP level indicates that she is at risk for having a baby with Down syndrome, and you recommend that she undergo a chorionic villus sam- pling to definitely determine the fetus’s chromosomes"},{"label":"B","text":"An ultrasound should be performed to confirm the gestational age of the fetus and rule out any fetal anomalies"},{"label":"C","text":"Fetal neural tube defects, multifetal gestations, and fetal abdominal wall defects are all possible etiologies of an elevated MSAFP"},{"label":"D","text":"Unexplained elevated MSAFP levels have been associated with poor pregnancy outcome, such as placental abruption, oligohydramnios, or fetal death in utero"},{"label":"E","text":"Most women who have an elevated MSAFP do not have a fetus with a neural tube defect 16 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-700657b577ce","stem":"An obese, 25-year-old G1P0 comes to your office at 8 weeks gesta- tional age for her first prenatal visit. She is delighted to be pregnant and wants to do whatever is necessary to ensure a healthy pregnancy. She is currently 5 ft, 2 in. tall and weighs 300 lb. She is concerned because she is overweight and wants you to help her with a strict exercise and diet regi- men so that she can be more healthy during the pregnancy. During your counseling session with the patient, you advise her of all of the following except","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Marked obesity in pregnancy increases the risk of developing diabetes, hyper- tension, and fetal macrosomia"},{"label":"B","text":"She should gain at least 25 lb during the pregnancy because nutritional depri- vation can result in impaired fetal brain development and intrauterine fetal growth retardation"},{"label":"C","text":"Obese women will still have adequate fetal growth in the absence of any weight gain during pregnancy"},{"label":"D","text":"She should avoid initiating a vigorous exercise program to get in shape"},{"label":"E","text":"Being obese places the patient at an increased risk of needing a cesarean section for delivery"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7476bb9a8816","stem":"A 26-year-old G1P1 comes to see you in your office for preconception counseling because she wants to get pregnant again. She denies a history of any illegal drug use but admits to smoking a few cigarettes each day and occasionally drinking some beer. When you advise her not to smoke or drink at all during this pregnancy, she gets defensive because she smokes and drinks very little, and she did the same during her previous pregnancy 2 years ago and her baby was just fine. Which of the following statements is true regarding the effects of tobacco and alcohol on pregnancy?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Small amounts of alcohol, such as a glass of wine or beer a day at dinner time, are safe; only binge drinking of large amounts of alcohol has been associated with fetal alcohol syndrome"},{"label":"B","text":"Fetal alcohol syndrome can be diagnosed prenatally via identifying fetal anom- alies on sonogram done antenatally"},{"label":"C","text":"Cigarette smoking is associated with an increased risk of spontaneous abortion"},{"label":"D","text":"In most studies, cigarette smoking has been associated with an increased risk of congenital anomalies"},{"label":"E","text":"Tobacco use in pregnancy is a common cause of mental retardation and devel- opmental delay in neonates Preconception Counseling, Genetics, and Prenatal Diagnosis 17"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"03bc3649d775beb85e35fbae913d970c69c4ecbe"},{"id":"q-df218789b57e","stem":"A 36-year-old G0 who has been epileptic for many years is contem- plating pregnancy and wants to go off her anticonvulsant medications because she is concerned regarding the adverse effects that these medica- tions may have on her unborn fetus. All of the following statements are true regarding epilepsy and pregnancy except","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Babies born to epileptic mothers have an increased risk of structural anomalies even in the absence of anticonvulsant medications"},{"label":"B","text":"Epileptic women should have their neurologist attempt to wean them off their anticonvulsant medications prior to conceiving"},{"label":"C","text":"Phenytoin (Dilantin) is associated with a 1 to 2% risk of spina bifida"},{"label":"D","text":"Folic acid supplementation reduces the risk of congenital anomalies in fetuses of epileptic women taking anticonvulsants"},{"label":"E","text":"The most frequently reported congenital anomalies in fetuses of epileptic women are neural tube defects"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a3bacb44e0c5","stem":"A patient who works as a nurse in the surgery intensive care unit at a local community hospital comes to see you for her annual gynecologic exam. She tells you that she plans to go off her oral contraceptives because she plans to attempt pregnancy in the next few months. This patient has many questions regarding updating her immunizations and whether or not she can do this when pregnant. All of the following statements are true regarding immunizations and pregnancy except","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"The patient should be checked for immunity against the rubella (German measles) virus prior to conception because the rubella vaccine is a live virus and should not be given during pregnancy"},{"label":"B","text":"The patient should be given the tetanus toxoid vaccination prior to becoming pregnant because it is a live virus that has been associated with multiple fetal anomalies when administered during pregnancy"},{"label":"C","text":"The Centers for Disease Control and Prevention recommends that all pregnant women should be vaccinated against the influenza virus after the first trimester"},{"label":"D","text":"If the patient does not have a history of having chickenpox in the past, she should be screened for immunity because most people without a history of the infection are immune; if the patient is nonimmune, she should be given the vaccine prior to achieving pregnancy because the vaccine is a live virus"},{"label":"E","text":"Because of her occupation, the patient is at high risk of hepatitis B; she can be given the vaccine during pregnancy because it is an inactivated virus vaccine 18 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-d008abcc835d","stem":"A patient comes to see you in the office because she has just missed her period and a home urine pregnancy test reads positive. She is extremely worried because last week she had a barium enema test done as part of a workup for blood in her stools. She is also concerned because her job requires her to sit in front of a computer screen all day and she uses the microwave oven on a regular basis. The patient is concerned regarding the deleterious effects of radiation exposure on her fetus. Which one of the fol- lowing statements is false regarding the effects of exposure to radiation and electromagnetic fields during pregnancy?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"There is no evidence in humans or animals that exposure to electromagnetic fields such as from high-voltage power lines, electric blankets, microwave ovens, and cellular phones causes adverse fetal outcomes"},{"label":"B","text":"There are no adverse fetal effects with exposure to radiation doses of less than 5 rads"},{"label":"C","text":"No single diagnostic procedure, such as a barium enema, results in a radiation dose that will adversely affect the embryo or fetus"},{"label":"D","text":"There is consistent data that exposure to radiation used for diagnostic studies is associated with an increased risk of childhood leukemia in the fetus"},{"label":"E","text":"There is not an increased risk of mental retardation when radiation exposure occurs at less than 8 weeks, even in the presence of very large radiation doses"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a70ab99e5ccb","stem":"A Jewish couple comes in to see you for preconception counseling. They are concerned that they might be at an increased risk of certain genetic diseases because of their ethnic background. The woman is 38 years old and tells you that in neither side of the family is there a family his- tory of any genetic disorders. Which one of the following statements is a correct recommendation for this couple?","type":"Single Best Answer MCQ","subject":"Medical Genetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"They are at an increased risk of having a β thalassemia, and they should both undergo screening tests with a hemoglobin electrophoresis prior to conception"},{"label":"B","text":"They are at an increased risk of having a baby born with a neural tube defect and should undergo amniocentesis in the second trimester of pregnancy for a definitive diagnosis"},{"label":"C","text":"They do not need to undergo screening for Tay-Sachs disease if there is no his- tory of affected children in their families"},{"label":"D","text":"The American College of Obstetrics and Gynecology recommends that all Jew- ish couples be screened for cystic fibrosis"},{"label":"E","text":"Canavan’s disease has a carrier frequency of 1 in 40 in the Jewish population, and the couple therefore should be screened for this genetic disease prior to conception Preconception Counseling, Genetics, and Prenatal Diagnosis 19"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Genetics","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"1fab899d409cc0af034839b7b0708c964771025e"},{"id":"q-cc178771e11e","stem":"You have a patient who is very health-conscious and regularly ingests a large number of vitamins in megadoses and herbal therapies on a daily basis. She is a strict vegetarian as well. She is going to attempt pregnancy and wants your advice regarding her diet and nutrition intake. Which of the following is true regarding diet recommendations in pregnancy?","type":"Single Best Answer MCQ","subject":"Nutrition and Dietetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Because herbal medications are natural, there is no reason to avoid these dietary supplements in pregnancy"},{"label":"B","text":"It is recommended that in pregnancy the majority of the protein consumed be supplied from animal sources"},{"label":"C","text":"Routine supplementation of vitamin A is necessary during pregnancy because dietary intake alone does not provide sufficient amounts needed during preg- nancy"},{"label":"D","text":"During pregnancy, vegetarians obtain sufficient amounts of vitamin B12 in their diet needed for the fetus"},{"label":"E","text":"Vitamin C supplementation in pregnancy is to be avoided because excessive levels can result in fetal malformations"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Nutrition and Dietetics","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"71dbd9ed2c120e3aafbe85c4db4146786031dccc"},{"id":"q-3e9111d5a3e1","stem":"A patient of yours has a history of multiple substance abuse. She is now pregnant again and tells you that she has a little boy that is 2 years old who is slow in school and has difficulty concentrating. Which of the fol- lowing substances has been associated with behavioral and developmental abnormalities in children?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Tobacco"},{"label":"B","text":"Cocaine"},{"label":"C","text":"Caffeine"},{"label":"D","text":"Marijuana"},{"label":"E","text":"LSD 20 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-c653408d0995","stem":"A 20-year-old G2P1 patient comes to see you at 17 weeks gestational age to review the results of her triple test done 1 week ago. You tell the patient that her MSAFP level is 2.0 MOM. The patient’s obstetrical history consists of a term vaginal delivery 2 years ago without complications. What do you tell your patient regarding how to proceed next?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Explain to the patient that the blood test is diagnostic of a neural tube defect and she should consult with a pediatric neurosurgeon as soon as possible"},{"label":"B","text":"Tell the patient that the blood test result is most likely a false-positive result and she should repeat the test at 20 weeks"},{"label":"C","text":"Refer the patient for an ultrasound to confirm dates"},{"label":"D","text":"Offer the patient immediate chorionic villus sampling to obtain a fetal karyo- type"},{"label":"E","text":"Recommend to the patient that she undergo a cordocentesis to measure fetal serum AFP levels"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a476abf066ff","stem":"You see a 42-year-old patient in your office who is now 5 weeks preg- nant with her fifth baby. She is very concerned regarding the risk of Down syndrome because of her advanced maternal age. After extensive genetic counseling, she has decided to undergo a second-trimester amniocentesis to determine the karyotype of her fetus. Prior to performing the procedure, you inform the patient that all of the following are possible complications of the amniocentesis except","type":"Single Best Answer MCQ","subject":"Medical Genetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Amniotic fluid leakage"},{"label":"B","text":"Chorioamnionitis"},{"label":"C","text":"A fetal loss rate of less than 0.5%"},{"label":"D","text":"Limb reduction defects"},{"label":"E","text":"Cell culture failure Preconception Counseling, Genetics, and Prenatal Diagnosis Answers"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Genetics","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-6e492047e373","stem":"Which of the following statements about twinning is true?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The frequencies of monozygosity and dizygosity are the same"},{"label":"B","text":"Division after formation of the embryonic disk results in conjoined twins"},{"label":"C","text":"The incidence of monozygotic twinning varies with race"},{"label":"D","text":"A dichorionic twin pregnancy always denotes dizygosity"},{"label":"E","text":"Twinning causes no appreciable increase in maternal morbidity and mortality over singleton pregnancies"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-af4a721043f5","stem":"The placenta of twins may be","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Dichorionic and monoamniotic in dizygotic (DZ) twins"},{"label":"B","text":"Dichorionic and monoamniotic in monozygotic (MZ) twins"},{"label":"C","text":"Monochorionic and monoamniotic in DZ twins"},{"label":"D","text":"Dichorionic and diamniotic in MZ twins"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b0e074a71adf","stem":"Fetal blood is returned to the umbilical arteries and the placenta through the","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Hypogastric arteries"},{"label":"B","text":"Ductus venosus"},{"label":"C","text":"Portal vein"},{"label":"D","text":"Inferior vena cava"},{"label":"E","text":"Foramen ovale 37 Copyright © 2004 by the McGraw-Hill Companies, Inc. Click here for Terms of Use. 38 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["source_attribution_in_option","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-bb29248e8faa","stem":"The finding of a single umbilical artery on examination of the umbili- cal cord after delivery is","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Abdomen","topicOriginal":"Abdomen","subtopic":"Liver","suggestedTopic":null,"options":[{"label":"A","text":"Insignificant"},{"label":"B","text":"Equal in incidence in blacks and whites"},{"label":"C","text":"An indicator of considerably increased incidence of major malformation of the fetus"},{"label":"D","text":"Equally common in newborns of diabetic and nondiabetic mothers"},{"label":"E","text":"Present in 5% of all births"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Abdomen","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-18d5052fcf8a","stem":"Velamentous insertion of the cord is associated with an increased risk for","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Premature rupture of the membranes"},{"label":"B","text":"Fetal exsanguinations before labor"},{"label":"C","text":"Torsion of the umbilical cord"},{"label":"D","text":"Fetal malformations"},{"label":"E","text":"Uterine malformations"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"8c6e07c2c8aa07d9a0c3c2378f52eb18fc2853bc"},{"id":"q-f54b421c8f43","stem":"A healthy 25-year-old G1P0 at 40 weeks gestational age comes to your office to see you for a routine OB visit. The patient complains to you that on several occasions she has experienced dizziness, light-headedness, and feeling as if she is going to pass out when she lies down on her back to take a nap. What is the appropriate plan of management for this patient?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Do an ECG"},{"label":"B","text":"Monitor her for 24 h with a Holter monitor to rule out an arrhythmia"},{"label":"C","text":"Do an arterial blood gas analysis"},{"label":"D","text":"Refer her immediately to a neurologist"},{"label":"E","text":"Reassure her that nothing is wrong with her and encourage her not to lie flat on her back Maternal-Fetal Physiology and Placentation 39"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"5764010ea6af46fc86eab48e53d82e729e1f8f5a"},{"id":"q-02499ed3ddea","stem":"A 42-year-old primigravida presents to your office for a routine OB visit at 34 weeks gestational age. She voices concern because she has noticed an increasing number of spidery veins appearing on her abdomen. She is upset with the unsightly appearance of these veins and wants to know what you recommend to get rid of them. How do you advise this patient?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Tell her that this is not a serious condition and give her a referral to a vascular surgeon to have the veins removed"},{"label":"B","text":"Tell her that you are concerned that she may have serious liver disease and order liver function tests"},{"label":"C","text":"Refer her to a dermatologist for further workup and evaluation"},{"label":"D","text":"Tell her that the appearance of these blood vessels is a normal occurrence with pregnancy and will resolve spontaneously after delivery"},{"label":"E","text":"Recommend that she wear an abdominal support to relieve pressure from her abdomen and cause resolution of the blood vessels"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-42308c7b89a0","stem":"A 32-year-old G2P1001 at 20 weeks gestational age presents to the emergency room complaining of constipation and abdominal pain for the past 24 h. The patient also admits to bouts of nausea and emesis since eat- ing a very spicy meal at a new Thai restaurant the evening before. She denies a history of any medical problems. During her last pregnancy, the patient underwent an elective cesarean section at term to deliver a fetus in the breech presentation. The emergency room doctor who examines her pages you and reports that the patient has a low-grade fever of 100°F, with a normal pulse and blood pressure. She is minimally tender to deep palpa- tion with hypoactive bowel sounds. She has no rebound tenderness. The patient has a WBC of 13,000, and electrolytes are normal. What is the appropriate next step in the management of this patient?","type":"OSCE / Practical Station","subject":"Emergency Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The history and physical exam are consistent with constipation, which is com- monly associated with pregnancy; the patient should be discharged with reas- surance and instructions to give herself a soapsuds enema and follow a high-fiber diet with laxative use as needed"},{"label":"B","text":"The patient should be prepped for the operating room immediately to have an emergent appendectomy"},{"label":"C","text":"The patient should be reassured that her symptoms are due to the spicy meal consumed the evening before and should be given Pepto-Bismol to alleviate the symptoms"},{"label":"D","text":"The patient should be sent to radiology for an upright abdominal x-ray"},{"label":"E","text":"Intravenous antiemetics should be ordered to treat the patient’s hyperemesis gravidarum 40 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Emergency Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-d20fd6bac438","stem":"A healthy 34-year-old G1P0 patient comes to see you in your office for a routine OB visit at 12 weeks gestational age. She tells you that she has stopped taking her prenatal vitamins with iron supplements because they make her sick and she has trouble remembering to take a pill every day. A review of her prenatal labs reveals that her hematocrit is 39%. Which of the following statements is the correct way to counsel this patient?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Tell the patient that she does not need to take her iron supplements because her prenatal labs indicate that she is not anemic and therefore she will not absorb the iron supplied in prenatal vitamins"},{"label":"B","text":"Tell the patient that if she consumes a diet rich in iron, she does not need to take any iron supplements"},{"label":"C","text":"Tell the patient that if she fails to take her iron supplements, her fetus will be anemic"},{"label":"D","text":"Tell the patient that she needs to take the iron supplements even though she is not anemic in order to meet the demands of pregnancy"},{"label":"E","text":"Tell the patient that she needs to start retaking her iron supplements when her hemoglobin falls below 11 g/dL"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"7195f4933b030bdabd3f91c1c25dca79b8223bcb"},{"id":"q-580cb669a2fc","stem":"A pregnant patient of yours goes to the emergency room at 20 weeks gestational age with complaints of hematuria and back pain. The emer- gency room physician orders an intravenous pyelogram (IVP) as part of a workup for a possible kidney stone. The radiologist indicates the absence of nephrolithiasis but reports the presence of bilateral hydronephrosis and hydroureter which is greater on the right side compared to the left. Which of the following statements is true regarding this IVP finding?","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"The bilateral hydronephrosis is of concern, and renal function tests including BUN and creatinine should be run and closely monitored"},{"label":"B","text":"These findings are consistent with normal pregnancy and are not of concern"},{"label":"C","text":"The bilateral hydronephrosis is of concern, and a renal sonogram should be ordered emergently"},{"label":"D","text":"The findings indicate that a urology consult is needed to obtain recommenda- tions for further workup and evaluation"},{"label":"E","text":"The findings are consistent with ureteral obstruction, and the patient should be referred for stent placement Maternal-Fetal Physiology and Placentation 41"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-0f0316e72fac","stem":"During a routine return OB visit, an 18-year-old G1P0 patient at 23 weeks gestational age undergoes a urinalysis. The dipstick done by the nurse indicates the presence of trace glucosuria. All other parameters of the urine test are normal. Which of the following is the most likely etiology of the increased sugar detected in the urine?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The patient has diabetes"},{"label":"B","text":"The patient has a urine infection"},{"label":"C","text":"The patient’s urinalysis is consistent with normal pregnancy"},{"label":"D","text":"The patient’s urine sample is contaminated"},{"label":"E","text":"The patient has kidney disease"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"37e38344902cd370b3ea9d3397bbe655154633ee"},{"id":"q-f88826ec97aa","stem":"A 29-year-old G1P0 patient at 15 weeks gestational age presents to your office complaining of some shortness of breath that is more intense with exertion. She has no significant past medical history and is not on any medication. The patient denies any chest pain but sometimes feels as though her heart is pounding. She is concerned because she has always been very athletic and cannot maintain the same degree of exercise that she was accustomed to prior to becoming pregnant. On physical exam, her pulse is 90/min. Her blood pressure is 90/50. On cardiac exam, a systolic ejection mummer is identified. The lungs are clear to auscultation and per- cussion. Which of the following is the most appropriate next step to pur- sue in the workup of this patient?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Refer the patient for a ventilation-perfusion scan to rule out a pulmonary embolism"},{"label":"B","text":"Perform an arterial blood gas"},{"label":"C","text":"Refer the patient to a cardiologist"},{"label":"D","text":"Reassure the patient"},{"label":"E","text":"Order an ECG 42 Obstetrics and Gynecology DIRECTIONS: Each group of questions below consists of lettered options followed by a set of numbered items. For each numbered item, select the one lettered option with which it is most closely associated. Each lettered option may be used once, more than once, or not at all. Items 68–70 Match the descriptions with the appropriate placenta type."},{"label":"A","text":"Fenestrated placenta"},{"label":"B","text":"Succenturiate placenta"},{"label":"C","text":"Vasa previa"},{"label":"D","text":"Placenta previa"},{"label":"E","text":"Membranaceous placenta"},{"label":"F","text":"Placenta accreta"}],"priority":1,"status":"review","flags":["topic_generic","too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["duplicate_option_labels","prior_structural_review_flag","too_many_options_possible_merge","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-7541338ff91c","stem":"The smallest anteroposterior diameter of the pelvic inlet is called the","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Pelvis and Perineum","topicOriginal":"Pelvis and Perineum","subtopic":"Pelvi","suggestedTopic":null,"options":[{"label":"A","text":"Interspinous diameter"},{"label":"B","text":"True conjugate"},{"label":"C","text":"Diagonal conjugate"},{"label":"D","text":"Obstetric conjugate"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Pelvis and Perineum","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b96ae606adb4","stem":"A pelvis characterized by an anteroposterior diameter of the inlet greater than the transverse diameter is classified as","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Pelvis and Perineum","topicOriginal":"Pelvis and Perineum","subtopic":"Pelvi","suggestedTopic":null,"options":[{"label":"A","text":"Gynecoid"},{"label":"B","text":"Android"},{"label":"C","text":"Anthropoid"},{"label":"D","text":"Platypelloid"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Pelvis and Perineum","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[],"manualEdits":{}},{"id":"q-9a82ae99f7ab","stem":"An abnormal attitude is illustrated by","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Breech presentation"},{"label":"B","text":"Face presentation"},{"label":"C","text":"Transverse position"},{"label":"D","text":"Occiput posterior"},{"label":"E","text":"Occiput anterior 49 Copyright © 2004 by the McGraw-Hill Companies, Inc. Click here for Terms of Use. 50 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["source_attribution_in_option","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-09629fca2242","stem":"Which of the following statements regarding monitoring of fetal heart rate (FHR) is true?","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A sinusoidal FHR pattern is almost invariably associated with an anemic, asphyxiated fetus"},{"label":"B","text":"A saltatory FHR pattern is almost invariably seen during rather than before labor"},{"label":"C","text":"The FHR tracing of the premature fetus should be analyzed by different criteria than tracings obtained at term"},{"label":"D","text":"Fetuses with congenital anomalies will invariably exhibit abnormal FHR patterns"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4c7fb9937532","stem":"Following a cesarean birth, contraindications for a trial of labor in a subsequent pregnancy include","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Breech presentation"},{"label":"B","text":"Lack of prior vaginal delivery"},{"label":"C","text":"The fact that the first section was for cephalopelvic disproportion (CPD)"},{"label":"D","text":"Unavailability of x-ray pelvimetry"},{"label":"E","text":"Classic cesarean section scar"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-496bc0d3b4ef","stem":"Fetal pulmonary maturity can be evaluated by phospholipid activity in amniotic fluid. In which of the following pregnancies does the fetus have the least chance of developing respiratory distress syndrome (RDS)?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Normal pregnancy; amniotic fluid L/S is 1.8:1, phosphatidyl glycerol (PG) is absent"},{"label":"B","text":"Hypertensive pregnancy; amniotic fluid L/S is 1.8:1, PG is absent"},{"label":"C","text":"Hypertensive pregnancy; amniotic fluid L/S is 2:1, PG is absent"},{"label":"D","text":"Diabetic pregnancy; amniotic fluid L/S is 2:1, PG is present"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-744197692b23","stem":"Doppler studies of the umbilical circulation","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Show that changes in flow velocity waveforms of the umbilical artery may be important in clinical management of high-risk pregnancies"},{"label":"B","text":"Exhibit in normal pregnancy a characteristic increase in the systolic/diastolic (S/D) ratio with advancing gestational age"},{"label":"C","text":"Report a decrease in S/D ratio resulting from nicotine and maternal smoking"},{"label":"D","text":"Show that absence of end-diastolic flow is normal at term"},{"label":"E","text":"Do not have a place in the clinical management of multiple gestations Antepartum Care and Fetal Surveillance 51 DIRECTIONS: Each group of questions below consists of lettered options followed by a set of numbered items. For each numbered item, select the one lettered option with which it is most closely associated. Each lettered option may be used once, more than once, or not at all. Items 78–82 Match each description with the appropriate fetal heart rate tracing. If none of the tracings apply, answer e (none). a. b. 52 Obstetrics and Gynecology c. d. Antepartum Care and Fetal Surveillance 53"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-008c356312b9","stem":"A 17-year-old primipara at 41 weeks wants an immediate cesarean section. She is being followed with biophysical profile testing. You tell her that","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Biophysical profile testing includes amniotic fluid volume, fetal breathing, fetal body movements, fetal body tone, and contraction stress testing"},{"label":"B","text":"The false-negative rate of the biophysical profile is 10%"},{"label":"C","text":"False-positive results on biophysical profile are rare"},{"label":"D","text":"Spontaneous decelerations during biophysical profile testing are associated with significant fetal morbidity"},{"label":"E","text":"A normal biophysical profile should be repeated in 1 week to 10 days in a post- term pregnancy"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-391f9da34875","stem":"A patient comes to your office with LMP 4 weeks ago. She denies any symptoms such as nausea, fatigue, urinary frequency, or breast tender- ness. She thinks that she may be pregnant because she has not gotten her period yet and is very anxious to find out because she has a history of a previous ectopic pregnancy and wants to be sure to get early prenatal care. Which of the following evaluation methods is most sensitive in diagnos- ing pregnancy?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"No evaluation to determine pregnancy is needed because the patient is asymp- tomatic and therefore cannot be pregnant"},{"label":"B","text":"Serum pregnancy test"},{"label":"C","text":"Detection of fetal heart tones by Doppler equipment"},{"label":"D","text":"Abdominal ultrasound"},{"label":"E","text":"Bimanual exam to assess uterine size 54 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-6e208af9c4ed","stem":"A patient presents for her first initial OB visit after performing a home pregnancy test and gives a last menstrual period of about 8 weeks ago. She says she is not entirely sure of her dates, however, because she has a long history of irregular menses. Which of the following is the most accurate way of dating the pregnancy?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Determination of uterine size on pelvic examination"},{"label":"B","text":"Quantitative serum HCG level"},{"label":"C","text":"Crown-rump length on abdominal or vaginal ultrasound"},{"label":"D","text":"Determination of progesterone level along with serum HCG level"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-bf1b93d2d210","stem":"A healthy 20-year-old G1P0 presents for her first OB visit at 10 weeks gestational age. She denies any significant medical history both personally and in her family. All of the following tests should be ordered as part of the initial prenatal care visit except","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"CBC"},{"label":"B","text":"HIV"},{"label":"C","text":"Hepatitis B surface antigen"},{"label":"D","text":"Type and screen"},{"label":"E","text":"One-hour glucola"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e804d14894a7","stem":"Your patient is a healthy 28-year-old G2P1001 at 20 weeks gestational age. Two years ago, she vaginally delivered at term a healthy baby boy weighing 6 lb, 8 oz. This pregnancy, she had a prepregnancy weight of 130 lb. She is 5 ft, 4 in. tall. She now weighs 140 lb and is extremely nervous that she is gaining too much weight. She is worried that the baby will be too big and require her to have a cesarean section. How do you counsel this patient?","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Her weight gain is excessive, and she needs to be referred for nutritional coun- seling to slow down her rate of weight gain"},{"label":"B","text":"Her weight gain is excessive, and you recommend that she undergo early glu- cola screening to rule out gestational diabetes"},{"label":"C","text":"She is gaining weight at a less than normal rate, and, with her history of a small- for-gestational-age baby, she should supplement her diet with extra calories"},{"label":"D","text":"During the pregnancy she should consume an additional 300 kcal/day vs. prepregnancy, and her weight gain so far is appropriate for her gestational age"},{"label":"E","text":"During the pregnancy she should consume an additional 600 kcal/day vs. prepregnancy, and her weight gain is appropriate for her gestational age Antepartum Care and Fetal Surveillance 55"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"ee59d5bc824bff49bc88b20ef3e8d650c13b0553"},{"id":"q-08c2aa6eba5f","stem":"A healthy 31-year-old G3P2002 patient presents to the obstetrician’s office at 34 weeks gestational age for a routine return visit. She has had an uneventful pregnancy to date. Her baseline blood pressures were 100–110/ 60–70, and she has gained a total of 20 lb so far. During the visit, the patient complains of bilateral pedal edema that sometimes causes her feet to ache at the end of the day. Her urine dip indicates trace protein, and her blood pressure in the office is currently 115/75. She denies any other symptoms or complaints. On physical exam, there is pitting edema of both legs without any calf tenderness. How should the obstetrician respond to the patient’s concern?","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Prescribe Lasix to relieve the painful swelling"},{"label":"B","text":"Immediately send the patient to the radiology department to have venous Doppler studies done to rule out deep vein thromboses"},{"label":"C","text":"Admit the patient to L and D to rule out preeclampsia"},{"label":"D","text":"Reassure the patient that this is a normal finding of pregnancy, and no treatment is needed"},{"label":"E","text":"Tell the patient that her leg swelling is due to too much salt intake and instruct her to go on a low-sodium diet"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f950b0ac116a","stem":"A 28-year-old G1P0 presents to your office at 18 weeks gestational age for an unscheduled visit secondary to right-sided groin pain. She describes the pain as sharp and occuring with movement and exercise. She denies any change in urinary or bowel habits. She also denies any fever or chills. The application of a heating pad helps alleviate the discomfort. As her obstetrician, what do you tell this patient is the most likely etiology of this pain?","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Round ligament pain"},{"label":"B","text":"Appendicitis"},{"label":"C","text":"Preterm labor"},{"label":"D","text":"Kidney stone"},{"label":"E","text":"Urinary tract infection 56 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-0fe22e54965a","stem":"A 32-year-old G3P2002 presents to the obstetrician’s office for a rou- tine OB visit at 30 weeks. She has had no complications during the preg- nancy and has had regular prenatal care. Her gestational age is confirmed with a first-trimester sonogram. During the routine OB visit, the fundal height measures 35 cm. All of the following can explain the size-date dis- crepancy except","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"The 5-cm difference is within the error for fundal height measurements"},{"label":"B","text":"Leiomyomas"},{"label":"C","text":"Polyhydramnios"},{"label":"D","text":"Fetal macrosomia"},{"label":"E","text":"Twin gestation"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7b7285886fcf","stem":"A 43-year-old G1P0 who conceived via in vitro fertilization comes into the office for her routine OB visit at 38 weeks. She denies any problems since she was seen the week before. She reports good fetal movement and denies any leakage of fluid per vagina, vaginal bleeding, or regular uterine contractions. She reports that sometimes she feels crampy at the end of the day when she gets home from work, but this discomfort is alleviated with getting off her feet. The fundal height measurement is 36 cm; it measured 37 cm the week before. Her cervical exam is 50/2/0. What is the appropri- ate next step in the management of this patient?","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Instruct the patient to return to the office in 1 week for her next routine visit"},{"label":"B","text":"Admit the patient for induction due to a diagnosis of fetal growth lag"},{"label":"C","text":"Send the patient for a sonogram to determine the amniotic fluid index"},{"label":"D","text":"Order the patient to undergo a nonstress test"},{"label":"E","text":"Do a fern test in the office"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["possible_multiple_questions_in_stem","topic_generic"],"cleaningOperations":[]},{"id":"q-ef9b0910f360","stem":"A pregnant women who is 7 weeks from her LMP comes in to the office for her first prenatal visit. Her previous pregnancy ended in a missed abortion in the first trimester. The patient therefore is very anxious about the well-being of this pregnancy. Which of the following modalities will allow you to best document fetal heart action?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Regular stethoscope"},{"label":"B","text":"Fetoscope"},{"label":"C","text":"Special fetal Doppler equipment"},{"label":"D","text":"Transvaginal sonogram Antepartum Care and Fetal Surveillance 57"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-d53685cd1a8a","stem":"A 30-year-old G2P1001 patient comes to see you in the office at 37 weeks gestational age for her routine OB visit. Her first pregnancy resulted in a vaginal delivery of a 9-lb, 8-oz baby boy after 30 min of pushing. On doing Leopold maneuvers during this office visit, you determine that the fetus is breech. Vaginal exam demonstrates that the cervix is 50% effaced and 1 to 2 cm dilated. The presenting breech is high out of the pelvis. The estimated fetal weight is about 7 lb. You send the patient for a sonogram, which confirms a fetus with a frank breech presentation. There is a normal amount of amniotic fluid present, and the head is well flexed. As the patient’s obstetrician, you offer all the following possible management plans except","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Allow the patient to undergo a vaginal breech delivery whenever she goes into labor"},{"label":"B","text":"Send the patient to labor and delivery immediately for an emergent cesarean section"},{"label":"C","text":"Schedule a cesarean section at or after 39 weeks gestational age"},{"label":"D","text":"Schedule an external cephalic version in the next few days"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c9075453692a","stem":"A healthy 23-year-old G1P0 has had an uncomplicated pregnancy to date. She is disappointed because she is 41 weeks gestational age by good dates and a first-trimester ultrasound and wants to have her baby. She feels like she has been pregnant forever, and wants to have her baby now. The patient reports good fetal movement; she has been doing kick counts for the past several days and reports that the baby moves about eight times an hour on average. On physical exam, her cervix is firm, posterior, 50% effaced, and 1 cm dilated, and the vertex is at a −1 station. As her obstetri- cian, which of the following would you recommend to the patient?","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"She should be admitted for an immediate cesarean section"},{"label":"B","text":"She should be admitted for Pitocin induction"},{"label":"C","text":"You will schedule a cesarean section in 1 week if she has not undergone spon- taneous labor in the meantime"},{"label":"D","text":"She should continue to monitor kick counts and to return to your office in 1 week to reassess the situation 58 Obstetrics and Gynecology Items 95–96 A 29-year-old G1P0 presents to the obstetrician’s office at 42 weeks gestation. On physical exam, her cervix is 50/1/−1. The patient declines induction because she wants to go into labor spontaneously. She agrees to undergo antepartum testing to evaluate fetal well-being."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-80d4bf4ae968","stem":"Which of the following modalities used to assess fetal health has the highest false-negative rate when administered weekly?","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Contraction stress test"},{"label":"B","text":"Nonstress test"},{"label":"C","text":"Biophysical profile"},{"label":"D","text":"Modified biophysical profile"},{"label":"E","text":"Nipple stimulation test"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-cff930d26339","stem":"The patient returns to the office still undelivered at 43 weeks gesta- tion. She agrees to undergo induction. Her cervix remains unchanged from the previous week. All of the following are options for cervical ripening except","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Gynecology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Gynecology","options":[{"label":"A","text":"Laminaria"},{"label":"B","text":"Cervidil"},{"label":"C","text":"Misoprostil"},{"label":"D","text":"Preperdil"},{"label":"E","text":"Pitocin Antepartum Care and Fetal Surveillance 59"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Gynecology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-001334abd7bd","stem":"A healthy 30-year-old G1P0 at 41 weeks gestational age presents to labor and delivery at 11:00 P.M. because she is concerned that her baby has not been moving as much as normal for the past 24 h. She denies any com- plications during the pregnancy. She denies any rupture of membranes, regular uterine contractions, or vaginal bleeding. On arrival to labor and delivery, her blood pressure is initially 140/90 but decreases with rest to 120/75. Her prenatal chart indicates that her baseline blood pressures are 100–120/60–70. The patient is placed on an external fetal monitor. The fetal heart rate baseline is 180 bpm with absent variability. There are uter- ine contractions every 3 min accompanied by late fetal heart rate decelera- tions. Physical exam indicates that the cervix is long/closed/−2. Which of the following is the appropriate plan of management for this patient?","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Proceed with emergent cesarean section"},{"label":"B","text":"Administer intravenous MgSO4 and induce labor with Pitocin"},{"label":"C","text":"Ripen cervix overnight with prostaglandin E2 (Cervidil) and proceed with Pitocin induction in the morning"},{"label":"D","text":"Admit the patient and schedule a cesarean section in the morning, after the patient has been NPO for 12 h"},{"label":"E","text":"Induce labor with misoprostil (Cytotec) Items 98–100 A 27-year-old G3P2002 who is 34 weeks gestational age calls the on- call obstetrician on a Saturday night at 10:00 P.M. complaining of decreased fetal movement. She says that for the past several hours, her baby has moved only once per hour. She is healthy, has had regular prenatal care, and denies any complications so far during the pregnancy."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["possible_multiple_questions_in_stem","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"e965f0fe4b5dda092e63ed5188f9605003e6fd7c"},{"id":"q-352febbbb8ea","stem":"How should the on-call physician counsel the patient?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Instruct the patient to go to labor and delivery for a contraction stress test"},{"label":"B","text":"Reassure the patient that one fetal movement per hour is within normal limits and she does not need to worry"},{"label":"C","text":"Recommend the patient be admitted to the hospital for delivery"},{"label":"D","text":"Counsel the patient that the baby is probably sleeping and that she should con- tinue to monitor fetal kicks. If she continues to experience less than five kicks per hour by morning, she should call you back for further instructions"},{"label":"E","text":"Instruct the patient to go to labor and delivery for a nonstress test 60 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-09ccd07e8c5d","stem":"The patient undergoes a biophysical profile in labor and delivery after her nonstress test proves to be nonreactive. All of the following are compo- nents of a BPP except","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Labor and Delivery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Labor and Delivery","options":[{"label":"A","text":"Contraction stress test"},{"label":"B","text":"Amniotic fluid volume"},{"label":"C","text":"Nonstress test"},{"label":"D","text":"Fetal breathing movements"},{"label":"E","text":"Fetal tone"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Labor and Delivery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-30ca401cb2fa","stem":"The patient receives a score of 8 on her biophysical profile. How should her obstetrician now counsel her?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The results are equivocal, and she should have a repeat BPP within 24 h"},{"label":"B","text":"The results are abnormal, and she should be induced"},{"label":"C","text":"The results are normal, and she can go home"},{"label":"D","text":"The results are abnormal, and she should undergo emergent cesarean section"},{"label":"E","text":"The results are abnormal, and she should undergo umbilical artery Doppler velocimetry Items 101–102 An 18-year-old G2P1001 with a last menstrual period of May 7 pre- sents for her first OB visit at 10 weeks. The patient had a previous preg- nancy complicated by gestational diabetes and delivered a 9-lb baby boy via cesarean section after a long labor."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c996d90cbf45","stem":"All of the following should be performed at each prenatal visit except","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Fetal heart tones by Doppler equipment"},{"label":"B","text":"Maternal weight"},{"label":"C","text":"Maternal blood pressure"},{"label":"D","text":"Urinalysis"},{"label":"E","text":"Real-time ultrasound for estimated fetal weight"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-fd5f3aaafd74","stem":"What is this patient’s estimated date of confinement?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"November 10"},{"label":"B","text":"February 10"},{"label":"C","text":"February 14"},{"label":"D","text":"November 14 Antepartum Care and Fetal Surveillance 61"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-b79d6fdf47a8","stem":"A healthy 30-year-old G3P2002 presents to the obstetrician’s office at 34 weeks for a routine prenatal visit. She has a history of two prior cesarean sections (low-transverse). The first cesarean section was performed sec- ondary to fetal malpresentation (footling breech). The patient then had an elective repeat cesarean section for her second pregnancy. This pregnancy, the patient has had an uncomplicated prenatal course. She tells her physi- cian that she would like to undergo a trial of labor during this pregnancy. However, the patient is interested in permanent sterilization and wonders if it would be better to undergo another scheduled cesarean section so she can have a bilateral tubal ligation performed at the same time. Which of the following statements is true and should be relayed to the patient?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"A history of two previous cesarean sections is a contraindication to vaginal birth after cesarean section (VBAC)"},{"label":"B","text":"Her risk of uterine rupture with attempted VBAC after two prior cesarean sec- tions is 4 to 9%"},{"label":"C","text":"Her chance of having a successful VBAC is less than 60%"},{"label":"D","text":"The patient should schedule an elective induction if not delivered by 40 weeks"},{"label":"E","text":"If the patient desires a bilateral tubal ligation, it is safer for her to undergo a vaginal delivery followed by a postpartum tubal ligation rather than an elective repeat cesarean section with intrapartum bilateral tubal ligation"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0c32095578df","stem":"Which of the following clinical conditions is not an indication for induction of labor?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Labor and Delivery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Labor and Delivery","options":[{"label":"A","text":"Intrauterine fetal demise"},{"label":"B","text":"Severe preeclampsia at 36 weeks"},{"label":"C","text":"Complete placenta previa"},{"label":"D","text":"Chorioamnionitis"},{"label":"E","text":"Postterm pregnancy 62 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Labor and Delivery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-ac714c8ef800","stem":"year-old G3P2002 who is 35 weeks calls you complaining of lower back pain. The patient informs you that she had been lifting some heavy boxes while fixing up the baby’s nursery. The patient’s pregnancy has been com- plicated by diet-controlled gestational diabetes. The patient denies any regular uterine contractions, rupture of membranes, vaginal bleeding, or dysuria. She denies any fever, chills, nausea, or emesis. She reports that the baby has been moving normally. On physical exam, you note that the patient is obese; her cervix is long and closed. Her abdomen is soft and nontender with no palpable uterine contractions. No flank pain can be elicited. She is afebrile. The external monitor indicates a reactive fetal heart rate strip; there are rare irregular uterine contractions demonstrated on toco. The patient’s urinalysis comes back with trace glucose and protein, and is otherwise negative. The patient’s most likely diagnosis is which of the following?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Labor"},{"label":"B","text":"Musculoskeletal pain"},{"label":"C","text":"Urinary tract infection"},{"label":"D","text":"Chorioamnionitis"},{"label":"E","text":"Round ligament pain Antepartum Care and Fetal Surveillance Answers"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-3a862e87b751","stem":"Which of the following statements concerning abdominal pregnancy is correct?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Gastrointestinal symptoms are quite often severe"},{"label":"B","text":"Fetal survival is approximately 50%"},{"label":"C","text":"Aggressive attempts should be made to remove the placenta at the time of ini- tial surgery"},{"label":"D","text":"It may result in infectious morbidity prior to the diagnosis"},{"label":"E","text":"It is usually the result of a primary abdominal implantation"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6ac18d88d8bf","stem":"Which of the following statements concerning placenta previa is true?","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Its incidence decreases with maternal age"},{"label":"B","text":"Its incidence is unaffected by parity"},{"label":"C","text":"The initial hemorrhage is usually painless and rarely fatal"},{"label":"D","text":"Management no longer includes a double setup"},{"label":"E","text":"Vaginal examination should be done immediately on suspicion of placenta previa"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-578fecc0ffac","stem":"A patient at 17 weeks gestation is diagnosed as having an intrauter- ine fetal demise. She returns to your office 5 weeks later and has not had a miscarriage, although she has had some occasional spotting. This patient is at increased risk for","type":"OSCE / Practical Station","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Septic abortion"},{"label":"B","text":"Recurrent abortion"},{"label":"C","text":"Consumptive coagulopathy with hypofibrinogenemia"},{"label":"D","text":"Future infertility"},{"label":"E","text":"Ectopic pregnancies 75 Copyright © 2004 by the McGraw-Hill Companies, Inc. Click here for Terms of Use. 76 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["source_attribution_in_option","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-314e7fb40ce3","stem":"A 24-year-old presents at 30 weeks with a fundal height of 50 cm. Which of the following statements concerning polyhydramnios is true?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Acute polyhydramnios always leads to labor prior to 28 weeks"},{"label":"B","text":"The incidence of associated malformations is approximately 3%"},{"label":"C","text":"Maternal edema, especially of the lower extremities and vulva, is rare"},{"label":"D","text":"Esophageal atresia is accompanied by polyhydramnios in nearly 10% of cases"},{"label":"E","text":"Complications include placental abruption, uterine dysfunction, and postpar- tum hemorrhage"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-fa8c5b1ecb92","stem":"True statements about pregnancy-induced hypertension include which of the following?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"The incidence varies little around the world"},{"label":"B","text":"Women who have had hypertension of pregnancy once have a 10% chance of developing it in a later pregnancy"},{"label":"C","text":"Elevations in systolic or diastolic blood pressures do not become diagnostically significant until blood pressure values reach 140/90 mmHg"},{"label":"D","text":"Young primiparous women have the lowest incidence"},{"label":"E","text":"Having a baby by a different father increases the risk of preeclampsia in a multi- gravid woman"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-33484a537b8b","stem":"True statements about the twin-to-twin transfusion syndrome include which of the following?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The donor twin develops hydramnios more often than does the recipient twin"},{"label":"B","text":"Gross differences may be observed between donor and recipient placentas"},{"label":"C","text":"The donor twin usually suffers from a hemolytic anemia"},{"label":"D","text":"The donor twin is more likely to develop widespread thromboses"},{"label":"E","text":"The donor twin often develops polycythemia"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4355b9312d12","stem":"Which of the following is consistent with a decision to perform a cerclage?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Uterine contractions"},{"label":"B","text":"Cervix dilated to 3 cm"},{"label":"C","text":"Uterine bleeding"},{"label":"D","text":"Gestation of 26 weeks"},{"label":"E","text":"Chorioamnionitis Obstetrical Complications of Pregnancy 77 DIRECTIONS: Each group of questions below consists of lettered options followed by a set of numbered items. For each numbered item, select the one lettered option with which it is most closely associated. Each lettered option may be used once, more than once, or not at all. Items 113–117 Match each description with the correct type of abortion."},{"label":"A","text":"Complete abortion"},{"label":"B","text":"Incomplete abortion"},{"label":"C","text":"Threatened abortion"},{"label":"D","text":"Missed abortion"},{"label":"E","text":"Inevitable abortion"}],"priority":1,"status":"review","flags":["topic_generic","too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","too_many_options","too_many_options_possible_merge","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-66e1f36b38a8","stem":"The most likely diagnosis of this woman’s condition is","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Sarcoma botryoides"},{"label":"B","text":"Tuberculous endometritis"},{"label":"C","text":"Adenocarcinoma of the uterus"},{"label":"D","text":"Hydatidiform mole"},{"label":"E","text":"Normal pregnancy Obstetrical Complications of Pregnancy 79"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"9ac0a32a1e639d0b9741f2545d2d523495b5d86a"},{"id":"q-6cd2bb5d2c07","stem":"After uterine evacuation, management of the woman described above, who has no clinical or radiographic evidence of metastatic disease, should include","type":"Radiological Interpretation","subject":"Radiography and Medical Imaging","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Weekly hCG titers"},{"label":"B","text":"Hysterectomy"},{"label":"C","text":"Single-agent chemotherapy"},{"label":"D","text":"Combination chemotherapy"},{"label":"E","text":"Radiation therapy"}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Radiography and Medical Imaging","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-6b0d5fbf29f8","stem":"Indications for instituting single-agent chemotherapy following evacuation of a hydatidiform mole usually include","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A rise in hCG titers"},{"label":"B","text":"A plateau of hCG titers for 1 week"},{"label":"C","text":"Return of hCG titer to normal at 6 weeks after evacuation"},{"label":"D","text":"Appearance of liver metastasis"},{"label":"E","text":"Appearance of brain metastasis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b3b927b2d10e","stem":"A 32-year-old G3P3 presents with abdominal pain. Her last men- strual period was 6 weeks ago, and a pregnancy test is positive. The speci- men shown below is obtained at laparotomy. The most likely diagnosis is","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Incomplete abortion"},{"label":"B","text":"Missed abortion"},{"label":"C","text":"Hydatidiform mole"},{"label":"D","text":"Tubal ectopic pregnancy"},{"label":"E","text":"Ovarian pregnancy 80 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-82f18e7b7636","stem":"A 19-year-old woman comes to the emergency room and reports that she fainted at work earlier in the day. She has mild vaginal bleeding. Her abdomen is diffusely tender and distended. In addition, she complains of shoulder and abdominal pain. Her temperature is 97.6°F, pulse rate is 120/min, and blood pressure is 96/50 mmHg. To confirm the diagnosis suggested by the available clinical data, the best diagnostic procedure is","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Pregnancy test"},{"label":"B","text":"Posterior colpotomy"},{"label":"C","text":"Dilation and curettage"},{"label":"D","text":"Culdocentesis"},{"label":"E","text":"Laparoscopy"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6c1c13b4ebe0","stem":"In comparing laparoscopic salpingostomy vs. laparotomy with sal- pingectomy for the treatment of ectopic pregnancy, laparoscopic therapy results in","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Decreased hospital stays"},{"label":"B","text":"Lower fertility rate"},{"label":"C","text":"Lower repeat ectopic pregnancy rate"},{"label":"D","text":"Comparable persistent ectopic tissue rate"},{"label":"E","text":"Greater scar formation"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-941a518370c4","stem":"A 27-year-old has just had an ectopic pregnancy. Which of the fol- lowing events would be most likely to predispose to ectopic pregnancy?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Previous tubal surgery"},{"label":"B","text":"Pelvic inflammatory disease (PID)"},{"label":"C","text":"Use of a contraceptive uterine device (IUD)"},{"label":"D","text":"Induction of ovulation"},{"label":"E","text":"Exposure in utero to diethylstilbestrol (DES)"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"3e714902b62cabb44de2565fc861c3e34b7fb894"},{"id":"q-1335799e465d","stem":"Nausea and vomiting are common in pregnancy. Hyperemesis gravi- darum, however, is a much more serious and potentially fatal problem. Findings that should alert the physician to the diagnosis of hyperemesis gravidarum early in its course include","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Electrocardiographic evidence of hypokalemia"},{"label":"B","text":"Metabolic acidosis"},{"label":"C","text":"Jaundice"},{"label":"D","text":"Ketonuria Obstetrical Complications of Pregnancy 81"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-ab2dff690fdd","stem":"A 32-year-old G2P0101 presents to labor and delivery at 34 weeks of gestation, complaining of regular uterine contractions about every 5 min for the past several hours. She has also noticed the passage of a clear fluid per vagina. A nurse places the patient on an external fetal monitor and calls you to evaluate her status. The external fetal monitor demonstrates a reac- tive fetal heart rate tracing, with regular uterine contractions occurring about every 3 to 4 min. On sterile speculum exam, the cervix is visually closed. A sample of pooled amniotic fluid seen in the vaginal vault is fern- and nitrazine-positive. The patient has a temperature of 102°F, P = 102, and her fundus is tender to deep palpation. Her admission blood work comes back indicating a WBC of 19,000. The patient is very concerned because she had previously delivered a baby at 35 weeks who suffered from respiratory distress syndrome. You perform a bedside sonogram, which indicates oligohydramnios and a fetus whose size is appropriate for gesta- tional age and with a cephalic presentation. What is the next appropriate step in the management of this patient?","type":"OSCE / Practical Station","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Administer betamethasone"},{"label":"B","text":"Administer tocolytics"},{"label":"C","text":"Place a cervical cerclage"},{"label":"D","text":"Administer antibiotics"},{"label":"E","text":"Perform emergent cesarean section 82 Obstetrics and Gynecology Items 127–130 A 30-year-old G1P0 with a twin gestation at 25 weeks presents to labor and delivery complaining of irregular uterine contractions and back pain. She reports an increase in the amount of her vaginal discharge, but denies any rupture of membranes. She reports that earlier in the day she had some very light vaginal bleeding, which has now resolved. She says that the babies have been active and moving as much as usual. She thinks that she may be feeling cramping because she may have overdone it with too much activity and lifting as she is trying to fix up the nursery to get it ready for the babies. She denies any change in her bowel or urine habits. She reports having had regular prenatal care during the pregnancy and denies any prior problems or complications. On arrival to L and D, she is placed on an external fetal monitor, which indicates uterine contractions every 2 to 4 min. She is afebrile and her vital signs are all normal. Her gravid uterus is nontender. The nurses call you to evaluate the patient."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-e6b78edcd608","stem":"All of the following are appropriate next steps in the evaluation of this patient except","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Sterile digital exam"},{"label":"B","text":"Intravenous hydration"},{"label":"C","text":"Bedside ultrasound"},{"label":"D","text":"Urinalyis and urine culture"},{"label":"E","text":"Rectovaginal swab for B strep"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2021919aebad","stem":"A bedside ultrasound examination indicates that both fetuses are in the cephalic presentation and rules out the presence of a placenta previa. A sterile speculum exam is then performed, and a vaginal swab is obtained to perform a fern test on the vaginal discharge. The fern and nitrazine tests are negative. A subsequent digital exam indicates that the cervix is 50/2–3/−3. All of the following are appropriate next steps to manage this patient except","type":"Radiological Interpretation","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Prep the patient for an emergent cesarean section"},{"label":"B","text":"Administer tocolytics"},{"label":"C","text":"Administer betamethasone"},{"label":"D","text":"Administer antibiotics"},{"label":"E","text":"Obtain a neonatal consultation Obstetrical Complications of Pregnancy 83"}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-f44c48306b5b","stem":"A maternal fetal medicine specialist is consulted and performs an in- depth sonogram. The sonogram indicates that the fetuses are both male, and the placenta appears to be diamniotic and monochorionic. Twin B is noted to have oligohydramnios and to be much smaller than twin A. In this clinical picture, all of the following are concerns for twin A except","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Congestive heart failure"},{"label":"B","text":"Anemia"},{"label":"C","text":"Hypervolemia"},{"label":"D","text":"Polycythemia"},{"label":"E","text":"Hydramnios"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4c37c3b12068","stem":"All of the following are appropriate tocolytics for this patient except","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Indocin"},{"label":"B","text":"Nifedipine"},{"label":"C","text":"Terbutaline"},{"label":"D","text":"Ritodrine"},{"label":"E","text":"Magnesium sulfate 84 Obstetrics and Gynecology Items 131–135 A healthy 42-year-old G2P1001 presents to labor and delivery at 30 weeks gestation complaining of a small amount of bright red blood per vagina earlier in the day. The bleeding occurred shortly after intercourse. It started off as spotting and then progressed to a light menses. By the time the patient arrived at L and D, the bleeding had completely resolved. The patient denies any regular uterine contractions, but admits to occasional abdominal cramping. She reports the presence of good fetal movements. She denies any complications during the pregnancy. She had a normal screening sonogram at 20 weeks as part of her routine prenatal care. Her obstetrical history is significant for a previous low transverse cesarean sec- tion at term for a fetus that was footling breech. She wants to have an elec- tive repeat cesarean section with a tubal ligation for delivery of this baby when she gets to term."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-4a6215b44181","stem":"All of the following should be included in the list of differential diag- noses for the bleeding except","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cervicitis"},{"label":"B","text":"Preterm labor"},{"label":"C","text":"Placental abruption"},{"label":"D","text":"Placenta previa"},{"label":"E","text":"Subserous pedunculated uterine fibroid"},{"label":"F","text":"Uterine rupture"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-42f68d4454cc","stem":"What is the appropriate next step in the management of this patient?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Send her home, since the bleeding has completely resolved and she is experi- encing good fetal movements"},{"label":"B","text":"Perform a sterile digital exam"},{"label":"C","text":"Perform an amniocentesis to rule out infection"},{"label":"D","text":"Perform a sterile speculum exam"},{"label":"E","text":"Perform an ultrasound exam Obstetrical Complications of Pregnancy 85"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-491fb89a943d","stem":"The patient is placed on an external monitor after a bedside ultra- sound exam reveals a partial placenta previa. No uterine contractions are demonstrated, but she starts to bleed heavily. All of the following are appropriate next steps except","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Administer intramuscular terbutaline as soon as possible"},{"label":"B","text":"Type and cross the patient for four units of packed red blood cells"},{"label":"C","text":"Administer an intravenous fluid bolus"},{"label":"D","text":"Place a Foley catheter"},{"label":"E","text":"Call anesthesia"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-eb435f09309d","stem":"The patient continues to bleed, and you observe persistent late decel- erations on the fetal heart monitor with loss of variability in the baseline. Her blood pressure and pulse are normal. You explain to the patient that she needs to be delivered. You counsel her regarding all of the following except","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"She may require a blood transfusion"},{"label":"B","text":"She may require a cesarean hysterectomy"},{"label":"C","text":"Tubal ligation is recommended at the time of cesarean section"},{"label":"D","text":"The baby may require resuscitative measures at delivery"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7f927bcbca89","stem":"The patient is delivered by cesarean section under general anesthesia. The baby and placenta are easily delivered, but the uterus is noted to be boggy and atonic despite intravenous infusion of Pitocin. All of the follow- ing are appropriate agents to use next except","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Labor and Delivery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Labor and Delivery","options":[{"label":"A","text":"Methylergonovine (Methergine) administered intramuscularly"},{"label":"B","text":"Prostaglandin F2α (Hemabate) suppositories"},{"label":"C","text":"Misoprostil (Cytotec) suppositories"},{"label":"D","text":"Terbutaline administered intravenously"},{"label":"E","text":"Prostaglandin E2 suppositories 86 Obstetrics and Gynecology Items 136–139 A 40-year-old G2P1001 presents to your office for a routine OB visit at 30 weeks gestational age. Her first pregnancy was delivered 10 years ago and was uncomplicated. She had an NSVD, and her baby delivered at 40 weeks and weighed 7 lb. During this present pregnancy, she has not had any complications, and she reports no significant medical history. She is a nonsmoker and has gained about 25 lb to date. Despite being of advanced maternal age, she declined any screening or diagnostic testing for Down syndrome. Her blood pressure range has been 100–120/60–70. During her exam, you note that her fundal height measures only 25 cm."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Labor and Delivery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-dbe39fd61c2e","stem":"All of the following are possible explanations for this patient’s de- creased fundal height except","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Oligohydramnios"},{"label":"B","text":"Intrauterine growth restriction of the fetus"},{"label":"C","text":"The presence of fibroid tumors in the uterus"},{"label":"D","text":"Incorrect dates"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8570ad1d346d","stem":"An ultrasound is performed by the maternal fetal medicine specialist. The estimated fetal weight is determined to be in the fifth percentile for the estimated gestational age. The biparietal diameter and abdominal circum- ference are concordant in size. All of the following are commonly associ- ated symmetric growth retardation except","type":"OSCE / Practical Station","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Nutritional deficiencies"},{"label":"B","text":"Chromosome abnormalities"},{"label":"C","text":"Intrauterine infections"},{"label":"D","text":"Congenital anomalies"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e3bd7325eda7","stem":"All of the following can be used to determine a chromosome analysis of the fetus except","type":"Single Best Answer MCQ","subject":"Medical Genetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Amniocentesis"},{"label":"B","text":"Chorionic villus sampling"},{"label":"C","text":"Percutaneous umbilical blood sampling (PUBS)"},{"label":"D","text":"Fetal umbilical Doppler velocimetry Obstetrical Complications of Pregnancy 87"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Genetics","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-fecc376b466b","stem":"At the time of delivery, the fetus would be prone to all of the follow- ing neonatal complications except","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Labor and Delivery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Labor and Delivery","options":[{"label":"A","text":"Meconium aspiration"},{"label":"B","text":"Hypothermia"},{"label":"C","text":"Hyperglycemia"},{"label":"D","text":"Polycythemia"},{"label":"E","text":"Hypoxia Items 140–142 A 38-year-old G3P1011 comes to see you for her first prenatal visit at 10 weeks gestational age. She had a previous term vaginal delivery without any complications. You detect fetal heart tones at this visit, and her uterine size is consistent with dates. You also draw her prenatal labs at this visit and tell her to follow up in 4 weeks for a return OB visit."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Labor and Delivery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a1e67bfc3107","stem":"Two weeks later, the results of the patient’s prenatal labs come back. Her blood type is A−, with an anti-D antibody titer of 1:4. What is the most appropriate next step in the management of this patient?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Schedule an amniocentesis for amniotic fluid bilirubin at 16 weeks"},{"label":"B","text":"Repeat the titer in 4 weeks"},{"label":"C","text":"Repeat the titer at 28 weeks"},{"label":"D","text":"Schedule PUBS to determine fetal hematocrit at 20 weeks"},{"label":"E","text":"Schedule PUBS as soon as possible to determine fetal blood type"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b644b2dea6e4","stem":"All of the following are scenarios in which it would have been appro- priate to administer RhoGam to this patient in the past except","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"After a spontaneous first-trimester abortion"},{"label":"B","text":"After treatment for ectopic pregnancy"},{"label":"C","text":"Within 3 days of delivering an Rh−fetus"},{"label":"D","text":"At the time of amniocentesis"},{"label":"E","text":"At the time of external cephalic version 88 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-43526c30e829","stem":"At 29 weeks gestational age, it becomes apparent that the fetus has developed hydrops. All of the following are characteristics of fetal hydrops except","type":"OSCE / Practical Station","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Polyhydramnios"},{"label":"B","text":"Small placenta"},{"label":"C","text":"Pericardial effusion"},{"label":"D","text":"Ascites"},{"label":"E","text":"Subcutaneous edema Items 143–145 A 39-year-old G1P0 at 39 weeks gestational age is sent to labor and delivery from her obstetrician’s office because of a blood pressure reading of 150/100 obtained during a routine OB visit. Her baseline blood pres- sures during the pregnancy were 100–120/60–70. On arrival to labor and delivery, the patient denies any headache, visual changes, nausea, vomit- ing, or abdominal pain. The heart rate strip is reactive and the tocody- namometer indicates irregular uterine contractions. The patient’s cervix is 50/2–3/0. Her repeat BP is 160/90. Hematocrit is 34.0, platelets are 160,000, SGOT is 22, SGPT is 15, and urinalysis is negative for protein."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","topic_generic"],"cleaningOperations":[]},{"id":"q-adaffc072884","stem":"Which of the following is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Preeclampsia"},{"label":"B","text":"Chronic hypertension"},{"label":"C","text":"Chronic hypertension with superimposed preeclampsia"},{"label":"D","text":"Eclampsia"},{"label":"E","text":"Pregnancy-induced hypertension (gestational hypertension) Obstetrical Complications of Pregnancy 89"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"706f9218180d46a04a614a5906790cf373eeac6e"},{"id":"q-6e0e38d7f134","stem":"While the patient is being monitored, she rings the bell for the nurse because she is developing a headache and feels funny. As you and the nurse enter the room, you witness the patient undergoing a tonic-clonic seizure. You secure the patient’s airway, and within a few minutes the seizure is over. The patient’s blood pressure monitor indicates a pressure of 160/110. You glance over at the fetal heart rate tracing and notice a bradycardia down to the sixties. All of the following are appropriate next steps in the management of this patient except","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Plan for induction of labor with amniotomy and Pitocin"},{"label":"B","text":"Prepare for emergent cesarean section because the patient is eclamptic"},{"label":"C","text":"Lower the patient’s blood pressure with hydralazine"},{"label":"D","text":"Begin magnesium sulfate intravenously to prevent recurrent seizures"},{"label":"E","text":"Place a Foley catheter"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-73da6b987bad","stem":"All of the following would be indications that the patient is receiving too much MgSO4 and needs her infusion dose lowered except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Hyperreflexia"},{"label":"B","text":"Disappearance of patellar reflexes"},{"label":"C","text":"Respiratory depression"},{"label":"D","text":"Somnolence"},{"label":"E","text":"Slurred speech Obstetrical Complications of Pregnancy Answers"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-b0f343d221ba","stem":"A 33-year-old has an infection in pregnancy. Which of the following is a reinfection, and therefore not a risk to the fetus?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Group B coxsackievirus"},{"label":"B","text":"Rubella virus"},{"label":"C","text":"Chickenpox virus"},{"label":"D","text":"Shingles"},{"label":"E","text":"Herpesvirus hominus type 2"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1054d61ae78c","stem":"Viremia and the presence of rubella virus in the throat of infected persons bear which of the following relationships to the onset of the rubella rash?","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"They precede the rash by 5 to 7 days"},{"label":"B","text":"They precede the rash by 1 to 2 days"},{"label":"C","text":"They occur coincidentally with the rash"},{"label":"D","text":"They occur 1 to 2 days after the rash"},{"label":"E","text":"They bear no consistent relationship to the onset of the rash 103 Copyright © 2004 by the McGraw-Hill Companies, Inc. Click here for Terms of Use. 104 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["source_attribution_in_option"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-a1b3bb18dfc0","stem":"A pregnant woman is discovered to be an asymptomatic carrier of Neisseria gonorrhoeae. A year ago, she was treated with penicillin for a gono- coccal infection and developed a severe allergic reaction. Treatment of choice at this time is","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Tetracycline"},{"label":"B","text":"Ampicillin"},{"label":"C","text":"Spectinomycin"},{"label":"D","text":"Chloramphenicol"},{"label":"E","text":"Penicillin"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-401b3e01a363","stem":"A 22-year-old has just been diagnosed with toxoplasmosis. You try to determine what her risk factors were. The highest risk association is","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Eating raw meat"},{"label":"B","text":"Eating raw fish"},{"label":"C","text":"Having a dog"},{"label":"D","text":"Being English"},{"label":"E","text":"Having viral infections in early pregnancy Medical and Surgical Complications of Pregnancy 105 DIRECTIONS: Each group of questions below consists of lettered options followed by a set of numbered items. For each numbered item, select the one lettered option with which it is most closely associated. Each lettered option may be used once, more than once, or not at all. Items 150–154 For each description, select the microorganism with which it is most likely to be associated."},{"label":"A","text":"Rubella virus"},{"label":"B","text":"Cytomegalovirus"},{"label":"C","text":"Group A β-hemolytic streptococci"},{"label":"D","text":"Group B β-hemolytic streptococci"},{"label":"E","text":"Toxoplasma gondii"}],"priority":1,"status":"review","flags":["topic_generic","too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","long_option_manual_review","nonunique_option_labels","prior_structural_review_flag","too_many_options","too_many_options_possible_merge","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-2038061d5692","stem":"Vaccination should be administered postpartum to nonimmune women. (SELECT 1 ORGANISM) 106 Obstetrics and Gynecology Items 155–158 For each syndrome or disease, choose the virus that is responsible when the fetus is exposed in utero.","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Labor and Delivery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Labor and Delivery","options":[{"label":"A","text":"Cytomegalovirus"},{"label":"B","text":"Rubella"},{"label":"C","text":"Varicella zoster"},{"label":"D","text":"Rubeola"},{"label":"E","text":"Hepatitis B"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Labor and Delivery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-c620bebfc901","stem":"Which of the following statements concerning appendicitis in preg- nancy is true?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Abdominal Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Abdominal Surgery","options":[{"label":"A","text":"Diagnosis is similar to that in the nonpregnant patient"},{"label":"B","text":"The maternal death rate is highest in the first trimester"},{"label":"C","text":"Surgical treatment should be delayed until the diagnosis is firmly established"},{"label":"D","text":"The incidence is unchanged by pregnancy"},{"label":"E","text":"The rate of fetal loss is about 50% Medical and Surgical Complications of Pregnancy 107"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Abdominal Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-24f5aecaf936","stem":"A 24-year-old woman appears at 8 weeks of pregnancy and reveals a history of pulmonary embolism 7 years ago during her first pregnancy. She was treated with intravenous heparin followed by several months of oral warfarin (Coumadin) and has had no further evidence of thromboembolic disease for over 6 years. Which of the following statements about her cur- rent condition is true?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Having no evidence of disease for over 5 years means that the risk of throm- boembolism is not greater than normal"},{"label":"B","text":"Impedance plethysmography is not a useful study to evaluate for deep venous thrombosis in pregnancy"},{"label":"C","text":"Doppler ultrasonography is not a useful technique to evaluate for deep venous thrombosis in pregnancy"},{"label":"D","text":"The patient should be placed on low-dose heparin therapy throughout preg- nancy and puerperium"},{"label":"E","text":"The patient is at highest risk for recurrent thromboembolism during the second trimester of pregnancy 108 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-8d5f857e06da","stem":"A 29-year-old G3P2 black woman in the thirty-third week of gesta- tion is admitted to the emergency room because of acute abdominal pain that has been increasing during the past 24 h. The pain is severe and is radiating from the epigastrium to the back. The patient has vomited a few times and has not eaten or had a bowel movement since the pain started. On examination, you observe an acutely ill patient lying on the bed with her knees drawn up. Her blood pressure is 150/100 mmHg, her pulse is 110/min, and her temperature is 38.8°C (100.8°F). On palpation, the abdomen is somewhat distended and tender, mainly in the epigastric area, and the uterine fundus reaches 31 cm above the symphysis. Hypotonic bowel sounds are noted. Fetal monitoring reveals a normal pattern of fetal heart rate (FHR) without uterine contractions. On ultrasonography, the fetus is in vertex presentation and appropriate in size for gestational age; fetal breathing and trunk movements are noted, and the volume of amni- otic fluid is normal. The placenta is located on the anterior uterine wall and of grade 2 to 3. Laboratory values show mild leukocytosis (12,000 cells per μL); a hematocrit of 43; mildly elevated serum glutamic-oxaloacetic transaminase (SGOT), serum glutamic-pyruvic transaminase (SGPT), and bilirubin; and serum amylase of 180 U/dL. Urinalysis is normal. The most probable diagnosis in this patient is","type":"OSCE / Practical Station","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Acute degeneration of uterine leiomyoma"},{"label":"B","text":"Acute cholecystitis"},{"label":"C","text":"Acute pancreatitis"},{"label":"D","text":"Acute appendicitis"},{"label":"E","text":"Severe preeclamptic toxemia"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-ce51cfe96dc0","stem":"An 18-year-old has asymptomatic bacteriuria at her first prenatal visit at 15 weeks gestation. Which of the following statements is true?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The prevalence of ASB during pregnancy may be as great as 30%"},{"label":"B","text":"There is a decreased incidence of ASB in multiparas with sickle cell trait"},{"label":"C","text":"Fifteen percent of women develop a urinary tract infection after an initial nega- tive urine culture"},{"label":"D","text":"Ten percent of women with ASB subsequently develop an acute symptomatic urinary infection during that pregnancy"},{"label":"E","text":"One percent of women with ASB have pyelographic evidence of chronic infec- tion or congenital abnormalities of the urinary tract Medical and Surgical Complications of Pregnancy 109"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-db3f2f5fcec8","stem":"When treating urinary tract infection (UTI) in the third trimester, the antibiotic of choice should be","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Cephalosporin"},{"label":"B","text":"Tetracycline"},{"label":"C","text":"Sulfonamide"},{"label":"D","text":"Nitrofurantoin"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-4be5ffb47468","stem":"A 30-year-old class D diabetic is concerned about pregnancy. She can be assured that which of the following risks is the same for her as for the general population?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Preeclampsia and eclampsia"},{"label":"B","text":"Infection"},{"label":"C","text":"Fetal cystic fibrosis"},{"label":"D","text":"Postpartum hemorrhage after vaginal delivery"},{"label":"E","text":"Hydramnios"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9cd19aeea76c","stem":"You are called in to evaluate the heart of a 19-year-old primigravida at term. Listening carefully to the heart, you determine that there is a split S1, normal S2, S3 easily audible with a 2/6 systolic ejection murmur greater during inspiration, and a soft diastolic murmur. You immediately recognize that","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The presence of the S3 is abnormal"},{"label":"B","text":"The systolic ejection murmur is unusual in a pregnant woman at term"},{"label":"C","text":"Diastolic murmurs are rare in pregnant women"},{"label":"D","text":"The combination of a prominent S3 and soft diastolic murmur is a significant abnormality"},{"label":"E","text":"All findings recorded are normal changes in pregnancy"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-235c530813a3","stem":"A 21-year-old has a positive purified protein derivative (PPD) and is about to be treated for tuberculosis. She can be reassured that her risk of which of the following is minimal?","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Respiratory Medicine","topicOriginal":"Respiratory Medicine","subtopic":"Tuberculosis","suggestedTopic":null,"options":[{"label":"A","text":"A flulike syndrome caused by rifampin"},{"label":"B","text":"A peripheral neuropathy caused by isoniazid"},{"label":"C","text":"Optic neuritis caused by INH"},{"label":"D","text":"Ototoxicity as a side effect of streptomycin"},{"label":"E","text":"A positive antinuclear antibody (ANA) titer with INH therapy 110 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Respiratory Medicine","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"02b4fc9f0651a7c9cd540f5ef6d28f99297fe9d5"},{"id":"q-2a728fcbba8c","stem":"Which of the following statements concerning hepatitis infection in pregnancy is true?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Hepatitis B core antigen status is the most sensitive indicator of positive vertical transmission of disease"},{"label":"B","text":"Hepatitis B is the most common form of hepatitis after blood transfusion"},{"label":"C","text":"The proper treatment of infants born to infected mothers includes the adminis- tration of hepatitis B immune globulin as well as Heptavax-B"},{"label":"D","text":"Patients who develop chronic active hepatitis should undergo therapeutic abor- tion Items 168–169 A 38-year-old G1P0 presents to the obstetrician’s office at 37 weeks gestational age complaining of a rash on her abdomen that is becoming increasingly pruritic. The rash started on her abdomen, and the patient notes that it is starting to spread downward to her thighs. The patient reports no previous history of any skin disorders or problems. She denies any malaise or fever. On physical exam, her physician notes that her abdomen, and most notably her stretch marks, are covered with red papules and plaques. No excoriations or bullae are present. The patient’s face, arms, and legs are unaffected by the rash."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","topic_generic"],"cleaningOperations":[]},{"id":"q-f0a622415030","stem":"What is this patient’s most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Herpes gestationis"},{"label":"B","text":"PUPPP"},{"label":"C","text":"Prurigo gravidarum"},{"label":"D","text":"Intrahepatic cholestasis of pregnancy"},{"label":"E","text":"Impetigo herpetiformis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"05634f6e4e9ba3bf8af79964ebb2bf1a906c10ce"},{"id":"q-118d7e180a7c","stem":"What would be the recommended first-line treatment for this patient?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Delivery"},{"label":"B","text":"Cholestyramine"},{"label":"C","text":"Topical steroids and antihistamines"},{"label":"D","text":"Oral steroids"},{"label":"E","text":"Antibiotic therapy Medical and Surgical Complications of Pregnancy 111"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-360f8d2e42cd","stem":"A 23-year-old G33P2002 presents for a routine OB visit at 34 weeks. She reports a history of genital herpes for 5 years. She reports that she has had only two outbreaks during the pregnancy, but is very concerned about the possibility of transmitting this infection to her baby. Which of the fol- lowing statements is accurate regarding how this patient should be coun- seled?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"There is no risk of neonatal infection during a vaginal delivery if no lesions are present at the time the patient goes into labor"},{"label":"B","text":"The patient should be scheduled for an elective cesarean section at 39 weeks of gestation to avoid neonatal infection"},{"label":"C","text":"Starting at 36 weeks, weekly genital herpes cultures should be done"},{"label":"D","text":"The herpes virus is commonly transmitted across the placenta in a patient with a history of herpes"},{"label":"E","text":"Suppressive antiviral therapy can be started at 36 weeks to help prevent an out- break from occurring at the time of delivery Items 171–172 A 35-year-old G1P0 presents to her obstetrician’s office at 8 weeks ges- tation. She has a history of type I diabetes and is very concerned regarding the possible risks this illness may have on her fetus."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-38b39b93823c","stem":"As the patient’s physician, you tell her that all of the following are possible risks that can result from having diabetes in pregnancy except","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Fetal malformations"},{"label":"B","text":"First-trimester spontaneous abortions"},{"label":"C","text":"Macrosomia"},{"label":"D","text":"Preterm labor"},{"label":"E","text":"Cesarean section"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-48374f0f7fd8","stem":"You recommend that the patient undergo all of the following routine testing because of her diabetes except","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"Diabet","suggestedTopic":null,"options":[{"label":"A","text":"Maternal serum AFP test at about 18 weeks"},{"label":"B","text":"Serial ultrasound assessments of fetal growth"},{"label":"C","text":"Fetal echocardiography at 18 to 20 weeks"},{"label":"D","text":"Twenty-four-hour urine study"},{"label":"E","text":"Fetal surveillance with contraction stress tests starting at 28 weeks 112 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Endocrinology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-5b24aa9394cb","stem":"A 37-year-old G3P2 presents to your office for her first OB visit at 10 weeks gestation. She has a history of Graves’ disease and has been main- tained on propylthiouracil (PTU) as treatment for her hyperthyroidism. She is currently euthyroid but asks you if her condition poses any problems for the pregnancy. Which of the following statements should be included in your counseling session with the patient?","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"She may need to discontinue the use of the thioamide drug because it is com- monly associated with leukopenia"},{"label":"B","text":"Infants born to mothers on PTU who are euthyroid may develop a goiter and be clinically hypothyroid"},{"label":"C","text":"Propylthiouracil does not cross the placenta"},{"label":"D","text":"Pregnant hyperthyroid women, even when appropriately treated, have an increased risk of developing preeclampsia"},{"label":"E","text":"Thyroid storm is a common complication in pregnant women with Graves’ disease"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"a50a2cb0abb38af3bae2e694d1c3ed70abdd772a"},{"id":"q-52a77faf1b1e","stem":"Your patient is a 40-year-old G3P2 obese woman at 37 weeks gesta- tion. Her pregnancy has been complicated by insulin-requiring gestational diabetes. Her most recent Hgb A1c was 6.0. The patient reports that her fasting and postprandial sugars have all been within normal range. Her fetus has an estimated weight of 61⁄2 lb by Leopolds today. All of the follow- ing are correct ways to manage this patient except","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"The patient should undergo an elective cesarean section at 38 weeks to avoid shoulder dystocia"},{"label":"B","text":"The patient should be induced by 40 weeks if spontaneous labor does not occur"},{"label":"C","text":"After 6 weeks postpartum, the patient should undergo a 75-g glucose tolerance test"},{"label":"D","text":"In the postpartum period, it is acceptable to use oral contraceptives"},{"label":"E","text":"A glucose infusion will be given to the patient in labor Medical and Surgical Complications of Pregnancy 113 Items 175–176 A 36-year-old G1P0 at 35 weeks gestation presents to your office com- plaining of a several-day history of generalized malaise, anorexia, nausea, and emesis. She has also been experiencing abdominal discomfort, which she attributes to indigestion. She has had a poor appetite and has lost sev- eral pounds since her last office visit 1 week ago. She denies any headache or visual changes. Her fetal movement has been good, and she denies any regular uterine contractions, vaginal bleeding, or rupture of membranes. This patient is on no medications except for a prenatal vitamin, and has no history of any medical problems. On physical exam, you notice that she is mildly jaundiced and appears to be a little confused. Her vital signs indi- cate a temperature of 100°F, pulse of 70, and BP of 100/62. She has no sig- nificant edema, and in fact appears very dehydrated. You send her to labor and delivery for IV hydration and additional evaluation. Once in labor and delivery, the patient is hooked up to an external fetal monitor, which indi- cates a fetal heart rate in the 160s that is nonreactive, but with good vari- ability. Blood is drawn and the following results are obtained: WBC = 25,000, Hct = 42.0, platelets = 51,000, SGOT/PT = 287/350, glucose = 43, creatinine = 2.0, fibrinogen = 135, PT/PTT = 16/50 s, serum ammonia level = 90 μmol/L (nl = 11–35). Urinalysis is positive for 3+ protein and large ketones."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-ee0c346bee3a","stem":"Which of the following is the patient’s most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Hepatitis B"},{"label":"B","text":"Acute fatty liver of pregnancy"},{"label":"C","text":"Intrahepatic cholestasis of pregnancy"},{"label":"D","text":"Severe preeclampsia"},{"label":"E","text":"Hyperemesis gravidarum"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1c1ba9c869bb","stem":"What is the recommended treatment for this patient?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Immediate delivery"},{"label":"B","text":"Cholecystectomy"},{"label":"C","text":"Intravenous diphenhydramine"},{"label":"D","text":"MgSO4 therapy"},{"label":"E","text":"Bed rest and supportive measures since this condition is self-limited 114 Obstetrics and Gynecology Items 177–178 A 32-year-old G1P0 reports to your office for a routine OB visit at 14 weeks gestational age. Labs drawn at her first prenatal visit 4 weeks ago reveal a platelet count of 60,000. All her other labs were within normal lim- its. During the present visit, the patient has a blood pressure of 120/70. Her urine dip reveals the presence of trace protein. The patient denies any com- plaints. The only medication she is currently taking is a prenatal vitamin. On taking a more in-depth history you learn that, prior to pregnancy, your patient had a history of occasional nose and gum bleeds, but no serious bleeding episodes. She has considered herself to be a person who just bruises easily."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-25ea3bf5e636","stem":"What is this patient’s most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Alloimmune thrombocytopenia"},{"label":"B","text":"Gestational thrombocytopenia"},{"label":"C","text":"Immune thrombocytopenic purpura"},{"label":"D","text":"HELLP syndrome"},{"label":"E","text":"Pregnancy-induced hypertension"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"05634f6e4e9ba3bf8af79964ebb2bf1a906c10ce"},{"id":"q-e44f866dc3b6","stem":"What medical treatment would you recommend to treat the throm- bocytopenia?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"No treatment is necessary"},{"label":"B","text":"Stop prenatal vitamins"},{"label":"C","text":"Oral corticosteroid therapy"},{"label":"D","text":"Intravenous immune globulin"},{"label":"E","text":"Splenectomy"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-caa5951f17d9","stem":"A 21-year-old G2P1 with a history of asthma presents to the emer- gency room at 25 weeks gestational age complaining of an acute exacerba- tion of her asthma. On presentation, she is tachypneic and struggling to breathe. All of the following are appropriate next steps in the management of this patient except","type":"OSCE / Practical Station","subject":"Internal Medicine","topic":"Respiratory Medicine","topicOriginal":"Respiratory Medicine","subtopic":"Asthma","suggestedTopic":null,"options":[{"label":"A","text":"Arterial blood gas determination"},{"label":"B","text":"Intubation with ventilatory assistance"},{"label":"C","text":"Oxygen therapy"},{"label":"D","text":"Subcutaneous epinephrine"},{"label":"E","text":"Intravenous methylprednisolone Medical and Surgical Complications of Pregnancy 115"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Respiratory Medicine","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-507cd3b5cffb","stem":"One of your obstetric patients presents to the office at 25 weeks com- plaining of severe left calf pain and swel