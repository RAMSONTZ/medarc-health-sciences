,"text":"Fainting is characteristic."},{"label":"D","text":"Vaginal bleeding is usually mild."},{"label":"E","text":"Absence of fetal movements suggest non viability. 54 All OB-GYN MCQs Second rearranged Edition 2011"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-6b355a570001","stem":"Regarding threatened abortion","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Anti-D should be given to Rh- positive mother."},{"label":"B","text":"All patients should be admitted to the hospital."},{"label":"C","text":"Ultrasound should be done to confirm the diagnosis."},{"label":"D","text":"Vaginal examination will reveal severe pain."},{"label":"E","text":"The patient has vaginal bleeding and tissue passage per vagina."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-886e53fa9bb0","stem":"Therapy in threatened abortion should include","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Progesterone IM"},{"label":"B","text":"D & C"},{"label":"C","text":"Prolonged bed rest"},{"label":"D","text":"Restricted activity"},{"label":"E","text":"Prostaglandin suppositories"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d647a6e5714b","stem":"During the first & second trimester of pregnancy, the most common pathologic cause of vaginal bleeding","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Hydatiform mole"},{"label":"B","text":"Abruptio placenta"},{"label":"C","text":"Ectopic pregnancy"},{"label":"D","text":"Abortion"},{"label":"E","text":"Uterine rupture"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-634b9a671f7d","stem":"Which of the following items may be associated with a mid trimester abortion","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Recurrent pelvic infection"},{"label":"B","text":"Maternal smoking"},{"label":"C","text":"Uterine anomalies"},{"label":"D","text":"Sickle cell disease"},{"label":"E","text":"Hyperemesis gravidarum"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-03c1befb4ab6","stem":"Bleeding in early pregnancy could be causes by all of the following, EXCEPT","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"An ectopic pregnancy"},{"label":"B","text":"Trophoblastic disease"},{"label":"C","text":"Carcinoma of the ovary"},{"label":"D","text":"Invasive carcinoma of the cervix"},{"label":"E","text":"Threatened abortion"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-fff403854438","stem":"Which of the following is correct in the treatment of a case of threatened abortion","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Bed rest"},{"label":"B","text":"Oral stillbosterol"},{"label":"C","text":"Curettage"},{"label":"D","text":"Urgent admission to hospital"},{"label":"E","text":"I.M Tranexamic acid 55 All OB-GYN MCQs Second rearranged Edition 2011"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-06aa65b08190","stem":"Etiological factors in spontaneous abortion include","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Chromosomal abnormalities"},{"label":"B","text":"Placental abnormalities"},{"label":"C","text":"Maternal disease"},{"label":"D","text":"Uterine abnormalities"},{"label":"E","text":"All of the above"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f8499ea933ec","stem":"A major hazard of a late missed abortion","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A positive human chorionic gonadotropin (hCG) titer"},{"label":"B","text":"Systemic allergies"},{"label":"C","text":"Bone marrow depression"},{"label":"D","text":"Coagulopathy"},{"label":"E","text":"Toxemia"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-36b2a6547072","stem":"A missed abortion is","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Death of the fetus at 36 weeks of gestation"},{"label":"B","text":"In which the products of conception are expelled completely"},{"label":"C","text":"In which the products of conception are partially expelled"},{"label":"D","text":"Bleeding and cramps but the fetus still viable"},{"label":"E","text":"Death of the fetus before 24 weeks gestation"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0ea354561d9b","stem":"A 26- year- old married white whose LMP was 2 1⁄2 months ago developed bleeding, uterine cramps, and passed some tissue per vagina. Two hours later she began to bleed heavily I. The most likely diagnosis is","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Twin pregnancy"},{"label":"B","text":"Threatened abortion"},{"label":"C","text":"Inevitable abortion"},{"label":"D","text":"Premature labor"},{"label":"E","text":"Incomplete abortion II. Of the option listed, the bleeding is most likely due to :"},{"label":"A","text":"Retained products of conception"},{"label":"B","text":"Ruptured uterus"},{"label":"C","text":"A systemic coagulopathy"},{"label":"D","text":"Vaginal lacerations 56 All OB-GYN MCQs Second rearranged Edition 2011"},{"label":"A","text":"Bleeding hemorrhoids III. The indicated procedure is :"},{"label":"A","text":"Hysterectomy"},{"label":"B","text":"Vaginal packing"},{"label":"C","text":"Compression of the hemorrhoids"},{"label":"D","text":"IV fibrinogen"},{"label":"E","text":"Uterine curettage"}],"priority":1,"status":"review","flags":["topic_generic","too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","too_many_options","too_many_options_possible_merge","topic_generic"],"cleaningOperations":["option_whitespace_normalization","whitespace/page_marker_normalization"]},{"id":"q-55e4a4f53313","stem":"Cervical cerculage","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Closure of incompetence cervix"},{"label":"B","text":"Effective in prevention of all types of abortion"},{"label":"C","text":"Should be removed at 32 weeks of pregnancy"},{"label":"D","text":"Protect against exposure of the pregnant lady to infection"},{"label":"E","text":"Should applied after 9 weeks of pregnancy"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-814b16c6b6b3","stem":"A 25 primigravida with 8 weeks threatened abortion. The US would most likely reveal","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Thickened endometrium with no gestational sac."},{"label":"B","text":"Fetal heart motion in the adnexia."},{"label":"C","text":"Empty gestational sac."},{"label":"D","text":"An intact gestational sac with fetal heart motion."},{"label":"E","text":"Collapsed gestational sac."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1718dae26217","stem":"Regarding Cervical incompetence, one is true","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cone biopsy is not a predisposing factor"},{"label":"B","text":"Cerculage is contraindicated"},{"label":"C","text":"In not encountered with uterine anomalies"},{"label":"D","text":"Best diagnosed by Hx"},{"label":"E","text":"Is a cause of early pregnancy abortion"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c881bb8db952","stem":"In patients with three consecutive spontaneous abortion in the second trimester the most useful investigation is","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Chromosomal analysis"},{"label":"B","text":"Hysterosalpingogram 57 All OB-GYN MCQs Second rearranged Edition 2011"},{"label":"C","text":"Endometrial biopsy"},{"label":"D","text":"Post coital test"},{"label":"E","text":"Prolactin level"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"cb2592a63f6340bd932a3f7a35f4d0139f797e08"},{"id":"q-1b027ed080cc","stem":"Therapy for threatened abortion should include","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Progesterone IM."},{"label":"B","text":"D & C."},{"label":"C","text":"Prolonged bed rest."},{"label":"D","text":"Restricted activity."},{"label":"E","text":"Prostaglandins suppository."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3a0ff2be60be","stem":"Approximately what percentage of spontaneous 1ST trimester abortions show chromosomal abnormalities","type":"Single Best Answer MCQ","subject":"Medical Genetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"1%."},{"label":"B","text":"10%."},{"label":"C","text":"25%."},{"label":"D","text":"50%."},{"label":"E","text":"75%."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Genetics","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0a05a7cc5f74","stem":"Repeated 2ND trimester abortions, especially when associated with a lack of painful uterine contractions, suggests most strongly","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Defective germ plasm."},{"label":"B","text":"Uterine myoma."},{"label":"C","text":"Maternal hyperthyroidism."},{"label":"D","text":"Folic acid deficiency."},{"label":"E","text":"Incompetent cervical os."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-36798d4b35f9","stem":"Inevitable abortion is usually associated with all of the following EXCEPT","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Pain."},{"label":"B","text":"Dilated cervix."},{"label":"C","text":"Bleeding."},{"label":"D","text":"Fever."},{"label":"E","text":"The pregnancy is almost doomed."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b5f9a5dc6c64","stem":"Threatened abortion is characterized by","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The presence of empty sac by ultrasound."},{"label":"B","text":"Disappearance of pregnancy symptoms."},{"label":"C","text":"Passage of vaginal vesicles."},{"label":"D","text":"The cervix is affected."},{"label":"E","text":"Vaginal bleeding. 58 All OB-GYN MCQs Second rearranged Edition 2011"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-88a11e7e5af7","stem":"In spontaneous abortion","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Uncontrolled blood sugar increases the risk of abortion in diabetic patients."},{"label":"B","text":"If the patient has mild bleeding with opened internal os this is considered to be threatened abortion."},{"label":"C","text":"Cervical incompetence is the most common cause of abortion in the 1ST trimester."},{"label":"D","text":"History of bleeding & passing of tissue per vagina indicates the need for curettage without the need for US."},{"label":"E","text":"D & C should be done immediately once missed abortion is diagnosed."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5519723eda10","stem":"Early bleeding in pregnancy may be caused by the following, EXCEPT","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Incomplete abortion"},{"label":"B","text":"Cervical cancer"},{"label":"C","text":"Threatened abortion"},{"label":"D","text":"Ectopic pregnancy"},{"label":"E","text":"Vasa praevia Ectopic pregnancies:"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-84f3be54a532","stem":"Regarding ectopic pregnancy, all of the following are true, EXCEPT","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Is associated with uterine enlargement"},{"label":"B","text":"Is situated in the ovary in about 0.5% of all cases"},{"label":"C","text":"Is more dangerous when it is situated in the isthmus of the fallopian tube"},{"label":"D","text":"Can only be diagnosed after it has ruptured"},{"label":"E","text":"Is a complication of assisted conception"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e864f61ccd97","stem":"Acceptable management of ruptured ectopic pregnancy","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Observation followed by Methotrexate"},{"label":"B","text":"Diagnostic laparoscopy followed by observation"},{"label":"C","text":"Repeat ultrasound next 24 hours to confirm the diagnosis"},{"label":"D","text":"Exploratory laparotomy and salpingectomy"},{"label":"E","text":"Dilatation and curettage"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-361534b5eea4","stem":"The following are factors affecting the choice of Methotrexate as a choice of treatment for ectopic pregnancy, EXCEPT","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Size of the ectopic"},{"label":"B","text":"Presence or absence of cardiac activity"},{"label":"C","text":"Level of β-hCG"},{"label":"D","text":"Parity of the patient"},{"label":"E","text":"Integrity of the tube 59 All OB-GYN MCQs Second rearranged Edition 2011"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"f082b851adb24f4f1f052786301a5089657c0db9"},{"id":"q-264e96db0afb","stem":"The most common cause of ectopic pregnancy is","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"History of pelvic inflammatory disease"},{"label":"B","text":"Congenital anomalies of the tube"},{"label":"C","text":"Endometriosis"},{"label":"D","text":"Tubal surgery"},{"label":"E","text":"Previous sterilization"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b673c3171c81","stem":"Following evacuation of a molar pregnancy, β-hCG titers will fall to untraceable levels in about 90% of patients within","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"2 weeks."},{"label":"B","text":"4 weeks."},{"label":"C","text":"8 weeks."},{"label":"D","text":"10 weeks"},{"label":"E","text":"12 weeks."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-78d6c14628bb","stem":"A 25 year-old G3 P1+1 presents to the emergency room complaining of lower abdominal crampy pain 6 weeks form he last normal period. She had significant vaginal bleeding but no passage of tissue & pregnancy test is Positive. I) The patient's most likely diagnosis is","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Incomplete abortion."},{"label":"B","text":"Complete abortion."},{"label":"C","text":"Missed abortion."},{"label":"D","text":"Threatened abortion."},{"label":"E","text":"Ectopic pregnancy. II) The most important step in this patient's evaluation should be:"},{"label":"A","text":"Sonography."},{"label":"B","text":"Physical exam."},{"label":"C","text":"CBC."},{"label":"D","text":"Quantitative β-hCG."},{"label":"E","text":"Detailed menstrual history. III) Transvaginal Ultrasonography would most likely reveal:"},{"label":"A","text":"Fetal heart motion."},{"label":"B","text":"An intact gestational sac."},{"label":"C","text":"A discrete yolk sac motion."},{"label":"D","text":"A Thickened endometrium with gestational sac."},{"label":"E","text":"Fetal heart motion in the adnexia."}],"priority":1,"status":"review","flags":["topic_generic","too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","too_many_options","too_many_options_possible_merge","topic_generic"],"cleaningOperations":[]},{"id":"q-4e12e9391452","stem":"The most common symptom of ectopic pregnancy is","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Profuse vaginal bleeding."},{"label":"B","text":"Abdominal pain."},{"label":"C","text":"Syncope. 60 All OB-GYN MCQs Second rearranged Edition 2011"},{"label":"D","text":"Dyspareunia."},{"label":"E","text":"Decreased pregnancy associated symptoms."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-9aae7354a945","stem":"Acceptable management of possible rupture ectopic pregnancy would include all of the following EXCEPT","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Exploratory laparotomy."},{"label":"B","text":"Diagnostic laparoscopy."},{"label":"C","text":"Partial salpingectomy."},{"label":"D","text":"Total salpingectomy."},{"label":"E","text":"Observation followed by Methotrexate."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-cd28aee9097a","stem":"If the above described patient has had a previous term pregnancy prior to her ectopic pregnancy, her chances of subsequent intrauterine pregnancy would be about","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"80%"},{"label":"B","text":"60%"},{"label":"C","text":"40%"},{"label":"D","text":"20%"},{"label":"E","text":"<10%"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b193a7b8a7aa","stem":"The commonest site of ectopic pregnancy is","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Peritoneal cavity"},{"label":"B","text":"Mesosalpinx"},{"label":"C","text":"Ovary"},{"label":"D","text":"Ampulla of the fallopian tube"},{"label":"E","text":"Isthmus portion of the fallopian tube"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7c6612aaac03","stem":"Etiological factor of ectopic pregnancy include all of the following EXCEPT","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Gonococcal Salpangitis"},{"label":"B","text":"Tubal surgery"},{"label":"C","text":"Combined OCP"},{"label":"D","text":"TB salpingitis"},{"label":"E","text":"Previous ectopic"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4d257d06833f","stem":"In ectopic pregnancy","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Rarely diagnosed before 12 weeks of gestation"},{"label":"B","text":"Usually present as obstetric emergency before 12 weeks gestation"},{"label":"C","text":"IM progesterone is useful"},{"label":"D","text":"50% continued up to term"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"f198bfcf6412cb176b647f0c88d37c47d6a81fd8"},{"id":"q-8be0270129c8","stem":"Patient with ectopic pregnancy","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Present with heavy per-vaginal bleeding"},{"label":"B","text":"Methotrexate is the treatment of the choice in patient with ruptured one"},{"label":"C","text":"May complain of shoulder pain. 61 All OB-GYN MCQs Second rearranged Edition 2011"},{"label":"D","text":"Present with cardio vascular collapse in all the cases"},{"label":"E","text":"Never have fainting attacks."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-73f4eb5cc97a","stem":"In the management of ectopic pregnancy","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"β-hCG titer has a role in the Dx & management of ectopic pregnancy."},{"label":"B","text":"D&C is the treatment of choice"},{"label":"C","text":"Methotrexate should be used if the patient hemodynamically unstable"},{"label":"D","text":"Shoulder pain is referred from bowel irritation"},{"label":"E","text":"The presence of severe bleeding is an indication of conservative management"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_