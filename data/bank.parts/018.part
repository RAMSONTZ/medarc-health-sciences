will NOT be musculinized"},{"label":"C","text":"The development of the female genital requires presence of the ovary"},{"label":"D","text":"45 XO fetus will have normal ovaries"},{"label":"E","text":"The development of the testes does not require presence of the Y chromosome"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-61435a10fad7","stem":"Turner syndrome: Which is true?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Genetically is 46 X O"},{"label":"B","text":"Has testis in inguinal area"},{"label":"C","text":"Usually presents with primary amenorrhea."},{"label":"D","text":"Has low I.Q"},{"label":"E","text":"Usually tall"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3142c37c1ab5","stem":"Androgen insensitivity syndrome: Which is true?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Genotype is 46 XX"},{"label":"B","text":"Phenotype they are female but with ill-developed breast"},{"label":"C","text":"Usually have secondary amenorrhea"},{"label":"D","text":"They have testes that should be kept to produce hormones"},{"label":"E","text":"They have no uterus 18 All OB-GYN MCQs Second rearranged Edition 2011"}],"pr