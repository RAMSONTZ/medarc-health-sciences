ral","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"50 million /ml"},{"label":"B","text":"60 million/ml."},{"label":"C","text":"90 million/ml."},{"label":"D","text":"20 million/ml."},{"label":"E","text":"10 million/ml."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7e8a1a63fed7","stem":"PCO, all true EXCEPT","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Hirsutism."},{"label":"B","text":"Imperforated hymen"},{"label":"C","text":"Infertility."},{"label":"D","text":"Acne."},{"label":"E","text":"Amenorrhea"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b5bded1e1118","stem":"A woman with bilateral proximal tubal blockage which was diagnosed by Hysterosalpingiogram and her husband have normal spermogram. There best chance to have a pregnancy is by","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Doing a laproscopic opening of the tube and then expectant management."},{"label":"B","text":"Giving the woman clomide for 6 months and expectant management."},{"label":"C","text":"Doing controlled ovarian hyperstimulation and IUI."},{"label":"D","text":"Doing IVF of the couple."}],"priority":1,"status":"prac