:[{"label":"A","text":"Bartholin's abscess."},{"label":"B","text":"Lymphogranuloma venerum."},{"label":"C","text":"Chancroid."},{"label":"D","text":"Vulva carcinoma."},{"label":"E","text":"Herpes infection."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-97b754f4f5c4","stem":"Treatment of pelvic inflammatory disease include the following, EXCEPT","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"Oral doxycycline"},{"label":"B","text":"Removal of IUCD"},{"label":"C","text":"Clindamycin"},{"label":"D","text":"Tetracycline"},{"label":"E","text":"Dilatation and curettage (D & C)"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-1a849ae98bbe","stem":"On bimanual examination, bilateral adnexal masses were palpated. A vaginal US was done for her and it showed bilateral tubo-ovarian abscesses. What is the most appropriate next step in her management","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Admit the patient for emergency laparoscopic drainage of the abscess."},{"label":"B","text":"Admit the patient and give her IV antibiotic."},{"label":"C","text":"Treat with multiple oral antibiotics as an outpatient."},{"label":"D","text":"Call interventional radiotherapy to perform \"CT guided Percutaneous aspiration\"."},{"label":"E","text":"Admit the patient for exploratory laparotomy, TAH and BSO."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3da8cb0cf913","stem":"Bartholin's abscess","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Is often asymptomatic."},{"label":"B","text":"Is usually bilateral."},{"label":"C","text":"Is most commonly due to gonococcus infections."},{"label":"D","text":"Is best treated surgically."},{"label":"E","text":"Is usually presented as painful swelling to one side to clitoris. 140 All OB-GYN MCQs Second rearranged Edition 2011"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-22e5a3a70685","stem":"The mechanism of infertility in pelvic inflammatory disease (PID) include the following EXCEPT","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"Polycystic ovary."},{"label":"B","text":"Peritubal adhesions."},{"label":"C","text":"Hydrosalpinx."},{"label":"D","text":"Pyosalpinx."},{"label":"E","text":"Frozen pelvis."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-bcb26c930c1f","stem":"Disorders of pelvic support are commonly associated with all of the following EXCEPT","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"Multiparity. (children)"},{"label":"B","text":"Aging."},{"label":"C","text":"Alcohol consumption."},{"label":"D","text":"Pelvic trauma."},{"label":"E","text":"Heavy lifting. 141 All OB-GYN MCQs Second rearranged Edition 2011 Infertility and Hirsutism:"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":["option_whitespace_normalization"],"manualEdits":{}},{"id":"q-37400e8b3088","stem":"All the following are true, about ovarian hyperstimulation, EXCEPT","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It can follow any of ovulation induction drugs"},{"label":"B","text":"In severe type admission to the intensive care unit may be required"},{"label":"C","text":"The ovaries will be very small in size have unilateral cyst."},{"label":"D","text":"It can diagnosed clinically and by ultrasound"},{"label":"E","text":"Patients with PCO are at increased risk"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-74aba9743023","stem":"All of the following are true about PCO EXCEPT","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"To diagnose PCO hormonal analysis can be done at any time of the cycle"},{"label":"B","text":"It is associated with reversed FSH:LH ratio"},{"label":"C","text":"It is associated with increase resistance to insulin"},{"label":"D","text":"Can be associated with increased prolactin level"},{"label":"E","text":"The ovaries have characteristic appearance by the ultrasound"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-bfa8eacded77","stem":"Evaluation of infertile couples","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"History of regular cycles is suggestive of anovulation"},{"label":"B","text":"History of severe dysmenorrhea and dyspareunia is suggestive of endometriosis"},{"label":"C","text":"Endometriosis is diagnosed by hysteroscopy"},{"label":"D","text":"Hysterosalpingogram is the only means of assisting ectopic pregnancy"},{"label":"E","text":"Thyroid disease does not affect fertility"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f1e1f0b74de7","stem":"Treatment of infertility","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Clomiphene citrate helpful in patients with anovulatory premature ovarian failure"},{"label":"B","text":"Ovarian drilling is helpful in the treatment of infertility endometriosis"},{"label":"C","text":"IVF is not helpful in the treatment of infertility due to male factor"},{"label":"D","text":"Hyperstimulation syndrome can occurs in patient treated by gonadotropins"},{"label":"E","text":"Spontaneous pregnancy can occur in patients with Müllerian agenesis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4ddfe6b6aa43","stem":"All of the following possible causes of infertility, EXCEPT","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Previous laparotomy for any reason"},{"label":"B","text":"Smoking"},{"label":"C","text":"High body mass index"},{"label":"D","text":"PCO"},{"label":"E","text":"Uterine subserous fibroids"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-131173632a3c","stem":"The following value of semen analysis indicates abnormal semen quality","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Volume less than 2 ml"},{"label":"B","text":"Count of 40 million / ml 142 All OB-GYN MCQs Second rearranged Edition 2011"},{"label":"C","text":"Motility 60%"},{"label":"D","text":"Abnormal form 30%"},{"label":"E","text":"Liquefaction complete in 30 minutes"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-f28dcd0dadfd","stem":"Regarding human fertility: Which is true?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Fertilization usually occurs 5-7 days before implantation and before the extrusion of the second polar body"},{"label":"B","text":"Subfertility only treated with IVF"},{"label":"C","text":"An adverse male factor is detectable in 60% of couples with low fertility"},{"label":"D","text":"Mumps in adulthood has no effect on male fertility"},{"label":"E","text":"Oligospermia means that sperm shape is abnormal"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1a1b1e9a7272","stem":"The commonest cause for infertility","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Tubal obstruction"},{"label":"B","text":"Male factor"},{"label":"C","text":"Chronic anovulation"},{"label":"D","text":"Hyper androgens"},{"label":"E","text":"Hypothyroidism."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ee578fee7a7a","stem":"All the following are possible causes of anovulation, EXCEPT","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"High body mass index"},{"label":"B","text":"Anorexia nervosa"},{"label":"C","text":"Polycystic ovarian syndrome"},{"label":"D","text":"Premature ovarian failure"},{"label":"E","text":"Sickle cell trait"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-651f1413574f","stem":"Polycystic ovarian diseases, all of the following can be seen, EXCEPT","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Acne"},{"label":"B","text":"Streak ovaries"},{"label":"C","text":"Insulin resistance"},{"label":"D","text":"Hirsutism"},{"label":"E","text":"Galactorrhea"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4fbe99aeead2","stem":"The initial evaluation in an infertile couple should include","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ovarian biopsy."},{"label":"B","text":"Semen analysis."},{"label":"C","text":"D & C."},{"label":"D","text":"Laparoscopy."},{"label":"E","text":"Sperm penetration assay."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d63bbd44f7df","stem":"Induction of ovulation agents","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Clomiphene citrate is an anti-androgen."},{"label":"B","text":"Clomiphene citrate is given by injection."},{"label":"C","text":"Gonadotropins is given orally. 143 All OB-GYN MCQs Second rearranged Edition 2011"},{"label":"D","text":"Ultrasound scan is not needed with induction."},{"label":"E","text":"Causes multiple follicles."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-a2c90dc47d94","stem":"In polycystic ovary syndrome patients, all the followings are true EXCEPT","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"They are usually underweight with low body mass index."},{"label":"B","text":"They have hirsutism."},{"label":"C","text":"They have Oligomenorrhoea."},{"label":"D","text":"They have high Prolactin level."},{"label":"E","text":"They have Subfertility."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"9c4360bc8ad381beac76a8e81ed59f235b19c904"},{"id":"q-a0697cbffb6a","stem":"Which of the following is suggestive of ovulation","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Basal body temperature drop at least 0.5 C in the second half of the cycle"},{"label":"B","text":"Day 21 Estrogen level is elevated"},{"label":"C","text":"Progesterone level on day ten of the cycle is elevated."},{"label":"D","text":"Regular cycle with dysmenorrhea."},{"label":"E","text":"Oligomenorrhoea"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"dbd023ccc84a39061009d53256ba37851c00f9ab"},{"id":"q-fa74ef6c93fc","stem":"Which of the following is a basic investigation for the male infertility","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Semen analysis."},{"label":"B","text":"Sperm penetration assay of cervical mucous."},{"label":"C","text":"Sperm penetration assay of hamster ova."},{"label":"D","text":"Splits ejaculate analysis."},{"label":"E","text":"Sperm antibodies test."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c2977eb87966","stem":"Characteristic of normal semen analysis all true EXCEPT","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Volume > 2ml"},{"label":"B","text":"pH of 7.2-7.8"},{"label":"C","text":"Sperm count > 2o million /ml."},{"label":"D","text":"Sperm motility >50%"},{"label":"E","text":"Normal sperm morphology is <20%"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2bb67fb6f3db","stem":"In Secondary infertility","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Is frequently due to tubal problems"},{"label":"B","text":"The problem is often a chromosomal defect in women."},{"label":"C","text":"Is frequently due to male factor"},{"lab