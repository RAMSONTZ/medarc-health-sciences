ic":"","suggestedTopic":null,"options":[{"label":"A","text":"Postpartum hemorrhage"},{"label":"B","text":"Consumptive hemorrhage"},{"label":"C","text":"Fetal demise"},{"label":"D","text":"Acute renal failure"},{"label":"E","text":"Subsequent ectopic"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{}},{"id":"q-66a0d88fe007","stem":"One of the following contraindications for the use of amnio-hook","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Placental previa"},{"label":"B","text":"Abruptio placenta"},{"label":"C","text":"Breech presentation 66 All OB-GYN MCQs Second rearranged Edition 2011"},{"label":"D","text":"IUGR"},{"label":"E","text":"Face presentation"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-f3b8a1a2aed0","stem":"Which of the following signs is most useful in predicting the absence of placental abruption following trauma","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Absence of uterine contraction"},{"label":"B","text":"Absence of vaginal bleeding"},{"label":"C","text":"Presence of normal fetal heart tones"},{"label":"D","