ate peptides."},{"label":"B","text":"Adrenocorticotropic hormone (ACTH)."},{"label":"C","text":"LH."},{"label":"D","text":"Growth hormone."},{"label":"E","text":"Thyroid-stimulating hormone."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-fc041d9df8e0","stem":"Effect of estrogen on the Cervix mucous","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Increase the glycoprotein level & thus allow the penetration of the sperms"},{"label":"B","text":"Decrease the watery content"}],"priority":1,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-8cb52784a60e","stem":"Raised FSH levels are found in all of the following conditions EXCEPT","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Postmenopausal women."},{"label":"B","text":"Turner's Syndrome."},{"label":"C","text":"Women on Combined Oral Contraceptive Pills."},{"label":"D","text":"Gonadal dysgenesis."},{"label":"E","text":"Peri-menopausal women who had hysterectomy with bilateral salpingooophorectomy."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":f