"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-bcad08496ce3","stem":"Pre-eclampsia is associated with an increase risk of all of the following, EXCEPT","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Delivery of a small for gestational age infant"},{"label":"B","text":"Placental abruptio"},{"label":"C","text":"Pulmonary edema"},{"label":"D","text":"Prolonged duration of labor"},{"label":"E","text":"Cerebral vascular accident (CVA)"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0d223dd5fd6b","stem":"Pregnancy induced hypertension","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Cardiology","topicOriginal":"Cardiology","subtopic":"Hypertension","suggestedTopic":null,"options":[{"label":"A","text":"Means high blood pressure at 10 weeks gestation."},{"label":"B","text":"Needs no treatment."},{"label":"C","text":"Pregnancy will be managed as normal."},{"label":"D","text":"Fetus will be at risk of fetal anomaly."},{"label":"E","text":"Fetus will be at risk of IUGR."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Cardiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"