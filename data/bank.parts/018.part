bject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-af467f60ab8d","stem":"Estrogen hormone is produced from all of the following organs EXCEPT","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Corpus luteum."},{"label":"B","text":"Anterior pituitary (anterior lobe of hypophysis)."},{"label":"C","text":"Placenta."},{"label":"D","text":"Testes,"},{"label":"E","text":"Adrenal glands."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-42c6b67a8269","stem":"The midcycle LH surge","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Enhances thecal cell androgen production."},{"label":"B","text":"Luteinizes granulose cells."},{"label":"C","text":"Initiates resumption of meiosis. 24 All OB-GYN MCQs Second rearranged Edition 2011"},{"label":"D","text":"Facilitates oocyte expulsion."},{"label":"E","text":"All the above."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-fe9b7dfe7652","stem":"An involuted corpus luteum becomes a hyalinized mass known as a","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Corpus delicti."},{"label":"B","text":"Corpus granulosa."},{"label":"C","text":"Graafian follicle."},{"label":"D","text":"Corpus atrectica."},{"label":"E","text":"Corpus albicans."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d18185fb8790","stem":"Which of the following is the best method to predict the occurrence of ovulation","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Thermogenic shift in basal body temperature."},{"label":"B","text":"LH surge."},{"label":"C","text":"Endometrial decidulaization."},{"label":"D","text":"Profuse, thin, acellular cervical mucous."},{"label":"E","text":"Mittelschmerz."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-08f7d67cb073","stem":"Luteal phase deficiency","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Has inadequate luteal progesterone production."},{"label":"B","text":"Has inadequate follicular estrogen production."},{"label":"C","text":"Can be corrected by estrogen."},{"label":"D","text":"Associated with delayed menstruation."},{"label":"E","text":"Can lead to hypoprolactenemia."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-af86f66705cf","stem":"On Examination of endometrial tissue obtained from a biopsy reveals simple columnar epithelium with no sub nuclear vacuoles. The stroma is edematous, & a tortuous gland contains secretions. These findings are consistent which stage of menstrual cycle","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Mid-proliferative."},{"label":"B","text":"Late proliferative."},{"label":"C","text":"Early secretory."},{"label":"D","text":"Mid-secretory."},{"label":"E","text":"Non-ovulatory cycle."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-77f5c2c7ab25","stem":"Ovulation occurs","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Immediately after LH surge."},{"label":"B","text":"6-8 hours after LH surge."},{"label":"C","text":"After Prolactin surge."},{"label":"D","text":"After follicles ripened in the ovary."},{"label":"E","text":"36 hours after LH surge"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d51725ec8181","stem":"Regarding Estrogen hormone: 25 All OB-GYN MCQs Second rearranged Edition 2011","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It is produced in corpus luteum."},{"label":"B","text":"It is responsible for secretory changes in endometrium."},{"label":"C","text":"It is mainly secreted as E3 by the ovary."},{"label":"D","text":"Can not be detected in the blood of postmenopausal."},{"label":"E","text":"Stimulates sebaceous gland activity"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-7983d2b1cc82","stem":"Regarding Human Chorionic Gonadotropin, all of the following are true EXCEPT","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It is produced by the placenta."},{"label":"B","text":"Is reversible for the maintenance of corpus luteum."},{"label":"C","text":"It's level doubles every 48 hours in ectopic pregnancy."},{"label":"D","text":"Reaches a peak concentration in maternal serum by 10 weeks gestation."},{"label":"E","text":"Forms the main tumor marker for trophoblastic neoplastic diseases."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT",