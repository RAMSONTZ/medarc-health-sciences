gilance"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-919b5f0556d2","stem":"Zero order kinetics occur in following drug with high dose","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Phenytoin and propranolol"},{"label":"B","text":"Digoxin and propranolol"},{"label":"C","text":"Amiloride and prebenecid"},{"label":"D","text":"Alcohol and theophylline"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-221e7d5a71d0","stem":"Which of the following is the most accurate method for calculating drug dosage in children","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Weight of the child"},{"label":"B","text":"Weight of the child and adult dose"},{"label":"C","text":"Age of the child"},{"label":"D","text":"Body surface area"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8b672a6a66ee","stem":"Therapeutic drug monitoring is done for all the follow- ing except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Phenytoin"},{"label":"B","text":"Metformin"},{"label":"C","text":"Tacrolimus"},{"label":"D","text":"Cyclosporin"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c50840baf8c5","stem":"The drug which may inhibit P450 for warfarin is which one of the following","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Cardiovascular Drugs · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Cardiovascular Drugs","options":[{"label":"A","text":"Cimetidine"},{"label":"B","text":"Ethanol"},{"label":"C","text":"Rifampicin"},{"label":"D","text":"Procainamide https://kat.cr/user/Blink99/ 35 35 General Pharmacology General Pharmacology General Pharmacology"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular Drugs · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-bdfc41969bec","stem":"In which type of poisonings is gastric lavage contrain- dicated?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Gastrointestinal","topicOriginal":"Gastrointestinal","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Organophosphorus poisoning"},{"label":"B","text":"Sedative drug poisoning"},{"label":"C","text":"Corrosive acid poisoning"},{"label":"D","text":"Barium carbonate poisoning"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Gastrointestinal","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-dbdb07db00a8","stem":"All of the following are examples of time dependent late adverse drug reactions except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Glucocorticoid induced osteoporosis"},{"label":"B","text":"Nitrate induced headache"},{"label":"C","text":"Chloroquine induced retinopathy"},{"label":"D","text":"Amiodarone induced tissue phospholipid deposition"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-375a21ffdd3e","stem":"Phase 4 clinical trial is carried out","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Before the marketing approval of a drug"},{"label":"B","text":"After a drug is marketed"},{"label":"C","text":"For drugs used in rare diseases"},{"label":"D","text":"For drugs used in pediatric patients"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-bb2c61e9fa29","stem":"Forced alkaline diuresis is effective in management of poisoning by which of the following agents","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Phenobarbitone"},{"label":"B","text":"Lead"},{"label":"C","text":"Iron"},{"label":"D","text":"Organophosphates"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7671b4eca9c4","stem":"Which of the following drugs can be given safety in pregnancy","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Obstetrics","topicOriginal":"Obstetrics","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Propylthiouracil"},{"label":"B","text":"Sodium valproate"},{"label":"C","text":"Warfarin"},{"label":"D","text":"Tetracycline"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Obstetrics","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-dcda91645b06","stem":"Which ONE of the following is TRUE about a competi- tive antagonism?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Antagonism cannot be completely reversed by in- creased dose of the agonist"},{"label":"B","text":"An agonist cannot displace an antagonists from the receptor"},{"label":"C","text":"Agonists and antagonists bind to the same receptor"},{"label":"D","text":"Dose-response curve of an agonists shifts to the left in the presence of an antagonist"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8404e97df8cd","stem":"Which route of drug administration avoids first pass hepatic metabolism and is used with drug preparation that slowly releases drugs for periods as long as seven days?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Gastrointestinal","topicOriginal":"Gastrointestinal","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Topical"},{"label":"B","text":"Transdermal"},{"label":"C","text":"Sublingual"},{"label":"D","text":"Oral"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Gastrointestinal","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-51a96cdfcaab","stem":"Hemodialysis is useful in all of the following except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Barbiturate poisoning"},{"label":"B","text":"Methanol poisoning"},{"label":"C","text":"Salicylate poisoning"},{"label":"D","text":"Digoxin poisoning"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-69c4ba379877","stem":"Which of the following is not a pro-drug?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Levodopa"},{"label":"B","text":"Enalapril"},{"label":"C","text":"Dipivefrine"},{"label":"D","text":"Amoxicillin"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"25dfa885a0721edbd8bc53bcea26fd4a780faa1b"},{"id":"q-c5e9fa50c4ef","stem":"Which of the following is a prodrug?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Lisinopril"},{"label":"B","text":"Enalapril"},{"label":"C","text":"Chlorpromazine"},{"label":"D","text":"Dopamine"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"0ebdfb573f9ae2280f796ecc8498c75426bf6e48"},{"id":"q-1f5a4981b375","stem":"Ans. (c) Phenobarbitone (Ref: KK Sharma 2/e p46) Phenobarbitone is a barbiturate which is a derivative of barbituric acid (weakly acidic drug) and its excretion can be en- hanced by making the urine alkaline. Morphine, atropine and amphetamines are basic drugs.","type":"Short Answer","subject":"Pharmacology","topic":"Autonomic Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Autonomic Pharmacology","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-df41c579840d","stem":"Ans. (a) Enalapril (Ref: KDT 7/e p23-24) All ACE inhibitors are prodrugs except captopril and lisinopril.","type":"Short Answer","subject":"Pharmacology","topic":"Cardiovascular Drugs · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Cardiovascular Drugs","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular Drugs · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ed30a45b9449","stem":"Ans. (b) Small changes of pH near the pKa of a weak acidic drug will not affect its degree of ionization (Ref: Katzung 11/e p9, 11) • pKa is the pH at which half of the drug is in the ionized form. There is maximum vari- ation in the ionization of a drug at pH near its pKa value. • Phenobarbitone is an acidic drug having pKa of 7.2. Therefore, at pH = 7.2, 50% of drug is ionized and 50% un-ionized. In acidic medium, more of it will be unionized (because it is acidic in nature). In plasma (pH = 7.4), more will be ionized (60%) and less (40%) un-ionized.","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6fff52a593dd","stem":"Ans. (d) Binding sites are non specific and one drug can displace the other (Ref: Katzung 10/e p47, 48) • Acidic drugs bind to albumin whereas basic drugs bind to α1 acid glycoprotein. • It is the free form of the drug that is metabolized or excreted. Bound form is not available for either metabolism or excretion. • Many drugs can bind to the same plasma protein binding site resulting in the displacement reactions. • When plasma concentration increases, both free as well as bound drug will increase in plasma.","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d4221ccede41","stem":"Ans. All (Ref: KDT 7/e p20, 30-33) • High protein binding of a drug make it restricted to vascular compartment and thus has tendency to lower volume of distribution. It behaves as a long acting drug as bound fraction is not available for metabolism or excretion. https://kat.cr/user/Blink99/ 39 39 General Pharmacology General Pharmacology General Pharmacology • Other factors that affect duration of action of IV drugs are: –– Clearance –– Half Life –– Volume of distribution which depends on lipid solubility, ionization at physiological pH, protein binding affinity of tissues and regional blood flow.","type":"Short Answer","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic","url_or_navigation_embedded"],"cleaningOperations":[]},{"id":"q-65dfd62f62d2","stem":"Ans. (a) Propanolol; (b) Lidocaine; (d) Imipramine; (e) Theophylline (Ref: KDT 6/e p28) • High hepatic extraction ratio means that most of the drug reaching the liver (via blood vessels) is removed by liver. These drugs have either high first pass metabolism or high systemic metabolism. • Propranolol and lidocaine undergo high first pass hepatic metabolism. • Theophylline is extensively metabolized in liver by demethylation and oxidation. • TCAs (tricyclic antidepressants) are extensively metabolized in liver; the major route for imipramine and amitripty- line is demethylation whereby active metabolites-desipramine and nortriptyline respectively are formed. • Ampicillin is partly excreted in bile and enterohepatic circulation occurs. However, primary channel of excretion is kidney.","type":"Short Answer","subject":"Pharmacology","topic":"Gastrointestinal","topicOriginal":"Gastrointestinal","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Gastrointestinal","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-2084a9917260","stem":"Ans. (c) Hepatic metabolism and renal excretion are the two most important mechanisms involved (Ref: KDT 6/e p23) • Action of a drug can be terminated either by hepatic metabolism or by renal excretion. Most of the drugs are in- activated by metabolism. However, some drugs may be activated from inactive form (pro-drugs) and others may produce active metabolites. • Some drugs may act away from blood e.g. digoxin leaves blood stream and enters the heart to produce its action.","type":"Short Answer","subject":"Pharmacology","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-cbbf58bc87b3","stem":"Ans. (c) Inhalational (Ref: KDT 6/e p9) Inhalational anesthetic agents like halothane are used in the clinical practice by titration of dose with response.","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-919d60437df5","stem":"Ans. (c) Conversion of lipid soluble drugs to water soluble metabolites (Ref: Katzung 10/e p50) After metabolism most of the drugs become inactive and are excreted through the kidney. Lipid soluble drugs will be reabsorbed whereas water soluble drugs are easily excreted. Thus, metabolism of drugs helps in the conversion of lipid soluble drugs to water soluble metabolites.","type":"Short Answer","subject":"Pharmacology","topic":"Renal and Urinary","topicOriginal":"Renal and Urinary","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Renal and Urinary","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-417e5fa8454a","stem":"Ans. (d) High plasma protein binding decreases the volume of distribution (Ref: Katzung 10/e p47) When a drug is highly bound to plasma proteins, it is more likely to stay in blood and thus Vd is less. Glomerular filtra- tion depends on renal blood flow and plasma protein binding. Highly protein bound drugs are less likely to be filtered by the glomerulus. Due to non-specific binding sites on plasma proteins these drugs are subjected to several drug interactions.","type":"Short Answer","subject":"Pharmacology","topic":"Renal and Urinary","topicOriginal":"Renal and Urinary","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Renal and Urinary","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-0b6e3c00bdbc","stem":"Ans. (b) Acetylation (Ref: KDT 6/e p25) Most of the phase I reactions and glucuronide conjugation (Phase II reaction) are catalyzed by microsomal enzymes. These enzymes can be induced or inhibited by drugs. Acetylation is carried out by N-acetyl transferase, a non-microsomal en- zyme.","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1686dd9ded07","stem":"Ans. (d) Lisinopril (Ref: KDT 6/e p485) • Captopril and lisinopril are ACE inhibitors that are not prodrugs. • Diazepam produce many active metabolites like oxazepam. • Propranolol can produce 4-hydroxypropanolol which has b-antagonist activity. • Allopurinol gives rise to oxypurinol which can inhibit xanthine oxidase.","type":"Short Answer","subject":"Pharmacology","topic":"Cardiovascular Drugs · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Cardiovascular Drugs","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular Drugs · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e262d5f2b2fe","stem":"Ans. (a) To achieve Steady State concentration in short time (Ref: KDT 6/e p34) https://kat.cr/user/Blink99/ 43 43 General Pharmacology General Pharmacology General Pharmacology","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic","url_or_navigation_embedded"],"cleaningOperations":[]},{"id":"q-5890194991db","stem":"Ans. (a) Clearance (Ref: KDT 7/e p30) Clearance of a drug is the theoretical volume of plasma from which the drug is completely removed in unit time.","type":"Short Answer","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-cb91c9262a98","stem":"Ans (d) The rate of elimination is proportional to the plasma concentration (Ref: Goodman and Gilman 12/e p34) Drugs may follow zero order or first order kinetics. It depends on the following formula: Rate of Elimination α {Plasma Concentration}order • Thus, if a drug follows zero order kinetics, {Plasma Concentration}0 is equal to one, in other words rate of elimination is independent of plasma concentration or rate of elimination is constant. • From the above formula, rate of elimination is proportional to plasma concentration for the drugs following first order kinetics.","type":"Short Answer","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2b8f876aa5ad","stem":"Ans. (a) Lipid solubility; (b) Volume of distribution; (c) Clearance; (d) Drug concentration (Ref: KDT 7/e p30-31) • Elimination of a drug depends upon: – Volume of distribution – Clearance • Volume of distribution is more with highly lipid soluble drugs. • In case of drugs following first order kinetics; rate of elimination is directly proportional to plasma concentration.","type":"Short Answer","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0920d59f3c73","stem":"9 Again, t1/2 = 0.693 × where, Vd = Volume of distribution CL = Clearance Thus, CL = 0.693 × 1/2 V t =","type":"Short Answer","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0d9bc4456349","stem":"Ans. (b) 4 mg/dl (Ref: Katzung 10/e p44) Dose Rate = Clearance × Steady state plasma concentration • This means plasma concentration at steady state is a direct function of the dose rate, if clearance is constant. In first order kinetics (clearance is constant), plasma concentration attained is directly proportional to the dose rate. Thus, doubling of dose rate from 10 to 20 mg/min, will double the steady state plasma concentration (from 2 to 4 mg/dl).","type":"Short Answer","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3e839cda2ba8","stem":"Ans. (d) Constant intravenous infusion (Ref: Katzung, 10/e p40, 43, 44) • When a drug is administered less frequently, it produces marked variation in the plasma concentrations. In this question the drug has a half life of 6 hours. If we repeat the dose at 6 hourly intervals, there will be 100% variation in the plasma concentration. • More frequent dosing will minimize the variation between maximum and minimum plasma concentrations. As the margin of safety of this drug (given in the question) is very low (maximum tolerable concentration is only 1.5 times the effective concentration), constant i.v. infusion is the best route.","type":"Short Answer","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e6c217de9bc8","stem":"Ans. (b) 4 mg/L (Ref: Katzung, 10/e p40, 43, 44) • Half life of this drug is 2 hours and its plasma concentration is 3 mg/L after 4 hours (9AM to 1 PM). • This means, after 2 half lives ( 4 hours) plasma concentration is 3 mg/L. We know, by constant i.v. infusion, plasma concentration attained is 75% of the steady state in 2 half lives. So, if 3 mg/L is 75% of steady state, it will amount to 4 mg/L.","type":"Short Answer","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a6477a0cbcc1","stem":"Ans. (b) Half life of drug (Ref: KDT 6/e p32) • After a dosage regimen, concentration of the drug to reach the steady state (when the elimination balances the input) is called steady state plasma concentration Cpss. • Cpss is reached in about 4-5 half lives. • The amplitude of fluctuations in Cpss depends on the dose interval relative to t1/2.","type":"Short Answer","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f5bd794d2421","stem":"Ans. (a) Volume of plasma which is cleared of drug in unit of time (Ref: KDT 6/e p31)","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ba887be8e94f","stem":"Ans. (c) Seven pass transmembrane receptors (Ref: Goodman and Gilman 12/e p52-53) These neurotransmitters (A, NA, DA) act through G-protein coupled receptors which are also known as seven-transmem- brane domain receptors, heptahelical receptors and serpentine receptors.","type":"Short Answer","subject":"Pharmacology","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-014c37badcf5","stem":"Ans. (c) Insulin binds to a transmembrane receptor at the outer surface of the plasma membrane, which activates the tyrosine kinase that is the cytosolic domain of the receptor. (Ref: Goodman and Gilman 12/e p1241) Enzymatic Receptors have two sites, the drug binds on the extracellular site and the intracellular site has enzymatic activ- ity (mostly tyrosine kinase). This enzyme can be activated via JAK-STAT pathway. Insulin, growth hormone, prolactin and cytokines act via enzymatic receptors.","type":"Short Answer","subject":"Pharmacology","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrinology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d1599d072dee","stem":"Ans. (c) Activation of protein kinase (Ref: KDT 7/e p46) • Cyclic AMP exerts most of its effects by stimulating cAMP-dependent protein kinases. These phosphorylate enzymes resulting in their activation or inhibition.","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-caf2e2b2bcdf","stem":"Ans. (c) ED50 of the drug corresponds to the efficacy (Ref: Katzung 11/e p30-31) ED50 corresponds to potency of a drug, not its efficacy. All other statements are true.","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-cd18d592f2ba","stem":"Ans. (c) The substrate concentration at half maximal velocity (Ref: KDT 7/e p38) Km of an enzyme is similar to potency of a drug. It is the substrate concentration at which the velocity reaches half of the maximum known as Vmax. (similar to efficacy of a drug).Higher is the Km, lesser is the speed of the reaction.","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ed8266ba25fd","stem":"Ans. (d) Salbutamol (Ref: KDT 6/e p45) GPCRs are heptahelical or serpentine receptors. Salbutamol acts through β2 receptors which are GPCRs.","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ee68505f559e","stem":"Ans. (a) Concentration of drug at which the reaction velocity is half of maximum (Ref KDT 6/e p55)","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1677f6e9952e","stem":"Ans. (b) It is easier to measure the effect of these drugs (Ref: KDT 6/e p34, 35) TDM is done for drugs (with narrow therapeutic index) whose response cannot be monitored by clinical examination. Antihypertensive effect can be easily measured, therefore TDM is not required.","type":"Short Answer","subject":"Pharmacology","topic":"Cardiovascular Drugs · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Cardiovascular Drugs","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular Drugs · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a8ccd15e4d2a","stem":"Ans. (c) Drugs used for rare diseases (Ref: KDT 7/e p5) Orphan drugs are the drugs that are used for the treatment of rare diseases. e.g. N-acetylcysteine for paracetamol poison- ing. Other examples include fomepizole, sodium nitrite, digibind etc.","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6806b4166c8b","stem":"Ans. (a) Efficacy (Ref: Katzung, 11/e p31) • Efficacy is the maximum effect of a drug regardless of dose. It is determined under controlled conditions in clinical trials. • Effectiveness is the response of a drug in clinical set up. It may not yield the maximum benefit.","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-01d3dbfee480","stem":"Ans. (a) Preclinical Phase (Ref: KDT 7/e p79) • GCP guidelines are made to safeguard the interest of subjects in clinical trials. These have to be adhered to in all phases of clinical trials. • Preclinical trials are performed in animals for which different regulations are given by CPCSEA (Committee for the Purpose of Control and Supervision of Experiments on Animals).","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-da65c680f37e","stem":"Ans. (a) Placebo is a dummy medication (Ref: KDT 6/e p65) Placebo plays a very important role in the clinical trials. To know, whether the effect is produced by a drug or it is just by chance, a dummy medication known as placebo is given to the control group. Placebo may or may not produce an effect in a subject.","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7414764ab5c9","stem":"Ans. (d) It is a drug required for treatment or prevention of a rare disease (Ref: KDT 6/e p6) Orphan drugs are used for rare diseases e.g. erythropoietin for the treatment of anemia in patients with chronic renal failure.","type":"Short Answer","subject":"Pharmacology","topic":"Renal and Urinary","topicOriginal":"Renal and Urinary","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Renal and Urinary","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-46504c748ad7","stem":"Ans. (a) Phase I involves the study of a small number of normal volunteers by highly trained clinical pharmacologists (Ref: KDT 6/e p77) • Phase I is carried out in healthy volunteers whereas other phases are conducted in patients. • Phase II is performed in small number of patients and phase III is a multicentric trial requiring large number of patients. • Phase IV is a post marketing trial conducted for every drug. It is done to know the rare adverse effects.","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-588979a4b6c1","stem":"Ans. (a) Specificity (Ref: Katzung 10/e p28, 29) It can be understood from the example given below: Atropine is a non specific antagonist of muscarinic receptors. It can be used in the management of bronchial asthma by vir- tue of its M3 blocking action (bronchodilation). But it can cause tachycardia as an adverse effect due to blockade of cardiac M2 receptors. A more specific drug like tiotropium bromide (selective M3 antagonist) is less likely to produce this adverse effect.","type":"Short Answer","subject":"Pharmacology","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-de2c92cadd63","stem":"Ans. (c) Antacids (Ref: KDT 7/e p53) • Alcohol promotes GABAA receptor mediated synaptic inhibition (through chloride channel opening) as well as NMDA and kainate type of excitatory amino acid receptors • Benzodiazepines acts through BZD receptors which is the integral part of the GABAA receptor-chloride channel com- plex. • Most antipsychotics (except clozapine) have potent dopamine D2 receptor blocking properties. • Local anesthetics acts with the receptors situated within voltage sensitive Na+ channel. • Propofol acts through GABA receptors • Drugs which do not have receptor mediated actions are –– antacids –– Chelating agents –– Antimetabolites –– mesna –– mannitol https://kat.cr/user/Blink99/ 52 Review of Pharmacology General Pharmacology","type":"Short Answer","subject":"Pharmacology","topic":"CNS Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"CNS Pharmacology","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"CNS Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic","url_or_navigation_embedded"],"cleaningOperations":[]},{"id":"q-39d0154f9606","stem":"Ans. (c) Ion trapping of acidic drugs occur in pregnancy: (Ref: Goodman & Gilman 11/e p9-10) • Heparin and insulin are anticoagulant and antidiabetic drugs of choice, respectively, in pregnancy, because these have minimum entry across placenta. • Fetal plasma is slightly more acidic than that of mother (pH 7.0 as compared to 7.4 of mother), so ion trapping of basic drugs occur. • Placenta contain P-glycoprotein that can act as an efflux pump for drugs. • Placental transfer of most drugs is greater in late pregnancy than in early pregnancy because uterine circulation in- creases and trophoblastic layer becomes thinner as the pregnancy advances.","type":"Short Answer","subject":"Pharmacology","topic":"Obstetrics","topicOriginal":"Obstetrics","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Obstetrics","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-6d8c8a9d681a","stem":"Ans. (b) Insulin (Ref: KDT 7/e p49) • Nicotine acts on NM and NN receptors which are inotropic receptors. • Diazepam acts on GABA-BZD-CL channel complex that mediates entry of chloride. • Glibenclamide is a sulforylurea that acts on ACh sensitive K+ channels. • Insulin acts on enzymatic receptors.","type":"Short Answer","subject":"Pharmacology","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrinology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ceb13171c0b9","stem":"Ans. (a) Phase I of clinical trial (Ref: KDT 7/e p63)","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7ff184fd0e23","stem":"When sympathetic system is stimulated, both α1 and β2 receptors are stimulated, so what will happen to blood vessels? It depends upon the relative number of receptors. If a blood vessel contain more α1 receptors, it contracts whereas those having more β2 receptors will dilate. To remember this, When we see a lion, we require sympathy, so sympathetic system is activated. We need to run now, so, muscles require more blood. They get this because blood vessels of skeletal muscle contain more β2 receptors. At this time of emergency, blood requirement in skin and internal organs is minimal, so vasoconstriction occur here due to more α1 receptors.","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-164c6e2eb5f9","stem":"Correct match of drug and mechanism of action is (AIIMS May 2013)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Brimonidine: Decrease aqueous production"},{"label":"B","text":"Latanoprost: Carbonic anhydrase inhibitor"},{"label":"C","text":"Pilocarpine: Increases uvoescleral outflow"},{"label":"D","text":"Betaxolol: Increases trabecular outflow"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7f6ea5f14256","stem":"Cholinomimetic drugs can be used for the treatment of all the following conditions EXCEPT: (AIIMS Nov 2012)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Closed angle Glaucoma"},{"label":"B","text":"Bradycardia"},{"label":"C","text":"Cobra bite"},{"label":"D","text":"Myasthenia gravis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-57749b7a8727","stem":"A patient presents to emergency with pinpoint pupil, salivation, lacrimation, tremors and red tears. Plasma cholinesterase level was 30% of normal. Most probable Diagnosis is:\b (AIIMS May 2012)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Organophospahte poisoning"},{"label":"B","text":"Dhatura poisoning"},{"label":"C","text":"Opioid poisoning"},{"label":"D","text":"Pontine hemorrhage"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-08be0c1870f1","stem":"Lid retraction is caused by? (AIIMS Nov 2011)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Bimatoprost"},{"label":"B","text":"Latanoprost"},{"label":"C","text":"Brimonidine"},{"label":"D","text":"Apraclonidine"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-54ac9d40dd32","stem":"What is the probable diagnosis in a patient with a dilated pupil not responsive to 1% pilocarpine?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Diabetic 3rd nerve palsy (AIIMS Nov 2011)"},{"label":"B","text":"Adie’s tonic pupil"},{"label":"C","text":"Uncal herniation"},{"label":"D","text":"Pharmacological block"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-cc55fdadf1d6","stem":"Which of the following cranial nerves does not carry parasympathetic outflow? (AIIMS May 2010)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Oculomotor"},{"label":"B","text":"Trochlear"},{"label":"C","text":"Facial"},{"label":"D","text":"Glossopharyngeal"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-165b3671deb3","stem":"A patient came to the casualty with acute bronchial asthma after treatment for glaucoma. The probable drug may be: (Delhi PG 2011)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Respiratory","topicOriginal":"Respiratory","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Timolol"},{"label":"B","text":"Betaxolol"},{"label":"C","text":"Latanoprost"},{"label":"D","text":"Anticholinesterase"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Respiratory","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-9c87624c1432","stem":"Which of the following drugs should not be given in a patient with acute angle closure glaucoma: (AI 2009)","type":"Single Best Answer MCQ","subject":"Pharmaco