lassified","topic_generic"],"cleaningOperations":[]},{"id":"q-5253ccc1f963","stem":"Which of the following has the lowest conduction velocity: a- A α fibers. b- A β fibers. c- B fibers. d- C fibers. c","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-74078a6e737e","stem":"Contraction of skeletal muscles: a- produces more work when the muscle contracts isometrically than when the muscle contracts isotonically. b- depends on external Ca++. c- decrease in magnitude with rapid repeated stimulation. d- does not depend on action potential. c","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-9dcf74a10b41","stem":"Nerve block is produced by all the following except: a- local anesthetics. b- excessive cooling. c- deep pressure. d- strong cat-electrotonus. d","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["subject_unclassified"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified"],"cleaningOperations":[]},{"id":"q-f6d452a60178","stem":"As regard neuro-muscular transmission all are true except: a- it shows fatigue due to depletion of acetylcholine vesicles. b- occurs from nerve to muscle i.e. one way conduction. c- it is stimulated by succinyl choline. d- it is blocked by botulinum toxins. c","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["subject_unclassified","possible_web_capture_contamination"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["possible_web_capture_contamination","subject_needs_classification","subject_unclassified"],"cleaningOperations":[]},{"id":"q-18a70742cefe","stem":"Red ( slow ) fibers are characterized by the following except: a- contains much blood capillaries. b- glycogen stores is low. c- contains high concentration of myoglobin. d- depends on anaerobic oxidation. d","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-74cc59f0e2f8","stem":"All about the Sarcomere are true except: a- is the distance between myosin and actin. b- is the distance between two Z membranes. c- is the contractile unite of the muscle. d- shorten when the muscle contracts. a","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-ba8cbd36645c","stem":"regarding the bronchi all true except","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Respiratory","topicOriginal":"Respiratory","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["subject_unclassified"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Respiratory","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified"],"cleaningOperations":[],"duplicateStemGroup":"e220b50c601e5ac9437504060edb04c2bd78f5ae"},{"id":"q-5945d1611a5a","stem":"regarding the heart all true except","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["subject_unclassified"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified"],"cleaningOperations":[],"duplicateStemGroup":"e468bcf443c9534fba0b42237a10f00316785a3f"},{"id":"q-e01468e1363c","stem":"> السؤال يجب أن يعدل من incorrect إلى correct الإجــابة هي E ( واضحـة )","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-71b98fb03cce","stem":"> D ( السبب : gonadal vessels are the most anterior ones in the abdominal viscera )","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-8d2cb499a3b5","stem":"according to the shoulder joint, All are correct EXCEPT","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"its capsule attaches laterally to the surgical neck of humerus."},{"label":"B","text":"its strength depends on the tone of muscles."},{"label":"C","text":"posterior dislocation cause the loss of rounded appearance of shoulder."},{"label":"D","text":"subglenoid displacement of the head of humerus can cause damage to axillary nerve."},{"label":"E","text":"anterior-inferior dislocation is common. f. damage of supraspinatus cause difficulties in extension."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"0c45497ee8c7e9c60399f8fb36a8bc66c45533a7"},{"id":"q-4cf8a8f2061c","stem":"Which of the following is an element of the peripheral nervous system?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Receptors"},{"label":"B","text":"Brachial plexus"},{"label":"C","text":"Ganglia"},{"label":"D","text":"Sciatic nerve"},{"label":"E","text":"All of the above The central nervous system consists of the brain and spinal cord. All other nervous system elements are considered to be in the peripheral nervous system. Thus the peripheral nervous system includes receptors, the brachial plexus, the sciatic nerve, and ganglia."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"d3e6f0c58f239f77e9a0c5434d82380184166373"},{"id":"q-8da097470e0c","stem":"What is the cell body of a neuron called?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ganglion"},{"label":"B","text":"Perikaryon"},{"label":"C","text":"Astrocyte"},{"label":"D","text":"Nissl"},{"label":"E","text":"Terminal bouton A ganglion is a collection of neuron cell bodies outside of the central nervous system. The cell body of a neuron is called a perikaryon or soma. An astrocyte is a supporting cell seen in the central nervous system. The basophilic clusters of ribosomes and rough endoplasmic seen in neuron cell bodies is called Nissl, Nissl bodies or Nissl substance. The terminal bouton is the end portion of an axon. It is also called an axon terminal or end bulb. The terminal bouton will be associated with another neuron in a synapse."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"2624f1a7d82c529d78248133d5b40dbded293844"},{"id":"q-9e622efce31f","stem":"Which type of neuron is multipolar?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Motor neurons"},{"label":"B","text":"Interneurons"},{"label":"C","text":"Sensory neurons d. Both a and b"},{"label":"E","text":"All of the above Both motor neurons and interneurons are multipolar."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"25bb29efbb35305a6510f63017c5caeca11be4d3"},{"id":"q-86f4e813035b","stem":"What provides tensile strength to a neuron?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Meninges"},{"label":"B","text":"Myelinated nerve fibers"},{"label":"C","text":"Cell bodies"},{"label":"D","text":"Nodes of Ranvier"},{"label":"E","text":"Neurofilaments The meninges are composed of the three connective tissue covers which surround the brain and spinal cord. White matter is myelinated nerve fibers. Gray matter is essentially neuron cell bodies and associated dendrites or unmyelinated axons. Nodes of Ranvier are the gaps that occur in the myelin sheath. Neurofilaments are a type of intermediate filaments seen in neurons which provide rigidity and tensile strength."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"25f9428a461fc2643ddc65770414f2d9019ba737"},{"id":"q-74baf341e310","stem":"Which meninx is made of a delicate web like connective tissue?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Dura mater"},{"label":"B","text":"Arachnoid"},{"label":"C","text":"Pia mater"},{"label":"D","text":"Both a and b"},{"label":"E","text":"All of the above The meninges cover the brain and spinal cord. There are three: dura mater, arachnoid, and pia mater. The dura mater is the outer meninx. The dura mater is composed of dense irregular connective tissue. The arachnoid is made of a delicate spider web like connective tissue. The pia mater is the innermost meninx. It covers the brain intimately. Note from Sarah Bellham: Arachnoid is derived from the Greek word for spider. It is used in the words arachnophobia, arachnids and arachnoid."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"5eef5fc00c789e405432c4f83c6de041a1224ae0"},{"id":"q-11480f77f4c5","stem":"What are the conglomerations of gray matter deep within the cerebrum and cerebellum called?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Tracts"},{"label":"B","text":"Islets"},{"label":"C","text":"Soma"},{"label":"D","text":"Cortex"},{"label":"E","text":"Nuclei A group of fibers traveling together to a destination is a tract. Islets of Langerhans are seen in the pancreas. Soma is another term for a neuron cell body. The outer part of the brain is gray matter called the cortex. The conglomerations of gray matter deep within the cerebrum and cerebellum are called nuclei."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"a359b5e8d1693dd940d68d4f49646eb105e279f6"},{"id":"q-51dd79637b91","stem":"Which of the following is involved in the blood brain barrier?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Astrocytes"},{"label":"B","text":"Ependymal cells"},{"label":"C","text":"Oligodendrocytes"},{"label":"D","text":"Microglia"},{"label":"E","text":"Schwann cells"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a25ca7e8a3ad","stem":"Which of the following is an element of the central nervous system?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Receptors"},{"label":"B","text":"Brachial plexus"},{"label":"C","text":"Sciatic nerve"},{"label":"D","text":"Ganglia"},{"label":"E","text":"Spinal cord Answer: e The central nervous system consists of the brain and spinal cord. All other nervous system elements are considered to be in the peripheral nervous system. Thus the peripheral nervous system includes receptors, the brachial plexus, the sciatic nerve, and ganglia."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"d0acff56a925848c055b9e1e600ba3d8188618cd"},{"id":"q-4f9c6a41cf10","stem":"What is a collection of cell bodies outside the CNS called?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ganglion"},{"label":"B","text":"Perikaryon"},{"label":"C","text":"Astrocyte"},{"label":"D","text":"Nissl"},{"label":"E","text":"Terminal bouton A ganglion is a collection of neuron cell bodies outside of the central nervous system. The cell body of a neuron is called a perikaryon or soma. An astrocyte is a supporting cell seen in the central nervous system. The basophilic clusters of ribosomes and rough endoplasmic seen in neuron cell bodies is called Nissl, Nissl bodies or Nissl substance. The terminal bouton is the end portion of an axon. It is also called an axon terminal or end bulb. The terminal bouton will be associated with another neuron in a synapse."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"70469970e6a36340f50c18b7e969446e08909753"},{"id":"q-113c3ccd3720","stem":"What is tissue which surrounds a nerve fascicle?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Perimysium"},{"label":"B","text":"Periosteum"},{"label":"C","text":"Perichondrium"},{"label":"D","text":"Perineurium"},{"label":"E","text":"Endosteum The perimysium is the connective tissue sheath around fascicles of muscle. The periosteum is the connective tissue covering of a bone. The perichondrium is the connective tissue which surrounds cartilage. The perineurium is the covering of nerve fascicles. The endosteum is the lining of the inner bone (the side which abuts the medullary cavity). Note from Sarah Bellham: The prefix \"peri\" means around, such as in the word \"perimeter\". The prefix \"endo\" means within or inner, such as in \"endosteum\", \"endocrine\", \"endoscope\"."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"d7c2ae3c650e6aba060e63961c64a40d4293ba75"},{"id":"q-54141d829e51","stem":"The colloquialism \"gray matter\" refers to somebody using his intellect or reasoning ability. In reality, what is gray matter?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Meninges"},{"label":"B","text":"Myelinated nerve fibers"},{"label":"C","text":"Cell bodies"},{"label":"D","text":"Nodes of Ranvier"},{"label":"E","text":"Neurofilaments A ganglion is a collection of nerve cell bodies outside of the central nervous system. White matter is myelinated nerve fibers. Gray matter is essentially neuron cell bodies. Nodes of Ranvier are the gaps that occur in the myelin sheath. Neurofilaments are a type of intermediate filaments seen in neurons."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"f80362f21c1708253bd06ae93c36b75cd9155120"},{"id":"q-f520de3dde48","stem":"Where is the cerebrospinal fluid?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Between the dura mater and bone"},{"label":"B","text":"Subdural space"},{"label":"C","text":"Subarachnoid space"},{"label":"D","text":"Between the pia mater and brain"},{"label":"E","text":"None of the above is the space between the arachnoid and the pia mater."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"2dc5d7d743fda6c366e850b229691c538d0b0d9e"},{"id":"q-40ba0e426c95","stem":"Which of the following are considered to be part of the meninges?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Dura mater"},{"label":"B","text":"Arachnoid"},{"label":"C","text":"Pia mater"},{"label":"D","text":"Both a and c"},{"label":"E","text":"All of the above The meninges cover the brain and spinal cord. There are three: dura mater, arachnoid, and pia mater. The dura mater is the outer meninx. The dura mater is composed of dense irregular connective tissue. The arachnoid is made of a delicate spider web like connective tissue. The pia mater is the innermost meninx. It covers the brain intimately. Note from Sarah Bellham: Arachnoid is derived from the Greek word for spider. It is used in the words arachnophobia, arachnids and arachnoid."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"611ee9173596e581bc9cf2af37249cdf682a7777"},{"id":"q-8b9b422a1bd7","stem":"What is the outer gray matter of the brain called?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Tracts"},{"label":"B","text":"Islets"},{"label":"C","text":"Soma"},{"label":"D","text":"Cortex"},{"label":"E","text":"Nuclei A group of fibers traveling together to a destination is a tract. Islets of Langerhans are seen in the pancreas. Soma is another term for a neuron cell body. The outer part of the brain is gray matter called the cortex. The conglomerations of gray matter deep within the cerebrum and cerebellum are called nuclei."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"eaf8f070b26ef4037e0cfabbbc25f066561881d1"},{"id":"q-68bfcb417004","stem":"Which of the following is the most abundant neuroglia cell?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Astrocytes"},{"label":"B","text":"Ependymal cells"},{"label":"C","text":"Oligodendrocytes"},{"label":"D","text":"Microglia"},{"label":"E","text":"Schwann cells neuroglia called glial cells or glia. Astrocytes, ependymal cells, oligodendrocytes, and microglia are all neuroglia. Of the neuroglia cells, astrocytes are the most abundant and the largest. These are star shaped cells involved in the blood brain barrier. Ependymal cells line the ventricles and spinal canal. Oligodendrocytes form myelin in the central nervous system. Microglia are the central nervous system macrophages. Schwann cells are seen in the peripheral nervous system and are not considered neuroglia. Schwann cells are responsible for the myelination of neurons in the peripheral nervous system."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"562a7b831e194b5506966ec61dafaa1f6fccba95"},{"id":"q-9e5a3d660705","stem":"Which of the following is an element of the central nervous system?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Receptors"},{"label":"B","text":"Brachial plexus"},{"label":"C","text":"Brain"},{"label":"D","text":"Ganglia"},{"label":"E","text":"Sciatic nerve The central nervous system consists of the brain and spinal cord. All other nervous system elements are considered to be in the peripheral nervous system. Thus the peripheral nervous system includes receptors, the brachial plexus, the sciatic nerve, and ganglia."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"d0acff56a925848c055b9e1e600ba3d8188618cd"},{"id":"q-1664644eadb8","stem":"Which of the following is supporting cell of the central nervous system?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ganglion"},{"label":"B","text":"Perikaryon"},{"label":"C","text":"Astrocyte"},{"label":"D","text":"Nissl"},{"label":"E","text":"Terminal bouton A ganglion is a collection of neuron cell bodies outside of the central nervous system. The cell body of a neuron is called a perikaryon or soma. An astrocyte is a supporting cell seen in the central nervous system. The basophilic clusters of ribosomes and rough endoplasmic seen in neuron cell bodies is called Nissl, Nissl bodies or Nissl substance. The terminal bouton is the end portion of an axon. It is also called an axon terminal or end bulb. The terminal bouton will be associated with another neuron in a synapse."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"faf5a9a7a72b9df8deedd5cb63e976a40ff377ba"},{"id":"q-398e6f682bf3","stem":"How many neurons are in the body of man?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"10,000 (10 to the 4th)"},{"label":"B","text":"10,000,000 (10 to the 7th) c. 10,000,000,000 (10 to the 10th)"},{"label":"D","text":"10,000,000,000,000 (10 to the 13th)"},{"label":"E","text":"10,000,000,000,000,000 (10 to the 16th There are 10,000,000,000 (10 to the 10th) to 100,000,000,000 (10 to the 11th) neurons."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"cd2482d0b774f975dbba87e41aa9afec812038a8"},{"id":"q-6a8de5d84747","stem":"What are the gaps that occur within the myelin sheath?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Meninges"},{"label":"B","text":"Myelinated nerve fibers"},{"label":"C","text":"Cell bodies"},{"label":"D","text":"Nodes of Ranvier"},{"label":"E","text":"Neurofilaments A ganglion is a collection of nerve cell bodies outside of the central nervous system. White matter is myelinated nerve fibers. Gray matter is essentially neuron cell bodies. Nodes of Ranvier are the gaps that occur in the myelin sheath. Neurofilaments are a type of intermediate filaments seen in neurons."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"906a8860e7fc13c1d1509a3cb1955027ce619b71"},{"id":"q-2c4fdaf8a569","stem":"What is the dura mater composed of?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Loose irregular connective tissue"},{"label":"B","text":"Dense irregular connective tissue"},{"label":"C","text":"Dense regular connective tissue"},{"label":"D","text":"Simple squamous epithelium"},{"label":"E","text":"Nervous tissue The meninges cover the brain and spinal cord. The dura mater is the outer meninx. The dura mater is composed of dense irregular connective tissue."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"0cd7a88fdcd5e5efd93d97a509e0f07ef5902d95"},{"id":"q-ed540a10b851","stem":"Where is gray matter?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Outer surface of the cerebrum and cerebellum"},{"label":"B","text":"Outer surface of the spinal cord"},{"label":"C","text":"Inner portion of the spinal cord"},{"label":"D","text":"Both a and b"},{"label":"E","text":"Both a and c The outer part of the cerebrum and cerebellum is gray matter. It is called the cortex. Underneath the cortex, is white matter. Gray matter is also found in conglomerations within the cerebrum and cerebellum where it is called nuclei. Gray matter is found in the central portion of the spinal cord in a butterfly shape. White matter is on the outer portion of the spinal cord. Note from Sarah Bellham: Notice that the distribution of gray matter and white matter for the brain and spinal cord is the reverse of each other. On the cerebrum and cerebellum, gray matter is on the outer portion, white matter is deeper. For the spinal cord, white matter is on the outer portion, and gray matter is deeper."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"d473cf9a299560bf28f2489ddb4a765acf747ccc"},{"id":"q-b317bdada8ce","stem":"What surrounds a nerve?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Neurium"},{"label":"B","text":"Perineurium"},{"label":"C","text":"Epineurium"},{"label":"D","text":"Endoneurium"},{"label":"E","text":"None of the above The endoneurium surrounds a nerve fiber. The perineurium surrounds a bundle of nerve fibers. The epineurium surrounds a nerve."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"4c5512fd26445fe8faba7d61ed3b9c165bba564d"},{"id":"q-ba6a34adf6f2","stem":"What are sensory neurons?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Unipolar"},{"label":"B","text":"Pseudounipolar"},{"label":"C","text":"Bipolar"},{"label":"D","text":"Multipolar"},{"label":"E","text":"Both a and b Sensory neurons are unipolar. Unipolar neurons are sometimes also called pseudounipolar. Neurons can be classified based on the number of axons and dendrites stemming off of the cell body. A unipolar neuron has one process which branches off of it This process then immediately divides into two. Thus, a unipolar neuron is sometimes also called a pseudounipolar neuron. Sensory neurons are unipolar. A bipolar neuron has two process that branch from it: an axon and a dendrite. Bipolar neurons are not very common and are found in some of the organs for special senses. Bipolar neurons are found in the retina, inner ear, and the region of the nose involved with smell. Multipolar neurons have one axon and many (at least two) dendrites that branch off of it. Most neurons are multipolar. Motor neurons and interneurons are multipolar."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"5f62f429e2af2f7f3ac616d77a10a5a3b73b750d"},{"id":"q-918c037e7828","stem":"What is the end of an axon called?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ganglion"},{"label":"B","text":"Perikaryon"},{"label":"C","text":"Astrocyte"},{"label":"D","text":"Nissl"},{"label":"E","text":"Terminal bouton A ganglion is a collection of neuron cell bodies outside of the central nervous system. The cell body of a neuron is called a perikaryon or soma. An astrocyte is a supporting cell seen in the central nervous system. The basophilic clusters of ribosomes and rough endoplasmic seen in neuron cell bodies is called Nissl, Nissl bodies or Nissl substance. The terminal bouton is the end portion of an axon. It is also called an axon terminal or end bulb. The terminal bouton will be associated with another neuron in a synapse."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"bd32518accee4d7d007148be9f654cf10ff6ebbf"},{"id":"q-2b308a78aa18","stem":"What is the connective tissue covering around the brain and spinal cord?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Meninges"},{"label":"B","text":"Myelinated nerve fibers"},{"label":"C","text":"Cell bodies"},{"label":"D","text":"Nodes of Ranvier"},{"label":"E","text":"Neurofilaments A ganglion is a collection of nerve cell bodies outside of the central nervous system. White matter is myelinated nerve fibers. Gray matter is essentially neuron cell bodies. Nodes of Ranvier are the gaps that occur in the myelin sheath. Neurofilaments are a type of intermediate filaments seen in neurons."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"c5bfd48f8e41ab20ac25ea906f718280afaf1fc9"},{"id":"q-52ea0467a820","stem":"Which meninx is made of a dense irregular connective tissue?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Dura mater"},{"label":"B","text":"Arachnoid"},{"label":"C","text":"Pia mater"},{"label":"D","text":"Both a and b"},{"label":"E","text":"All of the above arachnoid, and pia mater. The dura mater is the outer meninx. The dura mater is composed of dense irregular connective tissue. The arachnoid is made of a delicate spider web like connective tissue. The pia mater is the innermost meninx. It covers the brain intimately. Note from Sarah Bellham: Arachnoid is derived from the Greek word for spider. It is used in the words arachnophobia, arachnids and arachnoid."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"2c88f937222608d62a07e2026fe970b7d7e460f6"},{"id":"q-4fe4bcf3751a","stem":"What is a group of fibers traveling together?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Tracts"},{"label":"B","text":"Islets"},{"label":"C","text":"Soma"},{"label":"D","text":"Cortex"},{"label":"E","text":"Nuclei A group of fibers traveling together to a destination is a tract. Islets of Langerhans are seen in the pancreas. Soma is another term for a neuron cell body. The outer part of the brain is gray matter called the cortex. The conglomerations of gray matter deep within the cerebrum and cerebellum are called nuclei."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"287cafe5d4973ed1b6a0bc460814c2ceca91493d"},{"id":"q-e68ce2afa3ec","stem":"Where is white matter?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Outer surface of the cerebrum and cerebellum"},{"label":"B","text":"Outer surface of the spinal cord"},{"label":"C","text":"Inner portion of the brain"},{"label":"D","text":"Both a and b"},{"label":"E","text":"Both b and c The outer part of the cerebrum and cerebellum is gray matter. It is called the cortex. Underneath the cortex, is white matter. Gray matter is also found in conglomerations within the cerebrum and cerebellum where it is called nuclei. Gray matter is found in the central portion of the spinal cord in a butterfly shape. White matter is on the outer portion of the spinal cord. Note from Sarah Bellham: Notice that the distribution of gray matter and white matter for the brain and spinal cord is the reverse of each other. On the cerebrum and cerebellum, gray matter is on the outer portion, white matter is deeper. For the spinal cord, white matter is on the outer portion, and gray matter is deeper."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"96f90fe9703a1302fa19f81b98802d15d1b056f3"},{"id":"q-5c9f68a2f458","stem":"What is the primary component of myelin?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Amino acids"},{"label":"B","text":"Protein"},{"label":"C","text":"Carbohydrate"},{"label":"D","text":"Lipid"},{"label":"E","text":"Both b and c The primary component of myelin is lipid. It is formed by the cell wrapping itself around the axon. Thus, it is primarily the plasma membrane of either the Schwann cells or the oligodendrocytes."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"8d0947baad434d70d7f07f8afd0c93a3e5071d6b"},{"id":"q-11014d0fd61f","stem":"Which of the following is found in the cerebellum?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Schwann cells"},{"label":"B","text":"Basket cells"},{"label":"C","text":"Ganglion"},{"label":"D","text":"Neuroglia"},{"label":"E","text":"Satellite cells nervous system. Basket cells are a type of neuron seen in the cerebellum. A ganglion is a collection of nerve cell bodies outside of the CNS. Neuroglia are the supporting cells in the central nervous system Sometimes, neuroglia called glial cells or glia. Satellite cells are found in the ganglia of the peripheral nervous system."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"349723f91a34b40b98a06c17d69fc8d6823d40ed"},{"id":"q-8d89cca5f775","stem":"What are neurons in the retina?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Unipolar"},{"label":"B","text":"Pseudounipolar"},{"label":"C","text":"Bipolar"},{"label":"D","text":"Multipolar"},{"label":"E","text":"Both a and b The neurons in the retina are bipolar. Neurons can be classified based on the number of axons and dendrites stemming off of the cell body. A unipolar neuron has one process which branches off of it This process then immediately divides into two. Thus, a unipolar neuron is sometimes also called a pseudounipolar neuron. Sensory neurons are unipolar. A bipolar neuron has two process that branch from it: an axon and a dendrite. Bipolar neurons are not very common and are found in some of the organs for special senses. Bipolar neurons are found in the retina, inner ear, and the region of the nose involved with smell. Multipolar neurons have one axon and many (at least two) dendrites that branch off of it. Most neurons are multipolar. Motor neurons and interneurons are multipolar."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"3f9ee50af38635f77dcaf91e7b6fc69e83995906"},{"id":"q-27e3b4941c77","stem":"What are the basophilic clusters of ribosomes and rough endoplasmic reticulum seen in neurons called?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ganglion"},{"label":"B","text":"Perikaryon"},{"label":"C","text":"Astrocyte"},{"label":"D","text":"Nissl"},{"label":"E","text":"Terminal bouton A ganglion is a collection of neuron cell bodies outside of the central nervous system. The cell body of a neuron is called a perikaryon or soma. An astrocyte is a supporting cell seen in the central nervous system. The basophilic clusters of ribosomes and rough endoplasmic seen in neuron cell bodies is called Nissl, Nissl bodies or Nissl substance. The terminal bouton is the end portion of an axon. It is also called an axon terminal or end bulb. The terminal bouton will be associated with another neuron in a synapse."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"138f4b25a514130fa1ad740ac536826ec003c962"},{"id":"q-667f69623849","stem":"What is white matter?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Meninges"},{"label":"B","text":"Myelinated nerve fibers"},{"label":"C","text":"Cell bodies"},{"label":"D","text":"Nodes of Ranvier"},{"label":"E","text":"Neurofilaments A ganglion is a collection of nerve cell bodies outside of the central nervous system. White matter is myelinated nerve fibers. Gray matter is essentially neuron cell bodies. Nodes of Ranvier are the gaps that occur in the myelin sheath. Neurofilaments are a type of intermediate filaments seen in neurons."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"0e934734fb36ab9ee7217aff7c6014bbd53ceabe"},{"id":"q-33c7e0c65044","stem":"What is another term for the cell body of a neuron?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Tracts"},{"label":"B","text":"Islets"},{"label":"C","text":"Soma"},{"label":"D","text":"Cortex"},{"label":"E","text":"Nuclei Answer: c A group of fibers traveling together to a destination is a tract. Islets of Langerhans are seen in the pancreas. Soma is another term for a neuron cell body. The outer part of the brain is gray matter called the cortex. The conglomerations of gray matter deep within the cerebrum and cerebellum are called nuclei."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"60a1baf3b90987e30307434267325e50347cad35"},{"id":"q-9c659b30efe9","stem":"What is the covering of a nerve fiber?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Neurium"},{"label":"B","text":"Perineurium"},{"label":"C","text":"Epineurium"},{"label":"D","text":"Endoneurium"},{"label":"E","text":"None of the above The endoneurium surrounds a nerve fiber. The perineurium surrounds a bundle of nerve fibers. The epineurium surrounds a nerve."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"7b89bf9dd514fd888a3e24f411638ac632592311"},{"id":"q-4e60adf9870e","stem":"Which of the following is the CNS macrophage?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Astrocytes"},{"label":"B","text":"Ependymal cells"},{"label":"C","text":"Oligodendrocytes"},{"label":"D","text":"Microglia"},{"label":"E","text":"Schwann cells Neuroglia are the supporting cells of the central nervous system. Sometimes, neuroglia called glial cells or glia. Astrocytes, ependymal cells, oligodendrocytes, and microglia are all neuroglia. Of the neuroglia cells, astrocytes are the most abundant and the largest. These are star shaped cells involved in the blood brain barrier. Ependymal cells line the ventricles and spinal canal. Oligodendrocytes form myelin in the central nervous system. Microglia are the central nervous system macrophages. Schwann cells are seen in the peripheral nervous system and are not considered neuroglia. Schwann cells are responsible for the myelination of neurons in the peripheral nervous system."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"2f331d34bf6c9d17d8dc2b7dca7fe9cb53d69204"},{"id":"q-36bf31d3396a","stem":"What is the cell body of a neuron called?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ganglion"},{"label":"B","text":"Soma"},{"label":"C","text":"Astrocyte"},{"label":"D","text":"Nissl"},{"label":"E","text":"Terminal bouton A ganglion is a collection of neuron cell bodies outside of the central nervous system. The cell body of a neuron is called a perikaryon or soma. An astrocyte is a supporting cell seen in the central nervous system. The basophilic clusters of ribosomes and rough endoplasmic seen in neuron cell bodies is called Nissl, Nissl bodies or Nissl substance. The terminal bouton is the end portion of an axon. It is also called an axon terminal or end bulb. The terminal bouton will be > associated with another neuron in a synapse."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"2624f1a7d82c529d78248133d5b40dbded293844"},{"id":"q-ba4661e5164f","stem":"Where is the ependyma found?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Lining ventricles"},{"label":"B","text":"Lining spinal canal"},{"label":"C","text":"Covering the brain d. Covering the spinal cord"},{"label":"E","text":"Both a and b The ependyma lines the ventricles and spinal canal."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"020570807511e60f5124f01ad488c236405cf818"},{"id":"q-a661afc071a0","stem":"What surrounds a bundle of nerve fibers?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Neurium"},{"label":"B","text":"Perineurium"},{"label":"C","text":"Epineurium"},{"label":"D","text":"Endoneurium"},{"label":"E","text":"None of the above The endoneurium surrounds a nerve fiber. The perineurium surrounds a bundle of nerve fibers. The epineurium surrounds a nerve."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"f0cd13ad04b0fa1f1c95a1d5b428220a39d8cc2b"},{"id":"q-55cb19f330c5","stem":"Which meninx covers the brain intimately?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Dura mater"},{"label":"B","text":"Arachnoid"},{"label":"C","text":"Pia mater"},{"label":"D","text":"Both a and b"},{"label":"E","text":"All of the above The meninges cover the brain and spinal cord. There are three: dura mater, arachnoid, and pia mater. The dura mater is the outer meninx. The dura mater is composed of dense irregular connective tissue. The arachnoid is made of a delicate spider web like connective tissue. The pia mater is the innermost meninx. It covers the brain intimately. Note from Sarah Bellham: Arachnoid is derived from the Greek word for spider. It is used in the words arachnophobia, arachnids and arachnoid."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"51d3aad51727faef5b98f7dc7e88fa91988fa3a8"},{"id":"q-1b05c1324d07","stem":"Which of the following is NOT considered neuroglia?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Astrocytes"},{"label":"B","text":"Ependymal cells"},{"label":"C","text":"Oligodendrocytes"},{"label":"D","text":"Microglia"},{"label":"E","text":"Schwann cells Neuroglia are the supporting cells of the central nervous system. Sometimes, neuroglia called glial cells or glia. Astrocytes, ependymal cells, oligodendrocytes, and microglia are all neuroglia. Of the neuroglia cells, astrocytes are the most abundant and the largest. These are star shaped cells involved in the blood brain barrier. Ependymal cells line the ventricles and spinal canal. Oligodendrocytes form myelin in the central nervous system. Microglia are the central nervous system macrophages. Schwann cells are seen in the peripheral nervous system and are not considered neuroglia. Schwann cells are responsible for the myelination of neurons in the peripheral nervous system."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"2a87a4e726064816d54960a8d710325e876c8add"},{"id":"q-dbbb391d83ce","stem":"What is the innervation of an eccrine sweat gland?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cholinergic; parasympathetic"},{"label":"B","text":"Cholinergic; sympathetic"},{"label":"C","text":"Adrenergic; parasympathetic"},{"label":"D","text":"Adrenergic; sympathetic"},{"label":"E","text":"Cholinergic; motor Eccrine sweat glands are innervated by the sympathetic nervous system. The neurotransmitter for the eccrine sweat glands is acetylcholine. Thus it is cholinergic. Note from Sarah Bellham: For most postganglionic sympathetic neurons, the neurotransmitter is norepinephrine. Eccrine sweat glands are an exception to this generalization, as the innervation for eccrine sweat glands is cholinergic sympathetic."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"7de50b1ca8787d12b486a9712590c24907d4a80d"},{"id":"q-7515c0a4903e","stem":"What is the innervation of an apocrine sweat gland?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cholinergic; parasympathetic"},{"label":"B","text":"Cholinergic; sympathetic"},{"label":"C","text":"Adrenergic; parasympathetic"},{"label":"D","text":"Adrenergic; sympathetic"},{"label":"E","text":"Cholinergic; motor Apocrine sweat glands are innervated by the sympathetic nervous system. The neurotransmitter for the apocrine sweat glands is norepinephrine. Thus it is adrenergic."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"52a613a75d258f44a77de1c4209ddef802757f87"},{"id":"q-9c15d9df1b29","stem":"Which of the following disease is associated with joints?a) Goutb) Osteoporosisc) Arthritisd) TetanyView Answer Answer: cExplanation: Arthritis is inflammation and painful joints due to degradation of cartilages or synovial membrane or deposition of uric acid. advertisement","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-04211012efa6","stem":"Which cartilage is present at the joints of long bones?a) Calcifiedb) Elasticc) Hyalined) FibrousView Answer Answer: cExplanation: Hyaline is present at the joints of long bones.","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-d100603ea362","stem":"Which type of joint lies at the shoulder joint and hip joint?a) Pivot jointb) Angular jointc) Ball and socket jointd) Hinge jointView Answer Answer: cExplanation: Ball and socket joints have a ball like spherical end called head which fits into cup like depression. It is freely movable in all directions.","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic","subject_suggestion_available"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_suggestion_available","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-5af87307a338","stem":"Which of the following pair is correctly matched?a) Cartilaginous joint- skull bonesb) Gliding joint- between zygapophyses of vertebraec) Hinge joint- between vertebraed) Fibrous joint- between phalangesView Answer Answer: bExplanation: Zygapophyses are projections of the vertebrae that serve the purpose of fitting with an adjacent vertebra, the actual region of contact is called articular facet.","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-87cc43512c15","stem":"Hinge joint is present between _______ and _______a) Femur and ulnab) Humerus and ulnac) Femur and pectoral girdled) Femur and pelvic girdleView Answer Answer: bExplanation: Hinge joints are formed between two or more bones where the bones can only move alone one axis to flex or extend.","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic","subject_suggestion_available"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_suggestion_available","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-c4710afceabe","stem":"Which is not a feature of a typical rib?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Thoracic Wall and Ribs","suggestedTopic":null,"options":[{"label":"A","text":"Medial facet of the tubercle faces backwards"},{"label":"B","text":"Angle is the most posterior point"},{"label":"C","text":"Necks are all of equal length"},{"label":"D","text":"There are 3 costotransverse ligaments"},{"label":"E","text":"Intraarticular ligament attaches from horizontal ridge on the head to the intervertebral disc"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"f180abcecdda5d12067049ba0fa2101d7d87a2a8"},{"id":"q-a28c8dbc79f3","stem":"What travels through the diaphragm with the oesophagus?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Diaphragm","suggestedTopic":null,"options":[{"label":"A","text":"?"},{"label":"B","text":"?"},{"label":"C","text":"?"},{"label":"D","text":"?"},{"label":"E","text":"?"}],"priority":0,"status":"review","flags":["blank_option","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["blank_option","duplicate_option_text","nonunique_option_text","prior_structural_review_flag"],"cleaningOperations":[]},{"id":"q-7e5dbded0dab","stem":"Regarding bronchopulmonary segments, which is FALSE?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Lungs and Pleura","suggestedTopic":null,"options":[{"label":"A","text":"There are approximately 10 segments in each lung"},{"label":"B","text":"The lingual is divided into upper and lower segments"},{"label":"C","text":"?"},{"label":"D","text":"?"},{"label":"E","text":"?"}],"priority":0,"status":"review","flags":["blank_option","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["blank_option","duplicate_option_text","nonunique_option_text","prior_structural_review_flag"],"cleaningOperations":[]},{"id":"q-006ff9041bd7","stem":"Which vessel passes directly behind the right hilum?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Right phrenic nerve"},{"label":"B","text":"Right vagus nerve"},{"label":"C","text":"Azygos vein"},{"label":"D","text":"Internal mammary artery"},{"label":"E","text":"Hemi-azygos vein"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"73f1ed62fa705c47fc9fe9517f44da350709e8de"},{"id":"q-1db59679ab64","stem":"The IVC passes through the diaphragm at the level of T8, which is TRUE?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Diaphragm","suggestedTopic":null,"options":[{"label":"A","text":"this occurs to the left of the midline behind the 7th costal cartilage"},{"label":"B","text":"the left phrenic nerve accompanies it"},{"label":"C","text":"this occurs behind the 8th right costal cartilage"},{"label":"D","text":"the right phrenic nerve accompanies it"},{"label":"E","text":"it passes between the muscular levels of the diaphragm"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"independent_checked","sourceAnswerTrusted":false,"publicationStatus":"checked_explained","auditFlags":[],"cleaningOperations":[],"duplicateStemGroup":"10367b0b621ce0279e76dfbae7e80c9f3284fb74"},{"id":"q-5ab32f5d2308","stem":"All but which of the following are tributaries of the coronary sinus of the heart?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Cardiovascular Anatomy","suggestedTopic":null,"options":[{"label":"A","text":"the anterior cardiac vein"},{"label":"B","text":"the great cardiac vein"},{"label":"C","text":"the middle cardiac vein"},{"label":"D","text":"the oblique vein (of the LA)"},{"label":"E","text":"the posterior vein of the LV"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"eee40ccbfcc4795712b27724e2c59bdaeefe1a64"},{"id":"q-f6ff453942c8","stem":"Which doesn’t drain into the cardiac sinus?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Cardiovascular Anatomy","suggestedTopic":null,"options":[{"label":"A","text":"great cardiac vein"},{"label":"B","text":"anterior cardiac vein"},{"label":"C","text":"small cardiac vein"},{"label":"D","text":"oblique vein of the left atrium"},{"label":"E","text":"posterior vein of the left ventricle"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"a480c4aeae9bafd8d3e0adb153b154bb5556c53c"},{"id":"q-41d47810cc1e","stem":"Which of the following bronchi is called the epartenol bronchus?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Lungs and Pleura","suggestedTopic":null,"options":[{"label":"A","text":"left superior bronchus"},{"label":"B","text":"left inferior bronchus c) right superior bronchus"},{"label":"D","text":"right middle bronchus"},{"label":"E","text":"right inferior bronchus"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"5230fab359415f0bf8a82e7814591d8b163a078c"},{"id":"q-54a4076d48bd","stem":"A surface landmark which constitutes a guide to the gastro-oesophageal orifice is the","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Mediastinum","suggestedTopic":null,"options":[{"label":"A","text":"7th left costal cartilage"},{"label":"B","text":"left linea semilunaris c) tip of the 9th left costal cartilage"},{"label":"D","text":"left nipple"},{"label":"E","text":"level of the 11th thoracic vertebra"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"6f2def84be08ef48d09292ff59512c4f4edabafb"},{"id":"q-3ae09b93d968","stem":"Which of the following do not penetrate the diaphragm?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Diaphragm","suggestedTopic":null,"options":[{"label":"A","text":"aorta"},{"label":"B","text":"inferior vena cava"},{"label":"C","text":"left phrenic nerve"},{"label":"D","text":"right phrenic nerve e) oesophagus"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"776115e35589c1caa7bba0a02c8182cc0640c80f"},{"id":"q-8b218568d068","stem":"Which is NOT located at the level of the lower border of T4 vertebra? a) the most superior part of the arch of the aorta","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"azygous vein enters the superior vena cava"},{"label":"C","text":"thoracic duct reaches the left side of the oesophagus as it ascends"},{"label":"D","text":"ligamentum arteriosum"},{"label":"E","text":"superficial and deep parts of the cardiac plexus"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-45de0b55df48","stem":"In the lung","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Lungs and Pleura","suggestedTopic":null,"options":[{"label":"A","text":"The horizontal fissue is always present in the right side"},{"label":"B","text":"The fissures create a roughened surface to promote easier expansion"},{"label":"C","text":"The obliquity of the fissure ensures better expansion of the apex of the lung"},{"label":"D","text":"The lingual is a separate lobe of the left side"},{"label":"E","text":"Only 2% of lungs have incomplete oblique fissures"}],"priority":0,"status":"quarantine","flags":["short_or_incomplete_stem"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"quarantine","auditFlags":["prior_structural_review_flag","short_or_incomplete_stem","short_stem"],"cleaningOperations":[]},{"id":"q-849d48be4530","stem":"The diaphragm","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Diaphragm and Phrenic Nerve","suggestedTopic":null,"options":[{"label":"A","text":"Has the oesophageal opening opposite T8 vertebra"},{"label":"B","text":"Is supplied by the 5th, 6th and 7th cervical nerve roots"},{"label":"C","text":"Has a major role in expiration"},{"label":"D","text":"Has a vena caval foramen opposite T10 vertebra"},{"label":"E","text":"Has an aortic opening opposite T12 vertebra"}],"priority":0,"status":"practice_draft","flags":["short_or_incomplete_stem"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["short_or_incomplete_stem","short_stem"],"cleaningOperations":[]},{"id":"q-5411c59769c2","stem":"The trachea","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Lungs and Pleura","suggestedTopic":null,"options":[{"label":"A","text":"Drains to axillary lymph nodes"},{"label":"B","text":"Is supplied by glossopharyngeal nerve"},{"label":"C","text":"Is marked at its lower end by the sternal angle"},{"label":"D","text":"Enters the thoracic inlet slightly to the left"},{"label":"E","text":"Commences below the cricoid at the level of C5"}],"priority":0,"status":"quarantine","flags":["short_or_incomplete_stem"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"quarantine","auditFlags":["prior_structural_review_flag","short_or_incomplete_stem","short_stem"],"cleaningOperations":[]},{"id":"q-1eb17b68020f","stem":"Regarding the surface markings of the lung and pleura","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Lungs and Pleura","suggestedTopic":null,"options":[{"label":"A","text":"The border of the lung lies two ribs below the pleural reflection"},{"label":"B","text":"The hilum of the lungs lie at the level of T10 verterbra"},{"label":"C","text":"The oblique fissure follows the line of T10 vertebra"},{"label":"D","text":"The oblique fissure follows the line of the 5th rib"},{"label":"E","text":"The horizontal fissure meets the oblique fissure in the left midaxillary line f. The lower border of the lung lies at the level of the sixth rib in the midaxillary line"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"c693065a5f29f0f2beef05a3b6520b3fd6644aca"},{"id":"q-3162697c678f","stem":"Diaphragm","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Diaphragm and Phrenic Nerve","suggestedTopic":null,"options":[{"label":"A","text":"median arcuate ligament is at L1"},{"label":"B","text":"vena caval opening transmits IVC and left phrenic nerve"},{"label":"C","text":"oesophageal opening is at T8"},{"label":"D","text":"expiration depends on active contraction of the diaphragm"},{"label":"E","text":"the motor supply to the diaphragm is solely from the phrenic nerves"}],"priority":0,"status":"quarantine","flags":["short_or_incomplete_stem"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"quarantine","auditFlags":["prior_structural_review_flag","short_or_incomplete_stem","short_stem"],"cleaningOperations":[]},{"id":"q-5f29706dcf70","stem":"Regarding attachments to the thoracic cage","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Thoracic Anatomy","suggestedTopic":null,"options":[{"label":"A","text":"pectoralis major has slips of origin from the upper 8 costal cartilages"},{"label":"B","text":"the first digitation of serratus anterior attaches to the 1st and 2nd rib"},{"label":"C","text":"rectus abdominus is attached to the anterior surfaces of the 7th to 10th costal cartilages"},{"label":"D","text":"iliocostalis and longissimus, parts of erector spinae, are attached between the heads and tubercles of each rib"},{"label":"E","text":"serratus anterior is attached to the lower 8 ribs"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"4f006ceae29ec365bd56b103c7c655c3f98c54c4"},{"id":"q-28ce03b9ccb7","stem":"Regarding intercostal blood vessels","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Thoracic Wall and Ribs","suggestedTopic":null,"options":[{"label":"A","text":"in each space there are single anterior and posterior intercostal veins"},{"label":"B","text":"right sided superior intercostal vv drain into the brachiocephalic vein"},{"label":"C","text":"the second intercostal space does not contain a posterior intercostal artery"},{"label":"D","text":"all intercostal vv are branches of the descending thoracic aorta"},{"label":"E","text":"all this is clinically relevant"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"9967892360ca5fab8a06d16a573e2cb50174f255"},{"id":"q-b8b2387e6681","stem":"Regarding the heart valves","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Heart and Coronary Circulation","suggestedTopic":null,"options":[{"label":"A","text":"the aortic valve usually has two semilunar cusps"},{"label":"B","text":"the pulmonary valve is at the level of the 3rd costal cartilage"},{"label":"C","text":"they do not contain elastic fibres"},{"label":"D","text":"the tricuspid valve has anterior, posterior and medial cusps"},{"label":"E","text":"the mitral valve cusps are bigger and thinner than those of the tricuspid valve"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"5bf77a12398a8cb7a7c77025a4422db28165727c"},{"id":"q-d1d638c381a9","stem":"Which of the following bronchi is called the epartenol bronchus?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Lungs and Pleura","suggestedTopic":null,"options":[{"label":"A","text":"left superior bronchus"},{"label":"B","text":"left inferior bronchus"},{"label":"C","text":"right superior bronchus"},{"label":"D","text":"right middle bronchus"},{"label":"E","text":"right inferior bronchus"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"not_adjudicated","sourceAn