ne except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Autonomic Pharmacology","options":[{"label":"A","text":"Hypotension"},{"label":"B","text":"Central excitation"},{"label":"C","text":"Muscle paralysis"},{"label":"D","text":"Bronchoconstriction"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f4f3c85761be","stem":"A 28 yr old woman has been treated with several auto- nomic drugs for about a month. Which of the following signs would distinguish between an overdose of a mus- carinic blocker and a ganglionic blocker?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Blurred vision"},{"label":"B","text":"Dry mouth, constipation"},{"label":"C","text":"Mydriasis"},{"label":"D","text":"Postural hypotension"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6b4d02327a0e","stem":"Mr. James has just been diagnosed with myasthenia gravis. You are his physician and are considering dif- ferent therapies for his disease. Neostigmine and pyri- dostigmine may cause which one of the following?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Bronchodilation"},{"label":"B","text":"Diarrhea"},{"label":"C","text":"Cycloplegia"},{"label":"D","text":"Irreversible inhibition of acetylcholinesterase"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e04279590d2e","stem":"How would a drug that competes with ACh for receptors at the motor end plate affect skeletal muscle? It would: (Karnataka 2009)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Produce uncontrolled muscle spasms"},{"label":"B","text":"Cause the muscles to contract and be unable to relax"},{"label":"C","text":"Cause muscles to relax and be unable to contract"},{"label":"D","text":"Make the muscles more excitable"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-90e34005fa09","stem":"All are cholinergic agents EXCEPT: (DELHI-PG-2008)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Autonomic Pharmacology","options":[{"label":"A","text":"Gallantamine"},{"label":"B","text":"Donepezil"},{"label":"C","text":"Tacrine"},{"label":"D","text":"Memantine"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"k