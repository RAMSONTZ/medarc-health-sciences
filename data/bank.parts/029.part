ions":[],"manualEdits":{}},{"id":"q-7ec20d2d3f2a","stem":"Which of the following is an selective alpha 2 antagonist?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Prazosin"},{"label":"B","text":"Labetalol"},{"label":"C","text":"Yohimbine"},{"label":"D","text":"Butoxamine"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-033025c26242","stem":"Atropine is most sensitive to","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Autonomic Pharmacology","options":[{"label":"A","text":"Mucous and pharyngeal secretions"},{"label":"B","text":"Heart"},{"label":"C","text":"Pupil"},{"label":"D","text":"GI tract motility"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-315dcbd270a0","stem":"Which is not an effect of atropine?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Autonomic Pharmacology","options":[{"label":"A","text":"Rise of body temperature"},{"label":"B","text":"Decreased salivary secretion"},{"label":"C","text":"Bradycardia"},{"label":"D","text":"Increased A-V conduction"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-af19ab850ff7","stem":"In Anaphylactic shock, epinephrine is given by which route?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Intravenous route"},{"label":"B","text":"Oral"},{"label":"C","text":"Subcutaneous"},{"label":"D","text":"Intramuscular"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-053afeb579d9","stem":"Regarding neostigmine, all of the following are correct except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A quaternary ammonium compound"},{"label":"B","text":"Shorter acting than edrophonium"},{"label":"C","text":"Poorly absorbed orally"},{"label":"D","text":"Used in myasthenia gravis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3de8f110c3bf","stem":"Atropine is used in all except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Autonomic Pharmacology","options":[{"label":"A","text":"Glaucoma"},{"label":"B","text":"As a mydriatic"},{"label":"C","text":"As a cyclopegic"},{"label":"D","text":"Preanaesthetic medication"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6ed7d3c7b167","stem":"Praliodoxime is ineffective in case of which poisonings?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Organophosphorus"},{"label":"B","text":"Carbaryl"},{"label":"C","text":"Both of the above"},{"label":"D","text":"None of the above"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9fbbfbe27370","stem":"Besides its properties of decreasing intraocular pres- sure, timolol is preferred in the treatment of glaucoma because it","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Produces no miosis"},{"label":"B","text":"Possess membrane stabilizing activity"},{"label":"C","text":"Increases outflow of aqueous humor"},{"label":"D","text":"Is a selective beta-adrenoceptor blocker"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c26bd4dd8709","stem":"Which b1 selective blocker is used in glaucoma","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Levobunolol"},{"label":"B","text":"Timolol"},{"label":"C","text":"Betaxolol"},{"label":"D","text":"Carteolol"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-013ed46ff2a1","stem":"Nicotinic receptor sites include all of the following except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Bronchial smooth muscle"},{"label":"B","text":"Adrenal medulla"},{"label":"C","text":"Skeletal muscle"},{"label":"D","text":"Sympathetic ganglia"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0eb677c02410","stem":"Propanolol is useful for all of the following except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Angina"},{"label":"B","text":"Familial tremor"},{"label":"C","text":"Hypertension"},{"label":"D","text":"Partial AV block https://kat.cr/user/Blink99/ Review of Pharmacology 92 Autonomic Nervous System"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-40c4a225f6a2","stem":"All of the following are used in organophosphorus poisoning except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Pralidoxime"},{"label":"B","text":"Atropine"},{"label":"C","text":"Activated charcoal"},{"label":"D","text":"Naltrexone"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8e1fed448f8c","stem":"A 35 year old man was found unconscious. Examination revealed bilateral constricted pupils, bradycardia, excessive sweating and secretion. Most likely cause is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Opium poisoning"},{"label":"B","text":"Acute alcohol intoxication"},{"label":"C","text":"Organophosphorous poisoning"},{"label":"D","text":"Pontine hemorrhage"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-db0e7eb122b6","stem":"Which one of the following drugs does not induce my- driasis","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Phentolamine"},{"label":"B","text":"Ephedrine"},{"label":"C","text":"Phenylephrine"},{"label":"D","text":"Cocaine"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-eda626512671","stem":"Atropine when used as a pre-medication causes all of the following symptoms except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Autonomic Pharmacology","options":[{"label":"A","text":"Skin flush"},{"label":"B","text":"Bronchoconstriction"},{"label":"C","text":"Prevents bradycardia"},{"label":"D","text":"Dryness of mouth"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-610b166ffe31","stem":"Patients taking a b-adrenergic receptor blocking drug may experience all of the following except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Autonomic Pharmacology","options":[{"label":"A","text":"Exacerbation of existing heart block"},{"label":"B","text":"Precipitation of heart failure"},{"label":"C","text":"Nasal blockage"},{"label":"D","text":"Cold extremities"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ba1cbc499f95","stem":"Which of the following drugs is useful in anaphylactic shock","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Isoprenaline"},{"label":"B","text":"Adrenaline"},{"label":"C","text":"Non-adrenaline"},{"label":"D","text":"Terbutaline"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e500577c3422","stem":"A 24 years old farm worker is rushed to a nearby emer- gency department after an accidental exposure to par- athion. Which of the following drugs can be given to increase the activity of his acetyl cholinesterase","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Atropine"},{"label":"B","text":"Dimercaprol"},{"label":"C","text":"Physostigmine"},{"label":"D","text":"Pralidoxime"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d94da8726a20","stem":"Which of the following drug is not used in treatment of iridocyclitis","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Atropine eye ointment"},{"label":"B","text":"Pilocarpine eye drops"},{"label":"C","text":"Timolol eye drops"},{"label":"D","text":"Steroid eye drops"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-622389469f35","stem":"All of the following are the feature of atropine poisoning except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Autonomic Pharmacology","options":[{"label":"A","text":"Mydriasis"},{"label":"B","text":"Hallucinations"},{"label":"C","text":"Hypothermia"},{"label":"D","text":"Coma"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology · Suggested","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9891b0ceea43","stem":"In shock, Dopamine is used at the following dose rate","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"<1 – 2 mg/kg/min"},{"label":"B","text":"1 – 2 mg/kg/min"},{"label":"C","text":"2 – 10 mg/kg/min"},{"label":"D","text":"Greater than 10 mg/kg/min"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["duplicate_option_text","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-481fb85c4e10","stem":"A hypertensive patient has heart rate of 50 beats/min and taking tablet atenolol 200 mg/day in divided doses. After anesthesia, heart rate further fell down to 40 beats/ min. What will be the appropriate treatment to improve heart rate","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"IV adrenaline"},{"label":"B","text":"IV atropine"},{"label":"C","text":"IV isoprenaline"},{"label":"D","text":"Dobutamine infusion intravenously"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-bc8b814925cd","stem":"Which drug is contraindicated in a glaucoma patient suffering from bronchial asthma","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Respiratory","topicOriginal":"Respiratory","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Timolol maleate"},{"label":"B","text":"Latanoprost"},{"label":"C","text":"Betaxolol"},{"label":"D","text":"Brimonidine"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Respiratory","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-02a76a1e7143","stem":"A 33 years old patient with history of asthma is being treated for symptoms of hypertension. Which of the following beta blocker would be an appropriate therapy for this patient","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Isoprenaline"},{"label":"B","text":"Labetalol"},{"label":"C","text":"Metoprolol"},{"label":"D","text":"Propanolol"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-d97c1176ec34","stem":"Stimulation of which receptor will release renin","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Alpha 1"},{"label":"B","text":"Alpha 2"},{"label":"C","text":"Beta 1"},{"label":"D","text":"Beta 2"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ac7dcbb47b72","stem":"Mydriatic which does not cause cycloplegia is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Tropicamide"},{"label":"B","text":"Atropine"},{"label":"C","text":"Homatropine"},{"label":"D","text":"Phenylephrine"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9e9a8665c9ee","stem":"Drugs used in treatment of organophosporus poisoning are all except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Sodium bicarbonate"},{"label":"B","text":"Naloxone"},{"label":"C","text":"Atropine"},{"label":"D","text":"Activated charcoal"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3650c962c9f2","stem":"Ans. (d) Partial heart block (Ref: KDT 7/e p108-110) • Cholinergic drugs decrease the conduction from atrium to ventricle , thus should be avoided in partial heart block • Cholinergic drugs like pilocarpine and physostigmine are used in angle closure glaucoma • Neostigmine (acetylcholineesterase inhibitor, a cholinergic drug) is used for treatment of myasthenia gravis • Neostigmine is also used for post operative paralytic ileus and post operative urinary retention.","type":"Short Answer","subject":"Pharmacology","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f50a21b49fb8","stem":"Ans. (b) Bradycardia (Ref: KDT 6/e p104) Cholinomimetic drug will cause bradycardia as an adverse effect and thus cannot be used for its treatment.","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9dfd05b4985b","stem":"Ans. (b) Clozapine (Ref: Katzung 10/e p461; KDT 6/e p426) Friends, this seems to be another blunder from paper-setter. According to us, the question should contain ‘EXCEPT’ in the stem. Three drugs given in the options i.e. clozapine, fluphenazine and paroxetine have anti-cholinergic properties and should be avoided in angle closure glaucoma. Therefore, if the question was correctly framed as ‘all should be avoided in glaucoma except’, the answer would have been pilocarpine. But, if we have to choose the answer for the question as such, we will go with clozapine, as it has maximum anti-cholinergic properties.","type":"Short Answer","subject":"Pharmacology","topic":"Autonomic Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Autonomic Pharmacology","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-782acfee9320","stem":"Ans. (b) Nor-adrenaline (Ref: Katzung 10/e p76; KDT 6/e p116) • Neurotransmitter secreted at end organ effectors of sympathetic system is mostly nor-adrenaline (except in sweat glands and hair follicle, where it is acetylcholine) whereas it is acetyl-choline at parasympathetic system.","type":"Short Answer","subject":"Pharmacology","topic":"Renal and Urinary","topicOriginal":"Renal and Urinary","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Renal and Urinary","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-54b53a6455ec","stem":"Ans. (a) Edrophonium (Ref: KDT 6/e p104) Myasthenia gravis can be differentiated from cholinergic crisis with the help of a short acting anticholinesterase agent, edrophonium. It improves the symptoms in myasthenia gravis whereas worsens the condition in cases of cholinergic cri- sis. Neostigmine is used for the treatment of myasthenia.","type":"Short Answer","subject":"Pharmacology","topic":"Autonomic Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Autonomic Pharmacology","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-cd6c1f79fbf3","stem":"Ans. (a) Strong local anaesthetic activity (Ref: KDT 6/e p144) Timolol and betaxolol are the preferred β-blockers for the treatment of glaucoma because they lack local anaesthetic activ- ity. Drugs possessing this property increase the risk of corneal ulcers.","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2befbed7eb0a","stem":"Ans. (b) Betaxolol (Ref: KDT 6/e p145) Betaxolol is a cardioselective β-block useful in glaucoma. It is longer acting than timolol. Another non-selective β-blocker used topically for the treatment of glaucoma is levobunolol.","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-406572edc964","stem":"Ans. (c) Organophosphate poisoning (Ref. KDT 6/e p104, 105) All the symptoms are of anticholinesterase poisoning except raised blood pressure and heart rate. At high doses, ACh can stimulate NN and NM receptors. These symptoms may occur due to the nicotinic actions of ACh.","type":"Short Answer","subject":"Pharmacology","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-2af31b4a8986","stem":"Ans. (c) Muscle paralysis (Ref. KDT 6/e p104, 105) Atropine is a non-selective antagonist at muscarinic receptors. It can penetrate blood brain barrier and reverse the mus- carinic action in the CNS. It can also reverse hypertension and bronchoconstiction caused due to stimulation of muscarinic receptors. However, muscle paralysis is due to Nicotinic (NN) action on which it has no activity.","type":"Short Answer","subject":"Pharmacology","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a8b6f1a02d8d","stem":"Ans. (b) Inhibition of nor-epinephrine release from adrenergic nerve endings (Ref: Goodman & Gilman 11/e p184-185; KDT 6/e p96) • Most of the blood vessels contain cholinergic M3 receptors but no parasympathetic nerve supply. • Exogenously administered ACh can stimulate M3 receptors and result in vasodilation. • Stimulation of M3 receptors increases the production of NO (endothelium derived relaxing factor; EDRF) that causes smooth muscle relaxation resulting in vasodilation. • Vasodilation also may arise indirectly due to inhibition of NA release from nerve endings by ACh. • If endothelium is damaged, ACh can stimulate receptors on vascular smooth muscle cells resulting in vasoconstriction.","type":"Short Answer","subject":"Pharmacology","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-75c6ffee6112","stem":"Ans (b) Darifenacin, (c) Oxybutynin and (d) Flavoxate (Ref: Campbell-Walsh. Urology, 9/e p2102, Goodman and Gilman, 11/e p231-232, CMDT 2010/71) Most likely, this question has typographic mistake and they have forgotton to write EXCEPT in the question, because anti- cholinergic drugs are indicated for overactive bladder and darifenacin, solefenacin, oxybutynin, flavoxate, tolterodine and fesoterodine are commonly used for this condition. So, if except is in the option, then answer would obviously be dulox- etine.","type":"Short Answer","subject":"Pharmacology","topic":"Autonomic Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Autonomic Pharmacology","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8865b7fb02b5","stem":"Ans. (b) Scopolamine hydrochloride (Ref: J Psychiatry and Law 1993:3: 447-471) Controlled administration of intravenous hypnotics to obtain information from subjects who are unable or unwilling to provide it otherwise, is known as Narcoanalysis or Narcosynthesis. Drugs used for narcoanalysis are: – Ethanol – Scopolamine https://kat.cr/user/Blink99/ tahir99 - UnitedVRG Autonomic Nervous System 99 99 General Pharmacology Autonomic Nervous System – Temazepam – Barbiturates like Thiopentone and Amobarbital These drugs are also known as truth drug or truth serum. • Phenobarbitone is not used, rather amobarbital is used for narcoanalysis.","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic","url_or_navigation_embedded"],"cleaningOperations":[]},{"id":"q-4d45fa95e7b8","stem":"Ans. (d) Duloxetine (Ref: Principles of Pharmacology, 1/e p157, 159; KDT 6/e p111) • Anticholinergic drugs decrease the motility of urinary tract and thus may result in urinary retention (therefore contra-indicated in BHP). • Dicyclomine, flavoxate and oxybutynin are useful for the treatment of urinary incontinence due to detrussor insta- bility (urge incontinence) • Tolterodine, darifenacin and solefenacin are selective M3 antagonists that are also useful for urinary incontinence. • Duloxetine is an SSRI used for the treatment of depression","type":"Short Answer","subject":"Pharmacology","topic":"Renal and Urinary","topicOriginal":"Renal and Urinary","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Renal and Urinary","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f9029526c36d","stem":"Ans. (c) Urinary retention (Ref: Katzung 10/e p117; KDT 6/e p113) • Ipratropium and tiotropium are antimuscarinic drugs used for treatment of bronchial asthma and COPD by inhala- tional route. • Antimuscarinic drugs are contra-indicated (relative) in patients with –– Glaucoma especially angle closure glaucoma –– History of BHP (urinary retention)","type":"Short Answer","subject":"Pharmacology","topic":"Respiratory","topicOriginal":"Respiratory","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Respiratory","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-9f8ab836f0d2","stem":"Ans. (b) Ipratropium (Ref: Katzung 10/e p115; KDT 6/e p110-111) • Ipratropium is an anticholinergic drug which is used for the treatment of COPD and bronchial asthma.","type":"Short Answer","subject":"Pharmacology","topic":"Respiratory","topicOriginal":"Respiratory","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Respiratory","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-fcc1cfdea77e","stem":"Ans. (a) Atropine (Ref: KDT 6/e p98) • Treatment of choice for rapid onset type of mushroom poisoning is atropine.","type":"Short Answer","subject":"Pharmacology","topic":"Autonomic Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Autonomic Pharmacology","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8c9af0dfa905","stem":"Ans. (c) Neostigmine (Ref: KDT 6/e p104) • Cholinergic drugs increase GI motility. Neostigmine is an inhibitor of the enzyme AChE (which is responsible for the breakdown of ACh). It thus acts like a cholinergic agent. • Glycopyrrolate and atropine are anticholinergic drugs; thus reduce GI motility. Fentanyl is an opioid and can cause constipation.","type":"Short Answer","subject":"Pharmacology","topic":"Autonomic Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Autonomic Pharmacology","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-805d519ef302","stem":"Ans. (d) Blockade of muscarinic auto-receptors on vagal nerve endings (Ref: KDT 6/e p107) Atropine is a non-selective antagonist of M1, M2 and M3 muscarinic receptors. M2 cholinergic receptors are responsible for bradycardia and blockade of these receptors can result in tachycardia. Atropine initially acts on presynaptic M1 receptors (normally decrease the release of ACh) and result in greater release of ACh which is responsible for bradycardia. Later on, blockade of M2 receptors will lead to tachycardia.","type":"Short Answer","subject":"Pharmacology","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-3031bc792242","stem":"Ans. (a) Hyoscine (Ref: KDT 6/e p113) Hyoscine is used for the prophylaxisof motion sickness whereas other drugs listed in the question are used for the treatment of vomiting.","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d14d5bb3a3a1","stem":"Ans. (d) Increased bowel sounds (Ref: KDT 6/e p107) Atropine is an anticholinergic drug. It will decrease GI motility. Atropine flushing is seen in overdose, the exact mecha- nism of which is not known.","type":"Short Answer","subject":"Pharmacology","topic":"Gastrointestinal","topicOriginal":"Gastrointestinal","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Gastrointestinal","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-55fa1236e166","stem":"Ans. (c) Obstructive sleep apnea (Ref: www.fda.gov; KDT 6/e p470-471) • Modafinil is a sympathomimetic drug and is alpha and beta agonist in brain. The drug also acts upon several other receptors. It has brain activating properties and is the drug of choice for narcolepsy. • Modafinil can also be used for sleep disorders in shift workers. • Recently, FDA has approved modafinil as an adjunctive treatment for obstructive sleep apnea. Remember, continous positive airway pressure (cPAP) is the treatment of choice for this disorder. Modafinil is approved only as adjunc- tive treatment. https://kat.cr/user/Blink99/ tahir99 - UnitedVRG Autonomic Nervous System 101 101 General Pharmacology Autonomic Nervous System","type":"Short Answer","subject":"Pharmacology","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["url_or_navigation_embedded"],"cleaningOperations":[]},{"id":"q-4da665b422ef","stem":"Ans. (c) Phenylephrine (Ref: Harrison /18/e p377-378) Alpha blockers are used in erectile dysfunction not alpha agonists (phenyephrine). Drugs useful in the management of erectile dysfunction (ED) • Phosphodiesterase inhibitors –– Sildenafil –– Vardenafil –– Tadalafil –– Udenafil • PGE1 analog – Alprostadil • Aviptadil","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0267a0157150","stem":"Ans. (b) 1 : 1000 for inhalational route (Ref: Drug Facts and Comparisons, 2010/837) For inhalational route, adrenaline is used in a concentration of 1:100 for treatment of bronchial asthma by nebulizer.","type":"Short Answer","subject":"Pharmacology","topic":"Respiratory","topicOriginal":"Respiratory","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Respiratory","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-15c4962f4af5","stem":"Ans. (b) Dobutamine (Ref: Harrison 17/e p1399-1400) • Pharmacological stress testing is done in individuals who are not able to exercise. • It is done by infusion of dobutamine to increase myocardial oxygen demand.","type":"Short Answer","subject":"Pharmacology","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-2096f1015882","stem":"Ans. (a) Ephedrine (Ref: Current Diagnosis And Treatment-obstetrics And Gynecology, 2008) Vasopressors act by stimulating alpha adrenergic receptors. This vasoconstriction can lead to fetal hypoxia by reducing uteroplacental perfusion. Vasopressors acting predominantly by alpha receptors can also increase uterine tone and further aggaravate the fetal hypoxia. Phenylephrine, methoxamine and mephentermine are all alpha agonists and can cause this side effect so not preferred in pregnant female. Ephedrine on the other hand possess beta adrenergic activity also and result in less vasospasm (due to beta 2 mediated vasodilation) and is considered as the vasopressor of choice in pregnant females especially for the treatment of hypoten- sive complication of regional anaesthesia.","type":"Short Answer","subject":"Pharmacology","topic":"Obstetrics","topicOriginal":"Obstetrics","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Obstetrics","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-26e179776ae8","stem":"Ans. (a) Hypertensive emergencies (Ref: Katzung 10/e p133, 174) • Fenoldopam is a D1 agonist useful for i.v. treatment of hypertensive emergencies.","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e7d0d715121e","stem":"Ans. (b) Hypoglycemia (Ref: KDT 6/e p124) • β2 agonists are the inhaled bronchodilators used for the management of bronchial asthma. • Tremor is the dose related adverse effect of these drugs. https://kat.cr/user/Blink99/ Review of Pharmacology 102 Autonomic Nervous System • Brief hyperkalemia followed by hypokalemia is an important adverse effect of these agents. • β2 agonists do not cause hypoglycemia.","type":"Short Answer","subject":"Pharmacology","topic":"Respiratory","topicOriginal":"Respiratory","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Respiratory","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["url_or_navigation_embedded"],"cleaningOperations":[]},{"id":"q-01eacc4425f0","stem":"Ans. (d) Erectile dysfunction (Ref: KDT 6/e p129, 130) • Erection of penis requires increased blood supply by means of vasodilatation. This can be produced by α-blockers and not by agonists. Other drugs for erectile dysfunction are phosphodiesterase inhibitors like sildenafil and tadalafil. • Sympathomimetic agents are positive ionotropic agents and can be used for the treatment of acute decompensated heart failure. Dopamine and dobutamine are particularly suited for this purpose. • These agents can be used for the treatment of hypotension (dopamine) as well as hypertension (clonidine).","type":"Short Answer","subject":"Pharmacology","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-5c1da67700fc","stem":"Ans. (a) IV noradrenaline increases systolic and diastolic BP and causes tachycardia (Ref: Katzung 10/e p132) Noradrenaline increases blood pressure (both systolic and diastolic) which lead to reflex activation of baroreceptors result- ing in bradycardia. Adrenaline increases systolic BP and cause tachycardia. It has negligible effect on diastolic BP. How- ever both rise and fall have been noted. For details, see text.","type":"Short Answer","subject":"Pharmacology","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-3e8c859c81c5","stem":"Ans. (b) Methyl dopa (Ref: KDT 6/e p547) Methyl dopa itself is not an a2 agonist but it is converted to an active metabolite a-methyl norepinephrine which possesses a2 agonistic action. All other drugs listed in the question are a2 agonists for the treatment of hypertension.","type":"Short Answer","subject":"Pharmacology","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a72e4f598734","stem":"Ans. (c) Benign hyperplasia of prostate (Ref: KDT 6/e p146) a2 agonists like apraclonidine and brimonidine are useful for the treatment of glaucoma. Clonidine is also used for the management of hypertension. Dexmedetomidine is a centrally acting α2 agonist indicated for sedation of initially intu- bated and mechanically ventilated patients.","type":"Short Answer","subject":"Pharmacology","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-5a5b3dd91020","stem":"Ans. (a) Adrenaline (Ref: KDT 6/e p123) Vasomotor reversal of dale is seen with adrenaline. When this drug is infused quickly, initially there is rise in blood pressure (due to sitmulation of  receptors) followed by prolonged fall (β2 action). α-blocking drugs inhibit the initial rise and only fall in blood pressure is recorded. This is known as vasomotor reversal. Nor-adrenaline has no β2 activity and isoprenaline lacks  activity, therefore cannot demonstrate this phenomenon.","type":"Short Answer","subject":"Pharmacology","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-1ea7875d0856","stem":"Ans. (a) Dopamine (Ref: KDT 6/e p126) Dopamine has concentration dependent effects on various receptors. When infused at a rate of less than 2 μg/kg/min., it stimulates only dopamine receptors (resulting in renal vasodilation). At 2-10 μg/kg/min. infustion rate, it stimulates β2 receptors also and at a rate greater than 10 μg/kg/min. it causes vasoconstriction due to stimulation of -receptors.","type":"Short Answer","subject":"Pharmacology","topic":"Renal and Urinary","topicOriginal":"Renal and Urinary","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Renal and Urinary","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-36c68f9b13a0","stem":"Ans. (c) Secondary shock (Ref: KDT 6/e p129) Sympathomimetic drugs are indicated in all types of shock except secondary shock. In this condition, there is reflex vaso- constriction. Alpha blockers are useful in this type of shock.","type":"Short Answer","subject":"Pharmacology","topic":"Autonomic Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Autonomic Pharmacology","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-05f6a231bfef","stem":"Ans. (b) Asthma (Ref: KDT 6/e p127) Beta-2 agonists are useful in premature uterine contractions to delay labour and not for delayed labor. Beta blockers are used in the treatment of angina.","type":"Short Answer","subject":"Pharmacology","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-9bbcc48a631c","stem":"Ans. (a) Renal vasodilatory effect (Ref: Katzung 11/e p137) Dopamine acts on D1, β1 and α1 receptors. Stimulation of D1 receptors cause renal vasodilation, which is useful clinically to improve renal perfusion in shock with oligouria.","type":"Short Answer","subject":"Pharmacology","topic":"Renal and Urinary","topicOriginal":"Renal and Urinary","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Renal and Urinary","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-3a317e784f17","stem":"Ans. (c) Ephedrine (Ref: KDT 6/e p123) • Ephedrine acts directly as well as indirectly through release of nor-adrenaline. Latter increases systolic (β1) as well as diastolic (α1 action) blood pressure. This is due to lack of β2 mediated vasodilation. • Adrenaline transiently increase diastolic BP which later on decreases due to its β2 stimulatory action.","type":"Short Answer","subject":"Pharmacology","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-aee477b20f8a","stem":"Ans. (a) 120 seconds (Ref: Lawrence 9/e p453) Dobutamine is an inotropic drug which has onset of action = 1-2 min. Peak action = 1-10 min. Duration of action = < 10 min. Half life = 2 min.","type":"Short Answer","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2ee58aa64a6e","stem":"Ans. (b) Anaphylactic shock (Ref: KDT 6/e p129) • Epinephrine is the agent of choice for the treatment of anaphylactic shock. It increases BP by a action and causes bronchodilation by β2 action. • For bronchial asthma, selective β2 agonists like salbutamol are preferred. • For glaucoma, a prodrug of epinephrine, dipivefrine is useful (as adrenaline cannot cross corneal membrane). • Treatment for PVD is  blockers.","type":"Short Answer","subject":"Pharmacology","topic":"Respiratory","topicOriginal":"Respiratory","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Respiratory","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-51a8c5f18c56","stem":"Ans. (a) 1 receptors are usually presynaptic (Ref: KDT 6/e p119) Presynaptic sympathetic receptors are usually α2. Other statements are true.","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0c967fdcd421","stem":"Ans. (c) Decrease in the production of aqueous humor (Ref: Goodman and Gilman 12/e p1787) Beta-blockers decrease the formation of aqueous humor and thus decrease intra-ocular pressure. Goal of treatment in glaucoma is to prevent progressive optic nerve damage with minimum side effects.","type":"Short Answer","subject":"Pharmacology","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-606df5965126","stem":"Ans (c) Lupus Erythematosus (Ref: KDT 6/e p135-136) Prazosin is a selective a1 blocker and can be used for treatment of pheochromocytoma, peripheral vascular disease, benign hyperplasia of prostate and hypertension. It is the drug of choice for scorpion sting.","type":"Short Answer","subject":"Pharmacology","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-5401f78e05d4","stem":"Ans. (b) It is most effective in new onset decompensated heart failure (Ref: KDT 6/e p142, 143) • Beta blockers are absolutely contraindicated in decompensated (acute) heart failure. • In compensated heart failure, these agents should be initiated at very low doses and the dose should be in- creased gradually. • If used in this manner, long term use of β-blockers can decrease the mortality in CHF patients. • Carvedilol is the most commonly used beta blocker in CHF due to its antioxidant and antimitogenic property.","type":"Short Answer","subject":"Pharmacology","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-8440ce27aa17","stem":"Ans. (e) It can cause bradycardia (Ref: KDT 6/e p142) • Esmolol is an ultra shot acting cardioselective β-blocker devoid of partial agonistic or membrane stabilizing effect. It is used in terminating supraventricular tachycardia, episodic atrial fibrillation or flutter, arrhythmia during anaes- thesia, to reduce BP and HR during cardiac surgery and early treatment of MI. • β-blocker are contra-indicated in decompensated heart failure.","type":"Short Answer","subject":"Pharmacology","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-c086f2fcd3f1","stem":"Ans. (a) Atropine; (c) Glucagon (e) Calcium chloride (Ref: Washington Mannual 31/e p573) • Treatment of β-blocker poisoning : https://kat.cr/user/Blink99/ Review of Pharmacology 106 Autonomic Nervous System –– Establish an i.v. line before any other therapy is undertaken. –– Gastric lavage is done if patient is seen within one hour of therapy. –– To treat hypotension, start i.v. saline, I.V. glucagon is the drug of first choice in β-blocker poisoning. Adrena- line and nor-adrenaline are less effective for the treatment of β-blocker poisoning because β-receptors are already occupied. Glucagon increases cardiac contractility by increasing cAMP through its action on glucagon receptors. –– Calcium chloride may also be used.","type":"Short Answer","subject":"Pharmacology","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["url_or_navigation_embedded"],"cleaningOperations":[]},{"id":"q-f3ba16b3632d","stem":"Ans. (c) Short term stressful situations (Ref: KDT 6/e p143) Propanolol is used for controlling the performance anxiety, major manifestations of which are due to increased sympa- thetic activity (tachycardia, palpitalions etc.).","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-318a3777b47e","stem":"Ans. (b) Heart failure exacerbation from β-blockers (Ref: KDT 6/e p142) Beta blockers are contra-indicated in acute CHF because these can exacerbate the heart failure. Bronchoconstriction and impairment of blood glucose response is seen with β-blockers. These agents also decrease intraocular pressure and are used for the treatment of glaucoma.","type":"Short Answer","subject":"Pharmacology","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-1e1ed6ffe1a3","stem":"Ans. (d) Timolol lacks the local anaesthetic effects of propanolol (Ref: KDT 6/e p140, 141, 144, 145) • Metoprolol is a cardioselective (β1 selective) blocker and not β2 selective. • Esmolol is the shortest acting β -blocker and is useful for acute treatment. • Nadolol is a non-selective β-blocker. It blocks both β1 as well as β2 receptors. • Propanolol possesses maximum local anaesthetic activity whereas timolol lacks this property. • For more details, see text.","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-24805ddb1363","stem":"Ans. (d) Prazosin (Ref: Harrison 17/e p2752) Prazosin is used for treatment of scorpion sting.","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-bbbc8bc7e84d","stem":"Ans. (a) Hypothyroidism (Ref: KDT 6/e p142, 143) • Beta blockers are used to treat hyperthyroidism (not hypothyroidism). • These are the only drugs that offer prophylactic benefits in a patient of varices who has never bled.","type":"Short Answer","subject":"Pharmacology","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrinology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-698d0c8c716b","stem":"Ans. (b) Parkinsonian tremor (Ref: KDT 6/e p143) Propanolol is useful in the management of tremor due to overdose of sympathomimetic agents (β2 mediated). Metoprolol as well as propanolol are effective in essential or familial tremor (β1 mediated). β-blockers are ineffective in intention tremor and rest (parkinsonian) tremors.","type":"Short Answer","subject":"Pharmacology","topic":"Autonomic Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Autonomic Pharmacology","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ac62d3cdeca6","stem":"Ans. (b) Adjuvant pharmacotherapy for BMI > 30 kg/m2 (Ref: CMDT 2014/1215) NIH Clinical obesity guidelines recommend • Lifestyle modification for all • Surgery for patients with: –– BMI >40 kg/m2 –– BMI >35 kg/m2 with obesity related co-morbidities • Pharmacotherapy for patients with: –– BMI >30 kg/m2 –– BMI >27 kg/m2 with obesity-related risk factors.","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-bb7110ec1fd4","stem":"Methotrexate It is first choice DMARD and is used at much lower doses (7.5 mg weekly) than required in cancer chemotherapy (30 mg daily). Adverse effects of methotrexate • Gastric irritation and stomatitis (most common) • Pancytopenia • Hepatotoxicity with fibrosis and cirrhosis Risk factors are: v Chronic hepatitis v Heavy alcohol consumption v Diabetes mellitus v Obesity v Kidney disease • Interstitial pneumonitis (Hypersensitivity reaction) • Teratogenicity • Increased risk of B-cell lymphomas • Amoxycillin and probenecid increase risk of methotrexate toxicity","type":"Short Answer","subject":"Pharmacology","topic":"Gastrointestinal","topicOriginal":"Gastrointestinal","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Gastrointestinal","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b7cfc126768e","stem":"Sulfasalazine It is metabolized to sulfapyridine and 5-aminosalicylic acid. Former is the active moiety in RA and latter is useful for ulcerative colitis. It is used in patients when methotrexate is contraindicated.","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-183ced8d0b1c","stem":"Minocycline It is reserved for early mild cases and works better during the first year of RA. Mechanism of action is not clear but it has anti-inflammatory property including the ability to inhibit collagenase. Most common adverse effect of minocycline is dizziness.","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9501aae611bb","stem":"Old drugs Gold and d-penicillamine are highly efficacious DMARDs but are rarely used now due to severe toxic reactions. Gold salts can be used orally (auranofin) as well as intramuscularly (aurothiomalate). Dermatitis is the most common adverse effect seen with gold salts. These can also result in kidney and liver damage, peripheral neuropathy, pulmonary fibrosis, encephalopathy and bone marrow depression.","type":"Short Answer","subject":"Pharmacology","topic":"Respiratory","topicOriginal":"Respiratory","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Respiratory","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-84c5f06b371b","stem":"Which is not a 2nd generation anti-histaminic agent?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cetirizine\b (AIIMS Nov 2012)"},{"label":"B","text":"Cyclizine"},{"label":"C","text":"Loratidine"},{"label":"D","text":"Fexofenadine"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-421c5fd6ea55","stem":"A peptide that causes increased capillary permeability and edema is? (AI 2012)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Histamine"},{"label":"B","text":"Angiotensin II"},{"label":"C","text":"Bradykinin"},{"label":"D","text":"Renin"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-cbc58fd61e6d","stem":"A highway truck driver has profuse rhinorrhoea and sneezing. Which amongst the following drugs would you prescribe him? (AI 2002)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Pheniramine"},{"label":"B","text":"Promethazine"},{"label":"C","text":"Dimenhydrinate"},{"label":"D","text":"Cetirizine"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f92afcec9d3f","stem":"Which of the following is NOT a second generation antihistaminic? (AIIMS, May 2008, AIIMS Nov 2006)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cyclizine"},{"label":"B","text":"Fexofenadine"},{"label":"C","text":"Loratidine"},{"label":"D","text":"Acrivastine"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-95bd269c3342","stem":"The H3 receptor agonist exhibits all of the following actions EXCEPT: (AIIMS Nov, 2002)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Inhibition of H1 receptor induced wakefulness"},{"label":"B","text":"Increase in H1 mediated gastrin secretion"},{"label":"C","text":"Inhibition of H1 mediated bronchoconstriction"},{"label":"D","text":"Negative chronotropic effect on atria"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c12b3aba828b","stem":"All of the following actions of histamine are mediated through H1 receptors except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Release of EDRF from vascular endothelium result- ing in vasodilation"},{"label":"B","text":"Direct action on vascular smooth muscle causing vasodilation"},{"label":"C","text":"Bronchoconstriction"},{"label":"D","text":"Release of catecholamines from adrenal medulla"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b7e1ea798344","stem":"Which of the following drugs can cause hypotension by release of histamine from mast cells?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Aspirin"},{"label":"B","text":"Procaine"},{"label":"C","text":"Morphine"},{"label":"D","text":"Sulfadiazine"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b994e800d024","stem":"All of the following antihistaminic agents lack anticholinergic property except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Autonomic Pharmacology","options":[{"label":"A","text":"Promethazine"},{"label":"B","text":"Astemizole"},{"label":"C","text":"Levo-cetirizine"},{"label":"D","text":"Loratidine"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cle