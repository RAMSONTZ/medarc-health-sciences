70c814f7","stem":"Which is NOT located at the level of the lower border of T4 vertebra?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Thoracic Anatomy","suggestedTopic":null,"options":[{"label":"A","text":"the most superior part of the arch of the aorta"},{"label":"B","text":"azygous vein enters the superior vena cava"},{"label":"C","text":"thoracic duct reaches the left side of the oesophagus as it ascends"},{"label":"D","text":"ligamentum arteriosum"},{"label":"E","text":"superficial and deep parts of the cardiac plexus"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"d872626a64c64fd308cc864eb6af052cfe846877"},{"id":"q-d3f0b92f09a1","stem":"Regarding the cardiac veins","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Heart and Coronary Circulation","suggestedTopic":null,"options":[{"label":"A","text":"the great cardiac vein accompanies the posterior descending interventricular artery"},{"label":"B","text":"the middle cardiac vein ends in the right atrium"},{"label":"C","text":"the anterior cardiac vein ends in the right atrium"},{"label":"D","text":"the small cardiac vein accompanies the circumflex branch of the left coronary artery"},{"label":"E","text":"the oblique veins of the left atrium end in the left atrium"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"