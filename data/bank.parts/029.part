t":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9ce2a5601830","stem":"Involuntary movements (hyperkinesis) are the following syndromes","type":"Short Answer","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a422784e891d","stem":"The energy of muscle contraction is derived from the following except: a- ATP. b- muscle glycogen. c- lactic acid. d- Creatine phosphate. c","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-9938a8e0a3aa","stem":"Chronaxia: a- is the minimal stimulus which produce response after relatively long time. b- is the minimal time needed by the strong stimulus to produce response. c- is the time required to stimulate the nerve by a minimal stimulus. d- is the time required to stimulate the nerve by a stimulus which is double rheobase. d","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["subject_unclassified"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified"],"cleaningOperations":[]},{"id":"q-5effbddd74c5","stem":"During depolarization: a- voltage activated Na+ channels open. b- the membrane becomes impermeable to Na+. c- when membrane potential reaches -55 m.v Na+& K+ fluxes occur at the same time. d- K+ ions diffuse outside. a","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-a5797cf77143","stem":"Local excitatory state is characterized by the following except: a- its magnitude is directly proportional with the intensity of the sub-minimal stimulus. b- does not obey all or non rule. c- can be summated. d- propagated without decrement. d","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassifie