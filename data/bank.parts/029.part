2a7392c559c0c1d79283114e299e3b131370"},{"id":"q-d5c6d04e694d","stem":"The process of “active transport” through a membrane may be described by which of the following?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thoracic Wall and Ribs","topicOriginal":"Thoracic Wall and Ribs","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the movement of ions and small molecules away from regions where they are in high concentration."},{"label":"B","text":"the use of energy from ATP to move ions and small molecules into regions where they are in lower concentration."},{"label":"C","text":"the plasma membrane engulfs the substance and moves it through the membrane."},{"label":"D","text":"the use of energy from ATP to move ions and small molecules against their concentration gradient."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thoracic Wall and Ribs","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":["source answer/boilerplate removed from option D"],"duplicateStemGroup":"6abe6f395d829637bbbcf9314ef7cae54c613660"},{"id":"q-b56ce7521412","stem":"Cell membranes can maintain a difference in electrical charge between the inte- rior of the cell and the extracellular fl uid. What is this charge difference called?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"excitability"},{"label":"B","text":"the membrane potential"},{"label":"C","text":"the action potential"},{"label":"D","text":"the sodium-potassium pump"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D","whitespace/page_marker_normalization"],"duplicateStemGroup":"a4619974f695b05f63724c947f2845a9aee1f85e"},{"id":"q-b8d4ea652e33","stem":"Membrane proteins perform the following functions EXCEPT one. Which One?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"form the glycocalyx"},{"label":"B","text":"act as receptor proteins"},{"label":"C","text":"form pores to allow the passage of small solutes"},{"label":"D","text":"behave as enzymes."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"e495e39102617e56b0586367b42b26656436e30b"},{"id":"q-9477204b5072","stem":"Which one of the following terms best describes the structure of the cell membrane","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thoracic Wall and Ribs","topicOriginal":"Thoracic Wall and Ribs","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"fl uid mosaic model"},{"label":"B","text":"static mosaic model"},{"label":"C","text":"quaternary structure"},{"label":"D","text":"multilayered structure"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thoracic Wall and Ribs","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"364877d0ccd5030ab28cf597d08d6684ba2b92a9"},{"id":"q-a2779c70a8b9","stem":"What is the major function of lysosomes? They","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"package proteins"},{"label":"B","text":"detoxify toxic substances"},{"label":"C","text":"catalyse lipid metabolism"},{"label":"D","text":"digest unwanted particles within the cell"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"376f041cd50babd86f8faa3512d6db185a80657d"},{"id":"q-d8339358d836","stem":"What is the name of the mechanism that ensures that there is a higher concen- tration of sodium ions in the extracellular fl uid than in the intracellular fl uid?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Facilitated diffusion"},{"label":"B","text":"The sodium-potassium pump"},{"label":"C","text":"Secondary active transport"},{"label":"D","text":"Osmosis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D","whitespace/page_marker_normalization"],"duplicateStemGroup":"42a6fd1120055289825e794930060354b3ef4ab1"},{"id":"q-301fd54874a0","stem":"Which of the following statements about “leak channels” in the plasma mem- brane is correct?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Proteins that form these channels bind to solutes to allow them to pass into the cell."},{"label":"B","text":"They are passageways formed by proteins to allow water and ions to move passively through the membrane."},{"label":"C","text":"They allow small ions and molecules to move between adjacent cells."},{"label":"D","text":"They are formed by glycoprotein and proteoglycans to allow hormones to enter cells."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"63e9e8340d269fc793c81eebc25a6a248af75fcb"},{"id":"q-553e62c3b930","stem":"Epithelial and connective tissue differ from each other in which of the follow- ing characteristics?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"epithelial tissue contains fi bres but connective tissue does not."},{"label":"B","text":"connective tissue is avascular but epithelial tissue is well-vascularised."},{"label":"C","text":"cells in epithelial tissue are closely packed, whereas in connective tissue they are not."},{"label":"D","text":"connective tissue includes tissue that makes up glands, but epithelial tissue does not occur in glands."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"a6e002d3158e98d6483e22b88314062f9109512d"},{"id":"q-5b57514fb28a","stem":"Which of the following is a component of the plasma membrane of a cell?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"plasma"},{"label":"B","text":"glycolipid"},{"label":"C","text":"plasma proteins"},{"label":"D","text":"cholesterol"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"],"duplicateStemGroup":"24801971664fdde59ff5a5218c1fde28bea1aa30"},{"id":"q-c40c8928ca7c","stem":"Facilitated diffusion through a membrane involves which of the following scenarios?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the diffusion of water through a selectively permeable membrane along its concentration gradient."},{"label":"B","text":"the movement of a molecule against its concentration gradient with the expenditure of energy"},{"label":"C","text":"the plasma membrane surrounding (engulfi ng) the molecule & the molecule moving into the cell."},{"label":"D","text":"a molecule binding to a receptor which moves the molecule through the membrane without the expenditure of energy"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"0e6c60de336f6355cc393f056d959b4f7ac16b8a"},{"id":"q-547c3b99185b","stem":"Which of the following is true for connective tissue?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"it consists of cells, a basement membrane and intercellular matrix"},{"label":"B","text":"its cells are closely packed and held together by protein fi bres."},{"label":"C","text":"it has a high rate of cell division and no blood supply"},{"label":"D","text":"it is made of cells, protein fi bres and ground substance"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"f8951bb1180b4b65aa89c85019b7f026e8c72699"},{"id":"q-caeffa0d9f23","stem":"In which phase of mitosis would chromosomes line up at the centre of the spindle","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"anaphase"},{"label":"B","text":"interphase"},{"label":"C","text":"prophase"},{"label":"D","text":"metaphase"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"],"duplicateStemGroup":"26b21299b3cb1438f2f651d982852304751fd0b7"},{"id":"q-918e0a2ba852","stem":"What results from the events that occur during metaphase of mitosis?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The nuclear membranes form around two nuclei."},{"label":"B","text":"The chromosomes are aligned on a plane in the centre of the cell."},{"label":"C","text":"The chromosomes become visible and attach to the spindle fi bres."},{"label":"D","text":"The chromatids from each chromosome separate and move to opposite sides of the cell."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"dcbf44012df785a0679b193939b862f11f27b01f"},{"id":"q-da82af60e484","stem":"What happens during anaphase of mitosis?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"spindle fi bres pull each chromatid to opposite sides of the cell"},{"label":"B","text":"the sense and non-sense strands “unzip” along their hydrogen bonds"},{"label":"C","text":"RNA polymerase forms a complementary strand by reading the sense strand"},{"label":"D","text":"the cell cytoplasm divides into two cells"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"963db454a2519dcce360684c10b3f525d642ec58"},{"id":"q-8e1a75af6bb1","stem":"How many nucleotides are required to code for a single amino acid?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"twenty"},{"label":"B","text":"fi ve"},{"label":"C","text":"three"},{"label":"D","text":"one"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"3515af40e8a308afc970a015371412da83205531"},{"id":"q-514365100fad","stem":"Which statement is true of the 23 chromosomes within a sperm?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"23 chromosomes is the diploid number"},{"label":"B","text":"11 chromosomes came from the father, 11 chromosomes came from the mother, while one of either the Y or the X came from the father or mother respectively."},{"label":"C","text":"Some of the 23 came from the father and the rest came from the mother."},{"label":"D","text":"11 chromosomes and the Y came from the father, while 11 chromosomes came from the mother."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"],"duplicateStemGroup":"51324b69388213a27a6629809cd4e21e136ed2d9"},{"id":"q-7790ababa204","stem":"Say that someone’s body temperature is measured by four different devices and the resulting four measurements are given below. Which reading has an abso- lute error of ± 0.05 °C?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"38 °C"},{"label":"B","text":"37.8 °C"},{"label":"C","text":"37.85 °C"},{"label":"D","text":"37.855 °C"}],"priority":0,"status":"practice_draft","flags":["topi