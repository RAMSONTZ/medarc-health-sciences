 MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Haemolysis"},{"label":"B","text":"Haemopoiesis 7 Skeleton and Joints 127"},{"label":"C","text":"Haematuria"},{"label":"D","text":"Haemostasis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"],"duplicateStemGroup":"66732cf5bdea6149c3486d92ac93fdc293d6fa4f"},{"id":"q-c25f28bc8230","stem":"Which of the following describes the movements known as pronation and supination?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thoracic Wall and Ribs","topicOriginal":"Thoracic Wall and Ribs","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The fl exing of the arm with respect to the forearm around the elbow."},{"label":"B","text":"The swivelling of the foot to the medial and lateral directions."},{"label":"C","text":"The twisting of the wrist while the elbow is held motionless."},{"label":"D","text":"The rotation at the shoulder that causes the arm to describe a cone shape."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thoracic Wall and Ribs","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"aaf24c53881e0efbf09ef8b54e71b92866e86995"},{"id":"q-39f8ed16c909","stem":"Which of the f