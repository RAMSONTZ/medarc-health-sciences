cleaningOperations":[]},{"id":"q-62acb0382805","stem":"A patient Ram kali presents with the symptoms sug- gestive of pheochromocytoma. Her urine metanephrine and vinylmandelic acid levels are above normal but normetanephrine level is less than normal. She later presents to you in emergency with chest pain and severe headache. An ECG indicates MI. Her blood pressure is 220/160 mm Hg and the heart rate is 160/ min. On exami- nation she appears to be dehydrated also. The doctor attending her gives her phentolamine i.v. Within 8-10 min, she goes in a state of shock with her blood pres- sure being 36/0 mm Hg. Vasoconstrictors are ineffective and she dies within 4 hrs. Which of the following best explains the exaggerated response to phentolamine in this patient?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Escape of the autonomic nervous system control over blood pressure"},{"label":"B","text":"Metastasis of the tumor to the vasomotor centre in medulla"},{"label":"C","text":"Patient’s tumor secreting almost pure adrenaline and no noradrenaline"},{"label":"D","text":"Overdose of phentolamine because of the rarity of such cases in the emergency"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-9ded6666865b","stem":"Dopamine is preferred in treatment of shock because of: (DPG 2010) (UP 2008)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Renal vasodilatory effect"},{"label":"B","text":"Increased cardiac output"},{"label":"C","text":"Peripheral vasoconstriction"},{"label":"D","text":"Prolonged action"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3474be4fde9c","stem":"Which of the following increases systolic and diastolic BP for prolonged period? (DELHI-PG-2008)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Epinephrine"},{"label":"B","text":"Dopamine"},{"label":"C","text":"Ephedrine"},{"label":"D","text":"All of these"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-91330fcf173f","stem":"TRUE statement regarding use of adrenaline in anaphylactic shock is: (DPG-2007)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Renal and Urinary","topicOriginal":"Renal and Urinary","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The usual dose is 0.5-1 mg by i.m. route"},{"label":"B","text":"Cerebral hemorrhage never occurs as an adverse ef- fect to epinephrine when used in treatment of ana- phylactic shock"},{"label":"C","text":"It is repeated after every 2-4 hours"},{"label":"D","text":"Same solution can be given for s.c. as well as i.v. route"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"