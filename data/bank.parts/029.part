iginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Analgesia and antipyresis"},{"label":"B","text":"Closure of ductus arteriosus"},{"label":"C","text":"Uricosuria"},{"label":"D","text":"Antiinflammatory and anti platelet aggregation"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-08fee094e0d9","stem":"Which of the following drugs inhibit an enzyme in the prostaglandin synthesis? (DPG 2000)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Aminocaproic acid"},{"label":"B","text":"Aspirin"},{"label":"C","text":"Aprotinin"},{"label":"D","text":"Alteplase"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{}},{"id":"q-cbd3170635a3","stem":"Which one of the following is aspirin?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Methyl salicylate\b (MPPG 2007, 2004)"},{"label":"B","text":"Para-aminobenzoic acid"},{"label":"C","text":"Para-aminosalicylic acid"},{"label":"D","text":"Acetyl salicylic acid"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigur