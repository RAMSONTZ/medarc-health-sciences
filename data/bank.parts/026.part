pic":"Bacteriology","topicOriginal":"Bacteriology","subtopic":"Bacterial Pathogens","suggestedTopic":null,"options":[{"label":"A","text":"Salmonella, Streptococcus viridans and Staphylococcus"},{"label":"B","text":"Streptoccus pneumoniae, Haemophilus influenzae and Staph. Aureus"},{"label":"C","text":"Bordetella pertussis, Pneumococcus and Staphylococcus epid."},{"label":"D","text":"Pneumocystis carinii, Meningococcus and Haemophilus"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Bacteriology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-47563bf24560","stem":"Which of the following CSF ( cerebrospinal fluid) results would be the most typical for TB-Meningitis?","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Protein 2.2 g/dl, Glucose 0.1mmol/l, 600 WBC, 97% Polymorphs"},{"label":"B","text":"Protein 1.8 g/dl, Glucose 0.1mmol/l, 90 WBC, 92% Lymphocytes"},{"label":"C","text":"Protein 0.4 g/dl, Glucose 1.5 mmol/l, 12 WBC, 92% Lymphocytes"},{"label":"D","text":"Protein 1.0 g/dl, Glucose 3 mmol/l, 56 WBC, 95% Lymphocytes"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"296d49cdcc7f37d82c41e18d48f54f57052bea35"},{"id":"q-a785a309735f","stem":"Which agent doesn't normally cause pneumonia in children from 1-5yrs","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"RSV"},{"label":"B","text":"B-streptococci"},{"label":"C","text":"Influenza viruses"},{"label":"D","text":"Staph.pneumoniae"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"01f7a2ceb0f251a06849357d0c2093c1223c2d08"},{"id":"q-c4d938a72cd7","stem":"Which of the following statements is TRUE about Mumps?","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The main complication is a Polyarthritis"},{"label":"B","text":"CSF lymphocytosis is common but signs of Meningitis are seen only rarely"},{"label":"C","text":"It is highly infectious and all patients are symptomatic"},{"label":"D","text":"Corneal ulceration is seen, esp. in males"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"75d5b8eefe76d12d8de792dec335060fa84e862b"},{"id":"q-0cee53f88a7d","stem":"Poliomyelitis presents in 90 % of all infections as","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"inapparent illness, which gives immunity"},{"label":"B","text":"abortive illness similar to a flue"},{"label":"C","text":"paralytic illness not involving the respiratory muscles"},{"label":"D","text":"paralytic illness with bulbar paralysis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8c5538c03846","stem":"Paraplegia can NOT be caused by the following","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Schistosoma mansoni"},{"label":"B","text":"Guillain Barree Syndrome"},{"label":"C","text":"Ascariasis"},{"label":"D","text":"Poliomyelitis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-851526acbe09","stem":"A 6 month old child, weight 6 kg presents with generalized afebrile convulsions and you want to start antiepileptic treatment. What is your choice?","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Phenobarbitone 30 mg once daily"},{"label":"B","text":"Phenobarbitone 30 mg twice daily"},{"label":"C","text":"Phenytoin 25 mg once daily"},{"label":"D","text":"Phenytoin 25 mg twice daily"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"1676d482c1b867b1b2015885e9f8ae15f341ad8e"},{"id":"q-dd539d76ca36","stem":"Which of the following statements best characterizes the diagnosis of urinary tract infection?","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The presence of fever and lower abdominal pain."},{"label":"B","text":"Presence of pyuria with 5-7 WBC per high power field"},{"label":"C","text":"If a clean – catch specimen grows a single organism in urine-culture"},{"label":"D","text":"Presence of fever with no micturation for 12 hours"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"49dd66b7e2b03df44222246764b421bf69d37120"},{"id":"q-6e92afb8cfdc","stem":"Kernicterus is most closely related to the serum level of","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"total bilirubin"},{"label":"B","text":"conjugated bilirubin"},{"label":"C","text":"unconjugated bilirubin"},{"label":"D","text":"haptoglobin"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"f0209aef86b2c2a2850f7342d6ad0bf831f84ba6"},{"id":"q-ca6354b7067c","stem":"In the Tanzanian Vaccination Schedule the live attenuated measles vaccine should be administered","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"at 6 months"},{"label":"B","text":"at 9 months"},{"label":"C","text":"at 15 months"},{"label":"D","text":"at 24 months SAQ"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"ee5686f6fe454f80aa8472c7861a1291d418d093"},{"id":"q-6a29fbfc8ec3","stem":"TRUE/FALSE QUESTIONS (1) Which criteria have to be fulfilled to call a convulsion an “uncomplicated febrile convulsion “ ? (a)...it has to occur between the age of 5-6 months to 5-6 years (b) it has to be associated with urinary incontinence (c) duration at least 20 minutes (d) it has to be generalized (e) the focus of infection has to be outside the CNS (max. 5 marks) (2) Complications of Kwashiorkor are (a) Staphylococcal Sepsis (b) Pneumonia (c) Hypoglycemia (d) anuria (e) cardiac arrhythmias (max. 5 marks) (3) A typical Nephrotic Syndrome is characterized by the following: (a) low Serum Protein (b) Hyperkalemia (c) Hypercholesterinemia (d) Edema (e) high Blood pressure (max. 5 marks) (4) Iron deficiency anemia is characterized by (a) reduced mean corpuscular volume (MCV) (b) increased MCV (c) megaloblasts in periphery (d) easy fatiguability (e) hypochromic red blood cells (max. 5 marks) (5) A 1 year old child is brought with a 2 day history of pain in the left leg. Examination reveals a miserable child with bony tenderness over the upper end of the left tibia","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A normal X-Ray will exclude osteomyelitis / osteitis"},{"label":"B","text":"If a diagnosis of osteomyelitis is made antibiotic treatment should be postponed until the result of blood culture is obtained"},{"label":"C","text":"If early osteomyelitis is confirmed the treatment of choice is orthopedic intervention and parenteral antibiotics"},{"label":"D","text":"Ultrasound may reveal subperiostal fluid accumulation (max. 4 marks)"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["possible_multiple_questions_in_stem","topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-bddc90725958","stem":"Match the following seizure descriptions with the commonly used classification of seizures by the International League against epilepsy (ILAE) ( 6 marks) List 1","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"focal motor or sensory signs without impairment of consciousness"},{"label":"B","text":"sudden blank staring for some seconds, sometimes associated with eye-lid blinking"},{"label":"C","text":"aura, followed by twitching of one side of the body without loss of consciousness"},{"label":"D","text":"focal motor, sensory or autonomic signs associated with impairment of consciousness"},{"label":"E","text":"aura followed by twitching of the whole body and loss of consciousness"},{"label":"F","text":"sudden onset of twitching of the whole body with loss of consciousness List 2:"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"7af4e62a510068e1a8e8cc6bc933153d158f72c9"},{"id":"q-6035a98e8e95","stem":"Which of the following statements best characterizes the diagnosis of urinary tract infection? a. The presence of fever and lower abdominal pain. b. Presence of pyuria with 5-7 WBC per high power field","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"C","text":"If a clean – catch specimen grows a single organism in urine-culture"},{"label":"D","text":"Presence of fever with no micturation for 12 hours"}],"priority":0,"status":"review","flags":["mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-a63b5815b422","stem":"Which of the following can reduce the risk of having a baby with cleft lip and palate?","