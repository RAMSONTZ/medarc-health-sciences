xt":"Product sales o"},{"label":"B","text":"Customer feedback o"},{"label":"C","text":"Venture capital o"},{"label":"D","text":"Office rent"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-d7f023238aa7","stem":"A pro forma balance sheet is: o","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A statement of future projections o"},{"label":"B","text":"A historical financial record o"},{"label":"C","text":"An inventory list o"},{"label":"D","text":"A marketing plan"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2ff2d678653d","stem":"Ratio analysis helps to: o","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Develop new products o"},{"label":"B","text":"Assess financial health o"},{"label":"C","text":"Design marketing campaigns o"},{"label":"D","text":"Improve employee satisfaction Entrepreneurship Definitions"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-58b3100449a8","stem":"Which scholar defined entrepreneurship as creating something new and assuming risks and rewards? o","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Schumpeter o"},{"label":"B","text":"Cantillon o"},{"label":"C","text":"Hisrich o"},{"label":"D","text":"Kirzner"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b72de51909ae","stem":"According to Cantillon, an entrepreneur is: o","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A manager of a large corporation o"},{"label":"B","text":"Someone who innovates continuously o"},{"label":"C","text":"A risk-taker operating under uncertainty o"},{"label":"D","text":"An individual focused on technological advancements"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-de56229d5208","stem":"Schumpeter’s view of an entrepreneur includes: o","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Managing a stable business o"},{"label":"B","text":"Innovating and disrupting markets o"},{"label":"C","text":"Following traditional methods o"},{"label":"D","text":"Avoiding risks"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7a31b81291b8","stem":"Hisrich defines an entrepreneur as: o","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A corporate manager o"},{"label":"B","text":"An innovator developing unique solutions o"},{"label":"C","text":"A follower of traditional practices o"},{"label":"D","text":"A government official"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-290e62a9a984","stem":"Kirzner emphasizes that an entrepreneur must: o","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Have substantial capital o"},{"label":"B","text":"Be alert to opportunities o"},{"label":"C","text":"Follow established norms o"},{"label":"D","text":"Work within large organizations"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-323f4ef66932","stem":"Kilby’s functions of an entrepreneur include all EXCEPT: o","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Perceiving profitable opportunities o"},{"label":"B","text":"Assembling administrative inputs o"},{"label":"C","text":"Managing existing markets o"},{"label":"D","text":"Responding to competition"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e9ec64453040","stem":"An intrapreneur is: o","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"An entrepreneur operating independently o"},{"label":"B","text":"An individual practicing entrepreneurship within an organization o"},{"label":"C","text":"A government official managing policies o"},{"label":"D","text":"A student studying business"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c3cf445b1bc2","stem":"C 100. B Short Answer Questions 101. Define the term 'entrepreneurship'. - Entrepreneurship is the process of identifying, developing, and bringing a vision to life. This vision can be an innovative idea, an opportunity, or a way to solve a problem. Entrepreneurs take on financial risks to start and manage new businesses, aiming for profit and growth. 102. Explain the importance of a business plan for an entrepreneur. - A business plan is crucial for an entrepreneur as it serves as a roadmap for the business, outlining goals, strategies, and plans for achieving success. It helps in securing funding from investors and lenders, provides a structured approach to business development, and helps in managing the business efficiently by tracking progress against set objectives. 103. What are the key components of a financial plan in a business plan? - The","type":"Image / Diagram Question","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["possible_multiple_questions_in_stem","prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-d825006b279b","stem":"leadership style would you use and why?**","type":"Short Answer","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a909f1dc1a7f","stem":"Describe the role of a supervisor in the appraisal process. - A supervisor plays","type":"Short Answer","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9a98b37c723d","stem":"30 - 11.30 AM INSTRUCTIONS TO CANDIDATES 1. Write your examination Code Number on each examination sheet and never your name. 2. Write answer on the examination sheets provided for Multiple Choice Questions. 3. This is a Two-hour paper consisting of Ten (10) printed pages with Two sections. Section I : Multiple-Choice Questions Section II : Short answer Questions 4. Read each question carefully. 5. Attempt all questions. 2 SECTION I - MULTIPLE CHOICE QUESTIONS Choose one out of four possibilities Allow one hour for the MCQ’ s and one hour for Short Answers 1. The presence of clubbing maybe associated with any of he following , except: increased, excludes what type of pathology?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"TB of the lungs"},{"label":"B","text":"Cancer of the lungs"},{"label":"C","text":"Bronchiectasis"},{"label":"D","text":"Fallot’ s Tetralogy 2. Cyanosis:"},{"label":"A","text":"Is called peripheral when the tongue is blue"},{"label":"B","text":"May be caused by an uncomplicated left to right shunt"},{"label":"C","text":"Is called central when the circulation is low and slow"},{"label":"D","text":"Is a measure of the quantity of reduced haemoglobin present in the blood 3. Respiratory distress:"},{"label":"A","text":"Is always the result of hypoxia"},{"label":"B","text":"Is the same as respiratory failure"},{"label":"C","text":"Is assessed by the respiratory rate and the effort( work) of breathing"},{"label":"D","text":"Is always associated with pulmonary crepitations 4. Jaundice:"},{"label":"A","text":"And dark urine, pale faeces and pruritus suggests hepato-cellular disease"},{"label":"B","text":"May occur in malaria from malarial hepatitis from plasmodian invasion of the Kuppfer cells"},{"label":"C","text":"Associated with fever and right upper quadrant pain and tenderness is called Charcot’ s triad and suggests cholangitis"},{"label":"D","text":"Associated with a large gall bladder is called Trousseau’ s sign and suggests chronic cholecystitis 5. Hepatomegaly is usually present in the following, except:"},{"label":"A","text":"Cirrhosis"},{"label":"B","text":"Hepatocellular carcinoma"},{"label":"C","text":"Tricuspid incompetence"},{"label":"D","text":"Chronic myeloid keukaemia 6. Pallor:"},{"label":"A","text":"And koilonychia suggests acute blood loss anaemia"},{"label":"B","text":"And leg ulcers suggest haemolytic anaemia"},{"label":"C","text":"And splenomegaly suggests polycythaemia vera rubra"},{"label":"D","text":"And microcytosis suggests iron deficiency from hookworm infestation 3 7. Raised jugular venous pressure occurs in all of the following , except:"},{"label":"A","text":"Nephrotic syndrome with gross oedema"},{"label":"B","text":"Left ventricular failure"},{"label":"C","text":"Chronic TB with pulmonary hypertension"},{"label":"D","text":"Constrictive pericarditis 8. Haemoptysis may be caused by any of the following, except:"},{"label":"A","text":"Mitral stenosis"},{"label":"B","text":"Pulmonary embolus"},{"label":"C","text":"TB pericarditis"},{"label":"D","text":"Bronchiectasis 9. A collapsing pulse:"},{"label":"A","text":"Means the pulse pressure is small"},{"label":"B","text":"May occur in patent ductus arteriosus"},{"label":"C","text":"Is typical of aortic stenosis"},{"label":"D","text":"May cause pistol shots, which are sounds produced by the sudden opening of the aortic valve 10. A pan-systolic murmur is typical of:"},{"label":"A","text":"Mitral incompetence"},{"label":"B","text":"Mitral stenosis"},{"label":"C","text":"Aortic stenosis"},{"label":"D","text":"Pulmonary stenosis 11. A heaving apex beat located in the axillary line in the 6 intercostal space indicates:"},{"label":"A","text":"Mitral stenosis"},{"label":"B","text":"Right ventricular hypertrophy"},{"label":"C","text":"Left ventricular hypertrophy"},{"label":"D","text":"Heart failure 12. A diastolic thrill felt at the apex, indicates:"},{"label":"A","text":"Mitral incompetence"},{"label":"B","text":"A VSD"},{"label":"C","text":"Aortic incompetence"},{"label":"D","text":"Mitral stenosis 13. In assessing a patient with a BP of 180/110:"},{"label":"A","text":"Haemorrhages and exudates may be found in the fundi"},{"label":"B","text":"There will always be a raised JVP"},{"label":"C","text":"The pulse is usually irregular"},{"label":"D","text":"There is usually oedema of the ankles 14. Peripheral vascular disease may be diagnosed clinically:"},{"label":"A","text":"By auscultating for abdominal bruits"},{"label":"B","text":"Palpating the femoral and popliteal pulses but not other pulses"},{"label":"C","text":"By using the triple tourniquet test"},{"label":"D","text":"By palpating all pulses in the legs, including the dorsalis pedal and posterior tibial pulses 4 15. In atrial fibrillation:"},{"label":"A","text":"The heart rate counted by auscultation is less reliable than the peripheral pulse"},{"label":"B","text":"There is variation only in the heart rate, not in the volume of the pulse"},{"label":"C","text":"There is a fixed block in the atrio-ventricular node"},{"label":"D","text":"The pulse is irregularly irregular 16. Asthma is most likely present:"},{"label":"A","text":"If there are crepitations on auscultation"},{"label":"B","text":"There is cyanosis and dullness to percussion"},{"label":"C","text":"The clinical forced expiratory volume is less than 3 seconds"},{"label":"D","text":"There are expiratory rhonchi 17. TB of the upper lobe of the lung may be present if:"},{"label":"A","text":"There is bronchial breathing below the clavicle on one side"},{"label":"B","text":"The trachea is deviated to one side"},{"label":"C","text":"If there is infra-and supraclavicular recession and dullness to percusiion on the same side"},{"label":"D","text":"All of the above 18. Dullness to percussion may be present in:"},{"label":"A","text":"Pneumothorax"},{"label":"B","text":"Major lung collapse, such as the right lower lobe"},{"label":"C","text":"Interstitial fibrosis"},{"label":"D","text":"Pulmonary oedema without pleural effusions 19. Concerning chest signs:"},{"label":"A","text":"Vocal fremitus is the hearing of transmitted sounds from the larynx"},{"label":"B","text":"Bronchial breathing is the sound of air entering the lung"},{"label":"C","text":"Hyper-resonance on percussion in pneumothorax is present because the air in the pleural space acts as a resonating chamber"},{"label":"D","text":"Reduced percussion note implies obstructed airways 20. Abdominal distension may be caused by:"},{"label":"A","text":"Free fluid in the peritoneal space"},{"label":"B","text":"Splenomegaly"},{"label":"C","text":"Ovarian tumour"},{"label":"D","text":"All of the above 21. Ascites may be detected:"},{"label":"A","text":"By auscultation"},{"label":"B","text":"By the presence of a fluid thrill, performed by slow compression of the abdominal wall"},{"label":"C","text":"By demonstrating shifting dullness to be present"},{"label":"D","text":"By establishing guarding is present 5 22. An acute abdomen:"},{"label":"A","text":"Is present when there is diarrhoea and vomiting"},{"label":"B","text":"May be caused by acute expansion of an abdominal aortic aneurysm"},{"label":"C","text":"Requires admission to a medical department"},{"label":"D","text":"Can only be diagnosed with an X-Ray 23. Rebound tenderness:"},{"label":"A","text":"Is diagnostic of intestinal obstruction"},{"label":"B","text":"May be present in the left iliac fossa, suggestive of pyelonephritis"},{"label":"C","text":"Indicates inflammation of the parietal peritoneum at the site of tenderness"},{"label":"D","text":"Is determined by gentle palpation and percussion 24. Papilloedema:"},{"label":"A","text":"Is present when the disc is swollen and the eye is blind"},{"label":"B","text":"Is the result of compression of the central retinal artery"},{"label":"C","text":"May be present in raised severe hypertension"},{"label":"D","text":"Means it is safe to perform a lumbar puncture 25. Diplopia:"},{"label":"A","text":"Means reduced and blurred vision"},{"label":"B","text":"May occur with a VII nerve palsy"},{"label":"C","text":"Indicates that the sympathetic nerves are affected as in Horner’ s syndrome"},{"label":"D","text":"May be present if the IV nerve is affected , when it will be observed on looking down and outwards. 26. Nystagmus:"},{"label":"A","text":"Refers to an inability of the eyes to move together"},{"label":"B","text":"Is always unidirectional"},{"label":"C","text":"May occur physiologically when travelling"},{"label":"D","text":"Is typically present in Parkinson’ s disease 27. Dysdiadokokinesis:"},{"label":"A","text":"Indicates disease of the basal ganglia"},{"label":"B","text":"Is the term used for an action intention tremor"},{"label":"C","text":"Explains clumsiness for rapid movements occurring in patients with cerebellar disease"},{"label":"D","text":"May occur with demyelination in the thalamus 28. Bilateral wasting and weakness of the tongue, with fasciculation:"},{"label":"A","text":"Suggests bilateral XII palsy of a lower motor neuron type"},{"label":"B","text":"Indicates a lesion somewhere above the medulla"},{"label":"C","text":"Is typical of Parkinson’ s disease"},{"label":"D","text":"Indicates the IX, X, XII and XII nerves are abnormal 29. An extensor Babinski reflex( a positive response):"},{"label":"A","text":"Occurs in lower motor neuron diseases"},{"label":"B","text":"May be present in a transverse myelitis"},{"label":"C","text":"Occurs in peripheral neuropathy"},{"label":"D","text":"Is the result of uninhibited pontine nuclei 6 30. Concerning sensory impairment:"},{"label":"A","text":"A glove and stocking anaesthesia suggests peripheral neuropathy"},{"label":"B","text":"Anaesthesia below the umbilicus suggests a T6 lesion"},{"label":"C","text":"Dissociated sensory loss of the hands is typical of a middle cerebral artery stroke"},{"label":"D","text":"Loss of sensation on the little finger and the lateral half of the hand suggests a median nerve lesion 31. Generalised lymphadenopathy may occur in all of the following conditions, except:"},{"label":"A","text":"Infectious mononucleosis"},{"label":"B","text":"Stage 1 Hodgkins disease"},{"label":"C","text":"Leukaemia"},{"label":"D","text":"HIV /AIDS 32. A neutrophil leukocytosis may occur in all of the following, except:"},{"label":"A","text":"TB"},{"label":"B","text":"Empyema"},{"label":"C","text":"Pneumonia"},{"label":"D","text":"Infective endocarditis 33. Uraemia:"},{"label":"A","text":"Causes generalised dysfunction because of loss of salt form the body"},{"label":"B","text":"May cause pallor, an altered colour of the skin and sometimes a white precipitate on the skin, known as uraemic frost"},{"label":"C","text":"Is always associated with oliguria"},{"label":"D","text":"Is present when the serum creatinine is 200micromol/l 34. Generalised oedema may be present in all of the following, except:"},{"label":"A","text":"Cirrhosis with hypoalbuminaemia"},{"label":"B","text":"Congestive cardiac failure"},{"label":"C","text":"Superior mediastinal syndrome from a retrosternal goitre"},{"label":"D","text":"Nephrotic syndrome 35. The modified Shober test:"},{"label":"A","text":"If positive indicates a normal hip"},{"label":"B","text":"Is positive if the two points separate by more than 50% on flexion of the spine"},{"label":"C","text":"Is performed by standing on one leg"},{"label":"D","text":"Is a test for a fixed flexion deformity of the hip 36. In thyrotoxicosis:"},{"label":"A","text":"There is asymmetrical enlargement of the thyroid"},{"label":"B","text":"There is an inability to cough normally because of recurrent laryngeal nerve entrapment"},{"label":"C","text":"There may be a positive lid lag, indicating a defect in the III nerve"},{"label":"D","text":"There may be a fine tremor seen when the arms and hands are extended 7 37. In Cushing’ s disease:"},{"label":"A","text":"There is a moon face with generalised obesity, especially of the legs"},{"label":"B","text":"There is often a buffalo hump with hypertension"},{"label":"C","text":"There is a large jaw and hands"},{"label":"D","text":"The tongue is enlarged and the voice is deep 38. Metabolic abnormalities may be suggested:"},{"label":"A","text":"By tophi in the outer helix of the ear suggesting amyloidosis"},{"label":"B","text":"By xanthelasma under the eyes suggesting hypercholesterolemia"},{"label":"C","text":"By itchy papules in the skin suggesting gout"},{"label":"D","text":"By calcified nodules in the fingers suggesting porphyria 39. Problem analysis is essential for diagnosing difficult cases:"},{"label":"A","text":"As it is inclusive of all problems and is systematic"},{"label":"B","text":"As it allows grouping of problems and reduction of problems to diseases, syndromes and functional states"},{"label":"C","text":"As it allows effective long term management of patients"},{"label":"D","text":"All of the above 40. Differential diagnosis:"},{"label":"A","text":"Is a waste of time"},{"label":"B","text":"Is academic and of no practical use"},{"label":"C","text":"Is a systematic way that aids in the formulation of a diagnosis and a plan for diagnosis"},{"label":"D","text":"Can be remembered for all conditions, and no books are required for recall SECTION II - SHORT ESSAY QUESTION Complete answers on separate paper Allow 5 minutes for each Short Answer Allow 60 minutes for this section 1. Link the following Write the number on the right hand column alongside the alphabetical number on the left"},{"label":"A","text":"koilonychia 2 1 rheumatoid arthritis"},{"label":"B","text":"clubbing 4 2 Fe deficiency"},{"label":"C","text":"Oslers nodes 3 3 infective endocarditis"},{"label":"D","text":"spindle fingers 4 cancer of the lung"},{"label":"E","text":"claw hand 5 cirrhosis"},{"label":"F","text":"leukonychia 5 6 osteoarthritis"},{"label":"G","text":"pitted nails 8 7 ulnar nerve lesion"},{"label":"H","text":"sclerodactyly 10 8 psoriasis i) Heberden’ s nodes 6 9 gout j) tophus 9 10 scleroderma 8 2. The following symptoms and signs are all consistent with congestive cardiac failure, except oedema, raised JVP, tender hepatomegaly, orthopnoea ,pallor, persisting retrosternal chest pain relieved by sitting forward, sacral swelling, basal crepitations on auscultation, bronchial breathing on auscultation, splinter haemorrhages in the nails 3. Clinical examination of a 20 year old women reveals: pulse rate 70/min,irregularly irregular, BP 90/70,JVP not raised, apex beat in the fifth intercostal space in mid clavicular line, left sternal edge has a prominent heave, increased pulsation in the second left intercostal space,diastolic thrill at the apex, loud first heart sound, mid-diastolic murmur,, increased pulmonary component of the second heart sound, normal breath sounds in the bases of the lung Which of the following possible diagnoses is consistent with these findings a) Mixed mitral stenosis and mitral incompetence b) Mitral incompetence with atrial fibrillation and pulmonary hypertension c) Mitral stenosis with atrial fibrillatio n ,cardiomegaly and heart failure d) Mitral stenosis with pulmonary hypertension, right ventricular hypertrophy, and atrial fibrillation e) Aortic incompetence with right heart failure f) Mitral stenosis with right heart failure and ventricular ectopics g) Tricuspid incompetence with atrial fibrillation Select one 4. List the 8 essential factors required from a history to allow a pain analysis, and illustrate these findings by an analysis of angina pectoris 5. Describe and explain the mechanism of bronchial breathing 9 6. A 22 year – old man had a 4 month history of malaise, weight loss, fevers and night sweats. Over the course of the past 4 weeks he had developed increasing breathlessness Physical examination showed a thin young man. Chest movements were diminished on the left, and trachea deviated to the right. The percussion note was dull on the left, where the breath sounds were almost absent, and both the vocal resonance and tactile fremitus were markedly reduced The XRay is shown as attached Answer the following questions"},{"label":"A","text":"What is wrong with the lung?"},{"label":"B","text":"Why is the trachea deviated to the right?"},{"label":"C","text":"Why is the percussion note dull on the left?"},{"label":"D","text":"The fact that the vocal resonance and tactile fremitus are reduced rather than"},{"label":"E","text":"What do you think is the diagnosis? 7. Explain how an examination of faeces allows diagnosis of different diseases. List five different types of excreta 8. Describe the typical clinical finding on abdominal examination on a 40 year old man with a perforated peptic ulcer. Explain why these signs develop 9. Draw a diagram of the visual pathway from the eyeball to the occiput.. Explain the mechanism of homonymous hemianopia and bitemporal hemianopia 10 10. Match the following concerning cranial nerves Write the number on the right hand column alongside the alphabetical number on the left"},{"label":"A","text":"Inability to move the eye laterally 1. III nerve palsy palsy"},{"label":"B","text":"Ptosis, fixed dilated pupil, ophthalmoplegia 2. II mono neuritis"},{"label":"C","text":"Facial palsy but able to move forehead 3. VI nerve"},{"label":"D","text":"Blindness in one eye with loss of 4. UMN VII palsy consensual pupil reflex in opposite eye, but present in the blind eye"},{"label":"E","text":"Wasting and fasciculation of the tongue 5. IX palsy"},{"label":"F","text":"Total facial palsy, including inability to 6. bilateral XII raise forehead"},{"label":"G","text":"Toss of gag reflex 7. XI palsy"},{"label":"H","text":"Inability to shrug 8. LMN VII palsy"}],"priority":0,"status":"review","flags":["too_many_options_possible_merge","duplicate_option_labels","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","duplicate_option_text","long_option_manual_review","nonunique_option_labels","nonunique_option_text","prior_structural_review_flag","too_many_options","too_many_options_possible_merge"],"cleaningOperations":["option_whitespace_normalization","whitespace/page_marker_normalization"]},{"id":"q-a0256ba6bdb7","stem":"List separately the major signs for thyrotoxicosis and hypothyroidism 12 List at least five causes of eosinophilia – (bonus mark for more than five)","type":"Short Answer","subject":"Internal Medicine","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"Thyroid","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Endocrinology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},