vascular Drugs","subtopic":"Antihypertensive","suggestedTopic":null,"options":[{"label":"A","text":"metoprolol"},{"label":"B","text":"pindolol"},{"label":"C","text":"atenolol"},{"label":"D","text":"timolol"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular Drugs","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-81e055bc3834","stem":"Reflex tachycardia is not likely to occur during therapy with","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Cardiovascular Drugs","topicOriginal":"Cardiovascular Drugs","subtopic":"Antihypertensive","suggestedTopic":null,"options":[{"label":"A","text":"clonidine"},{"label":"B","text":"diazoxide"},{"label":"C","text":"reserpine"},{"label":"D","text":"minoxidil"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular Drugs","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f6d230c5a90e","stem":"Beta blockers which may be less likely to produce CNS-related adverse effects include","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Cardiovascular Drugs","topicOriginal":"Cardiovascular Drugs","subtopic":"Antihypertensive","suggestedTopic":null,"options":[{"label":"A","text":"metoprolol"},{"label":"B","text":"nadolol"},{"label":"C","text":"timolol"},{"label":"D","text":"atenolol"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular Drugs","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unveri