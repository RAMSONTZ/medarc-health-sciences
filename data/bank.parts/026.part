ngOperations":[]},{"id":"q-e824c6650e98","stem":"Define who your internal and external customers are","type":"Short Answer","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-338d6fced75c","stem":"Explain procedures clearly","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-bd971a1d742c","stem":"When you are communicating with a customer you need to be careful otherwise you may make the customer angry and that will have a negative impact resulting into loosing customer. Don’t do or say anything that would cause the customer to become angry in the first place. The customer may be angry if","type":"Short Answer","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-879c76e076ae","stem":"We all know customer satisfaction is essential to the survival of our businesses. How do we find out whether our customers are satisfied?","type":"Short Answer","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4474f5f02619","stem":"When you conduct a customer satisfaction survey, what you ask the customers is important. How, when, and how often you ask these questions are also important. However, the most important thing about conducting a customer satisfaction survey is what you do with their answers.","type":"Short Answer","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4aa5e0132204","stem":"When To Conduct A Customer Satisfaction Survey","type":"Short Answer","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d4a7fcf4b1c1","stem":"Identify laboratory customers","type":"Image / Diagram Question","subject":"Obstetrics and Gynecology","topic":"Labor and Delivery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Labor and Delivery","options":[],"priority":0,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Labor and Delivery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-488d1ea3afaa","stem":"Identify three internal and external customers of the laboratory","type":"Image / Diagram Question","subject":"Obstetrics and Gynecology","topic":"Labor and Delivery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Labor and Delivery","options":[],"priority":0,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Labor and Delivery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-6140b606f366","stem":"Describe laboratory customer service expectation","type":"Short Answer","subject":"Obstetrics and Gynecology","topic":"Labor and Delivery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Labor and Delivery","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Labor and Delivery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1be7b79b6aa7","stem":"List the tools that can be used to solicit customer feedback","type":"Short Answer","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-027e21cdd970","stem":"Name | Name of the Procedure | Frequency | Frequency | Frequency | Frequency | Frequency | Frequency","type":"Short Answer","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c7613a8f4885","stem":"Name | Name of the Procedure | Daily | Weekly | Monthly | Quarterly | Biannual | Annual","type":"Short Answer","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9655e3a87dbb","stem":"Doctor Charles comes to the laboratory very upset that the results of the HIV test performed on his patient were incorrect. How will you communicate with him? What steps will you take to resolve the problem?","type":"Clinical Vignette","subject":"Obstetrics and Gynecology","topic":"Labor and Delivery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Labor and Delivery","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Labor and Delivery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-395dcc68f492","stem":"The table below is for OFFICIAL USE ONLY SECTION A: MULTIPLE CHOICE QUESTIONS (20 MARKS) Instructions: This section consists of TWENTY (20) items One (1) mark will be awarded for each correct answer Responses with SMALL letter will NOT be awarded any mark Answer item (i) to (xx) by choosing the letter of the most correct answer and write it in the box provided using CAPITAL letter (i) The internal source of recruitment and selection (iii) is the organizational function that deals with issues related to people such as compensation, hiring, performance management, organization development, safety, wellness, benefits, employee motivation, communication, administration, and training.- (vi) The organization chart (Organogram) shows how the organization has been divided into departments and what responsibility and duties are assigned to each officer. The advantages of Organogram include the following: - (viii)The role of the management is to facilitate the achievement of organization goals in effective and efficient manner by working through people within defined boundaries. In other words, Laboratory managements job helps: - (xvi)When to do training?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Labor and Delivery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Labor and Delivery","options":[{"label":"A","text":"Schools"},{"label":"B","text":"Transfers"},{"label":"C","text":"Friends"},{"label":"D","text":"Family"},{"label":"E","text":"Employment agencies (ii)The assignment of any responsibility or authority to another person to carry specific activities Relegation"},{"label":"B","text":"Assertion"},{"label":"C","text":"Delegation"},{"label":"D","text":"Dissemination"},{"label":"E","text":"Allegation"},{"label":"A","text":"Head of section"},{"label":"B","text":"Leader"},{"label":"C","text":"Establish instrument maintenance program"},{"label":"D","text":"Manager"},{"label":"E","text":"Human resource management (iv) Assessment of non-technical skills include the following EXCEPT: - Communications (written and oral) Customer Service Problem-solving Commitment Color-blindness (v) The following is one among the function of the organization: -"},{"label":"A","text":"Focus the present realistic situation"},{"label":"B","text":"Administers and maintains"},{"label":"C","text":"Focus on day to day operations"},{"label":"D","text":"Offer employment and economic exchange for members"},{"label":"E","text":"All of the above"},{"label":"A","text":"It shows the rivalry among departments in the organization"},{"label":"B","text":"It shows the how the responsibility at different level is unclear"},{"label":"C","text":"The Lines of Communication both upwards and downwards are indicated"},{"label":"D","text":"The coordination among the various departments makes it difficult to incorporate new changes"},{"label":"E","text":"A and C (vii)The Operating organization is the major component that transforms the inputs to the outputs through implementation of the organization strategy. The Key elements of the organization include the following: -"},{"label":"A","text":"Work"},{"label":"B","text":"Skilled people"},{"label":"C","text":"Procedures and Culture"},{"label":"D","text":"Informal rules and policies"},{"label":"E","text":"All of the above"},{"label":"A","text":"To accomplish the goals of the manager"},{"label":"B","text":"Using resources effectively and efficiently for personal benefits"},{"label":"C","text":"Provides society with products and services"},{"label":"D","text":"In a quality organization"},{"label":"E","text":"None of the above (ix)Attributes of effective leadership includes the following: -"},{"label":"A","text":"Autocratic or authoritarian leadership"},{"label":"B","text":"Democratic or participative leadership"},{"label":"C","text":"Integrity leadership"},{"label":"D","text":"Bureaucratic leadership"},{"label":"E","text":"Narcist leadership (x)Leadership and Management are often thoughts of as the same thing, however there are an important distinction between these two. The following are qualities of leader which point the difference from the manager: -"},{"label":"A","text":"Innovates and develop"},{"label":"B","text":"Accomplish the goals, make good decision"},{"label":"C","text":"Focus on the present realistic situation"},{"label":"D","text":"Administers and maintains"},{"label":"E","text":"Provides society with products and services (xi)The following set consists of duties or functions of Human resource manager: -"},{"label":"A","text":"Competency Assessment, Orientation and training, Position/Job description"},{"label":"B","text":"Personal recruitment, position/job description, problem solving"},{"label":"C","text":"Orientation and training, Competency assessment, commitment"},{"label":"D","text":"Staffing and scheduling, continuing education, customer service"},{"label":"E","text":"Customer services, Problem solving, commitment (xii) Assessment of technical skills include the following EXCEPT: - Problem-solving Manipulation skills Customer Service Mathematical pipetting is an example of manipulating skills (xiii) refers to the discovery and development of the sources required personnel so that sufficient number of staffing will always be available: -"},{"label":"A","text":"Promotion"},{"label":"B","text":"Recruitment"},{"label":"C","text":"Internal transfer"},{"label":"D","text":"External transfer"},{"label":"E","text":"Competency assessment (xiv)Examples of technologist’s competencies: -"},{"label":"A","text":"Review policies at least annually"},{"label":"B","text":"Notify clinician of critical results/panic values"},{"label":"C","text":"Write and document SOP"},{"label":"D","text":"Train other staffs about the new equipment installed"},{"label":"E","text":"Perform Laboratory test only (xv) is the someone who leads strongly, but isn't bossy: -"},{"label":"A","text":"Manager"},{"label":"B","text":"Human resource"},{"label":"C","text":"Leader"},{"label":"D","text":"Trainer"},{"label":"E","text":"Mentor"},{"label":"A","text":"When a new trainer is employed"},{"label":"B","text":"During orientation"},{"label":"C","text":"When EQA fails"},{"label":"D","text":"When IQA fails"},{"label":"E","text":"When both IQA and EQA fails simultaneously (xvii)The advantage of continuing education: -"},{"label":"A","text":"Improve competency in certain problem areas"},{"label":"B","text":"Make learning on expectation for few people"},{"label":"C","text":"May lead to withdrawal of Vendor Support"},{"label":"D","text":"May lead to withdrawal of vendor support"},{"label":"E","text":"None of the above (xviii) When establishing a competency program, you have to: -"},{"label":"A","text":"Assign trainer"},{"label":"B","text":"Review job description"},{"label":"C","text":"Determine the number of questions on the assessment program"},{"label":"D","text":"Determine assessment method"},{"label":"E","text":"Explain performance evaluation process (xix)The following set consists of internal source of recruitment and Selection: -"},{"label":"A","text":"Schools, present employers and On Job training"},{"label":"B","text":"Trainee, Family, Schools"},{"label":"C","text":"Promotions, Professional bodies, and other Laboratories"},{"label":"D","text":"Family, Friends and employment agencies"},{"label":"E","text":"Transfer, promotions and present employee (xx) is the person responsible for planning and directing the work of a group of individuals, monitoring their work, and taking corrective action when necessary.: -"},{"label":"A","text":"Quality officer"},{"label":"B","text":"Head of department"},{"label":"C","text":"Leader"},{"label":"D","text":"Leadership"},{"label":"E","text":"Manager SECTION B: MULTIPLE TRUE/FALSE QUESTIONS Instructions: This section consists of Four (4) questions with five (5) options each Write the word “TRUE” for a correct statement and the word “FALSE “for incorrect statement in the space provided after each option All responses should be in CAPITAL letters One Mark (1) will be awarded for each correct response"}],"priority":0,"status":"review","flags":["topic_generic","too_many_options_possible_merge","duplicate_option_labels","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Labor and Delivery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["answer_explanation_mixed_into_stem","duplicate_option_labels","duplicate_option_text","nonunique_option_labels","nonunique_option_text","prior_structural_review_flag","too_many_options","too_many_options_possible_merge","topic_generic"],"cleaningOperations":[]},{"id":"q-3f6e203686b8","stem":"(xvi)When to do training?","type":"Short Answer","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8934431fefe6","stem":"Which principle of management is focused on ensuring that different parts of the organization work together harmoniously? o","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Coordinating o"},{"label":"B","text":"Controlling o"},{"label":"C","text":"Commanding o"},{"label":"D","text":"Organizing o"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f4ac2e4074db","stem":"What is the purpose of an organogram in an organization? o","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"To show the location of departments o"},{"label":"B","text":"To indicate lines of communication o"},{"label":"C","text":"To define the span of control o"},{"label":"D","text":"All of the above o"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draf