nblastine arrest cell division in metaphase. T"},{"label":"E","text":"Bleomycin is associated with the development of pulmonary fibrosis. T"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"e3e2d775211b07b6f22acb25e4b4fad462f14fef"},{"id":"q-84daeea482d6","stem":"The following are extremely emetogenic","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cyclophosphamide. T"},{"label":"B","text":"Methotraxate. F"},{"label":"C","text":"5-FU. F {frucytocine}"},{"label":"D","text":"Mustine. T"},{"label":"E","text":"Ciplastin. T"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"795487ba90147dd7dae77681f8193183b64dcd44"},{"id":"q-0e2c42a9119a","stem":"Sterile haemorrhagic cystitis is associated with","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cyclophosphonamide. T"},{"label":"B","text":"Isosfamide . T"},{"label":"C","text":"Acroleum. T"},{"label":"D","text":"Corticosteroids. F"},{"label":"E","text":"MESNA F"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSo