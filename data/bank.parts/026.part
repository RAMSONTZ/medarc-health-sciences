[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[],"manualEdits":{}},{"id":"q-746efa382c86","stem":"In the Immunodeficiency Syndrome (AIDS) in pregnancy all the following are true EXCEPT","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Only about 40% of the fetuses will contract the disease"},{"label":"B","text":"Breast feeding contributes about 12 – 14% of vertical transmissions"},{"label":"C","text":"Abortion are common"},{"label":"D","text":"If the HIV test is positive in the newborn baby, then this baby is infected by HIV infection"},{"label":"E","text":"Intra-uterine growth retardation and Haematological changes may occur"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3434284865cb","stem":"A pregnant woman presents at a gestational age of 32 weeks with lower abdominal pain without vaginal bleeding or leakage. The Fetus is alive and moving. Which of the following does not help you with the diagnosis?","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Speculum examination"},{"label":"B","text":"Palpation of the uterus for contractions"},{"label":"C","text":"Listening for the foetal heart"},{"label":"D","text":"Taking body temperature and pulse rate"},{"label":"E","text":"Urinalysis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0b42e3281cd1","stem":"Which combination of signs and symptoms is typical of preeclampia?","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"BP > 140/90 mmHg in supine position, proteinuria (++)"},{"label":"B","text":"Excessive weight gain, pedal edema, BP 150/100 mmHg"},{"label":"C","text":"Severe headaches, pedal edema, proteinuria trace BP 140/90 mmHg"},{"label":"D","text":"Body weight of 104 kg, Multipara, BP 140/90 mm Hg no proteinuria"},{"label":"E","text":"Puffy face, pedal edema, BP normal, No proteinuria"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7fc4cf2e0bc4","stem":"What is not a cause of antepartum hemmorhage?","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Placenta previa"},{"label":"B","text":"Abruptio placenta"},{"label":"C","text":"Dysfunctional uterine bleeding"},{"label":"D","text":"Pregnancy with carcinoma of the cervix"},{"label":"E","text":"Show"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a051687dfa13","stem":"What is not a cause of post partum hemorrhage?","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Placenta accreta"},{"label":"B","text":"Placenta increta"},{"label":"C","text":"Abruptio placenta"},{"label":"D","text":"Cervical tear"},{"label":"E","text":"Uterine atony"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3db68e3b859f","stem":"The following statements are true about malaria except","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Infectious Diseases","topicOriginal":"Infectious Diseases","subtopic":"Malaria","suggestedTopic":null,"options":[{"label":"A","text":"Incubation period is 5 days"},{"label":"B","text":"It can cause metabolic acidosis"},{"label":"C","text":"Thin film is used to identify the species of plasmodium"},{"label":"D","text":"The stain used at KCMC clinical laboratory is Giemsa"},{"label":"E","text":"Gamotocytes seen on the blood film represents the sexual stages of plasmodium"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Infectious Diseases","answerAudi