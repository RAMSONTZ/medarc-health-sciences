ft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-01412010a06f","stem":"The placenta: (Select incorrect statement)","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Functions as both respiratory, excretory and barrier for infection"},{"label":"B","text":"Fetal part is rough and spongy and having number of cotyledms"},{"label":"C","text":"Abnormal villi placentaritim are called placenta accreta, percrete and increta"},{"label":"D","text":"Is surrounded by Amnionic and chorionic membranes"},{"label":"E","text":"Supplied by 2 arteries and one vein"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7daaac7b48cf","stem":"All the statements are incorrect for both polyhydramnious and oligohydramnious except","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Oligohydramnious is excessive production of amniotic fluid and not associated with poor placenta function"},{"label":"B","text":"One of the effects of polyhydramnions in pregnancy and labour is cord prolapse"},{"label":"C","text":"Polyhadramnious is associated with renal agenesis"},{"label":"D","text":"The fetal causes of oligohydramnious includes Twin pregnancy, anecephaly and oesophageal atresia"},{"label":"E","text":"Polyhydramnious is not one of the causes of the confusion in discrepancy for the gestational age by dates and fundal height on examination"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4b9e856d3173","stem":"Endocrinological and physiological changes during pregnancy includes all except","type":"Single Best Answer MCQ","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Marked fluid retention both in extracelular and intracellular compartments"},{"label":"B","text":"Reduced plasma aldostenon concentration"},{"label":"C","text":"Difficult in interpretation of haematological indices due to expansion of blood volume and haemodilution"},{"label":"D","text":"Increased renal blood flow and glomerulus filtration rate"},{"label":"E","text":"Changes in acid base balance and therefore Ph of the blood."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-76f000332518","stem":"The following are true about pregnancy except","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Amenorrhea is the earliest symptom"},{"label":"B","text":"The fundus enlargement is approximately at the umbilical level at 22 weeks of gestation"},{"label":"C","text":"Pseudocyesis is a psychological disorder in which a women think and have fixed idea to be pregnant"},{"label":"D","text":"Distended bladder, fibroid are differential diagnosis of pregnancy"},{"label":"E","text":"Uterine soufflé which is associated with increased blood supply to the broad ligament is only seen in pregnancy"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9f8a60d2ca3b","stem":"The available Hormonal impregmented contraceptive dence contain which hormones","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Progesteron"},{"label":"B","text":"Oestrogen"},{"label":"C","text":"Testosterone"},{"label":"D","text":"a and b"},{"label":"E","text":"None of the above"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0dbaebb15a82","stem":"Medroxy progesterone used as a contraceptive for long period may cause","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Endometrial hypoplasia"},{"label":"B","text":"Amenorrhoea"},{"label":"C","text":"Endometrial carcinoma"},{"label":"D","text":"a and b are correct"},{"label":"E","text":"All of the above"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b46eca3788e9","stem":"The following items are true for Twin pregnancy except","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Tendency of multiple pregnancy is inherited and more frequently in a certain families"},{"label":"B","text":"Complications of Twins pregnancy includes preterm labour, preeclampsia and congenital malformations"},{"label":"C","text":"Two varieties of twins are uniovular and binovular"},{"label":"D","text":"Twins pregnancy is associated with exaggerated symptoms of pregnancy"},{"label":"E","text":"There is no association of maternal age neither using ovulatory drugs in the incidence of multiple pregnancies SECTION II - SHORT ESSAY QUESTIONS"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e846f82bf1bd","stem":"Write short notes on the stages of labour (6 marks)","type":"Essay / Structured Essay","subject":"Obstetrics and Gynecology","topic":"Labor and Delivery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Labor and Delivery","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Labor and Delivery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStat