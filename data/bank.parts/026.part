gy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Oligohydramnios"},{"label":"B","text":"Increasing parity"},{"label":"C","text":"External version of the fetus"},{"label":"D","text":"Afibrinogenaemia"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b724dcc01886","stem":"The typical clinical picture in abruptio","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A hard, woody uterus"},{"label":"B","text":"uterine tenderness"},{"label":"C","text":"absent fetal heart sounds"},{"label":"D","text":"bradycardia"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-45dd9354189d","stem":"The main maternal complications in abruption placentae are","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Chorioamnionitis"},{"label":"B","text":"Postpartum haemorrhage"},{"label":"C","text":"Renal failure"},{"label":"D","text":"Disseminated intravascular coagulation"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTo