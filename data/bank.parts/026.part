","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Vaginal examination"},{"label":"B","text":"Ultrasound examination"},{"label":"C","text":"Intravenous access line and X-match 2 units blood"},{"label":"D","text":"A non-stress test"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b74d2c17a767","stem":"The ideal obstetric plan for a patient with type III placenta praevia is to","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Deliver at 40 weeks"},{"label":"B","text":"Induce labour at 38 weeks"},{"label":"C","text":"Perform an elective Caesarean section"},{"label":"D","text":"Allow a vaginal delivery and monitor closely during labour E."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-cee912640e1b","stem":"The lower uterine segment","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Plays an active role in labour"},{"label":"B","text":"Is more vascular than the upper segment"},{"label":"C","text":"Is covered interiorly by loose peritoneum D Is more developed at 38 weeks than at 30 weeks MD 3 exam"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"ke