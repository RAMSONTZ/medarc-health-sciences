":"D","text":"Affects more girls than boys"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"9fb6105525ed061d2e95a54ba8a0b56e8ed9ede5"},{"id":"q-d9d6b9b040f3","stem":"Iron deficiency anaemia","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Red Cell Disorders","topicOriginal":"Red Cell Disorders","subtopic":"Anemia","suggestedTopic":null,"options":[{"label":"A","text":"May be prevented in infancy by early introduction of cows milk"},{"label":"B","text":"Is common finding in infant fed breast milk"},{"label":"C","text":"Predisposes children to recurrent infections"},{"label":"D","text":"Can be caused by infection of bone marrow"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Red Cell Disorders","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"7c3397409b7973f396836d86686d1143a8330b0b"},{"id":"q-965ce76c9454","stem":"A child 16 mo old with weight of 6 kg was found to have high fever, dysentery, abdominal distension. He is unwell and severely dehydrated What will be your plan of management.","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"I/v R/lactate mixed with glucose solutions"},{"label":"B","text":"I/v R/Lactate, ORS per motion through NGT and metronidazole"},{"label":"C","text":"I/v R/lactate modified ORS per motion (30mls), monitor urine output and electrolytes immediately."},{"label":"D","text":"I/v R/lactate, ReSoMal 30mls/motion, slow K and F-75 immediately on admission"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"7151d592b833cedb9bc38bc4588c9524cfe8d6bc"},{"id":"q-352bbc996a33","stem":"About a baby born to a diabetic mother","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"...May develop hypoglycaemia within 24 – 48 hours after delivery"},{"label":"B","text":"...Congenital malformations are not common"},{"label":"C","text":"...Cardiomyopathy may occur"},{"label":"D","text":"....Most Babies are born with low weight"},{"label":"E","text":"...They have increased risk of neural tube defect"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"8fb9f34ce1746e1ec8c0ca1d1deff06bb8bf7926"},{"id":"q-190abcabdbb5","stem":"Concerning problems of prematurity","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"...Respiratory distress is common because of less surfactant"},{"label":"B","text":"...Jaundice rarely occurs in preterm babies"},{"label":"C","text":"...Intraventricular hemorrhage may occur"},{"label":"D","text":"...Hypoglycaemia is not very common"},{"label":"E","text":"...They are not prone to hypothermia. MATCHING QUESTIONS Match the items"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"5953951921ff871e4a416b502875b078f72edfc9"},{"id":"q-3ecc797105fe","stem":"About poisoning (4 marks). COLUMN A COLUMN B POISON ANTIDOTE","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"...Acetaminophen 3 1. Atropine"},{"label":"B","text":"...Organophosphate 1 2. Desferioxamine"},{"label":"C","text":"...Narcotics 4 3. N-acetylcysteine"},{"label":"D","text":"...Carbonmonoxide 5 4. Naloxone"},{"label":"E","text":"...Iron 2 5. Oxygen"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"8aaa780e4f46b7beea4afee202bf955473fa0a6f"},{"id":"q-bb12ab43e412","stem":"Name two late complications ( 1 mark each, max.2)","type":"Short Answer","subject":"Pediatrics and Child He