":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"a0263f22b4a49e72b7e60aa981015c25733186b3"},{"id":"q-3f58bdc2dca5","stem":"The following Cephalosporins are excreted mainly through biliary tract hence no dosage adjustment is required in renal impairment","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Nephrology","topicOriginal":"Nephrology","subtopic":"Renal","suggestedTopic":null,"options":[{"label":"A","text":"Cefoperazone. T"},{"label":"B","text":"Cefoxin. F"},{"label":"C","text":"Cefixime. F"},{"label":"D","text":"Ceftiaxone. T"},{"label":"E","text":"Cefpofoxime proxetil. F"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Nephrology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"a52fb66495ef736d0afcb360e43e2fc5347f078e"},{"id":"q-fff3955e2488","stem":"The following statement about Penicillins are correct","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ampicillin and Amoxycillin are destroyed by beta-lactamase. T"},{"label":"B","text":"Flucloxacillin and Clocaxillin are resistant to beta-lactamase. T"},{"label":"C","text":"Ticarcillin is particulary effective against Pseudomonas aeruginosa. T"},{"label":"D","text":"Penicillinase-resistant penicillins are much less active than Benzyl penicillin against bacteria species which do not produce beta lactamase. T"},{"label":"E","text":"Benzylpenicillin is very potent and is the drug of choice for Lancefield group A Streptococcal infections examples erysiplelas, scarlet fever. T"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"4b3bf20988d462eab463dd79728226a72a463173"},{"id":"q-2ccb9611d85b","stem":"The following statement about Imipenem is most accurate","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The drug has a narrow spectrum of antibacterial action. T ???"},{"label":"B","text":"It is used in fixed combination with sulbutamol. T"},{"label":"C","text":"Imiprenem is highly susceptible to beta-lactamase produced by Enterobacteria species. F"},{"label":"D","text":"In renal dysfunction, dosage reductions are necessary to avoid seizures. T"},{"label":"E","text":"Imiprenem is active against methicilin-resistant Staphyococci. F"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"c5bc5911c5663b5f60da581b7d5429eed1860b39"},{"id":"q-cc0690790874","stem":"The clinical indications of Fluoroquinolones include the following.","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ciprofloxacin or Ofloxacin is occasionally usual for the treatment of tuberculosis and atypical mycobacteria infection. T"},{"label":"B","text":"Levofloxacin and Sparfloxacin are used in increase singly for the treatment of upper and lower respiratory tract infection. T"},{"label":"C","text":"Ciprofloxacin Ofloxacin and Norfloxacin are effective for bacterial diarrhea caused by Shigella, toxigenic E.coli, or Camphylobacter. T"},{"label":"D","text":"Ofloxacin is effective for Chlamydial urethritis or cevitis. T"},{"label":"E","text":"Ciprofloxacin and Ofloxacin are effective for gonococcal infection including disseminated disease. T"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"2994f55bf73da523b0deba3a5d5020ac6a124b1b"},{"id":"q-78df22cd0b87","stem":"The following statement about Flouroquinolones are accurate","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Trovafloxacin has been associated rarely with acute nephrotoxicity which has led to restricted indications for use of this drug. F {non but hepatic}"},{"label":"B","text":"Grepafloxacin with increased activity against gram negative{+ve} organisms was withdrawn by manufactures shortly after approval because of serious bone marrow depression it caused. F {cardiovascular toxicity}"},{"label":"C","text":"Concomitant administration of Theophylline and Quinolone can lead to elevated level of Theophylline with risk of toxic effects especially seizures. T"},{"label":"D","text":"Fluoroquinolones are contraindicated in nursing mothers. T"},{"label":"E","text":"Trovafloxacin and Moxifloxacin are non renally cleared and sose adjustment in renal failure is not necessary. T"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"3ac46983549586bc93ed94b2c445baa1797b26fb"},{"id":"q-7718cac7b978","stem":"Gentamicin an aminoglycoside","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Is effective in pneumococcal pneumonia. F"},{"label":"B","text":"Is poorly absorbed from the gut. T"},{"label":"C","text":"Has a half-life of 12 hours it renal function is normal. F {2-3hrs}"},{"label":"D","text":"Penetrates poorly into CSF. T"},{"label":"E","text":"Causes irreversible eight nerve damage. T"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"ad2bbcfb8ffdc81b8555b3c530a76cb2ca89d406"},{"id":"q-1922670a332c","stem":"Chloramphenical is usually effective in","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Pulmonary tuberculosis. F"},{"label":"B","text":"Epiglottis. T"},{"label":"C","text":"Typhoid. T"},{"label":"D","text":"Bacterial meningitis. T"},{"label":"E","text":"Bacterial conjunctivitis. T"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"77e3ac67659c1c53479c3621f1e2125c915293ce"},{"id":"q-989bbf199f0b","stem":"Tetracyclines are used to treat","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Infections caused by Clostridium difficile. F {metro or vancom..}"},{"label":"B","text":"Lyme disease. T"},{"label":"C","text":"Acne vulgaris. T"},{"label":"D","text":"Systemic lupus erythematosus. F"},{"label":"E","text":"Non specific urethritis. T"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"78d4b202213f3fabb341c0c546ebab04004903d6"},{"id":"q-013b3960a23f","stem":"The following adverse effects are correctly paired with a causative antituberculous drugs","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Peripheral neuropathy..............Isoniazid. T"},{"label":"B","text":"Ototoxicity.................Rifampicin. F { hepatotoxicity}"},{"label":"C","text":"Hyperuricaemia.............Pyrazinamide. T"},{"label":"D","text":"Retrobulbar neuritis............Ethambutolol. T"},{"label":"E","text":"Hepatotoxicity.................Streptomycin. F{GNP and 8th CN}"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"e4ec20f60aaf27645a6f4e8029e03ff439cd40d5"},{"id":"q-e57ee3bf737c","stem":"Quinine sulphate","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Is the drug of choice in Chloroquine resistant Falciparum malaria. T"},{"label":"B","text":"Is available for IV and oral use. T"},{"label":"C","text":"Is effective in eradicating the hepatic parasites in P.vivax malaria. F"},{"label":"D","text":"Is contraindicated in renal failure. F {heart failure}"},{"label":"E","text":"Large therapeutic doses cause tinnitus. T"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"1f419a9edceb8be6b44ce39ef7b38731c20de81c"},{"id":"q-2553b7c12b12","stem":"Zidovudine (AZT)","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Is a non nucleoside reverse trancriptase inhibitor. F"},{"label":"B","text":"Penetrates ell into the CSF. T"},{"label":"C","text":"The plasma concentration is increased by Lamivudine. T"},{"label":"D","text":"Has no effect on bone marrow. F{cause myelo..}"},{"label":"E","text":"Can cause fatal lactic acidosis. T"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"57f660cd89cb988d618f23967d7cb000f8a78b8a"},{"id":"q-b96b7f6c7264","stem":"Protease inhibitors example Ritonavir","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Produce altered body fat distribution. T"},{"label":"B","text":"May cause hyperglycaemia. T"},{"label":"C","text":"Ihibits cytocrome P450. T"},{"label":"D","text":"Will prevent generation of new waves of viral infection. T"},{"label":"E","text":"Prevents the cleavage of polyproteins into structural and functional protein in viruses. T"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"954b1b0fb875b7ef96ae64f76cb7752d2930707e"},{"id":"q-24f43422f15a","stem":"Metronidazole, a nitroimidazole","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"optio