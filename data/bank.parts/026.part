blood group O are at greater risk of duodenal, but not gastric ulcers"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"6bf59dd369bced723f8e7d95ea92533316a7bad6"},{"id":"q-3c607d958d4e","stem":"Which of the following is NOT a risk factor for diverticulosis?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Male gender"},{"label":"B","text":"Increasing age"},{"label":"C","text":"Developed world"},{"label":"D","text":"Low fibre diet"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-eb1b903619ff","stem":"Within the large bowel, diverticula are most commonly found?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"In the sigmoid colon"},{"label":"B","text":"In the transverse colon"},{"label":"C","text":"In the ascending colon"},{"label":"D","text":"In the descending colon"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"independe