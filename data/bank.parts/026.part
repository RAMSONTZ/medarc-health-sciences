generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-da673ed13622","stem":"Name 3 signs of Meningitis in older children from appr. 12-18 months and above (3 marks)","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-dfafdcea685d","stem":"Which of the following findings belongs to which problem?","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Legs in extension, arms flexed but stiff"},{"label":"B","text":"Legs and arms in extension and spastic"},{"label":"C","text":"Uncontrolled involuntary movements"},{"label":"D","text":"Sustained ankle clonus and tiptoeing ( when walking)"},{"label":"E","text":"Broadbased gait"},{"label":"F","text":"Inability to move the affected eye to a lateral(outward) position"},{"label":"G","text":"Unilateral ptosis, dilated pupil, eye deviated downward and outward"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"4d38b7ef8c40575ac78cf10830b939a2cb8569a2"},{"id":"q-46d7a76ee482","stem":"which you would order: (4 marks)","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5a2b648c3586","stem":"Regarding incidence risk which is false?","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Measures and Study Designs","suggestedTopic":null,"options":[{"label":"A","text":"Is a measure of risk of developing disease over specified period"},{"label":"B","text":"Is estimated from dynamic cohort or open cohort"},{"label":"C","text":"Measure probability of an event happening over specified time"},{"label":"D","text":"Also known as cumulative incidence"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"ebe24dd51b6bea519c12a6b56fe0afe86ec7a664"},{"id":"q-bc4d2e90d320","stem":"Among a thousand women with cervical cancer, medical records confirm a past history of herpes simplex type 2 infection in four hundred. What is the odds of developing cervical cancer in women with a history of HSV-2 type infection?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"400/1000"},{"label":"B","text":"1000/400"},{"label":"C","text":"400/600"},{"label":"D","text":"600/400"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"b35fa9e12cdc18443a6d067df64846799972ef9d"},{"id":"q-c3404453b2e7","stem":"A case-control study is undertaken to investigate the association between oral contraceptive use and risk of breast cancer. What is an appropriate source of controls","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Women with breast cancer who do not use oral contraceptives"},{"label":"B","text":"Women who have never used oral contraceptives"},{"label":"C","text":"Women who are pregnant"},{"label":"D","text":"None of the above"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-1abfd727b22d","stem":"A case-control study measures","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Incidence of disease"},{"label":"B","text":"Prevalence of disease"},{"label":"C","text":"Odds of exposure"},{"label":"D","text":"Odds of disease"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-afb66b29da3b","stem":"The healthy worker effect is a form of","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Information bias"},{"label":"B","text":"Confounding"},{"label":"C","text":"Selection bias"},{"label":"D","text":"Non-differential misclassification"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-4d19879b852c","stem":"A study reports that non-regular exercisers have a relative risk of 2.2 compared to regular exercisers in developing strokes. The correct interpretation of this relative risk is","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Regular exercisers are 2 times more likely to develop a stroke vs. non-regular exercisers."},{"label":"B","text":"Regular exercisers have 80% of the risk of developing a stroke vs. non-regular exercisers."},{"label":"C","text":"Non-regular exercisers are 2 times more likely to develop a stroke vs. regular exercisers."},{"label":"D","text":"Non-regular exercisers are 20% more likely to develop a stroke vs. regular exercisers."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d5379c6feb49","stem":"Proper hand washing by the staff is a way to reduce hospital acquired (nosocomial) infections. KCMC Hospital decided to implement a hand washing training program, but it was only possible to conduct the program on two of its four medical floors. The staff on two floors volunteered to participate in the training. Several months after the completion of the program on the two floors, the KCMC staff decided to conduct a study and prospectively collect nosocomial infection data of all four floors. The nosocomial infections on the two floors that underwent the program were 7/10,000 patient days while there were 12/10,000 patient days on the floors without the training. The measure of effect which can be calculated is","type":"Calculation","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Odds ratio"},{"label":"B","text":"Relative risk"},{"label":"C","text":"Risk difference"},{"label":"D","text":"Correlation coefficient"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-a709e282cbcd","stem":"A confounding factor in a study can be controlled for by","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"stratifying the disease-exposure association for each level of a confounder and calculating a pooled effect estimate"},{"label":"B","text":"restricting participants to those without the outcome of interest"},{"label":"C","text":"blinding interviewers to the study hypothesis"},{"label":"D","text":"either a) or b)"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-010a244e1fe6","stem":"Which of the following are examples of secondary prevention for diabetes","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"Diabet","suggestedTopic":null,"options":[{"label":"A","text":"Awareness campaign of link between obesity and diabetes"},{"label":"B","text":"Treatment of eye disease among people with diabetes"},{"label":"C","text":"Population based screening for detection of diabetes"},{"label":"D","text":"Counseling on importance of control of hypertension"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Endocrinology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b4a2199b9ee3","stem":"It is well known that smoking causes lung cancer. If we were to undertake a case-control study now to assess the relationship between smoking and lung cancer, which of the following may be particularly difficult to avoid given that this link is well established?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Recall bias"},{"label":"B","text":"Interviewer or observer bias"},{"label":"C","text":"Confounding"},{"label":"D","text":"a and b."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"1f64f2a9f6fb996da3f3d96f142452ac9f267919"},{"id":"q-ff6d54f58881","stem":"A cohort study was conducted to assess the association between exposure to a certain risk factor and two diseases: A and B. The investigators found a rate difference of 5 per 1000 person-years for disease A and 30 per 1000 person-years for disease B comparing “exposed” people to those who are “unexposed”. Which of the following are true?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"for both diseases, the rate in the exposed is greater than the rate in the unexposed"},{"label":"B","text":"the Relative Risk for disease A must be greater than the Relative Risk for disease B"},{"label":"C","text":"the Relative Risk for disease B must be greater than the Relative Risk for disease A"},{"label":"D","text":"among exposed individuals, more cases of disease A are attributable to the exposure than cases of disease B"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"35b62a5f1792885c517440829cf35f4f54848de7"},{"id":"q-f6732d095b61","stem":"In a study of obesity and coronary heart disease (CHD) morbidity, the Population Attributable Fraction (PAF) is a measure of","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the proportion of the population who develop CHD"},{"label":"B","text":"the proportion of CHD among obese members of the population attributable to obesity"},{"label":"C","text":"the proportion of CHD in the population that could be avoided if obesity was eliminated"},{"label":"D","text":"the risk of CHD in the whole population minus the risk of CHD among members of the population who are not obese"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8e808e108dbc","stem":"In intervention studies the main aim of randomization is to","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"help ensure that people take the tablets they are assigned to"},{"label":"B","text":"minimize confounding and selection bias"},{"label":"C","text":"help ensure that the sample is representative of the general population"},{"label":"D","text":"conceal the allocation from the investigator"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-0229b2d97217","stem":"Suppose you are doing a case-control study of the effect of folic acid intake on neural tube defects, and you are concerned about recall bias affecting your estimate of association. Which of the following potential control groups would reduce the likelihood of recall bias?","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Women with normal birth"},{"label":"B","text":"Women who gave birth prematurely"},{"label":"C","text":"Women with newborns who have other types of birth defects without a known association with folic acid"},{"label":"D","text":"None of the above"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"c40855673008e1b14667fd9fea894a53f7cdab9d"},{"id":"q-910eba0252a9","stem":"A double-blind Randomised Controlled Trial was carried out among pregnant women to assess the effect of a new anti-malarial drug on the risk of malaria. In this trial, blinding is done to","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"avoid measurement bias in the assessment of malaria"},{"label":"B","text":"avoid bias in the behaviour of the participants"},{"label":"C","text":"avoid selection bias"},{"label":"D","text":"all of the above"},{"label":"E","text":"a and b In the Tanzanian study of morbidity and mortality due to myocardial infarction, a comparison was made between married and single men. Use the following results were obtained to answer question 17 - 20 Myocardial infarction in men 40-64 years (age standardized rates) Incidence/ 100,000 person-years Mortality/ 100,000 person-years Married 1,371 498 Single 1,228 683"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-caea7857ace3","stem":"The relative risk for myocardial infarction for married men compared to single men was","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"1.12"},{"label":"B","text":"0.89"},{"label":"C","text":"0.73"},{"label":"D","text":"0.36"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-54573ac7eb9a","stem":"The relative risk of death due to myocardial infarction for married men compared to single in this study is","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"1.12"},{"label":"B","text":"0.89"},{"label":"C","text":"0.73"},{"label":"D","text":"0.36"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-032e846f1d17","stem":"The results of the study shows that","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Married men are 89% less likely to get myocardial infarction compared to single men"},{"label":"B","text":"Married men were at 27% less likely to get myocardial infarction compared to single men"},{"label":"C","text":"Married men were 36% less likely to get myocardial infarction compared to single men"},{"label":"D","text":"Married men were 12% more likely to get myocardial infarction compared to single men"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"5f2cf4b30a8f9434caa6b2268c9fb2ace6bc2728"},{"id":"q-755cd6bfdf6f","stem":"The results of the study shows that","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Married men had 89% less risk of mortality due to myocardial infarction compared to single men"},{"label":"B","text":"Married men had 27% less risk of mortality due to myocardial infarction compared to single men"},{"label":"C","text":"Married men had 36% less risk of mortality due to myocardial infarction compared to single men"},{"label":"D","text":"Married men had 12% more risk of mortality due to myocardial infarction compared to single men"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"5f2cf4b30a8f9434caa6b2268c9fb2ace6bc2728"},{"id":"q-b24e958b6a77","stem":"The following method can be used to show the relationship between two variables","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Histogram"},{"label":"B","text":"Pie chart"},{"label":"C","text":"Scatter diagram"},{"label":"D","text":"Bar chart"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"12dbcb39ff11973300013776300cf3abd47d2e9f"},{"id":"q-9a1e584db5f9","stem":"A survey was conducted among 15-45 year-olds in a population to investigate whether gender is associated with tobacco use. The prevalence of cigarette smoking was 28% for males aged 15-45 years and 4% for females aged 15-45 years. In this study","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"cigarette smoking is the outcome and gender is the exposure"},{"label":"B","text":"there is no outcome: gender and smoking are both exposures"},{"label":"C","text":"cigarette smoking is the outcome and age 15-45 years is the exposure"},{"label":"D","text":"the results suggest the effect of age on smoking is modified by gender"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8ec65e243f72","stem":"All of the following are examples of information bias except","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Recall bias"},{"label":"B","text":"Non response bias"},{"label":"C","text":"Interviewer bias"},{"label":"D","text":"Responder bias"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-221d6863da74","stem":"Measurement bias can be dealt with by.","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"performing a stratified analysis"},{"label":"B","text":"randomization"},{"label":"C","text":"increasing the sample size"},{"label":"D","text":"none of the above"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-c455bb11bff9","stem":"About cross sectional study design","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Studies are carried out at one time point or over a short period"},{"label":"B","text":"Commonly for the purposes of public health planning."},{"label":"C","text":"Data can also be collected on individual characteristics, including exposure to risk factors, alongside information about the outcome."},{"label":"D","text":"All above"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"354517759930f38d4a727432b09e9febf858b2b9"},{"id":"q-9ab4ea3c79b2","stem":"The most important difference between a cohort study and a case control study is","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":". A cohort study is prospective and a case control study is retrospective."},{"label":"B","text":". A case control study can assess multiple outcomes while a cohort study can assess multiple exposures."},{"label":"C","text":". At the beginning of the study, a cohort study classifies subjects by exposure status while a case control study classifies subjects by outcome status."},{"label":"D","text":". A prospective cohort study is more prone to selection bias than a case control study."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"5e5cbcd7ec3e66347aa3135a28d04833ab3194ac"},{"id":"q-bddac434dbb6","stem":"In a clinical trial when neither the participant nor the examiner is aware of whether the participant was receiving placebo or active drug. This is done to","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Reduce information bias"},{"label":"B","text":"Reduce selection bias"},{"label":"C","text":"Reduce observer bias"},{"label":"D","text":"a and c"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-91128a8a73b8","stem":"A case-control study looked at the association between mobile phone use and brain tumours. If participants were aware of the hypothesized association under study, those with brain tumours might have been more likely than those without them to recall and report higher levels of mobile phone use. This would tend to","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Lead to overestimate of the association between mobile phone use and brain tumours"},{"label":"B","text":"Bias the effect estimate towards the null"},{"label":"C","text":"Lead to underestimate of exposure levels in those without the disease"},{"label":"D","text":"Lead to selection bias"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7c6d6b49b49a","stem":"In a study measuring depression immediately following a spontaneous abortion, 1500 women volunteered to be interviewed in their home shortly after the occurrence of this experience. This might lead to","type":"Single Best Answer MCQ","subject":"Psychiatry","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Selection bias"},{"label":"B","text":"Information bias"},{"label":"C","text":"Confounding"},{"label":"D","text":"a and c"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Psychiatry","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-48f36469c76a","stem":"In Ecological studies","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"associations seen at group level are assumed to apply to individuals within those groups"},{"label":"B","text":"exposure and outcome are both measured at population or group level rather than at the individual level"},{"label":"C","text":"rare diseases cannot be investigated"},{"label":"D","text":"a and b"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-62438a011d04","stem":"In the same study above (Q 30), the dependent variable is","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Obesity"},{"label":"B","text":"None-obese"},{"label":"C","text":"Heart disease"},{"label":"D","text":"No heart disease"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-e8bec11d32ba","stem":"In the same study as in Q 30 above, 1000 people were recruited. During 5 years of follow-up, 100 were lost to follow-up and 90 developed heart disease. Which of the following statements is correct","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The risk of heart disease was 0.09 or 9%"},{"label":"B","text":"The risk of heart disease was 0.10 or 10%"},{"label":"C","text":"The risk cannot be estimated because of loss to follow-up"},{"label":"D","text":"The rate of heart disease was 2 per 100 person-years"},{"label":"E","text":"None of the above"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-165ecd48129b","stem":"After follow up of ten years in Q 33, the researchers reported the risk of an outcome was 1.83, 95% confidence interval of the risk ratio of rates of heart disease among obese was 1.64-2.85. The results means that","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"People who are obese have an increased risk of heart disease compared to non-obese"},{"label":"B","text":"There is statistical significant association between overweight and risk of heart disease"},{"label":"C","text":"People who are obese have 83% more risk of developing heart disease compared to non-obese people"},{"label":"D","text":"All of the above"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d3b6a9a8aaed","stem":"Which of the following are implemented in studies to reduce the effect of confounding?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Randomization in randomized controlled trials"},{"label":"B","text":"Matching in case-control studies"},{"label":"C","text":"Minimizing loss to follow up in cohort studies"},{"label":"D","text":"a and b"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-81dd3f029c0e","stem":"All of the following study designs are useful for hypothesis testing except","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Biostatistics","topicOriginal":"Biostatistics","subtopic":"Statistical Inference","suggestedTopic":null,"options":[{"label":"A","text":"Randomized controlled field trials"},{"label":"B","text":"Retrospective cohort studies"},{"label":"C","text":"Longitudinal ecologic studies"},{"label":"D","text":"Case-control studies"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Biostatistics","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-1c6a3181399c","stem":"In order for alcohol consumption to be a confounder factor of the association between first trimester smoking and risk of low birth weight, which one must be true","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Alcohol must be associated with first trimester smoking, and be independently associated with risk of low birth weight, and not be a link in the causal chain"},{"label":"B","text":"Alcohol must not be associated with first smoking, but be independently associated with risk of low birth weight, and not be a link in the causal chain"},{"label":"C","text":"Alcohol must be associated with first trimester smoking, but not be associated with the risk of low birth weight"},{"label":"D","text":"Alcohol must not be associated with first trimester smoking, and not be associated with risk of low birth weight"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-3ebd3a20b891","stem":"In an early study, investigators observed that postal clerks (i.e. postal employees who work at their desk) had higher risk of coronary heart disease than postal carriers who delivered mail on foot (RR= 2; p = 0.001). They concluded that physical activity was inversely related to risk of developing coronary heart disease. Skeptics disagreed, pointing out that the postal clerks were older than postal carriers, and that age is a risk factor for CHD. This argument is an example of the possible role of","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Chance"},{"label":"B","text":"Selection bias"},{"label":"C","text":"Recall bias"},{"label":"D","text":"Confounding"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d7e21ba28ac2","stem":"Suppose that estrogen-only postmenopausal hormone (PMH) therapy increases the risk for endometrial cancer. Also, suppose that women who are exposed to estrogen-only PMH and develop endometrial cancer die earlier than endometrial cancer patients who have not taken estrogen only-PMH. What would be the effect of only using prevalent cases of endometrial cancer that were alive in a case-control study of estrogen-only PMH and endometrial cancer?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The true odds ratio would be overestimated"},{"label":"B","text":"The true odds ratio would be underestimated"},{"label":"C","text":"The true odds ratio would be correctly estimated"},{"label":"D","text":"No correct answer"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["answer_text_in_option","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"806944f50ca5e709c1f8c480a911da77e51171d8"},{"id":"q-c0936dacee02","stem":"With regard to the association between exposure and outcome.","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Odds ratio of 1.0 means there is no association"},{"label":"B","text":"Odds ratio of 2.0 means there is half the effect"},{"label":"C","text":"Odds ratio 0.5 means there is increased risk by 50%"},{"label":"D","text":"Odds ratio of less than one means nothing"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"205f0c789451987e5366372d85b984e47bb2e5f1"},{"id":"q-0e28270fa7d7","stem":"A study was undertaken to evaluate any increased risk of breast cancer among women who use birth control pills. The relative risk was calculated. A type I error in this study consists of concluding: (Type 1 error: wrongly concluding that there is an association, while in reality it is not so)","type":"Calculation","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A significant increase in the relative risk when the relative risk is actually 1"},{"label":"B","text":"A significant increase in the relative risk when the relative risk is actually > 1"},{"label":"C","text":"No significant increase in the relative risk when the relative risk is actually 1"},{"label":"D","text":"No significant increase in the relative risk when the relative risk is actually > 1"}],"priority":0,"status":"review","flags":["subject_unclassified","topic_generic","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_text","prior_structural_review_flag","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-009cd025b039","stem":"A vaccine trial was performed with 1,000 randomly selected children two years of age. All these children were given a vaccine against a certain disease and their health monitored for 10 years. Of these, 80% were never afflicted with the disease. Which of the following is the best conclusion regarding the efficacy of the vaccine?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The vaccine is an excellent one because of the high immunization rate"},{"label":"B","text":"No conclusion is possible since no follow-up was made of non-vaccinated children"},{"label":"C","text":"The vaccine is not very effective because it should have produced a higher immunization rate"},{"label":"D","text":"No conclusion is possible since no test of statistical significance was performed"},{"label":"E","text":"The significance level is 100%-80%= 20%, the rate of acquiring illness Q 42 – 44: In a case-control study of birth weight and subsequent breast cancer, the OR for breast cancer associated with a low birth weight compared to a high birth weight was 1.5."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"42f3130a7ca3c524669d30f79e81c8520f518ece"},{"id":"q-d796c7917f2a","stem":"If the study participants were unable to remember their birth weight accurately, but this did not vary by breast cancer status, what is the biggest concern you will have?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"chance"},{"label":"B","text":"confounding"},{"label":"C","text":"recall bias"},{"label":"D","text":"non-differential misclassification"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"74f3a4142e1616a89ffb4d31c9aaf02bfc266f75"},{"id":"q-cfcb22b07888","stem":"Given the scenario above in Q42,in what direction would you expect the observed OR to be biased?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"towards the null value"},{"label":"B","text":"away from the null value"},{"label":"C","text":"none of the answers are correct"},{"label":"D","text":"both a and b are correct"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"7a2a06bb82c3c916797d893d2b47f3c0f99696f2"},{"id":"q-8e81839a984e","stem":"If the cases of breast cancer were more likely to over-report their birth weight compared to the controls, what is the biggest concern you will have?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"chance"},{"label":"B","text":"confounding"},{"label":"C","text":"recall bias"},{"label":"D","text":"non-differential misclassification"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"d1dea275395e520997da6e83e31e4baf745d1447"},{"id":"q-2fcd93bc4fe9","stem":"The problem of confounding can be solved by","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Choosing a prospective design"},{"label":"B","text":"Increasing the precision of the measurements"},{"label":"C","text":"Stratification during data analysis"},{"label":"D","text":"This cannot be solved"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-8557204351f9","stem":"Suppose an investigator performs a case-control study to investigate the association between coffee consumption and pancreatic cancer. Also, suppose that the odds ratio from this case-control study equals 1.0. Which of the following explanations could not be an explanation for finding no association in the study?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"coffee consumption does not increase the risk of developing pancreatic cancer"},{"label":"B","text":"coffee consumption does increase the risk of developing pancreatic cancer but the cases correctly reported their true amount of coffee consumption status but the controls under-reported their true prior amount of coffee consumption"},{"label":"C","text":"coffee consumption does increase the risk of developing pancreatic cancer but the cases under-reported their true prior amount of coffee consumption status but the controls correctly reported their true prior amount of coffee consumption"},{"label":"D","text":"many of the subjects labeled as cases did not really have pancreatic cancer, and many of the subjects labeled as controls did have pancreatic cancer"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"c24b4dac0d28458fcbe3634c549113d494a391fb"},{"id":"q-213fd8bfb543","stem":"At initial examination conducted in Tanga Region on December 23rd, esophageal reflux (heartburn) was found in 15 of 1,000 men aged 30-35 years and in 45 of 1,000 women aged 30-35 years. The statement that women have three times the risk of developing esophageal reflux than do men in this age group is","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"correct"},{"label":"B","text":"incorrect, because a ratio has been used to compare male and female rates"},{"label":"C","text":"incorrect, because of failure to control for potential confounding effect of age"},{"label":"D","text":"incorrect, because no data for a comparison or control group are given"},{"label":"E","text":"incorrect, because of failure to distinguish between incidence and prevalence"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-afca27b239f3","stem":"At physician observed that 500 patients in his practice with breast cancer, 300 of them had previously undergone breast implant surgery. He therefore concluded that breast implants were associated with an increased risk of developing breast cancer. On the basis of these data","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Breast and Endocrine Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Breast and Endocrine Surgery","options":[{"label":"A","text":"the conclusion is correct"},{"label":"B","text":"the conclusion is incorrect, because he did not adjust for differences in age"},{"label":"C","text":"the conclusion is incorrect, because of loss-to-follow up among other breast cancer patients"},{"label":"D","text":"the conclusion is incorrect, because of lack of a control group"},{"label":"E","text":"incorrect, because of failure to distinguish between incidence and prevalence"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Breast and Endocrine Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d7b9b42ca074","stem":"8, and the age-adjusted RR was 0.7. After additionally controlling for smoking, the age adjusted RR became 0.5. This is an example of","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"confounding by smoking"},{"label":"B","text":"effect modification by smoking"},{"label":"C","text":"confounding by alcohol consumption"},{"label":"D","text":"effect modification by age"},{"label":"E","text":"selection bias"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-7b7c0649368e","stem":"In the same study of alcohol consumption and heart attack, the crude RR was 0.8. The age-adjusted RR of heart attack comparing moderate alcohol consumption to no consumption was 0.5 among smokers, and age-adjusted RR of heart attack comparing moderate alcohol consumption to no consumption was 1.0 among smokers. This is an example of","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"confounding by smoking"},{"label":"B","text":"effect modification by smoking"},{"label":"C","text":"chance"},{"label":"D","text":"effect modification by age"},{"label":"E","text":"confounding by age Use the information to answer Q 51 – 53: A study was conducted of the association between alcohol consumption and motor vehicle accidents. For each of the following possible scenarios, select which of the following are present based on the data provided"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7121899fad91","stem":"The crude RR of alcohol consumption and motor vehicle accidents was 2.2. The RR for men was 3.0 and the RR for women was 1.1. This is an example of","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"confounding by age"},{"label":"B","text":"confounding by gender"},{"label":"C","text":"effect modification by age"},{"label":"D","text":"effect modification by gender"},{"label":"E","text":"none of the above"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-f149111ddacf","stem":"The crude RR of alcohol consumption and motor vehicle accidents was 2.2. The RR for men was 3.0 and the RR for women was 3.0. This is an example of","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"confounding by age"},{"label":"B","text":"confounding by gender"},{"label":"C","text":"effect modification by age"},{"label":"D","text":"effect modification by gender"},{"label":"E","text":"none of the above"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-1eb3dedec439","stem":"The crude RR of alcohol consumption and motor vehicle accidents was 2.2. The RR for men was 2.2 and the RR for women was 2.2. This is an example of","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"confounding by age"},{"label":"B","text":"confounding by gender"},{"label":"C","text":"effect modification by age"},{"label":"D","text":"effect modification by gender"},{"label":"E","text":"none of the above Use the information to answer question 54 – 56: A population of 100 healthy men in Moshi was followed for 10 years to assess the development of prostate cancer. Fifteen men were lost after one year and 30 men developed prostate cancer after 5 years of follow up, the remaining men never developed the disease for the whole duration of the study."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-e7fd896b4746","stem":"The measure of effect which can be calculated in this study was","type":"Calculation","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Odds ratio"},{"label":"B","text":"Relative risk"},{"label":"C","text":"Incidence rate ratio"},{"label":"D","text":"Unable to calculate"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-8d6b6cf45a99","stem":"In a study of a disease in which all cases that developed were ascertained, if the relative risk for the association between a factor and the disease is equal to or less than 1.0 then","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"There is no association between the factor and the disease"},{"label":"B","text":"The factor protects against development of disease"},{"label":"C","text":"The comparison group used was unsuitable and a valid comparison is not possible"},{"label":"D","text":"There is either no association or a negative association between the factor and the disease"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-75f6e06c010f","stem":"The authors reported the proportion of children with major infectious morbidity among those with bacteremia was 13% in the placebo group and 10% in the antibiotic group. The 95% confidence interval for the difference in proportions was -2.6% to +8.9%. Thus, the most important conclusion is that","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"there is a statistically significant difference in major infectious morbidity when placebo is compared with antibiotic"},{"label":"B","text":"the proportion of children with major infectious morbidity is the same with placebo and antibiotic"},{"label":"C","text":"there is no statistically significant difference in the proportions who received placebo and antibiotic"},{"label":"D","text":"the study has low power to detect a difference owing to the small sample size, and no conclusions should be drawn until a larger study is done"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a462aba0d946","stem":"What is the claim of the null hypothesis (Ho) in this study in Q 62?","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Biostatistics","topicOriginal":"Biostatistics","subtopic":"Statistical Inference","suggestedTopic":null,"options":[{"label":"A","text":"The null hypothesis claims that there is a difference between the mortality rates of smokers and non-smokers"},{"label":"B","text":"The null hypothesis claims that there is no difference between the mortality rates of smokers and non-smokers"},{"label":"C","text":"The null hypothesis claims that there is a difference between the mortality rates of smokers and non-smokers 5% of time"},{"label":"D","text":"The null hypothesis claims that there is no difference between the mortality rates of smokers and non-smokers 95% of the time"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Biostatistics","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"65b8753618324cfe24697f235793eeb7f4b1e3f6"},{"id":"q-72722e62d8de","stem":"Select the correct statement","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The attributable risk is the excess risk of disease in the exposed compared to the non-exposed during a defined period of time"},{"label":"B","text":"The attributable risk is a ratio of the disease risk in the exposed compared to the non-exposed during a defined period of time"},{"label":"C","text":"The attributable risk is a ratio of the disease risk in the non-exposed compared to the exposed during a defined period of time"},{"label":"D","text":"The attributable risk is the prevalence of disease in the exposed minus the prevalence of disease in the non-exposed"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"8c322ed680a0cae1eddd73b928d018339f3a84bb"},{"id":"q-4cd8bbbab495","stem":"Measures of an association/effect include the following","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Relative risk, risk, odds ratio and risk ratio"},{"label":"B","text":"Odds ratio, risk ratio, attributable risk"},{"label":"C","text":"Risk difference, relative risk, rate ratio and risk"},{"label":"D","text":"Risk ratio, odds ratio, odds and correlation coefficient"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-6a36a76a8245","stem":"Cancer Y has an incidence rate of 10 per 1,000,000 population per year. The researchers wants to determine the association between smoking of khat and cancer Y. Which is the best study design the researchers can use?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cross sectional study"},{"label":"B","text":"Randomized clinical trial"},{"label":"C","text":"Case control study"},{"label":"D","text":"Cohort study SECTION TWO (30 POINTS) In the following questions put true or false for each choices given 71 – 74: Compared to non-drinkers, the relative risk of heart attack for men who were moderate drinkers was 0.50, with 95% confidence interval limits from 0.30 – 1.6. The correct interpretation of this result is:"},{"label":"A","text":"The null hypothesis is rejected at the 0.05 level..................F"},{"label":"B","text":"The finding is not statistically significant at 0.05 level...........T"},{"label":"C","text":"The results may be due to chance...................................T"},{"label":"D","text":"Chance is unlikely explanation of the difference.................F"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","too_many_options","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"b89774b3d852a876dff46d8101524c62e5c25f77"},{"id":"q-d245aedf1771","stem":"78: In comparing the difference between two groups, the p-value is found to be 0.03. The correct interpretation of this result is","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Biostatistics","topicOriginal":"Biostatistics","subtopic":"Statistical Inference","suggestedTopic":null,"options":[{"label":"A","text":"The null hypothesis is rejected at the 0.05 level..................T"},{"label":"B","text":"The difference is statistically significant at 0.05 level............T"},{"label":"C","text":"The difference is compatible with the null hypothesis...........F"},{"label":"D","text":"Chance is unlikely explanation of the difference..................T 79 – 82: In a clinical trial, 9 of 50 patients (18%) taking penicillin three times per day for streptococcus pharyngitis had bacteriological treatment failures. In the group taking penicillin two times per day, 14 of 49 (28.5%) had treatment failure. A two sided t-test comparing the two groups treatment failures had a p-value of 0.21. The best conclusion is:"},{"label":"A","text":"Twice a day therapy is better than three times a day since they are equally efficacious and twice a day therapy is cheaper and has better compliance.........F"},{"label":"B","text":"Three times a day therapy is better than twice a day but the power of the study was too small to demonstrate this results conclusively...................................F"},{"label":"C","text":"Since the p-value was greater than 0.05, the null hypothesis of no difference between treatments cannot be rejected. It should be investigated as to whether these findings are the results of a type II error and insufficient power to detect a true difference ......................................................................................T"},{"label":"D","text":"Since the p-value of the study was greater than 0.05, the evidence indicates that doctors should be advising patients to take penicillin three times a day.....................................................................................................F 83 – 86: The risk of childhood diabetes was found to be 1.6 times higher among those whose birth weight was above the 70th percentile compared to those at or below the 70th percentile; the p-value was 0.24. Which of the following 95% confidence interval is/are consistent with these results?:"},{"label":"A","text":"0.01 to 0.03..................F"},{"label":"B","text":"0.75 to 2.0 ...................T"},{"label":"C","text":"1.1 to 2.5 ....................F"},{"label":"D","text":"6.27 to 7.81 .................F"}],"priority":0,"status":"review","flags":["too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Biostatistics","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","long_option_manual_review","nonunique_option_labels","prior_structural_review_flag","too_many_options","too_many_options_possible_merge"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-826477f95ffb","stem":"interval is/are consistent with these results?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-af52ecb83b7a","stem":"What was the title of the paper?","type":"Short Answer","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-c12893b10fd0","stem":"What are the main/key sections of the research paper?","type":"Short Answer","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-dd08aadabccf","stem":"What was the aim (s) of the study in the paper provided?","type":"Short Answer","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-305fe28a