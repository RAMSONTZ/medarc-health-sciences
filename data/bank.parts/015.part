8 months and is designed to meet the needs of qualified health care professionals and others engaged in HIV & AIDS care and management. The development of this programme is a response to the HIV & AIDS pandemic in Tanzania aimed at providing a comprehensive response through home and community based care to people living with HIV & AIDS. The Diploma programme is designed for qualified health care professionals and other cadres working in local communities, to build and develop capacity for local management in meeting the challenges of HIV & AIDS"},{"label":"B","text":"Programme Learning Outcomes By the end of the course, the students will be able to:"}],"priority":1,"status":"review","flags":["subject_unclassified","topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["long_option_manual_review","mcq_missing_options","not_enough_options","prior_structural_review_flag","repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"f0d94705901b9b7914c39a25f184cd4a0ba69565"},{"id":"q-91ca8b47f726","stem":"Identify and assess different disabilities and their functional needs","type":"Image / Diagram Question","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"review","flags":["subject_unclassified","topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior