wing","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Bromocriptine"},{"label":"B","text":"Cabergoline"},{"label":"C","text":"Pergolide"},{"label":"D","text":"All of the above"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-4ab01e9623da","stem":"Indications of oxitocin are following","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Labor and augment dysfunctional labor for conditions requiring early vaginal delivery"},{"label":"B","text":"Incompleted abortion"},{"label":"C","text":"For control of pospartum uterine hemorrhage"},{"label":"D","text":"All of the above"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f86245d19768","stem":"Indications of vasopressin are following","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Diabetes mellitus"},{"label":"B","text":"Hypertension"},{"label":"C","text":"Pituitary diabetes insipidus"},{"label":"D","text":"Incompleted abortion"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-86ef4c4df7eb","stem":"Vasopressin possesses the following","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Antidiuretic property"},{"label":"B","text":"Vasodilatation property"},{"label":"C","text":"Release of a thyroid hormone into the plasma"},{"label":"D","text":"Diuretic property"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-4a8030f8320a","stem":"Oxytocin produces the following effects","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"It causes contraction of the uterus"},{"label":"B","text":"It assists the progress of spermatozoa into the uterine cavity"},{"label":"C","text":"It brings about milk ejection from the lactating mammary gland"},{"label":"D","text":"All of the above"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-dd3693baa2af","stem":"Vasopressin causes a pressor effect by","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Releasing noradrenaline from the nerve terminals"},{"label":"B","text":"Releasing and activating renin-angiotensin system"},{"label":"C","text":"A direct action on smooth muscles of the blood vessels"},{"label":"D","text":"All of the above mechanisms"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-471df752bac7","stem":"Which of the following statements is true","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Hypothyroidism is a syndrome resulting from deficiency of thyroid hormones and is manifested largely by a reversible slowing down of all body functions"},{"label":"B","text":"Hypothyroidism is the clinical syndrome that results when tissues are exposed to high levels of thyroid hormone"}],"priority":1,"status":"review","flags":["mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"248a6c54f8445b675f896816d3de20b31c35fe86"},{"id":"q-16e3a584cafe","stem":"Which of the following hormones is produced by the thyroid gland?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Head and Neck","options":[{"label":"A","text":"Thyroxine"},{"label":"B","text":"Thyroid-stimulating hormone"},{"label":"C","text":"Thyrotropin-releasing hormone"},{"label":"D","text":"Thyroglobulin."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck · Suggested","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"ff3542f3e2ba0e6aaf676862ba974428e8eebdb9","manualEdits":{}},{"id":"q-26f24c85a3a0","stem":"Which of the following hormones is produced by the thyroid gland?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Head and Neck","options":[{"label":"A","text":"Thyroid-stimulating hormone"},{"label":"B","text":"Thyrotropin-releasing hormone"},{"label":"C","text":"Triiodothyronine"},{"label":"D","text":"Thyroglobulin."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"ff3542f3e2ba0e6aaf676862ba974428e8eebdb9"},{"id":"q-b0a88411a5ab","stem":"Thyroid stimulating hormone regulates the following","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Iodine uptake"},{"label":"B","text":"Biosynthesis of iodothyroglobulin"},{"label":"C","text":"Release of thyroid hormone into the plasma"},{"label":"D","text":"All of the above."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-90baabb7047b","stem":"Thyroid hormones produce various pharmacological effects. Indicate the wrong statement(s).","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Decline of the basal metabolic rate in the body"},{"label":"B","text":"Increase in the rate and force of contraction of the heart"},{"label":"C","text":"Increase in the blood cholestrol level"},{"label":"D","text":"Increase in the heat production"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-bbc0843911de","stem":"Synthesis and release of thyroid hormones are controlled by","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Anterior pituitary alone"},{"label":"B","text":"Hypothalamus alone"},{"label":"C","text":"Blood levels of thyroid hormones alone"},{"label":"D","text":"All of the above"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f64b977acda2","stem":"Thyrotrophin stimulates the following processes","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Concentration of iodine by thyroid follicles"},{"label":"B","text":"Iodination of thyroglobulin"},{"label":"C","text":"Release of thyroxine and triidothyronine"},{"label":"D","text":"De-iodination of thyroid hormones."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-0b9b25f96a64","stem":"The rate of secretion of thyrotropin is controlled by","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"The amount of iodine in the thyroid gland"},{"label":"B","text":"The amount of thyroid hormones in the thyroid gland"},{"label":"C","text":"The concentration of thyroid hormones in blood"},{"label":"D","text":"The concentration of catecholamines in blood"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b332e3cefad0","stem":"Indications of thyroid hormones are following, EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Cretinism"},{"label":"B","text":"Myxoedema"},{"label":"C","text":"Hashimoto's disease"},{"label":"D","text":"For treatment of simple obesity"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ddcf7d7f1b4b","stem":"The common side effect of thyroid hormones is following","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Increases in basal metabolic rate"},{"label":"B","text":"Angina pectoris"},{"label":"C","text":"Tremors"},{"label":"D","text":"Exopthalmos"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-fed02fd53120","stem":"Currently used antithyroid drugs include the following, EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Propylthiouracil (PTU)"},{"label":"B","text":"Diatrizoate sodium (Hypaque)"},{"label":"C","text":"Methimazole (Tapazole)"},{"label":"D","text":"Potassium perchlorate"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-35d090f32f17","stem":"In an area where goitre is endemic, which of the following drugs is used?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Iodide 1 part in 100000"},{"label":"B","text":"Propylthiouracil 200 mg daily"},{"label":"C","text":"Methimazole 40 mg daily"},{"label":"D","text":"Any of the above can be used."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-2e013c668ba9","stem":"Iodide preparations can be used in following situations, EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"In thyroid disorders"},{"label":"B","text":"In granulomatous lesions e.g. Syphilis"},{"label":"C","text":"As an antiseptic"},{"label":"D","text":"In iodism"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e05fc27eec18","stem":"Daily administration of large doses (several milligrammes) of iodides to a thyrotoxic patient causes","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Involution of the thyroid which reaches a maximum in two weeks"},{"label":"B","text":"Increased vascularity of the thyroid gland"},{"label":"C","text":"Decreased storage of the colloid in the thyroid gland"},{"label":"D","text":"Thyroid gland growing firm and less vascular"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-3823d9f53c15","stem":"Radioiodines (I131 and I132) is suitable for","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Elderly patients (over 45 years)"},{"label":"B","text":"Pregnant women"},{"label":"C","text":"Nursing mothers"},{"label":"D","text":"Younger patients"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-8c27004b9c37","stem":"Radioiodines in the body emit","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Mainly β radiations"},{"label":"B","text":"Mainly γ radiations"},{"label":"C","text":"β and γ radiations equally."},{"label":"D","text":"Do not emit any radiation, therefore, are safe PART VII Antihyperlipidemic Drugs & Drugs Used In the Treatment of Gout"}],"priority":1,"status":"review","flags":["duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["duplicate_option_text","prior_structural_review_flag"],"cleaningOperations":[]},{"id":"q-8aa50905a9f4","stem":"Lipoprotein is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"A conjugated protein having a lipid component; the principal means for transporting lipids in the blood"},{"label":"B","text":"Any of various fat-soluble or water-soluble organic substances essential in minute amounts for normal growth and activity of the body and obtained naturally from plant and animal foods"},{"label":"C","text":"Product of endocrine gland secretion"},{"label":"D","text":"Mediators of inflammatory process"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["short_stem"],"cleaningOperations":[]},{"id":"q-d68453104089","stem":"Very low density lipoprotein (VLDL) is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"A lipoprotein containing a very large proportion of lipids to protein and carrying most cholesterol from the liver to the tissues"},{"label":"B","text":"A lipoprotein that contains relatively high amounts of cholesterol and is associated with an increased risk of atherosclerosis and coronary artery disease. It is also called beta-lipoprotein"},{"label":"C","text":"A lipoprotein that contains relatively small amounts of cholesterol and triglycerides and is associated with a decreased risk of atherosclerosis and coronary artery disease. It is also called alpha-lipoprotein"},{"label":"D","text":"Large lipoprotein particle that is created by the absorptive cells of the small intestine. It transports lipids to adipose tissue where they are broken down by lipoprotein lipase"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-0a72ac12793f","stem":"Low-density lipoprotein (LDL) is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"A lipoprotein that contains relatively high amounts of cholesterol and is associated with an increased risk of atherosclerosis and coronary artery disease. It is also called beta-lipoprotein"},{"label":"B","text":"A lipoprotein that contains relatively small amounts of cholesterol and triglycerides and is associated with a decreased risk of atherosclerosis and coronary artery disease. It is also called alpha-lipoprotein"},{"label":"C","text":"A lipoprotein containing a very large proportion of lipids to protein and carrying most cholesterol from the liver to the tissues"},{"label":"D","text":"Large lipoprotein particle that is created by the absorptive cells of the small intestine. It transports lipids to adipose tissue where they are broken down by lipoprotein lipase"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-2096eccbde09","stem":"High-density lipoprotein (HDL) is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"A lipoprotein that contains relatively small amounts of cholesterol and triglycerides and is associated with a decreased risk of atherosclerosis and coronary artery disease. It is also called alpha-lipoprotein"},{"label":"B","text":"A lipoprotein containing a very large proportion of lipids to protein and carrying most cholesterol from the liver to the tissues"},{"label":"C","text":"A lipoprotein that contains relatively high amounts of cholesterol and is associated with an increased risk of atherosclerosis and coronary artery disease. It is also called beta-lipoprotein"},{"label":"D","text":"Large lipoprotein particle that is created by the absorptive cells of the small intestine. It transports lipids to adipose tissue where they are broken down by lipoprotein lipase"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ca299bbd80bc","stem":"Chylomicron is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"A lipoprotein that contains relatively small amounts of cholesterol and triglycerides and is associated with a decreased risk of atherosclerosis and coronary artery disease. It is also called alpha-lipoprotein"},{"label":"B","text":"A lipoprotein containing a very large proportion of lipids to protein and carrying most cholesterol from the liver to the tissues"},{"label":"C","text":"A lipoprotein that contains relatively high amounts of cholesterol and is associated with an increased risk of atherosclerosis and coronary artery disease. It is also called beta-lipoprotein"},{"label":"D","text":"Large lipoprotein particle that is created by the absorptive cells of the small intestine. It transports lipids to adipose tissue where they are broken down by lipoprotein lipase"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["short_stem"],"cleaningOperations":[]},{"id":"q-c9c1f1910e9a","stem":"Hyperlipoproteinemia is a condition marked by an abnormally high level of lipoproteins in the blood. This consideration is","type":"True / False","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-76cb363088b2","stem":"Hypertriglyceridemia denotes high blood levels of triglycerides. It has been associated with atherosclerosis, even in the absence of hypercholesterolemia (high cholesterol levels). This consideration is","type":"True / False","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-286ddd5a6d58","stem":"Hypercholesterolemia (or hypercholesteremia) is an abnormally high concentration of cholesterol in the blood. This consideration is","type":"True / False","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d5e7f05ad110","stem":"Which of the following consideration about type I familial hyperlipoproteinemia is True","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Type I familial hyperlipoproteinemia marked by the increased serum concentrations of chylomicrons and triglycerides, which decrease if the diet becomes fat free, decreased concentrations of high- and low-density lipoproteins, which increase if the diet is fat free, and decreased tissue lipoprotein lipase activity"},{"label":"B","text":"Type I familial hyperlipoproteinemia characterized by increased serum concentrations of chylomicrons, pre-low-density lipoproteins, and triglycerides that are considered to be the result of a combination of fat and carbohydrate-induced hyperlipemia"}],"priority":1,"status":"review","flags":["mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag"],"cleaningOperations":[]},{"id":"q-ec3c7122e38c","stem":"Familial chylomicronemia (type I) is caused by deficiency in lipoprotein lipase activity. This consideration is","type":"True / False","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-6efd9550ded6","stem":"The Coronary Primary Prevention Trial (CPPT) demonstrated that treatment with a lipid-lowering drug could reduce the risk of death due to coronary heart disease. This consideration is","type":"True / False","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e13da8cb80c9","stem":"Women taking probucol (Lorelco) should wait for 6 months after cessation of therapy before becoming pregnant. This consideration is","type":"True / False","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e3d3ace4fd2e","stem":"Nicotinic acid (Niacin) plus a bile acid-binding resin has not proven effective in combating hyperlipidemia. This consideration is","type":"True / False","subject":"Medical Biochemistry","topic":"Water, pH and Buffers","topicOriginal":"Water, pH and Buffers","subtopic":"Acid","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Water, pH and Buffers","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-69f2842add36","stem":"The ideal therapy for patients with elevated levels of cholesterol would lower the serum concentration of LDL-cholesterol while raising the concentration of HDL-cholesterol. This consideration is","type":"True / False","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-02144b2d81bd","stem":"Agents, which lower levels of LDL-cholesterol, tend to promote regression of atherosclerotic plaques. This consideration is","type":"True / False","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f898b07bcebd","stem":"Clofibrate (Atromid-S) is the drug of choice for treatment of broad-beta hyperlipidemia (type III). This consideration is","type":"True / False","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-395982dc2868","stem":"One advantage of gemfibrozil (Lopid) is that, in addition to lowering blood levels of most lipids, it raises the level of HDL cholesterol. This consideration is","type":"True / False","subject":"Medical Biochemistry","topic":"Lipids","topicOriginal":"Lipids","subtopic":"Lipid","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Lipids","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-6ae139aeb4c9","stem":"Probucol (Lorelco) appears to increase clearance of LDL cholesterol by a non-receptor mediated mechanism. This consideration is","type":"True / False","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-63a5b039d3a3","stem":"All of the following statements concerning cholestyramine (Questran) are true, EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"It would not be a good choice for treating patients with familial hypertriglyceridemia (type IV)"},{"label":"B","text":"It is not well tolerated by patients"},{"label":"C","text":"It works by directly binding cholesterol in the blood"},{"label":"D","text":"It is an effective drug for treatment of types IIa and IIb hyperlipidemia"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b3950fc318a8","stem":"All of the following statements concerning drugs which inhibit cholesterol synthesis are true, EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"They work in part by increasing the rate of LDL clearance from the plasma"},{"label":"B","text":"They are the most effective single agents for lowering LDL-cholesterol"},{"label":"C","text":"When used with a bile-acid binding resin, they can lower LDL-cholesterol by 50% or more"},{"label":"D","text":"No special monitoring is required in patients receiving one of them"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"392ec85d1793b06458b60186ea7b5a22ee193680"},{"id":"q-9f0bb9307d2e","stem":"All of the following statements concerning nicotinic acid (Niacin) are true, EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"It reduces the rate of synthesis of VLDL"},{"label":"B","text":"Sustained-release preparations of this drug are largely free of side effects"},{"label":"C","text":"Almost all patients taking the traditional dosage form of this drug experience uncomfortable flushing"},{"label":"D","text":"It should not be used with antihypertensives"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"66542fa0861ed8c4acdc636a08b5c36d97d56cee"},{"id":"q-cccdb5ed8afc","stem":"All of the following statements concerning drugs which inhibit cholesterol synthesis are true, EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"When used alone, they are the most effective agents for lowering LDL cholesterol"},{"label":"B","text":"They are often effective in patients in whom a diet, with or without a bile acid-binding resin or niacin, has failed"},{"label":"C","text":"Lovastatin (Mevacor) plus a resin causes regression of coronary lesions in about one third of treated patients"},{"label":"D","text":"Members of this drug class are generally not as well tolerated as the older bile acid-binding resins"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"392ec85d1793b06458b60186ea7b5a22ee193680"},{"id":"q-4741c42d2b74","stem":"All of the following statements concerning drugs which inhibit cholesterol synthesis are true, EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"These drugs should not be used in pregnant women or children"},{"label":"B","text":"These drugs often cause myopathy if used in combination with cyclosporine (Sandimmune)"},{"label":"C","text":"Failure to discontinue the drug after myopathy has been detected can cause acute renal failure"},{"label":"D","text":"Several of these drugs tend to lengthen the sleep cycle"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"392ec85d1793b06458b60186ea7b5a22ee193680"},{"id":"q-fd2e50347440","stem":"All of the following statements concerning the fibric acid derivatives are true, EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Clofibrate (Atromid-S) is the drug of choice for therapy of Type III hyperlipidemia"},{"label":"B","text":"Gemfibrozil (Lopid) increases HDL cholesterol while lowering LDL cholesterol"},{"label":"C","text":"Gemfibrozil (Lopid) has been shown to reduce mortality associated with a heart disease"},{"label":"D","text":"Gemfibrozil (Lopid) is generally well tolerated"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-1ae8c3d369e3","stem":"All of the following statements concerning the bile acid-binding resins are true, EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"They decrease total cholesterol and LDL"},{"label":"B","text":"They are contraindicated in patients with hypertriglyceridemia"},{"label":"C","text":"When used alone, they do not slow the progression of atherosclerotic lesions"},{"label":"D","text":"They are the drugs of choice for therapy of type II hyperlipidemia when used either alone or in combination with selected agents"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f95208ea96f6","stem":"All of the following statements concerning nicotinic acid (Niacin) are true, EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Both triglycerides and LDL cholesterol are reduced by this drug"},{"label":"B","text":"The drug acts by directly decreasing the rate of synthesis of apoproteins"},{"label":"C","text":"Doses higher than 3 gm/day are no longer used because of possible disturbances of hepatic or pancreatic functions"},{"label":"D","text":"Most patients taking this drug experience uncomfortable cutaneous flushing, itching, and/or rashes"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"66542fa0861ed8c4acdc636a08b5c36d97d56cee"},{"id":"q-9918635e60d3","stem":"All of the following statements concerning the general principles of therapy with lipid-lowering drugs are true EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Therapy with a lipid-lowering drug should be always accompanied by an appropriate diet"},{"label":"B","text":"A lipid-lowering diet should be discontinued if it fails to decrease the levels of plasma LDL cholesterol by at least 10%"},{"label":"C","text":"Lipid-lowering drugs should only be administered after at least 3 months of prior dietary therapy"},{"label":"D","text":"Some combinations of lipid-lowering drugs are synergistic"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a72ce8cbccad","stem":"The cholesterol synthesis inhibitors increase the rate of clearance of LDL cholesterol from the plasma. This consideration is","type":"True / False","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-dd72e2846e2e","stem":"Lovastatin (Mevacor) plus a bile-acid binding resin causes regression of coronary lesions in about one third of treated patients. This consideration is","type":"True / False","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-831e4058a500","stem":"The cholesterol synthesis inhibitors are better tolerated than most other lipid-lowering agents. This consideration is","type":"True / False","subject":"Medical Biochemistry","topic":"Lipids","topicOriginal":"Lipids","subtopic":"Cholesterol","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Lipids","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-1577c3053e09","stem":"Selected liver and muscle enzymes should be monitored during the use of any cholesterol synthesis inhibitors because of possible toxic effects. This consideration is","type":"True / False","subject":"Human Anatomy","topic":"Abdomen","topicOriginal":"Abdomen","subtopic":"Liver","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Abdomen","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-17857fb479a5","stem":"The bile acid-binding resins act by directly binding cholesterol and facilitating its excretion. This consideration is","type":"True / False","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-416f0eb6ea31","stem":"Nicotinic acid (Niacin) acts by increasing the rate of catabolism of VLDL. This consideration is","type":"True / False","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-47a94105544b","stem":"Gemfibrozil (Lopid) can cause dizziness and syncope when used with antihypertensives. This consideration is","type":"True / False","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d6c5de063854","stem":"Gemfibrozil (Lopid) increases concentrations of HDL cholesterol more than clofibrate (Atromid-S). This consideration is","type":"True / False","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-df19e233ad40","stem":"The bile acid-binding resins can bind many drugs and vitamins and reduce their absorption. This consideration is","type":"True / False","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-8ba77a73d73c","stem":"When used alone, the bile acid-binding resins are contraindicated in patients with hypertriglyceridemia. This consideration is","type":"True / False","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-9af70e5ec122","stem":"Combinations of lipid-lowering drugs are likely to be synergistic if they work at different steps in the same pathway. This consideration is","type":"True / False","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-0d0b27ee6749","stem":"Reduction in plasma triglycerides and LDL cholesterol concentrations with gemfibrozil treatment is greater than reduction in plasma cholesterol and LDL cholesterol concentrations with gemfibrozil treatment. This consideration is","type":"True / False","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b405ae4673eb","stem":"Patients with homozygous familial hypercholesterolemia (type IIa) lack any functional LDL receptors on their hepatocytes. This consideration is","type":"True / False","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-041fb3e01f93","stem":"Effects of drugs in lowering blood cholesterol levels are additive with those of diet. This consideration is","type":"True / False","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-96c8f8f93427","stem":"HMG-CoA reductase inhibiting drugs can cause muscle breakdown, especially when used in combination with a cyclosporine. This consideration is","type":"True / False","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-855c112a4c8f","stem":"Probucol (Lorelco) reduces the risk of atherosclerosis by stimulating the rate of clearance of LDL by receptor-mediated pathways. This consideration is","type":"True / False","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a58b030218e7","stem":"Clofibrate (Atromid-S) is generally regarded as superior to gemfibrozil.","type":"True / False","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"