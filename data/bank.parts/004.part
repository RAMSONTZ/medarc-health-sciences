tatus":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-e0a10d4ec9b7","stem":"What Measures are imposed under SAPs?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-09c2eee74b10","stem":"Why the Need for SAPS?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-701393945517","stem":"What's Wrong with SAPs?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-700d888dafc4","stem":"Why do you think it is important to study environmental problems?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-70cf080b8191","stem":"(a) Identify five major environmental problems that face the global community. (b) Why do you think those are the major ones?","type":"Image / Diagram Question","subject":"Community Health and Public Health","topic":"Environmental and Occupational Health","topicOriginal":"Environmental and Occupational Health","subtopic":"Environment","suggestedTopic":null,"options":[],"priority":2,"status":"review","flags":["requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Community Health and Public Health","displayTopic":"Environmental and Occupational Health","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-112ac47681cb","stem":"what is most like diagnosis? [Slide 4] Problem 3 Male 70 presenting with lymphodenpathy biopsy taken from small mature lymphocytes TWBCs normal What is your diagnosis [Slide 5] Problem 4 Adam male 70 years old presenting with anemia CBC show lymphocytosis BM was dry O/E -huge splenomegaly What is your diagnosis [Slide 6] Problem 5 Adam male 38 years old presenting with fever, nigh sweats ,enlarge lymph nodes Cytogentic done translocation (14:18) What is your diagnosis ? [Slide 7] Problem 6 Male with fever ,night sweats lymph node show tumer CD19 (+) CD20(+) CD5(+) CD32(-) cycline D1 (+) Q-what is your diagnosis [Slide 8] Problem 6 Child with jow mass biopsy shows (mediums size lymphocytes) high micotic rate with starry sky apperant What is your diagnosis ? [Slide 9] Problem 7 Male 53 years old has lymphodenopathy ,splenmegaly X-RAY bone no lytic lession electrophosis show IgM serum calcium normal What is your diagnosis? [Slide 10] Problem 8 Seham female 29 years give birth to a baby 2 hours later after birth she had bleeding decided to give her blood transfusion","type":"Radiological Interpretation","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["possible_multiple_questions_in_stem","prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-f512d8c57e0a","stem":"what is the criteria for donate ?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-5505bc4d2de4","stem":"what perform of blood before transfusion ?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-3c827c85ccb2","stem":"mention the disease trans by blood ?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-d487193d4bcb","stem":"mention 5 complication of blood transfusion [Slide 11] Problems 9 Adam male 38 years old immune suppressed had sever respiratory infection 2 days had bleeding by nose and purpelic rash (plt=30,000 – BT=30 MIN - PT=20 – control=20 –PTT=45) Q-what is your diagnosis ? Q-other tests you will request ? Q-treatment plan ? [Slide 12] Problem 10 Altahir boy 3 years old had circumcison boutgh to hospital with post –circumicism bleeding Q-mention 5 differential diagnosis ? Q- additions tests ? Q-treatment plan ? [Slide 13] Problems 1-(sunday) Sara female 29 years olds from madani delivered vaginal 2 hour past delivery she had bleeding (pales = 120 BP=80/50 Decided togive her (blood","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["possible_multiple_questions_in_stem","topic_generic"],"cleaningOperations":[]},{"id":"q-ca9dd6c2b6fc","stem":"mention 5 complication of blood transfusion ? [Slide 14] Problem 2 Adam male with epistaxsis his lab test (HB= 13 PLT =228 –BT=13) Q-what is your diagnosis ? Q-other lab tests you requests Q-treatment [Slide 15] Problem 3 Adam 70 years old with sensation in in abdomin O/E spleen enlarge 13 CM Q- what is deferential dignosis ? Q- lab tests ?","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e697105d5445","stem":"What is your diagnosis ?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-598fb0303272","stem":"In research, something that does not \"vary\" is called variable method constant control group 9. Which scale is the simplest form of measurement? Nominal Ordinal Interval Ratio 10: According to the text, most of the outcome/dependent variable characteristics and attributes measured in educational research probably exist at the ______________ level of measurement. Nominal Ordinal Interval d. Ratio 11: An ordinal scale is: The simplest form of measurement A rank-order scale of measurement A scale with equal intervals between adjacent numbers A scale with an absolute zero point 12: When each member of a population has an equally likely chance of being selected, this is called: A nonrandom sampling method A quota sample A snowball sample An Equal probability selection method 13: Which of the following techniques yields a simple random sample? Choosing volunteers from an introductory psychology class to participate Listing the individuals by ethnic group and choosing a proportion from within each ethnic group at random. Numbering all the elements of a sampling frame and then using a random number table to pick cases from the table. Randomly selecting schools, and then sampling everyone within the school.","type":"Clinical Vignette","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["possible_multiple_questions_in_stem","topic_generic"],"cleaningOperations":[]},{"id":"q-ca53a5d1c6aa","stem":"Which of the following is not true about stratified random sampling? It involves a random selection process from identified subgroups Proportions of groups in the sample must always match their population proportions Disproportional stratified random sampling is especially helpful for getting large enough subgroup samples when subgroup comparisons are to be done Proportional stratified random sampling yields a representative sample 15: Which of the following statements are true? The larger the sample size, the greater the sampling error The more categories or breakdowns you want to make in your data analysis, the larger the sample needed The fewer categories or breakdowns you want to make in your data analysis, the larger the sample needed As sample size decreases, so does the size of the confidence interval 16: Which of the following sampling techniques is an equal probability selection method (i.e., EPSEM) in which every individual in the population has an equal chance of being selected? Simple random sampling Systematic sampling Proportional stratified sampling All of the above are EPSEM 17: Which of the following is not a form of nonrandom sampling? Snowball sampling Convenience sampling Quota sampling They are all forms of nonrandom sampling 18: People who are available, volunteer, or can be easily recruited are used in the sampling method called ______. Simple random sampling Cluster sampling Systematic sampling Convenience sampling","type":"Short Answer","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ee8e92c86a5c","stem":"For the following histogram, what is the proper ordering of the mean, median, and mode? Note that the graph is NOT numerically precise - only the relative positions are important. I = mean II = median III = mode I =mode II = median III = mean I = median II = mean III = mode I = mode II = mean III = median 49. There is a positive association between the number of drownings and ice cream sales. This is an example of an association likely caused by: coincidence cause and effect relationship confounding factor none of the above 50. What is a statistical inference? A decision, estimate, prediction, or generalization about the population based on information contained in a sample. A statement made about a sample based on the measurements in that sample. A set of data selected from a larger set of data. A decision, estimate, prediction or generalization about sample based on information contained in a population.","type":"Short Answer","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Incidence","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["possible_multiple_questions_in_stem"],"cleaningOperations":[]},{"id":"q-24b2dc810986","stem":"Read the table below and look at the P value. In each case, think about what the P value tells you, and what the confidence interval for the mean difference tells you. The mean systolic blood pressure is statistically significant There is statistically significant observed mean difference between the systolic and diastolic blood pressure A and B are correct None is correct 52. Which of the following best describes the number of cases of a disease in a given population at a specific time?","type":"Clinical Vignette","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-77d260aab088","stem":"Name the graphical presentation above.................................. 69: What type of variable is used to make this graph.......................... 70: Between the categories that made the graph, which one carries highest percentage........................ 71: The followings are true in summarizing binary data except one Use % and (n/N) Do not give too many digits You may use more than 2 decimals if have large study group Giving median and mode would be the best option 72: Descriptive statistics is used to characterize the set of data in terms Shape, tables, central tendency, and variability. Graphs and draw conclusion Tables and graphs All above are correct 73: Measures of Variability include Range, Percentiles Variance, standard deviation Coefficient of variation All a, b, c are correct 74: One of the study designs is purely experimental study Randomized placebo clinical trial Case control Prospective study Retrospective study","type":"Clinical Vignette","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-c824a9735fc2","stem":"the average because the 95% confidence interval does not cover 0. There is evidence that doing assignments improves the average grade because the 95% confidence interval does not cover 0. There is evidence that doing assignments does not improve the average grade because the 95% confidence interval does not cover 0. 6: A variable that is presumed to cause a change in another variable is called a(n): categorical variable dependent variable independent variable intervening variable 7: Which of the following can best be described as a categorical variable?","type":"Short Answer","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5197ec80c9ee","stem":"<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"no\"?>","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options"