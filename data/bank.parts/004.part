ice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"4df8ef3f3987e5e10a04e9dcd7c640b774e49556"},{"id":"q-fa7eb516b3df","stem":"Which of the following is not one of the seven major parts to the research report?","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"eb8ffc0f8325e14806ee201646d6a82d052bdc2b"},{"id":"q-89a6cd2a538e","stem":"Where do you provide a step-by-step account of what the researcher and participants did during the research study?","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"26f371526b35f80bd0ab95c7b6d76882930b84df"},{"id":"q-9afdaacf2f3b","stem":"When a researcher starts with the dependent variable and moves backwards, it is called ________. Predictive research Retrospective research Exploratory research Descriptive research","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7176da1742df","stem":"Which of the following is/are necessary condition(s) for causation?","type":"Short Answer","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"4ef89691bce4efa34162946d93d0cbad98344937"},{"id":"q-cc0c144d011f","stem":"Which type of well-being is NOT part of the WHO definition of health?","type":"Short Answer","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"355d6b3381cb7d10be341a676c5df198bf5b7cf6"},{"id":"q-8a9d1ab27c77","stem":"9: Is the health education to prevent HIV infection a form of primary, secondary, or tertiary prevention?","type":"Short Answer","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7f73d95943a4","stem":"Is smoking a necessary, sufficient, or non-necessary contributing cause of lung cancer?","type":"Short Answer","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-57e36d87c514","stem":"What happens to the prevalence of a disease in a population when the average duration of the disease increases?","type":"Short Answer","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Prevalence","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"23b63ba51736330a257a0d30fbfaf8b6b83495bf"},{"id":"q-9626836f8dbb","stem":"For which of the following disease situations could a cross-sectional study design be used to determine prevalence?","type":"Short Answer","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Prevalence","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"847ba617be6193536452717232b0f6d501bb97a8"},{"id":"q-a2561ab0b8de","stem":"Which measure of association is most appropriate in the cross-sectional design?","type":"Short Answer","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Prevalence","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"7d20dfbfdd8b82e50073d7e170b9aac3bd25a82b"},{"id":"q-e1e9e4be9093","stem":"When only study subjects are unaware of their treatment status but investigator and analyst are aware of the treatment status, the trial is called triple –blinded trial ...F...","type":"Short Answer","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-df88fffc4fd4","stem":"Read the scenario and answers questions that follow (10 marks) BMI is a measure of obesity (weight / height2). A study set out compare BMI between men and women. Mean BMI in a sample of men was 26.8 and mean BMI in a sample of women was 29.0. The difference between the mean for women and the mean for men was 2.2, with a 95% confidence interval from 0.1 to 4.3. The P value for this difference was calculated to be 0.048 (i.e. P = 0.048). What was aim of this study? To compare BMI between men and women What was the magnitude of the BMI? Was 2.2 with 95% CI: 0.1 to 4.3 What is the direction of this magnitude? Women has higher BMI by 2.2 than men Name the measure central tendency used in this study Mean Explain why do you think this measure of central tendency was used - Probably because the distribution of the weight and height was normally distributed","type":"Calculation","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1a3f26aeec3d","stem":"What kind of study design does the figure above represent?","type":"Image / Diagram Question","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[],"priority":2,"status":"review","flags":["requires_visual_review"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":true,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-d4b41c8890c0","stem":"Consider the values below and choose the best summary of the age-data below 15 17 12 16 48 the mean of this group is 21.6 year (sd 14.9) the median of this group is 16 (interquartile range 15-17 years) the range of this group is 12 – 48 years the mean of this group the mean of this group is 21.6 year (sd 14.9); median 16 years (interquartile range 15-17 years) the mean is equal t the median 6. Calculate the median value of the group below. 27 29 41 32 18 27 median is 29 years median is 28 years median is 27 years median is 18 – 41 years mode is 27 7. What options do you have to summarize not normally distributed data?","type":"Calculation","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["possible_multiple_questions_in_stem","topic_generic"],"cleaningOperations":[]},{"id":"q-85dfc07f81e7","stem":"The following graph (consider the bars only) is an example of: a normal distribution a skewed (not-normal) distribution both a normal and a skewed distribution both answer a and b could be correct, it is not possible to say not-normal distribution, but left skewed distribution 9. What kind of variable is hypertension (yes/no)?","type":"Clinical Vignette","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Incidence","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f6aa9cdefa99","stem":"Which measures of central tendency are unlikely to be affected by extremely low or extremely high values? Mean, median Mean, mode Mode, median Mean,median,mode All are correct 13: What is the relationship among the mean, median, and mode in a symmetrical distribution? all are equal mean is always the smallest value mean is always the largest value mode is the largest value al are not equal 14: Which of the following best describes the number of cases of a disease in a given population at a specific time?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":") Incidence"},{"label":"B","text":") Occurrence"},{"label":"C","text":") Frequency"},{"label":"D","text":") Prevalence"},{"label":"E","text":") Rate 15: With regard to the association between exposure and outcome."},{"label":"A","text":") Odds ratio of 1.0 means no association"},{"label":"B","text":") Odds ratio of 2.0 means half the effect"},{"label":"C","text":") Odds ratio 0.5 if increase risk 50%"},{"label":"D","text":") Odds ratio of 0.0 means no association e.) Odds ratio of negative means nothing. 16: Tick the wrong statement. Incidence of a disease may change if: a) New risk is introduced in the population b) There is change in the habit c) The duration of disease increases d) If there is change in the potency of treatment or intervention programme e) Changing virulence of causative"}],"priority":2,"status":"review","flags":["topic_generic","too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","too_many_options","too_many_options_possible_merge","topic_generic"],"cleaningOperations":[]},{"id":"q-fb7a3d4c0f98","stem":"The nonrandom sampling type that involves selecting a convenience sample from a population with a specific set of characteristics for your research study is called _____ a.) Convenience sampling b.) Quota sampling c.) Purposive sampling d.) Snowball sampling e.) Random sampling 18: Which of the following is not an example of a nonrandom sampling technique? a.) Purposive b.) Quota c.) Convenience d.) Cluster e.) None of the above 19: Which of the following sampling methods is the best way to select a group of people for a study if you are interested in making statements about the larger population? a.) Convenience sampling b.) Quota sampling c.) Purposive sampling d.) Random sampling e.) a, b and c are correct 20) Epidemiology can best be defined as study of a) Distribution, determinant and prevention of disease b) Distribution, determinants and treatment of diseases c) Controlling infectious diseases d) Important in medical science 21: The group that does not receive the experimental treatment condition is the Experimental group Control group Treatment group Independent group 22: An observation of a dependent variable response prior to any attempt to change this response is known as the ___________. Flat line Baseline Variance Reverse 23: A baseline _____________. Is used as the standard against which change induced by the treatment is assessed Is the occurrence of a response in its freely occurring or natural state Is first obtained prior to the administration of a treatment All of the above are true 24: The variable the researcher matches to eliminate it as an alternative explanation is called a (n) _________ variable. Matching Independent Dependent Partial 25: Which of the following is not a longitudinal design? Panel Cross-sectional Trend Both a and c are longitudinal designs 26: When a researcher starts with the dependent variable and moves backwards, it is called ________. Predictive research Retrospective research Exploratory research Descriptive research 27: Which of the following is/are necessary condition(s) for causation? The relationship condition The temporal antecedence condition The lack of alternative explanation condition All of the above 28: What is the median of the following set of scores? 18, 6, 12, 10, 14? 10 14 18 12 29: The standard deviation is: The square root of the variance A measure of variability An approximate indicator of how numbers vary from the mean All of the above 30: A graph that uses vertical bars to represent data is called a ____. Line graph Bar graph Scatter plot Vertical graph 31: The goal of ___________ is to focus on summarizing and explaining a specific set of data. Inferential statistics Descriptive statistics None of the above All of the above 32: The most frequently occurring number in a set of values is called the Mean Median Mode Range 33: As a general rule, the _______ is the best measure of central tendency because it is more precise. Mean Median Mode Range 34: Why are variance and standard deviation the most popular measures of variability? They are the most stable and are foundations for more advanced statistical analysis They are the most simple to calculate with large data sets They provide nominally scaled data None of the above 35: The ______ is the value you calculate when you want the arithmetic average. Mean Median Mode All of the above 36: The _______ is often the preferred measure of central tendency if the data are severely skewed. Mean Median Mode Range 37: Which of the following is NOT a measure of variability? Median Variance Standard deviation Range 38: What is the median of this set of numbers: 4, 6, 7, 9, 2000000? 7.5 6 7 4 39: What is the mean of this set of numbers: 4, 6, 7, 9, 2000000? 7.5 400,005.2 7 4 40: The median is ______. The middle point The highest number The average Affected by extreme scores 41. Which measure of central tendency takes into account the magnitude of scores? Mean Median Mode Range 42: If a test was generally very easy, except for a few students who had very low scores, then the distribution of scores would be _____. Positively skewed Negatively skewed Not skewed at all Normal 43: If a distribution is skewed to the left, then it is __________. Negatively skewed Positively skewed Symmetrically skewed Symmetrical 44: The malaria officer wishes to provide a graphic presentation on the sex distribution of malaria cases in his region. He could use: A bar chart. A histogram. A pie chart. (a) and (c). Use the following terms (A, B, C) below to answer questions 45 – 46, by filling the spaces left to each question: Case-Control study Longitudinal ecologic study Prospective cohort study 45: In ...................................multiple disease outcomes can be studied, but only the risk factors define and measured at the beginning of the study can be assessed 46: In ................................Only one outcome may be studied, but many risk factors or exposures may be assessed. 47: Which one of the following examples might represent a retrospective cohort","type":"Calculation","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Frequency"},{"label":"B","text":"Percentage"},{"label":"C","text":"Current"}],"priority":2,"status":"quarantine","flags":["probable_document_or_multiple_questions","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"quarantine","auditFlags":["long_stem_manual_review","possible_multiple_questions_in_stem","prior_structural_review_flag","probable_document_or_multiple_questions","topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-f43b04db322a","stem":"Choose the most correct answer 1. A median is: a) the average of the group the middle number of the group the most common number of the group a measure of the spread in a group a and b are correct 2. Consider the following values of a continuous variable 15 17 12 16 48 What is the best way of summarizing these data? the mean and standard deviation the mean and 95% confidence interval the median and the standard deviation the median and interquartile range b and d are correct 3. What is (are) characteristics of the normal distribution? the mean equals the median the distribution has a bell shape curve the standard deviation equals the standard error both answer a and b answer a, b and c 4. Why is it important to determine if a variable is normally distributed? it changes the way you summarize data it changes the way you analyse your data it is absolutely irrelevant both a, b and c all are correct","type":"Short Answer","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["answer_explanation_mixed_into_stem","possible_multiple_questions_in_stem","topic_generic"],"cleaningOperations":[]},{"id":"q-25ef417d1575","stem":"About Hypothesis testing","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The null hypothesis means that there is no difference"},{"label":"B","text":"The smaller the P value (less than 0.05) the more likely is our data, and the greater the evidence to reject the null hypothesis"},{"label":"C","text":"A and D are correct"},{"label":"D","text":"The study hypothesis means that there is difference"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"2cddf44f0b1142c914f1d72443b30aaf8b6fe903"},{"id":"q-84f2b9f6c7b6","stem":"In order for the project/research/study to be feasible","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It must consider resources (time and money)"},{"label":"B","text":"There is agreement of the meaning of the research question"},{"label":"C","text":"Whether everything that needs to be measured can be measured"},{"label":"D","text":"All of the above"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-731880046e0e","stem":"Randomization and double blinding in a controlled trial are intended to accomplish all of the following except","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"Minimise bias"},{"label":"B","text":"Optimize external validity"},{"label":"C","text":"Reduces or eliminate known confounders"},{"label":"D","text":"None of the above"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"32415bb37507f80dd40ca210cbe84c2a5cfa4ce9"},{"id":"q-d6a1ddeed76f","stem":"All of the following study designs are useful for hypothesis generation except","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Randomised controlled field trials"},{"label":"B","text":"Retrospective cohort studies"},{"label":"C","text":"Longitudinal ecologic studies"},{"label":"D","text":"Case-control studies"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8e7767bf9ff7","stem":"The nonrandom sampling type that involves selecting a convenience sample from a population with a specific set of characteristics for your research study is called.","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Convenience sampling"},{"label":"B","text":"Quota sampling"},{"label":"C","text":"Purposive sampling"},{"label":"D","text":"Snowball sampling"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"f8d66358f23f747a56c4dc81ecb49445d5dd26b4"},{"id":"q-f5962d922b8c","stem":"If we took the 500 people attending a school in New York City, divided them by gender, and then took a random sample of the males and a random sampling 1 of the females, the variable on which we would divide the population is called the","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Dependent variable"},{"label":"B","text":"Stratification variable"},{"label":"C","text":"Sampling variable"},{"label":"D","text":"Frame sampling"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-007b95842678","stem":"As a member of Public health team, you have an interest in controlling measles infection through vaccination, to estimate the level of immunity in your study population and derive the data useful for generating vaccination policy. You should","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"Conduct a case control study of measles infection"},{"label":"B","text":"Conduct randomized trial of measles vaccination"},{"label":"C","text":"Conduct a retrospective cohort study of measles vaccination"},{"label":"D","text":"Conduct cross sectional study of vaccination status"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"f803504200073b732413c3a063e7ca8ba4d27071"},{"id":"q-3c8edaf1e2a5","stem":"Cross sectional surveys are subject to the Neyman bias, or late look bias. This may be explained as","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"The tendency to detect only the late stages of a disease, when manifestations are more severe"},{"label":"B","text":"The tendency to detect preferentially the more indolent cases of a disease"},{"label":"C","text":"The tendency to detect only those cases of a disease that are asymptomatic"},{"label":"D","text":"The tendency to detect preferentially fatal disease"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-688236fdeae5","stem":"Case finding relies on the","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"Identification of the people with known risk factor"},{"label":"B","text":"Identification of the people with known disease"},{"label":"C","text":"Identification of the people with early stages of disease"},{"label":"D","text":"None of the above"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7f37dcd3785b","stem":"Sampling and sample size","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Randomization is the best way to control bias"},{"label":"B","text":"Randomization is the best way to control selection bias"},{"label":"C","text":"Representative sample selected through random sampling technique is the best way for generalizing the results"},{"label":"D","text":"b and c are most correct"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"84ba31928515dc441b0872e3aca0ab6235363e1f"},{"id":"q-8820289d4c09","stem":"Select the correct answer. Randomization","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"Helps to avoid misclassification of exposure status in randomized controlled trials."},{"label":"B","text":"Reduces the probability of selection bias in randomized controlled trials. 2"},{"label":"C","text":"Helps to avoid the necessity of performing an adjustment."},{"label":"D","text":"Helps to avoid interaction"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["answer_explanation_mixed_into_stem","repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"25c443aa6e9db79f5a98d652c3179de69fcfebda"},{"id":"q-06a52648d657","stem":"In research, something that does not \"vary\" is called","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"variable"},{"label":"B","text":"method"},{"label":"C","text":"constant"},{"label":"D","text":"control group"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e55cdba895d7","stem":"What is the mean of the set of numbers: 2,3,7,9,100000?","type":"Short Answer","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"5ce80287d3ea3c0dad4667a1070a1260ccbf15e6"},{"id":"q-5389206c6160","stem":"What is the median of the set of number: 2,3,7,9,100000?","type":"Short Answer","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"e481f53d8ed815e40f16526087b3b0cd749cadcc"},{"id":"q-85252c697fd2","stem":"Test selection criteria for a widespread screening program should include each of the following except","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"The test should be inexpensive and available."},{"label":"B","text":"The test results should be reliable and accurate."},{"label":"C","text":"The screening test must be as good as the gold standard test."},{"label":"D","text":"The test should be of low risk to patients."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"a23c693a0ddb4bc6f34f4aa166f42da342d2f85a"},{"id":"q-a902ec124090","stem":"The distribution of weight in a medical school of 600 students is right skewed. A student randomly selects 35 students from the school and records their average weight. She repeats this process 40 times. Each time, students previously randomly selected are again eligible to be randomly selected. The student then plots the average weights she obtained from the 40 samples and plots a sampling distribution. Select the correct statement","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The sampling distribution should be right skewed."},{"label":"B","text":"The variance in the sampling distribution should be smaller than the variance in the distribution of individual weights of all of the medical school students."},{"label":"C","text":"The mean of the sampling distribution should be to the left (less than) the mean of all the medical school students."},{"label":"D","text":"The standard deviation of the distribution of all the weights of the medical school students is called the standard error of the mean."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-72096ed08490","stem":"Which of the following independent variables cannot be manipulated in a research study?","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":