ditFlags":[],"cleaningOperations":[]},{"id":"q-2fadeb19ac19","stem":"A condition or characteristic that can take on different values or is called ___.","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"a constant"},{"label":"B","text":"a variable"},{"label":"C","text":"a cause-and-effect relationship"},{"label":"D","text":"a descriptive relationship"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-353d6bc00a14","stem":"A variable that is presumed to cause a change in another variable is called a (n)","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"categorical variable"},{"label":"B","text":"dependent variable"},{"label":"C","text":"independent variable"},{"label":"D","text":"intervening variable"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-1de0f4f918aa","stem":"All of the following are common characteristics of experimental research except","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"it relies primarily on the collection of numerical data"},{"label":"B","text":"it can produce important knowledge about cause and effect"},{"label":"C","text":"it uses the deductive scientific method"},{"label":"D","text":"it rarely is conducted in a controlled setting or environment"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a1da871f9086","stem":"______ research occurs when the researcher manipulates the independent variable.","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"causal-comparative research"},{"label":"B","text":"experimental research"},{"label":"C","text":"correlational research"},{"label":"D","text":"Cross sectional research"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"158d76426582f498533c42e96a06ce1a0d6c43e7"},{"id":"q-cdf7fa69918e","stem":"According to the text, which of the following orders is the recommended in the flowchart of the development of a research idea?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Research topic, research problem, research purpose, research question, hypothesis"},{"label":"B","text":"Research topic, research purpose, research problem, research question, hypothesis 6"},{"label":"C","text":"Research topic, research problem, research purpose, research question, hypothesis"},{"label":"D","text":"Research topic, hypothesis, research problem, research question, research purpose"}],"priority":2,"status":"review","flags":["topic_generic","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_text","nonunique_option_text","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"361c28f7b865b6c0a4eb3f8033d9eee1e5d8b7c2"},{"id":"q-346002248567","stem":"Sources of researchable problems can include","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Researchers’ own experiences as educators"},{"label":"B","text":"Practical issues that require solutions"},{"label":"C","text":"Theory and past research"},{"label":"D","text":"All of the above"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7db78c20a774","stem":"The Method section of the research plan typically specifies","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The results of prior studies that address the phenomena of interest"},{"label":"B","text":"The apparatus, instruments, and materials for the research study"},{"label":"C","text":"The planned research procedures"},{"label":"D","text":"c and d"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f3c8a7200166","stem":"Researchers use both open-ended and closed-ended questions to collect data. Which of the following statements is true?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Open-ended questions directly provide quantitative data based on the researcher’s predetermined response categories 7"},{"label":"B","text":"Closed-ended questions provide quantitative data in the participant’s own words"},{"label":"C","text":"Open-ended questions provide qualitative data in the participant’s own words"},{"label":"D","text":"Closed-ended questions directly provide qualitative data in the participants’ own words"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"da025bac73eac172f6f3511fb805833fa515b98a"},{"id":"q-1e97b2d6b19a","stem":"Select the correct answer","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"Study results can be clinically significant even if the results are not statistically significant."},{"label":"B","text":"The p value is a measure of association between the exposure and outcome."},{"label":"C","text":"Calculating a p value is one way of adjusting for a potential confounder."},{"label":"D","text":"The higher the p value, the higher the study’s power."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["answer_explanation_mixed_into_stem","repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"c91c4262685c62fad2d21b6633bdcf2204ceab1d"},{"id":"q-26be70b3594d","stem":"The directors of a graduate program in educational research wish to see what types of jobs their graduates take after they finish their program. They randomly sample students from the program and have them fill out questionnaires with items asking about the types of jobs they have had. They also are asked to describe the roles they play in their current positions. This project is best described as having what kind of objective","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Descriptive"},{"label":"B","text":"Predictive"},{"label":"C","text":"Explanatory"},{"label":"D","text":"Analytical"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-dcd24486109c","stem":"The most important issue on research about ethics for a participant is to","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Protect them"},{"label":"B","text":"Make sure they are safe"},{"label":"C","text":"Have right to refuse to participate without any consequence"},{"label":"D","text":"A, b and c are correct"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-79ea4e2db6d5","stem":"The standard deviation is","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The square root of the variance"},{"label":"B","text":"A measure of variability"},{"label":"C","text":"An approximate indicator of how numbers vary from the mean"},{"label":"D","text":"All of the above"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5c6663e457ff","stem":"The goal of ___________ is to focus on summarizing and explaining a specific set of data.","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"Inferential statistics"},{"label":"B","text":"Descriptive statistics 8"},{"label":"C","text":"None of the above"},{"label":"D","text":"All of the above"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"6ccb8e50c187b3ee963e519f28b250ee3fdc9c24"},{"id":"q-37434d4f4a49","stem":"The ______ is the value you calculate when you want the arithmetic average.","type":"Calculation","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"Mean"},{"label":"B","text":"Median"},{"label":"C","text":"Mode"},{"label":"D","text":"All of the above"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d3f9d339d1c7","stem":"The _______ is often the preferred measure of central tendency if the data are severely skewed.","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"Mean"},{"label":"B","text":"Median"},{"label":"C","text":"Mode"},{"label":"D","text":"Range"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7a1f787ccfbb","stem":"If a test was generally very easy, except for a few students who had very low scores, then the distribution of scores would be _____.","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"Positively skewed"},{"label":"B","text":"Negatively skewed"},{"label":"C","text":"Not skewed at all"},{"label":"D","text":"Norma"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"bb62dec7571b6358ef16beba3941e1fa90ad8d73"},{"id":"q-1cc4a38f4d81","stem":"As a general rule, researchers tend to use ____ percent confidence intervals.","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"99%"},{"label":"B","text":"95%"},{"label":"C","text":"50% 9"},{"label":"D","text":"none of the above"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"41d76086a02d79cec2063f06b95af816d7948481"},{"id":"q-b20c6e8ed0b5","stem":"_________ are the values that mark the boundaries of the confidence interval.","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Confidence intervals"},{"label":"B","text":"Confidence limits"},{"label":"C","text":"Levels of confidence"},{"label":"D","text":"Margin of error"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a044f338c0f5","stem":"If a research finding is statistically significant, then ____.","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The observed result is probably not due to chance"},{"label":"B","text":"The observed result cannot possibly be due to chance"},{"label":"C","text":"The observed result is probably a chance result"},{"label":"D","text":"The null hypothesis of “no relationship” is probably true"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-20daa5cfb848","stem":"Which type of well-being is NOT part of the WHO definition of health?","type":"Short Answer","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"355d6b3381cb7d10be341a676c5df198bf5b7cf6"},{"id":"q-916a3e8b3862","stem":"Which measure of association is most appropriate in the cross-sectional design?","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"Prevalence ratio"},{"label":"B","text":"Prevalence odds ratio"},{"label":"C","text":"Cumulative incidence"},{"label":"D","text":"None of the above 11"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"7d20dfbfdd8b82e50073d7e170b9aac3bd25a82b"},{"id":"q-30a18bb47166","stem":"The use of the comparison group is essential when","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"Designing a study"},{"label":"B","text":"Interpreting any research findings"},{"label":"C","text":"Analyzing the data"},{"label":"D","text":"Conducting case control study SECTION II: TRUE/FALSE QUESTIONS"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7b5099d47f58","stem":"About epidemiological study designs (10 Marks)","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"List 4 main epidemiological study designs I. cross sectional II. case-control III. cohort IV. clinical trials 13"},{"label":"B","text":"List main 2 disadvantages and advantages of a cross sectional study Disadvantages I. Does not provide temporal association between cause and outcome II. Because it is conducted at one point in time, can not predict trends over time III. Can not estimate incidence of disease Advantages I. easy and fast to conduct II. Cheap III. Rapid assessment of the health situation IV. Used for health planning V. Can provide prevalence"}],"priority":2,"status":"review","flags":["mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"8384a0b2f9190b5079744f1c2dc83e5d6e13c3b3"},{"id":"q-6d60dbc2ee37","stem":"Study the figure 1, below and respond to the questions below: (10 marks) Figure 1","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"What kind of study design does the figure above represent? Case-control"},{"label":"B","text":"For the study design you have named above, give very brief explanation in terms of comparable study participants involved based on their exposure and outcome status There are cases and controls among the participants. Both cases and controls were either exposed or not exposed to the risk factor. Only cases have outcome (disease) of interest"},{"label":"C","text":"List 2 disadvantages and advantages of this study design Advantages I. relative quick, cheap and easy to perform II. suitable for rare disease III. used to study multiple exposures/risk factors IV. no loss of follow-up Disadvantages I. recall bias II. not suitable for disease with rare exposure III. If onset of disease precede exposure to risk, causation can not be inferred. 14 4 Give differences between the following related terms (20 marks)"},{"label":"A","text":"Retrospective study and Prospective study Retrospective study: data on disease status or exposure status are collected after the events have occurred i.e. use pre-existing data on exposure and outcomes (as opposed to prospective data collection). Prospective study/incidence study/longitudinal or follow-up study: identify the participants and then follow them up over time until the end-point of interest has been reached or the time limit for the study has been reached (study in which data are collected in an going way during the study)."},{"label":"B","text":"Population and sample Population: A group of individuals living in a particular area or all cases that meet pre-set criteria and sample: A subset of units in the population or a group of subjects selected from a population"},{"label":"C","text":"Confounder and Bias Confounder: is a variable or a factor that is associated with both the exposure and outcome, but is not in a causal pathway between them. i.e. a confounder is also a risk factor for the outcome in its own right, and Bias: any error that results in a systematic deviation from the estimation of the association between exposure and outcome or an explanation for the findings of a study( information/measurement bias and or selection bias)"},{"label":"D","text":"Research proposal and research report Research proposal: A project proposal is written, to make an offer and to try to convince a supervisor or a future customer to accept it (it details how research will be undertaken i.e. contains; research title, introduction, objectives and methodology). and Research report: an outline how the research was conducted, it also gives findings from the research undertaken (i.e. contains; research title, introduction, objectives and methodology)"},{"label":"E","text":"Informed consent and a written informed consent Informed consent: is a legal condition whereby a person can be said to have given consent based upon an appreciation and understanding of the facts and implications of an action. The individual needs to be in possession of relevant facts and also of his or her reasoning abilities, such as not being mentally retarded or mentally ill and without an impairment of judgment at the time of consenting. And Written consent: Written consent should be gained wherever possible to ensure that information is being collected and provided in a consistent and uniform way. It also acts as a guarantee should any form of dispute arise. it requires an individual to sign on a sheet of paper as an agreement to participate in a study"}],"priority":2,"status":"review","flags":["duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","long_option_manual_review","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","too_many_options"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"dce8829c5a9577020550a8d443f2a3e74dceb146"},{"id":"q-c525cd75b749","stem":"Read carefully the figure below, and then answer the following Questions (10 Marks) 15 ID No Sex Smoker 1 M Y 3 M Y 5 F N 7 M N 8 F N 9 M Y 11 M Y 13 F N i) What type of Variable is this? ii) How many responses in each category?","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"ID No - Numerical discrete (quantitative)"},{"label":"B","text":"Sex - Categorical binary"},{"label":"C","text":"Smoker - Categorical binary"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-57c6ff231edf","stem":"calculate an effect size indicator, and make an assessment of practical","type":"Calculation","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-433b45e21a07","stem":"how strong a relationship is. For example, if relationship A has a p=.04 and","type":"Short Answer","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-17e573b4eb9e","stem":"The properties of good estimates should have","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"Absence of systematic error (unbiasedness)"},{"label":"B","text":"Small variability from one sample to another"},{"label":"C","text":"The mean of the sampling distribution of the means is unbiased"},{"label":"D","text":"A and B are the most correct"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-5c5d0ef40a11","stem":"Read the table below and look at the P value. In each case, think about what the P value tells you, and what the confidence interval for the mean difference tells you?","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The mean systolic blood pressure is statistically significant"},{"label":"B","text":"There is statistically significant observed mean difference between the systolic and diastolic blood pressure"},{"label":"C","text":"A and B are correct"},{"label":"D","text":"None is correct"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"4275f92890a53cfc33474d16008f183c2983d771"},{"id":"q-9e5fc8594189","stem":"When each member of a population has an equally likely chance of being selected, this is called: (a) A random sampling method (b) A convenience sample (c) A snowball sample (d) A cluster sampling method","type":"Short Answer","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-de401d7b1379","stem":"When the results are said to be significant, this means that","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"The statistician is making a probability statement"},{"label":"B","text":"It means that the differences observed are most likely to be real rather than being due to chance or random difference"},{"label":"C","text":"A and B are most correct"},{"label":"D","text":"The study can be accepted worldwide"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7a93ace8374e","stem":"Which of the following statements sounds like a null hypothesis?","type":"Short Answer","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"5ab0f24967afc5e9edb3acab5efff7afabbc8380"},{"id":"q-ad8609526590","stem":"P value interpretations","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"P > 0.05 Results not significant"},{"label":"B","text":"P < 0.05 Results is significant"},{"label":"C","text":"P < 0.01 Results is highly significant"},{"label":"D","text":"All A, B, C, D are correct"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"56b0e370dea728239fa4306df6f2a526de764552"},{"id":"q-156b3b8dbb56","stem":"Read the table below and look at the P value. In each case, think about what the P value tells you, and what the confidence interval for the mean difference tells you?","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The mean systolic blood pressure is statistically significant"},{"label":"B","text":"There is statistically significant observed mean difference between the systolic and diastolic blood pressure"},{"label":"C","text":"A and B are correct"},{"label":"D","text":"None is correct"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"],"duplicateStemGroup":"4275f92890a53cfc33474d16008f183c2983d771"},{"id":"q-981583a0e3c3","stem":"P value interpretations","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"P > 0.05 Results not significant"},{"label":"B","text":"P < 0.05 Results is significant"},{"label":"C","text":"P < 0.01 Results is highly significant"},{"label":"D","text":"All A, B, C, D are correct"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"56b0e370dea728239fa4306df6f2a526de764552"},{"id":"q-8e3666acdd34","stem":"Calculate; Mean (2), Median (1), Mode (1) Calculate range (1) Calculate the standard deviation (3) d. Which scale of measurement was used? (1) 3 A. Which level of measurements will you use for the following variables? For each variable, give the level of measurement and measure of central tendency (MCT) you will use to summarize the data (5 points) a) Blood haemoglobin level Scale of measurement: MCT: Outcome of malaria treatment Scale of measurement: MCT: Systolic blood pressure among adults Scale of measurement: MCT: Severity of dysponea Scale of measurement: MCT: Number of hospital visits Scale of measurement: MCT: 3 B. Study the following figure and answer the questions that follow (5 points)","type":"Calculation","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d77a5e106611","stem":"Figure 1. Prevalence of HIV by marital status among women in Moshi urban a) What was the dependent variable? (1) b). What was the independent variable? (1) c) Which scale of measurement was used for the outcome variable? (1) d) Which scale of measurement was used for the predictor variable? (1) What measure of central tendency and dispersion will you use to summarize the data and why? (1) 4. Look at the following 2 graphs and answer the following questions","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Prevalence","suggestedTopic":null,"options":[{"label":"A","text":"SHAPE \\* MERGEFORMAT"},{"label":"B","text":"SHAPE \\* MERGEFORMAT"},{"label":"C","text":"Figure 2: Age distribution of participants in HIV study in Moshi urban"}],"priority":2,"status":"review","flags":["duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_text","nonunique_option_text","prior_structural_review_flag"],"cleaningOperations":[]},{"id":"q-596291a82a9b","stem":"a.) What is the name (data presentation method) of figure 1 and 2 and what is the difference between them? (4) b) What were independent and dependent variables in figure number 1? (2) c) What was the scale of measurement used for independent and dependent variables in figure 1? (3) d) What was the scale of measurement used in figure 2? (1) 5. The following data shows duration of hospitalization for 24 children admitted last month to hospital with diarrhoea. (10 points) ID number","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"No of days hospitalized"},{"label":"B","text":"ID number"},{"label":"C","text":"No of days hospitalized"},{"label":"D","text":"Child 1"},{"label":"E","text":"Child 13"},{"label":"F","text":"Child 2"}],"priority":2,"status":"review","flags":["duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_text","nonunique_option_text","prior_structural_review_flag"],"cleaningOperations":[]},{"id":"q-d22de839d248","stem":"a. Calculate range and interquartile range (3) b. What was the mean duration of hospitalization? (3) c. What is the standard deviation? (3) d. Is range or standard deviation a better measure of the distribution in this case and why? 6. In order to estimate counts and rates of work-related fatalities, the National Traumatic Occupational Fatality system has introduced a tick-box on the death certificate to indicate \"injury at work.\" Kraus et al. (Am J Epidemiol 1995; 141: 973-9) attempted to validate this \"injury at work\" classification system against a gold standard [International Classification of Diseases (ICD) death certificate codes designating deaths that occurred during work-related activities]. After reviewing a sample of 100,000 death certificates, the authors reported the following: 1,195 true positives; 788 false positives; 97,672 true negatives; 345 false negatives. (\"positive\" indicates that the tick-box was checked; \"negative\" indicates that it was not checked; \"true\" indicates agreement between the tick-box and the ICD code). Using the counts provided above, complete the 2x2 table below: (4 pts)","type":"Calculation","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"ICD Classification (Reference)"},{"label":"B","text":"Death Certificate (new test)"},{"label":"C","text":"Work-related"},{"label":"D","text":"Not work-related"},{"label":"E","text":"Work-related"},{"label":"F","text":"Not work-related"}],"priority":2,"status":"review","flags":["topic_generic","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["duplicate_option_text","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-2a1877799776","stem":"Normal Distribution","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"Symmetrical about the mean"},{"label":"B","text":"Bell shaped"},{"label":"C","text":"Continuous"},{"label":"D","text":"All A, B and C are correct"}],"priority":2,"status":"practice