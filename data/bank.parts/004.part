Answer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7971428f98ee","stem":"people infected?","type":"Short Answer","subject":"Community Health and Public Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b7bcb1e79735","stem":"People negative tuberculosis? TRUE","type":"Short Answer","subject":"Internal Medicine","topic":"Respiratory Medicine","topicOriginal":"Respiratory Medicine","subtopic":"Tuberculosis","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Respiratory Medicine","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-23d41e84a7e2","stem":"curable? and FALSE","type":"Short Answer","subject":"Community Health and Public Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9227293d2ab1","stem":"<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"no\"?>","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"<ds:datastoreItem ds:itemID=\"{3F00D7D0-048A-47F6-B83A-20409B4881EF}\" xmlns:ds=\"http://schemas.openxmlformats.org/officeDocument/2006/customXml\"><ds:schemaRefs><ds:schemaRef ds:uri=\"http://schemas.openxmlformats.org/officeDocument/2006/bibliography\"/><\/ds:schemaRefs><\/ds:datastoreItem>"},{"label":"B","text":"Microsoft Office Word 97-2003 Document"},{"label":"C","text":"MSWordDoc"},{"label":"D","text":"Word.Document.8"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"d33ae42eb5fb87296742a93c0cf6b817f4bfbea4"},{"id":"q-72106c791631","stem":"When signing, ratifying, accepting, approving or acceding to the Convention or at any time thereafter, a Party may, by means of a binding written declaration, indicate its commitment to prohibit the introduction of tobacco vending machines within its jurisdiction or, as appropriate, to a total ban on tobacco vending machines. The declaration made pursuant to this Article shall be circulated by the Depositary to all Parties to the Convention.","type":"Short Answer","subject":"Community Health and Public Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b8ba58526b88","stem":"When ratifying, accepting, approving, formally confirming or acceding to the Convention, or at any time thereafter, a State or regional economic integration organization may declare in writing to the Depositary that, for a dispute not resolved in accordance with paragraph 1 of this Article, it accepts, as compulsory, ad hoc arbitration in accordance with procedures to be adopted by consensus by the Conference of the Parties.","type":"Short Answer","subject":"Community Health and Public Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-38d8e4ee52b4","stem":"which states that the enjoyment of the highest attainable standard of health is one of the","type":"Short Answer","subject":"Community Health and Public Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1256e05254a0","stem":"which is relevant to this Convention, and in so doing shall take into account and address the","type":"Short Answer","subject":"Community Health and Public Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1a907c6fc529","stem":"which was presented by the Director-General to the Ninety-seventh Session of the WHO","type":"Short Answer","subject":"Community Health and Public Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2af31ec49308","stem":"Evidence of tuberculosis (TB) has been found in archeological digs dating back","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Respiratory Medicine","topicOriginal":"Respiratory Medicine","subtopic":"Tuberculosis","suggestedTopic":null,"options":[{"label":"A","text":"6,500 years."},{"label":"B","text":"5,500 years."},{"label":"C","text":"4,500 years."},{"label":"D","text":"3,500 years. HISTORICAL BACKGROUND Evidence of TB dating back 6,500 years has been found in archaeologic digs. There are signs of the organism in the remains of mummified Egyptians and mention of it in ancient Chinese and Sanskrit written records. Hippocrates made the first clinically detailed description between 460 and 375 B.C.E. He called the disease \"phthisis.\" During the 16th to the 19th centuries, TB was epidemic in Europe, causing the death of as many as one in four persons. Click to Review"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Respiratory Medicine","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"6c225f4670798e171234550e68360ce88347a56b"},{"id":"q-85fabc808738","stem":"What country was the last in the world without TB infection?","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Respiratory Medicine","topicOriginal":"Respiratory Medicine","subtopic":"Tuberculosis","suggestedTopic":null,"options":[{"label":"A","text":"Russia"},{"label":"B","text":"China"},{"label":"C","text":"United States"},{"label":"D","text":"New Guinea HISTORICAL BACKGROUND Starting in Northern Europe more than 500 years ago, the disease spread steadily across the continent but did not move into Russia until the late 1800s. New Guinea, the last place left uninfected, developed TB for the first time in the 1940s. Click to Review "}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Respiratory Medicine","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"1015bd3725ab0fdd37315b86be8d7974b27a9e8c"},{"id":"q-b169f851f29f","stem":"Within the body, TB organisms","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Respiratory Medicine","topicOriginal":"Respiratory Medicine","subtopic":"Tuberculosis","suggestedTopic":null,"options":[{"label":"A","text":"are engulfed and killed by macrophages."},{"label":"B","text":"reside indefinitely in an active stage in the body."},{"label":"C","text":"are walled off by macrophages in encapsulated granulomas called tubercles."},{"label":"D","text":"replicate and gain access to lymphatic channels through the blood stream. PATHOGENESIS, TRANSMISSION, AND RISK FACTORS Inhaled droplet nuclei containing tuberculous bacilli accumulate in the alveoli of the middle or lower lobes of the lung. They replicate and gain access to regional lymphatic channels, mediastinal lymph nodes, and thence to the thoracic duct and bloodstream, by which they are disseminated throughout the body. In response, the immune system targets these scattered vascular foci of infection, first with macrophages that surround and engulf the organisms, then lymphocytes, and finally a characteristic, focal inflammatory reaction termed a granuloma. A healthy granulomatous reaction terminates active infection, usually before the person is symptomatic, though it does not eliminate all bacilli. In time, the granuloma becomes encapsulated, effectively sealing off any remaining viable organisms. Encapsulated granulomas are termed tubercles. With age, they usually calcify, and larger ones are visible later by chest x-ray and tissue scans. Most healthy persons remain asymptomatic throughout life, the only evidence of prior infection being the calcified granuloma or positive skin test. Click to Review"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Respiratory Medicine","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"7a48a90f31276d251ddb6085337326234cfec65e"},{"id":"q-53793267da98","stem":"The average time of exposure to someone with active TB until acquisition of infection is about","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Respiratory Medicine","topicOriginal":"Respiratory Medicine","subtopic":"Tuberculosis","suggestedTopic":null,"options":[{"label":"A","text":"two hours."},{"label":"B","text":"two days."},{"label":"C","text":"two weeks"},{"label":"D","text":"two months. PATHOGENESIS, TRANSMISSION, AND RISK FACTORS However, compared with other infectious diseases, TB is not easy to contract. The average time of exposure until acquired infection is about two months. There have been reports of infection occurring in much less time. In one well-reported incident, a passenger on an airline was very ill with TB and coughed throughout the entire flight. Later, it was learned that fellow passengers on the plane had become infected with TB [7]. This is a rare occurrence, but it serves as a reminder to those in the healthcare professions. Caring for patients with TB can be a health risk, and proper isolation techniques for prevention must be employed when working with known or suspected cases of active infection [7]. Click to Review"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Respiratory Medicine","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"6742d82a6a8b3088b3ef439041b29dc249f8c932"},{"id":"q-86d6df3edee0","stem":"During the asymptomatic phase, the only evidence of infection with TB may be","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Respiratory Medicine","topicOriginal":"Respiratory Medicine","subtopic":"Tuberculosis","suggestedTopic":null,"options":[{"label":"A","text":"dry cough and fever."},{"label":"B","text":"chest pain and dyspnea. "},{"label":"C","text":"cervical node enlargement."},{"label":"D","text":"skin-test reactivity to tuberculin. STAGES AND TYPES OF TUBERCULOSIS If the immune process works well and stops the proliferation of bacilli after the initial primary infection, healing occurs in the lungs, in the lymph nodes, and in the metastatic sites of infection. Depending upon the patient's age and presence of other infections, a latent period ensues. This period lasts a lifetime in 85% to 90% of those infected. During this asymptomatic phase, the only evidence of infection with M. tuberculosis may be skin-test reactivity to tuberculin [22]. Some patients will have fine, linear scarring in the lung or a focal calcification (Ghon lesion) visible usually in a middle or lower lobe, a sign of the struggle between M. tuberculosis and the cellular immune response. Click to Review"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Respiratory Medicine","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"57446bb5fb8c9f3eb99334e50c9bee36248db3da"},{"id":"q-bdae9f6f68e0","stem":"Recurrence of TB occurs in what percentage of those with latent TB infection?","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Respiratory Medicine","topicOriginal":"Respiratory Medicine","subtopic":"Tuberculosis","suggestedTopic":null,"options":[{"label":"A","text":"1% to 2%"},{"label":"B","text":"10% to 15%"},{"label":"C","text":"25% to 30%"},{"label":"D","text":"80% to 90% STAGES AND TYPES OF TUBERCULOSIS It is estimated that 10 to 15 million persons in the United States are infected with the latent or asymptomatic form of TB [13,57]. Recurrence of the active disease occurs in 10% to 15% of infected patients, half of whom reactivate within the first two years after the primary infection. The cause for the reactivation is usually a breakdown in the patient's immune system rather than reinfection from newly inhaled bacteria. In the United States, the highest frequency of recurrent or reactivation TB is in middle-aged and older adults and immigrants [3]. Click to Review"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Respiratory Medicine","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"6fdf15dfcd21d08075c4e33f4033317e684b456c"},{"id":"q-0c40a553a44e","stem":"The usual cause for secondary or reactivation TB is a breakdown of the patient's","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Respiratory Medicine","topicOriginal":"Respiratory Medicine","subtopic":"Tuberculosis","suggestedTopic":null,"options":[{"label":"A","text":"immune system."},{"label":"B","text":"digestive system."},{"label":"C","text":"circulatory system."},{"label":"D","text":"integumentary system STAGES AND TYPES OF TUBERCULOSIS It is estimated that 10 to 15 million persons in the United States are infected with the latent or asymptomatic form of TB [13,57]. Recurrence of the active disease occurs in 10% to 15% of infected patients, half of whom reactivate within the first two years after the primary infection. The cause for the reactivation is usually a  breakdown in the patient's immune system rather than reinfection from newly inhaled bacteria. In the United States, the highest frequency of recurrent or reactivation TB is in middle-aged and older adults and immigrants [3]. Click to Review"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Respiratory Medicine","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"3b0abecfa2c5f9c929fc99f33a84fd54a3b3d90d"},{"id":"q-6cc32fbc50a9","stem":"The most common early symptoms of pulmonary TB are","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"dry cough."},{"label":"B","text":"rales and rhonchi."},{"label":"C","text":"chest pain upon inspiration."},{"label":"D","text":"productive cough, malaise, and weight loss. PULMONARY TUBERCULOSIS The early symptoms of active pulmonary TB are often so subtle as to be missed at first by most patients. Because of this, they will frequently have difficulty pinpointing exactly when their illness began. Some patients without obvious symptoms are diagnosed solely by a routine chest x-ray. For those who do have symptoms, the most common manifestations are gradual onset and progression of fever, malaise, cough, anorexia, and weight loss. The fever is one that is not so high as to be noticed or to be disquieting. When the fever breaks during the early morning hours, it is often associated with \"night sweats.\" Weight loss may result from the infectious process itself, or it can be a sign that malnutrition and depletion of immune reserves preceded, and to some extent caused, the infection. Click to Review"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"d7075026b151788f2b6addd018ee1596c1f8e9ad"},{"id":"q-3b77cb637ef1","stem":"Groups considered high risk for contracting TB who should be screened include HIV- infected persons, injecting drug users, and","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"all hospital workers."},{"label":"B","text":"emergency medical personnel."},{"label":"C","text":"persons with healthy immune systems."},{"label":"D","text":"residents in areas with severe air pollution. PULMONARY TUBERCULOSIS HIGH-RISK GROUPS TO SCREEN FOR TUBERCULOSIS  HIV-infected persons Close contacts of persons with active, infectious TB Persons with conditions that weaken their immunity, thereby putting them at greater risk for contracting the disease (includes chronic renal failure, diabetes, prolonged steroid use, immunosuppressive therapy, malnutrition, gastrectomy) Injecting drug users Residents and employees of long-term care facilities, prisons, mental institutions, homeless shelters, or other group homes Emergency medical personnel Firefighters Persons spending time in countries with a high prevalence of TB Foreign-born persons originating from countries with a high prevalence of TB Source: Compiled by Author Table 1 Click to Review"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"291981eb01216d661e785286041214b66a68bda3"},{"id":"q-37f6d175945e","stem":"Foreign-born persons originating from countries with high TB prevalence should be","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Prevalence","suggestedTopic":null,"options":[{"label":"A","text":"quarantined."},{"label":"B","text":"administered BCG vaccine."},{"label":"C","text":"screened for possible TB infection."},{"label":"D","text":"started on chemoprophylaxis as soon as possible. PULMONARY TUBERCULOSIS HIGH-RISK GROUPS TO SCREEN FOR TUBERCULOSIS HIV-infected persons Close contacts of persons with active, infectious TB Persons with conditions that weaken their immunity, thereby putting them at greater risk for contracting the disease (includes chronic renal failure, diabetes, prolonged steroid use, immunosuppressive therapy, malnutrition, gastrectomy) Injecting drug users Residents and employees of long-term care facilities, prisons, mental institutions, homeless shelters, or other group homes Emergency medical personnel Firefighters Persons spending time in countries with a high prevalence of TB Foreign-born persons originating from countries with a high prevalence of TB  Source: Compiled by Author Table 1 Click to Review"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"f223eed27c8b78f64090ba2add8dc1b3dc1e3b0b"},{"id":"q-f753f3e65172","stem":"A negative reaction to a tuberculin skin test","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Respiratory Medicine","topicOriginal":"Respiratory Medicine","subtopic":"Tuberculosis","suggestedTopic":null,"options":[{"label":"A","text":"is <5 mm in diameter."},{"label":"B","text":"is often a misread conversion."},{"label":"C","text":"indicates a strong immune system."},{"label":"D","text":"rules out TB as the source of infection. PULMONARY TUBERCULOSIS TUBERCULIN SKIN TEST When applying a skin test using the Mantoux technique, the injection should be made with a single-use, disposable tuberculin syringe. Draw up 0.1 mL of PPD, containing 5 tuberculin units (TU). The skin should be cleansed, as with any injection, and the skin stretched taut. Using a 26- or 27-gauge needle, the tuberculin syringe should be held close to the skin so the needle hub touches it as the needle is inserted into the skin, with the bevel up. This decreases the needle angle at the skin surface and helps to ensure the fluid is injected just beneath the surface of the skin into the dermis to form a wheal, taking care not to inject subcutaneously. The site of the injection should be circled with a pen and the location documented on the patient's medical record (in case the pen circle should wash off). Examine the site of the Mantoux intradermal injection within 48 to 72 hours of injection. Always use sufficient lighting to examine the area. Use a pen to outline the diameter of induration (firm-to-hard zone of elevation or swelling). The area of erythema (redness) is not measured, and erythema without induration is of no significance. Use a standard centimeter rule or a clear plastic ruler that has been marked with circles of various diameters. Place the ruler over the outlined induration to measure its diameter. The presence and degree of induration is an indicator of prior TB infection and, to some extent, the probability of current active TB. A reaction of <5 mm is negative. Reactions Source: Compiled by Author Table 2 Click to Review"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Respiratory Medicine","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"d8329f897d18e166a1f16ada7000c2aceb0db111"},{"id":"q-b0abbba4b879","stem":"When teaching a patient to produce a sputum specimen, instruct him or her to","type":"Single Best Answer MCQ","subject":"Medical Laboratory Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"drink a large glass of water before coughing."},{"label":"B","text":"collect the specimen just before going to sleep at night."},{"label":"C","text":"cough gently and expectorate into the sputum container. "},{"label":"D","text":"bring the specimen up from their lungs (not throat) after a deep cough. PULMONARY TUBERCULOSIS The optimal time to collect a specimen is early morning, after the patient has had nothing by mouth for about eight hours. The mouth should be rinsed with water to reduce contamination of the sample with the normal flora of the mouth, but the teeth should not be brushed prior to the collection. Patients are provided a sterile container with a screw-top lid. They should avoid putting the rim of the jar inside their lips, but rather hold it below their bottom lip. Specimens should not be saliva or nasopharyngeal secretions, but should come from the lungs after a deep cough. A sample of 5–10 cc (1–2 teaspoons) of sputum is adequate. Patients should be instructed to notify the practitioner as soon as the sample has been obtained so it can be sent to the laboratory promptly. Click to Review"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Laboratory Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"2bef5cf075bce7cf2bea7ae130f54bf2b00bda75"},{"id":"q-e9011e247932","stem":"Nucleic acid amplification (NAA) tests for the diagnosis of TB","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Respiratory Medicine","topicOriginal":"Respiratory Medicine","subtopic":"Tuberculosis","suggestedTopic":null,"options":[{"label":"A","text":"are not approved by the FDA."},{"label":"B","text":"require more than one month for results."},{"label":"C","text":"may not be used with smear-positive specimens."},{"label":"D","text":"are able to differentiate between different species of M. tuberculosis. PULMONARY TUBERCULOSIS The U.S. Food and Drug Administration (FDA) has approved three commercially available nucleic acid amplification (NAA) tests for use in confirming M. tuberculosis in procured specimens. The first is the Amplicor Test, which is based on the polymerase chain reaction. It amplifies a specific portion of the RNA from the TB organisms and measures the results with a photometer. The findings of this test are usually available within six to seven hours. The FDA has approved the Amplicor Test only for smear-positive specimens [26,46]. The second approved probe is the amplified M. tuberculosis direct (Amplified MTD) test, which uses transcription-mediated amplification in order to identify and magnify the RNA target. Results are generally available within three to four hours. This test is approved for the detection of tuberculosis in both smear- positive and smear-negative cultures [26]. The third NAA test is the Xpert MTB/RIF Assay, which is able to detect the presence of M. tuberculosis organisms as well as resistance to rifampin [55]. This automated, cartridge-based system requires a sputum sample and results are available within two hours. Non-FDA approved NAA tests (often called \"in-house\" tests) may be used to diagnose TB and to test for drug-resistant TB [46,58]. These tests are also able to differentiate the DNA of different species of M. tuberculosis, also called DNA fingerprinting or genotyping. Because most strains of bacteria share patterns, it has been difficult to follow the person-to-person transmission of certain strains. Using genotyping, researchers have shown that each strain has a distinct DNA fingerprint and that all samples sharing the same DNA fingerprint were isolated from people who live together. This will help track the path of transmission and aid public health researchers to pinpoint patterns of infection, which in turn helps to plan prevention programs that target the areas of heightened infection rates.  Click to Review"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Respiratory Medicine","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization","whitespace/page_marker_normalization"],"duplicateStemGroup":"6dcfcbcc1f1fabefa141cd7a4b28ad6c6417c495"},{"id":"q-335d8c3cd996","stem":"The most common site for extrapulmonary TB is the","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Respiratory Medicine","topicOriginal":"Respiratory Medicine","subtopic":"Tuberculosis","suggestedTopic":null,"options":[{"label":"A","text":"liver."},{"label":"B","text":"skin."},{"label":"C","text":"kidney."},{"label":"D","text":"adrenal gland. EXTRAPULMONARY TUBERCULOSIS The kidney is the most common site for extrapulmonary TB. From there, the bacilli spread to the bladder and, in men, to the prostate, seminal vesicles, and epididymis. Often, the first sign of the infection is an enlarging scrotal mass. Pyelography will then often reveal a cavitary lesion of the renal parenchyma and irregularities of the ureters. Diagnosis is easily confirmed by urine smear and culture. Click to Review"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Respiratory Medicine","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"abfd59f9d0c2b480d0d1fb9c6d9dff5bb343db4e"},{"id":"q-4d9793b477ff","stem":"Miliary tuberculosis refers to an infection affecting the","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Respiratory Medicine","topicOriginal":"Respiratory Medicine","subtopic":"Tuberculosis","suggestedTopic":null,"options":[{"label":"A","text":"skin."},{"label":"B","text":"testes."},{"label":"C","text":"GI tract."},{"label":"D","text":"entire body. EXTRAPULMONARY TUBERCULOSIS Under conditions of poor immune function or trauma, previously quiescent TB foci may destabilize, releasing viable bacilli into the bloodstream. Unchecked, this leads to a sustained, active systemic infection with small metastatic lesions throughout the body. Although not immediately evident on chest x-ray, eventually the films will show multitudes of small nodules spread throughout both lungs, having the appearance of millet seeds. Prominent symptoms include chronic fever, night sweats, weakness, malaise, weight loss, and dyspnea. Bone marrow and liver biopsies are often taken to complete the diagnosis. Click to Review"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Respiratory Medicine","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"ed63c8f4b415f5471df28432d7d5c4b3991683b5"},{"id":"q-02347c085105","stem":"Two first-line drugs used in the treatment of drug-susceptible TB include","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"isoniazid and rifampin."},{"label":"B","text":"rifabutin and streptomycin."},{"label":"C","text":"rifapentine and capreomycin."},{"label":"D","text":"ethionamide and ethambutol.  TREATMENT TREATMENT OF DRUG-SUSCEPTIBLE TUBERCULOSIS IN ADULTS Drug Daily Dose (Adult) Adverse/Toxic Reactions First-Line Drugs Hepatotoxicity, hepatitis, peripheral Isoniazid 5 mg/kg PO/IM (up to 300 mg) neuropathy, hypersensitivity, flu-like symptoms Orange discoloration of urine and other Rifampin 10 mg/kg PO/IV (up to 600 mg) secretions, nausea, vomiting, hepatitis, hepatotoxicity, fever, purpura Rash, GI disturbance, neutropenia Not Rifabutin 5 mg/kg PO (up to 300 mg) approved by FDA for treatment of TB Red-orange stain on body fluids, Rifapentine 10–20 mg/kg hyperuricemia, abnormal liver function tests 800 mg PO (40–55 kg), 1,200 mg PO Optic neuritis, decreased visual acuity, color Ethambutol (56–75 kg), or 1,600 mg PO (76–90 blindness, skin rash kg) 1,000 mg PO (40–55 kg), 1,500 mg Hepatotoxicity, hyperuricemia, skin rash, Pyrazinamide PO (56–75 kg), or 2,000 mg PO (76– arthralgias, GI irritation 90 kg) Second-Line Drugs Streptomycin 15 mg/kg IM/IV Ototoxicity, nephrotoxicity, hypokalemia 15–20 mg/kg PO (usually 250–500 GI disturbance, hepatotoxicity, depression, Ethionamide mg once or twice daily) drowsiness, hypothyroidism, metallic taste Para-aminosalicylic 8–12 g PO (typically 4,000 mg in two GI disturbance, sodium load, hepatotoxicity acid to three divided doses) 15 mg/kg IM/IV (up to 1 g) or 15 mg/kg Auditory and renal toxicity, hypokalemia, Amikacin/kanamycin dose three times per week for vestibular toxicity Not approved by FDA for decreased renal function treatment of TB Psychosis, personality changes, rash, 10–15 mg/kg PO (usually 250–500 Cycloserine impaired coordination, convulsions, mg once or twice daily) depression Auditory and renal toxicity, vestibular Capreomycin 15 mg/kg IM/IV toxicity, hypokalemia Nausea, diarrhea Moxifloxacin 400 mg daily PO/IV Not approved by FDA for treatment of TB Source: [30,32,34,42] Table 3  Click to Review"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","whitespace/page_marker_normalization"],"duplicateStemGroup":"014aad6528424ad2eb857a631247262039b7fa72"},{"id":"q-e44555789bd9","stem":"Chemoprophylaxis is recommended for all of the following groups of people with a positive tuberculin test of 6 mm, EXCEPT","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Respiratory Medicine","topicOriginal":"Respiratory Medicine","subtopic":"Tuberculosis","suggestedTopic":null,"options":[{"label":"A","text":"Children older than 4 years of age"},{"label":"B","text":"Persons with known or suspected HIV infection"},{"label":"C","text":"Close contacts of persons with infectious, clinically active TB"},{"label":"D","text":"Persons who inject drugs and who are known to be HIV negative CHEMOPROPHYLAXIS FOR TUBERCULOSIS Preventive therapy is recommended for the following persons, regardless of age, with a positive tuberculin test result of 5 mm or greater: Persons with HIV infection* Close contacts of a TB case* Patients who have had organ transplants and other immunosuppressed patients (receiving the equivalent of ≥15 mg/day of prednisone for at least one month) Persons with fibrotic changes on chest radiograph consistent with old TB disease Persons receiving specialized treatment for rheumatoid arthritis or Crohn disease Persons in the following groups should be considered for preventive therapy if their reaction to the tuberculin test is 10 mm or greater: Recent arrivals to the United States (within the last five years) from high- prevalence countries Persons who inject illicit drugs Residents and employees of high-risk congregate settings Mycobacteriology laboratory personnel Persons with medical conditions that make them high risk (i.e., diabetes, silicosis, cancer of the head and neck, end-stage renal disease, intestinal bypass or gastrectomy, chronic malabsorption syndromes) Children younger than 4 years of age, or children and adolescents exposed to adults in high-risk categories Click to Review"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Respiratory Medicine","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"350930b4be68f8ea18f9be827c284c83e547d718"},{"id":"q-fe18f148607c","stem":"Bacille Calmette-Guérin (BCG) vaccine","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Respiratory Medicine","topicOriginal":"Respiratory Medicine","subtopic":"Tuberculosis","suggestedTopic":null,"options":[{"label":"A","text":"is used regularly in the United States."},{"label":"B","text":"does not have any effect on the tuberculin skin test."},{"label":"C","text":"is one of the most widely used vaccines in the world."},{"label":"D","text":"is internationally regulated to ensure that only one strain is used. CHEMOPROPHYLAXIS FOR TUBERCULOSIS Although not recommended or routinely used in the United States, many other countries, particularly developing countries with limited financial resources, have used the BCG vaccine to control TB [20]. The WHO  estimates that more than 1 billion people have received BCG, making it one of the most widely used vaccines in the world. Studies have shown BCG to have variable efficacy against all TB strains. Analysis of these studies is difficult due to the fact that several different strains of the vaccine are used worldwide. There are serious concerns about its use in immunocompromised patients [20]. Generally, the vaccine is given to infants and children who have (1) a negative tuberculin skin test; (2) are at high risk of continuing exposure to persons with infectious TB; (3) cannot be placed on long-term preventive therapy; or (4) are continually exposed to persons with INH- or rifampin-resistant disease. As BCG is a live, attenuated vaccine, administration will cause a person to convert from a negative TB skin test to a positive one, requiring any subsequent skin testing to be confirmed by blood test. Click to Review"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Respiratory Medicine","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"c1d3a5c980466dd8514d17ee7bac233bd829fc1a"},{"id":"q-a39b78d52841","stem":"Prophylactic treatment for children of patients infected with TB is","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Respiratory Medicine","topicOriginal":"Respiratory Medicine","subtopic":"Tuberculosis","suggestedTopic":null,"options":[{"label":"A","text":"contraindicated."},{"label":"B","text":"highly recommended."},{"label":"C","text":"usually recommended only if the child is HIV positive."},{"label":"D","text":"recommended only if close monitoring of liver function is done. CHILDREN AND TB Prophylactic treatment for children of patients with TB is highly recommended. The treatment regimens most effective for children are limited, compared with those used for adult patients with TB. However, the once- weekly, three-month regimen of isoniazid-rifapentine is now approved for use in children 2 to 17 years of age, thereby permitting a relatively brief and more manageable course of antituberculous prophylaxis [65]. Nine- month treatment with INH alone has proved to be successful in most children and is also recommended [52]. Children taking INH do not seem to develop the transient elevation of liver enzymes seen in adults, so liver function does not have to be monitored unless the patient has a history of other liver disease. When INH is not tolerated, the American Academy of Pediatrics recommends six months of daily rifabutin at a dosage of 10–20 mg/kg [52]. As noted, ethambutol is usually avoided in children younger than 7 years of age because it is difficult to properly monitor visual acuity and color perception in children that young. It is rare for children to develop drug-induced hepatitis, so monthly follow-ups do not include liver function studies, as in adults. Good indicators of improvement are increased appetite, weight gain, and lower evening temperatures. Click to Review"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Respiratory Medicine","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"d16c435140b86faae43b66b763ab9bdb93894082"},{"id":"q-3601c875b3c1","stem":"It is important for the healthcare professional to explain to the patient with TB and his/her caregiver","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Respiratory Medicine","topicOriginal":"Respiratory Medicine","subtopic":"Tuberculosis","suggestedTopic":null,"options":[{"label":"A","text":"the signs and symptoms of drug toxicity."},{"label":"B","text":"instructions outlining which medications to take and how often."},{"label":"C","text":"information about where financial assistance and free medications can be found in the community."},{"label":"D","text":"All of the above  CARE OF THE PATIENT WITH TB It is important for healthcare professionals to give both the patient and the caregiver explicit verbal and written instructions outlining which medications should be taken and how often. Some even make a poster with sample tablets glued to it, so the patient has a constant visual reminder of what needs to be taken. These instructions should also include the name and telephone number of a physician or nurse to call if questions arise. Patients and caregivers should be taught the signs and symptoms of drug toxicity and side effects, such as those with rifampin, which causes feces, saliva, tears, and urine to be a red-orange color. It is important to strongly reinforce that they must not stop taking the medications without permission. Some patients may have financial hardships as a result of paying for the continuing prescriptions, but not all will feel comfortable mentioning that fact. Depending upon the type of insurance coverage the patient has, the"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Respiratory Medicine","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"b32b20f4f02d5b75e4f6fe60bc3110bd81c36cac"},{"id":"q-f199c53c69d2","stem":"where they can obtain financial assistance or free medications in the community.","type":"Short Answer","subject":"Community Health and Public Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-ab5d604ff91f","stem":"How do you get TB?","type":"Short Answer","subject":"Community Health and Public Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c9a162b3e0fc","stem":"Who is at risk of developing tuberculosis in this country?","type":"Short Answer","subject":"Internal Medicine","topic":"Respiratory Medicine","topicOriginal":"Respiratory Medicine","subtopic":"Tuberculosis","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Respiratory Medicine","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-9cb0eb917641","stem":"What makes TB hard to diagnose?","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b4d0eb3d92c7","stem":"What are the symptoms of active TB?","type":"Short Answer","subject":"Community Health and Public Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-04bb564e34d0","stem":"How is TB diagnosed?","type":"Radiological Interpretation","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":true,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-24af37defb94","stem":"How is TB treated?","type":"Short Answer","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antiviral","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-cd5b57ff82c0","stem":"What is causing TB to become a serious public health problem?","type":"Short Answer","subject":"Community Health and Public Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-41d29a922246","stem":"Who in the Tanzania should receive a vaccine for TB?","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4a89f88f7056","stem":"What to do??","type":"Short Answer","subject":"Community Health and Public Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["short_or_incomplete_stem","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["short_or_incomplete_stem","short_stem","topic_generic"],"cleaningOperations":[]},{"id":"q-548c420a2aa3","stem":"How do these factors cause CVD?","type":"Short Answer","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1bf77ee5e338","stem":"What knowledge constitutes a sufficient basis for public health action?","type":"Short Answer","subject":"Community Health and Public Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-fa0590aced28","stem":"What is different now from those early transient efforts? What new","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b94ef2852c16","stem":"Situation Report – 162 World Health deaths and stillbirths. Further research urgently Organization; 2020. Available from: needed to understand the reasons for increased https://www.who.int/docs/default- adolescent maternal mortality, reduced uptake of source/coronaviruse/20200630-covid-19-sitrep- long-term FP methods, and increased still birth 162.pdf?","type":"Short Answer","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["url_or_navigation_embedded"],"cleaningOperations":[]},{"id":"q-eea2858a48a6","stem":"Euronews. Coronavirus second wave? Which countries inrate. This will be critical to developing policies Europe are experiencing a resurgence of cases? and interventions to prevent additional maternal 2020. Available from: deaths during this pandemic and in future https://www.euronews.com/2020/08/27/is-europe- infectious disease outbreaks. having-a-covid-19-second-wave-country-by- country-breakdown. Acknowledgement 4. DW. Coronavirus pandemic: Is the second wave already here? 2020. Available from: This paper has been developed under t