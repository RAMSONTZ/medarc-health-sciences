s supply the abdominal wall"},{"label":"E","text":"all intercostal arteries are branches of the descending thoracic aorta"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-24ee7882f370","stem":"The azygous vein","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Thorax","suggestedTopic":null,"options":[{"label":"A","text":"has an avascular fibrous cord in the abdomen"},{"label":"B","text":"begins as the union of ascending lumbar vein with the subcostal vein on the left side"},{"label":"C","text":"arches over the right pulmonary artery"},{"label":"D","text":"receives veins from the upper third of the oesophagus"},{"label":"E","text":"usually enters the brachiocephalic vein"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"b5abd685f94e11caa0c5dc6d963285447578d3de"},{"id":"q-90ddb5156dac","stem":"Which doesn’t drain into the cardiac sinus?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"great cardiac vein"},{"label":"B","text":"anterior cardiac vein"},{"label":"C","text":"small cardiac vein"},{"label":"D","text":"oblique vein of the left atrium"},{"label":"E","text":"posterior vein of the left ventricle"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"a480c4aeae9bafd8d3e0adb153b154bb5556c53c"},{"id":"q-c3010af7595b","stem":"The cardiac plexus","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"has a larger superficial part and a smaller deep part"},{"label":"B","text":"is made up of sympathetic and parasympathetic fibres only"},{"label":"C","text":"receives fibres from the left vagus nerve and left cervical sympathetic ganglion only into the superficial part"},{"label":"D","text":"the deep part lies to the left of the ligamentum arteriosum"},{"label":"E","text":"has preganglionic sympathetic fibres"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-5070d3c37efe","stem":"Regarding the pericardium","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","