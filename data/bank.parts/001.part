A","text":"primary structure"},{"label":"B","text":"secondary structure"},{"label":"C","text":"tertiary structure"},{"label":"D","text":"quaternary structure"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Water, pH and Buffers","answerAuditStatus":"independently_reasoned_provisional_oct20","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-89ae6987c840","stem":"Which one of the following structure represents a saturated organic compound? O ǁ","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"CH3CH2 C─OH"},{"label":"B","text":"CH3CH2OH"},{"label":"C","text":"CH3CHCHCH3"},{"label":"D","text":"CH ... CH"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"]},{"id":"q-d67c064818d3","stem":"Which statement below is correct?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"dendrites are produced by dendrocytes"},{"label":"B","text":"glycolipids are produced by lipocytes"},{"label":"C","text":"keratin is produced by keratinocytes"},{"label":"D","text":"melanin is produced by merkel cells"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"7418c3ce05d8540725d6dacd95c1e96e352af87b"},{"id":"q-68c2e21513ac","stem":"Where are sebaceous glands found?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"In the digestive system"},{"label":"B","text":"In the hypodermis"},{"label":"C","text":"In the dermis"},{"label":"D","text":"In the stratum corneum"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-68491ccd0a87","stem":"When a medicine is delivered via a patch attached to the skin, it is said to be delivered","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Gastroenterology and Hepatology","topicOriginal":"Gastroenterology and Hepatology","subtopic":"Liver","suggestedTopic":null,"options":[{"label":"A","text":"transdermally"},{"label":"B","text":"subcutaneously"},{"label":"C","text":"topically"},{"label":"D","text":"intramuscularly"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Gastroenterology and Hepatology","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[],"manualEdits":{"sourceStem":"When a medicine is delivered via a patch attached to the skin, it is said to be delivered","sourceOptions":[{"label":"A","text":"transdermally"},{"label":"B","text":"subcutaneously"},{"label":"C","text":"topically"},{"label":"D","text":"intramuscularly Answer is A: Some medicines can be absorbed through the skin to enter the bloodstream. Choice C applies to ointments that act on the skin hey are applied to. Choices B & D are delivered by a penetrating injection to locations deep to the skin."}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-56a039629d37","stem":"Full thickness burns to more than 20 % of the skin surface is a life-threatening situation. Why is this?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Trauma and Emergency Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Trauma and Emergency Surgery","options":[{"label":"A","text":"The synthesis of vitamin D (calcitriol) is severely compromised."},{"label":"B","text":"The loss of skin sensation prevents access to environmental information."},{"label":"C","text":"The body is not able to prevent water loss from the burnt area."},{"label":"D","text":"Soft internal tissues are abraded by the external environment."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Trauma and Emergency Surgery · Suggested","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{"sourceStem":"Full thickness burns to more than 20 % of the skin surface is a life-threatening situation. Why is this?","sourceOptions":[{"label":"A","text":"The synthesis of vitamin D (calcitriol) is severely compromised."},{"label":"B","text":"The loss of skin sensation prevents access to environmental information."},{"label":"C","text":"The body is not able to prevent water loss from the burnt area."},{"label":"D","text":"Soft internal tissues are abraded by the external environment. Answer is C: The body is not able to prevent water loss from the exposed tis- sues. (Also, but not part of the provided choices, the loss of skin means that the body is unprotected from infectious agents)"}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-3b2eb97d353b","stem":"Which is a notable feature of the stratum corneum layer of the integument? It","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"is where melanocytes and keratinocytes are rapidly dividing."},{"label":"B","text":"is richly supplied with blood capillaries."},{"label":"C","text":"consists of keratin filled cells with glycolipid in between cells."},{"label":"D","text":"has protruding epidermal ridges that push the overlying epidermis into “fingerprints”."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"df0dacedb267cc0efe8e2fa69747db47a8e793ab"},{"id":"q-adc98ca15c2d","stem":"When a pharmaceutical is administered hypodermically, it is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"wiped onto the skin."},{"label":"B","text":"applied via a patch that adheres to the skin."},{"label":"C","text":"injected into the dermis. 5 Integument 107"},{"label":"D","text":"injected into subcutaneous fat."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"b7022086051a507763154ac5ded718ee6d294062","manualEdits":{"sourceStem":"When a pharmaceutical is administered hypodermically, it is","sourceOptions":[{"label":"A","text":"wiped onto the skin."},{"label":"B","text":"applied via a patch that adheres to the skin."},{"label":"C","text":"injected into the dermis. 5 Integument 107"},{"label":"D","text":"injected into subcutaneous fat. Answer is D: “Hypo” means below, in this case, the dermis. Subcutaneous fat (superficial fascia) lies beneath the dermis."}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-8e42b0d3c74f","stem":"Which of the following is NOT a sensory receptor of the skin?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"a Meissner corpuscle"},{"label":"B","text":"an apocrine gland"},{"label":"C","text":"a root hair plexus"},{"label":"D","text":"a nociceptor"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[],"manualEdits":{"sourceStem":"Which of the following is NOT a sensory receptor of the skin?","sourceOptions":[{"label":"A","text":"a Meissner corpuscle"},{"label":"B","text":"an apocrine gland"},{"label":"C","text":"a root hair plexus"},{"label":"D","text":"a nociceptor Answer is B: This is a type of sudiferous (sweat) gland."}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-dac0e1a9f947","stem":"What is the protein that fills the outermost dead cells of the epidermis?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"granstein"},{"label":"B","text":"dermin"},{"label":"C","text":"melanin"},{"label":"D","text":"keratin"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D","whitespace/page_marker_normalization"],"duplicateStemGroup":"36773ef6f1416527d4c35fc273568dc5ff80a14c"},{"id":"q-0eff363f36aa","stem":"What is the name given to the most superficial layer of the integument?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"stratum corneum"},{"label":"B","text":"papillary dermal layer"},{"label":"C","text":"stratum lucidum"},{"label":"D","text":"superficial fascia"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"pub