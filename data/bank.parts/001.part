":null,"options":[{"label":"A","text":"descending thoracic aorta"},{"label":"B","text":"thoracic duct"},{"label":"C","text":"phrenic nerves"},{"label":"D","text":"azygous vein"},{"label":"E","text":"lymph nodes"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"independent_checked","sourceAnswerTrusted":false,"publicationStatus":"checked_explained","auditFlags":[],"cleaningOperations":[],"duplicateStemGroup":"6d8aeffcf59c6585ccd43f8f8a6203cb7abb7a56"},{"id":"q-e7797f4fc073","stem":"Regarding the phrenic nerves","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Thorax","suggestedTopic":null,"options":[{"label":"A","text":"pass behind anterior scalene muscle"},{"label":"B","text":"the right nerve pierces the muscular part of the diaphragm"},{"label":"C","text":"they are always in contact with pleura laterally"},{"label":"D","text":"run in mediastinum behind the lung root"},{"label":"E","text":"split into four main branches – anterior, posterior, medial and lateral"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-db3339437f5c","stem":"The vagus nerve","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Thorax","suggestedTopic":null,"options":[{"label":"A","text":"the right vagus nerve is in contact with the trachea"},{"label":"B","text":"passes in front of the lung root"},{"label":"C","text":"the right recurrent laryngeal branch hooks around the right subclavian artery"},{"label":"D","text":"passes through the vena caval forearm"},{"