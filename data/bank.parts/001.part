opic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"e5976fd43d43000511a958c593fb8aefcf4fd6a3"},{"id":"q-4cbbbac7cf00","stem":"What are sensory neurons?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Unipolar"},{"label":"B","text":"Pseudounipolar"},{"label":"C","text":"Bipolar"},{"label":"D","text":"Multipolar"},{"label":"E","text":"Both a and b Sensory neurons are unipolar. Unipolar neurons are sometimes also called pseudounipolar. Neurons can be classified based on the number of axons and dendrites stemming off of the cell body. A unipolar neuron has one process which branches off of it This process then immediately divides into two. Thus, a unipolar neuron is sometimes also called a pseudounipolar neuron. Sensory neurons are unipolar. A bipolar neuron has two process that branch from it: an axon and a dendrite. Bipolar neurons are not very common and are found in some of the organs for special senses. Bipolar neurons are found in the retina, inner ear, and the region of the nose involved with smell. Multipolar neurons have one axon and many (at least two) dendrites that branch off of it. Most neurons are multipolar. Motor neurons and interneurons are multipolar."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"5f62f429e2af2f7f3ac616d77a10a5a3b73b750d"},{"id":"q-0bf611ba3717","stem":"What is the end of an axon called?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ganglion"},{"label":"B","text":"Perikaryon"},{"label":"C","text":"Astrocyte"},{"label":"D","text":"Nissl"},{"label":"E","text":"Terminal bouton"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"bd32518accee4d7d007148be9f654cf10ff6ebbf"},{"id":"q-aa1d24ec34b1","stem":"What is the connective tissue covering around the brain and spinal cord?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Meninges"},{"label":"B","text":"Myelinated nerve fibers"},{"label":"C","text":"Cell bodies"},{"label":"D","text":"Nodes of Ranvier"},{"label":"E","text":"Neurofilaments"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"c5bfd48f8e41ab20ac25ea906f718280afaf1fc9"},{"id":"q-fc54f6b477a5","stem":"Which meninx is made of a dense irregular connective tissue?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":"Meninges","options":[{"label":"A","text":"Dura mater"},{"label":"B","text":"Arachnoid"},{"label":"C","text":"Pia mater"},{"label":"D","text":"Both a and b"},{"label":"E","text":"All of the above"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"independent_checked","sourceAnswerTrusted":false,"publicationStatus":"checked_explained","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"2c88f937222608d62a07e2026fe970b7d7e460f6"},{"id":"q-652125b66f0f","stem":"What is a group of fibers traveling together?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Tracts"},{"label":"B","text":"Islets"},{"label":"C","text":"Soma"},{"label":"D","text":"Cortex"},{"label":"E","text":"Nuclei"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"287cafe5d4973ed1b6a0bc460814c2ceca91493d"},{"id":"q-f35e762b7e25","stem":"Where is white matter?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Outer surface of the cerebrum and cerebellum"},{"label":"B","text":"Outer surface of the spinal cord"},{"label":"C","text":"Inner portion of the brain"},{"label":"D","text":"Both a and b"},{"label":"E","text":"Both b and c"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"96f90fe9703a1302fa19f81b98802d15d1b056f3"},{"id":"q-ce9698e500ec","stem":"Which of the following forms myelin in the central nervous system?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Astrocytes"},{"label":"B","text":"Ependymal cells"},{"label":"C","text":"Oligodendrocytes"},{"label":"D","text":"Microglia"},{"label":"E","text":"Schwann cells Neuroglia are the supporting cells of the central nervous system. Sometimes, neuroglia called glial cells or glia. Astrocytes, ependymal cells, oligodendrocytes, and microglia are all neuroglia. Of the neuroglia cells, astrocytes are the most abundant and the largest. These are star shaped cells involved in the blood brain barrier. Ependymal cells line the ventricles and spinal canal. Oligodendrocytes form myelin in the central nervous system. Microglia are the central nervous system macrophages. Schwann cells are seen in the peripheral nervous system and are not considered neuroglia. Schwann cells are responsible for the myelination of neurons in the peripheral nervous system."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"9b1fdea0dec0919181b7c8c97325570f6c0bef59"},{"id":"q-8ab28e0b39be","stem":"What is the primary component of myelin?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Amino acids"},{"label":"B","text":"Protein"},{"label":"C","text":"Carbohydrate"},{"label":"D","text":"Lipid"},{"label":"E","text":"Both b and c"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"8d0947baad434d70d7f07f8afd0c93a3e5071d6b"},{"id":"q-677497efc876","stem":"Which of the following is found in the cerebellum?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Schwann cells"},{"label":"B","text":"Basket cells"},{"label":"C","text":"Ganglion"},{"label":"D","text":"Neuroglia"},{"label":"E","text":"Satellite cells Schwann cells are responsible for the myelination of neurons in the peripheral nervous system. Basket cells are a type of neuron seen in the cerebellum. A ganglion is a collection of nerve cell bodies outside of the CNS. Neuroglia are the supporting cells in the central nervous system Sometimes, neuroglia called glial cells or glia. Satellite cells are found in the ganglia of the peripheral nervous system."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"349723f91a34b40b98a06c17d69fc8d6823d40ed"},{"id":"q-6fd8009b9af9","stem":"What are neurons in the retina?","type":"Single Best Answer MCQ","subject":"Ophthalmology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Unipolar"},{"label":"B","text":"Pseudounipolar"},{"label":"C","text":"Bipolar"},{"label":"D","text":"Multipolar"},{"label":"E","text":"Both a and b"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Ophthalmology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"3f9ee50af38635f77dcaf91e7b6fc69e83995906"},{"id":"q-30c7a65369de","stem":"What are the basophilic clusters of ribosomes and rough endoplasmic reticulum seen in neurons called?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ganglion"},{"label":"B","text":"Perikaryon"},{"label":"C","text":"Astrocyte"},{"label":"D","text":"Nissl"},{"label":"E","text":"Terminal bouton"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"138f4b25a514130fa1ad740ac536826ec003c962"},{"id":"q-465be6d6281a","stem":"All of the following are properties of neurons, except","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"High metabolic rate"},{"label":"B","text":"Longevity"},{"label":"C","text":"Specialized for conduction"},{"label":"D","text":"High mitotic rate"},{"label":"E","text":"Limited ability for oxygen deprivation Neurons do not divide; therefore they do not have a high mitotic rate. Neurons have a high metabolic rate. They are unable to survive long without oxygen. They have an extremely long longevity, lasting a lifetime. Neurons are specialize for conduction. They send signals via a nervous impulse."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"cd63eaa9e215df7f3060babbb7f9c814db198339"},{"id":"q-f27f5d68c9b4","stem":"Which type of neuron is also called an internuncial neuron?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Sensory neurons"},{"label":"B","text":"Motor neurons"},{"label":"C","text":"Interneurons"},{"label":"D","text":"Both a and b"},{"label":"E","text":"All of the above Interneurons are also called internuncial neurons."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"f76f6c742d9919f32a5375b06433f08f8ca51985"},{