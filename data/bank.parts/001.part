ions":[{"label":"A","text":"triglycerols"},{"label":"B","text":"polysaccharides"},{"label":"C","text":"complex carbohydrates"},{"label":"D","text":"polypeptides"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Lipids","answerAuditStatus":"independently_reasoned_provisional_oct20","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-a491f16255fe","stem":"In organic compounds, How many bonds do carbon atoms always form?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"four single bonds"},{"label":"B","text":"four covalent bonds"},{"label":"C","text":"two double bonds"},{"label":"D","text":"four ionic bonds"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-82c317eab4ef","stem":"A molecule of an organic compound can be thought of as having two portions: a radical with an attached functional group. What is the correct definition of a functional group?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"it consists of carbon atoms and hydrogen atoms"},{"label":"B","text":"it is responsible for most of the properties of the molecule. 100 4 Chemistry for Physiology"},{"label":"C","text":"it has a modest influence on the properties of the molecule."},{"label":"D","text":"it consists of a ring of carbon atoms."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"f03f2088a1c25b0c7de6b58e3ec335c9e541816d"},{"id":"q-cf1ed85aae3d","stem":"The one medicine may have many names. What is the “generic name” of a medicine?","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the name that describes the effect of the drug on the body."},{"label":"B","text":"the systematic name of the chemical involved."},{"label":"C","text":"the name given to the product by a manufacturer of the drug."},{"label":"D","text":"the name proposed by the inventor and approved by a government agency."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-8b19d4adb41d","stem":"When a protein is denatured, which aspect of its structure is affected the LEAST?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"primary structure"},{"label":"B","text":"secondary structure"},{"label":"C","text":"tertiary structure"},{"label":"D","text":"quaternary structure"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-7b75c9cfb77e","stem":"What chemical symbol for the element/atom occurs in an amino acid but not in fats and carbohydrates?","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Water, pH and Buffers","topicOriginal":"Water, pH and Buffers","subtopic":"Acid","suggestedTopic":null,"options":[{"label":"A","text":"N"},{"label":"B","text":"H"},{"label":"C","text":"O"},{"label":"D","text":"C"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Water, pH and Buffers","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["answer-leak or footer removed"]},{"id":"q-961fab6a899d","stem":"The element carbon is said to be tetravalent. This means it always has the fol- lowing number of covalent bonds in neutral compounds.","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"one"},{"label":"B","text":"two"},{"label":"C","text":"three"},{"label":"D","text":"four"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"60c75907ddeea456dce60e7be0295a111faa8ec8"},{"id":"q-8fa674aa73a7","stem":"Which of the following structures represents a molecule belonging to the alco- hol family?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"CH3 – COOH"},{"label":"B","text":"CH3 – OH"},{"label":"C","text":"CH3 – O – CH3"},{"label":"D","text":"CH3 – CO – CH3"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-8247e6ce9eb6","stem":"Which statement describing the chemical reactivity of organic molecules is FALSE?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thoracic Wall and Mediastinum · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Thoracic Wall and Mediastinum","options":[{"label":"A","text":"Reactivity depends on the nature of the functional group."},{"label":"B","text":"Reactivity is independent of the number and nature of the carbon rings"},{"label":"C","text":"Reactivity is dependent on the nature and size of the radical group."},{"label":"D","text":"Reactivity in the body may depend on the internal body factors such as temperature and pH."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thoracic Wall and Mediastinum · Suggested","answ