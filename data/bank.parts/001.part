abel":"C","text":"Epineurium"},{"label":"D","text":"Endoneurium"},{"label":"E","text":"None of the above"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"7b89bf9dd514fd888a3e24f411638ac632592311"},{"id":"q-ccfc9fc91556","stem":"Which of the following is the CNS macrophage?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Astrocytes"},{"label":"B","text":"Ependymal cells"},{"label":"C","text":"Oligodendrocytes"},{"label":"D","text":"Microglia"},{"label":"E","text":"Schwann cells Neuroglia are the supporting cells of the central nervous system. Sometimes, neuroglia called glial cells or glia. Astrocytes, ependymal cells, oligodendrocytes, and microglia are all neuroglia. Of the neuroglia cells, astrocytes are the most abundant and the largest. These are star shaped cells involved in the blood brain barrier. Ependymal cells line the ventricles and spinal canal. Oligodendrocytes form myelin in the central nervous system. Microglia are the central nervous system macrophages. Schwann cells are seen in the peripheral nervous system and are not considered neuroglia. Schwann cells are responsible for the myelination of neurons in the peripheral nervous system."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repea