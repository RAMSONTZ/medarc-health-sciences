erations":["source answer/boilerplate removed from option D"]},{"id":"q-16f0323c656d","stem":"Which of the following situations could produce life threatening fluid loss and infection?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Stomach ulcers"},{"label":"B","text":"Full thickness skin burn"},{"label":"C","text":"Severe muscle tear"},{"label":"D","text":"Displaced bone fracture"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D","whitespace/page_marker_normalization"],"duplicateStemGroup":"5e421e8c6fe95becede1868a855d00a653ac4ec5"},{"id":"q-9ce85d6afbf1","stem":"What do sudiferous glands do?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Secrete sebum into a hair follicle"},{"label":"B","text":"Secrete sweat through a duct to the skin"},{"label":"C","text":"Secrete sweat through a duct to the skin or into a hair follicle"},{"label":"D","text":"Secrete cerumen through a duct to the skin or into a hair follicle"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-23eb36e07f18","stem":"Which cell type produces a pigment that affords the skin some protection against ultraviolet radiation?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"keratinocytes"},{"label":"B","text":"melanocytes"},{"label":"C","text":"dendrocytes"},{"label":"D","text":"merkel cells"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"f3f63df1d876758ac6bad1039b85407f7799c843"},{"id":"q-78379cb3e367","stem":"Which layer of the integument is the most superficial layer?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the hypodermis"},{"label":"B","text":"stratum granulosum"},{"label":"C","text":"stratum corneum"},{"label":"D","text":"reticular dermal layer"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D","whitespace/page_marker_normalization"],"duplicateStemGroup":"d51bd6c1b15576eda561b22d29cbe96daa591fd2"},{"id":"q-6426a573e2d7","stem":"A drug that is applied to the skin and exerts its therapeutic effect systemically is said to be administered","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"transdermally"},{"label":"B","text":"topically"},{"label":"C","text":"intradermally"},{"label":"D","text":"subcutaneously"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"]},{"id":"q-d0e9052a20d5","stem":"Which is the most superficial layer of the integument that also has capillaries, lymphatics and sensory neurons?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Histology and Tissues","topicOriginal":"Histology and Tissues","subtopic":"Capillar","suggestedTopic":null,"options":[{"label":"A","text":"reticular dermal layer"},{"label":"B","text":"papillary dermal layer"},{"label":"C","text":"stratum granulosum"},{"label":"D","text":"stratum lucidum"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Histology and Tissues","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D","whitespace/page_marker_normalization"],"duplicateStemGroup":"0b39d82b87471004b7848fc825ef66bc717958ff"},{"id":"q-f8a98174b401","stem":"Which skin layer is the most superficial?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"stratum lucidum"},{"label":"B","text":"stratum corneum"},{"label":"C","text":"papillary dermal layer"},{"label":"D","text":"reticular dermal layer"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D","whitespace/page_marker_normalization"],"duplicateStemGroup":"69274fea98b80eddb728d751823f1f4765396674"},{"id":"q-242602ec7065","stem":"Which glands secrete “oil” into a hair follicle?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"apocrine"},{"label":"B","text":"eccrine"},{"label":"C","text":"ceruminous"},{"label":"D","text":"sebaceous"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"28c76978953934edf0ac2154c548eac2ce6adf0f"},{"id":"q-98b2e25bab27","stem":"What must be the case for a drug to be administered transdermally?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It must be water soluble"},{"label":"B","text":"It must be lipid soluble"},{"label":"C","text":"It must be injected subcutaneously"},{"label":"D","text":"It must not irritate the skin’s chemo-receptors."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"independently_reasoned_provisional_oct20","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-608f99891d98","stem":"The skin participates in the production of vitamin D when which of the follow- ing occurs? When","type":"Single Best Answer MCQ","subject":"Nutrition and Dietetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"calcium is present"},{"label":"B","text":"signalled to by the hormone PTH"},{"label":"C","text":"exposed to ultraviolet radiation"},{"label":"D","text":"the precursor molecule is produced by the liver"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Nutrition and Dietetics","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{"sourceStem":"The skin participates in the production of vitamin D when which of the follow- ing occurs? When","sourceOptions":[{"label":"A","text":"calcium is present"},{"label":"B","text":"signalled to by the hormone PTH"},{"label":"C","text":"exposed to ultraviolet radiation"},{"label":"D","text":"the precursor molecule is produced by the liver Answer is C:UV light converts cholecalciferol (= provitamin D3) into vitamin D pre-cursor. The liver then adds a hydroxyl group."}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-15d57b8e0d21","stem":"The integument consists of which of the following layers?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"epidermis and dermis"},{"label":"B","text":"epidermis, dermis and hypodermis"},{"label":"C","text":"stratum germinativum, stratum spinosum, stratum granulosum, stratum lucidum and stratum corneum"},{"label":"D","text":"stratum corneum, dermis and reticular dermal layer"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-cc23a1923379","stem":"One of the following is NOT a type of sweat gland. Which one?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"eccrine gland"},{"label":"B","text":"merocrine gland"},{"label":"C","text":"endocrine gland"},{"label":"D","text":"apocrine gland"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-a6f516c09c3f","stem":"Three functions of the skin are to","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"store fat, produce sweat, receive stimuli."},{"label":"B","text":"synthesise vitamin D, excrete bile, and provide a barrier to the entry of bacteria."},{"label":"C","text":"produce keratin, assist in the immune response, and produce lymphocytes."},{"label":"D","text":"produce melanin, secrete sebum, minimise water loss."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"346910de1389e8a68080f34f50c323f08ae7516c"},{"id":"q-562c268adbad","stem":"Which of the following is NOT a cell?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"macrophage"},{"label":"B","text":"chondroblast"},{"label":"C","text":"lysosome"},{"label":"D","text":"melanocyte"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"ab4cb36393b57d5bc4f93f2ee36075ec6641f760"},{"id":"q-15f782d097d2","stem":"What purpose is vitamin D (calcitriol) used for?","type":"Single Best Answer MCQ","subject":"Nutrition and Dietetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"required for several stages of haemostasis"},{"label":"B","text":"required for uptake of calcium from the gut"},{"label":"C","text":"required for erythropoiesis"},{"label":"D","text":"required for uptake of intrinsic factor"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Nutrition and Dietetics","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{"sourceStem":"What purpose is vitamin D (calcitriol) used for?","sourceOptions":[{"label":"A","text":"required for several stages of haemostasis"},{"label":"B","text":"required for uptake of calcium from the gut"},{"label":"C","text":"required for erythropoiesis"},{"label":"D","text":"required for uptake of intrinsic factor Answer is B: Dietary calcium requires vitamin D for absorption"}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-d95117b5c20f","stem":"Which layer of the skin is the most superficial?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"epidermis"},{"label":"B","text":"dermis"},{"label":"C","text":"papillary dermal layer"},{"label":"D","text":"stratum germinativum"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D","whitespace/page_marker_normalization"],"duplicateStemGroup":"74c7d79fb6d590d4c53f710da8ea247d6ffc992b"},{"id":"q-ac0149c9b05c","stem":"The skin begins the production of vitamin D in which of the following situa- tions? When","type":"Single Best Answer MCQ","subject":"Nutrition and Dietetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"exposed to ultraviolet radiation."},{"label":"B","text":"signalled to by the hormone PTH"},{"label":"C","text":"calcium is present"},{"label":"D","text":"it adds an hydroxyl group to a cholesterol molecule."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Nutrition and Dietetics","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"manualEdits":{"sourceStem":"The skin begins the production of vitamin D in which of the following situa- tions? When","sourceOptions":[{"label":"A","text":"exposed to ultraviolet radiation."},{"label":"B","text":"signalled to by the hormone PTH"},{"label":"C","text":"calcium is present"},{"label":"D","text":"it adds an hydroxyl group to a cholesterol molecule. Answer is A: Choice D happens in the liver and in the kidney. PTH signals the kidney to act on the modifi ed pre-cursor, whereupon an hydroxyl group is added."}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-58457e05d827","stem":"What do the apocrine glands of the skin secrete?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"apocrin"},{"label":"B","text":"cerumin"},{"label":"C","text":"milk"},{"label":"D","text":"sweat"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"9a0e7515ef4478efb430f3fc0803fa3e05f875b7"},{"id":"q-774fb3f877df","stem":"Another name for oil glands in the skin is","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"sebaceous glands"},{"label":"B","text":"eccrine glands"},{"label":"C","text":"merocrine glands"},{"label":"D","text":"apocrine glands"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-e3711a4ec75c","stem":"What are three functions of the skin? To","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"store fat, produce sebum, trap a layer of air beneath hair to insulate against heat loss."},{"label":"B","text":"synthesise vitamin D, excrete bile, protect against abrasion."},{"label":"C","text":"produce melanin, regulate body temperature, minimise water loss."},{"label":"D","text":"produce keratin, assist in the immune response, produce dendrocytes."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-02c33c316b96","stem":"Which of the following lists layers of the integument in the order from most superficial first, to deep?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"epidermis, hypodermis, dermis"},{"label":"B","text":"epidermis, papillary dermal layer, reticular dermal layer."},{"label":"C","text":"dermis, stratum germinativum, stratum corneum"},{"label":"D","text":"stratum corneum, stratum germinativum, epidermis."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D","whitespace/page_marker_normalization"],"duplicateStemGroup":"40657dcf7b97e3af66a48a3d3c849d8c0c34a2dd"},{"id":"q-1245523d0de8","stem":"What is another name for sweat glands?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"ceruminous glands"},{"label":"B","text":"sebaceous glands"},{"label":"C","text":"sudiferous glands"},{"label":"D","text":"apocrine glands"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-9d9fa670394a","stem":"Which statement about vitamin D is INCORRECT?","type":"Single Best Answer MCQ","subject":"Nutrition and Dietetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It is required for uptake of calcium from the gut"},{"label":"B","text":"It is made in the skin, liver and kidneys."},{"label":"C","text":"It is an essential part of our diet."},{"label":"D","text":"It is a hormone"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Nutrition and Dietetics","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"bc82adc56a5bad28acb344d1957e01aac96bde60","manualEdits":{"sourceStem":"Which statement about vitamin D is INCORRECT?","sourceOptions":[{"label":"A","text":"It is required for uptake of calcium from the gut"},{"label":"B","text":"It is made in the skin, liver and kidneys."},{"label":"C","text":"It is an essential part of our diet."},{"label":"D","text":"It is a hormone Answer is C: As our body can make “vitamin D” it is not an essential part of our diet. As it circulates in the bloodstream, it is regarded as a type of steroid hormone. 5 Integument 113"}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-bf9ddeeb1466","stem":"If a drug is administered “transdermally”, which of the following applies?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"it is absorbed through the skin and acts locally."},{"label":"B","text":"it is injected into the dermis"},{"label":"C","text":"it is absorbed through the skin and acts systemically."},{"label":"D","text":"it is injected into the subcutaneous fat layer"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{"sourceStem":"If a drug is administered “transdermally”, which of the following applies?","sourceOptions":[{"label":"A","text":"it is absorbed through the skin and acts locally."},{"label":"B","text":"it is injected into the dermis"},{"label":"C","text":"it is absorbed through the skin and acts systemically."},{"label":"D","text":"it is injected into the subcutaneous fat layer Answer is C: Transdermally refers to the drug having to pass through the skin, rather than bypass the skin as in hypodermic administration (choice D), or intradermal injection (choice B)."}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-2a501ad3ed43","stem":"The “stratum corneum” is part of the skin that","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"contains the youngest, rapidly-dividing cells."},{"label":"B","text":"anchors the skin to muscle while allowing it to slide over muscle."},{"label":"C","text":"contains collagen, elastin and reticular fibres."},{"label":"D","text":"protects the body against heat, chemicals and bacteria."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"]},{"id":"q-e2526b43c71e","stem":"A drug that is administered “transdermally” is one that","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"acts at (or close to) the skin area to which it is administered."},{"label":"B","text":"is injected into the muscle"},{"label":"C","text":"is applied to the epidermis"},{"label":"D","text":"is inserted into the anus"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"independently_reasoned_provisional_oct20","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-8ae35deb1dcc","stem":"The hypodermis is which of the following?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the outer layer of the skin."},{"label":"B","text":"the inner layer of the skin."},{"label":"C","text":"the superficial fascia and not regarded as part of the skin."},{"label":"D","text":"not vascularised, getting its nutrients by diffusion."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"5fdfbf46a62bc58134e657e269806eec5224b866"},{"id":"q-392c0232cc7e","stem":"Sudiferous glands are also known as","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"eccrine or apocrine glands."},{"label":"B","text":"sebaceous or oil glands."},{"label":"C","text":"ceruminous or apocrine glands."},{"label":"D","text":"mammary or eccrine glands."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"63eb12d44ebf3e6287a98dc1433ceeb9080e6b0f"},{"id":"q-047b461acb14","stem":"Which is the outermost layer of the skin?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"dermis"},{"label":"B","text":"epidermis"},{"label":"C","text":"stratum lucidum"},{"label":"D","text":"reticular dermal layer"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"3cf969188fbb351a8febcb3ed07024990f9f4926"},{"id":"q-24e386f20ed6","stem":"One of the following is NOT part of the integumentary system. Which one?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the hypodermis"},{"label":"B","text":"sebaceous glands"},{"label":"C","text":"finger nails."},{"label":"D","text":"the stratum corneum."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"ca5992876d524686ebdfc372d4eabcf4056726ed"},{"id":"q-e253ee54ec4c","stem":"People with full thickness burns to more than 20 % of their body are in a life- threatening situation. This is due to which of the following?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Trauma and Emergency Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Trauma and Emergency Surgery","options":[{"label":"A","text":"The body’s inability to thermoregulate."},{"label":"B","text":"The loss of the ability to produce vitamin D."},{"label":"C","text":"The buildup of urea and uric acid which would otherwise have been excreted by the skin."},{"label":"D","text":"The body’s inability to prevent water loss"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Trauma and Emergency Surgery · Suggested","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{"sourceStem":"People with full thickness burns to more than 20 % of their body are in a life- threatening situation. This is due to which of the following?","sourceOptions":[{"label":"A","text":"The body’s inability to thermoregulate."},{"label":"B","text":"The loss of the ability to produce vitamin D."},{"label":"C","text":"The buildup of urea and uric acid which would otherwise have been excreted by the skin."},{"label":"D","text":"The body’s inability to prevent water loss Answer is D: Without a waterproof outer layer, the body would lose water faster than it could be replaced."}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-c0d6248f2a67","stem":"Which one of the following cell types is responsible for forming the skin’s abil- ity to tan on exposure to sunlight?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"melanocytes."},{"label":"B","text":"keratinocytes."},{"label":"C","text":"dendrocytes."},{"label":"D","text":"lymphocytes."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-5ac64f03e8ec","stem":"Which list below contains functions that are NOT performed by the integumen- tary system?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"protection, secretion of sebum, role in immunity."},{"label":"B","text":"body temperature regulation, excretion, synthesis of vitamin D."},{"label":"C","text":"perception of stimuli, production of sweat, protection"},{"label":"D","text":"body temperature regulation, synthesis of vitamin E, social function."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"75c084e010ead35c5f3da3351a84d1988437d2ce"},{"id":"q-2d89daa0669a","stem":"Full thickness burns to more than 20 % of the body surface is life-threatening because of the","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Trauma and Emergency Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Trauma and Emergency Surgery","options":[{"label":"A","text":"fluid loss and inability to produce vitamin D."},{"label":"B","text":"loss of ability to thermoregulate and infection."},{"label":"C","text":"inability to excrete lactic acid, urea and uric acid, loss of thermoregulation."},{"label":"D","text":"fluid loss and loss of the barrier against infection"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Trauma and Emergency Surgery · Suggested","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"manualEdits":{"sourceStem":"Full thickness burns to more than 20 % of the body surface is life-threatening because of the","sourceOptions":[{"label":"A","text":"fluid loss and inability to produce vitamin D."},{"label":"B","text":"loss of ability to thermoregulate and infection."},{"label":"C","text":"inability to excrete lactic acid, urea and uric acid, loss of thermoregulation."},{"label":"D","text":"fluid loss and loss of the barrier against infection Answer is D: Removing the skin barrier means that bacteria can enter the body and water can leave the body. This can be fatal."}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-a95b6dd06872","stem":"Which one of the following cell types is responsible for forming the skin’s stratum corneum?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"melanocytes."},{"label":"B","text":"keratinocytes."},{"label":"C","text":"dendrocytes."},{"label":"D","text":"lymphocytes."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"9509b24f8b5f6ea7c9ab71e8cf92407f9aaabafa"},{"id":"q-1e92111a3dd1","stem":"Which list of structures is NOT all part of the integumentary system?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"sebaceous glands, hair, nails, mammary glands."},{"label":"B","text":"meissner’s corpuscles, hypodermis, eccrine sweat glands, oil glands."},{"label":"C","text":"apocrine sweat glands, sebaceous glands, merkel disc, hair follicles"},{"label":"D","text":"melanocytes, keratinocytes, merkel cells, dendrocytes."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-14e12e442d46","stem":"Which of the following is NOT a function of the skin?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"fat storage"},{"label":"B","text":"waterproofing the body"},{"label":"C","text":"production of vitamin D"},{"label":"D","text":"immunity"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"b311d196f36044361aeaeb6b050a2ebd3db93097"},{"id":"q-e44f3583dc6b","stem":"What is one difference between the dermis and the epidermis? The","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"epidermis is composed of fibrous connective tissue while the dermis is com- posed of epithelial cells."},{"label":"B","text":"dermis is the most exterior layer."},{"label":"C","text":"dermis is not part of the skin while the epidermis is."},{"label":"D","text":"dermis is vascularised while the epidermis is not."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"f5d9820f5c7d216e5705268b99fea11fb55c6dba"},{"id":"q-07d7f45bc21d","stem":"What is the most common protein in the epidermis?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"elastin"},{"label":"B","text":"keratin"},{"label":"C","text":"melanin"},{"label":"D","text":"cholesterol"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"f206e4115fae888571e5531edbd657ad9df0893e"},{"id":"q-53044f3ba5c6","stem":"What is the fibrous protein in our skin that protects it from abrasion?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"melanin"},{"label":"B","text":"keratin"},{"label":"C","text":"sebum"},{"label":"D","text":"elastin"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D","whitespace/page_marker_normalization"],"duplicateStemGroup":"f2c98ee9d6ba2d5e78d5604c5eddcf12cd5cce6e"},{"id":"q-f64f0eb1fd11","stem":"Which stratum of the epidermis protects the body against water loss and abrasion?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"stratum germinativum"},{"label":"B","text":"stratum basale"},{"label":"C","text":"stratum lucidum"},{"label":"D","text":"stratum corneum"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"]},{"id":"q-01a44fb36a56","stem":"On which part of the integument is most of the body’s normal flora located?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"dermis"},{"label":"B","text":"epidermis"},{"label":"C","text":"microdermis"},{"label":"D","text":"hypodermis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D","whitespace/page_marker_normalization"],"duplicateStemGroup":"480d40bd0bee1db874a76e35992438222a6f3e3d"},{"id":"q-c6a45972c776","stem":"Which is the deepest layer of the integument?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the epidermis"},{"label":"B","text":"the dermis"},{"label":"C","text":"the stratum corneum"},{"label":"D","text":"the papillary dermal layer"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"265b9581bb6ff38ffab885f274c5bc52744f2034"},{"id":"q-d10989510d6b","stem":"One of the following is NOT a gland found in the integument. Which one?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"sudiferous gland"},{"label":"B","text":"mammary gland"},{"label":"C","text":"pineal gland"},{"label":"D","text":"sebaceous gland"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-f3fce253c310","stem":"All but one of the following are sensory receptors in the skin. Which one is NOT?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Reticular dermal layer"},{"label":"B","text":"Merkel discs"},{"label":"C","text":"Nociceptors"},{"label":"D","text":"Pacinian corpuscles"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[],"manualEdits":{"sourceStem":"All but one of the following are sensory receptors in the skin. Which one is NOT?","sourceOptions":[{"label":"A","text":"Reticular dermal layer"},{"label":"B","text":"Merkel discs"},{"label":"C","text":"Nociceptors"},{"label":"D","text":"Pacinian corpuscles Answer is A: The reticular dermal layer is not a receptor, it is the deepest layer of the dermis."}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-e81f9604a3e9","stem":"What is the secretion produced by sudiferous glands?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"sweat"},{"label":"B","text":"sebum"},{"label":"C","text":"cerumin"},{"label":"D","text":"merocrin"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-e66b0ef826af","stem":"One of the following statements about the stratum corneum is correct. Which one?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"cells in this layer undergo cell division to replace the skin."},{"label":"B","text":"it consists of dead cells."},{"label":"C","text":"it contains collagen, elastin and reticular fibres."},{"label":"D","text":"the layer has sensory receptors known as Merkel discs, Meissner’s and Pacinian corpuscles."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"aa2c199c9923434fd555724b40822eba8870a8ce"},{"id":"q-f2378ade88ef","stem":"Choose one answer below that completes the sentence so that it makes a true statement: Positive feedback","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"is the way the body maintains homeostasis"},{"label":"B","text":"is a response that opposes a stimulus"},{"label":"C","text":"is a response that maintains a dynamic state of equilibrium"},{"label":"D","text":"is a response that enhances a stimulus"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-7a9248a2e7a1","stem":"The hypothalamus and core thermoreceptors notice if body temp too low. The hypothalamus signals smooth muscle in blood vessels to vasoconstrict and skeletal muscle to shiver. This activity causes body temp to rise, which is again noticed by hypothalamus & core thermoreceptors, so the hypothalamus turns © Springer Science+Business Media Singapore 2016 119 M. Caon, Examination Questions and Answers in Basic Anatomy and Physiology, DOI 10.1007/978-981-10-2332-3_6 120 6 Homeostasis off these heat gain mechanisms. In this scenario, which of the following state- ments is correct?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Neuroanatomy · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Neuroanatomy","options":[{"label":"A","text":"The scenario describes positive feedback in action."},{"label":"B","text":"The core thermoreceptors are the effector organs."},{"label":"C","text":"The hypothalamus is the control centre."},{"label":"D","text":"Skeletal muscle is the efferent pathway to the effector organ."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Neuroanatomy · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D","whitespace/page_marker_normalization"]},{"id":"q-0439e4d0615b","stem":"The human body’s ability to maintain a relatively constant internal temperature is an example of what?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Respiratory heat loss"},{"label":"B","text":"Homeostasis"},{"label":"C","text":"Vasodilation and evaporative heat loss"},{"label":"D","text":"Positive feedback"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-a65fd5621e1f","stem":"Some of the body’s homeostatic responses rely on “negative feedback”. Which of the following happens in negative feedback?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The body ignores changes in a physiological variable that are directed towards the set point for that variable."},{"label":"B","text":"The body ignores changes in a physiological variable that are directed away from the set point for that variable"},{"label":"C","text":"The body’s response acts to oppose the change in the physiological variable."},{"label":"D","text":"The body’s response acts to enhance the change in the physiological variable"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-6355f9c6ca14","stem":"In homeostasis, what is it that produces the response that moves the physiologi- cal variable back towards the middle of its healthy range?","type":"Single Best Answer MCQ","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the effector"},{"label":"B","text":"the receptor"},{"label":"C","text":"the integrating centre"},{"label":"D","text":"the efferent pathway"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"1716e3f23ee8c9aec601bcab920396749238ef23","manualEdits":{"sourceStem":"In homeostasis, what is it that produces the response that moves the physiologi- cal variable back towards the middle of its healthy range?","sourceOptions":[{"label":"A","text":"the effector"},{"label":"B","text":"the receptor"},{"label":"C","text":"the integrating centre"},{"label":"D","text":"the efferent pathway Answer is A: The effector produces the effect that it is directed to by the inte- grating centre. That direction is passed along the efferent (or outgoing) pathway. 6 Homeostasis 121"}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-af2ae64041f1","stem":"The “afferent pathway” in the description of a feedback loop in homeostasis, refers to the","type":"Single Best Answer MCQ","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"circulating blood."},{"label":"B","text":"pathway from the integrating centre to the effector."},{"label":"C","text":"outgoing signal."},{"label":"D","text":"path taken by the signal produced by a stimulus."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{"sourceStem":"The “afferent pathway” in the description of a feedback loop in homeostasis, refers to the","sourceOptions":[{"label":"A","text":"circulating blood."},{"label":"B","text":"pathway from the integrating centre to the effector."},{"label":"C","text":"outgoing signal."},{"label":"D","text":"path taken by the signal produced by a stimulus. Answer is D: The afferent signal is incoming from the receptor to the integrat- ing centre. It may be via the blood, but may be via a nerve."}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-2b4c5a388148","stem":"Homeostasis usually returns the body to a healthy state after stressful stimuli by","type":"Single Best Answer MCQ","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"negative feedback"},{"label":"B","text":"positive feedback"},{"label":"C","text":"means of the immune system"},{"label":"D","text":"means of the nervous system"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-6a8b81e275da","stem":"What does the word “homeostasis” refer to?","type":"Single Best Answer MCQ","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the steps leading to repair of a blood vessel and the coagulation of blood"},{"label":"B","text":"the maintenance of internal body conditions within narrow limits"},{"label":"C","text":"the controlled response that opposes the influence that caused it."},{"label":"D","text":"the production of blood cells in active bone marrow"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"16e731580c674bc791ef747be4708e4a3f142a08","manualEdits":{"sourceStem":"What does the word “homeostasis” refer to?","sourceOptions":[{"label":"A","text":"the steps leading to repair of a blood vessel and the coagulation of blood"},{"label":"B","text":"the maintenance of internal body conditions within narrow limits"},{"label":"C","text":"the controlled response that opposes the influence that caused it."},{"label":"D","text":"the production of blood cells in active bone marrow Answer is B: This is the best definition. Choice C refers to negative feedback only."}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-889adf2d8e5d","stem":"How does homeostasis return the body to a healthy state after stressful stimuli? By producing a","type":"Single Best Answer MCQ","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"responses that oppose the stress"},{"label":"B","text":"learned behaviour"},{"label":"C","text":"reflex action"},{"label":"D","text":"buffering mechanism"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"2b60affd51f9ea0196078058d9823db17777f013","manualEdits":{"sourceStem":"How does homeostasis return the body to a healthy state after stressful stimuli? By producing a","sourceOptions":[{"label":"A","text":"responses that oppose the stress"},{"label":"B","text":"learned behaviour"},{"label":"C","text":"reflex action"},{"label":"D","text":"buffering mechanism Answer is A: Refers to negative feedback. Positive feedback is also possible (but rare), nevertheless choice A is the best answer."}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-1dcfd113bb60","stem":"What causes the body to maintain a relatively constant internal environment?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"positive feedback"},{"label":"B","text":"homeostasis"},{"label":"C","text":"reflexes"},{"label":"D","text":"pH buffers"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"0e81fd107c734ce170aafdb980baaf64eb3d4305"},{"id":"q-403370b19326","stem":"Homeostasis relies on feedback to achieve its aims. “Negative” feedback refers to which situation below? The body’s response","type":"Single Best Answer MCQ","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"travels from the effector to the integrating centre via the afferent pathway."},{"label":"B","text":"opposes the stressful stimulus."},{"label":"C","text":"is to decrease the set point."},{"label":"D","text":"enhances the stressful stimulus."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{"sourceStem":"Homeostasis relies on feedback to achieve its aims. “Negative” feedback refers to which situation below? The body’s response","sourceOptions":[{"label":"A","text":"travels from the effector to the integrating centre via the afferent pathway."},{"label":"B","text":"opposes the stressful stimulus."},{"label":"C","text":"is to decrease the set point."},{"label":"D","text":"enhances the stressful stimulus. Answer is B: “Negative” refers to the opposing nature of the response."}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-c4a1807603cd","stem":"The term “homeostasis” is described by which one of the following statements? “The body’s ability to","type":"Single Best Answer MCQ","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"respond to a stimulus or stress in such a way as to enhance the stress."},{"label":"B","text":"maintain a relatively constant internal temperature."},{"label":"C","text":"respond to a stimulus or stress in such a way as to reduce the stress."},{"label":"D","text":"maintain a relatively constant internal environment."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-966ba5e1931e","stem":"Synthesis and release of most hormones is regulated by negative feedback. Negative feedback means","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A rise in hormone levels affects the target organ which acts to inhibit further hormone release"},{"label":"B","text":"A rise in hormone levels affects the target organ which acts to stimulate further hormone release"},{"label":"C","text":"The effect of hormones on target cells does not control further release of hormone"},{"label":"D","text":"Neural stimuli result in the release of oxytocin and antidiuretic hormone from the hypothalamus"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-ecda313d4932","stem":"Which of the following is a correct definition of “positive feedback”?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The process by which the body maintains homeostasis."},{"label":"B","text":"A mechanism in which the body’s response to a stimulus, opposes the stimulus."},{"label":"C","text":"A mechanism whereby the body responds to a stimulus by acting to enhance the stimulus."},{"label":"D","text":"The dynamic equilibrium maintained by an integrating centre which causes an effector to respond to the stimulus received by the receptor."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D","whitespace/page_marker_normalization"],"duplicateStemGroup":"51ac36a5ea95ae6d78744859639a9f6d3da9cff3"},{"id":"q-f0342c9b961b","stem":"Which of the following is a correct definition of “negative feedback”?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The process by which the body maintains homeostasis."},{"label":"B","text":"A mechanism in which the body’s response opposes the stimulus. 6 Homeostasis 123"},{"label":"C","text":"A mechanism whereby the body responds to a stimulus by acting to enhance the stimulus."},{"label":"D","text":"The dynamic equilibrium maintained by an integrating centre which causes an effector to respond to the stimulus received by the receptor."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D","whitespace/page_marker_normalization"],"duplicateStemGroup":"03ad38f927b32ddde6a3bb086af5086c880c9923"},{"id":"q-cc408be41f79","stem":"Homeostasis refers to maintaining","type":"Single Best Answer MCQ","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"a constant internal body environment through negative feedback."},{"label":"B","text":"body conditions relatively constant within a narrow range through negative and positive feedback."},{"label":"C","text":"adequate concentrations of respiratory gases."},{"label":"D","text":"blood glucose level within the healthy range."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{"sourceStem":"Homeostasis refers to maintaining","sourceOptions":[{"label":"A","text":"a constant internal body environment through negative feedback."},{"label":"B","text":"body conditions relatively constant within a narrow range through negative and positive feedback."},{"label":"C","text":"adequate concentrations of respiratory gases."},{"label":"D","text":"blood glucose level within the healthy range. Answer is B: The maintenance of body conditions through feedback which is usually negative but is positive in some rare situations."}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-f32954463f4b","stem":"What does the term “homeostasis” refer to?","type":"Single Best Answer MCQ","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the chemical processes that take place in the organelles of the cells."},{"label":"B","text":"the body’s tendency to maintain a relatively constant internal environment."},{"label":"C","text":"the body’s use of energy to produce chemical substances and parts for growth."},{"label":"D","text":"any body response that opposes the stimulus that initiated the response."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"6ed4b49dd522069a36298ff472a22d2d3846cfd2","manualEdits":{"sourceStem":"What does the term “homeostasis” refer to?","sourceOptions":[{"label":"A","text":"the chemical processes that take place in the organelles of the cells."},{"label":"B","text":"the body’s tendency to maintain a relatively constant internal environment."},{"label":"C","text":"the body’s use of energy to produce chemical substances and parts for growth."},{"label":"D","text":"any body response that opposes the stimulus that initiated the response. Answer is B: This is the best definition of homeostasis. Choice D refers to negative feedback."}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-320df4a7a378","stem":"The body returns to a healthy state after stressful stimuli thanks to which of the following?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"positive feedback"},{"label":"B","text":"metabolism"},{"label":"C","text":"anabolism"},{"label":"D","text":"negative feedback"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-961d77203795","stem":"Which of the following would be a negative feedback response by the body to hyperthermia?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Shivering"},{"label":"B","text":"Sweating"},{"label":"C","text":"Vasoconstriction of blood vessels in the dermis"},{"label":"D","text":"An increase in metabolic rate"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"90b8479b35c2e83ae653bcc8e801e230b43659e6"},{"id":"q-3b4412630f34","stem":"How would the hypothalamus respond if its osmoreceptors noticed an increase in plasma osmotic pressure? It would send a message to","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"the posterior pituitary to release more ADH"},{"label":"B","text":"the posterior pituitary to release less ADH"},{"label":"C","text":"the adrenal cortex to release less aldosterone"},{"label":"D","text":"the atria to release more ANP"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"independently_reasoned_provisional_oct20","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"f672c3f26c34655adc8e08e8f88319e16ba82e63"},{"id":"q-95eb5a5e1356","stem":"During the delivery of a baby the baby’s head is pushing against the cervix causing the cervix wall to stretch. This stretching causes nerve impulses to be sent to the hypothalamus which directs the posterior pituitary to release oxyto- cin in the blood. Oxytocin stimulates the uterus to contract which pushes the baby’s head deeper into the cervix, stretching it further. This situation is a description of which of the following?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Head","suggestedTopic":null,"options":[{"label":"A","text":"negative feedback"},{"label":"B","text":"positive feedback"},{"label":"C","text":"homeostasis"},{"label":"D","text":"an afferent pathway to an integrating centre"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-e8a218bcfa4c","stem":"Which of the following statements about positive feedback and homeostasis is correct?","type":"Single Best Answer MCQ","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"They are regulation mechanisms that control most fluctuations in the inter- nal environment of the body."},{"label":"B","text":"The response to the stimulus serves to exaggerate the feedback effect."},{"label":"C","text":"This type of feedback response only involves an effector not a specific stim- ulus receptor site."},{"label":"D","text":"This feedback mechanism involves adjustments at the organ level but not at the cellular level."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"dffda7eb82ead3857cd282b4252e5bd0e30f9856"},{"id":"q-1ec68e2807dc","stem":"Which of the following is NOT a bone of the axial skeleton?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"deltoid"},{"label":"B","text":"ethmoid © Springer Science+Business Media Singapore 2016 125 M. Caon, Examination Questions and Answers in Basic Anatomy and Physiology, DOI 10.1007/978-981-10-2332-3_7 126 7 Skeleton and Joints"},{"label":"C","text":"sphenoid"},{"label":"D","text":"hyoid"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"1250a37e362d98566afd3614afe08b9b76648168"},{"id":"q-d862950e47f9","stem":"Which of the following is a function of the skeletal system?","type":"Single Best Answer MCQ","subject":"Human Anatom