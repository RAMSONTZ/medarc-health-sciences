ubject":"Medical Biochemistry","topic":"Lipids","topicOriginal":"Lipids","subtopic":"Lipid","suggestedTopic":null,"options":[{"label":"A","text":"C2936H4624N786O889S41"},{"label":"B","text":"C57H110O6"},{"label":"C","text":"C6H12O6"},{"label":"D","text":"Ca10(PO4)6(OH)2"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Lipids","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-d29dfff3b5df","stem":"What are the four most common elements found in proteins? 98 4 Chemistry for Physiology","type":"Single Best Answer MCQ","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"C, H, N, Ca"},{"label":"B","text":"C, O, N, Fe"},{"label":"C","text":"C, H, N, O"},{"label":"D","text":"N, C, H, Na"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"],"manualEdits":{"sourceStem":"What are the four most common elements found in proteins? 98 4 Chemistry for Physiology","sourceOptions":[{"label":"A","text":"C, H, N, Ca"},{"label":"B","text":"C, O, N, Fe"},{"label":"C","text":"C, H, N, O"},{"label":"D","text":"N, C, H, Na Answer is C: Nitrogen must be present. Choice B is wrong as H is absent."}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-516a7dbb5b41","stem":"To what type of fatty acids is the term “saturated” applied?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Those with four single bonds around each carbon atom."},{"label":"B","text":"Those with at least one double bond between carbon atoms."},{"label":"C","text":"Those that are not implicated in coronary heart disease."},{"label":"D","text":"Those which are essential in our diet."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-1a8b9bda1c4c","stem":"Which of the following is a polysaccharide?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"glucuronidase"},{"label":"B","text":"glucagon"},{"label":"C","text":"glucose"},{"label":"D","text":"glycogen"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-b15ab2108317","stem":"What holds the primary structure of a protein together?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"hydrogen bonds"},{"label":"B","text":"covalent bonds"},{"label":"C","text":"peptide bonds"},{"label":"D","text":"ionic bonds"