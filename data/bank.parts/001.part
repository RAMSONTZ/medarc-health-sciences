tus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"1b22ce9667a48efe2910673239f3160bc5e18201"},{"id":"q-1fb1797a73e5","stem":"Given that the healthy range of sodium ion concentration in the blood is 137– 145 mmol/L, if the measured concentration of a blood sample was 130 mmol/L, what would the condition be called?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"hyperkalemia"},{"label":"B","text":"hypokalemia"},{"label":"C","text":"hypernatremia"},{"label":"D","text":"hyponatremia"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-df4da76ec484","stem":"Extracellular fluid includes which of the following liquids?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"blood plasma"},{"label":"B","text":"blood plasma and interstitial fluid"},{"label":"C","text":"blood plasma and interstitial fluid and connective tissue fluid"},{"label":"D","text":"blood plasma and interstitial fluid and connective tissue fluid and liquid inside cells"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-936716a20298","stem":"What can be said about a solution that conducts electricity?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the solute is a polar molecule"},{"label":"B","text":"the solvent is a non-polar liquid"},{"label":"C","text":"the solution contains dissolved ions"},{"label":"D","text":"the solution contains dissolved molecules"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-c4d4444ab861","stem":"Which of the body’s fluid compartments does the vascular compartment form part of?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"interstitial fluid"},{"label":"B","text":"extracellular fluid"},{"label":"C","text":"intracellular fluid"},{"label":"D","text":"transcellular fluid"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-cbd263aba683","stem":"To what condition does the term “hypokalemia” refer?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"too little phosphorus in the blood"},{"label":"B","text":"too much sodium in the blood"},{"label":"C","text":"too little potassium in the blood"},{"label":"D","text":"too little sodium in the blood"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"c69e294a91a933b2eebda9f7bad3c164b594a3cb"},{"id":"q-55af3f66bd32","stem":"Which of the following is correct for intra-cellular fluid (ICF) and extra-cellular fluid (ECF)?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the ECF is part of the ICF"},{"label":"B","text":"the majority of the body’s water is in the ECF"},{"label":"C","text":"the ICF contains more sodium than the ECF"},{"label":"D","text":"the ICF contains more potassium than the ECF"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-cba550c5bf02","stem":"A one litre IV bag contains 0.18 % sodium chloride and 4 % glucose. What mass of solutes would be dissolved in 100 ml of the solution?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"0.18 g of sodium chloride and 4 g of glucose"},{"label":"B","text":"1.8 g of sodium chloride and 4 g of glucose"},{"label":"C","text":"1.8 g of sodium chloride and 40 g of glucose"},{"label":"D","text":"18 g of sodium chloride and 40 g of glucose"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-0712ca80edbe","stem":"In the context of fluid (water) balance, the body is said to have “two compart- ments”. What are they?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the vascular and the interstitial compartments"},{"label":"B","text":"the intracellular and the interstitial compartments"},{"label":"C","text":"the lymph and the vascular compartments"},{"label":"D","text":"the extracellular and the intracellular compartments"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-49ac3f2e286f","stem":"What is an insufficient concentration of potassium in the blood known as?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"hypokalemia"},{"label":"B","text":"hyponatremia"},{"label":"C","text":"hypopotassemia"},{"label":"D","text":"hypocalcemia"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-691b86399f17","stem":"If a solution is shown to be able to conduct electricity, then what is true?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A: the solution is free of impurities"},{"label":"B","text":"B: the solution contains a dissolved electrolyte"},{"label":"C","text":"C: the solution contains dissolved molecules"},{"label":"D","text":"D: the solution is an aqueous solution"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"0006101a7bf3b3ab0db48d0503c7e0ee5df131d1"},{"id":"q-f26dde24bb21","stem":"How many grams of sodium chloride are there in a one litre bag of 4 % glucose and 0.18 % sodium chloride solution?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"0.18"},{"label":"B","text":"1.8"},{"label":"C","text":"18"},{"label":"D","text":"41.8"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-54acffb658af","stem":"In the vascular compartment of the body, what is the solvent?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"blood"},{"label":"B","text":"plasma"},{"label":"C","text":"serum"},{"label":"D","text":"water"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-59ed4d7066b4","stem":"The extracellular fluid compartment consists of which of the following?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"vascular and transcellular"},{"label":"B","text":"interstitial, vascular and connective tissue fluid"},{"label":"C","text":"intra-cellular and transcellular"},{"label":"D","text":"trans-cellular, intra-cellular and connective tissue fluid"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-65d54cb47b37","stem":"Electrolyte balance is achieved largely by","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the kidneys and aldosterone"},{"label":"B","text":"drinking sufficient water"},{"label":"C","text":"anti-diuretic hormone and isotonic fluids"},{"label":"D","text":"ensuring that daily water intake is the same as daily water output"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-ff6699371b0d","stem":"What may hyponatremia be described as?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thoracic Wall and Mediastinum · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Thoracic Wall and Mediastinum","options":[{"label":"A","text":"insufficient potassium in the blood"},{"label":"B","text":"insufficient iron in the blood"},{"label":"C","text":"insufficient sodium in the blood"},{"label":"D","text":"excess sodium in the blood"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thoracic Wall and Mediastinum · Suggested","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"11a9a5a30fc943232e1b27ae8ae461f2053b2f52"},{"id":"q-cc9cfcf0c149","stem":"Which of the following ways of expressing a solution’s concentration is written as a number without units?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"% concentration"},{"label":"B","text":"Molarity"},{"label":"C","text":"Osmotic pressure"},{"label":"D","text":"Specific gravity"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-46a81f72bfb2","stem":"A solution of 5 % glucose is infused over a period of three hours. If 250 ml of solution was used, how many grams of glucose was infused?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"5 g"},{"label":"B","text":"12.5 g"},{"label":"C","text":"15.0 g"},{"label":"D","text":"50 g"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-6144c391aca9","stem":"A solution is prepared by dissolving 10 g of glucose in 250 ml of water. What will be the concentration of this solution expressed as a percentage?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"4"},{"label":"B","text":"6"},{"label":"C","text":"25"},{"label":"D","text":"40"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["source_attribution_or_footer","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-99f5344934dd","stem":"Consider two aqueous solutions of different concentration separated by a semi-­ permeable membrane. In this situation, osmosis results in","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"water molecules moving to the side where the solution concentration is lower."},{"label":"B","text":"the more concentrated solution becoming even more concentrated."},{"label":"C","text":"the more dilute solution becoming even more dilute."},{"label":"D","text":"the more concentrated solution becoming more dilute."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-2ed09e62e73e","stem":"Osmosis may be defined as which of the following?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The diffusion of water molecules across a semi-permeable membrane from the solution with higher water concentration into the solution of lower water concentration."},{"label":"B","text":"The movement of water molecules across a semi-permeable membrane from the solution of higher concentration into the solution of lower concentration."},{"label":"C","text":"The diffusion of solute particles across a semi-permeable membrane from the solution of higher concentration into the solution of lower concentration."},{"label":"D","text":"The movement of water molecules across a semi-permeable membrane from the solution of lower concentration into the solution of higher concentration."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-eba506c0a207","stem":"What is the movement of water molecules across a plasma membrane from the side where the solution concentration is more dilute to the side where the solu- tion is more concentrated called?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"osmosis"},{"label":"B","text":"reverse osmosis"},{"label":"C","text":"diffusion"},{"label":"D","text":"hydration"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"eb24b6f83e5eec9c23391d13ad4a862d06c14444"},{"id":"q-3fee1f238a76","stem":"The movement of water molecules through a plasma membrane from the side where there is a higher concentration water molecules to the side where there are fewer, is best known as","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"diffusion"},{"label":"B","text":"osmosis"},{"label":"C","text":"pinocytosis"},{"label":"D","text":"hydrolysis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-9c9dbab1f0e7","stem":"The diffusion of water molecules across a cell membrane from the side where the solution concentration is more dilute to the side where it is greater, is known as which of the following?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"osmosis"},{"label":"B","text":"filtration"},{"label":"C","text":"hydrolysis"},{"label":"D","text":"buffer action"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-9cbf2c36fb23","stem":"If a semi-permeable membrane separates two aqueous solutions with different osmotic pressures, what will be the direction of water flow between solutions? From","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"higher osmotic pressure to the solution of lower osmotic pressure."},{"label":"B","text":"lower osmotic pressure to the solution of higher osmotic pressure."},{"label":"C","text":"higher concentration to the solution of lower concentration."},{"label":"D","text":"higher hydrostatic pressure to the solution of lower hydrostatic pressure."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-dcd9ff51f306","stem":"During dialysis, what moves across a semi-permeable membrane (and how)?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Water molecules by diffusion from the region of high solute concentration to the region of low solute concentration."},{"label":"B","text":"Water molecules by filtration from the region of high hydrostatic pressure to the region of low hydrostatic pressure."},{"label":"C","text":"Solutes by diffusion from the region of high solute concentration to the region of low solute concentration."},{"label":"D","text":"Solutes by filtration from the region of low hydrostatic pressure to the region of high hydrostatic pressure. 64 4 Chemistry for Physiology"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"274f041c420101ed01b01e45da8913295debce0e"},{"id":"q-3c18cbe5c254","stem":"A suitable definition of osmosis would be movement","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"of solute particles through a plasma membrane from the side where their concentration is greatest to the side where it is lower."},{"label":"B","text":"of water molecules through a plasma membrane from the side where their concentration is greatest to the side where it is lower."},{"label":"C","text":"of a substance from a region where it is in high concentration to where its concentration is lower"},{"label":"D","text":"caused by a hydrostatic pressure difference."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-677b329cca8f","stem":"The difference between dialysis and diffusion is that","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"dialysis involves the movement of water molecules."},{"label":"B","text":"diffusion involves movement against the concentration gradient."},{"label":"C","text":"dialysis involves passive movement through a cell membrane."},{"label":"D","text":"diffusion is caused by a hydrostatic pressure difference."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-565514ba9c6b","stem":"Osmosis involves the movement of","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"water molecules through a membrane from a region of higher concentration of water molecules to a region of lower water molecule concentration."},{"label":"B","text":"solute particles from a region of higher solution concentration to a region of lower solution concentration."},{"label":"C","text":"water molecules from a region of lower concentration of water to a region of higher water molecule concentration."},{"label":"D","text":"solute particles through a membrane from a region of lower solute concen- tration to a region of higher solute concentration."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-4cefcdb0fd04","stem":"What does “osmosis” refer to?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the constant random motion of ions and molecules."},{"label":"B","text":"the movement of ions and molecules from regions of high concentration to regions of low concentration."},{"label":"C","text":"the movement of water molecules through a semi-permeable membrane."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"72a0485fe26ef08e337b9378d47ab8ce125d3c60"},{"id":"q-eca885c1f437","stem":"What is the difference between filtration and diffusion?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Diffusion can occur through a biological membrane whereas filtration cannot."},{"label":"B","text":"Filtration can occur through a biological membrane whereas diffusion cannot."},{"label":"C","text":"Filtration is the movement of molecules caused by a pressure difference but diffusion does not involve a difference in pressure."},{"label":"D","text":"Diffusion is the movement of molecules caused by a pressure difference but filtration does not involve a difference in pressure."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-a95a2cde8366","stem":"What is the difference between osmosis and dialysis?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Dialysis involves the movement of solute molecules whereas osmosis refers to water molecules."},{"label":"B","text":"Osmosis involves the movement of solute molecules whereas dialysis refers to water molecules."},{"label":"C","text":"Osmosis involves movement of molecules across a membrane but dialysis does not involve a membrane."},{"label":"D","text":"Dialysis involves movement of molecules across a membrane but osmosis does not involve a membrane."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-efb942e47c9c","stem":"Which one of the following processes that describe movement of the particles in a solution does NOT require passing through a membrane?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thoracic Wall and Mediastinum · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Thoracic Wall and Mediastinum","options":[{"label":"A","text":"diffusion"},{"label":"B","text":"filtration"},{"label":"C","text":"dialysis"},{"label":"D","text":"osmosis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thoracic Wall and Mediastinum · Suggested","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-ba3bebcd11c9","stem":"Which statement about the osmotic pressure of an aqueous solution is correct? Osmotic pressure","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"is an indication of the force with which pure water moves into that solution."},{"label":"B","text":"is a measure of the tendency of water to move into the solution. 66 4 Chemistry for Physiology"},{"label":"C","text":"is the drawing power of water and depends on the number of molecules in the solution."},{"label":"D","text":"of a solution is called its osmolarity in mosmol/kg."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"fbade74753ee8300ec95f4b2e7fda2203cde4069"},{"id":"q-3b4663bf552d","stem":"Diffusion is the term given to the process where","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"molecules move along their concentration gradient from high concentration to low concentration."},{"label":"B","text":"water moves along its concentration gradient from low concentration to high concentration."},{"label":"C","text":"ATP is used to move ions along their concentration gradient."},{"label":"D","text":"a membrane protein, by changing shape after binding to a molecule, moves the molecule across the plasma membrane."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-478b345abf4c","stem":"By what name is the movement of solute particles through a selectively perme- able membrane, in the direction of their concentration gradient known?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"diffusion"},{"label":"B","text":"dialysis"},{"label":"C","text":"osmosis"},{"label":"D","text":"filtration"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-cc3899a76ada","stem":"Blood has a slightly higher osmotic pressure than the interstitial fluid that sur- rounds capillaries. What is the effect of this?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Histology and Tissues","topicOriginal":"Histology and Tissues","subtopic":"Capillar","suggestedTopic":null,"options":[{"label":"A","text":"Water will tend to move from the interstitial fluid into the capillaries."},{"label":"B","text":"The solution concentration of blood is less than the solution concentration of interstitial fluid."},{"label":"C","text":"Water will tend to move from the capillaries into the interstitial fluid."},{"label":"D","text":"Capillaries will expand in diameter."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Histology and Tissues","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-b89578fbf502","stem":"Consider a patient undergoing kidney dialysis, whose blood has bicarbonate at a concentration of 14 mmol/L and urea at 23 mmol/L. The dialysing liquid has bicarbonate at 32 mmol/L and urea at 0 mmol/L. In which direction will these substances flow?","type":"Clinical Vignette","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-8ec209178d7d","stem":"3 Diffusion and Osmosis 67","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"bicarbonate will flow from patient’s blood to dialysing liquid, urea will flow from patient’s blood into dialysing liquid."},{"label":"B","text":"bicarbonate will flow from dialysing liquid to patient’s blood, urea will flow from dialysing liquid into patient’s blood."},{"label":"C","text":"bicarbonate will flow from dialysing liquid to patient’s blood, urea will flow from patient’s blood into dialysing liquid."},{"label":"D","text":"bicarbonate will flow from patient’s blood to dialysing liquid, urea will flow from dialysing liquid to patient’s blood."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-305ca1161993","stem":"Which is the best description for the osmotic pressure of a solution?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A: the pressure that needs to be applied to the solution while it is separated from pure water by a membrane, to prevent a net flow of water through the membrane into the solution."},{"label":"B","text":"B: the force with which pure water moves through a membrane into that solution as a result of its solute concentration."},{"label":"C","text":"C: the movement of particles through a membrane, where the movement is caused by a hydrostatic pressure."},{"label":"D","text":"D: it is the force of attraction for water by undissolved particles in the solution."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-c5d8da818887","stem":"In which of the following situations would the osmotic pressure of blood be the greatest?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"in a patient whose blood osmolarity is 290 mosmol/L"},{"label":"B","text":"in a patient whose blood osmolarity is 280 mosmol/L and whose urine spe- cific gravity is 1.002"},{"label":"C","text":"in a patient with hyperthermia"},{"label":"D","text":"in a patient who is dehydrated"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-e56b0323167d","stem":"Osmosis involves movement of water from where the","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"water concentration is lower to where it is higher"},{"label":"B","text":"solute concentration is higher to where it is lower 68 4 Chemistry for Physiology"},{"label":"C","text":"solution is more concentrated to where it is less concentrated"},{"label":"D","text":"water concentration is higher to where it is lower"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"9842b7fee0d853297e089efbf01f9d5706fbf862"},{"id":"q-274c0aba2c52","stem":"What is “osmotic pressure”?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the pressure exerted by a solution due to its concentration"},{"label":"B","text":"a measure of solution concentration expressed in the units of pressure"},{"label":"C","text":"the pressure exerted by the blood colloidal plasma proteins"},{"label":"D","text":"the pressure that drives water movement out of the arterial end of capillaries"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-be2aeca81d47","stem":"If a red blood cell (rbc) is placed in a solution that has a greater concentration than that inside the rbc, what will happen?","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the rbc will crenate"},{"label":"B","text":"the rbc will haemolyse"},{"label":"C","text":"there will be a net movement of water out of the rbc into the solution"},{"label":"D","text":"there will be no net movement of water out of the rbc"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-6b825f2833ad","stem":"One of the following is an example of osmosis. Which one?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"water moving from the glomerulus of a nephron into the Bowman’s capsule"},{"label":"B","text":"water leaving a blood capillary from close to its arteriole end, to enter the interstitial fluid"},{"label":"C","text":"water entering a red blood cell that is in a 0.8% sodium chloride solution, by passing through its plasma membrane"},{"label":"D","text":"water evaporating from perspiration on the skin"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-71ae1803552f","stem":"The Na+/K+ ATPase pump in the plasma membrane moves Na out of the cell and K into the cell against their concentration gradient. Then Na reenters the cell and K leaks out of the cell, along their concentration gradients through their membrane channels. What is the movement of Na and K along their concentra- tion gradients called?","type":"Short Answer","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-13df19cb3d39","stem":"4 Tonicity, Moles and Osmoles 69","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Active transport"},{"label":"B","text":"Diffusion"},{"label":"C","text":"Facilitated diffusion"},{"label":"D","text":"Osmosis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-915dc8d8b1e3","stem":"Which of the following statements is FALSE?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Filtration is movement of water caused by a difference in hydrostatic pres- sure, while diffusion results from a difference in concentration."},{"label":"B","text":"Both diffusion and filtration will tend to continue till there is an equal amount on both sides of the membrane."},{"label":"C","text":"Any hypertonic solution has a concentration lower than that of blood while a hypotonic solution has a concentration greater than the blood."},{"label":"D","text":"Water moves into a red blood cell resulting in haemolysis, and out of a cell by a process called plasmolysis."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"],"duplicateStemGroup":"ddd53843a7c3208057acb162a2c5585b42e5b16c"},{"id":"q-9365c6b454fb","stem":"What information does the molarity of a solution provide?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the density of a solution"},{"label":"B","text":"the number of dissolved particles per litre of solution"},{"label":"C","text":"the mass of a mole of the substance"},{"label":"D","text":"the tonicity of the solution"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-222d07d30589","stem":"What term is applied to an intravenous solution that would cause a net move- ment of water out of red blood cells?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"hypertonic"},{"label":"B","text":"supertonic"},{"label":"C","text":"epitonic"},{"label":"D","text":"hypotonic"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-309998e92c11","stem":"What is a definition of an osmole? The amount of substance that","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"must be dissolved to produce 6 × 1023 solute particles."},{"label":"B","text":"must be dissolved to produce an osmotic pressure of 1.0 mmHg."},{"label":"C","text":"must be dissolved to produce an isotonic solution."},{"label":"D","text":"contains 6 × 1023 particles."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-6c61f0b2373e","stem":"Choose the solution below that has the lowest concentration of dissolved particles.","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"0.9 % NaCl"},{"label":"B","text":"isotonic powerade"},{"label":"C","text":"5 % glucose"},{"label":"D","text":"hypotonic saline"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-7a9a0667bd2e","stem":"What can be correctly said of an isotonic intravenous solution? An isotonic solution","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"causes water to move out of red blood cells."},{"label":"B","text":"causes no net movement of water into or out of red blood cells."},{"label":"C","text":"has the same solutes in the same solution concentration as blood plasma"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"2c558d5db9ded86b4e9a2870d0549554ce2d980f"},{"id":"q-689b410b6d74","stem":"What would be the concentration of a solution that causes red blood cells placed in it to swell?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"hypotonic"},{"label":"B","text":"isotonic"},{"label":"C","text":"hypertonic"},{"label":"D","text":"iso-osmotic"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-9dae3e2e4586","stem":"The unit milliosmoles per litre (mosmol/L) refers to which of the following?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the number of particles in solution, in multiples of 6 × 1020 per litre."},{"label":"B","text":"103 times the number of moles of particles in a litre of solution."},{"label":"C","text":"the number of molecules per litre of solution."},{"label":"D","text":"the number of moles per millilitre of solution."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["answer_text_in_option","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-f4a9a40aaa44","stem":"A hypertonic solution is one which","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"has an osmotic pressure that is different to that inside red blood cells"},{"label":"B","text":"has an osmolarity less than that of red blood cells"},{"label":"C","text":"causes no net movement of water through the membrane of red blood cells"},{"label":"D","text":"has an osmolarity greater than that of red blood cells"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-c9af01f8e300","stem":"Given that one mole of Na+Cl− has a mass of 58.5 g, what would be the concen- tration of particles when 0.9 g of Na+Cl− is dissolved in 100 ml of water?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"117 mmol/L"},{"label":"B","text":"150 mmol/L"},{"label":"C","text":"150 mosmol/L"},{"label":"D","text":"300 mosmol/L Na+Cl−. However NaCl separates into ions when dissolved, so that there will be"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"59518de878b375e1b7b2ea1419a7d71fc31681a6"},{"id":"q-ac07f80a668d","stem":"The unit millimoles per litre (mmol/L) refers to which of the following?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the number of particles in solution, in multiples of 6 × 1020 per litre."},{"label":"B","text":"103 times the number of moles of particles in a litre of solution."},{"label":"C","text":"the number of molecules per litre of solution."},{"label":"D","text":"the number of moles per millilitre of solution."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-27b713500d49","stem":"An isotonic solution is one which","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"has an osmotic pressure that is different to red blood cells"},{"label":"B","text":"has an osmolarity less than that of red blood cells"},{"label":"C","text":"causes no net movement of water between the solution and red blood cells"},{"label":"D","text":"has an osmolarity greater than that of red blood cells"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-8c37d206a6a5","stem":"A hypotonic solution may be characterised by which of the following?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"a solution whose osmolarity is greater than that of blood."},{"label":"B","text":"one that causes red blood cells to crenate."},{"label":"C","text":"a solution within the range 280–300 mosmol/L"},{"label":"D","text":"one that causes a net water movement into red blood cells."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-ffc89bce45eb","stem":"Whi