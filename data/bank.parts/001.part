acology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Antagonism"},{"label":"B","text":"Potentiation"},{"label":"C","text":"Additive effect"},{"label":"D","text":"None of the above"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"independently_reasoned_provisional_oct20","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7d38a6e5f272","stem":"What does the term “potentiation” mean?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cumulative ability of a drug"},{"label":"B","text":"Hypersensitivity to a drug"},{"label":"C","text":"Fast tolerance developing"},{"label":"D","text":"Intensive increase of drug effects due to their combination"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"independently_reasoned_provisional_oct20","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0866e8cb8e88","stem":"The types of antagonism are","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Summarized"},{"label":"B","text":"Potentiated"},{"label":"C","text":"Additive"},{"label":"D","text":"Competitive"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"independently_reasoned_provisional_oct20","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6eee3a3d8f56","stem":"The term “chemical antagonism” means that","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"two drugs combine with one another to form an inactive compound"},{"label":"B","text":"two drugs combine with one another to form a more active compound"},{"label":"C","text":"two drugs combine with one another to form a more water soluble compound"},{"label":"D","text":"two drugs combine with one another to form a more fat soluble compound"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"independently_reasoned_provisional_oct20","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9006f49ec170","stem":"A teratogenic action is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Toxic action on the liver"},{"label":"B","text":"Negative action on the fetus causing fetal malformation"},{"label":"C","text":"Toxic action on blood system"},{"label":"D","text":"Toxic action on kidneys"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"independently_reasoned_provisional_oct20","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_gen