playTopic":"Upper Limb","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"43c0d9bc3f13058a559710cadf814fddb160c9be"},{"id":"q-664c2450821c","stem":"Which of the following pair is correctly matched?","type":"Short Answer","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"9986536913725fa7ba93f6d1fbc81d08a1661ad8"},{"id":"q-370c8b3ed776","stem":"A young man is brought to the hospital after sustaining injury to the right hip in motor traffic accident. The patient is conscious with normal vital sign. Local examination revealed that the right hip is flexed, externally rotated abducted and the limb is elongated. The most likely diagnosis of this patient is","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Central hip dislocation"},{"label":"B","text":"Anterior hip dislocation"},{"label":"C","text":"Posterior hip dislocation"},{"label":"D","text":"Closed fracture of femur"},{"label":"E","text":"Fracture dislocation of the femur"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"53ea46401fda9b3228a0dde0774798121d3a212f"},{"id":"q-9e12633b9ef9","stem":"An old woman 79 years slipped and fell down at home. She was not able to stand up immediately after the injury. On examination, her right leg was externally rotated amd shortened. The likely diagnosis will be; Which of the following is an example of syndesmoses?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ankle joint dislocation."},{"label":"B","text":"Knee joint dislocation"},{"label":"C","text":"Fracture of the distal femur"},{"label":"D","text":"Fracture of the neck of femur"},{"label":"E","text":"Anterior dislocation of the hip joint"},{"label":"A","text":"coronal suture B. distal tibiofibular joint"},{"label":"C","text":"hip joint D. intercarpal joints"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"ff676b95b12cbf9ca685c4eba26ca2dc82decef5"},{"id":"q-9693965e22c6","stem":"Which of the following movements are possible in pivot joint?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"flexion and extension B. adduction and abduction"},{"label":"C","text":"rotation D. extension flexion and rotation"}],"priority":2,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"e38842dc98755da001055dc780c78b06a7e98815"},{"id":"q-9c6e611f1455","stem":"Which of the following is known as a bony joint?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"synostosis B. symphysis"},{"label":"C","text":"syndesmoses d. interosseous membrane"}],"priority":2,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"e1e39c03c01f9231f46316cae88ee670098c6580"},{"id":"q-00566423f692","stem":"What do you mean by the movement adduction?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"decrease in the angle between the bones"},{"label":"B","text":"increase in the angle between the bones"},{"label":"C","text":"movement of bone toward the midline"},{"label":"D","text":"movement of bone away from the midline"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"00d546c5a9a4745bc09b761cc33f5cc386086810"},{"id":"q-d1a2d656bc90","stem":"Which of the following are the part of functional classification?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ellipsoidal B. GOMPHOSIS"},{"label":"C","text":"Syndesmoses D. none of the above"}],"priority":2,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"39ce0b20ab65905ec3b5a6409481a47696adb26b"},{"id":"q-2a10a282a4a3","stem":"Which the following is not the unique features of synovial joint?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Articular capsule B. articular cartilage"},{"label":"C","text":"synovial fluid D. fibro cartilage"}],"priority":0,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"893db0bac0e4d191a4cdcc81c2872988ad71c031"},{"id":"q-12e0bafddf7d","stem":"What are the supporting cells in the central nervous system called?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Schwann cells"},{"label":"B","text":"Basket cells"},{"label":"C","text":"Ganglion"},{"label":"D","text":"Neuroglia"},{"label":"E","text":"Satellite cells Schwann cells are responsible for the myelination of neurons in the peripheral nervous system. Basket cells are a type of neuron seen in the cerebellum. A ganglion is a collection of nerve cell bodies outside of the CNS. Neuroglia are the supporting cells in the central nervous system Sometimes, neuroglia called glial cells or glia. Satellite cells are found in the ganglia of the peripheral nervous system."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"eab87d0dea2934843bab7a98044288989fc71a7b"},{"id":"q-e444ea182be1","stem":"Which of the following is an element of the peripheral nervous system?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Receptors"},{"label":"B","text":"Brachial plexus"},{"label":"C","text":"Ganglia"},{"label":"D","text":"Sciatic nerve"},{"label":"E","text":"All of the above"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"d3e6f0c58f239f77e9a0c5434d82380184166373"},{"id":"q-ecbcaec8cc2d","stem":"What are most neurons in the body?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Unipolar"},{"label":"B","text":"Pseudounipolar"},{"label":"C","text":"Bipolar"},{"label":"D","text":"Multipolar"},{"label":"E","text":"Both a and b Most neurons in the body (over 99%) are multipolar. Neurons can be classified based on the number of axons and dendrites stemming off of the cell body. A unipolar neuron has one process which branches off of it This process then immediately divides into two. Thus, a unipolar neuron is sometimes also called a pseudounipolar neuron. Sensory neurons are unipolar. A bipolar neuron has two process that branch from it: an axon and a dendrite. Bipolar neurons are not very common and are found in some of the organs for special senses. Bipolar neurons are found in the retina, inner ear, and the region of the nose involved with smell. Multipolar neurons have one axon and many (at least two) dendrites that branch off of it. Most neurons are multipolar. Motor neurons and interneurons are multipolar."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"44637d5d148d69f525689e06c479b2f0b327bf90"},{"id":"q-d30451a34fc1","stem":"What is the cell body of a neuron called?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ganglion"},{"label":"B","text":"Perikaryon"},{"label":"C","text":"Astrocyte"},{"label":"D","text":"Nissl"},{"label":"E","text":"Terminal bouton"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"2624f1a7d82c529d78248133d5b40dbded293844"},{"id":"q-88e0b0fe03b8","stem":"Which cell is a macrophage found in the central nervous system?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Kupffer cells"},{"label":"B","text":"Histiocyte"},{"label":"C","text":"Dust cell"},{"label":"D","text":"Langerhans cell"},{"label":"E","text":"Microglia Macrophages are mononuclear phagocytes. Many tissues have resident (fixed) macrophages. Fixed macrophages are given a unique name, depending on the tissue that they are located in. Kupffer cells are the hepatic macrophages. Histiocytes are macrophages seen in connective tissue. Dust cells are alveolar macrophage found in the respiratory tract. Langerhans cells are macrophages seen in the skin. Microglia are the central nervous system macrophages."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"bf73838025e9fac35a3568cc6cadb9bddaa4de38"},{"id":"q-7b3f3dc7cb08","stem":"Which type of neuron is multipolar?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Motor neurons"},{"label":"B","text":"Interneurons"},{"label":"C","text":"Sensory neurons"},{"label":"D","text":"Both a and b"},{"label":"E","text":"All of the above Both motor neurons and interneurons are multipolar."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"25bb29efbb35305a6510f63017c5caeca11be4d3"},{"id":"q-d6a83814bc7b","stem":"What provides tensile strength to a neuron?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Meninges"},{"label":"B","text":"Myelinated nerve fibers"},{"label":"C","text":"Cell bodies"},{"label":"D","text":"Nodes of Ranvier"},{"label":"E","text":"Neurofilaments"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"25f9428a461fc2643ddc65770414f2d9019ba737"},{"id":"q-04159d504abf","stem":"Which meninx is made of a delicate web like connective tissue?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Dura mater"},{"label":"B","text":"Arachnoid"},{"label":"C","text":"Pia mater"},{"label":"D","text":"Both a and b"},{"label":"E","text":"All of the above"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"5eef5fc00c789e405432c4f83c6de041a1224ae0"},{"id":"q-0d704c38e167","stem":"What are the conglomerations of gray matter deep within the cerebrum and cerebellum called? Which of the following is involved in the blood brain barrier?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Tracts"},{"label":"B","text":"Islets"},{"label":"C","text":"Soma"},{"label":"D","text":"Cortex"},{"label":"E","text":"Nuclei A group of fibers traveling together to a destination is a tract. Islets of Langerhans are seen in the pancreas. Soma is another term for a neuron cell body. The outer part of the brain is gray matter called the cortex. The conglomerations of gray matter deep within the cerebrum and cerebellum are called nuclei. 10."},{"label":"A","text":"Astrocytes"},{"label":"B","text":"Ependymal cells"},{"label":"C","text":"Oligodendrocytes"},{"label":"D","text":"Microglia"},{"label":"E","text":"Schwann cells"}],"priority":2,"status":"review","flags":["topic_generic","too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","too_many_options","too_many_options_possible_merge","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"ad1181d09c23f399dd6e3064d2418d1e29e56f16"},{"id":"q-006c89d08b5a","stem":"Which of the following forms myelin in the peripheral nervous system?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Schwann cells"},{"label":"B","text":"Basket cells"},{"label":"C","text":"Ganglion"},{"label":"D","text":"Neuroglia"},{"label":"E","text":"Satellite cells Schwann cells are responsible for the myelination of neurons in the peripheral nervous system. Basket cells are a type of neuron seen in the cerebellum. A ganglion is a collection of nerve cell bodies outside of the CNS. Neuroglia are the supporting cells in the central nervous system Sometimes, neuroglia called glial cells or glia. Satellite cells are found in the ganglia of the peripheral nervous system."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"401b40613a8570e93538254c4a63e92d9817d50d"},{"id":"q-233f4e43a914","stem":"Which of the following is an element of the central nervous system?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Receptors"},{"label":"B","text":"Brachial plexus"},{"label":"C","text":"Sciatic nerve"},{"label":"D","text":"Ganglia"},{"label":"E","text":"Spinal cord"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"d0acff56a925848c055b9e1e600ba3d8188618cd"},{"id":"q-5674354b679b","stem":"What are motor neurons?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Unipolar"},{"label":"B","text":"Pseudounipolar"},{"label":"C","text":"Bipolar"},{"label":"D","text":"Multipolar"},{"label":"E","text":"Both a and b Motor neurons are multipolar. Neurons can be classified based on the number of axons and dendrites stemming off of the cell body. A unipolar neuron has one process which branches off of it This process then immediately divides into two. Thus, a unipolar neuron is sometimes also called a pseudounipolar neuron. Sensory neurons are unipolar. A bipolar neuron has two process that branch from it: an axon and a dendrite. Bipolar neurons are not very common and are found in some of the organs for special senses. Bipolar neurons are found in the retina, inner ear, and the region of the nose involved with smell. Multipolar neurons have one axon and many (at least two) dendrites that branch off of it. Most neurons are multipolar. Motor neurons and interneurons are multipolar."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"e8b13ec0f3f492780359a35923deeed2e5404f5a"},{"id":"q-49ab1a1283db","stem":"What is a collection of cell bodies outside the CNS called?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ganglion"},{"label":"B","text":"Perikaryon"},{"label":"C","text":"Astrocyte"},{"label":"D","text":"Nissl"},{"label":"E","text":"Terminal bouton"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"70469970e6a36340f50c18b7e969446e08909753"},{"id":"q-12e614658f9c","stem":"What is tissue which surrounds a nerve fascicle?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Perimysium"},{"label":"B","text":"Periosteum"},{"label":"C","text":"Perichondrium"},{"label":"D","text":"Perineurium"},{"label":"E","text":"Endosteum"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"d7c2ae3c650e6aba060e63961c64a40d4293ba75"},{"id":"q-a408e6740332","stem":"The colloquialism \"gray matter\" refers to somebody using his intellect or reasoning ability. In reality, what is gray matter?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Meninges"},{"label":"B","text":"Myelinated nerve fibers"},{"label":"C","text":"Cell bodies"},{"label":"D","text":"Nodes of Ranvier"},{"label":"E","text":"Neurofilaments"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"f80362f21c1708253bd06ae93c36b75cd9155120"},{"id":"q-d8e99b5bc453","stem":"Where is the cerebrospinal fluid?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Between the dura mater and bone"},{"label":"B","text":"Subdural space"},{"label":"C","text":"Subarachnoid space"},{"label":"D","text":"Between the pia mater and brain"},{"label":"E","text":"None of the above"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"2dc5d7d743fda6c366e850b229691c538d0b0d9e"},{"id":"q-0ed9548e6b68","stem":"Which of the following are considered to be part of the meninges?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Dura mater"},{"label":"B","text":"Arachnoid"},{"label":"C","text":"Pia mater"},{"label":"D","text":"Both a and c"},{"label":"E","text":"All of the above"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"611ee9173596e581bc9cf2af37249cdf682a7777"},{"id":"q-276178eafac8","stem":"What is the outer gray matter of the brain called?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Tracts"},{"label":"B","text":"Islets"},{"label":"C","text":"Soma"},{"label":"D","text":"Cortex"},{"label":"E","text":"Nuclei"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"eaf8f070b26ef4037e0cfabbbc25f066561881d1"},{"id":"q-998442657820","stem":"Which of the following is the most abundant neuroglia cell?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Astrocytes"},{"label":"B","text":"Ependymal cells"},{"label":"C","text":"Oligodendrocytes"},{"label":"D","text":"Microglia"},{"label":"E","text":"Schwann cells Neuroglia are the supporting cells of the central nervous system. Sometimes, neuroglia called glial cells or glia. Astrocytes, ependymal cells, oligodendrocytes, and microglia are all neuroglia. Of the neuroglia cells, astrocytes are the most abundant and the largest. These are star shaped cells involved in the blood brain barrier. Ependymal cells line the ventricles and spinal canal. Oligodendrocytes form myelin in the central nervous system. Microglia are the central nervous system macrophages. Schwann cells are seen in the peripheral nervous system and are not considered neuroglia. Schwann cells are responsible for the myelination of neurons in the peripheral nervous system."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"562a7b831e194b5506966ec61dafaa1f6fccba95"},{"id":"q-0c06c84fb537","stem":"Which of the following is a supporting cell found in the ganglia?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Schwann cells"},{"label":"B","text":"Basket cells"},{"label":"C","text":"Ganglion"},{"label":"D","text":"Neuroglia"},{"label":"E","text":"Satellite cells Schwann cells are responsible for the myelination of neurons in the peripheral nervous system. Basket cells are a type of neuron seen in the cerebellum. A ganglion is a collection of nerve cell bodies outside of the CNS. Neuroglia are the supporting cells in the central nervous system Sometimes, neuroglia called glial cells or glia. Satellite cells are found in the ganglia of the peripheral nervous system."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"999c203f38653bc8b01b4217109327d9d24f35ea"},{"id":"q-8e2e85fd8039","stem":"Which of the following is an element of the central nervous system?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Receptors"},{"label":"B","text":"Brachial plexus"},{"label":"C","text":"Brain"},{"label":"D","text":"Ganglia"},{"label":"E","text":"Sciatic nerve"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"d0acff56a925848c055b9e1e600ba3d8188618cd"},{"id":"q-7e8e10a8dc85","stem":"What are interneurons?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Unipolar"},{"label":"B","text":"Pseudounipolar"},{"label":"C","text":"Bipolar"},{"label":"D","text":"Multipolar"},{"label":"E","text":"Both a and b Interneurons are multipolar. Neurons can be classified based on the number of axons and dendrites stemming off of the cell body. A unipolar neuron has one process which branches off of it This process then immediately divides into two. Thus, a unipolar neuron is sometimes also called a pseudounipolar neuron. Sensory neurons are unipolar. A bipolar neuron has two process that branch from it: an axon and a dendrite. Bipolar neurons are not very common and are found in some of the organs for special senses. Bipolar neurons are found in the retina, inner ear, and the region of the nose involved with smell. Multipolar neurons have one axon and many (at least two) dendrites that branch off of it. Most neurons are multipolar. Motor neurons and interneurons are multipolar."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"5ad25efb7f146a2ca32c589ad9774a492eee5888"},{"id":"q-7fe2ffd54104","stem":"Which of the following is supporting cell of the central nervous system?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ganglion"},{"label":"B","text":"Perikaryon"},{"label":"C","text":"Astrocyte"},{"label":"D","text":"Nissl"},{"label":"E","text":"Terminal bouton"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"faf5a9a7a72b9df8deedd5cb63e976a40ff377ba"},{"id":"q-33d3e39a12d1","stem":"How many neurons are in the body of man?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"10,000 (10 to the 4th)"},{"label":"B","text":"10,000,000 (10 to the 7th)"},{"label":"C","text":"10,000,000,000 (10 to the 10th)"},{"label":"D","text":"10,000,000,000,000 (10 to the 13th)"},{"label":"E","text":"10,000,000,000,000,000 (10 to the 16th"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"cd2482d0b774f975dbba87e41aa9afec812038a8"},{"id":"q-6cbf3a6fbb4f","stem":"What are the gaps that occur within the myelin sheath?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Meninges"},{"label":"B","text":"Myelinated nerve fibers"},{"label":"C","text":"Cell bodies"},{"label":"D","text":"Nodes of Ranvier"},{"label":"E","text":"Neurofilaments"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"906a8860e7fc13c1d1509a3cb1955027ce619b71"},{"id":"q-f74cfaa1826f","stem":"What is the dura mater composed of?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Loose irregular connective tissue"},{"label":"B","text":"Dense irregular connective tissue"},{"label":"C","text":"Dense regular connective tissue"},{"label":"D","text":"Simple squamous epithelium"},{"label":"E","text":"Nervous tissue"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"0cd7a88fdcd5e5efd93d97a509e0f07ef5902d95"},{"id":"q-60cb17355070","stem":"Where is gray matter?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Outer surface of the cerebrum and cerebellum"},{"label":"B","text":"Outer surface of the spinal cord"},{"label":"C","text":"Inner portion of the spinal cord"},{"label":"D","text":"Both a and b"},{"label":"E","text":"Both a and c"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"d473cf9a299560bf28f2489ddb4a765acf747ccc"},{"id":"q-cf34eaf948e0","stem":"What surrounds a nerve?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Neurium"},{"label":"B","text":"Perineurium"},{"label":"C","text":"Epineurium"},{"label":"D","text":"Endoneurium"},{"label":"E","text":"None of the above"}],"priority":0,"status"