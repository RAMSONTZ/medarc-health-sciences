,"subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the neurovascular bundle runs in the plane between external intercostal and internal intercostal muscles"},{"label":"B","text":"neurovascular structures lie in the order of nerve, artery, vein from above downwards"},{"label":"C","text":"the upper two spaces are supplied by the supreme intercostal artery"},{"label":"D","text":"the collateral branches of the intercostal artery and nerve run along the upper border of the rib that forms the lower boundary of the space"},{"label":"E","text":"the collateral branch of the intercostal nerve supplies skin over the space"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-8951defa8548","stem":"Which is NOT USUALLY supplied by the left coronary artery?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Thorax","suggestedTopic":null,"options":[{"label":"A","text":"conus artery"},{"label":"B","text":"circumflex artery"},{"label":"C","text":"anterior interventricular artery"},{"label":"D","text":"anterior fibres of left bundle"},{"label":"E","text":"posterior fibres of left bundle"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-458759927382","stem":"Which is NOT a surface marking of the pleura?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"right and left pleura meet each other in midline anteriorly at level of the sternal angle"},{"label":"B","text":"both cross the midclavicular line at the 6th rib"},{"label":"C","text":"both cross the midaxillary line at the 10th rib"},{"label":"D","text":"both cross the 12th rib at the lateral border of erector spinae"},{"label":"E","text":"both pass under the 12th costovertebral angle"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-eaf47eb24b83","stem":"Which of the following bronchi is called the epartenol bronchus?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"left superior bronchus"},{"label":"B","text":"left inferior bronchus"},{"label":"C","text":"right superior bronchus"},{"label":"D","text":"right middle bronchus"},{"label":"E","text":"right inferior bronchus"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["option_whitespace_norma