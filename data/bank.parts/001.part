from option D"],"duplicateStemGroup":"8764069dd8c8ac1ddb4753f486e5afa2ad50c741"},{"id":"q-3d6614c4d426","stem":"What do solutions of 5 % glucose, 9.5 % sucrose and 0.9 % sodium chloride have in common? They","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"all have the same concentration"},{"label":"B","text":"are all hypotonic to plasma"},{"label":"C","text":"all contain the same number of dissolved particles per unit volume."},{"label":"D","text":"are all hypertonic to plasma"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-526217a402aa","stem":"An intravenous fluid that is hypertonic to blood would have what effect on the red blood cells?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"it would have no effect."},{"label":"B","text":"the number of red blood cells would increase"},{"label":"C","text":"red blood cells would lyse."},{"label":"D","text":"it would cause red blood cells to crenate."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-0bd3fb7e4a1f","stem":"An intravenous fluid that is isotonic to blood would have what effect on the red blood cells?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"it would have no effect."},{"label":"B","text":"it would cause red blood cells to crenate."},{"label":"C","text":"red blood cells would lyse."},{"label":"D","text":"the blood volume would increase."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-435dab3b4fdd","stem":"What may be said of isotonic solutions? They have","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"had added the same number of moles of solid substance per volume of solution."},{"label":"B","text":"the same number of grams of solute per volume of solution."},{"label":"C","text":"the same percent concentration."},{"label":"D","text":"the same number of dissolved particles per volume of solution."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-371165aa07cc","stem":"Fructose is a sugar with a molecular formula C6H12O6. Given that the atomic weights 