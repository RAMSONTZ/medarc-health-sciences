:"ATP."},{"label":"B","text":"muscle glycogen."},{"label":"C","text":"lactic acid."},{"label":"D","text":"Creatine phosphate. c"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-630563a28394","stem":"The frequency needed to produce tetanus","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"is increased by cooling."},{"label":"B","text":"is decreased in red muscles."},{"label":"C","text":"is increased in fatigue."},{"label":"D","text":"is decreased in the pale muscles. b"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-bbad2f44a25b","stem":"Action potential","type":"Single Best Answer MCQ","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"is a graded potential."},{"label":"B","text":"is produced by sub threshold stimulus."},{"label":"C","text":"starts with repolarization caused by outward movement of Cl-."},{"label":"D","text":"is conducted slower in thin nerve fibers. d"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3e9d4d60741d","stem":"RMP of a nerve","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"is caused by equal distribution of ions along both sides of the membrane."},{"label":"B","text":"is caused by selective permeability of the membrane to the ions."},{"label":"C","text":"Na+ - K+ pump has no role in RMP."},{"label":"D","text":"is caused mainly by inward movement of Na+ ions. b"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["short_stem","topic_generic"],"cleaningOperations":[]},{"id":"q-3b83b669e320","stem":"As regard conduction of action potential in a nerve","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"in thick myelinated nerve fibers can reach up to 120 meter / second."},{"label":"B","text":"can be increased by increase calcium."},{"label":"C","text":"can be increased by cooling."},{"label":"D","text":"is conducted with decrement. 1 a"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"355f589be2320f279f48b3efc2447cf5621350a1"},{"id":"q-bd16f64ff4c8","stem":"Pale (fast) fiber","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"contains much blood capillaries."},{"label":"B","text":"doesn't show fatigue."},{"label":"C","text":"contains low concentration of myoglobin."},{"label":"D","text":"depends on aerobic oxidation. c"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-015195184ce0","stem":"About cellular sheath ( sheath of Schwann)","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It acts as an electric insulator around the nerve fiber."},{"label":"B","text":"It surrounds the axons of all neurons inside and outside the CNS."},{"label":"C","text":"It is responsible for the color of the white matter of the spinal cord."},{"label":"D","text":"It is essential for regeneration of the damaged verve fibers. d"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-09df2bf0c9e1","stem":"Myelin sheath","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Present in the myelinated and unmyelinated nerve fibers."},{"label":"B","text":"Formed of lipoprotein complex and acts as electric insulator."},{"label":"C","text":"It is formed of successive wrappings of the membrane of Schwann cells."},{"label":"D","text":"It is the cause of decreased conduction of nerve impulse. b"}],"priority":0,"status":"practice_draft","flags":["short_or_incomplete_stem","subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["short_or_incomplete_stem","short_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-5cc2f15aa620","stem":"During depolarization","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"voltage activated Na+ channels open."},{"label":"B","text":"the membrane becomes impermeable to Na+."},{"label":"C","text":"when membrane potential reaches -55 m.v Na+& K+ fluxes occur at the same time."},{"label":"D","text":"K+ ions diffuse outside. a"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-1fbdd3c25c12","stem":"The resting membrane potential is caused by","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Diffusion of K+ ions outside the nerve fibers."},{"label":"B","text":"Diffusion of Na+ ions inside the nerve fibers."},{"label":"C","text":"Opening of the chemically activated ion channels."},{"label":"D","text":"Opening of the voltage activated ion channels. a"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-9a7b93439703","stem":"To measure resting membrane potential","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"We use a special voltmeter or cathode ray oscilloscope (CRO). 2"},{"label":"B","text":"We put the two electrodes outside the nerve fiber."},{"label":"C","text":"We stimulate the nerve by an effective stimulus."},{"label":"D","text":"We put the two electrodes inside the nerve fiber. a"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"c566801153686783f86a38e50184b868809d9de1"},{"id":"q-c269888759f7","stem":"Continuous conduction","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"occurs in myelinated nerve fibers."},{"label":"B","text":"occurs by jumping of charges from one node of Ranvier to another."},{"label":"C","text":"is relatively slow 0.5-2.0 meter / second."},{"label":"D","text":"occurs in the neuro-muscular junction. c"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-0f8f5af11257","stem":"Saltatory conduction","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"occurs in unmyelinated nerve fibers."},{"label":"B","text":"may reach up to 120 meter / second."},{"label":"C","text":"occurs by jumping from one neuron to another."},{"label":"D","text":"decreases gradually with distance till it disappears. b"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,