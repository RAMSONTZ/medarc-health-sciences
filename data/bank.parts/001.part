"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-addeef87a59e","stem":"In the chest wall","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The intercostal artery is more superficial than the vein"},{"label":"B","text":"The intercostal artery lies between the intercostal nerve and vein"},{"label":"C","text":"The transverses muscle lies between the external and internal intercostals"},{"label":"D","text":"The neurovascular bundle lies between the external and internal intercostals"},{"label":"E","text":"All of the above"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"independent_checked","sourceAnswerTrusted":false,"publicationStatus":"checked_explained","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"6c5963fa6e75d42a3025216974069ed7e419af1b"},{"id":"q-3863db90f2ad","stem":"The oesophageal opening in the diaphragm is opposite","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Diaphragm","suggestedTopic":null,"options":[{"label":"A","text":"T6"},{"label":"B","text":"T8"},{"label":"C","text":"T10"},{"label":"D","text":"T11"},{"label":"E","text":"T12"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"