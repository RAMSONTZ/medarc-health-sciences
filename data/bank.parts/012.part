,"text":"Convulsion on withdrawal"},{"label":"E","text":"Cirrhosis of the liver"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"CNS Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"a3483fc0c64c2f5e8010442a51371c972aa63953"},{"id":"q-bb3727e1b34a","stem":"Which of the following occur as a complication of morphine treatment","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"CNS Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"CNS Pharmacology","options":[{"label":"A","text":"Addiction"},{"label":"B","text":"Antihistaminic effect"},{"label":"C","text":"A rise in systemic arterial blood pressure"},{"label":"D","text":"Constriction of smooth muscle sphincters"},{"label":"E","text":"Stimulation of respiratory centre"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"CNS Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"1e1d15eadba640c44d54c735f9530c17def39d42"},{"id":"q-06404c066b66","stem":"heroine (Diamorphine)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"CNS Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"CNS Pharmacology","options":[{"label":"A","text":"Has greater efficacy with less adverse effects than does morphine FROM LUCAS TO LUHIGO,DOGO SOMA HAYO MASWALI YATAKUSAIDIA,ALWAYS TOGETHER BROTHER,I LOVE YOU YOUNG BROTHER 35"},{"label":"B","text":"Has only one proved advantage over morphine that is it is much more lipid soluble"},{"label":"C","text":"Has plasma half life of 3 min"},{"label":"D","text":"Is metabolized in the body to morphine and to 6-acetylmorphine"},{"label":"E","text":"Is used for severe cough"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"CNS Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"1f38eaa535786dd36552fc76365663a662bc7a7d"},{"id":"q-bbb3dc9654c5","stem":"Lignocaine; a local anaesthetic","type":"Single Best Answer MCQ","subject":"Anesthesiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"prevents the rapid inflow of sodium ions which is the ionic basis of action potential"},{"label":"B","text":"causes vasoconstriction"},{"label":"C","text":"is not absorbed from the urethra"},{"label":"D","text":"can be combined with adrenaline for digital ring blocks"},{"label":"E","text":"has shorter duration of action than bupivacaine"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Anesthesiology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"4ab040431a1be72ebbba947432d833f0b136004d"},{"id":"q-d08541d3cd85","stem":"The following transmitter mainly increase neuronal activity in the CNS","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"glutamate"},{"label":"B","text":"glycine"},{"label":"C","text":"acetylcholine"},{"label":"D","text":"GABA"},{"label":"E","text":"Aspartate"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"f75609c624ec9854b1436f1a98adc20bc7e190cb"},{"id":"q-1a5f0c2c4059","stem":"The following statements about convulsants agents are correct","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"strychnine is an antagonist at GABA receptors"},{"label":"B","text":"strychnine poisoning is treated with short acting neuromuscular blocking agent FROM LUCAS TO LUHIGO,DOGO SOMA HAYO MASWALI YATAKUSAIDIA,ALWAYS TOGETHER BROTHER,I LOVE YOU YOUNG BROTHER 36"},{"label":"C","text":"bicuculline is a competitive antagonist of GABA at GABA receptors"},{"label":"D","text":"picrotoxin causes functional opposition"},{"label":"E","text":"strychnine is an antagonist at glycine at its receptor"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"8e21314666a164f71f9ae54feffca0396d6786e1"},{"id":"q-442c28732caf","stem":"The following statements about anticonvulsant agents are correct","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"CNS Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"CNS Pharmacology","options":[{"label":"A","text":"the dextro – and levo- isomers of amphetamine have equal potency in the periphery"},{"label":"B","text":"levo-amphetamine is twice as potent as a central stimulant"},{"label":"C","text":"the treatment of acute poisoning of amphetamine involves alkalinization of urine to promote secretion"},{"label":"D","text":"current clinical use of amphetamine is restricted to rarely conditions of narcolepsy"},{"label":"E","text":"tranylcypromine is an inhibitorof MAO but causes more stimulation of CNS than amphetamine"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"CNS Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"9f351067f676314bd3cd224d65bd243141597728"},{"id":"q-dfdefb52ef3a","stem":"The following statements about hallucinogens are correct","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Mescaline and related hallucinogens are potent hallucinogens. They cause vivid hallucinations though the mechanism is unknown"},{"label":"B","text":"LSD cause vivid hallucination. The mechanism is presumed to stem from its ability to interact with neurotransmitter dopamine"},{"label":"C","text":"Pentazocine cause dysphoria and visual hallucination that are commonly persecutory"},{"label":"D","text":"Nitrous oxide cause auditory distortion. Mechanism may involve interaction with endorphin and enkephaline"},{"label":"E","text":"Cocaine causes euphoria, indifference to pain and tactile hallucinations. Mechanism is presumed to be related to inhibition of MAO"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"f91ca8e870fae2ddc79848611974d011a1cb1de9"},{"id":"q-6c0d898c1afd","stem":"Opiod peptides are","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"components of opioid receptors to which morphine bind"},{"label":"B","text":"molecules such as pentapeptides methionine-enkephaline and leucine enkephaline"},{"label":"C","text":"found both in the CNS and in the periphery"},{"label":"D","text":"a fragment containing 17 amino acids (dynorphin) some of the most potent agonist at the opiod receptors"},{"label":"E","text":"antagonists morphine"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"d7638cae1ed47c8b38878ef9bccfdd045dd3d6d5"},{"id":"q-648bff46a319","stem":"Symptoms that indicate phenytoin overdoses are","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Hirsutism. FROM LUCAS TO LUHIGO,DOGO SOMA HAYO MASWALI YATAKUSAIDIA,ALWAYS TOGETHER BROTHER,I LOVE YOU YOUNG BROTHER 37"},{"label":"B","text":"Dysarthiria."},{"label":"C","text":"Megaloblastic anaemia."},{"label":"D","text":"Ataxia."},{"label":"E","text":"Gum hyperplasia."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"10fe9d0a424b8213cccd8915e55c43dca8a41248"},{"id":"q-b36a00655c29","stem":"The mechanism of action of valproate include","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"inhibition of GABA transaminase"},{"label":"B","text":"increase of Na conduction"},{"label":"C","text":"reduction in the action glutamic acid and decarboxylase enzymes"},{"label":"D","text":"activation of potassium channels"},{"label":"E","text":"inhibition of calcium channels"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"df83336bc9484c1d8633903f19337724d0b51633"},{"id":"q-f4f10bc4609f","stem":"The following have been matched with appropriate anticonvulsant","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"CNS Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"CNS Pharmacology","options":[{"label":"A","text":"Blockage of voltage gated sodium channels – valproate"},{"label":"B","text":"Blockage of glutaminergic transmission – Phenytoin"},{"label":"C","text":"Blockage of T-calcium channel – zonisamide"},{"label":"D","text":"Increased GABAergic inhibition of neurotransmission- carbamazepine"},{"label":"E","text":"Inhibition of GABA uptake – Tiagabine"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"CNS Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"c19212e1cdd34f1f9a4333145c1343cd1113912c"},{"id":"q-96c29102138b","stem":"Inhaled anaesthetics","type":"Single Best Answer MCQ","subject":"Anesthesiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cause membrane polarization by activating potassium channels."},{"label":"B","text":"Increases the duration of opening of nicotinic receptors."},{"label":"C","text":"Depress evoked but not spontaneous activity of neurones."},{"label":"D","text":"Appear to interact with component of cell membranes."},{"label":"E","text":"Render the patient unresponsive to painful stimulation."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Anesthesiology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"2724ac3e8d0fd49fbe319e14aec049feba8f3aec"},{"id":"q-a4a47a5d6801","stem":"Rapid induction of anaesthesia is caused by agents that are","type":"Single Best Answer MCQ","subject":"Anesthesiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":""