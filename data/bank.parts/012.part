el":"E","text":"Should be monitored for plasma blood levels."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"decbed5734c463c5d6c4016ee5ba45bd021c2ea3"},{"id":"q-eb4ade0cfab6","stem":"Drugs to treat movement disorders","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Is a dopamine agonist effective in later stages of parkinsonism"},{"label":"B","text":"Is a pro drug that is most effective in early stages of parkinsonism"},{"label":"C","text":"Is an antimuscarinic agent used to treat Parkinson's disease"},{"label":"D","text":"Is an antiviral drug used to treat Parkinson disease"},{"label":"E","text":"Is an MAO-B inhibitor used to treat Parkinson's disease FROM LUCAS TO LUHIGO,DOGO SOMA HAYO MASWALI YATAKUSAIDIA,ALWAYS TOGETHER BROTHER,I LOVE YOU YOUNG BROTHER 42"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"cb39ff29d3aa37f575239a633a8e09ccd33a7d7c"},{"id":"q-21d62b009680","stem":"Antipsychotic (neuroleptic drugs)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Central Nervous System Drugs","topicOriginal":"Central Nervous System Drugs","subtopic":"Antipsychotic","suggestedTopic":null,"opt