y decrease preload. T"},{"label":"E","text":"They can be co-adminstered concurrently with sidenafil. F"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"e7ec36b04a75f06a3a17a0ec802f00ad929e91ed"},{"id":"q-e595f958d583","stem":"The following are side effects of nitrates EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Postural hypontesion. F"},{"label":"B","text":"Tachycardia F (Reflex tachy)"},{"label":"C","text":"Throbbing headache F"},{"label":"D","text":"Methaemoglobinemia which is seen with nitrites F"},{"label":"E","text":"Bradycardia T"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"9bc1449680e06bb5dadc28b58d3165aa49dd8cb7"},{"id":"q-f86537cf8b99","stem":"Calcium channel blockers","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Acts mainly on N-P type channels. F"},{"label":"B","text":"Relax significantly venous smooth muscles. F (Artery)"},{"label":"C","text":"Include dihydropyridines such as verapamil. F"},{"label":"D","text":"Inhibits impulse generation in SA node. T (and AV)"},{"label":"E","text"