ntagonist?","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6f7c5321a5b0","stem":"Which statement regarding hepatic enzyme induction is INCORRECT","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Proteins and Enzymes","topicOriginal":"Proteins and Enzymes","subtopic":"Enzyme","suggestedTopic":null,"options":[{"label":"A","text":"Induction takes 7-10 days to reach maximum"},{"label":"B","text":"Inhibition occurs more rapidly than induction"},{"label":"C","text":"Induction ceases within a few days of withdrawal of drug"},{"label":"D","text":"Suicide inhibitors are metabolized to products which inhibit the metabolizing enzymes"},{"label":"E","text":"Induction is associated with an increase in hepatic smooth ER"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Proteins and Enzymes","answerAuditStatus":"independent_provisional_reasoning","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-efe1446d1b85","stem":"Which of the following is not an inducer of hepatic drug-metabolising enzymes","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Proteins and Enzymes","topicOriginal":"Proteins and Enzymes","subtopic":"Enzyme","suggestedTopic":null,"options":[{"label":"A","text":"Cigarette smoke"},{"label":"B","text":"Phenytoin"},{"label":"C","text":"Charcoal broiled beef"},{"label":"D","text":"Chloramphenicol"},{"label":"E","text":"Spironolactone"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Proteins and Enzymes","answerAuditStatus":"independent_provisional_reasoning","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-fb0c1edeaa78","stem":"Which of the following drugs has a high bioavailability","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"Acyclovir"},{"label":"B","text":"Cyclosporine"},{"label":"C","text":"Metoprolol"},{"label":"D","text":"Diazepam"},{"label":"E","text":"Verapamil"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"manualEdits":{}},{"id":"q-97be726b3a3b","stem":"Which of the following is not an inhibitor of hepatic drug-metabolising enzymes","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Proteins and Enzymes","topicOriginal":"Proteins and Enzymes","subtopic":"Enzyme","suggestedTopic":null,"options":[{"label":"A","text":"Metronidazole"},{"label":"B","text":"Cimetidine"},{"label":"C","text":"Isoniazid"},{"label":"D","text":"Allopurinol"},{"label":"E","text":"Rifampicin"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Proteins and Enzymes","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[],"manualEdits":{}},{"id":"q-5deee2223047","stem":"Which of the following act via cytokine receptors","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Growth hormone"},{"label":"B","text":"EPO"},{"label":"C","text":"IFN"},{"label":"D","text":"All of the above"},{"label":"E","text":"None of the above"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-80394cbdf04a","stem":"Which of the following receptor ligand pathways is true","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Insulin and G receptor protein"},{"label":"B","text":"Mineralocorticoid and tyrosine kinase receptor"},{"label":"C","text":"Vitamin D and intracellular receptor"},{"label":"D","text":"Adrenaline and ligand gated channel receptor"},{"label":"E","text":"PDGF and cytokine receptor"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-1f631dfdbef0","stem":"Which of the following are antagonist and agonist pairs for the same receptor","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"butoxamine, terbutaline"},{"label":"B","text":"phenyoxybenzamine, cyclopentolate"},{"label":"C","text":"pilocarpine, bethanechol"},{"label":"D","text":"oxymetazoline, dobutamine"},{"label":"E","text":"bromocriptine, pranipexole"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-82afd9a71827","stem":"Which is false","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Drug A with a higher potency can have a lower efficacy than drug B"},{"label":"B","text":"Drug A with a higher affinity for its receptor has a higher potency"},{"label":"C","text":"Drug A with a lower potency must have a lower efficacy than drug B"},{"label":"D","text":"Drug A with a higher potency can still have the same efficacy"},{"label":"E","text":"None of the above"}],"priority":2,"status":"practice_draft","flags":["short_or_incomplete_stem","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["short_or_incomplete_stem","short_stem","topic_generic"],"cleaningOperations":[]},{"id":"q-c1a66a9562c5","stem":"Which is false","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Half-life is inversely proportional to volume of distribution"},{"label":"B","text":"Half-life is constant in first order clearance"},{"label":"C","text":"α half-life is usually shorter than β half life"},{"label":"D","text":"half-life is not constant in zero order kinetics"},{"label":"E","text":"half-life is determined by the molecular weight of a drug"}],"priority":2,"status":"practice_draft","flags":["short_or_incomplete_stem","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["short_or_incomplete_stem","short_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-22936aca458c","stem":"Which is not a determinant of the volume of distribution","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"pKa of the drug"},{"label":"B","text":"degree of plasma protein binding"},{"label":"C","text":"dose given"},{"label":"D","text":"fat parturition co-efficient"},{"label":"E","text":"degree of tissue binding"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9567a9213eec","stem":"Which of the following has zero order elimination","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"Warfarin"},{"label":"B","text":"Phenytoin"},{"label":"C","text":"Paracetamol"},{"label":"D","text":"Digoxin"},{"label":"E","text":"None of the above"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4394e118596f","stem":"Following the cessation of drug therapy, how many half lives does it take for 97% of the drug to be eliminated?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"1"},{"label":"B","text":"3"},{"label":"C","text":"5"},{"label":"D","text":"7"},{"label":"E","text":"9"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5480bb8422ea","stem":"Which is incorrect","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Phenytoin follows zero order kinetics"},{"label":"B","text":"At high doses alcohol has 1st order kinetics"},{"label":"C","text":"Rifampicin enhances oestrogen metabolism"},{"label":"D","text":"Low dose paracetamol is mainly metabolized by the cytochrome p450 system"},{"label":"E","text":"Hepatic carcinoma tends to inhibit drug metabolism"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"aa47513023642e9fee802c9634ac8e158e949f51"},{"id":"q-ec989ece8368","stem":"Which is not a phase I metabolizing reaction","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Molecular Biology","topicOriginal":"Molecular Biology","subtopic":"Gene","suggestedTopic":null,"options":[{"label":"A","text":"acetylation"},{"label":"B","text":"deanimation"},{"label":"C","text":"hydrolysis"},{"label":"D","text":"oxidation"},{"label":"E","text":"reduction"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Molecular Biology","answerAuditStatus":"independently_reasoned_provisional_oct20","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-345a6b8f2136","stem":"A patient has taken an OD of a drug with a pKa of 9, which is true?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Urinary excretion would be accelerated by giving NaHCO3"},{"label":"B","text":"More of the drug will be in its unionized form in the stomach than in the jejunum"},{"label":"C","text":"Gastric lavage should be performed immediately to punish the patient for wasting your time"},{"label":"D","text":"Haemodialysis should be carried out immediately"},{"label":"E","text":"Administration of NH4Cl will increase urinary excretion"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-5f78f1334b2b","stem":"Which is true of protein binding","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The fraction of unbound drug is determined by the affinity of the drug for the protein, the concentration of the binding protein and the molecular weights of the drug and the protein"},{"label":"B","text":"α1-acid glycoprotein has little effect on the binding of drugs in plasma"},{"label":"C","text":"in general, changes in protein binding do not cause clinically important drug interactions"},{"label":"D","text":"protein binding refers to an irreversible interaction of drugs with proteins in the plasma"},{"label":"E","text":"drugs only slowly bind and/or dissociate from plasma proteins"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7e5fa1442c44","stem":"Which is true","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Zero order kinetics refers to situations where a constant proportion of the drug in the body is eliminated per unit time"},{"label":"B","text":"Non-linear kinetics are best described in situations where no matter how much drug is in the body a constant amount of drug is eliminated per unit time"},{"label":"C","text":"Variations in the dose of ETOH will not effect its half life"},{"label":"D","text":"For drugs which exhibit capacity limited elimination, clearance will be constant"},{"label":"E","text":"If drug doses are repeated, the drug will accumulate in the body only if the dosing intervals is less than 3 half lives"}],"priority":2,"status":"practice_draft","flags":["short_or_incomplete_stem","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["short_or_incomplete_stem","short_stem","topic_generic"],"cleaningOperations":[]},{"id":"q-ac97bda5b99f","stem":"Which is incorrect","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A drug which binds to a receptor and produces a maximal response is called a full agonist"},{"label":"B","text":"A drug which binds to a receptor and produces a variable response is called a quasi agonist"},{"label":"C","text":"A drug which binds to a receptor and produces a submaximal response is called a partial agonist"},{"label":"D","text":"A drug which binds to a receptor and produces no response is called an antagonist"},{"label":"E","text":"A drug which does not bind to receptors can still be effective"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"aa47513023642e9fee802c9634ac8e158e949f51"},{"id":"q-b7491ddcaa16","stem":"Which is false","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Partial agonists produce lower response at the same receptor occupancy rate"},{"label":"B","text":"The concept of spare receptors refers to the fact that some receptors have alternate molecular configuration (isomers) and so are spared from producing a response to certain drugs"},{"label":"C","text":"The efficiency of the receptor-effect coupling is dependant on the affinity of the drug for the receptor, the power of the agonist and the receptor concentration"},{"label":"D","text":"variation in concentration of endogenous receptor ligand may be responsible for variations in drug effectiveness"},{"label":"E","text":"changes in components of the response distal to the receptor are the largest and most important group of mechanisms of variability"}],"priority":2,"status":"practice_draft","flags":["short_or_incomplete_stem","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["short_or_incomplete_stem","short_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-ffff85b7ba3c","stem":"Which is true","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The ED50 is the dose at which the desired effect is produced in 50% target population"},{"label":"B","text":"Maximal potency refers to the relative position of the plateau portion of the dose- response curve"},{"label":"C","text":"A quantal dose-response curve plots the percentage of a population having a defined clinical response to a drug concentration or dose"},{"labe