d37f33cd667","stem":"All of the following diseases and features relate to Skin lymphomas EXCEPT","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Sezary Syndrome"},{"label":"B","text":"Mycosis Fungoides C Often of B cell lymphocyte origin"},{"label":"D","text":"Erythroderma and presence of cerebriform lymphocytes in the blood"},{"label":"E","text":"Adult T cell Leukaemia/Lymphoma usually present with skin lesions"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-9f0cfc4c0113","stem":"One of the following features relate to Mixed cellularity Hodgkin's Disease","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Lacunar Cells"},{"label":"B","text":"Mediastinal involvement"},{"label":"C","text":"Alcohol-induced nodal pain D The commonest type in Saudi Arabia"},{"label":"E","text":"Bands of collagen separating cellular lymphoma nodules 33 Professor Anwar Sheikha, MD, FRCP, FRCPath., FACP One Thousand Hematology MCQ"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-f4018b7ded4a","stem":"All of the following features are true for Sezary Syndrome EXCEPT","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"T-Helper cell lymphoma B Caused by HTLV-1 virus"},{"label":"C","text":"Involvement of the skin and the blood"},{"label":"D","text":"Erythroderma"},{"label":"E","text":"It usually passes through patch, plaque and tumor stages"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-67189c111ec8","stem":"All of the following features are true for Lymphoblastic lymphoma EXCEPT","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Usually affects children B \"Starry-Sky\" tissue appearance"},{"label":"C","text":"Mediastinal involvement is common"},{"label":"D","text":"Usually have a leukemic phase"},{"label":"E","text":"Cells have distinctive convoluted nuclear morphology"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-6b86a2917bd6","stem":"Paraproteins could be seen in all of the following neoplasms EXCEPT: A Acute Myeloblastic Leukemia (AML)","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Waldenstrom's Macroglobulinemia"},{"label":"C","text":"Multiple Myeloma"},{"label":"D","text":"Chronic Lymphocytic Leukemia (CLL)"},{"label":"E","text":"Lymphomas"}],"priority":2,"status":"practice_draft","flags":[],"keyVeri