ngOperations":[],"duplicateStemGroup":"72bb53e60bef74646233438f41baf3f0a6c40296"},{"id":"q-0b507cdecdb2","stem":"When p>05 is reported in a journal article that you read for an observed relationship, it means that the author has rejected the null hypothesis (assuming that the author is using a significance or alpha level of .05).","type":"True / False","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"],"duplicateStemGroup":"72bb53e60bef74646233438f41baf3f0a6c40296"},{"id":"q-2633d754e349","stem":"Identify which of the following steps would not be included in hypothesis testing.","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"State the null and alternative hypotheses"},{"label":"B","text":"Set the significance level before the research study"},{"label":"C","text":"Eliminate all outliers"},{"label":"D","text":"Obtain the probability value using a computer program such as SPSS"},{"label":"E","text":"Compare the probability value to the significance level and make the statistical decision"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"313d9299c360faca5d703ba9055d4a71f690e080"},{"id":"q-a7303d4237b7","stem":"Which of the following can be viewed as an effect size indicator?","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"r-squared"},{"label":"B","text":"r"},{"label":"C","text":"Eta-squared"},{"label":"D","text":"Omega-squared"},{"label":"E","text":"All of the above"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d89bffd665a7","stem":"When the researcher rejects a true null hypothesis, a ____ error occurs.","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Type I"},{"label":"B","text":"Type A"},{"label":"C","text":"Type II"},{"label":"D","text":"Type B"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-edf6e3a6f55f","stem":"Which ____ percent confidence interval will be the widest (i.e., the least precise) for a particular data set that includes exactly 500 cases?","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"99%"},{"label":"B","text":"95%"},{"label":"C","text":"90%"},{"label":"D","text":"None of the above"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8ee8d7859db7","stem":"As sample size goes up, what tends to happen to 95% confidence intervals?","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"They become more precise"},{"label":"B","text":"They become more narrow"},{"label":"C","text":"They become wider"},{"label":"D","text":"Both a and b"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b1d432dfbc5f","stem":"Which of the following statements is/are true according to the logic of hypothesis testing?","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"When the null hypothesis is true, it should be rejected"},{"label":"B","text":"When the null hypothesis is true, it should not be rejected"},{"label":"C","text":"When the null hypothesis is false, it should be rejected"},{"label":"D","text":"When the null hypothesis is false, it should not be rejected"},{"label":"E","text":"Both b and c are true"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"37464390e0097371dd1c9fddfc6c2769d8383f5e"},{"id":"q-ad5da1aa2484","stem":"What is the key question in the field of statistical estimation?","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"Based on my random sample, what is my estimate of the population parameter?"},{"label":"B","text":"Based on my random sample, what is my estimate of normal distribution?"},{"label":"C","text":"Is the value of my sample statistic unlikely enough for me to reject the null hypothesis?"},{"label":"D","text":"There is no key question in statistical estimation"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-222ed737fada","stem":"The “equals” sign (=) is included in which hypothesis when conducting hypothesis testing?","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Null"},{"label":"B","text":"Alternative"},{"label":"C","text":"It can appear in both the null and the alternative hypothesis"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6df331e8f496","stem":"Which of the following is not true about stratified random sampling?","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It involves a random selection process from identified subgroups"},{"label":"B","text":"Proportions of groups in the sample must always match their population proportions"},{"label":"C","text":"Disproportional stratified random sampling is especially helpful for getting large enough subgroup samples when subgroup comparisons are to be done"},{"label":"D","text":"Proportional stratified random sampling yields a representative sample"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-41636e9db864","stem":"Which of the following statements are true?","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"The larger the sample size, the greater the sampling error"},{"label":"B","text":"The more categories or breakdowns you want to make in your data analysis, the larger the sample needed"},{"label":"C","text":"The fewer categories or breakdowns you want to make in your data analysis, the larger the sample needed"},{"label":"D","text":"As sample size decreases, so does the size of the confidence interval"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"6bf9ead4ae2bf3e9e3630756a8163f216bc34034"},{"id":"q-9da356fe3563","stem":"Which of the following formulae is used to determine how many people to include in the original sampling?","type":"Calculation","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Desired sample size/Desired sample size + 1"},{"label":"B","text":"Proportion likely to respond/desired sample size"},{"label":"C","text":"Proportion likely to respond/population size"},{"label":"D","text":"Desired sample size/Proportion likely to respond"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-10f466280369","stem":"Which of the following sampling techniques is an equal probability selection method (i.e., EPSEM) in which every individual in the population has an equal chance of being selected?","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Simple random sampling"},{"label":"B","text":"Systematic sampling"},{"label":"C","text":"Proportional stratified sampling"},{"label":"D","text":"Cluster sampling using the PPS technique"},{"label":"E","text":"All of the above are EPSEM"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"a53beb0b9294252d48fdbf6a0e671bee8f97e4e2"},{"id":"q-2a3d1f792838","stem":"Which of the following is not a form of nonrandom sampling?","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Snowball sampling"},{"label":"B","text":"Convenience sampling"},{"label":"C","text":"Quota sampling"},{"label":"D","text":"Purposive sampling"},{"label":"E","text":"They are all forms of nonrandom sampling"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_duplicate_projection","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"d8285909a0c1cd15a93e9f37789ae7dc96d55a76"},{"id":"q-b854f309099a","stem":"Sampling in qualitative research is similar to which type of sampling in quantitative research?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Simple random sampling"},{"label":"B","text":"Systematic sampling"},{"label":"C","text":"Quota sampl