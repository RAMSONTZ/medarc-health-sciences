erified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3194fb0a6d65","stem":"A decrease in the life span of the red cell is found in the following","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Pernicious anemia."},{"label":"B","text":"Immune Thrombocytopenic Purpura ( ITP )"},{"label":"C","text":"Thalassemia."},{"label":"D","text":"Hemophilia"},{"label":"E","text":"Pregnancy"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f6d6e4cc526e","stem":"Which of the following are often found in the blood after splenectomy ?","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Megaloblasts"},{"label":"B","text":"Target cells."},{"label":"C","text":"Howell Jolly bodies."},{"label":"D","text":"Thrombocytosis."},{"label":"E","text":"Leucopenia"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"7bc148f8527bc42c775bb55603345f6ec3bbcc3e"},{"id":"q-b7ad33e3c920","stem":"The following drugs or toxins may be responsible for aplastic anemia","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Quinidine"},{"label":"B","text":"Penicillamine."},{"label":"C","text":"Benzene."},{"label":"D","text":"Glibenclamide"},{"label":"E","text":"Sodium aureothiomalate. MATCH THE FOLLOWING ABNORMAL RED BLOOD CELL FEATURES WITH THEIR MOST PROBABLE BLOOD DISEASES. “YOU ARE ONLY REQUESTED TO FILL IN THE SPACES WITH THE POSSIBLE LETTERS. DON’T RE-WRITE THE WHOLE RED CELL ABNORMALITY. JUST INSERT THE POSSIBLE CORRECT LETTER.” (A). SHISTOCYTES (Fragmented RBC) (F). HYPOCHROMIC MICROCYTIC RBC (B). TEAR DROP RED CELLS (G). ELLIPTOCYTES (C). SICKLE CELLS (H). HEINZ BODIES (D). HOWELL-JOLLY BODIES (I ). SPHEROCYTES (E). BASOPHILIC STIPPLING (J). BURR CELLS BLOOD DISEASE POSSIBLE RED CELL ABNORMALITY 351 UREMIA 352 HEREDITARY SPHEROCYTOSIS 353 G6P DEHYDROGENASE DEFICIENCY 354 HEREDITARY ELLIPTOCYTOSIS 355 MAHA “Microangiopathic Hemolytic Anemia” 356 MYELOFIBROSIS 357 SICKLE CELL ANEMIA 358 IRON DEFICIENCY ANEMIA 359 LEAD POISONING 360 MEGALOBLASTIC ANEMIA 47 Professor Anwar Sheikha, MD, FRCP, FRCPath., FACP One Thousand Hematology MCQ Select the most appropriate answers to these morphology questions:"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-f6b5c73949ff","stem":"The following features are true in all of these hematological cells EXCEPT","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Pronormoblasts are relatively large myeloid cells with abundant cytoplasmic granules and few nucleoli."},{"label":"B","text":"Myeloblasts are positive for Sudan Black stain"},{"label":"C","text":"Lymphoblasts are positive for Periodic Acid Schiff (PAS) stain"},{"label":"D","text":"Myeloblasts are positive for Specific \"Chloroacetate\" Esterase stain"},{"label":"E","text":"Tear drop cells & leuko-erythroblastic feature are seen in myelofibrosis"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-79d3961bea05","stem":"All of the following features are correct about red cell anomalies, EXCEPT","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Anisocytosis means variation in size"},{"label":"B","text":"Poikilocytosis means variation in shape"},{"label":"C","text":"Howell Jolly Bodies are nuclear remnants"},{"label":"D","text":"Heinz bodies are precipitated denatured hemoglobin debris"},{"label":"E","text":"Polychromasia indicates reticulocytopenia."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-0c49c0d5ca48","stem":"Reticulocytes have all of the following features EXCEPT","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"They are young red blood cells with fine basophilic reticulum"},{"label":"B","text":"Their number in the blood is between 10 and 100 billion per liter"},{"label":"C","text":"Their ratio in the blood is between 0.2 to 2 percent"},{"label":"D","text":"They can best be demonstrated by Supravital stains"},{"label":"E","text":"After a week in the blood they give rise to mature erythrocytes."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[],"manualEdits":{}},{"id":"q-f067717efe96","stem":"The following features relate to Target Cells","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Large target cells are usually due to gain of red cell membrane and characteristically seen in thalassemia major"},{"label":"B","text":"Small target cells are usually due to defective hemoglobinization and characteristically seen in liver failure"},{"label":"C","text":"They are markedly increased after splenectomy"},{"label":"D","text":"They are markedly increased in Hemoglobin SC disease."},{"label":"E","text":"They are usually hyperchromic cells"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-47439faf2bd7","stem":"Siderocytes have all, but one, of the following features","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"They are erythrocytes containing iron granules"},{"label":"B","text":"They are Pappenheimer bodies as seen by Romanowsky stains"},{"label":"C","text":"They are best seen when stained by Prussian-blue stains"},{"label":"D","text":"Ring sideroblasts are characteristic for sideroblastic anemias"},{"label":"E","text":"They are seen in iron deficiency anemia but not in thalassemia."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-064815e6ea78","stem":"Poikilocytosis could mean any one of the following EXCEPT","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Blister cells"},{"label":"B","text":"Prickle cells"},{"label":"C","text":"Pear shaped cells"},{"label":"D","text":"Spherocytes."},{"label":"E","text":"Crenated cells 48 Professor Anwar Sheikha, MD, FRCP, FRCPath., FACP One Thousand Hematology MCQ"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-af61a10eb720","stem":"The following abnormalities are seen in megaloblastic anemias EXCEPT","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Giant metamyelocytes in the bone marrow"},{"label":"B","text":"Hypersegmented neutrophils in the peripheral blood"},{"label":"C","text":"Defective hemoglobinization of the developing red cells."},{"label":"D","text":"Hypercellular bone marrow"},{"label":"E","text":"Howell Jolly bodies in the red cells"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f1b552b771ee","stem":"Which finding is NOT typical of iron-deficiency anemia?","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":"Iron deficiency morphology","options":[{"label":"A","text":"Hypochromic microcytic red cells"},{"label":"B","text":"Defective hemoglobinization of the developing red cells"},{"label":"C","text":"Pencil shaped red cells"},{"label":"D","text":"Ring sideroblasts in the marrow nucleated red cells."},{"label":"E","text":"Absent stainable iron stores"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"independent_checked","sourceAnswerTrusted":false,"publicationStatus":"checked_explained","auditFlags":[],"cleaningOperations":[],"manualEdits":[{"field":"stem","original":"All, but one, of the following abnormalities are seen in iron deficiency anemias","corrected":"Which finding is NOT typical of iron-deficiency anemia?","reason":"language_or_captured_footer_repair"}]},{"id":"q-48465be4a3ef","stem":"All, EXCEPT one, of the following relate to the clinical features of hemolysis","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The patient may not be anemic"},{"label":"B","text":"Splenomegaly is a common feature"},{"label":"C","text":"Biliary colic may occur"},{"label":"D","text":"Mild jaundice is a usual feature"},{"label":"E","text":"Gall stones at young age is an absolute indication of hemolytic anemia."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-df9929bede62","stem":"All, EXCEPT one, of the following relate to laboratory features of hemolysis","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Labor and Delivery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Labor and Delivery","options":[{"label":"A","text":"Reticulocytosis is a usual finding"},{"label":"B","text":"Polychromasia usually detected"},{"label":"C","text":"Coomb’s test is positive in all patients."},{"label":"D","text":"Cross-matching might be difficult if autoantibodies are present"},{"label":"E","text":"Mild unconjugated hyperbilirubinemia is usual LEUKEMIA IMMUNOPHENOTYPING EXMINATION: There are five main immunological types of Acute Lymphoblastic Leukemias: Common ALL; T-ALL; Pro-B ALL; Pre-B ALL and B-ALL. Each of these types of ALL is characteristically positive for certain markers. The main immunological markers used are TdT; HLA-DR; CD10; Cyt.; SmIg; CD 19 to 22, which are Pan B cell markers and CD 2 to 8 markers, which are T cell markers. In the following table, you are requested to fill in the positive tests with the plus (+) sign and the negative tests with the minus (-) sign. For your convenience, I have already marked few of the tests. ALL TdT CD10 Cyt.  SmIg CD19-22 CD 2-8 (B- (T-Lineage) Lineage) Q371 Pro-B Q372 cALL - Q373 Pre-B Q374 B-ALL - Q375 T-ALL 49 Professor Anwar Sheikha, MD, FRCP, FRCPath., FACP One Thousand Hematology MCQ Select the True (T) & False (F) answers:"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Labor and Delivery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"7bf6e32b4e2f9cbc5fc683aeaa915aefbb508ebe"},{"id":"q-9584de0eabe8","stem":"The following compensatory mechanisms occur in severe chronic anemia: A Arterial PO2 is decreased","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Red cell 2,3 diphosphoglycerate increases"},{"label":"C","text":"There is an increase in cardiac output at rest"},{"label":"D","text":"The concentration of erythropoietin in the urine is often increased E Whole blood viscosity is increased"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e659381f09f6","stem":"The following statements relate to the gain & loss of iron by the body: A Absorption takes place only in the lower part of the small intestine B In adult males at least 2 mg of iron is lost from the body each day C The average iron loss during each menstrual period is 120-150 mg","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"D","text":"Iron requirements in pregnancy are increased"},{"label":"E","text":"Adult males absorb about 1 mg of iron daily although intake is 10 mg"}],"priority":2,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-be6994e0944b","stem":"The following relate to the causes of iron deficiency","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Partial gastrectomy may be followed by iron deficiency"},{"label":"B","text":"Iron deficiency anemia in adult male is quite worrisome C Iron deficiency is most frequently caused by dietary lack of iron"},{"label":"D","text":"Hemosiderin can be excreted in large quantities in the urine"},{"label":"E","text":"Women of child-bearing age are more common to develop iron deficiency than adult males"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-858d8d40e4ec","stem":"Which of the following are consistent with diagnosis of chronic iron deficiency ?","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Hemoglobin of 60 gm/L, MCV of 60 fl, MCH of 15.5 pg"},{"label":"B","text":"Absent stainable iron in the marrow C A reticulocyte count of 3.7 %"},{"label":"D","text":"Tendency to crave for strange things like chalk and ice"},{"label":"E","text":"A platelet count of 540 thousand / uL"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"c37873d7e58d677c6622599f12665c78e1f9570e"},{"id":"q-2e4731e9e6c5","stem":"The following are statements about sideroblastic anemia","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"There is increased marrow iron with ring sideroblasts"},{"label":"B","text":"There is impaired hemoglobin synthesis"},{"label":"C","text":"A dimorphic blood picture is often found D The anemia is due to erythroid hypoplasia in the marrow"},{"label":"E","text":"In many patients the etiology of acquired sideroblastic anemia is obscure"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ed73e5946ad2","stem":"The following are statements about Erythrocyte Sedimentation Rate (ESR)","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The rate of sedimentation in one hour at 200 C is about 4 mm in men"},{"label":"B","text":"It is raised in anemia C It is high in defibrinated blood D It can be used to exclude presence of underlying organic disease"},{"label":"E","text":"The ESR is useful in following the progress of diseases such as tuberculosis and rheumatoid arthritis"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-73878758b749","stem":"The following statements relate to the Anemia of Chronic Disorders : A This type of anemia is uncommon","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"The blood picture is usually normocytic normochromic"},{"label":"C","text":"In the bone marrow, stainable iron stores are normal or increased D The serum iron and total iron binding capacity ( TIBC ) are raised"},{"label":"E","text":"The ESR is usually elevated 50 Professor Anwar Sheikha, MD, FRCP, FRCPath., FACP One Thousand Hematology MCQ"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-95367bd74a8b","stem":"The following are statements concerning some of the hematological findings during pregnancy","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The hemoglobin concentration decreases"},{"label":"B","text":"The red cell mass increases C The ESR is lower"},{"label":"D","text":"The concentration of many coagulation factors is increased"},{"label":"E","text":"A total white cell count of 20 x 109/l following delivery is common"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-de18257f5f3e","stem":"The following concern vitamin B12","type":"Single Best Answer MCQ","subject":"Nutrition and Dietetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It is plentiful in a mixed diet, so inadequate intake is rare B The daily requirement of vitamin B12 is about 100 microgram"},{"label":"C","text":"The body stores can last 2-3 years"},{"label":"D","text":"Pernicious anemia is due to lack of intrinsic factor production E Vitamin B12 is absorbed in the upper jejunum"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Nutrition and Dietetics","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-152222a6dab0","stem":"Common features of megaloblastic anemias are as follows","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A raised MCV with oval macrocytosis in the peripheral blood smear"},{"label":"B","text":"There is hyperplastic erythropoiesis in the bone marrow C Pancytopenia is rare"},{"label":"D","text":"Hypersegmented neutrophils may be present in the peripheral blood"},{"label":"E","text":"The typical megaloblastic bone marrow and macrocytic red cells may be masked if concomitant iron deficiency exists"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-cb77504c5525","stem":"The following are related to the diagnosis of pernicious anemia (PA)","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The serum B12 is always reduced"},{"label":"B","text":"The red cell folate is low in 60% of patients C A patient with a megaloblastic anemia, histamine fast achlorhydria and low serum B12 must have PA D A low radioactive vitamin B12 excretion in the urine ( Schilling test ) uncorrected by the oral administration of IF is usual E The presence of IF antibodies is essential to confirm the diagnosis"}],"priority":2,"status":"review","flags":["mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag"],"cleaningOperations":[]},{"id":"q-6b804c53a2fc","stem":"The following are statements concerning β-thalassemia major","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Iron overload is the major cause of death B Severe anemia occurs in the neonatal period"},{"label":"C","text":"Gross hepatosplenomegaly is common"},{"label":"D","text":"There is often evidence of endocrine disease"},{"label":"E","text":"A pancytopenia may develop"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f802f98340dc","stem":"The following concern a peripheral blood neutrophil leukocytosis : A If neutrophils comprise 80% of a total WBC of 8,000/uL, then, by definition, a neutrophil leukocytosis exists","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"It is commonly caused by an acute pyogenic infection C A postoperative neutrophilia indicates associated infection"},{"label":"D","text":"It often follows severe hemorrhage"},{"label":"E","text":"It is characteristic of most myeloproliferative diseases 51 Professor Anwar Sheikha, MD, FRCP, FRCPath., FACP One Thousand Hematology MCQ"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-4c7e27e3d9a8","stem":"The following concern aplastic anemia","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"There is commonly a pancytopenia"},{"label":"B","text":"A bone marrow aspirate can appear to be of normal cellularity C Splenomegaly is a consistent feature at the time of diagnosis"},{"label":"D","text":"The plasma erythropoietin concentration is usually high E The reticulocyte count is usually greater than 2%"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-3915c81a5d55","stem":"The following concern the presenting features of Acute Leukemia","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The presenting symptoms are due to bone marrow failure"},{"label":"B","text":"Fever can occur without obvious infection C Enlargement of the spleen below the umbilicus is common"},{"label":"D","text":"Bone pain can be a feature E Widespread lymphadenomegaly is a diagnostic feature"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-317d9a78d3ff","stem":"The following are statements concerning Acute Lymphoblastic Leukemia: A The lymphoblasts in culture have a rapid cell cycle","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Immunophenotyping of the lymphoblasts is essential"},{"label":"C","text":"There is sometimes an associated mediastinal mass D Lymphoblasts are always found in the peripheral blood"},{"label":"E","text":"A high WBC & moderate splenomegaly are poor prognostic features"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-902a37935169","stem":"The following concern Acute Myeloblastic Leukemia ( AML ) : A The absence of physical signs excludes the diagnosis of AML","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"There are distinct morphological variants"},{"label":"C","text":"AML is less common in children than ALL"},{"label":"D","text":"Cytogenetic studies suggest the presence of an abnormal cell line in many patients"},{"label":"E","text":"Some patients present with severe bleeding due to coagulation factor deficiencies"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-fc5bcfbbef0c","stem":"The following are statements about the clinical findings of Chronic Granulocytic Leukemia (CGL )","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Night sweats and weight loss are common"},{"label":"B","text":"Splenomegaly is the major clinical sign"},{"label":"C","text":"Patients can present with priapism"},{"label":"D","text":"Bruising may occur despite a normal platelet count E Lymphadenomegaly is common at presentation"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7f20df9a5c82","stem":"The following relate to Chronic Lymphocytic Leukemia","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It is discovered as an incidental finding in 25% of cases"},{"label":"B","text":"Hepatosplenomegaly may occur without lymph node enlargement"},{"label":"C","text":"Thrombocytopenia indicates an advanced stage"},{"label":"D","text":"Hemolytic anemia may complicate the disease"},{"label":"E","text":"Herpes zoster infections are quite common"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-eb865db85731","stem":"Infiltration of the bone marrow by myeloma cells could cause the following","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Osteolytic bone lesions"},{"label":"B","text":"A normocytic normochromic anemia C Circulating nucleated RBCs & immature myeloid cells in 60% of cases"},{"label":"D","text":"The appearance of plasma cells in the peripheral blood E Hypocalcaemia 52 Professor Anwar Sheikha, MD, FRCP, FRCPath., FACP One Thousand Hematology MCQ"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-dad354a0ec70","stem":"The following relate to the treatment of myelomatosis","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Alkylating agents are the mainstay of treatment B Therapeutic irradiation is contraindicated"},{"label":"C","text":"Hypercalcemia must be treated urgently"},{"label":"D","text":"Prophylactic antibiotics may be indicated"},{"label":"E","text":"Treatment is best monitored by serial paraprotein measurements"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-4ebfcc41f1ee","stem":"The following concern patients with Polycythemia","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The red cell mass estimation was a must in the past for diagnosis"},{"label":"B","text":"The total blood volume is usually increased in Polycythemia Rubra Vera C Blood viscosity remains unaltered in Polycythemia Rubra Vera D Platelet function in PRV is usually normal"},{"label":"E","text":"Pruritus could be from Hyperhistaminemia secondary to basophilia"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-134b92de1fc3","stem":"The following statements relate to Myelofibrosis","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Reticulin fibers are increased in the bone marrow"},{"label":"B","text":"The development of myelofibrosis can be preceded by PRV"},{"label":"C","text":"Extramedullary hemopoiesis is a cardinal feature of the disease D The disease is often found incidentally"},{"label":"E","text":"Palpable splenomegaly is usual"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-6c1c96875af6","stem":"The following concern the recognition of splenic enlargement","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"There is a left hypochondrial mass that moves down on respiration B The notch on the anteromedial border of the spleen is rarely felt C Percussion is unhelpful in recognizing the presence of splenomegaly"},{"label":"D","text":"A plain X-ray of the abdomen is useful"},{"label":"E","text":"99Tcm colloid can be used to detect enlargement"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b18739db8394","stem":"The following blood cell changes may be seen after splenectomy","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Target cells"},{"label":"B","text":"Howell-Jolly bodies C Thrombocytopenia"},{"label":"D","text":"Transient neutrophilia"},{"label":"E","text":"Red cells containing hemosiderin"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-6686e52bdaa6","stem":"The following features relate to Hodgkin lymphoma","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The commonest presentation is painless cervical lymphadenopathy B A chest X-ray is rarely helpful"},{"label":"C","text":"Patients with constitutional symptoms have a poorer prognosis"},{"label":"D","text":"Although Pruritus is not a B-symptom, prognostically it is as important"},{"label":"E","text":"A normocytic normochromic anemia is common"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-8b96d558ecf5","stem":"The following factors inhibit thrombus formation","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Nitrous oxide"},{"label":"B","text":"Plasmin"},{"label":"C","text":"Antithrombin III D Stasis"},{"label":"E","text":"Decreased concentration of coagulation factors 53 Professor Anwar Sheikha, MD, FRCP, FRCPath., FACP One Thousand Hematology MCQ"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-38f1a5e7961e","stem":"The following factors potentiate thrombus formation: A Prostacyclin (PGI2)","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Thrombocythemia"},{"label":"C","text":"Damaged vascular endothelium"},{"label":"D","text":"Depressed RE function"},{"label":"E","text":"Inhibitors of fibrinolysis"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-cb4d2d24f1f5","stem":"The following facts concern abnormal bleeding due to thrombocytopenia","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Superficial bleeding into the skin is typical"},{"label":"B","text":"Bleeding from a superficial skin cut is often excessive"},{"label":"C","text":"Gastrointestinal hemorrhage can occur D Usually associated with joint bleeding"},{"label":"E","text":"A history of drug ingestion is important"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b99b62a53327","stem":"The following diseases could cause of thrombocytopenic purpura: A Henoch-Schonlein purpura","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Aplastic anemia"},{"label":"C","text":"Systemic lupus Erythematosus (SLE)"},{"label":"D","text":"Disseminated Intravascular Coagulation (DIC) E Hemorrhagic Disease of the Newborn (HDN)"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-c5e4a3f0ee85","stem":"The following conditions predispose to thromboembolism","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Antiphospholipid antibody syndrome"},{"label":"B","text":"Homocystinuria"},{"label":"C","text":"(HIT) Heparin-induced thrombocytopenia"},{"label":"D","text":"Factor XII deficiency"},{"label":"E","text":"Disseminated Intravascular Coagulation"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-cfa26a27981b","stem":"The followings concern Hemophilia","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The severity of bleeding is related to the factor VIII concentration B Chronic arthritis is uncommon"},{"label":"C","text":"Hematomas can compress peripheral nerves"},{"label":"D","text":"It occurs more commonly than Christmas disease"},{"label":"E","text":"If a hemophiliac marries a normal female, all their daughters will be carriers"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b5a6b6490534","stem":"The followings concern von Willebrand disease : A It is inherited as an sex-linked disease B The bleeding time is usually normal","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"C","text":"The factor VIII activity measured by clotting assay is usually low D Factor VIII-related antigen is usually normal"},{"label":"E","text":"Platelet function test is abnormal"}],"priority":2,"status":"review","flags":["mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag"],"cleaningOperations":[]},{"id":"q-54a52960da30","stem":"The followings concern the use of anticoagulants","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"During Warfarin therapy factors II, VII, IX and X are reduced B A single loading dose of 30mg Warfarin is the best way of initiating therapy"},{"label":"C","text":"Barbiturates affect the action of Warfarin D The best way of using heparin is by intermittent parenteral dosage"},{"label":"E","text":"Subcutaneous heparin is helpful in prevention of postoperative thrombosis 54 Professor Anwar Sheikha, MD, FRCP, FRCPath., FACP One Thousand Hematology MCQ"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-5c854c740279","stem":"The following concerns Disseminated Intravascular Coagulation (DIC) : A Thrombosis is rare","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Bleeding can be a major feature"},{"label":"C","text":"Fragmentation of the red cells may be observed on a blood film"},{"label":"D","text":"Thrombin time may be prolonged despite an adequate fibrinogen E Treatment with heparin is to prevent thrombosis is usually life-saving"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-10e204f63a92","stem":"The following are general statements about blood transfusion and blood groups: A Donor blood is usually collected into heparin which acts as an anticoagulant","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Most of ABO-incompatible transfusions are due to failure to check identity"},{"label":"C","text":"Anti-A and Anti-B are often absent from the sera of group O babies D The following blood groups (ABO, Rh(D) and MN) are from a mother, child and putative father : mother: A Rh(D) positive MN child : O Rh(D) negative NN putative father : A Rh(D) positive NN The result exclude paternity"},{"label":"E","text":"Care should be exercised in transfusing chronic anemias to avoid overload"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-3ab4f06e4965","stem":"Requirements for blood donors are : A The hemoglobin concentration is above 140 gm/l","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"The donor has not had malaria in the recent past"},{"label":"C","text":"The donor has not been pregnant within the previous year D The donor has never been jaundiced"},{"label":"E","text":"The donor's blood is free from evidence of active syphilis"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-9721dcc886f6","stem":"The followings are complications of rapid massive blood transfusion","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Electrocardiographic abnormalities may develop B Metabolic acidosis is common"},{"label":"C","text":"Abnormal bleeding"},{"label":"D","text":"Hypothermia"},{"label":"E","text":"Altered hemoglobin function"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-981f335e8a9b","stem":"The followings concern basic immunological reactions in blood group serology","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Anti-A agglutinate group A red cells when they are suspended in saline"},{"label":"B","text":"Addition of albumin improves the sensitivity of some serological tests."},{"label":"C","text":"Antiglobulin (Coomb's) test detects antibodies on the erythrocyte membrane which fail to agglutinate the red cells when suspended in saline"},{"label":"D","text":"The direct Coomb’s test detects in vivo sensitization of RBC with antibody"},{"label":"E","text":"The Antiglobulin test is used in the standard cross-match procedure 55 Professor Anwar Sheikha, MD, FRCP, FRCPath., FACP One Thousand Hematology MCQ"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-1f773bc3875d","stem":"The following statements relate to unwanted reactions of blood transfusion","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Complement-mediated red cell lysis follows incompatible blood transfusion"},{"label":"B","text":"Renal failure may follow the transfusion of ABO incompatible blood C Febrile transfusion reaction is usually due to Rhesus incompatibility"},{"label":"D","text":"Sudden extreme hypotension in the presence of warm extremities could indicate that the transfused blood was contaminated with bacteria"},{"label":"E","text":"One cause of urticarial & other allergic reactions is anti-IgA in the recipient"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b88c7bc5c939","stem":"The following statements concern other unwanted effects of blood transfusion","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A patient with aplastic anemia requiring 24 units of blood per annum will accumulate 6 gm of iron during that year"},{"label":"B","text":"A rapid fall of hemoglobin together with jaundice 5 to 7 days following transfusion suggests the development of delayed transfusion reaction C Post-transfusion hepatitis has been eliminated by routine HBsAg screening"},{"label":"D","text":"Dyspnea accompanied by a dry cough can be an early sign of pulmonary edema due to circulatory overload E Thrombophlebitis of the vein cannulated for transfusion is common"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-cdbe5a6f48b4","stem":"The followings are statements about blood and blood products","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The only indication for whole blood transfusion might be massive bleeding B Packed RBC has inferior post-transfusion survival compared to whole blood"},{"label":"C","text":"Cryoprecipitate contains fibrinogen D Blood product replacement therapy in patients with DIC is contraindicated"},{"label":"E","text":"Febrile neutropenic patients may benefit from the infusion of white cells from a patient with chronic granulocytic leukemia (CGL)"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ae0398c7ae11","stem":"The following are further statements about blood products","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Albumin is useful in the treatment of nephrotic syndrome B Specific immunoglobulins prepared from donor plasma in the convalescent phase of infectious disease can be used to confer active immunity C The administration of plasma protein fraction (PPF) is accompanied by the risk of transmitting serum hepatitis"},{"label":"D","text":"Coagulation deficiencies in liver disease can be treated with FFP"},{"label":"E","text":"Factor VIII concentrates has a half-life of nearly 12 hours in the circulation"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-6a5dad2a647f","stem":"The following statements concern Hemolytic Disease of the Newborn (HDN) : A Rhesus HDN is common in Rh(D) positive babies born to primiparous Rh(D) negative mothers","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Passively administered anti-D to Rh(D) negative mothers postpartum has reduced the incidence of Rh HDN"},{"label":"C","text":"High concentration of unconjugated bilirubin can cause death D A jaundiced newborn child whose blood group is O and whose mother is group A could have HDN due to ABO incompatibility E Exchange transfusion should always be performed in any newborn with HDN if the cord hemoglobin concentration is below 15 g/dl 56 Professor Anwar Sheikha, MD, FRCP, FRCPath., FACP One Thousand Hematology MCQ"}],"priority":2,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-f8bfc3aab46c","stem":"The following disorders are inherited as autosomal dominant traits","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Hereditary elliptocytosis"},{"label":"B","text":"Hereditary spherocytosis C Christmas disease (Hemophilia B)"},{"label":"D","text":"von Willebrand's disease E Glucose-6-Phosphate Dehydrogenase deficiency"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7ecde786de80","stem":"Methemoglobinemia is a recognized complication of ingestion of or exposure to","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Potassium chlorate"},{"label":"B","text":"Nitroglycerine"},{"label":"C","text":"Aniline dyes D Aspirin E Ascorbic acid"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-22dfeaaee413","stem":"Henoch-Schonlein syndrome","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"May be complicated by intussusception"},{"label":"B","text":"May run a relapsing course of as long as a year"},{"label":"C","text":"Could be associated with nephropathy"},{"label":"D","text":"Typically follows infection with β- hemolytic streptococci E Is characterized by painful erythematous, 3 cm diameter, shin lesions"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-9272b6a590dd","stem":"The following inherited problems can predispose to venous thromboembolism","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Factor V Leiden"},{"label":"B","text":"Protein C deficiency"},{"label":"C","text":"Protein S deficiency"},{"label":"D","text":"Elevated factor VIII"},{"label":"E","text":"Antithrombin III deficiency"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-5e41f03d557f","stem":"The following disorders are inherited as X-linked recessive traits","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Wiskott-Aldrich syndrome"},{"label":"B","text":"Glucose-6-Phosphate Dehydrogenase deficiency C Acute intermittent porphyria"},{"label":"D","text":"Complete testicular feminizati