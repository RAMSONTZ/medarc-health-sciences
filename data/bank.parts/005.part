,"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-165f4bece070","stem":"The single most frequent complication of myocardial infarction is","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"mural thrombosis"},{"label":"B","text":"embolism"},{"label":"C","text":"rupture of myocardium"},{"label":"D","text":"aneurysm of left ventricle"},{"label":"E","text":"arrhythmia"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-2959076133c2","stem":"The most frequent site of myocardial infarction is","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"anterior septal"},{"label":"B","text":"anterior lateral"},{"label":"C","text":"posterior lateral"},{"label":"D","text":"posterior"},{"label":"E","text":"posterior septal"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-3c9062c2ff20","stem":"The extent of myocardial damage in coronary artery disease is significantly affected by all of the following except","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"extent of coronary occlusion"},{"label":"B","text":"rate at which occlusion occurs"},{"label":"C","text":"metabolic demands of the myocardium"},{"label":"D","text":"venous pressure"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f31f0e7fdd62","stem":"Eight days after a documented myocardial infarct, a patient experiences recurrence of chest pain and equivocal changes on electrocardiogram suggesting that a second infarct has occurred. Levels for which serum enzyme would be most useful in resolving the problem?","type":"ECG Interpretation","subject":"Medical Biochemistry","topic":"Proteins and Enzymes","topicOriginal":"Proteins and Enzymes","subtopic":"Enzyme","suggestedTopic":null,"options":[{"label":"A","text":"lactic dehydrogenase"},{"label":"B","text":"creatine kinase"},{"label":"C","text":"aspartate aminotransferase"},{"label":"D","text":"alanine aminotransferase"},{"label":"E","text":"alkaline phosphatase"}],"priority":2,"status":"review","flags":["requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Medical Biochemistry","displayTopic":"Proteins and Enzymes","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","visual_asset_not_transcribed"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-8f3d0aac9aa0","stem":"Complications of myocardial infarct include","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"fibrinous pericarditis"},{"label":"B","text":"hemopericardium with tamponade"},{"label":"C","text":"both"},{"label":"D","text":"neither"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-14991d93802b","stem":"A 62-year-old woman died three weeks following an acute anteroseptal myocardial infarct. At necropsy the infarcted area will","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"show coagulation necrosis of myocardial fibers and an acute inflammatory cell infiltrate."},{"label":"B","text":"consist primarily of a slightly depressed zone of dark gray-red granulation tissue in which there are many pigmented macrophages."},{"label":"C","text":"be composed of a dense collagenous scar."},{"label":"D","text":"bulge from the cut surfaces as a soft, mottled, red and yellow area."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0be0fe15ef53","stem":"The major cause of death in myocardial infarction is","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"rupture of mitral papillary muscle"},{"label":"B","text":"congestive failure"