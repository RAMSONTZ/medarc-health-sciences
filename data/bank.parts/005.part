the participant’s own words"},{"label":"C","text":"Open-ended questions provide qualitative data in the participant’s own words"},{"label":"D","text":"Closed-ended questions directly provide qualitative data in the participants’ own words"},{"label":"E","text":"Open ended and closed questions are open to many interpretations"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"da025bac73eac172f6f3511fb805833fa515b98a"},{"id":"q-f809d5917636","stem":"Open-ended questions provide primarily what type of data?","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"Confirmatory data"},{"label":"B","text":"Qualitative data"},{"label":"C","text":"Predictive data"},{"label":"D","text":"Mixed data"},{"label":"E","text":"Quantitative data"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-0f37a2408e4e","stem":"Which of the following IS TRUE concerning observation?","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"It takes more time than self-report approaches"},{"label":"B","text":"It costs more money than self-report approaches"},{"label":"C","text":"It is always possible to determine exactly why the people behave as they do"},{"label":"D","text":"It can only be made in naturalistic settings"},{"label":"E","text":"It can be done directly through the human senses or with the aid of apparatus"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"dea288b5dc32000c06253e5749641dbc8739209b"},{"id":"q-38f0a0ba7f97","stem":"When constructing a questionnaire it is important to do each of the following EXCEPT","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"Use \"leading\" or \"loaded\" questions"},{"label":"B","text":"Use natural language"},{"label":"C","text":"Understand your research participants"},{"label":"D","text":"Pilot your test questionnaire"},{"label":"E","text":"Avoid ambiguous words"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-2679eca3e9c8","stem":"The researcher has secretly placed him or herself (as a member) in the group that is being studied. This researcher may be which of the following?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A complete participant"},{"label":"B","text":"An observer-as-participant"},{"label":"C","text":"A participant-as-observer"},{"label":"D","text":"An intruder"},{"label":"E","text":"An outsider"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"509483425e9b7502cf1dd7e55820784fe00d4c03"},{"id":"q-89751e87db85","stem":"When conducting an interview, asking \"Anything else?, What do you mean?, Why do you feel that way?,\" etc, are all forms of","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"Contingency questions"},{"label":"B","text":"Probes"},{"label":"C","text":"Protocols"},{"label":"D","text":"Response categories"},{"label":"E","text":"Additional questions"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"97b58b90fe9b09ec575c125a2f75bba48c6cddfb"},{"id":"q-2a3a099180cb","stem":"When each member of a population has an equally likely chance of being selected, this is called","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"A non-random sampling method"},{"label":"B","text":"A quota sample"},{"label":"C","text":"A snowball sample"},{"label":"D","text":"An Equal probability selection method"},{"label":"E","text":"A multistage sample"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"9bbd3e2473fedc2af8a418f9bfeff6e4ffac2075"},{"id":"q-1b105c5e561f","stem":"Which of the following techniques yields a simple random sample?","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"Choosing volunteers from an introductory psychology class to participate"},{"label":"B","text":"Listing the individuals by ethnic group and choosing a proportion from within each ethnic group at random."},{"label":"C","text":"Numbering all the elements of a sampling frame and then using a random number table to pick cases from the table"},{"label":"D","text":"Randomly selecting schools, and then sampling everyone within the school"},{"label":"E","text":"Choosing all who have same digit number from a list"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"071c5df93adb00b484e6ef23611c19c3e9df0271"},{"id":"q-8747a0d3ff54","stem":"Which of the following is NOT a form of non-random sampling?","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Snowball sampling"},{"label":"B","text":"Convenience sampling"},{"label":"C","text":"Quota sampling"},{"label":"D","text":"Purposive sampling"},{"label":"E","text":"They are all forms of non-random sampling"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"d8285909a0c1cd15a93e9f37789ae7dc96d55a76"},{"id":"q-cfb6a3d970aa","stem":"Which of the following will give a more “accurate” representation of the population from which a sample has been taken?","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"A large sample based on the convenience sampling technique"},{"label":"B","text":"A small sample based on simple random sampling"},{"label":"C","text":"A large sample based on simple random sampling"},{"label":"D","text":"A small cluster sample"},{"label":"E","text":"A large sample based on cluster sampling"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"9576630f012a87f0d88c6a53775fc49b8cb84b03"},{"id":"q-3da0e51be89a","stem":"Which one of the following sampling technique is based on belief that the researchers’ knowledge about the population can be used to hand pick sample members?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Simple random sampling"},{"label":"B","text":"Systematic sampling"},{"label":"C","text":"Quota sampling"},{"label":"D","text":"Purposive sampling"},{"label":"E","text":"Strata sampling"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d0019910b6dd","stem":"In which of the following non-random sampling techniques does the researcher ask the research participants to identify other potential research participants?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Snowball"},{"label":"B","text":"Convenience"},{"label":"C","text":"Purposive"},{"label":"D","text":"Quota"},{"label":"E","text":"Systematic"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"1e30a02d83f5442524b6766f78f718c26ab24af6"},{"id":"q-e06d0ef867d9","stem":"Which of the following is the most efficient random sampling technique discussed in research.","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggest