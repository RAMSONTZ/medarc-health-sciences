ourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"b8695f314c482660f8e4088ca20f75f93a01f165"},{"id":"q-03f52882ca4a","stem":"The strongest evidence for causality comes from which of the following research methods?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Experimental"},{"label":"B","text":"Causal-comparative"},{"label":"C","text":"Correlational"},{"label":"D","text":"Ethnography"},{"label":"E","text":"Longitudinal"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"aad121083d152cac51e8a0a26e2f7400c737e1fe"},{"id":"q-ac1979bf46f8","stem":"Which of the following IS TRUE about the use of deception in research?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It should never be used"},{"label":"B","text":"It can be used anytime"},{"label":"C","text":"If there is deception in a study, the participants may need to be debriefed"},{"label":"D","text":"The use of deception must be outweighed by other benefits of the study"},{"label":"E","text":"Both c and d are true"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-610d815387be","stem":"Which of the following generally cannot be done in qualitative studies conducted in the field?","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"Getting informed consent"},{"label":"B","text":"Keeping participants free from physical harm"},{"label":"C","text":"Maintaining consent forms"},{"label":"D","text":"Having full anonymity rather than just confidentiality"},{"label":"E","text":"Debriefing participants the purpose of the study"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-4043e3f8a845","stem":"Which of the following is NOT an ethical guideline for conducting research with humans?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Getting informed consent of the participant"},{"label":"B","text":"Telling participants they must continue until the study has been completed"},{"label":"C","text":"Keeping participants’ identity anonymous"},{"label":"D","text":"Telling participants they are free to withdraw at any time"},{"label":"E","text":"Debriefing participants about the study 13_______ means that the participant's identity, although known to the researcher, is not revealed to anyone outside of the researcher and his or her staff:"},{"label":"A","text":"Anonymity"},{"label":"B","text":"Secrecy"},{"label":"C","text":"Confidentiality"},{"label":"D","text":"Deception"},{"label":"E","text":"Desensitizing"}],"priority":2,