iginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Disseminated abscesses and granulomas in multiple organs"},{"label":"B","text":"Meningitis or meningoencephalitis with septicemia"},{"label":"C","text":"Painful, pruritic inflammatory skin lesion"},{"label":"D","text":"Endocarditis"},{"label":"E","text":"Osteomyelitis 28 – Nocardia"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e6e6ef69a25f","stem":"Which of the following describes clinical diagnosis for Nocardiosis?","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Weakly Gram-positive, beaded filaments, not acid fast, obligate anaerobe"},{"label":"B","text":"Weakly Gram-negative, beaded filaments, weakly acid fast, obligate anaerobe"},{"label":"C","text":"Weakly Gram-positive, beaded filaments, weakly acid fast, obligate anaerobe"},{"label":"D","text":"Weakly Gram-negative, beaded filaments, weakly acid fast, obligate aerobe"},{"label":"E","text":"Weakly Gram-positive, beaded filaments, weakly acid fast, obligate aerobe"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-69a17995ba71","stem":"Which of the following groups of people would be the least susceptible to Nocardiosis?","type":"Single Best Answer MCQ",