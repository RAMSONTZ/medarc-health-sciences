"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-606d044f5347","stem":"What are the Goals of ART?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antiviral","suggestedTopic":null,"options":[{"label":"A","text":"Maximal & durable suppression of viral load thus: Halting disease progression Significantly interrupting viral replication Restoration/preservation of immune function Improvement in quality of life Reduction of HIV morbidity/mortality (prolonging survival)"},{"label":"B","text":"Classes of Antiretrovirals"}],"priority":2,"status":"review","flags":["mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"0262b0c3a553b48f945d01d0001a1e6c0d94b7a1"},{"id":"q-670d1209560a","stem":"What are the Goals of ART?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antiviral","suggestedTopic":null,"options":[{"label":"A","text":"Classes of Antiretrovirals"},{"label":"B","text":"Reverse Transcriptase inhibitors"},{"label":"C","text":"NRTI mechanism of action"},{"label":"D","text":"Life cycle of HIV"},{"label":"E","text":"Lifecycleâ€¦"},{"label":"F","text":"Life cycle of HIV ctd"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceA