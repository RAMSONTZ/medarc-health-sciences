Verified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-10a4ffa52eb2","stem":"Which of the following molecular actions is catalyzed by the penicillin binding proteins?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antimicrobials","options":[{"label":"A","text":"The transport of penicillins through the poring channels"},{"label":"B","text":"The transpeptidation reaction"},{"label":"C","text":"The breakdown of the beta-lactam ring"},{"label":"D","text":"The inhibition of murein hydrolases"},{"label":"E","text":"The binding of penicillins to peptidoglycan layer"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"97f76057cf5e600c268fe997b3687cf7a4d59b53"},{"id":"q-cafb53ea7a82","stem":"Which of the following are mechanisms of resistance to beta-lactam antibiotics? (Check all that apply)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Inhibition of drug binding to 50S subunit"},{"label":"B","text":"Production of enzymes that inactivate the drug"},{"label":"C","text":"Decrease affinity of penicillin binding protein for the drug"},{"label":"D","text":"Inhibition of an efflux pump which expels the drug from bacteria"},{"label":"E","text":"Increased production of autolytic enzymes"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"6c92f0959eee2f2b1e1057d4d135b9215e60789d"},{"id":"q-c174b12c4e51","stem":"Which of the following penicillins are effective against infections caused by MS staphylococci? (Check all that apply)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antimicrobials","options":[{"label":"A","text":"Ticarcillin"},{"label":"B","text":"Amoxicillin"},{"label":"C","text":"Cloxacillin"},{"label":"D","text":"Nafcillin"},{"label":"E","text":"Piperacillin"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"40f8638a945c331f8e84eda36d18fd2849635cc1"},{"id":"q-19ce0063ecfe","stem":"Which of the following penicillins are effective against infections caused by Proteus spp? (Check all that apply)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antimicrobials","options":[{"label":"A","text":"Penicillin G"},{"label":"B","text":"Ampicillin"},{"label":"C","text":"Piperacillin"},{"label":"D","text":"Nafcillin"},{"label":"E","text":"Ticarcillin"},{"label":"F","text":"Amoxicillin"},{"label":"G","text":"Cloxacillin"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-783fa0af1ca3","stem":"Penicillins are effective in treating infections caused by which of the following bacteria? (Check all that apply)","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Listeria monocytogenes"},{"label":"B","text":"Methicillin-resistant staphylococci"},{"label":"C","text":"Escherichia coli"},{"label":"D","text":"Pseudomonas aeruginosa"},{"label":"E","text":"Enterococcus faecalis"},{"label":"F","text":"Clostridium difficile"},{"label":"G","text":"Rickettsia conorii"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-aec864012694","stem":"Which of the following statements regarding the pharmacokinetics of penicillins are correct? (Check all that apply)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Pharmacokinetic","suggestedTopic":null,"options":[{"label":"A","text":"The half-life of all penicillins is less than 3 hours"},{"label":"B","text":"Most penicillins are extensively metabolized by the liver"},{"label":"C","text":"Oral bioavailability of all penicillins is very high (>80%)"},{"label":"D","text":"Probenecid decreases penicillin G excretion by inhibiting renal tubular secretion"},{"label":"E","text":"Concentration of most penicillins in the cerebrospinal fluid is equal to that in plasma"},{"label":"F","text":"Renal clearance of penicillins is generally low (less than 30 mL/min)"},{"label":"G","text":"Therapeutic concentrations of most penicillins can be achieved in urine"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-1f309ce23a98","stem":"Which of the following statements regarding the allergic reactions to penicillins are correct? (Check all that apply)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antimicrobials","options":[{"label":"A","text":"Allergic reactions occur in about 50% of patients previously exposed to the drug"},{"label":"B","text":"Their frequency is increased when the drug is administered by oral route"},{"label":"C","text":"Cross sensitivity with aztreonam is very common"},{"label":"D","text":"Allergic reactions are due mainly to some breakdown products of penicillin molecule"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-62e400830efa","stem":"Which of the following statements best explains why broad-spectrum penicillins can cause superinfections?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antimicrobials","options":[{"label":"A","text":"They lower the immunological defense of the host"},{"label":"B","text":"They select viral mutants that are resistant to most antimicrobial drugs"},{"label":"C","text":"They mask the symptoms of the disease that therefore progresses undetected"},{"label":"D","text":"They alter the normal microflora of the host"},{"label":"E","text":"They block the activity of mediators essential for a normal inflammatory reaction"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"84b66324a9c7d9e09cce2449cf13629f4d85cd49"},{"id":"q-ba6efe1d49c2","stem":"Which of the following beta-lactam antibiotics is resistant to most beta-lactamases, is active against many gram-positive bacteria, gram-negative bacteria and anaerobes, and is inactivated by a dehydropeptidase present in the renal tubule?","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Aztreonam"},{"label":"B","text":"Imipenem"},{"label":"C","text":"Nafcillin"},{"label":"D","text":"Ceftriaxone"},{"label":"E","text":"Meropenem"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-0edbfa0c8544","stem":"Which of the following antibacterial drugs is an effective alternative for the treatment of infections caused by clostridia, including Clostridium difficile, but may cause ototoxicity?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antimicrobials","options":[{"label":"A","text":"Metronidazole"},{"label":"B","text":"Gentamicin"},{"label":"C","text":"Clindamycin"},{"label":"D","text":"Vancomycin"},{"label":"E","text":"Chloramphenicol"},{"label":"F","text":"Azithromycin"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c749fa4e4291","stem":"Which of the following antibiotics acts by inhibiting the synthesis of N-acetylmuramic acid in sensitive bacteria?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Ampicillin"},{"label":"B","text":"Cefazolin"},{"label":"C","text":"Vancomycin"},{"label":"D","text":"Erythromycin"},{"label":"E","text":"Fosfomycin"},{"label":"F","text":"Tetracycline"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-16e79ff9a19c","stem":"A 69-year-old woman from a nursing home was admitted to the hospital for watery diarrhea and hypotension. Salmonella enteritis was isolated from a stool sample and the patient stabilized with rehydration an IV antibiotic. Four days later she deteriorated with abdominal distension and absent bowel sounds. Colonoscopy showed diffuse ulcerations and exudative plaques lining the colonic mucosa. Which of the following antibiotics most likely caused the disease of the patient?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Gentamicin"},{"label":"B","text":"Vancomycin"},{"label":"C","text":"Rifampin"},{"label":"D","text":"Oxacillin"},{"label":"E","text":"Ampicillin"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"caa102292cbe9a5855e6ae7a8fd5157b283f24e6"},{"id":"q-35dcc0f83fa1","stem":"A 7-year-old girl presented with fever and a productive cough of thick, greenish sputum. Her medical history was significant for cystic fibrosis for the past 3 years and several episodes of pneumonia. The Gram stain of the sputum revealed gram-negative bacilli. Growth of the organism on agar culture exhibited a blue-green pigment. Which of the following beta-lactam drugs would be most appropriate for this patient?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Piperacillin"},{"label":"B","text":"Cefazolin"},{"label":"C","text":"Amoxicillin"},{"label":"D","text":"Clavulanate"},{"label":"E","text":"Oxacillin"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"83f1a49ec510fd211dda0466d5c024c75e8e3b16"},{"id":"q-8f8f16f19b55","stem":"A 51-year-old woman with poor dentition was scheduled to have all of her remaining teeth extracted for subsequent fitting of dentures. Past medical history of the patient was significant for numerous infections of the oral cavity. The woman has been suffering from mitral stenosis with mild cardiac insufficiency for 5 years. Which of the following drugs was most likely prescribed, to be taken before and after the extraction as a prophylactic agent?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Amoxicillin"},{"label":"B","text":"Gentamicin"},{"label":"C","text":"Aztreonam"},{"label":"D","text":"Ciprofloxacin"},{"label":"E","text":"Metronidazole"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-763079f8fb83","stem":"A 28-year old woman is in labor with her second child. Past history of the patient notes neonatal meningitis of her first baby due to perinatal contamination with Streptococcus agalactiae during delivery. In order to prevent recurrence of this infection in the newborn, both the mother and the newborn should be treated with which of the following drugs?","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Chloramphenicol"},{"label":"B","text":"Trimethoprim-Sulfamethoxazole"},{"label":"C","text":"Tetracycline"},{"label":"D","text":"Gentamicin"},{"label":"E","text":"Ampicillin"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-10062ed70817","stem":"A 10-year-old boy presents with fever of 102 F and complains of lower back, knee and wrist pain. He has a history of a severe sore throat 3 weeks earlier. Physical examination reveals subcutaneous nodules over the elbows and wrists and a serpiginous, flat, painless rash on the anterior trunk. An erythrocyte sedimentation rate is 120/h and the antistreptolysin-O titer is elevated. Which of the following treatments would be most appropriate for this patient?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Penicillin G and aspirin"},{"label":"B","text":"Amoxicillin and erythromycin"},{"label":"C","text":"Ceftriaxone and acetaminophen"},{"label":"D","text":"Tobramycin and aspirin"},{"label":"E","text":"Penicillin G and acetaminophen"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"d1303a3e8d5660008228dde3e34f6953b9b76c35"},{"id":"q-217cb4dc6fb1","stem":"A 5-year-old boy was brought to the hospital by his mother because of a localized, crusted lesion on his left leg. The mother told the physician that three days ago the boy was bitten by her home dog. A purulent discharge from the lesion was found to contain many small gram-negative coccobacilli. Which of the following drugs would be most appropriate for this patient?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Oxacillin"},{"label":"B","text":"Metronidazole"},{"label":"C","text":"Penicillin G"},{"label":"D","text":"Clindamycin"},{"label":"E","text":"Vancomycin"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9249c52d305f","stem":"A 22-year-old man presented to the clinic with a painful ulcer on his penis. Regional lymph nodes were enlarged and painful. The man admitted to visit several prostitutes while on vacation. Darkfield microscopy and FTA-ABS test for syphilis were negative. The Gram stain of pus revealed short gram-negative bacilli in parallel chains consistent with Haemophilus ducreyi. Which of the following drugs would be most appropriate for this patient?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Vancomycin"},{"label":"B","text":"Nafcillin"},{"label":"C","text":"Penicillin G"},{"label":"D","text":"Ceftriaxone"},{"label":"E","text":"Metronidazole"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4083a8216a1b","stem":"A 50-year-old man came to the emergency department complaining of diffuse abdominal pain which began 12 hours ago. He has been suffering from an alcoholic liver cirrhosis for the past six months. Physical examination revealed a patient in obvious distress with cold and wet skin. The abdomen showed ascites with diffuse tenderness upon palpation. A Gram stain of the ascitic fluid revealed gram-negative bacilli. IV administration of which of the following antibiotics would be most appropriate for this patient?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Erythromycin"},{"label":"B","text":"Ceftriaxone"},{"label":"C","text":"Oxacillin"},{"label":"D","text":"Penicillin G"},{"label":"E","text":"Vancomycin"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-2ff1bc1c5dc0","stem":"A 5-year-old boy presented with fever and sharp pain at his left ear. On physical examination the left tympanic membrane was red, opaque and bulging. Amoxicillin was prescribed but three days later the symptoms were not reduced. The pediatrician decided to change the therapy and prescribed amoxicillin/clavulanate. Which of the following statements best explains the advantage of adding clavulanate to amoxicillin?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The drug inhibits the inactivation of amoxicillin by beta-lactamase enzymes"},{"label":"B","text":"The drug is active against Pseudomonas and Serratia species"},{"label":"C","text":"The drug increases amoxicillin plasma concentration by inhibiting renal secretion"},{"label":"D","text":"The drug increases amoxicillin diffusion across the outer bacterial membrane"},{"label":"E","text":"The drug inhibits the synthesis of peptidoglycan"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"b37a419f2a4025866fbc012befa289cc7ad2a241"},{"id":"q-1bfd6a8fa723","stem":"Third generation cephalosporins differ from second generation cephalosporins because","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antimicrobials","options":[{"label":"A","text":"some of them are active against mycobacteria."},{"label":"B","text":"most of them have very long half-lives ( > 20 hours)."},{"label":"C","text":"most of them are less resistant to beta-lactamases."},{"label":"D","text":"some of them are active against Pseudomonas aeruginosa."},{"label":"E","text":"some of them are active against enterococci."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-452f2945f89c","stem":"A 48-year-old alcoholic, homeless man was admitted to the hospital with a broken arm. On examination, in addition to the fracture, an area of inflammation was found on his right thigh. The area was very painful, swollen, with a bronze discoloration and a purulent, brown, foul-smelling discharge. Crepitation was felt over the area. A Gram stain of the discharge showed only large gram-positive bacilli consistent with C. perfringens. Surgical debridement of the lesion was performed and an antibiotic was administered IV. The drug most likely was","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"cefotaxime."},{"label":"B","text":"gentamicin."},{"label":"C","text":"penicillin G."},{"label":"D","text":"ciprofloxacin."},{"label":"E","text":"aztreonam."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-76592296cd4d","stem":"Which of the following are pharmacological effects of muscarinic agonists? (Check all that apply)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology","topicOriginal":"Autonomic Pharmacology","subtopic":"Cholinergic","suggestedTopic":null,"options":[{"label":"A","text":"Increased ventricular contractility"},{"label":"B","text":"Decreased A-V conduction"},{"label":"C","text":"Bronchodilation"},{"label":"D","text":"Contraction of smooth muscle fibers in the erectile tissue of corpora cavernosa"},{"label":"E","text":"Peripheral vasodilation"},{"label":"F","text":"Increased release of acetylcholine from adrenal medulla"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-338ca02556e0","stem":"Which of the following is the most likely effect of muscarinic agonists upon the urinary system?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology","topicOriginal":"Autonomic Pharmacology","subtopic":"Cholinergic","suggestedTopic":null,"options":[{"label":"A","text":"Increased diuresis"},{"label":"B","text":"Increased tone of trigone of the bladder"},{"label":"C","text":"Increased tone of internal sphincter of the bladder"},{"label":"D","text":"Increased tone of the detrusor muscle"},{"label":"E","text":"Decreased peristalsis of ureters"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-2bff993bd99b","stem":"Which of the following is the most likely effect of muscarinic agonists upon the gastrointestinal system?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology","topicOriginal":"Autonomic Pharmacology","subtopic":"Cholinergic","suggestedTopic":null,"options":[{"label":"A","text":"Decreased pepsinogen secretion"},{"label":"B","text":"Increased tone of pylorus sphincter"},{"label":"C","text":"Relaxation of the external anal sphincter"},{"label":"D","text":"Contraction of the lower esophageal sphincter"},{"label":"E","text":"Decreased intestinal peristalsis"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-cafbc901cc9c","stem":"Muscarinic agonists are contraindicated, or should be used with caution, in which of the following disorders?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology","topicOriginal":"Autonomic Pharmacology","subtopic":"Cholinergic","suggestedTopic":null,"options":[{"label":"A","text":"Essential hypertension"},{"label":"B","text":"Gastrointestinal obstruction"},{"label":"C","text":"Raynaud’s disease"},{"label":"D","text":"Peripheral arteriosclerotic disease"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ae97ea2a484d","stem":"Which of the following is an adverse effect of cholinesterase inhibitors?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology","topicOriginal":"Autonomic Pharmacology","subtopic":"Cholinergic","suggestedTopic":null,"options":[{"label":"A","text":"Xerostomia"},{"label":"B","text":"Constipation"},{"label":"C","text":"Sweating"},{"label":"D","text":"Mydriasis"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e1fac5e3c344","stem":"Which of the following is the most common immediate cause of death from poisoning by irreversible cholinesterase inhibitors?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology","topicOriginal":"Autonomic Pharmacology","subtopic":"Cholinergic","suggestedTopic":null,"options":[{"label":"A","text":"Circulatory failure"},{"label":"B","text":"Convulsions"},{"label":"C","text":"Cardiac arrhythmias"},{"label":"D","text":"Respiratory paralysis"},{"label":"E","text":"Dehydration due to diarrhea and vomiting"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-757342e643ae","stem":"Physostigmine can most effectively counteract which of the following drug-induced effects?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology","topicOriginal":"Autonomic Pharmacology","subtopic":"Cholinergic","suggestedTopic":null,"options":[{"label":"A","text":"Atropine-induced hallucinations"},{"label":"B","text":"Epinephrine-induced increase in blood pressure"},{"label":"C","text":"Prazosin-induced decrease in blood pressure"},{"label":"D","text":"Neostigmine-induced fasciculations"},{"label":"E","text":"Nicotine-induced tachycardia"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[],"manualEdits":{}},{"id":"q-ce79504e1bf4","stem":"A 35-year-old farmer is brought to the emergency room complaining of severe abdominal cramps, vomiting and excess salivation. His skin was flushed, warm, and moist to the touch. He stated that he was working in his field with an organophosphate pesticide. Which of the following mechanism best explains the cause of the flushed skin in this patient?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Increased firing of efferent vagal fibers"},{"label":"B","text":"Activation of Nn receptors on autonomic ganglia"},{"label":"C","text":"Activation of M2 autoreceptors"},{"label":"D","text":"Inhibition of norepinephrine release from adrenergic terminals"},{"label":"E","text":"NO-induced increase in cGMP"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-dfbf7a45d515","stem":"A 67-year-old woman, recently diagnosed with open angle glaucoma, started a treatment with pilocarpine eye drops. Which of the following effects is to be expected in this patient?","type":"Single Best Answer MCQ","subject":"Ophthalmology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Relaxation of ciliary muscle"},{"label":"B","text":"Decreased lens curvature"},{"label":"C","text":"Stretching of zonula fibers"},{"label":"D","text":"Impairment of far vision"},{"label":"E","text":"Contraction of radial muscle of iris"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Ophthalmology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-92760803efc9","stem":"A 42-year-old man is brought to the emergency department because of severe vomiting and diarrhea which started about one hour after a meal. The patient shows profuse salivation, lacrimation and wheezing. His skin is warm and moist, and pupils are miotic. Skeletal muscle movements are normal. Blood pressure is 80/50 mm Hg, pulse 46/min. Poisoning of this patient is most likely due to which of the following?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"Muscarine-containing mushrooms"},{"label":"B","text":"Nicotine-containing insecticide"},{"label":"C","text":"Organophosphate containing insecticide"},{"label":"D","text":"Atropine-containing mushrooms"},{"label":"E","text":"Carbamate-containing insecticide"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-793debc044cf","stem":"A 63-year-old woman undergoes a total abdominal hysterectomy to remove an endometrial carcinoma. General anesthesia is induced with thiopental sodium, maintained with halothane and nitrous oxide, and supplemented with vecuronium. Which of the following would be useful in reversing the skeletal muscle paralysis after the surgery?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"Physostigmine"},{"label":"B","text":"Edrophonium"},{"label":"C","text":"Neostigmine"},{"label":"D","text":"Bethanechol"},{"label":"E","text":"Pralidoxime"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-200f56efeb0b","stem":"A 55-year-old man, recently diagnosed with myasthenia gravis, was treated with a cholinesterase inhibitor and with a second drug which should antagonize some of the adverse effects of the first one. The two drugs most likely were which of the following?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology","topicOriginal":"Autonomic Pharmacology","subtopic":"Cholinergic","suggestedTopic":null,"options":[{"label":"A","text":"Physostigmine and atropine"},{"label":"B","text":"Neostigmine and atropine"},{"label":"C","text":"Neostigmine and pralidoxime"},{"label":"D","text":"Donepezil and atropine"},{"label":"E","text":"Physostigmine and pralidoxime"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-55da8390a468","stem":"A 45-year-old patient suffering from severe myasthenia gravis has been receiving neostigmine for the past several months. He is admitted to the emergency room because of extreme muscle weakness, ptosis, diplopia, difficulty in swallowing, speaking and breathing. Which of the following responses to 2 mg edrophonium IV would indicate a cholinergic crisis?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"Increased muscle strength, no fasciculations"},{"label":"B","text":"Decreased muscle strength, fasciculations"},{"label":"C","text":"No change in muscle strength, no fasciculations"},{"label":"D","text":"Decreased muscle strength, no fasciculations"},{"label":"E","text":"Increased muscle strength, fasciculations"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f852d08ce741","stem":"A 54-year-old woman presented to the hospital because of a gradual onset of a scratchy sensation on both eyes and an extreme dryness of the mouth and lips. Lab exams showed elevated levels of antibodies against gamma-globulin. A diagnosis of Sjögren’s syndrome was made and a drug was prescribed to relieve patient’s xerostomia. Which of the following drugs would be useful in relieving this pateint’s xerostomia?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology","topicOriginal":"Autonomic Pharmacology","subtopic":"Cholinergic","suggestedTopic":null,"options":[{"label":"A","text":"Acetylcholine"},{"label":"B","text":"Phenylephrine"},{"label":"C","text":"Prazosin"},{"label":"D","text":"Donepezil"},{"label":"E","text":"Pilocarpine"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-738b4c093da5","stem":"A 63-year-old man underwent a surgical operation to remove a colonic carcinoma. Three days after surgery he developed a fever (103°F), abdominal distension and vomiting. Palpation showed tenderness over the entire abdomen, and auscultation revealed no bowel sound. Which of the following therapeutic measures is absolutely contraindicated in this case?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Parenteral administration of an antipyretic"},{"label":"B","text":"Nasogastric intubation and suction"},{"label":"C","text":"Parenteral antibiotic therapy"},{"label":"D","text":"SC administration of neostigmine"},{"label":"E","text":"IV administration of fluid and electrolytes"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-21797de555d2","stem":"Which of the following molecular actions can result from the blockade of M3 receptors by antimuscarinic drugs in non-vascular smooth muscle? (Check all that apply)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"More negative resting membrane potential"},{"label":"B","text":"Binding of Ca++ to troponin C"},{"label":"C","text":"More positive action potential"},{"label":"D","text":"Decreased synthesis of intracellular IP3"},{"label":"E","text":"Direct opening of K+ channels"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-240c58218388","stem":"Which of the following are the most likely effects of atropine upon the respiratory system in the normal subject? (Check all that apply)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology","topicOriginal":"Autonomic Pharmacology","subtopic":"Cholinergic","suggestedTopic":null,"options":[{"label":"A","text":"Bronchodilation"},{"label":"B","text":"Decreased mucociliary clearance"},{"label":"C","text":"Laryngeal spasm"},{"label":"D","text":"Decreased tracheobronchial secretions."},{"label":"E","text":"Increased residual respiratory volume"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-c8cd52d8bd9b","stem":"Which of the following best explains why antimuscarinic drugs can increase the heart rate?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology","topicOriginal":"Autonomic Pharmacology","subtopic":"Cholinergic","suggestedTopic":null,"options":[{"label":"A","text":"Vasodilation caused by these drugs leads to a reflex tachycardia"},{"label":"B","text":"The drugs prevent the acetylcholine-induced opening of K+ channels in the SA node"},{"label":"C","text":"The drugs prevent the acetylcholine-induced opening of Na+ channels in the AV node"},{"label":"D","text":"These drugs decrease the firing discharge of the nucleus ambiguus"},{"label":"E","text":"These drugs block presynaptic cholinergic autoreceptors"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-5c3fe8d7dc8a","stem":"Which of the following correctly pairs the effect of atropine with the main mechanism that mediates the effect? (Check all that apply)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology","topicOriginal":"Autonomic Pharmacology","subtopic":"Cholinergic","suggestedTopic":null,"options":[{"label":"A","text":"Xerostomia - blockade of M3 receptors in salivary glands"},{"label":"B","text":"Increased release of norepinephrine from nerve endings - blockade of presynaptic Nn receptors"},{"label":"C","text":"Urinary retention - blockade of M2 receptors in the detrusor muscle of the bladder"},{"label":"D","text":"Tachycardia - blockade of M2 receptors in the AV node"},{"label":"E","text":"Difficulty in near vision - blockade of M3 receptors in ciliary epithelium"},{"label":"F","text":"Mydriasis - blockade of M3 receptors in the sphincter of iris"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-02a031f2110b","stem":"Which of the following are common side effects of quaternary ammonium antimuscarinic drugs? (Check all that apply)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology","topicOriginal":"Autonomic Pharmacology","subtopic":"Cholinergic","suggestedTopic":null,"options":[{"label":"A","text":"Urge incontinence"},{"label":"B","text":"Drowsiness"},{"label":"C","text":"Constipation"},{"label":"D","text":"AV block"},{"label":"E","text":"Difficulty in near vision"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-73b8986743c5","stem":"Which of the following statements correctly pair the antimuscarinic drugs with one of their potential adverse effects? (Check all that apply)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology","topicOriginal":"Autonomic Pharmacology","subtopic":"Cholinergic","suggestedTopic":null,"options":[{"label":"A","text":"Atropine - cough"},{"label":"B","text":"Tolterodine - constipation"},{"label":"C","text":"Scopolamine - photophobia"},{"label":"D","text":"Ipratropium - restlessness"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-6a43a14d3b57","stem":"Antimuscarinic drugs are contraindicated, or should be used with caution, in which of the following disease states?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology","topicOriginal":"Autonomic Pharmacology","subtopic":"Cholinergic","suggestedTopic":null,"options":[{"label":"A","text":"Irritable bowel syndrome"},{"label":"B","text":"Sialorrhea"},{"label":"C","text":"Atrial flutter"},{"label":"D","text":"Urinary urge incontinence"},{"label":"E","text":"Sinus bradycardia"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-683163a60ae4","stem":"Atropine can most effectively counteract which of the following drug-induced effects?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology","topicOriginal":"Autonomic Pharmacology","subtopic":"Cholinergic","suggestedTopic":null,"options":[{"label":"A","text":"Physostigmine-induced sweating"},{"label":"B","text":"Epinephrine-induced increased in blood pressure"},{"label":"C","text":"Nicotine-induced increase in peripheral vascular resistance"},{"label":"D","text":"Prazosin-induced reflex tachycardia"},{"label":"E","text":"Scopolamine-induced sleepiness"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-0b44bb81b15b","stem":"A 85-year-old man resident of a nursing facility recently developed urinary incontinence. He was treated with tolterodine, which was able to decrease the urge to urinate and the pain associated with it. The mechanism of the therapeutic effect of the drug in this patient most likely involved which of the following molecular events?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology","topicOriginal":"Autonomic Pharmacology","subtopic":"Cholinergic","suggestedTopic":null,"options":[{"label":"A","text":"Decreased potassium efflux from cells of the detrusor muscle"},{"label":"B","text":"Decreased availability of cytosolic calcium in detrusor muscle cells"},{"label":"C","text":"Blockade of alpha-1 receptors in the bladder internal sphincter"},{"label":"D","text":"Activation of M3 receptors in the bladder internal sphincter"},{"label":"E","text":"Increased sodium influx into cells of the detrusor muscle"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-798b112e2397","stem":"A 5-year-old boy was prescribed ophthalmic drops in order to prepare the eye for measurement of refractive errors. One hour after the first administration the boy showed mental confusion, restlessness, incoherence and hallucinatory behavior. His pulse rate was 120 bpm. Which of the following drugs was most likely administered?","type":"Single Best Answer MCQ","subject":"Ophthalmology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Phenylephrine"},{"label":"B","text":"Epinephrine"},{"label":"C","text":"Atropine"},{"label":"D","text":"Timolol"},{"label":"E","text":"Apraclonidine"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Ophthalmology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ce182e358bec","stem":"A 48-year-old man was admitted to the coronary unit 12 hours ago with an acute inferior wall myocardial infarction. He had a left bundle branch block which now has changed into a third degree AV block, and the heart rate of the patient has decreased from 70 bpm to 48 bpm. Which of the following drugs would be appropriate to manage the patient’s bradycardia?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Epinephrine"},{"label":"B","text":"Propranolol"},{"label":"C","text":"Atropine"},{"label":"D","text":"Phenylephrine"},{"label":"E","text":"Clonidine"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4de9512976a8","stem":"A 62-year-old man has been recently diagnosed with benign prostatic hyperplasia and is scheduled for surgery. Which of the following drugs would be absolutely contraindicated in this patient?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology","topicOriginal":"Autonomic Pharmacology","subtopic":"Cholinergic","suggestedTopic":null,"options":[{"label":"A","text":"Prazosin"},{"label":"B","text":"Propranolol"},{"label":"C","text":"Labetalol"},{"label":"D","text":"Clonidine"},{"label":"E","text":"Atropine"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e9971bb0a1a9","stem":"A 58-year-old woman is admitted to the hospital with shallow breathing, wheezing, profuse rhinorrhea, lacrimation, ocular pain and diminished vision. She reported that the symptoms started when she was in her garden spraying flowers with an insecticide containing carbaryl (a reversible cholinesterase inhibitor). Which of the following drugs would be the appropriate to treat the patient’s disorder?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology","topicOriginal":"Autonomic Pharmacology","subtopic":"Cholinergic","suggestedTopic":null,"options":[{"label":"A","text":"Pralidoxime"},{"label":"B","text":"Albuterol"},{"label":"C","text":"Epinephrine"},{"label":"D","text":"Atropine"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-3d1bd1b20fc5","stem":"A 35-year-old woman has been recently diagnosed with gastroesophageal reflux disease. Which of the following drug classes would be contraindicated in this patient?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology","topicOriginal":"Autonomic Pharmacology","subtopic":"Cholinergic","suggestedTopic":null,"options":[{"label":"A","text":"Beta-1 antagonists"},{"label":"B","text":"Beta-1 agonists"},{"label":"C","text":"M3-antagonists"},{"label":"D","text":"M3-agonists"},{"label":"E","text":"Alpha-2 agonists"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-228d246fcab6","stem":"Which of the following effects can be caused by nicotine?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology","topicOriginal":"Autonomic Pharmacology","subtopic":"Cholinergic","suggestedTopic":null,"options":[{"label":"A","text":"Stimulation of water diuresis is a frequent adverse effect"},{"label":"B","text":"Pupillary diameter is usually increased"},{"label":"C","text":"Low doses can strongly decrease resting bowel tone"},{"label":"D","text":"Epinephrine plasma levels are usually increased"},{"label":"E","text":"Toxic doses usually cause a generalized inhibition of the CNS which can lead to lethargy and stupor"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f9e25f17c1f7","stem":"High doses of nicotine usually cause a ganglionic blockade after an initial stimulatory action. Which of the following best explains the reason for this blockade?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology","topicOriginal":"Autonomic Pharmacology","subtopic":"Cholinergic","suggestedTopic":null,"options":[{"label":"A","text":"Long-lasting activation of nicotinic receptors"},{"label":"B","text":"Long lasting blockade of M2 receptors"},{"label":"C","text":"Long lasting blockade of M1 receptors"},{"label":"D","text":"Prevention of acetylcholine release from ganglionic presynaptic terminals"},{"label":"E","text":"Prevention of catecholamine release from ganglionic small intensely fluorescent cells"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-8f8094176683","stem":"Pretreatment with a ganglionic blocker will most effectively prevent which of the following drug-induced effects?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology","topicOriginal":"Autonomic Pharmacology","subtopic":"Cholinergic","suggestedTopic":null,"options":[{"label":"A","text":"Neostigmine-induced increase in intestinal peristalsis"},{"label":"B","text":"Nicotine-induced contraction of skeletal muscle"},{"label":"C","text":"Norepinephrine-induced bradycardia"},{"label":"D","text":"Epinephrine-induced tachycardia"},{"label":"E","text":"Propranolol-induced hypotension"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-c66859208394","stem":"A 3-year-old boy is rushed to the emergency department by his mother after she discovered he had put on his skin 4 medication patches found in his father’s drawer. The boy presents with vomiting, diarrhea, profuse salivation, cold sweat, rapid and irregular pulse, tachypnea and mental confusion. Soon after admission the boy experiences a tonic-clonic seizure. Poisoning of this patient is most likely due to which of the following drugs?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology","topicOriginal":"Autonomic Pharmacology","subtopic":"Cholinergic","suggestedTopic":null,"options":[{"label":"A","text":"Clonidine"},{"label":"B","text":"Scopolamine"},{"label":"C","text":"Nicotine"},{"label":"D","text":"Bethanechol"},{"label":"E","text":"Neostigmine"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-20f93992e1ff","stem":"F Activation of M2 receptors in the heart leads to a decrease in AV conduction. Activation of non-innervated M3 receptors in the vascular endothelium leads to the release of nitric oxide which in turn causes vasodilation. A, C) Muscarinic agonists actually cause a slight decrease, not increase, of ventricular contractility and elicit bronchoconstriction, not bronchodilation.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"D","text":"Smooth muscle fibers in the erectile tissue of corpora cavernosa are relaxed, not contracted, by M3 receptor activation that releases nitric oxide in those structures. This action allows a rapid arterial blood into corpora cavernosa of the penis, so causing erection."},{"label":"F","text":"Activation of nicotinic receptors in the adrenal medulla results in release of epinephrine."}],"priority":2,"status":"review","flags":["mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag"],"cleaningOperations":[]},{"id":"q-034d418528d0","stem":"By activating M3 receptors muscarinic agonists increase the tone and contractility of the detrusor muscle of the bladder. B, C) The trigone and the external sphincter of the bladder are relaxed (not contracted) by parasympathetic activation, and the receptors involved are not cholinergic. With drugs that are pure muscarinic agonists, this relaxation is indirect (local reflexes are stimulated by the increased detrusor tone).","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Diuresis refers to the urine formation by the kidney. Muscarinic agonists are not diuretic agents."},{"label":"E","text":"Ureters peristalsis is increased, not decreased, by activation of M3 receptors."}],"priority":2,"status":"review","flags":["mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag"],"cleaningOperations":[]},{"id":"q-e9c9c207bff5","stem":"Activation of M3 receptors by muscarinic agonists contracts the lower esophageal sphincter. This sphincter normally remains tonically constricted, so preventing the reflux of stomach content into the esophagus, but can be relaxed by several causes including antimuscarinic drugs","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Activation of M3 receptors in the peptic cells of the stomach actually increases pepsinogen secretion."},{"label":"B","text":"The tone of all sphincters (except the lower esophageal sphincter) of gastrointestinal tract is decreased, not increased by parasympathetic activation."},{"label":"C","text":"The external anal sphincter is composed of a striated voluntary muscle and therefore not sensitive to parasympathetic activation."},{"label":"E","text":"Activation of M3 receptors by muscarinic agonists actually increases intestinal peristalsis."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-31ba196fe90c","stem":"Physostigmine is a reversible cholinesterase inhibitor which increases the amount of acetylcholine in the synaptic cleft. Acetylcholine-induced activation of M3 receptors causes contraction of the sphincter muscle of iris (so decreasing pupillary diameter) and contraction of the ciliary muscle (so increasing lens curvature). Ocular pressure is decreased because the contraction of the ciliary muscle opens the pores of the trabecular meshwork, so facilitating the outflow of the aqueous humor into the Schlemm’s canal.","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Upper Limb","topicOriginal":"Upper Limb","subtopic":"Arm","suggestedTopic":null,"options":[{"label":"A","text":"These effects would be caused by an alpha-2 agonist, like apraclonidine."},{"label":"C","text":"These effects would be caused by a beta-blocker like timolol."},{"label":"D","text":"These effects would be caused by epinephrine."},{"label":"E","text":"These effects would be caused by an antimuscarinic drug, like scopolamine."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Upper Limb","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-12837de6bced","stem":"The signs and symptoms of the patients are consistent with the diagnosis of organophosphate poisoning and are all due to an excessive amount of acetylcholine at the synaptic cleft of cholinergic terminals. The arteriolar vasodilation that causes the flushed skin is mainly due to the acetylcholine induced activation of non innervated M3 receptors which in turn trigger the release of NO. NO acts by increasing the synthesis of cGMP which is a powerful smooth muscle relaxant.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"By activating Nn receptors on autonomic ganglia acetylcholine can increase the firing of efferent vagal fibers, but this cannot explain the flushed skin (in fact this activation increases the firing of sympathetic fibers too)."},{"label":"B","text":"(see explanation above)"},{"label":"C","text":"Activation of presynaptic M2 receptors actually causes a decrease of acetylcholine release from cholinergic terminals."},{"label":"D","text":"Acetylcholine can inhibit the release of norepinephrine from adrenergic terminals (by activating M2 receptors) but this is not the main action that causes the flushed skin."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e458ee8df392","stem":"By activating M3 receptors pilocarpine triggers the contraction of ciliary muscle, which in turn increases lens curvature. The lens is therefore accommodated for near vision and far vision is impaired. A, B) (see explanation above)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"C","text":"The contraction of ciliary muscle actually relaxes zonula fibers."},{"label":"E","text":"The radial muscle of iris receives only sympathetic innervation. Parasympathetic activation cannot change the contractility of this muscle."}],"priority":2,"status":"review","flags":["mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag"],"cleaningOperations":[]},{"id":"q-33717f301358","stem":"The signs and symptoms of the patients are consistent with the diagnosis of muscarine poisoning. High concentrations of muscarine are present in various species of Inocybe and Clitocybe mushrooms and poisoning is not exceptional because of the habit to consume wild mushrooms. The symptoms of muscarine intoxication start within one hour after the ingestion and are all attributable to activation of muscarinic receptors.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"B","text":"Nicotine poisoning results from the activation, and later the blockade, of Nn and Nm receptors. Activation of Nn receptors in ganglia and adrenal medulla causes increase in sympathetic firing and increased release of norepinephrine. Early signs include cold sweat, rapid and irregular pulse and hypertension, followed by hypotension and collapse. Moreover the activation of Nm receptors at the motor end plate would cause muscle paralysis due to depolarization blockade."},{"label":"C","text":"Poisoning by organophosphates causes all symptoms due to activation of muscarinic receptors, but in addition there are also symptoms due to activation of nicotinic receptors (ie. skeletal muscle paralysis due to depolarization blockade)."},{"label":"D","text":"Some mushroom species contain atropine. The symptoms of atropine poisoning are due to blockade of muscarinic receptors, so are the opposite of those exhibited by the patient."},{"label":"E","text":"Carbamate insecticides are reversible cholinesterase inhibitors. Symptoms of poisoning by these agents are the same as the symptoms of poisoning by organophosphates."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review"],"cleaningOperations":[]},{"id":"q-7f24a1b8bb54","stem":"Reversible cholinesterase inhibitors are currently used to reverse the paralysis induced by nondepolarizing neuromuscular blocking drugs, like vecuronium. This drug blocks Nm receptors at the motor end plate while acetylcholine activates these receptors. The two drugs competitively antagonize each other and an increase availability of acetylcholine at the motor end plate can therefore reverse the muscle paralysis induced by vecuronium. Neostigmine is the preferred drug since it does not enter the brain and it is therefore free of central adverse effects.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Pysostigmine is not indicated since it can cross the blood brain barrier."},{"label":"B","text":"Edrophonium is not indicated since it has a very short duration of action (its half-life is 1-10 min) C, E) These drugs do not act at Nm receptors."}],"priority":2,"status":"review","flags":["mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag"],"cleaningOperations":[]},{"id":"q-efb0e7a90790","stem":"D When M3 receptors are activated by acetylcholine the membrane potential of a smooth muscle becomes less negative, that is the muscle is more excitable. This explains the increase in tonic tension and in the number of contractions brought about by acetylcholine. By blocking M3 receptors antimuscarinic drugs cause the opposite, that is the resting membrane potential becomes more negative and the muscle is less excitable. The postreceptor mechanism triggered by activation of M3 receptors is the stimulation of phospholipase C which in turn increases the synthesis of IP3. By blocking M3 receptors the opposite will occur.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"B","text":"In smooth muscle C1++ binds to calmodulin, not to troponin C."},{"label":"C","text":"By definition the action potential occurs with a constant amplitude, regardless the strength of the stimulus."},{"label":"E","text":"Potassium channels are regulated by M2 receptors, not by M3 receptors."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ff52132e4267","stem":"B D Antimuscarinic drugs cause bronchodilation by blocking M3 receptors in bronchial smooth muscle. All antimuscarinic drugs, except ipratropium, decrease mucociliary clearance and tracheobronchial secretions.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"C","text":"Laryngeal muscles are voluntary muscles and therefore they are not controlled by autonomic drugs."},{"label":"E","text":"Residual respiratory volume is the volume of the air left in the lung after a maximal expiratory effort. This volume cannot be changed in the normal subject but is much increased in patients with obstructive lung disease. By causing bronchodilation antimuscarinic drugs actually decrease the residual expiratory volume in these patients."}],"priority":2,"status":"review","flags":["mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag"],"cleaningOperations":[]},{"id":"q-ee496d9c1cb8","stem":"By activating M2 receptors acetylcholine opens K+ channels in the SA node. This increases the outward K+ current and the membrane becomes hyperpolarized. The result is a decrease in firing rate of the SA node. By blocking M2 receptors antimuscarinic drugs prevent the acetylcholine-induced opening of K+ channels in the SA node. The firing rate of the SA node is increased so causing an increase in heart rate.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Antimuscarinic drug causes vasodilation only when very high doses are given. Therefore a reflex action is not the main mechanism of tachycardia induced by these drugs."},{"label":"C","text":"Acetylcholine does not open Na+ channels in the SA node."},{"label":"D","text":"Even is antimuscarinic drugs can have central actions, the action on heart rate is not centrally mediated."},{"label":"E","text":"The blockade of presynaptic M2 autoreceptors increases the release of acetylcholine from cholinergic terminals. This would decrease, not increase, the heart rate."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-bd149d1cc26b","stem":"F The secretion of exocrine glands (mainly salivary and gastric) is primarily mediated by M3 receptor activation. Blockade of these receptors causes dry mouth. Pupillary diameter is mainly regulated by the sphincter of iris, which is under parasympathetic control. Activation of M3 receptors of this muscle causes miosis, blockade of these receptors causes mydriasis.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"B","text":"Activation of cholinergic receptors (mainly M2 receptors) located on adrenergic nerve endings can modulate the release of norepinephrine. Activation of these receptors decreases the release of norepinephrine. Therefore blockade of M2 (not Nn) receptors can increase the release of norepinephrine from nerve endings."},{"label":"C","text":"Antimuscarinic drugs can cause urinary retention by relaxing the detrusor muscle of the bladder. However this is due to the blockade of M3, not M2, receptors."},{"label":"D","text":"Atropine-induced tachycardia is mainly due to blockade of M2 receptors in the SA, not AV, node. Blockade of M2 receptors in AV node increases AV conduction. This would cause tachycardia only when there is an abnormal high frequency of impulses in the atrium, like in case of atrial fibrillation."},{"label":"E","text":"Atropine-induced difficulty in near vision is due to blockade of M3 receptors in ciliary muscle, not in ciliary epithelium. Relaxation of ciliary muscle lead to cycloplegia (ciliary muscle paralysis) and therefore accommodation for near vision is lost. The main function of ciliary epithelium is the production of aqueous humor."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-16a95d5f2669","stem":"E Quaternary ammonium antimuscarinic drugs mainly block muscarinic receptors but also exhibit a significant blocking activity at ganglionic Nn receptors. Blockade of M3 receptors in the gastrointestinal smooth muscle and blockade of the Nn receptors in the parasympathetic ganglia of myenteric plexus cause relaxation of the smooth muscle so leading to constipation. Likewise the blockade of M3 receptors in the ciliary muscle and Blockade of Nn receptors in the ciliary ganglion cause cycloplegia with loss of accommodation for near vision.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Urge incontinence is due to contraction of the detrusor muscle. By blocking M3 receptors antimuscarinic drugs actually cause relaxation, not contraction, of the detrusor muscle."},{"label":"B","text":"Quaternary ammonium antimuscarinic drugs do not cross the blood brain barrier so drowsiness is unlikely."},{"label":"D","text":"By blocking M2 receptors in the heart antimuscarinic drugs increase AV conduction, so AV block is unlikely."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7a38f345cc6e","stem":"C Tolterodine-induced decrease in intestinal peristalsis can lead to constipation. Scopolamine-induced mydriasis can lead to visual intolerance to bright light.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology","topicOriginal":"Autonomic Pharmacology","subtopic":"Cholinergic","suggestedTopic":null,"options":[{"label":"A","text":"By causing bronchodilation atropine can actually relieve cough."},{"label":"D","text":"Ipratropium is a quaternary ammonium compound that does not enter the brain. Therefore central adverse effects are quite unlikely."}],"priority":2,"status":"review","flags":["mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag"],"cleaningOperations":[]},{"id":"q-4f33e0d28008","stem":"Physostigmine is a cholinesterase inhibitor and therefore it can increase the availability of acetylcholine at cholinergic neuroeffector junctions. Activation of M2 receptors in sweat glands promotes sweating. By blocking these receptors atropine can counteract this action.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"B","text":"Epinephrine increase blood pressure by activating alpha-1 and beta-1 receptors. These receptors are not affected by atropine."},{"label":"C","text":"Nicotine can increase peripheral vascular resistance by activating Nn receptors at sympathetic ganglia. Atropine has negligible effects on Nn receptors."},{"label":"D","text":"Prazosin can cause reflex tachycardia by blocking alpha-1 receptors which in turn decreases the blood pressure. Atropine actually can cause tachycardia and therefore it can increase, not counteract, the action of prazosin."},{"label":"E","text":"Scopolamine and atropine are belladonna alkaloids with very close pharmacological properties. Therefore the effects of the two drugs enhance, not antagonize, each other."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-3175931fa58d","stem":"Antimuscarinic drugs relax the detrusor muscle. Therefore voiding of the bladder becomes more difficult. This can be especially dangerous in patients with prostatic hyperplasia who have already difficulty in micturition, due to prostate-induced narrowing of the urethra. In these patients antimuscarinic drugs can precipitate an acute urinary retention. B, C) Beta blockers tend to contract the smooth muscle since they block the beta-2 receptor mediated relaxation. However these drugs have little influence on nonvascular smooth muscles that are mainly under parasympathetic control.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Alpha-1 antagonists like prazosin are actually indicated in prostatic hyperplasia since they relax the internal sphincter of the bladder."},{"label":"D","text":"Clonidine is an alpha-2 receptor agonist. Alpha-2 receptors are mainly presynaptic receptors, which modulate the release of different neurotransmitters (mainly norepinephrine). This modulation is usually too weak to affect significantly the contractility of nonvascular smooth muscle."}],"priority":2,"status":"review","flags":["mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag"],"cleaningOperations":[]},{"id":"q-12f7f1a01801","stem":"Gastroesophageal reflux disease is one of the most prevalent gastrointestinal disorders. Population based studies show that it affects up to 15% of individuals. The disease is due to incompetence of the lower esophageal sphincter. This sphincter receives mainly parasympathetic innervation and remains tonically constricted. When this constriction is insufficient the gastric content can go back into the esophagus. The esophageal mucosa is not capable of resisting the digestive action of gastric secretion and erosion occurs. This explains the heartburn, which is the most prominent symptom of the disease. All drugs that relax smooth muscle are contraindicated in gastrointestinal reflux disease. Antimuscarinic drugs can be especially dangerous, since the sphincter is rich of M3 cholinergic receptors. A, B) Contraction of the smooth muscle is not mediated by beta-1 receptors.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"D","text":"M3-agonists increase the contraction of lower esophageal sphincter. Therefore these drugs would be indicated, not contraindicated, in gastroesophageal reflux disease."},{"label":"E","text":"Alpha-2 agonists have negligible effects on nonvascular smooth muscle."}],"priority":2,"status":"review","flags":["mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag"],"cleaningOperations":[]},{"id":"q-a09c1e56adf1","stem":"Nicotine induced activation of Nn receptors in the adrenal medulla stimulates the release of epinephrine, so the plasma levels of the hormone are increased.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Nicotine actually inhibits water diuresis by stimulating vasopressin secretion."},{"label":"B","text":"Nicotine usually causes miosis, due to the activation of Nn receptors of ciliary ganglion. This action overrides the effect of epinephrine on the radial muscle of iris, which would cause mydriasis (the pupil diameter is mainly under parasympathetic control)."},{"label":"C","text":"Nicotine induced activation of Nn receptors in the ganglia of myenteric plexus actually causes an increase of bowel resting tone. Gut paralysis only occurs after high doses."},{"label":"E","text":"Nicotine is a CNS stimulant. Toxic doses actually lead to convulsions."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-1181b8ade5c8","stem":"Norepinephrine increases the mean blood pressure. This increase causes a stimulation of aortic baroreceptors which activates the baroreceptor reflex. The increased vagal discharge overcomes the direct effect of norepinephrine on the heart rate (an increase due to the activation of beta-1 receptors), so the final effect is a decrease in heart rate. Ganglionic blockers impair the baroreceptor reflex and therefore bradycardia is abolished.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Neostigmine is a cholinesterase inhibitor that increases the availability of acetylcholine at every cholinergic synapse. Acetylcholine activates M3 receptors in the gut and Nn receptors in the autonomic ganglia. Both actions contribute to the increase in intestinal peristalsis. A ganglionic blocker can prevent the activation of Nn receptors but has no effect on the activation of M3 receptors. Therefore peristalsis will be decreased, but not completely abolished."},{"label":"B","text":"Nicotine-induced contraction of skeletal muscle is due to activation of Nm receptors. Ganglionic blocker have negligible activity on these receptors."},{"label":"D","text":"Epinephrine induced tachycardia is due to the activation of cardiac beta-1 and beta-2 receptors. A ganglionic blocker cannot block these receptors."},{"label":"E","text":". Ganglionic blockers actually cause hypotension by blocking the sympathetic discharge to the vessels. Therefore the propranolol-induced hypotension is in fact enhanced, not prevented."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review"],"cleaningOperations":[]},{"id":"q-383fe9b30153","stem":"The history of the patient together with his signs and symptoms are consistent with the diagnosis of nicotine poisoning. Nicotine is sold in transdermal patches for use as an aid in the treatment of nicotine withdrawal following cessation of smoking. The drug causes a rapid activation of both the sympathetic and parasympathetic nervous system, as well as a stimulation of different areas of the brain. Signs of this patient due to parasympathetic activation are vomiting, loss of urine and feces, and profuse salivation. Sings of sympathetic activation are cold sweat (sweat glands are stimulated and skin vessels are constricted), and rapid and irregular pulse (activation of Nn receptors releases epinephrine from adrenal medulla). Central stimulation accounts for the mental confusion and the to tonic clonic seizure.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Clonidine is sold in transdermal patches for the therapy of hypertension, but it does not cause most of the symptoms exhibited by the patient."},{"label":"B","text":"Scopolamine is sold in transdermal patches for the prevention of motion sickness. The drug is a muscarinic antagonist and therefore the symptoms of overdose would be the opposite of those exhibited by the patient"},{"label":"C","text":"Bethanechol is a muscarinic agonist. Symptoms of overdose would be limited to parasympathetic activation."},{"label":"E","text":"Neostigmine is a cholinesterase inhibitor. Many symptoms of poisoning by cholinesterase inhibitors are similar to those of nicotine overdose (both drugs can activate, directly or indirectly, nicotinic receptors). In cholinesterase inhibitor overdose however the cardiovascular effects are usually bradycardia and vasodilation, due to the peripheral actions of accumulated acetylcholine. Moreover, since the skin vessels are dilated, the sweat would not be “cold”. In addition, in the case of neostigmine central effects would be negligible since the drug crosses poorly the blood brain barrier."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review"],"cleaningOperations":[]},{"id":"q-eafba2f0b183","stem":"The drug causes an increase in diastolic blood pressure and a decrease in heart rate. This suggests that the increased blood pressure has caused a reflex bradycardia. Among the listed drugs only norepinephrine and phenylephrine can cause these effects, due in both cases to alpha-1 receptor activation. In fact both effects are prevented by a pretreatment with prazosin and unaffected by pretreatment with propranolol or atropine.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Norepinephrine-induced decrease in heart rate is due to reflex bradycardia which overcomes the direct tachycardic effect due to beta-receptor activation. A pretreatment with atropine would antagonize the reflex bradycardia (which is vagal-mediated) so unmasking the direct tachycardic effect. By the same token a pretreatment with propranolol would antagonize the direct tachycardic, effect so enhancing the reflex bradycardia. This does not occur with phenylephrine which is a pure alpha agonist with no direct effects on the heart."},{"label":"B","text":"Epinephrine usually does not cause an increase in diastolic blood pressure since the alpha-1 mediated vasoconstriction is counterbalanced by the beta-2 mediated vasodilation. C, E) Isoproterenol and acetylcholine decrease, not increase, the diastolic blood pressure."}],"priority":2,"status":"review","flags":["mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["long_option_manual_review","mcq_missing_options","not_enough_options","prior_structural_review_flag"],"cleaningOperations":[]},{"id":"q-d59023ec99a9","stem":"Previous Classification of Diabetes Mellitus: Insulin Dependent Diabetes Mellitus (IDDM) = Type 1 Non-Insulin Dependent Diabetes Mellitus (NIDDM) = Type 2 2 Classification ... • In 1997, The American Diabetes Association adopted the following guidelines for the classification of diabetes types, based on aetiology. • Type 1 - results from an autoimmune response to pancreatic ß-cell component(s) triggered by viral infection • Type 2 - hyperglycemia may be due to: the external secretions to keep dogs with diabetes alive?","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"Diabet","suggestedTopic":null,"options":[{"label":"A","text":"Increased hepatic glucose production"},{"label":"B","text":"Impaired insulin secretion"},{"label":"C","text":"Receptor and post receptor defects (insulin resistance) • Chronic hyperglycemia of diabetes is associated with long-term damage, dysfunction, and failure of various organs, especially the eyes, kidneys, nerves, heart and blood vessels. 3 Diabetes – Insulin (Biosynthesis, storage, secretion) Insulin gene is on chromosome 11 Synthesized largely by β cells of the Islets of Langerhans (pancreas) as a 12,000 Dalton precursor (preproinsulin) The insulin mRNA is translated as a single chain precursor called preproinsulin Processed to final secreted products (proinsulin, insulin, C-peptide). Removal of signal peptide during insertion into the endoplasmic reticulum (ER) generates proinsulin Synthesis is regulated at the transcriptional and translational levels. 4 Proinsulin • Proinsulin consists of 3 domains: an amino-terminal B chain, a carboxy-terminal A chain and a connecting peptide in the middle known as the C peptide. • Within the ER, proinsulin is exposed to several specific endopeptidases which excise the C peptide, generating the mature form of insulin. • Insulin and free C peptide are packaged in the Golgi into secretory granules which accumulate in the cytoplasm. • When the beta cell is appropriately stimulated, insulin is secreted from the cell by exocytosis and diffuses into islet capillary blood. C peptide is also secreted into blood, but has no known biological activity. 5 Proinsulin to Insulin Within the ER, proinsulin is exposed to several specific endopeptidases which excise the C peptide, thereby generating the mature form of insulin Stored as β granules Exists as a monomer, dimer or hexamer; Each hexamer binds two molecules of Zn2+ which coordinates crystal formation within β granules of insulin 6 Insulin Consist of A & B chains linked by 2 disulfide bonds (plus additional disulfide in A) Positions B24 and B25 are important sites for receptor recognition; Substitution at these sites – a product with a marked change in biological activity. A = 21amino acids B = 30 amino acids ~ 7 Banting and Best 8 The birth of an idea In Ontario, Canada, first conceived the idea - discovery of insulin. One evening, after delivering a lecture on the pancreas to medical students, he was struck by an idea: Could the internal secretions of the pancreas be isolated from - tie-off pancreatic ducts to cause acinar tissue degeneration, thereby removing proteases which were destroying the anti- diabetic principle during its extraction. 9 The Discovery of insulin Banting began his research on May 19, 1921, with Macleod as formal supervisor and Charles Banting as his assistant. In August 1921 after numerous failures, Banting and Best prepared a new extract from the atrophied pancreas of one of the dogs. They then isolated two other dogs with diabetes, administering the extract to one and leaving the second untreated. Four days later, the untreated dog died of severe diabetes. The dog that received the extract lived for 3 more weeks, dying only when the extract was used up - Marjorie. 10 Marjorie 11 First Human Patient On Jan. 11, 1922, 14-year-old Leonard Thompson was the first human patient to receive insulin made by Banting and Best. The initial test failed, causing only slight reductions in blood glucose levels. A second series of \"purified\" insulin injections, produced by J.B. Collip, achieved the desired results. Leonard's blood glucose dropped to normal, and he began to gain weight. 12 Insulin therapy Prior to 1972, purity of commercial insulin preparations was low and the insulin contained 5-10% impurities, proinsulin being the major contaminant. Insulin preparations are now recombinant and lack proinsulin and other contaminants. The clinical significance of purified insulin preparations has been a reduction in side effects thought to be caused by immunological issues including:"},{"label":"A","text":"lipodistrophy"},{"label":"B","text":"insulin allergy"},{"label":"C","text":"antibody-related insulin resistance"},{"label":"D","text":"prolonged circulation of injected insulin may contribute to hypoglycemia"},{"label":"E","text":"immune complex deposition 13 Factors Affecting Insulin Secretion"},{"label":"A","text":"Stimulatory Factors Metabolic components glucose* / amino acids / fatty acids / ketones Hormonal components – incr cAMP – incr Ca2+ Cholinergic and β2-adrenergic stimulation (propranolol decrease) Intestinal nutrients via gastrin, secretin, enteroglucagon - oral vs. iv glucose yields a larger response"},{"label":"B","text":"Inhibitory Factors - Decrease cAMP Levels insulin / epinephrine / adrenergic stimulation / serotonin 14 Mechanism of Insulin Action"}],"priority":2,"status":"review","flags":["too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Endocrinology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","long_option_manual_review","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","too_many_options","too_many_options_possible_merge"],"cleaningOperations":["option_whitespace_normalization","whitespace/page_marker_normalization"],"duplicateStemGroup":"c834f65e95127abe09386bfdb3d6e5620710fc2a"},{"id":"q-44c108d18adc","stem":"How common are signs of drowning?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Lunetta et al 2002, Retrospective study of 1590 bodies found in water Plume of pulmonary oedema 17.3 % Pulmonary oedema in airways 46.5% Overexpanded lung 42.1% All three 18.3% No diagnosis determined on basis of circumstances & PM changes 41.5%"},{"label":"B","text":"€-aò6$ÿÿ"},{"label":"C","text":"Washerwoman hands"},{"label":"D","text":"This is a sign of immersion not drowning"},{"label":"E","text":"Water in the stomach"},{"label":"F","text":"Not usually this obvious! Water may be found in the stomach in some dumped bodies, therefore probably a sign of immersion not drowning"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"857c735dc0a430fe8664f564ee56637aa2396501"},{"id":"q-b6c59e27fbdc","stem":"How common are signs of drowning?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Washerwoman hands"},{"label":"B","text":"Water in the stomach"},{"label":"C","text":"Immersion"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"857c735dc0a430fe8664f564ee56637aa2396501"},{"id":"q-a8dcc6f7c718","stem":"What exactly do we mean by race, ethnicity and culture?","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"359981ecfbf5b4c332d56ffb4e6a5e368415a5ba"},{"id":"q-a513df5d587c","stem":"What exactly do we mean by race, ethnicity and culture?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cultural Assimilation"},{"label":"B","text":"Cultural Differences"},{"label":"C","text":"Cultural Differences"},{"label":"D","text":"Liberal visiting hours and an un-limited number of visitors (Family based care). Incorporation of religious beliefs and cultural traditions in tandem with Western medicine."},{"label":"E","text":"Cultural Differences"},{"label":"F","text":"Can effect the quality of client care Can have a negative effect on the family Should be evaluated carefully to improve healthcare outcomes and prevent: Misunderstandings Stereotyping Barriers Conflict"}],"priority":2,"status":"review","flags":["topic_generic","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_text","nonunique_option_text","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"359981ecfbf5b4c332d56ffb4e6a5e368415a5ba"},{"id":"q-5066c3122f4c","stem":"What Are Ethical Principles, and How Do They Help With Decision Making?","type":"Single Best Answer MCQ","subject":"Medical Ethics and Law","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ethical Principles"},{"label":"B","text":"Conflict is inevitable. Ethical principles provide the framework/ tools which may facilitate individuals and society to resolve conflict in a fair, just and moral manner."},{"label":"C","text":"Ethical Principles"},{"label":"D","text":"Autonomy/Freedom Veracity Privacy/Confidentiality Beneficence/Nonmaleficence Fidelity Justice"},{"label":"E","text":"Autonomy"},{"label":"F","text":"Veracity"}],"priority":2,"status":"review","flags":["topic_generic","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Ethics and Law","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_text","nonunique_option_text","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"46331299ef82f276084e72eee9938f2e0daa3138"},{"id":"q-f2e2b9f327e3","stem":"Why Employ Ethical Principles?","type":"Single Best Answer MCQ","subject":"Medical Ethics and Law","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Respect for the Individual"},{"label":"B","text":"In our pluralistic society individuals often misunderstand each other. Even when they do understand each other, it is possible for them to disagree. The Healthcare arena, in common with every other segment of society has found it necessary to find ways to create understanding and agreement."},{"label":"C","text":"How to Create Understanding"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Ethics and Law","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"cdd0f8874d97c58052e88c51fc73999d4420fbc6"},{"id":"q-9bf06c2f0863","stem":"How May Harmony Be Achieved?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Through ethical principles/behaviors, because they: Provide a unique opportunity for personal fulfillment and self respect. Serve to make it possible for professionals to deal with each other on a human level with respect across all disciplines."},{"label":"B","text":"Ethical Principles/Behaviors Continued:"},{"label":"C","text":"Serve to make it possible for professionals and clients to deal with each other on a human level with respect across all cultures and communities. Make it possible for strangers to achieve understanding (if agreement is not reached, toleration may be achieved)."},{"label":"D","text":"Ethical Principles/Behaviors Continued:"}],"priority":2,"status":"review","flags":["topic_generic","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_text","nonunique_option_text","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"849ddc8cac11a65f3f1a16ce988de14b37566692"},{"id":"q-7f0ffb0be07d","stem":"Why increase interest and respect for diverse societal values?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ethics consults are confidential. Any recommendations made are purely advisory in nature. Patients, family members, and health care providers remain responsible for making their own decisions."},{"label":"B","text":"There are certain ethical theories that are employed that serve as a framework to respond to a myriad of ethical questions which we will explore in the next several slides."},{"label":"C","text":"An example of stereotyping is all Latinos are loud, all Irish people are alcoholics, all New Yorkers are crass and loud, all Southerners are prejudiced, all Sicilians are not members of the Mafia."},{"label":"D","text":"Ethnicity can misleading as for example all Latinos do not necessarily share the same cultural values as they come from different countries. Even though one may identify with a certain cultural group, they may not share all the values often associated with that group. For example all Italians are not Catholic."},{"label":"E","text":"An example of a misunderstanding which may be a barrier to healthcare is assuming that all people of color have poor dietary habits that lead to poor health, (hypertension, obesity and stroke)."},{"label":"F","text":"All Chinese have very similar physical appearances, however, their views about their government and procreation may differ."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-726c90aaf169","stem":"What exactly do we mean by race, ethnicity and culture?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cultural Assimilation"},{"label":"B","text":"Cultural Differences"},{"label":"C","text":"Cultural Differences"},{"label":"D","text":"Cultural Differences"},{"label":"E","text":"Stereotypes:"},{"label":"F","text":"Generalizations"}],"priority":2,"status":"review","flags":["topic_generic","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_text","nonunique_option_text","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"359981ecfbf5b4c332d56ffb4e6a5e368415a5ba"},{"id":"q-d35094563264","stem":"What Are Ethical Principles, and How Do They Help With Decision Making?","type":"Single Best Answer MCQ","subject":"Medical Ethics and Law","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ethical Principles"},{"label":"B","text":"Ethical Principles"},{"label":"C","text":"Autonomy"},{"label":"D","text":"Veracity"},{"label":"E","text":"Privacy/Confidentiality"},{"label":"F","text":"Beneficence/Nonmaleficence"}],"priority":2,"status":"review","flags":["topic_generic","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Ethics and Law","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_text","nonunique_option_text","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"46331299ef82f276084e72eee9938f2e0daa3138"},{"id":"q-92e9dca42d5b","stem":"Why Employ Ethical Principles?","type":"Short Answer","subject":"Medical Ethics and Law","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Ethics and Law","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"cdd0f8874d97c58052e88c51fc73999d4420fbc6"},{"id":"q-fdc2aac6d482","stem":"How to Create Understanding and Agreement?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Creating Harmony is Difficult In The Healthcare Arena."},{"label":"B","text":"Changing Healthcare Environment"},{"label":"C","text":"External Forces"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-31e1e09cc6a6","stem":"How May Harmony Be Achieved?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ethical Principles/Behaviors Continued:"},{"label":"B","text":"Ethical Principles/Behaviors Continued:"},{"label":"C","text":"Cultural Values Influence Decision Making"},{"label":"D","text":"Ethical Dilemma: Deciding People’s Fate"}],"priority":2,"status":"review","flags":["topic_generic","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_text","nonunique_option_text","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"849ddc8cac11a65f3f1a16ce988de14b37566692"},{"id":"q-1a2f7d0296d4","stem":"All of the following drugs exhibit flow dependent elimination EXCEPT a. Atenolol b. Isoniazid c. Propoxyphene d. Amitriptylline e. Lignocaine 7. Which of the following undergoes a phase I hydrolysis reaction? (biotransformation) a. Ethanol b. Naloxone c. Morphine d. Lignocaine e. Diazepam 8. Which of the following undergoes acetylation in the liver? (Phase 2 biotransformation) a. Isoniazid b. Acetaminophen c. Salicylic acid d. Epinephrine e. Diazepam 9. B C Concentration Which of these drugs is the most efficacious? a. Drugs A and B b. Drug C c. Drugs A and D d. Drugs D and C e. Drug A","type":"Short Answer","subject":"Pharmacology","topic":"CNS Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"CNS Pharmacology","options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"CNS Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["possible_multiple_questions_in_stem","topic_generic"],"cleaningOperations":[]},{"id":"q-a73a0f2609cb","stem":"Referring to the graph in question 9 – which of the drugs is most potent? a. A b. B c. C d. D e. A and B 11. EC50 is a. Measured with a radioactive receptor b. Always equal to Kd c. Drug concentration with 50% receptors bound d. Representation of the receptors affinity for drug binding e. Drug concentration with 50% of maximal drug effect 12. Which of the following will NOT alter the volume of distribution of a drug? a. Cardiac failure b. Clearance c. Age d. Burns e. Pleural effusion 13. Volume of distribution equals a. Dose given/plasma concentration b. Total amount of drug in the body/plasma concentration c. Urine drug concentration/plasma concentration d. Dose given/urine concentration e. Urine drug concentration/plasma concentration 14. Which of the following drugs undergoes rate limited elimination? a. Lignocaine b. Morphine c. Warfarin d. Propanolol e. Aspirin 15. Ligand gated channel receptors include all of the following EXCEPT a. GABA b. Aspartate c. Glycine d. Glutamate e. Ach-muscarinic","type":"Short Answer","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["possible_multiple_questions_in_stem"],"cleaningOperations":[]},{"id":"q-3d31f9f3a521","stem":"MCQs – Pharmacodynamics & Pharmacokinetics May 2006 1. Which of the following drugs has an average half life of 50 hours?","type":"Short Answer","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Pharmacodynamic","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-fe0f8ef2b079","stem":"What's post-mortem examination?","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-783338afccad","stem":"A 23-year-old woman suffering from asthma has been prescribed albuterol by inhalatory route. Albuterol is a bronchodilating drug with a molecular weight of 239. Which of the following permeation processes most likely accounts for the transfer of the drug through the bronchial mucosa?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Active transport"},{"label":"B","text":"Aqueous diffusion"},{"label":"C","text":"Passive diffusion"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-fbabe4c744f1","stem":"A 65-year old man suffering from hypertension has being taking hydrochlorothiazide orally, one tablet daily. Hydrochlorothiazide is an acidic drug with a pKa of about 9. Which of the following parts of digestive tract most likely represents the main site of absorption of the drug?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"Oral mucosa"},{"label":"B","text":"Stomach"},{"label":"C","text":"Small intestine"},{"label":"D","text":"Colon"},{"label":"E","text":"Rectum"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-64349defc110","stem":"Explain how the organochlorine pesticide DDT (which is banned in the US) persists in the human body and can cause chronic adverse effects.","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5f172922e2db","stem":"Which route of drug administration is used with potent and lipophilic drugs in a patch formulation and avoids first pass metabolism?","type":"Calculation","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0c16b2f06aa2","stem":"Lipid diffusion of a drug through the luminal membrane of gastric cells can lead to very high concentration of the drug inside the cell if the drug is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"a base with pKa of 7."},{"label":"B","text":"an acid with pKa of 3.5."},{"label":"C","text":"a base with pKa of 5.2."},{"label":"D","text":"an acid with pKa of 8.5."},{"label":"E","text":"non ionizable."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-9cb511337ca1","stem":"Valproic acid is an antiseizure drug with a pKa of 5. Approximately what percentage of the drug would be in the lipid soluble form in the duodenal lumen (pH = 7)?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"1"},{"label":"B","text":"24"},{"label":"C","text":"50"},{"label":"D","text":"76"},{"label":"E","text":"99"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-15bd0dba9fd5","stem":"A 70-year-old woman is brought to the Emergency Room by her son, who told the physician that his mother has been lethargic, disoriented and combative over the last 3 hours. Additional history revealed that she had ingested a large number of aspirin tablets in a suicide attempt. Appropriate therapy was instituted, which included the administration of sodium bicarbonate. What was the rationale for administering sodium bicarbonate?","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-21ea5d8ffd14","stem":"The Henderson-Hasselbalch equation predicts that a weak acid will be more non-ionized, and therefore more lipid soluble, when pKa>pH. Since the pH of the stomach lumen is less than 2, an acid with the pKa of 3.5 will be mainly in the non-ionized form in the gastric lumen, and will readily penetrate the gastric mucosal cell membranes. Inside the mucosal cells, however, the pH is about 7 and the drug will become mainly ionized because now pKa is less than pH. As a consequence, the concentration gradient of the non-ionized, lipid soluble form, will remain high and the drug will continue crossing the cell membranes. At equilibrium the concentration of nonionized moiety of the drug will be the same on both sides, but the concentration of the ionized moiety inside the cell can be 15 to 20 times higher than that in the gastric lumen since the ionized moiety is \"trapped\" inside the cell (ion trapping mechanism). Therefore the total drug concentration inside the cell will be very high. A, C) Basic drugs are mainly ionized when the pKa is higher than the pH and therefore most of the drug will stay in the stomach lumen.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"D","text":"An acidic drug with pKa of 8.5 will be mainly non-ionized in the stomach lumen and therefore will readily penetrate the gastric mucosal cell membranes. Inside the mucosal cells, however the drug will remain mainly nonionized since pKa > pH. In this case, no ion trapping will occur and the drug will not concentrate inside the cells."},{"label":"E","text":"A non-ionizable drug does not change its status according to the pH of the medium and therefore cannot be concentrated inside the cell by a lipid diffusion process."}],"priority":2,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-3c5625d5ed1c","stem":"When a drug is given by oral route it is swallowed and therefore the oral mucosa does not","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b45a99d03266","stem":"state was sufficient to control his symptoms when he was smoking. Upon smoking cessation","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ae3f5a0a2d7b","stem":"A 57-year-old woman recently diagnosed with pheochromocytoma was under surgery to remove the tumor. With manipulation of the adrenal mass her blood pressure rose to 200/140 mm Hg. Which of the following pairs of drugs were most likely administered during the operation to reduce her blood pressure?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Phenoxybenzamine and propranolol"},{"label":"B","text":"Prazosin and esmolol"},{"label":"C","text":"Metyrosine and pindolol"},{"label":"D","text":"Clonidine and propranolol"},{"label":"E","text":"Clonidine and pindolol"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"5a0b72a9a19562130aec6b3fbcf2a293f78b9e2c"},{"id":"q-1c40fd6df952","stem":"Recognized clinical indications for the use of terbinafine include which of the following diseases?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[{"label":"A","text":"Actinomycosis"},{"label":"B","text":"Brucellosis"},{"label":"C","text":"Toxoplasmosis"},{"label":"D","text":"Onychomycosis \\*504b030414000600080000002100828abc13fa0000001c020000130000005b436f6e74656e745f54797065735d2e786d6cac91cb6ac3301045f785fe83d0b6d8 72ba28a5d8cea249777d2cd20f18e4b12d6a8f843409c9df77ecb850ba082d74231062ce997b55ae8fe3a00e1893f354e9555e6885647de3a8abf4fbee29bbd7 2a3150038327acf409935ed7d757e5ee14302999a654e99e393c18936c8f23a4dc072479697d1c81e51a3b13c07e4087e6b628ee8cf5c4489cf1c4d075f92a0b 44d7a07a83c82f308ac7b0a0f0fbf90c2480980b58abc733615aa2d210c2e02cb04430076a7ee833dfb6ce62e3ed7e14693e8317d8cd0433bf5c60f53fea2fe7 065bd80facb647e9e25c7fc421fd2ddb526b2e9373fed4bb902e182e97b7b461e6bfad3f010000ffff0300504b030414000600080000002100a5d6a7e7c00000 00360100000b0000005f72656c732f2e72656c73848fcf6ac3300c87ef85bd83d17d51d2c31825762fa590432fa37d00e1287f68221bdb1bebdb4fc7060abb08 84a4eff7a93dfeae8bf9e194e720169aaa06c3e2433fcb68e1763dbf7f82c985a4a725085b787086a37bdbb55fbc50d1a33ccd311ba548b63095120f88d94fbc 52ae4264d1c910d24a45db3462247fa791715fd71f989e19e0364cd3f51652d73760ae8fa8c9ff