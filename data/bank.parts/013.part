:"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Systemic disease in children younger than 5 years has been virtually eliminated in the United States"},{"label":"B","text":"Most of the H. influenzae type B infections now occur in children who had incomplete vaccination or poor response to the vaccine"},{"label":"C","text":"Outside of the United States, influenza type B remains the most significant pediatric pathogen in many countries of the world"},{"label":"D","text":"Elderly patients in the United States are unlikely to get influenza type B because they are vaccinated"},{"label":"E","text":"Ear and sinus infections caused by these organisms are primarily pediatric diseases"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-6049582deb2c","stem":"Which of the following is NOT true for Pasteurella multocida?","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Oxidase positive"},{"label":"B","text":"Catalase positive"},{"label":"C","text":"Gram-negative"},{"label":"D","text":"Coccobacilli"},{"label":"E","text":"Non-fermentive"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-3f7e7ed063b3","stem":"How would a person typically acquire a P. multocida infection?","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Mosquitoes bite"},{"label":"B","text":"Cat bite"},{"label":"C","text":"Unpasteurized milk"},{"label":"D","text":"Person-to-person via aerosols"},{"label":"E","text":"Sexual contact 36 & 37 – Bordetella, Francisella and Brucella"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-31f1b7325204","stem":"1) Which of the following describes laboratory characteristics of Bordetella pertussis?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Labor and Delivery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Labor and Delivery","options":[{"label":"A","text":"Oxidase positive, urease positive, non-motile, growth on sheep blood agar, no growth on MacConkey agar"},{"label":"B","text":"Oxidase negative, urease negative, motile, no growth on sheep blood agar, no growth on MacConkey agar"},{"label":"C","text":"Oxidase positive, urease negative, non-motile, no growth on sheep blood agar, no growth on MacConkey agar"},{"label":"D","text":"Oxidase positive, urease negative, motile, growth on sheep blood agar, growth on MacConkey agar"},{"label":"E","text":"Oxidase negative, urease negative, non-motile, growth on sheep blood agar, growth on MacConkey agar"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Labor and Delivery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"pu