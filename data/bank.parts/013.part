us"},{"label":"D","text":"All of the above are correct (p. 326)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1cfe094936eb","stem":"18 The following local anaesthetic is poorly water soluble, PABA derivative and primarily used for anorectal lesions, wounds and ulcers","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Trauma and Emergency Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Trauma and Emergency Surgery","options":[{"label":"A","text":"Benzocaine"},{"label":"B","text":"Dibucaine"},{"label":"C","text":"ProcaineAim4aiims.inD. Benoxinate (p. 326) 22222 44444 ..... 11111 55555 C 22222 44444 ..... 11111 66666 B 22222 44444 ..... 11111 77777 D 22222 44444 ..... 11111 88888 A 158158158158158 MCQs in Pharmacology"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Trauma and Emergency Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-7a157dba4ee5","stem":"19 Choose the local anaesthetic that is specifically used to produce corneal anaesthesia for tonometry","type":"Single Best Answer MCQ","subject":"Anesthesiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Tetracaine"},{"label":"B","text":"Oxethazaine"},{"label":"C","text":"Ropivacaine"},{"label":"D","text":"Benoxinate (p. 326)"}],"priority":2,"status":"practi