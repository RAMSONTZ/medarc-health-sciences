ceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Nephrology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d295658e2967","stem":"The following are correct concerning administration of Cotrimoxazole prophylaxis","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"TRUE All patients who are in WHO clinical stage II,III,IV"},{"label":"B","text":"FALSE All asymptomatic HIV infected individual CD4>350"},{"label":"C","text":"FALSE HIV positive patient allergic to sulfur"},{"label":"D","text":"TRUE All HIV infected pregnant women"},{"label":"E","text":"FALSE Dosage should be twice daily 22. MATCHING ITEM QUESTIONS: Match the side effects from column B with responsible medicine in column A COLUMN A ( Medication ) COLUMN B ( Side effect) 15"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"a98d82a82a3e16d7db23b5f65e18b4c49c479d8b"},{"id":"q-39e46a9dbb87","stem":"F Nifedipine E. Idiosyncratic bone marrow suppression","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"F","text":"Severe headache"},{"label":"G","text":"Hemoptysis"},{"label":"H","text":"Acute renal failure"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-44fa30cabc0e","stem":"B Acute lymphoblastic leukemia E. Aplastic anaemia","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"F","text":"Mature abnormal lymphocytes"},{"label":"G","text":"Myeloid hyperplasia with left shift"},{"label":"H","text":"Monoclonal protein spike in urine"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-77d6c36a4bd1","stem":"Match the following oral hypoglycemic drugs from column B with their corresponding class in column A. Column A Column B 1 G Biguanides A: Rosiglitazone 2 F 1st generation Sulfonyl urea B: Glibenclamide 3 B 2nd generation Sulfonyl urea C: Methadone 4 A Thiazolidinediones D: A-Carbose 5 D Alpha glycosidase inhibitors E: Amiodarone","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"F","text":"Chlopropramide"},{"label":"G","text":"Metformin"},{"label":"H","text":"Chlorpromazine SECTION D: SHORT ANSWER QUESTIONS 40 MARKS Instructions: • This section consist of Eight (8) questions • Write your answer on the space provided in the answer booklet • Write readable handwrite; DIRTY WORK IS NOT ALLOWED 17"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-67db9bf087ba","stem":"Mention six (6) skin conditions associated with HIV infection (3 Marks) i. Herpes simplex infection v. Molluscum contigiosum ii. Herpes zoster vi. Bacteria skin infection e.g impetigo iii. Kaposi’s sarcoma vii. Serborrhoeic dermatitis iv. Norwegian scabies viii. Warts","type":"Short Answer","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-89576af9e245","stem":"Outline eight (8) neurological symptoms associated with hypoglycemia (4 Marks) i. Confusion vii. Tachycardia ii. Irritability and anger viii. Sweating and trembling iii. Speech difficulty ix. Anxiety iv. Inability to concentrate x. Irritability and anger v. Incoordination xi. Trembling vi. Drowsiness","type":"Short Answer","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1cb43e281b76","stem":"Outline the Treatment of acute severe pulmonary oedema (5 Marks) i. Positioned the patient at cardiac position (450) ii. Give oxygen therapy iii. Give I.V loop diuretic (furosemide 1mg/kg 8-12hrly) iv. Give I.V morphine 4-6hourly v. Nitrates e.g Isosorbide mononitrate","type":"Clinical Vignette","subject":"Internal Medicine","topic":"Cardiology","topicOriginal":"Cardiology","subtopic":"Cardiac","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Cardiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-2c21d3a279b3","stem":"Mention five (5) poor prognostic indicators for a patient presenting with acute stroke (2.5 Marks) i. Presence of infection/aspiration pneumonia ii. Presence of uncontrolled diabetic mellitus iii. Hemorrhagic stroke carries poor prognosis than Ischemic stroke iv. Extent of stroke, stroke involving large area carries poor prognosis than the one involving small area v. Area of stroke, brain stem strokes carries poor prognosis vi. Presence of fever vii. Low level of consciousness at presentation","type":"Clinical Vignette","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6c06d8570e2d","stem":"Outline five (5) differential Diagnoses of a 40 years old male who is brought to you because of convulsions: (2.5 marks) Answers: • Epilepsy • Viral encephalitis • Severe Malaria • Meningitis 18 • Electrolyte imbalance • Hypoglycemia • Space occupying lesions","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-045afbf19257","stem":"An eighteen year old young man gives history of swelling of body starting from face and more on getting up in the morning. On examination his blood pressure is normal, pallor is absent and jugular venous pressure is not raised. Signs of ascites and bilateral pleural effusion are found.","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"What is the most likely diagnosis of this patient? ( 1 Mark) Nephrotic syndrome"},{"label":"B","text":"Outline four (4) secondary causes the condition ( 2 Mark) i. Hepatitis B and C ii. Rheumatism iii. Syphilis iv. HIV v. Malaria vi. Diabetes mellitus vii. Systemic lupus erythematosus viii. Amyloidosis ix. Multiple myeloma 19 1."}],"priority":1,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"bbf1bbcf256b76b17a940d216e096e176be1fa7b"},{"id":"q-b3934106ab01","stem":"List down five (5) Risk factors for developing Type II Diabetes Mellitus: (5 Mark) Answers: • Family history of diabetes • Obesity (BMI > 27kg/m2) • Age >45 years • Hypertension • History of gestational diabetes mellitus • High cholesterol level","type":"OSCE / Practical Station","subject":"Internal Medicine","topic":"Cardiology","topicOriginal":"Cardiology","subtopic":"Hypertension","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Cardiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d2562b141464","stem":"A22 years old Musician attended the health centre with complaints of fever and skin lesions on the Perineum. On examination, small tender vesicles were found on the genitalia and bilateral enlarged Inguinal Lymphnodes. What is the most likely diagnosis?","type":"Clinical Vignette","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-53a12a81878c","stem":"A 40 years old man always has alcohol and frequent falls, he moved into the suburb few months ago and is well known for habitual drinking mostly drinking spirit, he presents to you with tremors, sweating profusely and vomiting. What is the possible diagnosis: What is the possible diagnosis (1 Mark) Answers: • Alcohol withdrawal syndrome List dawn 2 Differential diagnosis (2 Marks) Answers: • Alcohol Abuse • Alcohol Dependence How are you going to treat the patient?","type":"Clinical Vignette","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f319e146ca0a","stem":"A patient present to the health centre with history of fever with severe headache associated with neck pain and stiffness. On examination kerning sign was positive.","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"What is the working diagnosis of this patient (1Mark) Meningitis"},{"label":"B","text":"List down four (4) pre-disposing factors of the above condition (4 Marks) Predisposing factors of meningitis • Ear infections (Otitis media, mastoiditis) • Sinusitis • Respiratory infections • Malnutrition • Head injuries • Septicaemia and Diarrhea especially in the new-borns • Immune suppression e.g. HIV 22 SECTION E: GUIDED ESSAY QUESTIONS 30 MARKS INSTRUCTIONS • This section consists of two (2) questions which are supposed to be answered in a narrative way • Write your answer on a separate sheet of paper provided; each question should start on a new page. • Write your examination number on each answer sheet you are using. • Write a readable handwrite; DIRTY WORK IS NOT ALLOWED"}],"priority":1,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["long_option_manual_review","mcq_missing_options","not_enough_options","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"ff401543f17f66de3a115f905240f87b4b79394c"},{"id":"q-e4d66dfa6ceb","stem":"What is the WHO clinical stage of the patient (1 Mark)","type":"Clinical Vignette","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2deef08192ec","stem":"Outline for (4) Possible causes of the above condition: (4 Mark)","type":"Short Answer","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7ab54ecf5f44","stem":"Describe the cause and the management of this patient.","type":"Clinical Vignette","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3e54c640d574","stem":"When stable, usually after 24hour (3 Marks)","type":"Short Answer","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b39ba9d99e0b","stem":"Jaundice : a may be caused by fasting a patient who has Gilbert’s syndrome b is probably cholestatic if there is increased unconjugated bilirubin , ALP is normal and AST and ALT are increased b is probably haemolytic if there is increased conjugated bilirubin and increased ALP with normal transaminases d may be caused by cirrhosis if the serum albumin is increased and the serum globulins are decreased 20 Portal hypertension: a is most commonly caused by shistosomiasis in Tanzania and the site of blockage is post-sinusoidal . b can be reduced by daily consumption of propranolol in a dosage range 80- 160mg/day, so that the pulse is reduced to less than 60/min c is always caused by hepatic disease d may be reduced to normal using a technique of TIPSS ( transjugular intrahepatic portasystemic stent shunting) and this is a simple and cheap procedure, free of complications and never followed by hepatic encephalopathy 21 Concerning therapy for pituitary syndromes and tumours: a craniopharyngiomas are benign tumours which develop from Rathke’s pouch, are more common in young people than pituitary adenomas, are difficult to remove 5 surgically as they are usually large and radiotherapy should be considered, although its efficacy is not certain b macroademomas with prolactin levels exceeding 4,000 may respond to a therapeutic trial of bromocriptine making surgery unnecessary c most operations on the pituitary are performed by the trans-sphenoidal approach, as the tumours are not too large and can be removed by this route d all are correct 22 Plasma prolactin may be elevated in all of the following except: a consumption of anti-psychotic drugs such as phenothiazines b pregnancy c menopause d prolactinoma 23 Acromegaly a is the result of growth hormone acting directly on the tissues of the body stimulating growth genes in these cells b develops only in children c may be associated with skin thickening, sweating, arthropathy and carpal tunnel syndrome d pituitary surgery alone will cure the condition in all cases 24 In hypopituitarism: a puberty occurs normally b loss of libido and impotence may occur in male adults c the two most important hormones needed for therapy are ACTH and FSH d the cause is always a pituitary tumour 25 Hyperthyroidism may cause any of the following, EXCEPTt: a sweaty skin b eye lid retraction c constipation d amenorrhoea 26 Grave’s disease: a is the result of IgG antibodies directed against TSH receptors on the thyroid follicular cell, stimulating thyroid hormone production b is an auto-immune disease but it is not possible to detect the thyroid auto- antibodies in the serum in most cases c is best treated with sub-total thyroidectomy, especially if under 40 years of age d treated with anti-thyroid drugs will relapse in less than 10% of patients within two years of stopping the drug 6 27 Hypothyroidism may cause any of the following, except: a weight gain b cold intolerance c tachycardia d menorrhagia 28 Hypothyroidism: a is called primary when the TSH is low b is only caused by iodine deficiency c is never associated with a goitre d is best treated by starting with a low dose of thyroxine, given once daily as the half-life is 7 days 29 Malignant tumours of the thyroid; a are most frequently anaplastic and respond well to treatment with radiotherapy b have an excellent prognosis, if either follicular or papillary in type, and are treated with total thyroidectomy and large dose radio-iodine therapy and long term thyroxine consumption c include lymphoma of the thyroid which is incurable d are most common in males 30 Parathyroid disease: a is called primary hyperparathyroidism when the serum calcium is high and there is chronic renal failure b may cause symptoms of polyuria , polydipsia and renal colic as a result of a low serum calcium c may produce characteristic radiological signs in the hands with sub-periosteal erosions of the shaft of the middle phalanx and resorption of the terminal portion of the distal phalanx d is best treated with tablets of parathyroid hormone if there is hypoparathyroidism 31 Cushing’s syndrome: a is most often caused by doctors b is called Cushing’s disease whether or not there is a pituitary tumour c Cushing’s disease and adrenal tumours are four times more common in men than women d if caused by a pituitary tumour, is usually a macroadenoma, greater than 10mm in diameter, and so visual impairment is common 7 32 Diabetes mellitus: a is called type I (IDDM) in older obese subjects where there is insulin resistance b may be complicated by necrobiosis lipoidica diabeticorum which is a form of renal disease c is increasingly prevalent in Africa d is not influenced by genetic or environmental factors 33 In diabetic ketoacidosis, careful clinical examination may detect some abnormalities so that: the following linkages are true, EXCEPTt: a acidosis, clinically detected by an increased respiratory rate b ketosis, clinically detected by acetone on the breath c dehydration, clinically detected by the presence of oedema d glycosuria, clinically detected by polyuria c 34 Concerning management of diabetes: a only 20% of newly diagnosed diabetics can be managed by diet alone b weight reduction in obese patients is essential to reduce insulin resistance, hyperglycaemia and dyslipidaemia c sulphonylureas are helpful in enhancing insulin production in type I diabetics d biguanides such as metformin cause hypoglycaemia in non-diabetic patients 35 Insulin: a is a refined complex mucopolycaccharide b as isophane insulin has an onset of action within an hour and lasts only 4 hours c for treatment needs to be individualised but most patients need two or more injections daily for good control d has no side effects 36 The following are correct definitions , except: a target cells-red cells with a central mass of haemoglobin, surrounded by a ring of pallor and an outer ring of haemoglobin b polychromasia-the presence of haemosiderin particles in the red cell c Howell-jolly bodies- remnants of nuclear material in the red cell d macrocytosis -increased red cell size, exceeding 105 cubic microns(fl) 37 Concerning anaemia: a microcytosis with MCV<90 suggests vitamin B 12 deficiency b a low haemoglobin with a normal MCV suggests either acute blood loss or anaemia of chronic disease c pernicious anaemia is usually the result of poor nutrition d the presence of jaundice with anaemia suggests aplastic anaemia 8 38 The following is true of haemolytic anaemias, except: a it could be the result of a defect in red cell membrane formation b it may cause urobilinogen in the urine c the bone marrow is hypoplastic d Alpha thalassaemia is common in South-East Asia and is called Haemoglobin H if three alpha genes are deleted on chromosome 16 causing a tetramer of beta chains 39 Concerning sickle cell anaemia: a the patient is permanently protected from falciparum malaria b it is the de-oxygenation of haemoglobin that causes the sickle cell shape and this is reversible c folic acid is prescribed because of a defect in absorption of folic acid d a sickle cell crisis is best managed with fluid restriction and analgesics 40 The following is true of leukaemia:: a chronic myeloid leukaemia is diagnosed when there is a high lymphocyte count in the peripheral blood b acute lymphoblastic leukaemia may be cured with intensive treatment, including bone marrow transplantation c Philadelphia chromosome is present in 90% of patients with chronic lymphatic leukaemia d chlorambucil 5mg orally daily is the best treatment for chronic myeloid leukaemia 41 Lymphomas: a if stage IA Hodgkins disease, are cured by radiotherapy alone in over 90% of cases b if non-Hodgkins lymphoma, are usually T cell lymphomas in 70% of cases c if widely disseminated at the time of presentation are suggestive of Hodgkin’s disease rather than non-Hodgkins (NHL) disease d if non-Hodgkins(NHL), and of a low grade histology, have a poor prognosis with death within a year 42 Multiple myeloma: a may be diagnosed by the presence of a monoclonal immunoglobulin in the serum, and the type of paraprotein is most commonly IgG in more than 50% of cases, then IgA in about 20% of cases and light chains only in about 20% b presents most commonly as renal failure c hypocalcaemia and an elevated alkaline phosphatase are common features d is unresponsive to chemotherapy 9 43 The following is true of myeloproliferative disorders, EXCEPTt: a myelofibrosis has massive splenomegaly and patients may suffer from splenic infarcts b primary proliferative polycythaemia is often well treated by simple venesection c essential thrombocythaemia always requires treatment with aspirin regardless of other therapies d it is best to perform splenectomy early in cases of essential thrombocytopenia 44 Idiopathic thrombocytopenic purpura: a in adults is usually a chronic illness, with relapses and remissions, with a significant number of patients requiring splenectomy, which is then curative in 70% of cases b causes persistent oozing rather than purpura and bruising c always requires treatment with steroids if the platelet count is below 100x 109/l d is associated with splenomegaly 45 Thrombosis occurring spontaneously in an individual under 40 years of age; a requires a bone marrow to look for thrombocytopenia b could be the result of Factor V Leiden mutation present in 3-5%of healthy individuals living in Europe and North America c is caused usually by an excess of anti-thrombin d is common and sporadic, not requiring further investigations or intervention 46 Acute renal failure","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"is almost always associated with oliguria with a urine output less than 400 ml/day"},{"label":"B","text":"occurs commonly in hospital medicine, and the commonest cause is parenchymal disease, usually toxic in nature c always requires dialysis if the creatinine exceeds 200micromol/l"},{"label":"D","text":"requires urgent measurement of the serum potassium."}],"priority":1,"status":"quarantine","flags":["probable_document_or_multiple_questions"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"quarantine","auditFlags":["long_stem_manual_review","prior_structural_review_flag","probable_document_or_multiple_questions"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-516131d76c01","stem":"In acute tubular necrosis","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the specific gravity is usually > 1020 b the urine sodium is above 20mmol/l c the urine osmolarity is above 500mmol/l"},{"label":"D","text":"the concentration of urea measured in the urine and the plasma expressed as a ratio of urine/plasma is 20 or more 10 48 Chronic renal failure: a is usually associated with hyperphosphatemia,which leads to hypocalcaemia, hyperparathyroidism and renal osteodystrophy"},{"label":"B","text":"is inevitably, rapidly and irreversibly progressive once the GFR is less than 40ml/min because of protein toxicity and free radical oxidant damage"},{"label":"C","text":"is associated with a positive nitrogen balance, increased erythropoietin levels and increased hydroxylation of 21 hydroxy cholecalciferol to 1,25 hydroxy cholecalciferol"},{"label":"D","text":"is always associated with hyperkalaemia 49 In chronic renal failure:"},{"label":"A","text":"the renal size is always small b there is usually hypotension c uraemic symptoms relate to uraemic toxins d there is a macrocytic anaemia"}],"priority":1,"status":"review","flags":["duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"48ccab1e59af75c7a80550275527193eec602363"},{"id":"q-478bfbaaf78d","stem":"The abnormalities seen in different types of renal disease reflect altered physiology and include","type":"Single Best Answer MCQ","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"azotaemia (high urea and creatinine) caused by excessive secretion of these compounds in the urine b hypertension caused by low renin and aldosterone secretion c hypocalcalcaemia, partly because of reduced hydroxylation of vitamin D"},{"label":"D","text":": systemic alkalosis from impaired ammonia secretion 52 The nephrotic syndrome comprises:"},{"label":"A","text":"haematuria, hypertension and oedema b oedema, proteinuria exceeding 3g/24hours, hypercholesterolemia,. hypoalbuminemia c oedema, azotaemia, hypercholesterolemia, proteinuria d facial oedema, hypertension, ++ proteinuria 53 Immune damage of the glomerulus: a may be the result of linear anti-GBM antibody, characteristic of lupus nephritis"},{"label":"B","text":"may be seen in SBE , malaria and hepatitis c when associated with proliferative changes in the Bowmans capsule so the crescents are seen , has a good prognosis 11 d typical of post-streptococcal glomerulonephritis is seen as focal necrotizing nephritis on biopsy. 54 The following is true for urosepsis, EXCEPT: a it is called a urinary tract infection if there is more than 100,000 organisms per ml in a mid-stream specimen of urine b it may present as septicaemia without urinary symptoms, especially in the elderly c tuberculous of the kidney is a primary renal infection , the bacteria entering the kidney from the urinary tract d severe cases of acute pyelonephritis require a renal ultrasound for assessment and intravenous antibiotics"}],"priority":1,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","long_option_manual_review","nonunique_option_labels","prior_structural_review_flag","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-c7a83fa780de","stem":"A 25 years old man presents with sudden onset of chest pain on the right side and dyspnoea. O/E –Trachea is deviated to the left. The following signs would be anticipated illness? What investigations would you order to confirm your provisional diagnosis? would you order? is your diagnosis?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Absence of rales"},{"label":"B","text":"Absence of rhochi"},{"label":"C","text":"Hyperesonance over the right chest"},{"label":"D","text":"Distant breath sounds 75 In jaundice with a direct bilirubin exceeding 40mmol/l a dilated bile ducts on an ultra-sound indicate hepato-cellular disease b the diagnosis will be diffuse amoebiasis of the liver if there is associated diarrhoea c the faeces will usually be pale and the urine dark if there is obstructive jaundice d haemolytic anaemia should be considered, especially if there is splenomegaly 15 d generally should be treated with anti-thyroid drugs first for a period of 12 to . months, and surgery if there is a relapse Section B Short Answer Questions (75marks) There are two different types of questions I and II I there are 3 clinical case scenarios II there are twoexercises requiring matching, or True and False answers A Clinical Cases. Write your answers in the exam booklet Case 1 A 70 year old man comes to you because he simply has not passed any urine for 2 days. He claims to be well ."},{"label":"A","text":"Explain three different mechanisms for this finding A digital rectal examination reveals an enlarged prostate, which has smooth normal lobes and a well defined median groove. . A catheter is inserted and 1 lite of smelly urine is passed . He receives gentamicin 80mg IV bd for the next week. Initially the urine output is 1 litre, but after 5 days the urine output reduces and becomes less than 100 ml each day via the catheter. Throughout this time he has been eating and drinking more than a litre of fluid each day"},{"label":"B","text":"What do you think has happened ?What are possible causes? Further information from the family, and from the patient indicate that in fact this man has not been well for more than a year. He has had lethargy, with anorexia, occasional vomiting, oedema of the legs and some difficulty in breathing for the past two months. He is pale, his BP is 180/120 ,he has generalised oedema and basal crepitations ."},{"label":"C","text":"What diagnosis is now suggested? What are the possible causes for this chronic Indicate your expected findings from these tests. It is considered that there are acute reversible factors as well as chronic factors in this case, so it is decided that he should receive dialysis ,especially as the serum potassium is 7mmol/l. d Describe the basic principles of peritoneal dialysis and how this differs from haemodialysis. Explain how the serum potassium may be reduced by dialysis 16 Case 2 A 40 year old woman has noticed a swelling in her neck for more than 10 years. It is not associated with any change in her voice or in swallowing. A sister suggests she sees a doctor , who diagnoses an “active goitre”"},{"label":"A","text":"List the main symptoms and signs of thyrotoxicosis It is decided that a thyroidectomy should be performed"},{"label":"B","text":"What medical preparation is required before surgery ? What investigations Surgery is performed uneventfully and she is discharged . One week after the operation she begins to feel weak and sleepy, with a poor appetite. She has an epileptic seizure and returns to hospital She notices twitches.in her muscles, and occasionally there is a spasm affecting her hands c What possible complication may have occurred? How can this be confirmed?What The Chvostek teat and Trousseau tests is positive ."},{"label":"D","text":"How do you perform these tests? e What should be the further management of this lady? Indicate how therapy may help."},{"label":"F","text":"What is her prognosis without treatment? Case 3 A 15 year old girl presents with an episode of acute haematemesis"},{"label":"A","text":"What are the main principles of acute management in this girl? 17 Her condition stabilises and there is a need for diagnosis of this condition"},{"label":"B","text":"List the major cause of haematemesis c List the investigations that may determine the exact cause in this girl Unfortunately this patient discharges herself the next day and fails to attend any medical clinic for further attention Three years later she notices swelling of her abdomen, and when this is gross she again returns to your care"},{"label":"D","text":"List causes of a diffusely distended abdomen Liver function tests do not show any elevation of bilirubin or elevation of AST, ALT or SAP, but the serum albumin is low at 25g/l e Explain what is happening in this girl and what is the most likely cause 4 Match the items in the left hand column with those in the right hand column (1.5mark for a correct response) Record your results in the examination booklet Write the numerical numbers of the left hand column, and your answer as an alphabetical letter from the right hand column 1 folate deficiency a splenectomy 2 lymphoblasts in peripheral blood b ITP 3 Howell-Jolly bodies c ALL 4 CD4 d megaloblastosis 5 target cells e microcytosis 6 nucleated red cell f haemoglobinopathies 7 thrombocytopenia g MCV 115 8 macrocytosis h disordered haemoglobin synthesis 18 9 low serum iron i. vigorous erythropoiesis 10 hypochromia j lymphocyte"}],"priority":1,"status":"review","flags":["topic_generic","too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","long_option_manual_review","nonunique_option_labels","prior_structural_review_flag","too_many_options","too_many_options_possible_merge","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-7055219cdfd3","stem":"when it is called MALToma","type":"Short Answer","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-cbd7a4a57535","stem":"b. What do you think has happened ?What are possible causes?","type":"Short Answer","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8a9eecb33ffb","stem":"c. What diagnosis is now suggested?","type":"Short Answer","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f3a86a7cf23b","stem":"illness? What investigations would you order to confirm your provisional diagnosis?","type":"Short Answer","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-cbb08368ecd8","stem":"b. What medical preparation is required before surgery ?","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e351e7628e26","stem":"would you order?","type":"Short Answer","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c032ab5d20ee","stem":"c What possible complication may have occurred? How can this be confirmed?What","type":"Short Answer","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-cd59e1cba628","stem":"is your diagnosis?","type":"Short Answer","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-716e2c1f718d","stem":"d. How do you perform these tests?","type":"Short Answer","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3deb7b363475","stem":"e What should be the further management of this lady?","type":"Short Answer","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6a23497a1ee5","stem":"f. What is her prognosis without treatment?","type":"Short Answer","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-31f8b23d3227","stem":"a. What are the main principles of acute management in this girl?","type":"Short Answer","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-59d8a2f80611","stem":"1 A 36-year-old woman has severe burning chest pain that radiates to her neck. The pain occurs particularly after meals, especially when she lies down, and is not precipitated by exertion. She is admitted for observation. Serial ECG and troponin I levels are normal. Which of the following is the best next step?","type":"ECG Interpretation","subject":"General Surgery","topic":"Trauma and Emergency Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Trauma and Emergency Surgery","options":[{"label":"A","text":"Stress thallium treadmill test"},{"label":"B","text":"Initiation of a proton pump inhibitor"},{"label":"C","text":"Coronary angiography"},{"label":"D","text":"Initiation of an antidepressant such as a selective serotonin reuptake inhibitor"},{"label":"E","text":"Referral to a psychiatrist"}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"General Surgery","displayTopic":"Trauma and Emergency Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-0d905f0458ca","stem":"2 A 56-year-old man is admitted to the hospital for chest pain of 2-hour duration. H is heart rate is 42 bpm, with sinus bradycardia on ECG, as well as STsegment elevation in leads II, III, and aVF. Which of the following is the most likely diagnosis?","type":"ECG Interpretation","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"He is likely in good physical condition with increased vagal tone."},{"label":"B","text":"He likely has suffered an inferior wall MI."},{"label":"C","text":"He likely has an LV aneurysm."},{"label":"D","text":"The low heart rate is a reflection of a good cardiac ejection fraction."}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","repeated_question_stem","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"16c92e98b94327c88ffdcdeb0c5c6f15f7993ed9"},{"id":"q-48cbce39d562","stem":"3 A 59-year-old diabetic woman had suffered an acute anterior wall MI. Five days later, she gets into an argument with her husband and complains of chest pain. H er initial ECG shows no ischemic changes, but serum cardiac troponin I levels are drawn and return mildly elevated at this time. Which of the following is the best next step?","type":"ECG Interpretation","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Use thrombolytic therapy."},{"label":"B","text":"Treat with percutaneous coronary intervention."},{"label":"C","text":"Perform coronary artery bypass."},{"label":"D","text":"Perform serial ECGs and obtain CK-MB."},{"label":"E","text":"Prepare the patient for dialysis."}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-cbb97a23ddfd","stem":"4 A 59-year-old male smoker complains of severe substernal squeezing chest pain of 30-minute duration. The paramedics have given sublingual nitroglycerin and oxygen by nasal cannula. His blood pressure is 110/ 70 mm H g and heart rate is 90 bpm on arrival to the ER. The ECG is normal. Which of the following is the best next step?","type":"ECG Interpretation","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Echocardiography"},{"label":"B","text":"Thallium stress test"},{"label":"C","text":"Aspirin"},{"label":"D","text":"Coronary angiography"},{"label":"E","text":"Coronary artery bypass"}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","repeated_question_stem","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"820279ba77466d7501b8a1c949ad9107b203a21f"},{"id":"q-100a8dc443d4","stem":"1 A 55-year-old man is noted to have moderately severe congestive heart failure with impaired systolic function. Which of the following drugs would most likely lower his risk of mortality?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Angiotensin-converting enzyme inhibitors"},{"label":"B","text":"Loop diuretics"},{"label":"C","text":"Digoxin"},{"label":"D","text":"Aspirin"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-62109efb60ef","stem":"2 In the United States, which of the following is most likely to have caused the congestive heart failure in the patient described in Question 4.1?","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Cardiology","topicOriginal":"Cardiology","subtopic":"Heart","suggestedTopic":null,"options":[{"label":"A","text":"Diabetes"},{"label":"B","text":"Atherosclerosis"},{"label":"C","text":"Alcohol"},{"label":"D","text":"Rheumatic heart disease"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Cardiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-cdb3bdbea808","stem":"3 A 75-year-old man is noted to have chest pain with exertion and has been passing out recently. On examination he is noted to have a harsh systolic murmur. Which of the following is the best therapy for his condition?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Coronary artery bypass"},{"label":"B","text":"Angioplasty"},{"label":"C","text":"Valve replacement"},{"label":"D","text":"Carotid endarterectomy"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"13ff56e24e32c4a3a4ec5c8bf8b981ba38b7df42"},{"id":"q-8a5ac1add786","stem":"4 A 55-year-old man is noted to have congestive heart failure and states that he is comfortable at rest but becomes dyspneic even with walking to the bathroom. On echocardiography, he is noted to have an ejection fraction of 47%. Which of the following is the more accurate description of this patient’s condition?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Diastolic dysfunction"},{"label":"B","text":"Systolic dysfunction"},{"label":"C","text":"Dilated cardiomyopathy"},{"label":"D","text":"Pericardial disease"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f5a9c2c0d7c3","stem":"1 A 59-year-old man complains of severe chest pain that radiates to his back. His brachial pulses appear unequal between his right and left arms. He appears hemodynamically stable. On chest radiography, he has a widened mediastinum. Which of the following is the best next step?","type":"Radiological Interpretation","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Initiate thrombolytic therapy."},{"label":"B","text":"Obtain CT of chest with intravenous contrast."},{"label":"C","text":"Initiate aspirin and heparin."},{"label":"D","text":"Measure serial cardiac enzyme levels."}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","repeated_question_stem","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"b067183511860a6f43799610a2a22b55a3ed053c"},{"id":"q-817f6990f310","stem":"2 A 45-year-old woman with new-onset aortic regurgitation is found to have aortic dissection of the ascending aorta and aortic arch by echocardiography. She is relatively asymptomatic. Which of the following is the best management?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Oral atenolol therapy and monitor the dissection"},{"label":"B","text":"Angioplasty"},{"label":"C","text":"Surgical repair of the dissection"},{"label":"D","text":"Oral warfarin (Coumadin) therapy"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1628d7d4cb6f","stem":"3 A healthy 75-year-old man undergoing an ultrasound examination for suspected gallbladder disease is found incidentally to have a 4.5-cm abdominal aneurysm of the aorta. Which of the following is the best management for this patient?","type":"Radiological Interpretation","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Surgical repair of the aneurysm"},{"label":"B","text":"Serial ultrasound examinations every 6 months"},{"label":"C","text":"Urgent MRI"},{"label":"D","text":"Beta-agonist therapy"}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-eb2cac8e9cf9","stem":"4 A 45-year-old man is concerned because his father died of a ruptured abdominal aortic aneurysm. On evaluation, he is found to have a bicuspid aortic valve. Which of the following is the most accurate statement regarding his condition?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"He is at risk for an aortic aneurysm of the ascending aorta."},{"label":"B","text":"He is at risk for an abdominal aortic aneurysm."},{"label":"C","text":"He is not at increased risk for aortic aneurysms."},{"label":"D","text":"He should have surgical correction of the aortic valve."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-f2674e23c5a1","stem":"1 A 30-year-old woman is noted to have blood pressures in the 160/ 100 mm H g range. She also has increased obesity, especially around her abdomen, which also shows some striae. She has been bruising very easily and has increased hair growth on her face and chest. Which of the following is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Hyperthyroidism"},{"label":"B","text":"Coarctation of the aorta"},{"label":"C","text":"Cushing syndrome"},{"label":"D","text":"Pheochromocytoma"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5bff9c145c70","stem":"2 A 45-year-old man is diagnosed with essential hypertension based on two blood pressures of 150/ 100 and 156/ 102 mm H g during two separate visits. Which of the following would most likely provide prognostic information regarding this patient?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Vascular biopsy"},{"label":"B","text":"End-organ effects from hypertension"},{"label":"C","text":"Patient’s enrolment in a clinical trial"},{"label":"D","text":"Measurement of serum homocysteine levels"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"a7caf938ff1d8b3019f7ae1ac1e785e83d728449"},{"id":"q-2ceaa1b03676","stem":"3 A 34-year-old woman contemplating pregnancy is diagnosed with stage I hypertension, and after an evaluation is noted to have no complications. Which of the following antihypertensive classes may be appropriate for this individual?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Labetolol"},{"label":"B","text":"Angiotensin-receptor blockers"},{"label":"C","text":"Direct rennin inhibitors"},{"label":"D","text":"Angiotensin-receptor blockers"},{"label":"E","text":"Hydrochlorothiazine"}],"priority":1,"status":"review","flags":["topic_generic","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_text","nonunique_option_text","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-6d4d33bea043","stem":"4 A 45-year-old man with type 2 diabetes is noted to have blood pressures of 145/ 90 and 150/ 96 mm H g on two separate occasions. Which of the following is the best initial therapy for this patient?","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"Diabet","suggestedTopic":null,"options":[{"label":"A","text":"Hydrochlorothiazide"},{"label":"B","text":"ACE inhibitor"},{"label":"C","text":"Beta-blocker"},{"label":"D","text":"Clonidine"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Endocrinology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"6e350012b1072ab11d4858ad48df2d1e695f2159"},{"id":"q-e625aa313a75","stem":"1 A 50-year-old man with chronic hypertension presents at the clinic having run out of his medications, lisinopril and amlodipine, for more than a month. He is asymptomatic and has a blood pressure of 200/ 104 mm Hg. Which of the following is the best management?","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Cardiology","topicOriginal":"Cardiology","subtopic":"Hypertension","suggestedTopic":null,"options":[{"label":"A","text":"Admit in the hospital and initiate intravenous nitroprusside."},{"label":"B","text":"Prescribe clonidine 0.1 mg TID and recheck the blood pressure in 24 to 48 hours."},{"label":"C","text":"Restart his angiotensin-converting enzyme (ACE) inhibitor and calcium channel blocker and recheck blood pressure in 24 to 48 hours."},{"label":"D","text":"Refer to a social worker and do not prescribe any antihypertensive agent."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Cardiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ca1fa609548c","stem":"2 An 80-year-old woman without a history of hypertension undergoes surgery for a hip fracture. Her blood pressure on postoperative day 1 is 178/ 110 mm Hg. She is asymptomatic except for hip pain. Which of the following is the best next step?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Trauma and Emergency Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Trauma and Emergency Surgery","options":[{"label":"A","text":"Transfer the patient to the intensive care unit, obtain cardiac enzyme levels, and lower the blood pressures to the 140/ 90 mm H g range."},{"label":"B","text":"Control the pain and monitor the blood pressure."},{"label":"C","text":"Start the patient on a beta-blocker and monitor the blood pressure."},{"label":"D","text":"Restrict visitors and turn down television, alarms, and other noise."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Trauma and Emergency Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"959c380981d43d664cb149a32162884005f35bd2"},{"id":"q-3bb8983e177e","stem":"3 A 61-year-old man with coronary artery disease complains of progressive orthopnea and pedal edema. He is hospitalized with a blood pressure of 190/ 105 mm Hg. Cardiac enzyme levels and the electrocardiography (ECG) are normal. Intravenous furosemide has been administered. Which of the following is the best next step?","type":"ECG Interpretation","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"Prescribe a beta-blocker to decrease myocardial oxygen demands."},{"label":"B","text":"Start intravenous dopamine."},{"label":"C","text":"Observe his clinical status."},{"label":"D","text":"Start an ACE inhibitor"}],"priority":1,"status":"review","flags":["requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-45b9d08d704f","stem":"4 A 58-year-old woman with aphasia and right arm weakness of 8 hours’ duration is seen in the ER. CT scan shows no intracranial haemorrhage. H er blood pressure is 162/ 98 mm H g. Which of the following is the best next step?","type":"Radiological Interpretation","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Normalize the blood pressure with beta-blockade."},{"label":"B","text":"Admit to ICU with sodium nitroprusside."},{"label":"C","text":"Normalize the blood pressure with an ACE inhibitor."},{"label":"D","text":"Observe the blood pressure."}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","repeated_question_stem","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"b3835e7a8e85608e6037834656b7e16c6cf7261b"},{"id":"q-6cb153721ee1","stem":"1 A 28-year-old woman has been told she has rheumatic heart disease, specifically mitral stenosis. Which of the following murmurs is most likely present?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Diastolic rumble at apex of the heart"},{"label":"B","text":"Early diastolic decrescendo at right upper sternal border"},{"label":"C","text":"Holosystolic murmur at apex"},{"label":"D","text":"Late-peaking systolic murmur at right upper sternal border"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f15d64113574","stem":"2 A 48-year-old woman is noted to have atrial fibrillation with a ventricular heart rate of 140 bpm. She is feeling dizzy and dyspneic with a systolic blood pressure of 75/ 48 mm H g. Which of the following is the most appropriate next step?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Intravenous digoxin"},{"label":"B","text":"DC cardioversion"},{"label":"C","text":"Vagal maneuvers"},{"label":"D","text":"Intravenous diltiazem (Cardizem)"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"c4c3ca0e3617e961e74c5cd0953f924e7b72c464"},{"id":"q-be6f3226af09","stem":"3 A third-year medical student has been reading about the dangers of excessive anticoagulation and bleeding potential. He reviews the charts of several patients with atrial fibrillation currently taking Coumadin. Which of the following patients is best suited to have anticoagulation discontinued?","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A 45-year-old man who has normal echocardiographic findings and no history of heart disease or hypertension, but a family history of hyperlipidemia"},{"label":"B","text":"A 62-year-old man with mild chronic hypertension and dilated left atrium, but normal ejection fraction"},{"label":"C","text":"A 75-year-old woman who is in good health except for a prior stroke, from which she has recovered nearly all function"},{"label":"D","text":"A 52-year-old man with orthopnea and paroxysmal nocturnal dyspnea"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-841136a11c1c","stem":"4 A 59-year-old woman has been placed on warfarin (Coumadin) after being found to have had chronic atrial fibrillation. She is noted to have an INR of 5.8, is asymptomatic, and has no overt bleeding. Which of the following is the best management for this patient?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Transfuse with erythrocytes."},{"label":"B","text":"Give vitamin K."},{"label":"C","text":"Give fresh frozen plasma."},{"label":"D","text":"Hold warfarin."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"6c7f026653a8fcaba2081f381cee208eae5abf7f"},{"id":"q-e8dd253aed55","stem":"5 A 45-year-old woman is noted to have dizziness, pounding of the chest, and fatigue of 3 hours’ duration. On examination, she is noted to have a blood pressure (BP) of 110/ 70 mm H g and heart rate of 180 bpm. She is noted on ECG to have atrial fibrillation, and a prior baseline ECG showed delta waves. The ED physician counsels the patient regarding cardioversion, but the patient declines. Which of the following is the best therapy for her condition?","type":"ECG Interpretation","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Digoxin"},{"label":"B","text":"Angiotensin-converting enzyme (ACE) inhibitor"},{"label":"C","text":"Calcium channel blocker"},{"label":"D","text":"Procainamide"}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-acb9fddc342a","stem":"1 An 18-year-old woman is brought to the emergency centre because she fainted at a rock concert. She apparently recovered spontaneously, did not exhibit any seizure activity, and has no medical history. Her heart rate is 90 bpm and blood pressure 110/ 70 mm H g. The neurologic examination is normal. The pregnancy test is negative, and an ECG shows normal sinus rhythm. Which of the following is the most appropriate management?","type":"ECG Interpretation","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Admit to hospital for cardiac evaluation."},{"label":"B","text":"Obtain an outpatient echocardiogram."},{"label":"C","text":"Use 24-hour Holter monitor."},{"label":"D","text":"Reassure the patient and discharge home."}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","repeated_question_stem","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"26272d1d5209c8be36983cc54d993ea7589a2326"},{"id":"q-65d7d6b87533","stem":"2 A 67-year-old woman has diabetes and mild hypertension. She is noted to have some diabetic retinopathy, and she states that she cannot feel her legs. She has recurrent episodes of light-headedness when she gets up in the morning. She comes in now because she had fainted this morning. Which of the following is the most likely cause of her syncope?","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Cardiology","topicOriginal":"Cardiology","subtopic":"Hypertension","suggestedTopic":null,"options":[{"label":"A","text":"Carotid sinus hypersensitivity"},{"label":"B","text":"Pulmonary embolism"},{"label":"C","text":"Autonomic neuropathy"},{"label":"D","text":"Critical aortic stenosis"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Cardiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-2987e6ed5472","stem":"3 A 74-year-old man with no prior medical problems faints while shaving. He has a quick recovery and has no neurologic deficits. His blood sugar level is normal, and an ECG shows a normal sinus rhythm. Which of the following is the most useful diagnostic test of his probable condition?","type":"ECG Interpretation","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Carotid massage"},{"label":"B","text":"Echocardiogram"},{"label":"C","text":"Computed tomographic (CT) scan of head"},{"label":"D","text":"Serial cardiac enzymes"}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","repeated_question_stem","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"c971ab2c4d311b9db6074b479191ae934c7ed8cf"},{"id":"q-541c3c6caa01","stem":"4 A 49-year-old man is admitted to the intensive care unit (ICU) with a diagnosis of an inferior myocardial infarction. His heart rate is 35 bpm and blood pressure 90/ 50 mm H g. His ECG shows a Mobitz type I heart block. Which of the following is the best next step?","type":"ECG Interpretation","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Atropine"},{"label":"B","text":"Transvenous pacer"},{"label":"C","text":"Lidocaine"},{"label":"D","text":"Observation"}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-ead9375fe095","stem":"1 A 68-year-old man with a history of end-stage renal disease is admitted to the hospital for chest pain. On examination, a pericardial friction rub is noted. His ECG shows diffuse ST-segment elevation. Which of the following is the best definitive treatment?","type":"ECG Interpretation","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"NSAIDs"},{"label":"B","text":"Dialysis"},{"label":"C","text":"Steroids"},{"label":"D","text":"Kayexalate (sodium polystyrene sulfonate)"}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","repeated_question_stem","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"4644371bffec2224ba547027530e3becb7573d12"},{"id":"q-316b5da554b2","stem":"2 The patient described in Question 10.1 is hospitalized, but there is a delay in initiating treatment. You are called to the bedside because he has become hypotensive with systolic blood pressure of 85/ 68 mm Hg, a heart rate of 122 bpm, and pulsus paradoxus. A repeat ECG is unchanged from admission. Which of the following is the most appropriate immediate intervention?","type":"ECG Interpretation","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Draw blood cultures and initiate broad-spectrum antibiotics for suspected sepsis."},{"label":"B","text":"Intravenous furosemide for fluid overload."},{"label":"C","text":"Echocardiographic-guided pericardiocentesis."},{"label":"D","text":"Percutaneous coronary intervention for acute myocardial infarction."}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-c06d20d99a3c","stem":"3 A 25-year-old woman complains of pain in her PIP and metacarpophalangeal (MCP) joints and reports a recent positive antinuclear antibody (ANA) laboratory test. Which of the following clinical features would not be consistent with a diagnosis of SLE?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Pleural effusion"},{"label":"B","text":"Malar rash"},{"label":"C","text":"Sclerodactyly"},{"label":"D","text":"Urinary sediment with RBC casts"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"1ae487f64bdf8d1e9038fc1d86c2ac92f2e78a5d"},{"id":"q-8b32e6d30899","stem":"1 A 35-year-old woman is noted to have a positive Kussmaul sign. Which of the following conditions does she most likely have?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Constrictive pericarditis"},{"label":"B","text":"Cardiac tamponade"},{"label":"C","text":"Dilated cardiomyopathy"},{"label":"D","text":"Diabetic ketoacidosis1–1 • FEATURES OF CARDIAC TAMPONADE, ACUTE PERICARDITIS,"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-eb4fecfb05c4","stem":"2 Which of the following is the most sensitive finding in patients with cardiac tamponade?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Disappearance of radial pulse during inspiration"},{"label":"B","text":"Drop in systolic blood pressure more than 10 mm H g during inspiration"},{"label":"C","text":"Rise in heart rate more than 20 bpm during inspiration"},{"label":"D","text":"Distant heart sounds"}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-5828e0baea87","stem":"3 While awaiting pericardiocentesis, immediate supportive care of a patient with cardiac tamponade should include which of the following?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Diuresis with furosemide"},{"label":"B","text":"Intravenous fluids"},{"label":"C","text":"Nitrates to lower venous congestion"},{"label":"D","text":"Morphine to relieve dyspnea"}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"5028a99abd063a5574772abe3a6fd3166790d84e"},{"id":"q-d8c1a4b74a7e","stem":"4 Which of the following is most likely to cause restrictive cardiomyopathy?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Endomyocardial fibrosis"},{"label":"B","text":"Viral myocarditis"},{"label":"C","text":"Beriberi (thiamine deficiency)"},{"label":"D","text":"Doxorubicin therapy"}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-7aa735c552f0","stem":"1 A 68-year-old man is hospitalized with Streptococcus bovis endocarditis of the mitral valve and recovers completely with appropriate therapy. Which of the following is the most important next step?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Good dental hygiene and proper denture fitting to prevent reinfection of damaged heart valves from oral flora."},{"label":"B","text":"Repeat echocardiography in 6 weeks to ensure the vegetations have resolved."},{"label":"C","text":"Colonoscopy to look for mucosal lesions."},{"label":"D","text":"Mitral valve replacement to prevent systemic emboli such as cerebral infarction."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"fe2ae961fec710ea8bfbe190191d011ff48fcf79"},{"id":"q-ca2f2fde319c","stem":"2 A 24-year-old intravenous drug user is admitted with 4 weeks of fever. He has three blood cultures positive with Candida spp and suddenly develops a cold blue toe. Which of the following is the appropriate next step?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Repeat echocardiography to see if the large aortic vegetation previously seen has now embolized."},{"label":"B","text":"Cardiovascular surgery consultation for aortic valve replacement."},{"label":"C","text":"Aortic angiography to evaluate for a mycotic neurysm, which may be embolizing."},{"label":"D","text":"Switch from fluconazole to amphotericin B."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d3ee3d3fad0e","stem":"3 A patient with which of the following conditions requires antimicrobial prophylaxis before dental surgery?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Atrial septal defect"},{"label":"B","text":"Mitral valve prolapse without mitral regurgitation"},{"label":"C","text":"Previous coronary artery bypass graft"},{"label":"D","text":"Previous infective endocarditis Table 12–3 • INDICATIONS FOR SURGICAL MANAGEMENT OF ENDOCARDITIS"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"fb055200ceaa8159f31b8b3af7f7d0066884b194"},{"id":"q-b80f1633b94a","stem":"1 A 49-year-old smoker with hypertension, diabetes, and hypercholesterolemia comes to the clinic complaining of pain in his calves when he walks two to three blocks. Which of the following therapies might offer him the greatest benefit in symptom reduction and in overall mortality?","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Cardiology","topicOriginal":"Cardiology","subtopic":"Hypertension","suggestedTopic":null,"options":[{"label":"A","text":"Aspirin"},{"label":"B","text":"Limb revascularization procedure"},{"label":"C","text":"Cilostazol"},{"label":"D","text":"Smoking cessation"},{"label":"E","text":"Pravastatin"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Cardiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f2531ded099a","stem":"2 A 31-year-old male smoker presents with resting pain in his legs and a nonhealing foot ulcer. Which of the following is the most likely cause of arterial insufficiency in this patient?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cholesterol embolism"},{"label":"B","text":"Fibromuscular dysplasia"},{"label":"C","text":"Thromboangiitis obliterans (Buerger disease)"},{"label":"D","text":"Takayasu arteritis"},{"label":"E","text":"Psychogenic pain"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"459c4d647f774cb42fa255def0662d9d68548c74"},{"id":"q-5717c759fcfc","stem":"3 A 21-year-old woman presents with fever, fatigue, and unequal pulses and blood pressures in her arms. Which of the following is the most likely cause of arterial insufficiency in this patient?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cholesterol embolism"},{"label":"B","text":"Fibromuscular dysplasia"},{"label":"C","text":"Thromboangiitis obliterans (Buerger disease)"},{"label":"D","text":"Takayasu aortitis"},{"label":"E","text":"Psychogenic pain"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-54b8a0354d93","stem":"4 A 62-year-old man presents with livedo reticularis and three blue toes, including one with gangrene following cardiac catheterization. Which of the following is the most likely cause of this patient’s findings?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cholesterol embolism"},{"label":"B","text":"Fibromuscular dysplasia"},{"label":"C","text":"Thromboangiitis obliterans (Buerger disease)"},{"label":"D","text":"Takayasu aortitis"},{"label":"E","text":"Psychogenic pain"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"27a8d69cc24313e6a3786b1dceb827c2ea1affff"},{"id":"q-3ae17153447b","stem":"5 A 67-year-old woman is noted to have significant peripheral vascular disease. She is evaluated by the cardiovascular surgeon but not felt to be a surgical candidate. Which of the following conditions is likely to be present in this patient?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Diffuse atherosclerotic disease"},{"label":"B","text":"Leg pain at rest"},{"label":"C","text":"Symptoms that do not improve with pharmacologic management"},{"label":"D","text":"Nonhealing ulcers of the ankle"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9dbbee0ac5e7","stem":"1 A 35-year-old woman complains of calf tenderness and acute Dyspnoea. The arterial blood gas reveals partial pressure of oxygen (PO 2) of 76 mm Hg. Which of the following is the most common physical examination fining of pulmonary embolism?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Wheezing"},{"label":"B","text":"Increase pulmonary component of the second heart sound"},{"label":"C","text":"Tachypnoea"},{"label":"D","text":"Calf swelling"},{"label":"E","text":"Pulmonary rales"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"22d176e213d24470b25c0dfc11fe7ee4a760cdef"},{"id":"q-c27c515f582c","stem":"2 A 39-year-old man is note to have a deep venous thrombosis without any known risk factors. He notes that his brother also developed a pulmonary embolism at age 45, and his mother developed a “clot in the leg” when she was in her thirties. Which of the following is the most likely inherited disorder in this patient?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Protein S deficiency"},{"label":"B","text":"Antithrombin III deficiency"},{"label":"C","text":"Factor V Leiden mutation"},{"label":"D","text":"Antiphospholipid antibody syndrome"},{"label":"E","text":"Familial malignancy syndrome"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2eeb9ccca666","stem":"3 A 54-year-ol woman is note to have cervical cancer and present with significant vaginal bleeding with a haemoglobin level of 7 g/dL. Her left leg is swollen, which on Doppler investigation reveals a deep venous thrombosis. Which of the following is the best treatment for the thrombus?","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Intravenous unfractionated heparin"},{"label":"B","text":"Fractionate subcutaneous heparin"},{"label":"C","text":"Subcutaneous unfractionated heparin"},{"label":"D","text":"Oral warfarin (Coumadin)"},{"label":"E","text":"Vena cava filter RESPIRATORY"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"de03c61ef7d9e5243f86c1000cb8c2fcc9cb9a6f"},{"id":"q-dcd7ced33b4f","stem":"1 Which of the following is the most likely physical examination findings in a patient with COPD?","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Respiratory Medicine","topicOriginal":"Respiratory Medicine","subtopic":"Copd","suggestedTopic":null,"options":[{"label":"A","text":"Diffuse expiratory wheezing"},{"label":"B","text":"Clubbing of the fingers"},{"label":"C","text":"Bibasilar inspiratory crackles with increased jugular venous pressure ( JVP)"},{"label":"D","text":"Inspiratory stridor"},{"label":"E","text":"Third heart sound"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Respiratory Medicine","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ca73d29cce91","stem":"2 A 56-year-old woman admits to a 60-pack-year smoking history. She complains of fatigue and dyspnea with minimal exertion, and a cough that is productive each morning. Which of the following is the most likely finding in this patient?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Higher diffusing capacity of lung for carbon monoxide (DLCO)"},{"label":"B","text":"Decreased residual volume"},{"label":"C","text":"Normal to slightly increased FEV1"},{"label":"D","text":"Decreased FEV1/ FVC"},{"label":"E","text":"Decreased FVC"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"5608d9e6916044710779616c37792ebc6d894115"},{"id":"q-e1d25e40913a","stem":"3 Which of the following therapies is most likely to provide the greatest benefit to a patient with chronic stable emphysema and a resting oxygen saturation of 86%?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Inhaled tiotropium daily"},{"label":"B","text":"Inhaled albuterol as needed"},{"label":"C","text":"Oral prednisone daily"},{"label":"D","text":"Supplemental oxygen used at night"},{"label":"E","text":"Supplemental oxygen used continuously"}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-93e594298078","stem":"1 A patient with known asthma undergoing therapy with inhaled corticosteroids and intermittent (short acting) β2-agonist presents with complaints of nocturnal awakenings secondary to cough and occasional wheezing. This episode occurs three to four times per week. Pulmonary function tests in the past have shown mild obstructive lung disease. Which of the following is the best next step?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Oral steroids"},{"label":"B","text":"Leukotriene inhibitors"},{"label":"C","text":"Long-acting β2-agonists"},{"label":"D","text":"Theophylline"},{"label":"E","text":"Anti-reflux therapy"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"6c13ba04c81357b30107bf5fa60c1ba9ca946ad3"},{"id":"q-1dc4a436e692","stem":"2 Which of the following is most accurate?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cough caused by captopril may resolve with switching to enalapril."},{"label":"B","text":"Initial treatment of a chronic cough should include codeine or a similar opiate derivative to suppress the cough."},{"label":"C","text":"Cough caused by reflux can be effectively ruled out by a negative history of heartburn or dyspepsia."},{"label":"D","text":"More than one condition is often responsible for causing chronic cough in a given patient."}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-b358dd01139e","stem":"3 A 22-year-old African-American woman presents with fatigue, arthralgias, and a nagging dry cough for the past 6 weeks, but no shortness of breath. On physical examination, her lungs are clear to auscultation, and she has bilateral pretibial tender erythematous raised nodules. Which of the following is your best next step?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Chest radiograph"},{"label":"B","text":"High-resolution CT"},{"label":"C","text":"Empiric treatment for postnasal drip"},{"label":"D","text":"Antinuclear antibody"},{"label":"E","text":"Initiation of antituberculosis therapy"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"8b82bb0cd7956e697f089398d5433af1ffd0a4a0"},{"id":"q-3802fee7c320","stem":"4 An obese 50-year-old man with a history of asthma returns with complaints of occasional dyspepsia and nocturnal cough. He wakes up in the morning with a sour taste in his mouth. His current medications include inhaled corticosteroid and a short-acting β 2- agonist. Which of the following should be your next step?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"24-H our oesophageal pH monitoring"},{"label":"B","text":"Chest radiograph"},{"label":"C","text":"Initiation of omeprazole"},{"label":"D","text":"Short course of oral corticosteroids"},{"label":"E","text":"Initiation of allergy desensitization"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f1decf0d01e3","stem":"1 A 55-year-old man with congestive heart failure develops bilateral pleural effusions. Which of the following is the most likely pleural fluid characteristic if thoracentesis is performed?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Pleural fluid LDH 39, LDH ratio 0.2, protein ratio 0.7"},{"label":"B","text":"Pleural fluid LDH 39, LDH ratio 0.2, protein ratio 0.1"},{"label":"C","text":"Pleural fluid LDH 599, LDH ratio 0.9, protein ratio 0.1"},{"label":"D","text":"Pleural fluid LDH 599, LDH ratio 0.9, protein ratio 0.7"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"2094905fba721eaaeb489d5300b54c7efc26fd67"},{"id":"q-18688508a266","stem":"2 A 39-year-old man develops a moderate free-flowing pleural effusion following a left lower lobe pneumonia. Thoracentesis reveals straw-colored fluid with gram- positive diplococci on Gram stain, pH 6.9, glucose 32 mg/dL, and LDH 1890. Which of the following is the best next step?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Send the fluid for culture."},{"label":"B","text":"Continue treatment with antibiotics for pneumococcal infection."},{"label":"C","text":"Tube thoracostomy to drain the effusion."},{"label":"D","text":"Schedule a follow-up chest x-ray in 2 weeks to document resolution of the effusion."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-daebe77584f6","stem":"3 A 69-year-old man complains of gradually worsening dyspnea and a nagging cough over the past 3 months but no fevers. He is found to have a right-sided pleural effusion, which is tapped and is grossly bloody. Which of the following is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Parapneumonic effusion"},{"label":"B","text":"Malignancy in the pleural space"},{"label":"C","text":"Rupture of aortic dissection into the pleural space"},{"label":"D","text":"Pulmonary embolism with pulmonary infarction"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"9cdbc40604064e65eceb2ed6b920840836f6f109"},{"id":"q-d6e04bf99476","stem":"1 A 67-year-old long-time smoker with chronic obstructive pulmonary disease presents with 3 days of headaches and plethoric swelling of his face and right arm. Which of the following is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Angioedema"},{"label":"B","text":"Hypothyroidism"},{"label":"C","text":"Superior vena cava syndrome"},{"label":"D","text":"Trichinosis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6f6ecb280135","stem":"2 A 64-year-old woman comes to your office complaining of hoarse voice for 4 months. She has not had fever, sore throat, or a cough. On examination, she has expiratory wheezes in her left mid-lung fields. Which of the following is the best next step?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Prescribe antibiotics for bronchitis."},{"label":"B","text":"Order a chest x-ray."},{"label":"C","text":"Advise gargling with saltwater solution."},{"label":"D","text":"Prescribe an albuterol inhaler."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"8f17057891bd0e8d5b68980dfe7d8fac5195e83e"},{"id":"q-aa39062ba001","stem":"3 A 33-year-old woman who is a nonsmoker has lost 30 lb and has a cough. She is noted to have a lung mass on chest radiograph. Which of the following lung cancers is the most likely cell type?","type":"Radiological Interpretation","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Squamous cell"},{"label":"B","text":"Adenocarcinoma"},{"label":"C","text":"Small cell"},{"label":"D","text":"Large cell"}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-018430aa94c5","stem":"4 A 52-year-old man presents with dyspnea, and chest x-ray shows a hilar mass with ipsilateral pleural effusion. Which of the following is the best next step?","type":"Radiological Interpretation","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"CT scan of the chest, head, and abdomen for cancer staging."},{"label":"B","text":"Pulmonary function testing to evaluate pulmonary reserve to evaluate for pulmonectomy."},{"label":"C","text":"Obtain a specific tissue diagnosis by biopsy of the hilar mass."},{"label":"D","text":"Initiate palliative radiation because the patient is not a candidate for curative resection."}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","repeated_question_stem","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"90858b0f7d6f9334804851ac76131b6e938286fe"},{"id":"q-f112c3d0f19a","stem":"1 A 65-year-old cigarette smoker with a history of hypertension and mild congestive heart failure presents to the emergency room with worsening cough, fever, and dyspnea at rest. The illness began 1 week ago with fever, muscle aches, abdominal pain, and diarrhea, with nonproductive cough developing later that week and rapidly becoming worse. Therapy for which of the following atypical organisms must be considered in this case?","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Cardiology","topicOriginal":"Cardiology","subtopic":"Hypertension","suggestedTopic":null,"options":[{"label":"A","text":"C pneumoniae"},{"label":"B","text":"M pneumoniae"},{"label":"C","text":"Legionella pneumophila"},{"label":"D","text":"Coccidioidomycosis"},{"label":"E","text":"Aspergillus fumigates"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Cardiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-91d2e6c1e0ed","stem":"day history of fever and productive cough. Chest x-ray reveals a right middle lobe consolidation. Which of the following is the most appropriate initial antibiotic choice?","type":"Radiological Interpretation","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Oral amoxicillin"},{"label":"B","text":"Intravenous linezolid"},{"label":"C","text":"Intravenous cefepime"},{"label":"D","text":"Oral azithromycin"}],"priority":1,"status":"review","flags":["requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","repeated_question_stem","requires_visual_review","visual_asset_not_transcribed"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"1b7c1ed6d44a2cc25ec7c6eadbb1289df851f4d0"},{"id":"q-a53497ecb336","stem":"3 A 56-year-old man is brought into the emergency room intoxicated with alcohol. He has repeated bouts of emesis and is found choking. Lung examination reveals some crackles in the right lung base. Which of the following is the most appropriate management?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Initiate azithromycin."},{"label":"B","text":"Initiate corticosteroid therapy."},{"label":"C","text":"Initiate haloperidol therapy."},{"label":"D","text":"Observation with follow-up chest radiograph. GASTRO"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4ec0bd297292","stem":"1 A 42-year-old overweight but otherwise healthy woman presents with sudden onset of right upper abdominal colicky pain 45 minutes after a meal of fried chicken. The pain is associated with nausea and vomiting, and any attempt to eat since then has caused increased pain. Which of the following is the most likely cause?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Gastric ulcer"},{"label":"B","text":"Cholelithiasis"},{"label":"C","text":"Duodenal ulcer"},{"label":"D","text":"Acute hepatitis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"1192e558d0fdf686bdd20142d527ea52fea55bca"},{"id":"q-279e5df0c4c3","stem":"2 Which of the following is the most accurate statement regarding H pylori infection?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It is more common in North America than in the developing world."},{"label":"B","text":"It is associated with the development of colon cancer."},{"label":"C","text":"Eradication of H pylori eliminates most cases of non ulcer dyspepsia."},{"label":"D","text":"The route of transmission is believed to be sexually transmitted."},{"label":"E","text":"It is a cause of both duodenal and gastric ulcers"}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-7cc0153813b1","stem":"3 A 45-year-old man was brought to the emergency room (ER) after vomiting bright red blood. H e has a blood pressure of 88/ 46 mm H g and heart rate of 120 bpm. Which of the following is the best next step?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Intravenous fluid resuscitation and preparation for a transfusion"},{"label":"B","text":"Administration of a proton pump inhibitor"},{"label":"C","text":"Guaiac test of the stool"},{"label":"D","text":"Treatment for H pylori"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"b79dd347d12d9cbcb4c708c9652050049f40d210"},{"id":"q-29f014215374","stem":"4 Which one of the following patients should be promptly referred for endoscopy?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A 65-year-old man with new onset of epigastric pain and weight loss"},{"label":"B","text":"A 32-year-old patient whose symptoms are not relieved with ranitidine"},{"label":"C","text":"A 29-year-old H pylori-positive patient with dyspeptic symptoms"},{"label":"D","text":"A 49-year-old woman with intermittent right upper quadrant pain following meals"}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-d7e4497a9dfe","stem":"1 A 32-year-old woman has a history of chronic diarrhea and gallstones and now has rectovaginal fistula. Which of the following is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Crohn disease"},{"label":"B","text":"Ulcerative colitis"},{"label":"C","text":"Systemic lupus erythematosus"},{"label":"D","text":"Laxative abuse"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"eb4717b5534b1ca8ac0b3589aaf7d66839283ccf"},{"id":"q-4615f3eef3ed","stem":"2 A 45-year-old man with a history of ulcerative colitis is admitted to the hospital with 2 to 3 weeks of right upper quadrant abdominal pain, jaundice, and pruritus. H e has no fever and a normal W BC count. (ERCP) shows multifocal strictures of both the intrahepatic and extrahepatic bile ducts with intervening segments of normal and dilated ducts. Which of the following is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Acute suppurative cholangitis"},{"label":"B","text":"Cholangiocarcinoma"},{"label":"C","text":"Primary sclerosing cholangitis (PSC)"},{"label":"D","text":"Choledocholithiasis with resultant biliary strictures"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f47e308f9bda","stem":"3 A 25-year-old man is hospitalized for ulcerative colitis. He has now developed abdominal distention, fever, and transverse colonic dilation of 7 cm on x-ray. Which of the following is the best next step?","type":"Radiological Interpretation","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"5-ASA"},{"label":"B","text":"Oral steroids"},{"label":"C","text":"IV antibiotics and prompt surgical consultation"},{"label":"D","text":"Infliximab"}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","repeated_question_stem","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"1b49bceab01df596b20bdf9bbb87b72cfd9b9926"},{"id":"q-c1332a1e4d78","stem":"4 A 35-year-old woman has chronic crampy abdominal pain and intermittent constipation and diarrhea, but no weight loss or gastrointestinal bleeding. Her abdominal pain is usually relieved with defection. Colonoscopy and upper endoscopy with biopsies are normal, and stool cultures are negative. Which of the following is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Infectious colitis"},{"label":"B","text":"Irritable bowel syndrome"},{"label":"C","text":"Crohn disease"},{"label":"D","text":"Ulcerative colitis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5677844a5ac5","stem":"1 A 48-year-old woman is admitted to the hospital with left lower quadrant abdominal pain, leukocytosis, and a CT showing sigmoid wall thickening consistent with a pericolic abscess. H er only significant medical history is a similar hospitalization with the same diagnosis less than 1 year previously. Which of the following is the most appropriate treatment?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Surgical consultation for exploratory laparotomy and sigmoid resection"},{"label":"B","text":"Intravenous antibiotics with follow-up colonoscopy after hospital discharge"},{"label":"C","text":"Intravenous antibiotics and barium enema to evaluate for possible colonic malignancy"},{"label":"D","text":"Intravenous antibiotics and recommendations for postdischarge diet high in fiber with whole grains and nuts to minimize the risk of diverticular progression"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"4032551e484025c4d583a7b4b7d5e081e6545b51"},{"id":"q-75bdb37ce723","stem":"2 A 78-year-old is noted to have fever and chills, decreased mentation, tachycardia, and right lower quadrant abdominal tenderness and guarding. Which of the following is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ruptured diverticulitis"},{"label":"B","text":"Meningitis"},{"label":"C","text":"Ruptured appendicitis"},{"label":"D","text":"Ischemic bowel"},{"label":"E","text":"Urosepsis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-323648c720e9","stem":"3 A 58-year-old man presents to the emergency room with a temperature of 102°F, abdominal pain localizing to the left lower quadrant, and mild rebound tenderness. Which of the following diagnostic tests is the best next step?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Barium enema"},{"label":"B","text":"Flexible sigmoidoscopy"},{"label":"C","text":"CT imaging of the abdomen"},{"label":"D","text":"Laparoscopic examination"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"fa1264894254903d276462b51c601a375426e12d"},{"id":"q-75b661dc940b","stem":"1 Which of the following features is not consistent with the diagnosis of irritable bowel syndrome?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Abdominal pain relieved with defecation"},{"label":"B","text":"Sensation of incomplete evacuation"},{"label":"C","text":"Passage of mucus"},{"label":"D","text":"Nocturnal awakening with pain or diarrhea"},{"label":"E","text":"Normal bowel habits alternating with either diarrhea or constipation"}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-e26549c87d1c","stem":"2 Which of the following findings is more consistent with an osmotic, rather than a secretory, diarrhea?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The diarrhea persists despite a 48-hour fast."},{"label":"B","text":"Stool osmolality = 290 mOsm, stool Na = 95 mOsm, stool K = 15 mOsm."},{"label":"C","text":"Diarrhea is large volume and watery, and is accompanied by paroxysms of flushing and wheezing."},{"label":"D","text":"Profuse, painless “rice-water” stool in a patient in a cholera-endemic area."}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"4d4b8250d296e5df335e7271e91a88d3b2756866"},{"id":"q-6096ae550888","stem":"3 Which of the following patients is not a good candidate for evaluation for celiac disease, with either endoscopy or serologic testing?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A 26-year-old woman who experiences with intermittent abdominal bloating but no diarrhea and is found to have osteopenia and vitamin D deficiency."},{"label":"B","text":"A 19-year-old college freshman with bulky, foul- smelling, floating stools and excessive flatulence, who has lost 20 lb unintentionally."},{"label":"C","text":"A thin, 39-year-old man with a family history of celiac disease, who has been adhering to a gluten-free vegetarian diet for the last 3 years, and now complains of gassiness and reflux."},{"label":"D","text":"A 42-year-old man who was found to have iron deficiency anemia, but has no gastrointestinal symptoms, and recently had a negative colonoscopy."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-12acc689ca15","stem":"1 A 15-year-old adolescent girl has elevated liver enzymes and a positive antinuclear antibody (ANA). Choose the one cause (A-G) that is probably responsible for the patient’s presentation.","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Wilson disease"},{"label":"B","text":"Hematochromatosis"},{"label":"C","text":"Primary biliary cirrhosis"},{"label":"D","text":"Sclerosing cholangitis"},{"label":"E","text":"Autoimmune hepatitis"},{"label":"F","text":"Alcohol-induced hepatitis"},{"label":"G","text":"Viral hepatitis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"2abd5999a6b4a301fe21596cc120961bd75085f9"},{"id":"q-4aeb8e663ca3","stem":"2 A 56-year-old man has brittle diabetes (difficult to control with widely fluctuating blood sugars), tan skin, and a family history of cirrhosis. Select the cause (A-G) that is probably responsible for the patient’s presentation.","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Gastroenterology and Hepatology","topicOriginal":"Gastroenterology and Hepatology","subtopic":"Cirrhosis","suggestedTopic":null,"options":[{"label":"A","text":"Wilson disease"},{"label":"B","text":"Hematochromatosis"},{"label":"C","text":"Primary biliary cirrhosis"},{"label":"D","text":"Sclerosing cholangitis"},{"label":"E","text":"Autoimmune hepatitis"},{"label":"F","text":"Alcohol-induced hepatitis"},{"label":"G","text":"Viral hepatitis"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Gastroenterology and Hepatology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7f22b3092a74","stem":"3 A 35-year-old man presents to your clinic with progressive jaundice, pruritis, and fatigue. He has ulcerative colitis. Choose the cause that is probably responsible for the patient’s presentation.","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Wilson disease"},{"label":"B","text":"Hematochromatosis"},{"label":"C","text":"Primary biliary cirrhosis"},{"label":"D","text":"Sclerosing cholangitis"},{"label":"E","text":"Autoimmune hepatitis"},{"label":"F","text":"Alcohol-induced hepatitis"},{"label":"G","text":"Viral hepatitis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"a5c1536deb5b85a8b074ba23e5264e4e881afe78"},{"id":"q-22bdd50e2e3b","stem":"4 A 56-year-old woman who presented with complaints of pruritus and fatigue has elevated alkaline phosphatase. Select the cause that is probably responsible for the patient’s presentation.","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Wilson disease"},{"label":"B","text":"Hematochromatosis"},{"label":"C","text":"Primary biliary cirrhosis"},{"label":"D","text":"Sclerosing cholangitis"},{"label":"E","text":"Autoimmune hepatitis"},{"label":"F","text":"Alcohol-induced hepatitis"},{"label":"G","text":"Viral hepatitis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"8fc151b56d6e2c06854bd6d96aff181a1acb9ed5"},{"id":"q-d90e718ede80","stem":"5 A 32-year-old man presents to your clinic with Kayser-Fleischer rings, dysarthria, and spasticity. Pick the cause from the following that is probably responsible for the patient’s presentation.","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Wilson disease"},{"label":"B","text":"Hematochromatosis"},{"label":"C","text":"Primary biliary cirrhosis"},{"label":"D","text":"Sclerosing cholangitis"},{"label":"E","text":"Autoimmune hepatitis"},{"label":"F","text":"Alcohol-induced hepatitis"},{"label":"G","text":"Viral hepatitis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"a8a38393d825acc59651b7894f20db9e9814a66b"},{"id":"q-c6d5f4323714","stem":"1 A 43-year-old man who is an alcoholic is admitted to the hospital with acute pancreatitis. H e is given intravenous hydration and is placed NPO. Which of the following findings is a predictor of higher mortality?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"His age"},{"label":"B","text":"Initial serum glucose level of 60 mg/ dL"},{"label":"C","text":"BUN of 18 mg/ dL"},{"label":"D","text":"Disorientation, with Glasgow Coma Scale score of 10"},{"label":"E","text":"Amylase level of 1000 IU/ L"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0f841e95943c","stem":"2 A 37-year-old woman is noted to have gallstones on ultrasonography. She is placed on a low-fat diet. After 3 months she is noted to have severe right upper quadrant pain, fever to 102°F, and nausea. Which of the following is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Acute cholangitis"},{"label":"B","text":"Acute cholecystitis"},{"label":"C","text":"Acute pancreatitis"},{"label":"D","text":"Acute perforation of the gallbladder"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"4382cb0e8c1e8f33be69108642942a6b754b3754"},{"id":"q-b61bed3809e6","stem":"3 A 45-year-old man was admitted for acute pancreatitis, thought to be a result of blunt abdominal trauma. After 3 months he still has epigastric pain but is able to eat solid food. His amylase level is elevated at 260 IU/ L. Which of the following is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Recurrent pancreatitis"},{"label":"B","text":"Diverticulitis"},{"label":"C","text":"Peptic ulcer disease"},{"label":"D","text":"Pancreatic pseudocyst"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e816ff46c2c9","stem":"1 A 25-year-old medical student is stuck with a hollow needle during a procedure performed on a patient known to have hepatitis B and C viral infection, but who is H IV negative. The student’s baseline laboratory studies include serology: H BsAg negative, anti-H BsAb positive, anti-H Bc IgG negative. Which of the following regarding this medical student’s hepatitis status is true?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Prior vaccination with hepatitis B vaccine"},{"label":"B","text":"Acute infection with hepatitis B virus"},{"label":"C","text":"Prior infection with hepatitis B virus"},{"label":"D","text":"The student was vaccinated for hepatitis B but is not immune"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"b945f8be32a9517bc8ae056ce44b926108894816"},{"id":"q-aab105fefa4e","stem":"2 What postexposure prophylaxis should the student described in Question 26.1 receive?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"HBIg"},{"label":"B","text":"Oral lamivudine"},{"label":"C","text":"Intravenous immunoglobulin (IVIG)"},{"label":"D","text":"Reassurance"}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-7b952aef3b17","stem":"3 In a suicide attempt, an 18-year-old woman took 4 g of acetaminophen, approximately 8 hours previously. H er acetaminophen level is 30 μg/ mL. Which of the following is the best next step to be performed for this patient?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Immediately start N-acetylcysteine"},{"label":"B","text":"Observation"},{"label":"C","text":"Alkalinize the urine"},{"label":"D","text":"Administer intravenous activated charcoal RENAL"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","whitespace/page_marker_normalization"],"duplicateStemGroup":"04682a97afc76749f9c3661ae5bc7bc1bed4f989"},{"id":"q-4e6137b1147f","stem":"1 An 18-year-old marathon runner has been training during the summer. H e is brought to the emergency room disoriented after collapsing on the track. His temperature is 102°F. A Foley catheter is placed and reveals reddish urine with 3+ blood on dipstick and no cells seen microscopically. Which of the following is the most likely explanation for his urine?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Underlying renal disease"},{"label":"B","text":"Prerenal azotemia"},{"label":"C","text":"Myoglobinuria"},{"label":"D","text":"Glomerulonephritis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-913e29d903aa","stem":"2 Which of the following laboratory findings is most consistent with poststreptococcal glomerulonephritis?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Labor and Delivery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Labor and Delivery","options":[{"label":"A","text":"Elevated serum complement levels"},{"label":"B","text":"Positive antinuclear antibody titers"},{"label":"C","text":"Elevated ASO titers"},{"label":"D","text":"Positive blood cultures"},{"label":"E","text":"Positive cryoglobulin titers"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Labor and Delivery · Suggested","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"dece9ed7faeac5b1942f4d43169b3e35d4099470"},{"id":"q-f58fb58e6982","stem":"3 A 22-year-old man complains of acute hemoptysis over the past week. He denies smoking or pulmonary disease. H is blood pressure is 130/ 70 mm Hg, and his physical examination is normal. His urinalysis also shows microscopic hematuria and red blood cell casts. Which of the following is the most likely etiology?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Metastatic renal cell carcinoma to the lungs"},{"label":"B","text":"Acute tuberculosis of the kidneys and lungs"},{"label":"C","text":"Systemic lupus erythematosus"},{"label":"D","text":"Goodpasture disease (antiglomerular basement membrane)"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-fd6ec38a466b","stem":"1 A 49-year-old woman with type 2 diabetes presents to your office for new onset swelling in her legs and face. She has no other medical problems and says that at her last ophthalmologic appointment she was told that the diabetes had started to affect her eyes. She takes glyburide daily for her diabetes. Physical examination is normal except for hard exudates and dot hemorrhages on funduscopic examination, and diminished sensation up to the mid-shin bilaterally. Her blood pressure is normal. Urine analysis shows 2+ protein and 2+ glucose (otherwise negative). Which of the following is the best treatment for this patient?","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"Diabet","suggestedTopic":null,"options":[{"label":"A","text":"Have the patient return in 6 weeks and check a repeat urine analysis at that time."},{"label":"B","text":"Start metoprolol."},{"label":"C","text":"Change the glyburide to glipizide and have the patient return for followup in 6 weeks."},{"label":"D","text":"Start lisinopril."},{"label":"E","text":"Refer the patient to a cardiologist."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Endocrinology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-89ca44a71fe8","stem":"2 A 19-year-old man was seen at the university student health clinic a week ago complaining of pharyngitis, and now returns because he has noted discoloration of his urine. He is noted to have elevated blood pressure (178/ 110 mm H g), and urinalysis reveals red blood cell (RBC) casts, dysmorphic RBCs, and 1+ proteinuria. Which of the following is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"SLE"},{"label":"B","text":"Amyloidosis"},{"label":"C","text":"Poststreptococcal glomerulonephritis"},{"label":"D","text":"H IV nephropathy"},{"label":"E","text":"Diabetic nephropathy"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"aaccebd07dd840eb54504b02bfa900c183aba625"},{"id":"q-784ad4743fc6","stem":"3 Which of the following is the best screening test for early diabetic nephropathy?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Urine microalbuminuria"},{"label":"B","text":"Dipstick urinalysis"},{"label":"C","text":"Renal biopsy"},{"label":"D","text":"Fasting blood glucose"},{"label":"E","text":"Twenty-four-hour urine collection for creatinine clearance"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5dd26eb39cbe","stem":"4 A 58-year-old man with type 2 diabetes is normotensive, has no known heart disease, and has a baseline creatinine of 1.8 mg/ dL. H is fasting lipid profile shows triglycerides 205 mg/ dL, total cholesterol 220 mg/ dL, high-density lipoprotein (H DL) 35 mg/ dL, and LDL 148 mg/ dL. What is the most appropriate treatment?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Niacin"},{"label":"B","text":"Low-protein diet"},{"label":"C","text":"Gemfibrozil"},{"label":"D","text":"Simvastatin"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"4b549dde2aa9c587919d61a2e906073195268690"},{"id":"q-2a1e2b300e00","stem":"1 A 63-year-old woman with a history of cervical cancer treated with hysterectomy and pelvic irradiation now presents with acute oliguric renal failure. On physical examination, she has normal jugular venous pressure, is normotensive without orthostasis, and has a benign abdominal examination. H er urinalysis shows a specific gravity of 1.010, with no cells or casts on microscopy. Urinary FENa is 2% and the Na level is 35 mEq/ L. Which of the following is the best next step?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"Bolus of intravenous fluids"},{"label":"B","text":"Renal ultrasound"},{"label":"C","text":"Computed tomographic (CT ) scan of the abdomen with intravenous contrast"},{"label":"D","text":"Administration of furosemide to increase her urine output"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-74ae1eda05be","stem":"2 A 49-year-old man with a long-standing history of chronic renal failure as a consequence of diabetic nephropathy is brought to the emergency room for nausea, lethargy, and confusion. H is physical examination is significant for an elevated jugular venous pressure, clear lung fields, and harsh systolic and diastolic sounds heard over the precordium. Serum chemistries reveal K 5.1 mEq/ L, CO 2 17 mEq/ L, BUN 145 mg/ dL, and creatinine 9.8 mg/ dL. Which of the following is the most appropriate therapy?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Administer IV insulin and glucose."},{"label":"B","text":"Administer IV sodium bicarbonate."},{"label":"C","text":"Administer IV furosemide."},{"label":"D","text":"Urgent hemodialysis."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-a3294f5c8bd0","stem":"3 A 62-year-old diabetic man underwent an abdominal aortic aneurysm repair 2 days ago. H e is being treated with gentamicin for a urinary tract infection. His urine output has fallen to 300 mL over 24 hours, and his serum creatinine has risen from 1.1 mg/ dL on admission to 1.9 mg/ dL. Which of the following laboratory values would be most consistent with a prerenal etiology of his renal insufficiency?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Labor and Delivery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Labor and Delivery","options":[{"label":"A","text":"FENa of 3%"},{"label":"B","text":"Urinary sodium level of 10 mEq/ L"},{"label":"C","text":"Central venous pressure reading of 10 mm H g"},{"label":"D","text":"Gentamicin trough level of 4 μg/ mL JOINTS"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Labor and Delivery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"00064f7364e3c5374b66f94f8f97479b55e28fac"},{"id":"q-d7b859f6e6ad","stem":"1 Which of the following is most likely to be associated with advanced OA?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Disability with recurrent falls and inability to live alone"},{"label":"B","text":"Joints with redness and effusion"},{"label":"C","text":"Best treated with oral steroids"},{"label":"D","text":"Improvement throughout the day after approximately 1 to 2 hours of “unfreezing the joint”"}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-a6d245c16be2","stem":"6 A 72-year-old man complains of painful joints in his hips and knees, which you have diagnosed as osteoarthritis. Which of the following is the best first medication to prescribe for this patient?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Naproxen sodium"},{"label":"B","text":"Celecoxib"},{"label":"C","text":"Oral prednisone"},{"label":"D","text":"Intra-articular prednisone"},{"label":"E","text":"Acetaminophen"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-60307eb0f9ed","stem":"1 A 35-year-old obese hotel housekeeper presents with 1 week of lower back pain. H er history and examination are without “red flag” symptoms and completely normal, except for her weight. Which of the following is the best next step?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Regular doses of a N SAID, and activity as tolerated"},{"label":"B","text":"Six weeks of bed rest"},{"label":"C","text":"MRI of the lumbar spine"},{"label":"D","text":"Plain film x-ray of lumbosacral spine"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-1ee4ca9c3849","stem":"month history of persistent lower lumbar back pain, associated with a low-grade fever and night sweats. She denies any extremity weakness or human immunodeficiency virus (H IV) risk factors. Her examination is normal except for point tenderness over the spinous processes of L4-L5. Which of the following is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Staphylococcus aureus osteomyelitis"},{"label":"B","text":"Tuberculous osteomyelitis"},{"label":"C","text":"Given her age, idiopathic low back pain"},{"label":"D","text":"Metastatic breast cancer"},{"label":"E","text":"Multiple myeloma"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ae731bc4a504","stem":"8 mg/ dL, and calcium level 11.2 mg/ dL. Which of the following is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Osteoporosis with compression fractures"},{"label":"B","text":"Renal failure with osteodystrophy"},{"label":"C","text":"Multiple myeloma"},{"label":"D","text":"Lumbar strain"},{"label":"E","text":"Osteomyelitis"}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"],"duplicateStemGroup":"471b642bbb7a7d5fd61061f7d10b6099c6e5df3e"},{"id":"q-5e6b9a7c931e","stem":"4 A 45-year-old man complains of decreased sensation in his buttocks and inability to achieve an erection. On examination he has decreased anal sphincter tone and decreased ankle reflexes bilaterally. Which of the following is the next best step in management?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Bed rest and follow-up in 4 to 6 weeks"},{"label":"B","text":"Plain film x-ray of lumbosacral spine"},{"label":"C","text":"Sedimentation rate and complete blood count"},{"label":"D","text":"Immediate referral for advanced imaging and surgical evaluation"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d13a2e0fc339","stem":"1 A previously healthy 18-year-old college freshman presents to the student health clinic complaining of pain on the dorsum of her left wrist and in her right ankle, fever, and a pustular rash on the extensor surfaces of both her forearms. She has mild swelling and erythema of her ankle, and pain on passive flexion of her wrist. Less than 1 mL of joint fluid is aspirated from her ankle, which shows 8000 PMN cells per high-power field (hpf ) but no organisms on Gram stain. Which of the following is the best initial treatment?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Indomethacin orally"},{"label":"B","text":"Intravenous ampicillin"},{"label":"C","text":"Colchicine orally"},{"label":"D","text":"Intra-articular prednisone"},{"label":"E","text":"Intravenous ceftriaxone"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"],"duplicateStemGroup":"e1a3462a92f38e2dcb870e410971f72fbb93352c"},{"id":"q-0ee6f1065220","stem":"2 Which of the following diagnostic tests is most likely to give the diagnosis for the case in Question 33.1?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Crystal analysis of the joint fluid"},{"label":"B","text":"Culture of joint fluid"},{"label":"C","text":"Blood culture"},{"label":"D","text":"Cervical culture"}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-708b33b9c316","stem":"3 A 30-year-old man is noted to have an acutely swollen and red knee. Joint aspirate reveals numerous leukocytes and polymorphonuclear leukocytes, but no organisms on Gram stain. Analysis shows few negatively birefringent crystals. Which of the following is the best initial treatment?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Oral corticosteroids"},{"label":"B","text":"Intra-articular corticosteroids"},{"label":"C","text":"Intravenous antibiotic therapy"},{"label":"D","text":"Oral colchicine"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"ce9dd5322adca2200e1ad51a6c9021cbad23f206"},{"id":"q-1142564b4cc4","stem":"1 A 72-year-old man develops severe pain and swelling in both knees, shortly after undergoing an abdominal hernia repair surgery. Physical examination shows warmth and swelling of both knees with large effusions. Arthrocentesis of the right knee reveals the presence of intracellular and extracellular weakly positive birefringent crystals in the synovial fluid. Gram stain is negative. Which of the following is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Abdominal Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Abdominal Surgery","options":[{"label":"A","text":"Gout"},{"label":"B","text":"Septic arthritis"},{"label":"C","text":"Calcium oxalate deposition disease"},{"label":"D","text":"Reactive arthritis"},{"label":"E","text":"Pseudogout"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Abdominal Surgery · Suggested","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0d36200e5113","stem":"2 A 65-year-old man with a history of chronic hypertension, diabetes mellitus, and degenerative joint disease presents with acute onset of severe pain of the metatarsophalangeal (MTP) joint and swelling of the left first toe. Physical examination shows exquisite tenderness of the joint, with swelling, warmth, and erythema. The patient has no history of trauma or other significant medical problems. Synovial fluid analysis and aspiration are most likely to show which of the following?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"Hemorrhagic fluid"},{"label":"B","text":"Needle-shaped, negatively birefringent crystals"},{"label":"C","text":"Gram-negative organisms"},{"label":"D","text":"Noninflammatory fluid"},{"label":"E","text":"Rhomboidal, positively birefringent crystals"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"ce43faddcc60cef77b3fc69fcc77e22462e1a22d"},{"id":"q-4a7c2d560ba1","stem":"3 A 17-year-old sexually active adolescent boy presents with a 5-day history of fever, chills, and persistent left ankle pain and swelling. On physical examination, maculopapular and pustular skin lesions are noted on the trunk and extremities. H e denies any symptoms of genitourinary tract infection. Synovial fluid analysis is most likely to show which of the following?","type":"Single Best Answer MCQ","subject":"Dermatology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"W BCs 75,000/ mm3 with 95% polymorphonuclear leukocytes"},{"label":"B","text":"RBCs 100,000/ mm3, W BCs 1000/ mm3"},{"label":"C","text":"W BCs 48,000/ mm3 with 80% lymphocytes"},{"label":"D","text":"W BCs 500/ mm3 with 25% polymorphonuclear leukocytes"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Dermatology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-13fb5923c310","stem":"4 A 22-year-old man presents with complaints of low back pain for 3 to 4 months and stiffness of the lumbar area, which worsen with inactivity. H e reports difficulty in getting out of bed in the morning and may have to roll out sideways, trying not to flex or rotate the spine to minimize pain. A lumbosacral (LS) spine x-ray film would most likely show which of the following?","type":"Radiological Interpretation","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Degenerative joint disease with spur formation"},{"label":"B","text":"Sacroiliitis with increased sclerosis around the sacroiliac joints"},{"label":"C","text":"Vertebral body destruction with wedge fractures"},{"label":"D","text":"Osteoporosis with compression fractures of L3-L5"},{"label":"E","text":"Diffuse osteonecrosis of the LS spine"}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","repeated_question_stem","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":["whitespace/page_marker_normalization"],"duplicateStemGroup":"5321c72a3e727c05d9410bc5fd771b6388b5d0a9"},{"id":"q-bf8954859031","stem":"5 A 36-year-old woman was seen by her physician due to pain in her hands, wrists, and knees. She is diagnosed with rheumatoid arthritis. Which of the following treatments will reduce joint inflammation and slow progression of the disease?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"N SAIDs"},{"label":"B","text":"Joint aspiration"},{"label":"C","text":"Methotrexate"},{"label":"D","text":"Systemic corticosteroids"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a900175b6a98","stem":"1 Which of the following patients is most likely to be a candidate for bone mineral density screening?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A 65-year-old, thin, white woman who smokes and is 15 years postmenopausal"},{"label":"B","text":"A 40-year-old white woman who exercises daily and still menstruates"},{"label":"C","text":"A healthy 75-year-old white man who is sedentary"},{"label":"D","text":"A 60-year-old overweight African-American woman"},{"label":"E","text":"A 35-year-old asthmatic woman who took prednisone 40 mg/ d for a 2-week course 1 week ago"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"cec03782651a3504ec3e450510e2076b8dc60ba5"},{"id":"q-bd9ffe18099c","stem":"2 During which of the following periods in a woman’s life is the most bone mass accumulated?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ages 15-25"},{"label":"B","text":"Ages 25-35"},{"label":"C","text":"Ages 35-45"},{"label":"D","text":"Ages 45-55"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-47f12fd83c26","stem":"3 A 60-year-old woman presents with the results of her DEXA scan. She has a T score of – 1.5 SD at the hip and – 2.5 at the spine. Which of the following is the most accurate interpretation of these results?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"She has osteoporosis at the spine and osteopenia at the hip."},{"label":"B","text":"She has osteoporosis in both areas."},{"label":"C","text":"This is a normal examination."},{"label":"D","text":"She has osteoporosis of the hip and osteopenia at the spine."},{"label":"E","text":"You need to know the Z score."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"a2d2b99c80652524c42c37fef7b0f3e1db17a7c3"},{"id":"q-7114d2a46989","stem":"4 You see a 70-year-old woman in your office for a routine checkup, and you order a DEXA scan for bone mineral density screening. The T score returns as – 2.5 SD in the spine and – 2.6 in the hip. Which of the following statements is most accurate?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"This patient has osteopenia."},{"label":"B","text":"Estrogen replacement therapy should be started with an anticipated rebuilding of bone mass to near-normal within 1 year."},{"label":"C","text":"Swimming will help build bone mass."},{"label":"D","text":"Bisphosphonates would reduce the risk of hip fracture by 30%-50%. STROKE"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"bb016233fb03f1a0c0789a69f6f429ad4d1c666d"},{"id":"q-51607568a10e","stem":"1 A previously healthy 75-year-old man experienced a TIA 2 weeks ago. On physical examination, he is found to have a right carotid bruit. Duplex ultrasound demonstrates a 75% stenosis of the right carotid artery. Which of the following is the best therapy?","type":"Radiological Interpretation","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"Aspirin plus clopidogrel"},{"label":"B","text":"Warfarin (Coumadin)"},{"label":"C","text":"Carotid endarterectomy"},{"label":"D","text":"Carotid artery stenting"}],"priority":1,"status":"review","flags":["requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-3ba2af82764c","stem":"2 One year ago, a 24-year-old woman had an episode of diplopia of 2 weeks’ duration. The symptoms resolved completely. Currently, she complains of left arm weakness but no headache. Which of the following is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Recurrent transient ischemic attacks"},{"label":"B","text":"Subarachnoid hemorrhage"},{"label":"C","text":"Complicated migraine"},{"label":"D","text":"Multiple sclerosis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"ce21165588e300cbc4e56ca68f3e2b71d46bd6a1"},{"id":"q-8d0899453ebc","stem":"3 A 67-year-old woman with extensive atherosclerotic cerebrovascular disease complains of dizziness and vertigo. Which of the following arteries is most likely to be affected?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Vertebrobasilar"},{"label":"B","text":"Carotid"},{"label":"C","text":"Aorta"},{"label":"D","text":"Middle cerebral"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8eeb9e7eeb5b","stem":"4 A 62-year-old man who works at an automobile assembly line has noticed that he feels pain, fatigue, and numbness in his right arm while working for the last several months. This morning at work, he noticed vertigo, then lightheadedness, then lost consciousness for a few seconds. The blood pressure in his right arm is 30 mm H g lower than that in his left arm. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Left middle cerebral artery stroke"},{"label":"B","text":"Lacunar infarction involving right internal capsule"},{"label":"C","text":"Stenosis of right subclavian artery due to atherosclerosis"},{"label":"D","text":"Multiple sclerosis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"e2b8e46ff06472be78a44471483b45619d56d3c8"},{"id":"q-c15ee8db782a","stem":"1 A 78-year-old woman is diagnosed with early Alzheimer disease. Which of the following agents is most likely to help with the cognitive function?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"H aloperidol"},{"label":"B","text":"Estrogen replacement therapy"},{"label":"C","text":"Donepezil"},{"label":"D","text":"H igh-dose vitamin B12 injections"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d5cc1352672e","stem":"2 A 74-year-old man was noted to have excellent cognitive and motor skill 12 months ago. H is wife noted that 6 months ago his function deteriorated noticeably, and 2 months ago another level of deterioration was noted. Which of the following is most likely to reveal the etiology of his functional decline?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"H IV antibody test"},{"label":"B","text":"Magnetic resonance imaging of the brain"},{"label":"C","text":"Cerebrospinal fluid (CSF) Venereal Disease Research Laboratory (VDRL) test"},{"label":"D","text":"Serum thyroid-stimulating hormone"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"380b16510ce44fa349f496dd9b6053565a65d477"},{"id":"q-cb10b3510870","stem":"3 A 55-year-old man is noted by his family members to be forgetful and become disoriented. H e has difficulty making it to the bathroom in time and complains of feeling as though “he is walking like he was drunk.” Which of the following therapies is most likely to improve his condition?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Intravenous penicillin for 21 days"},{"label":"B","text":"Rivastigmine"},{"label":"C","text":"Treatment with fluoxetine for 9 to 12 months"},{"label":"D","text":"Ventriculoperitoneal shunt"},{"label":"E","text":"Enrollment into Alcoholics Anonymous"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6596e61271dd","stem":"4 Which of the following are commonly seen in brain imaging of patients with Alzheimer disease?","type":"Single Best Answer MCQ","subject":"Radiography and Medical Imaging","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Chronic subdural hematoma"},{"label":"B","text":"Cortical atrophy with atrophy of medial temporal structures"},{"label":"C","text":"Ventriculomegaly without cortical atrophy"},{"label":"D","text":"Normal cerebral ventricles and normal brain tissue, acetylcholine deficiency"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Radiography and Medical Imaging","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"c90ec470db200ad2d91b3468293917f1bdee89d0"},{"id":"q-4b1623aed366","stem":"1 A young woman presents to your office complaining of dizziness. When asked to describe the feeling, she gives a vague story of just feeling like “her head is too big” and she “feels like is not really here.” The feeling is associated with palpitations, sweating, and nervousness and typically resolves in less than an hour. Her examination, including neurologic evaluation, is completely normal. Which of the following is the best next step?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Magnetic resonance imaging (MRI) brain scan."},{"label":"B","text":"Obtaining a thorough psychosocial history."},{"label":"C","text":"Dix-H allpike maneuver."},{"label":"D","text":"Prescribe meclizine."},{"label":"E","text":"Referral to neurology department."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4cbea7bba65d","stem":"2 A 75-year-old man presents to the emergency room with the sudden onset of nausea and vomiting. H is medical history is notable for coronary artery disease and well-controlled hypertension. On examination he refuses to open his eyes or move his head, but when finally coaxed to sit up, he immediately starts to retch and vomit. Rotational nystagmus is noted. H e cannot walk because of the dizziness and nausea that walking evokes. H is noncontrast brain computed tomography (CT ) scan is read as normal for age. Which of the following is the best next step?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"MRI/ magnetic resonance angiography (MRA)."},{"label":"B","text":"Obtain a thorough psychosocial history."},{"label":"C","text":"Dix-H allpike maneuver."},{"label":"D","text":"Prescribe meclizine."},{"label":"E","text":"Referral to neurology."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-cfba6cac420c","stem":"3 A 65-year-old woman with a history of benign positional vertigo returns to your office for follow-up. Although manageable, the symptoms of vertigo continue to recur periodically. Between episodes she generally feels normal but occasionally somewhat “off-balance.” Today, her neurologic examination is completely normal, except that the thresholds of both air and bone conduction of a vibrating 256-H z tuning fork are elevated on the left side. Which of the following is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"Intermittent benign positional vertigo"},{"label":"B","text":"Otosclerosis"},{"label":"C","text":"Acoustic neuroma"},{"label":"D","text":"Acute basilar artery infarct"},{"label":"E","text":"Panic disorder"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"813971383524b6930675efccb2dcb3012f0fbc7d"},{"id":"q-c196c4c405b1","stem":"4 Which of the following is the best next step for the patient described in Question 39.3?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Prescription for a selective serotonin reuptake inhibitor"},{"label":"B","text":"Referral for a hearing aid"},{"label":"C","text":"Lumbar puncture and serology for syphilis"},{"label":"D","text":"Referral for an MRI"},{"label":"E","text":"Reassurance ANAPHYLAXIS"}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-45a839eaa294","stem":"1 A 55-year-old accountant complains of facial and tongue swelling. H e recently started using a new bath soap. H is medical problems include osteoarthritis and hypertension, for which he takes acetaminophen and lisinopril, respectively. Which of the following is the most likely etiology?","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Cardiology","topicOriginal":"Cardiology","subtopic":"Hypertension","suggestedTopic":null,"options":[{"label":"A","text":"Lisinopril"},{"label":"B","text":"Soap hypersensitivity"},{"label":"C","text":"H ypothyroidism"},{"label":"D","text":"Acetaminophen"},{"label":"E","text":"Food-related allergy"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Cardiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"b9fd225a7a8bc20f2059c30687671e88c2b4ed8e"},{"id":"q-7905aa5aab22","stem":"2 An 18-year-old man with epilepsy controlled with medication develops fever,lymphadenopathy, a generalized maculopapular rash, elevated transaminases, and arthralgias. H e notes having been bitten by ticks while working in the yard outside. Which of the following is the most likely etiology?","type":"Single Best Answer MCQ","subject":"Dermatology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Severe poisonivy dermatitis"},{"label":"B","text":"Reaction to anticonvulsant medication"},{"label":"C","text":"Acute human immunodeficiency virus (H IV) infection"},{"label":"D","text":"Lyme disease"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Dermatology","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2a5662e480d1","stem":"3 A 34-year-old man is brought into the emergency room for a severe allergic reaction caused by fire ant bites. H e is treated with intramuscular epinephrine and intravenous corticosteroids. H is oxygen saturation falls to 80%, and he becomes apneic. Which of the following is the best next step?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Intravenous diphenhydramine"},{"label":"B","text":"Intravenous epinephrine"},{"label":"C","text":"Oxygen by nasal cannula"},{"label":"D","text":"Endotracheal intubation"},{"label":"E","text":"Electrical cardioversion"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"fb62f77a7f59c8a347667b85cf06ab96b7af8964"},{"id":"q-dc8b60b814f4","stem":"4 A 57-year-old woman with congestive heart failure (CH F) has a positive cardiac stress test. Cardiac catheterization is required to evaluate for coronary bypass grafting. She states that she has an allergy to iodine. Which of the following is the best next step?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Desensitization with increasing doses of oral iodine"},{"label":"B","text":"Infusion of diphenhydramine during the procedure"},{"label":"C","text":"Cancel the procedure and proceed to surgery"},{"label":"D","text":"Diphenhydramine and corticosteroids the night before the procedure SEPSIS"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d6ff14178642","stem":"1 Which of the following asymptomatic patients would most benefit from treatment of the finding of more than 105 CFU/ mL of Escherichia coli on urine culture?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A 23-year-old asymptomatic sexually active woman"},{"label":"B","text":"A 33-year-old asymptomatic pregnant woman"},{"label":"C","text":"A 53-year-old asymptomatic diabetic woman"},{"label":"D","text":"A 73-year-old asymptomatic woman in a nursing home"}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"f8c9f6f4fcb9d0950dea693dd24c9eae73298298"},{"id":"q-6083a7d98d3e","stem":"2 Which of the following is the best treatment for a 39- year-old woman with fever of 103°F, nausea, flank pain, and more than 105 CFU/ mL of E coli in a urine culture?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Oral trimethoprim-sulfamethoxazole for 3 days"},{"label":"B","text":"Single-dose ciprofloxacin"},{"label":"C","text":"Intravenous and then oral levofloxacin for 14 days"},{"label":"D","text":"Oral ampicillin for 21 to 28 days"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-82de269b151d","stem":"3 A 57-year-old man is noted to have a blood pressure of 68/ 50 mm H g, heart rate of 140 bpm, elevated jugular venous pressure, inspiratory crackles on examination, and cold clammy extremities. Which of the following is the most likely etiology?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Septic shock"},{"label":"B","text":"Adrenal crisis"},{"label":"C","text":"Cardiogenic shock"},{"label":"D","text":"H ypovolemic shock"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b710cef8d8a3","stem":"4 A 45-year-old man is noted to have a blood pressure of 80/ 40 mm H g, heart rate of 142 bpm, and fever of 102°F. H is abdomen is tender, particularly in the right lower quadrant, and acute appendicitis is diagnosed. Three liters of 0.9% saline are infused and intravenous antibiotics are administered as he is prepared for surgery. H is blood pressure falls to 70/ 42 mm H g. Which of the following is the most appropriate next step?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Administer a beta-blocker to control his heart rate."},{"label":"B","text":"Check a cortisol level and administer corticosteroids."},{"label":"C","text":"Infuse fresh frozen plasma (FFP)."},{"label":"D","text":"Initiate norepinephrine intravenous infusion."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"],"duplicateStemGroup":"174533328672e2c66026d33bc0225dd97c12610e"},{"id":"q-cd9e048768a0","stem":"1 Which of the following infectious agents is the most likely etiology associated with an infected central venous catheter?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Streptococcus pyogenes"},{"label":"B","text":"Pseudomonas aeruginosa"},{"label":"C","text":"Coagulase-negative Staphylococcus"},{"label":"D","text":"Klebsiella pneumoniae"},{"label":"E","text":"Candida albicans"}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-4a48397089a7","stem":"2 A 32-year-old man with acute myelogenous leukemia is undergoing chemotherapy. H e was hospitalized 7 days ago for fever to 102°F with an absolute neutrophil count of 100 cells/ mm3, and he has been placed on intravenous imipenem and vancomycin. He continues to have fever to 103°F without an obvious source. Which of the following is the best next step?","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Perform lumbar puncture to assess cerebrospinal fluid."},{"label":"B","text":"Continue present therapy."},{"label":"C","text":"Stop all antibiotics because he likely has drug fever."},{"label":"D","text":"Add an aminoglycoside antibiotic."},{"label":"E","text":"Add an antifungal agent."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem"],"cleaningOperations":["whitespace/page_marker_normalization"],"duplicateStemGroup":"e8ff37f4f83486c9d9c61390a5aaba705aa74ac4"},{"id":"q-d2896b959c19","stem":"3 A 68-year-old woman is diagnosed with acute leukemia and is undergoing induction of chemotherapy. Last cycle, she developed neutropenia with an absolute neutrophil count of 350 cells/ mm3, which has now resolved. Whichof the following is appropriate therapy?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Immunization against varicella"},{"label":"B","text":"Immunization against mumps"},{"label":"C","text":"Use of recombinant erythropoietin before the next cycle of chemotherapy"},{"label":"D","text":"Use of G-CSF after the next cycle of chemotherapy"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6eaaae74a039","stem":"1 An 18-year-old with a 1-week history of fever, headache, increasing confusion, and lethargy presents to the emergency room. H is physical examination is normal, and he has no focal neurologic signs. The CT scan of his head is negative. An LP reveals a W BC count of 250/ mm3, with 78% lymphocytes and RBCs 500/ mm3 in tube 1 and 630/ mm3 in tube 2, respectively. No organisms are seen on Gram stain. Which of the following is the best next step?","type":"Radiological Interpretation","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Intravenous ceftriaxone, acyclovir, and vancomycin"},{"label":"B","text":"Intravenous fluconazole"},{"label":"C","text":"Intravenous azithromycin"},{"label":"D","text":"Careful observation with no antibiotics"}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","repeated_question_stem","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":["whitespace/page_marker_normalization"],"duplicateStemGroup":"07d948363e3306b3bc4de0048e9cd9554ad24816"},{"id":"q-6c68436b085b","stem":"2 A 55-year-old man with a long history of alcohol abuse presents with a 3-week history of progressive confusion and stupor. On examination he is afebrile, but he has a new right sixth cranial nerve palsy and tremulousness of all four extremities. H is CSF has 250 W BCs/ mm3, with 68% lymphocytes. There are 300 RBCs/ mm3. Protein levels are high, and the ratio of CSF to serum glucose is very low. He is started on ceftriaxone, vancomycin, and acyclovir. A purified protein derivative (PPD) placed on admission is positive, and bacterial cultures are negative at 48 hours. Which of the following would help to confirm the diagnosis?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"Gram stain of throat scrapings"},{"label":"B","text":"CT of the head with contrast"},{"label":"C","text":"MRI of the head"},{"label":"D","text":"Repeat LP after 48 hours of therapy"},{"label":"E","text":"H erpes simplex virus PCR"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-02f93af92972","stem":"3 A 65-year-old man with colon cancer on chemotherapy presents with a fever and headache of 3- day duration. An LP is performed, and Gram stain reveals gram-positive rods.Which of the following therapies is most likely to treat the organism?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Vancomycin"},{"label":"B","text":"Metronidazole"},{"label":"C","text":"Ampicillin"},{"label":"D","text":"Gentamicin"},{"label":"E","text":"Ceftriaxone"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e791f5af9db2","stem":"1 A 42-year-old woman from Pakistan is being treated with infliximab for rheumatoid arthritis. After 6 months of therapy, she develops persistent fever, weight loss, and night sweats, and tuberculosis is suspected. Which of the following is the most likely location of the tuberculosis?","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Respiratory Medicine","topicOriginal":"Respiratory Medicine","subtopic":"Tuberculosis","suggestedTopic":null,"options":[{"label":"A","text":"Middle and lower lung zones"},{"label":"B","text":"Pleural space"},{"label":"C","text":"Apical segment of the upper lung lobes"},{"label":"D","text":"Cervical or supraclavicular lymph nodes"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Respiratory Medicine","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-45a89465fdd4","stem":"2 A 24-year-old man has been treated with isoniazid, rifampin, and pyrazinamide for active pulmonary tuberculosis. After 3 months, he states that he is having numbness and tingling of both feet but no back pain. H e denies taking other medications. Which of the following is the most appropriate next step?","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Respiratory Medicine","topicOriginal":"Respiratory Medicine","subtopic":"Tuberculosis","suggestedTopic":null,"options":[{"label":"A","text":"Computed tomography (CT ) scan of the lumbar spine."},{"label":"B","text":"Initiate pyridoxine."},{"label":"C","text":"Continue the tuberculosis agents and monitor for further neurologic problems."},{"label":"D","text":"Initiate a workup for tuberculosis adenopathy compression on the femoral nerve"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Respiratory Medicine","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":["whitespace/page_marker_normalization"],"duplicateStemGroup":"8ffdd9070cff060747b950fca0e82e74166b2362"},{"id":"q-e4ba8625cefe","stem":"3 A 25-year-old woman is seen in the clinic because her father, who recently immigrated from South America, was diagnosed with and has been treated for tuberculosis. She denies a cough and her chest radiograph is normal. A PPD test shows 10 mm of induration. H er only medication is an oral contraceptive. Which of the following is the best next step?","type":"Radiological Interpretation","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Isoniazid."},{"label":"B","text":"Combination therapy including isoniazid, rifampin, and pyrazinamide."},{"label":"C","text":"Observation."},{"label":"D","text":"Induce three sputum samples."}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-5a232fde293b","stem":"4 Which of the following tests are the most important to follow for a patient receiving isoniazid and rifampin for tuberculosis treatment?","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Respiratory Medicine","topicOriginal":"Respiratory Medicine","subtopic":"Tuberculosis","suggestedTopic":null,"options":[{"label":"A","text":"Renal function tests"},{"label":"B","text":"Liver function tests"},{"label":"C","text":"Slit-lamp examinations"},{"label":"D","text":"Amylase and lipase tests"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Respiratory Medicine","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"86a80471fc1624e48d3392afc3b8845ea72abe51"},{"id":"q-e1724fd43949","stem":"1 A 25-year-old man presents to your office complaining of left knee and right great toe pain, which started 1 week ago and has not responded to over the counter pain relievers. He also has felt feverish and achy, has dysuria, and has developed an eye infection. Approximately 1 month ago, he was seen at an outside clinic and treated for syphilis. On examination, he is afebrile, and both eyes are injected and very sensitive to light. H is left knee and the metatarsophalangeal (MTP) joint of his right great toe are swollen and tender. Which of the following is your diagnosis?","type":"Single Best Answer MCQ","subject":"Ophthalmology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Gouty arthritis"},{"label":"B","text":"Reactive arthritis (Reiter syndrome)"},{"label":"C","text":"Infectious arthritis"},{"label":"D","text":"Rheumatoid arthritis"},{"label":"E","text":"Syphilis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Ophthalmology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-403b2791fcc8","stem":"2 As part of normal screening during pregnancy, a 28- year-old G2P1 has a positive RPR with a titer of 1 :64 and a positive MH A-TP. She is allergic to penicillin, which causes shortness of breath and “swelling of her tongue.” Which of the following treatments do you offer?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Erythromycin estolate."},{"label":"B","text":"Doxycycline."},{"label":"C","text":"Tetracycline."},{"label":"D","text":"Penicillin after desensitization."},{"label":"E","text":"Vancomycin."},{"label":"F","text":"Wait until delivery of the baby before treatment"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"6c6698a9840e1a92959d111f0626584edab42e84"},{"id":"q-4e0615281d79","stem":"3 A 23-year-old man is found to have late latent syphilis (RPR 1 :64) as part of a workup following his diagnosis with H IV. H e is asymptomatic with a CD4 count of 150 and does not remember having lesions or rashes in the past. Prior to starting therapy with penicillin for the syphilis, the patient should undergo which of the following procedures?","type":"Single Best Answer MCQ","subject":"Dermatology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Lumbar puncture to exclude neurosyphilis"},{"label":"B","text":"Skin biopsy to confirm the diagnosis of syphilis"},{"label":"C","text":"Magnetic resonance imaging (MRI) of his brain and an electroencephalogram (EEG)"},{"label":"D","text":"Skin testing to exclude penicillin allergy"},{"label":"E","text":"Adjustment of his H IV medications to optimize his CD4 count prior to treatment for syphilis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Dermatology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"be8e32768baadacd6b391e83ae9ac7c52485c6fb"},{"id":"q-31e3e6d2e832","stem":"4 A 28-year-old woman is noted to have a nontender ulcer of the vulva. A herpes culture is taken of the ulcer scraping, which is negative, and the RPR titer is negative. Which of the following is the next best step?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Empiric treatment with doxycycline for Chlamydia trachomatis"},{"label":"B","text":"Empiric treatment with acyclovir for herpes simplex virus (H SV)"},{"label":"C","text":"Empiric treatment with azithromycin for Haemophilus ducreyi"},{"label":"D","text":"Dark-field microscopy"},{"label":"E","text":"Biopsy for possible vulvar cancer"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-de7e821eb952","stem":"1 A 32-year-old woman with a 5-year history of H IV infection is noted to have a CD4 count of 100 cells/ mm3. She is admitted to the hospital with a 2-week history of fever, shortness of breath, and a dry cough. Which of the following diagnostic tests would most likely confirm the diagnosis?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Silver stain or DFA of the sputum"},{"label":"B","text":"Gram stain of the sputum showing gram-positive diplococci"},{"label":"C","text":"Acid-fast smear of the sputum"},{"label":"D","text":"Serum cryptococcal antigen"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"c83a5f19f917f15fe0cc8a8f9c993ea4abcfdf25"},{"id":"q-69b4b9669d98","stem":"2 Which of the following is the most likely organism to cause a lobar pneumonia in a patient with AIDS?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"P jirovecii"},{"label":"B","text":"M tuberculosis"},{"label":"C","text":"Histoplasmosis capsulatum"},{"label":"D","text":"S pneumoniae"}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-9c8edccd52bf","stem":"3 A 44-year-old woman infected with H IV is noted to have a CD4 count of 180 cells/ mm3. Which of the following is recommended as a useful prophylactic agent in this patient at this point?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Fluconazole"},{"label":"B","text":"Azithromycin"},{"label":"C","text":"Trimethoprim-sulfamethoxazole"},{"label":"D","text":"Ganciclovir"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-81fb9015e32d","stem":"4 A 36-year-old woman with H IV is admitted with new-onset seizures. The CT scan of the head reveals multiple ring-enhancing lesions of the brain. Which of the following is the best therapy for the likely condition?","type":"Radiological Interpretation","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Rifampin, isoniazid, ethambutol"},{"label":"B","text":"Ganciclovir"},{"label":"C","text":"Penicillin"},{"label":"D","text":"Sulfadiazine with pyrimethamine ELECTRO AND ENDOCRINE"}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","repeated_question_stem","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"2f9d5dab8630770cfa67f288fe7e922b4c8f53ba"},{"id":"q-b1f4c08bdbc6","stem":"1 A 24-year-old man develops seizures following an emergent splenectomy after a car accident. H is serum sodium level is initially 116 mEq/ L and is corrected to 120 mEq/ L over the next 3 hours with hypertonic saline. Which of the following factors most likely led to his hyponatremia?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Elevation of serum vasopressin"},{"label":"B","text":"Administration of hypertonic solutions"},{"label":"C","text":"Volume depletion"},{"label":"D","text":"Seizure-induced hyponatremia"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f16f1eebc7dc","stem":"7 mEq/ L, creatinine level is normal, and bicarbonate and chloride levels are low. Which of the following is the likely cause of his hyponatremia given his presentation?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"SIADH"},{"label":"B","text":"H ypothyroidism"},{"label":"C","text":"Gastrointestinal losses"},{"label":"D","text":"Adrenal insufficiency"},{"label":"E","text":"Renal insufficiency"}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-bec2ab359871","stem":"3 An 83-year-old woman comes to your clinic complaining of a headache and mild confusion. H er medical history is remarkable only for hypertension, which is well controlled with hydrochlorothiazide. H er examination and laboratory tests show no signs of infection, but her serum sodium level is 119 mEq/ L, and plasma osmolarity is 245 mOsm/ kg. She appears to be clinically hypovolemic. Which of the following is the best initial therapy?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Fluid restriction"},{"label":"B","text":"Infusion of 0.9% saline"},{"label":"C","text":"Infusion of 3% saline"},{"label":"D","text":"Infusion of 3% saline with furosemide"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"a19dff3276c5fb4f8b188174df54dbce0e1da926"},{"id":"q-63070fc6403b","stem":"4 A 58-year-old man has undergone a lengthy colon cancer surgery. On the first postoperative day, he is noted to have significant hyponatremia with a sodium level of 128 mEq/ L. You suspect that the hyponatremia is due to the intravenous infusion of hypotonic solution. Which of the following laboratory findings supports your diagnosis?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Urine sodium > 20 mmol/ L"},{"label":"B","text":"Urine osmolality > 200 mOsm/ L"},{"label":"C","text":"Serum osmolarity < 280 mOsm/ kg"},{"label":"D","text":"Serum potassium > 5 mEq/ L"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f75246a5354d","stem":"1 A 42-year-old woman presents to your clinic for her annual physical examination. On examination, you note neck fullness. When you palpate her thyroid, it is enlarged, smooth, rubbery, and nontender. The patient is asymptomatic. You send her for thyroid function testing: her T 4, free T 4, and T 3 are normal, but her TSH is slightly elevated. Which of the following is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Iodine deficiency"},{"label":"B","text":"Thyroid cancer"},{"label":"C","text":"H ashimoto thyroiditis"},{"label":"D","text":"Graves disease"},{"label":"E","text":"Multinodular goiter"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"937640d1bfeab2b3aab19e9f6622d5f613b3a77f"},{"id":"q-416f331cb00d","stem":"3 A 19-year-old gymnast active in national competition is brought to your clinic by her mother because the daughter’s menses have ceased for the last 3 months. Prior to this, she was always regular. She denies excess dieting, although she does work out with her team 3 hours daily. H er physical examination is normal except for her body mass index (BMI) of 20 kg/ m2. Which of the following laboratory tests should be ordered first?","type":"Single Best Answer MCQ","subject":"Nutrition and Dietetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Thyroid function tests"},{"label":"B","text":"Complete blood count"},{"label":"C","text":"Luteinizing hormone (LH )/ follicle-stimulating hormone (FSH )"},{"label":"D","text":"Prolactin"},{"label":"E","text":"Beta-Hcg"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Nutrition and Dietetics","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"73a459ce37105cf7a49a07c5a51c293ba51ee303"},{"id":"q-51025058425c","stem":"4 A 35-year-old woman who was diagnosed with hypothyroidism 4 weeks ago presents to your clinic complaining of persistent feelings of fatigue and sluggishness. After confirming your diagnosis with a measurement of the TSH , you started her on levothyroxine 50 μg daily. She has been reading about her diagnosis on the Internet and wants to try desiccated thyroid extract instead of the medicine you gave her. On examination, she weighs 175 lb, her heart rate is 64 bpm at rest, and her blood pressure is normal. Which of the following is the best next step?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Tell her that this delay in resolution of symptoms is normal and schedule a follow-up visit with her in 2 months."},{"label":"B","text":"Change her medication, as requested, to thyroid extract and titrate."},{"label":"C","text":"Increase her dose of levothyroxine and have her come back in 4 weeks."},{"label":"D","text":"Tell her to start a multivitamin with iron to take with her levothyroxine."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","whitespace/page_marker_normalization"],"duplicateStemGroup":"5ed8816e420699599412d7e4558314816e24df38"},{"id":"q-20be9f71770d","stem":"1 Which of the following is the most common cause of secondary adrenal insufficiency?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Autoimmune process"},{"label":"B","text":"Surgical excision"},{"label":"C","text":"Hemorrhagic shock"},{"label":"D","text":"Exogenous corticosteroids"},{"label":"E","text":"ACTH failure due to panhypopituitarism"}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-4f1290d9e54a","stem":"2 A 30-year-old woman takes prednisone 15 mg/ d for systemic lupus erythematosus. She is admitted to the hospital for a cholecystectomy. Which of the following is the most important intervention for her?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"H ydrocortisone intravenously before surgery and every 6 hours for 24 hours."},{"label":"B","text":"Double the prednisone the night before and hold her steroids the day of the surgery."},{"label":"C","text":"Use of cyclophosphamide in lieu of corticosteroids for 2 weeks following surgery to promote wound healing."},{"label":"D","text":"Cancel the surgery and use lithotripsy to break up the stones"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"eb04f52901f1ea8895726756ffb8157f371413a3"},{"id":"q-db7b6e6d9387","stem":"3 A 30-year-old woman who is 12 weeks’ postpartum is noted to have adrenal insufficiency and a very distinct tan, although she hardly ventures outside. Which of the following is the most likely etiology?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Long-term steroid use"},{"label":"B","text":"Sheehan syndrome (pituitary insufficiency)"},{"label":"C","text":"Brain tumor"},{"label":"D","text":"Autoimmune adrenal destruction"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-86ba077e8d43","stem":"4 What is the best diagnostic test for a patient with suspected Cushing syndrome (ACTH -producing adenoma)?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Random cortisol level"},{"label":"B","text":"ACTH -stimulation test"},{"label":"C","text":"Overnight 1-mg dexamethasone suppression test"},{"label":"D","text":"Pituitary MRI"}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-2916db7061c5","stem":"0- 4.5 mg/ dL). She is not anemic and has no symptoms. Her medical history is significant for osteoporosis, discovered on a dual-energy x-ray absorptiometry (DEXA) scan performed last year. Which of the following is the most likely cause of her hypercalcemia?","type":"Radiological Interpretation","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Multiple myeloma"},{"label":"B","text":"Parathyroid adenoma"},{"label":"C","text":"Familial hypocalciuric hypercalcemia"},{"label":"D","text":"Sarcoidosis"},{"label":"E","text":"Undiagnosed breast cancer"}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","repeated_question_stem","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":["whitespace/page_marker_normalization"],"duplicateStemGroup":"e06e043b8fa39c1d08fe4586343630650e683b83"},{"id":"q-4986b9ca3dce","stem":"2 A 62-year-old asymptomatic woman is noted to have multiple myeloma and hypercalcemia, but no bone lesions or end-organ damage. Which of the following therapies is useful for immediate treatment of the hypercalcemia?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"Bisphosphonates."},{"label":"B","text":"Erythropoietin."},{"label":"C","text":"Dexamethasone plus thalidomide."},{"label":"D","text":"Interferon-alpha."},{"label":"E","text":"Observe without treatment since she is asymptomatic."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-6a37d7cda56a","stem":"3 A 22-year-old African-American woman presents with worsening cough over 6 weeks, which did not improve with a course of antibiotics or antitussives. Her serum calcium level is found to be 12.5 mg/ dL, and a chest x-ray reveals bilateral hilar lymphadenopathy. She has erythema nodosum on her legs. Which of the following is the most likely diagnosis?","type":"Radiological Interpretation","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Sarcoidosis"},{"label":"B","text":"Mycoplasma pneumonia"},{"label":"C","text":"Acute lymphoblastic leukemia"},{"label":"D","text":"Squamous cell carcinoma of the lung"},{"label":"E","text":"Pulmonary embolism"}],"priority":1,"status":"review","flags":["requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","repeated_question_stem","requires_visual_review","visual_asset_not_transcribed"],"cleaningOperations":["whitespace/page_marker_normalization"],"duplicateStemGroup":"95d2cf4bd2b4eb3c890a263ad776ad22f55f1adf"},{"id":"q-6ebb0c352c30","stem":"4 A 66-year-old man with known metastatic squamous cell carcinoma of the esophagus is brought to the emergency room for increasing lethargy and confusion. H e is clinically dehydrated, his serum calcium level is 14 mg/ dL, and his creatinine level is 2.5 mg/ dL but 1 month ago it was 0.9 mg/ dL. Which therapy for his hypercalcemia should be instituted first?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Intravenous bisphosphonate"},{"label":"B","text":"Intravenous furosemide"},{"label":"C","text":"Glucocorticoids"},{"label":"D","text":"Intravenous normal saline"},{"label":"E","text":"Chemotherapy for squamous cell carcinoma"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"50b5921a31ba737faa36934a3866e298bb50b095"},{"id":"q-6a8e32fd33f7","stem":"1 A patient comes in for a fasting plasma glucose test. On two separate occasions, the result has been 115 mg/ dL and 120 mg/ dL. Which of the following is the most appropriate next step?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Reassurance that these are normal blood sugars."},{"label":"B","text":"Recommend weight loss, an ADA diet, and exercise."},{"label":"C","text":"Diagnose diabetes mellitus and start on a sulfonylurea."},{"label":"D","text":"Recommend cardiac stress testing."},{"label":"E","text":"Obtain stat arterial blood gas and serum ketone levels."}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-230eb8bb36b3","stem":"2 A 45-year-old obese Hispanic woman presents for follow-up of her diabetes. She currently takes metformin 1000 mg twice per day, and her fasting morning glucose runs approximately 170 to 200 mg/ dL. H er last H bA1C was 7.9. She states that she conscientiously follows her diet and that she walks 30 minutes to 1 hour daily. Which of the following is the best next step in her care?","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"Diabet","suggestedTopic":null,"options":[{"label":"A","text":"Refer to an endocrinologist for an insulin pump."},{"label":"B","text":"Stop metformin and start on glimepiride."},{"label":"C","text":"Add once-a-day injection of insulin glargine (Lantus)."},{"label":"D","text":"H ospitalize her urgently."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Endocrinology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"8f0c303b5733c3a63f3d2ff954861e41155ab971"},{"id":"q-36e367cf0f5f","stem":"3 A 75-year-old woman with diabetes for approximately 20 years, diabetic retinopathy, and diabetic nephropathy with creatinine level 2.2 mg/ dL is brought into the clinic by her daughter for follow-up. The patient currently takes a sulfonylurea for her diabetes and an ACE inhibitor for her proteinuria. H er daughter reports that, on three occasions in the past 2 weeks, her mother became sweaty, shaky, and confused, which resolved when she was given some orange juice. Which of the following conditions is most likely to be contributing to these episodes?","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"Diabet","suggestedTopic":null,"options":[{"label":"A","text":"Excess caloric oral intake"},{"label":"B","text":"Interaction between the ACE inhibitor and the sulfonylurea agents"},{"label":"C","text":"Worsening renal function"},{"label":"D","text":"H yperglycemic amnesia"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Endocrinology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-6ac19f53431b","stem":"4 A 42-year-old woman who developed gestational diabetes with her last pregnancy which was 10 years ago, is being screened for type 2 diabetes. Which of the following screening methods has the highest sensitivity?","type":"OSCE / Practical Station","subject":"Internal Medicine","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"Diabet","suggestedTopic":null,"options":[{"label":"A","text":"Fasting serum glucose"},{"label":"B","text":"2-H our glucose tolerance test"},{"label":"C","text":"Hemoglobin A1C"},{"label":"D","text":"Random glucose"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Endocrinology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"9e5121ecc6b279f5f495f11b2b368810d3dc1a61"},{"id":"q-59abfe92798d","stem":"5 A 36-year-old man has been recently diagnosed with type 2 diabetes. If not vaccinated previously, which of the following immunizations is most important to administer?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Pneumococcal"},{"label":"B","text":"Human papilloma virus"},{"label":"C","text":"Hepatitis B"},{"label":"D","text":"Rubella"},{"label":"E","text":"Toxoplasmosis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1cf1a8e36e5f","stem":"1 Which of the following most likely will lead to a nonanion gap acidosis?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Diarrhea"},{"label":"B","text":"Lactic acidosis"},{"label":"C","text":"Diabetic ketoacidosis"},{"label":"D","text":"Ethylene glycol ingestions"}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-a12bcce139d0","stem":"2 An 18-year-old man is noted to be in diabetic ketoacidosis with pH 7.20 and serum glucose level 400 mg/ dL. Which of the following is the most accurate statement regarding this patient’s potassium status?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Likely to have a potassium level less than 3 mEq/ L."},{"label":"B","text":"Likely to have a potassium level more than 5 mEq/ L."},{"label":"C","text":"Likely to have a total body potassium deficit regardless of the serum level."},{"label":"D","text":"Serum level is likely to increase with correction of the acidosis."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"1c9122e69142160af27ddfd4590b214a9f728928"},{"id":"q-d16d9488c455","stem":"3 Which of the following is the most important first step in the treatment of diabetic ketoacidosis?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Replacement of potassium"},{"label":"B","text":"Intravenous fluid replacement"},{"label":"C","text":"Replacement of phosphorus"},{"label":"D","text":"Antibiotic therapy"}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-02d00ca67778","stem":"4 A 59-year-old man with a long history of diabetes with chronic renal insufficiency due to diabetic nephropathy is seen in clinic for routine laboratory work. H e is asymptomatic, but his glucose is elevated at 258 mg/ dL, and his other chemistries are as follows: sodium 135 mEq/ L, potassium 5.4 mEq/ L, chloride 108 mEq/ L, and bicarbonate 18 mEq/ L. H is creatinine is stable at 2.1 mg/ dL. What is the most likely cause of his acidosis?","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"Diabet","suggestedTopic":null,"options":[{"label":"A","text":"Diabetic ketoacidosis"},{"label":"B","text":"Lactic acidosis"},{"label":"C","text":"Type 4 renal tubular acidosis"},{"label":"D","text":"Accidental salicylate overdose."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Endocrinology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"6b01d47a8907ea6ca1134de1f68e68219077729e"},{"id":"q-be2c01703df9","stem":"1 A 44-year-old woman is noted to be nervous and has heat intolerance. H er thyroid gland is diffusely enlarged, nontender, with an audible bruit. H er TSH level is very low. Which of the following is the most likely etiology?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"Lymphocytic thyroiditis"},{"label":"B","text":"H ashimoto thyroiditis"},{"label":"C","text":"Graves disease"},{"label":"D","text":"Multinodular toxic goiter"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-fe84f13dddde","stem":"2 Which of the following distinguishes hyperthyroidism from thyroid storm?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Tachycardia to heart rate 120 bpm"},{"label":"B","text":"Weight loss"},{"label":"C","text":"Fever and delirium"},{"label":"D","text":"Large goiter"}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-ef1fd44deb0e","stem":"3 A 58-year-old woman is noted to have Graves disease and has a small goiter. Which of the following is the best therapy?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Long-term propranolol"},{"label":"B","text":"Lifelong oral propylthiouracil (PTU)"},{"label":"C","text":"Radioactive iodine ablation"},{"label":"D","text":"Surgical thyroidectomy HAEMATOLOGY"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"8cbe2c13cde0c8545abba106d3070b9b09729484"},{"id":"q-86b1a1d00255","stem":"1 A 25-year-old man with a history of a duodenal ulcer is noted to have a hemoglobin level of 10 g/ dL. H e does not report any visible GI blood loss. Which of the following most likely will be seen on laboratory investigation?","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Reticulocyte count of 4%"},{"label":"B","text":"Elevated total iron-binding capacity"},{"label":"C","text":"Normal serum ferritin"},{"label":"D","text":"Mean corpuscular volume of 105 Fl"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e69f954045f2","stem":"2 A 22-year-old woman is pregnant and at 14-week gestation. H er haemoglobin level is 9 g/ dL. She asks why she could have iron deficiency when she is no longer menstruating. Which of the following is the best explanation?","type":"OSCE / Practical Station","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Occult gastrointestinal blood loss"},{"label":"B","text":"Expanded blood volume and transport to the fetus"},{"label":"C","text":"Hemolysis"},{"label":"D","text":"Iron losses as a result of relative alkalosis of pregnancy"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"fb19ddfbf0a8af3321843a89469dbc1b432a1472"},{"id":"q-531d2f6f7438","stem":"3 A 35-year-old man has undertaken a strict fad diet for 3 months. H e previously had been healthy but now complains of fatigue. H is hemoglobin level is 10 g/ dL, and his MCV is 105 fL. Which of the following is the most likely etiology of his anemia?","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Iron deficiency"},{"label":"B","text":"Folate deficiency"},{"label":"C","text":"Vitamin B 12 deficiency"},{"label":"D","text":"Thalassemia"},{"label":"E","text":"Sideroblastic anemia"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-1c5f379c1fcc","stem":"1 A 32-year-old man is brought into the emergency room after a motor vehicle accident. He is noted to be in hypovolemic shock with a blood pressure of 60/ 40 mm H be transfused?","type":"Single Best Answer MCQ","subject":"Emergency Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"G","text":"He is actively bleeding from a femur fracture. The patient’s hemoglobin level is 7 g/ dL. H is wife is positive that the patient’s blood type is A positive. Which of the following is the most appropriate type of blood to"},{"label":"A","text":"Give AB-positive blood, uncross-matched."},{"label":"B","text":"Await cross-matched A-positive blood."},{"label":"C","text":"Give type-specific A-positive blood, uncross-matched."},{"label":"D","text":"Give O-negative blood, uncross-matched."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Emergency Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-20f6a52bdf92","stem":"2 A 45-year-old woman is noted to have severe menorrhagia over 6 months and a hemoglobin level of 6 g/ dL. She feels dizzy, weak, and fatigued. She receives 3 units of packed erythrocytes intravenously. Two hours into the transfusion, she develops fever to 103°F and shaking chills. Which of the following laboratory tests would most likely confirm an acute transfusion reaction?","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"LDH level"},{"label":"B","text":"Leukocyte count"},{"label":"C","text":"Direct bilirubin level"},{"label":"D","text":"Glucose level"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-82f2182ff363","stem":"3 A 57-year-old man has a prosthetic aortic valve for which he takes warfarin (Coumadin) 10 mg/ d. H e is noted to have an international normalized ratio (IN R) of 7 and is actively bleeding large clots from his gums, rectum, and when urinating. Which of the following is the best management for this patient?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Administer vitamin D."},{"label":"B","text":"Transfuse with fresh frozen plasma."},{"label":"C","text":"Administer IVIg."},{"label":"D","text":"Discontinue the warfarin (Coumadin) and observe."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"3c6957fe7a28b533a793e41161b8d147c0d242da"},{"id":"q-e323fb02064b","stem":"1 A 28-year-old woman complains of excessive bleeding from her gums and has petechiae. Her CBC shows a platelet count of 22,000/ mm3 with a hemoglobin of 8.9 g/ dL and a WBC count of 87,000/ mm3. Which of the following is the most likely etiology of her low platelet count?","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Immune thrombocytopenia purpura"},{"label":"B","text":"Systemic lupus erythematosus"},{"label":"C","text":"Drug-induced thrombocytopenia"},{"label":"D","text":"Acute leukemia"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-c79be73ee8e5","stem":"2 A 50-year-old man has been treated for rheumatoid arthritis for many years. He currently is taking corticosteroids for the disease. On examination, he has stigmata of rheumatoid arthritis and some fullness on his left upper abdomen. H is platelet count is slightly low at 105,000/ mm3. H is white blood cell count is 3100/ mm3 with neutropenia, and hemoglobin level is 9 g/ dL. Which of the following is the most likely etiology of the thrombocytopenia?","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Steroid induced"},{"label":"B","text":"Splenic sequestration"},{"label":"C","text":"Autoimmune destruction"},{"label":"D","text":"Prior gold therapy"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"dfb8cc82a006bcd10c13759b12867eea10ed64ba"},{"id":"q-0dc5d6b7fb28","stem":"3 A 30-year-old woman with ITP has been taking maximum corticosteroid doses and still has a platelet count of 20,000/ mm3 and frequent bleeding episodes. Which of the following should she receive before her splenectomy?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Washed leukocyte transfusion"},{"label":"B","text":"Intravenous interferon therapy"},{"label":"C","text":"Pneumococcal vaccine"},{"label":"D","text":"Bone marrow radiotherapy"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4d856cd1a479","stem":"4 A 65-year-old man who has a prosthetic heart valve is hospitalized for a knee replacement surgery, and placed on intravenous (IV) heparin for anticoagulation before the procedure. He drinks one glass of wine each weekend and has been diagnosed with osteoarthritis for which he takes acetaminophen. His platelet count was normal, but now is 32,000/ mm3. Which of the following is the most likely cause of the thrombocytopenia?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Prosthetic heart valve"},{"label":"B","text":"Alcohol intake"},{"label":"C","text":"Acetaminophen"},{"label":"D","text":"Heparin"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"ceb6b7c908b4cdcbcda4bd1a35f54b47ec7e70ce"},{"id":"q-1c167928d88e","stem":"1 A 25-year-old man presents with a 2-week history of low-grade fever, slight cough, malaise, and myalgias, and is noted on physical examination to have enlarged posterior cervical lymph nodes and significant splenomegaly. His CBC shows a lymphocytosis with ALC 10,000/ μL, normal haemoglobin level, and normal platelet count. The peripheral smear shows large atypical lymphocytes. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"ALL"},{"label":"B","text":"CLL"},{"label":"C","text":"Acute H IV infection"},{"label":"D","text":"EBV infection"},{"label":"E","text":"Pertussis"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-1bb43ba48aee","stem":"2 Which of the following statements regarding CML is true?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Peripheral smear shows elevated W BC count with mature and immature granulocytes, toxic granulation, and high LAP score."},{"label":"B","text":"Usually presents initially with splenomegaly, anemia, and thrombocytopenia."},{"label":"C","text":"Chromosomal translocations, most often t(9;22), are found in 90% to 95% of patients."},{"label":"D","text":"Is an indolent disease, and should be monitored without treatment until patients enter accelerated or blast phase."}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"a9cc316d7b49f30f77a979da5f9611174e594eb2"},{"id":"q-ff22beb6a211","stem":"3 A 75-year-old woman, diagnosed with stage 0 CLL 1 year ago and being monitored without treatment, now complains of fatigue and dyspnea. She has no palpable adenopathy or splenomegaly, no rashes or arthritis, and her CBC shows ALC 11,000/ μL, with hemoglobin 6.8 mg/ dL, and platelet count 127,000/ μL. What is the most appropriate diagnostic test?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Direct antiglobulin (Coombs) test"},{"label":"B","text":"Antinuclear antibody"},{"label":"C","text":"Bone marrow biopsy"},{"label":"D","text":"Test for Lewis alloantibody"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-c3ed12d7080f","stem":"1 Which of the following therapies would most likely decrease the number of sickle cell crises? diagnosis? best pharmacotherapy for this patient’s condition?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Hydroxyurea"},{"label":"B","text":"Folate supplementation"},{"label":"C","text":"Prophylactic penicillin"},{"label":"D","text":"Pneumococcal vaccination REVIEW R1. A 55-year-old white man with a history of end-stage renal disease (ESRD) secondary to chronic uncontrolled hypertension (HTN ) presents to the emergency department (ED) after sustaining a fall in his bathroom on to his right hip. H e complains of pain with passive motion of the hip and on physical examination the hip has limited range of motion upon internal rotation. An x-ray of the right hip shows a fracture. Which of the below series of serum laboratory values are consistent with the underlying condition predisposing to this patient’s fracture? Serum Ca Serum PO3 Serum PTH"},{"label":"A","text":"Increased Decreased Increased"},{"label":"B","text":"Increased Decreased Decreased"},{"label":"C","text":"Increased Increased Decreased"},{"label":"D","text":"Decreased Increased Increased"},{"label":"E","text":"Decreased Increased Decreased"},{"label":"F","text":"Decreased Decreased Decreased R2. A 24-year old African-American man comes into clinic from a referral after having significant bleeding following a wisdom tooth extraction 1 week ago. H e has no significant medical history and took aspirin 1 week ago for a headache. However, he reports getting nosebleeds lasting over 10 minutes as a child. He reports no family history of diagnosed bleeding disorders but endorses his mother easily bruises and has heavy menstrual bleeding. Laboratory values include a normal platelet count, increased bleeding time, a normal prothrombin time (PT ), and an increased partial prothrombin time (PT T ). What is the most likely"},{"label":"A","text":"Aspirin overdose"},{"label":"B","text":"Bernard-Soulier syndrome"},{"label":"C","text":"Hemophilia A"},{"label":"D","text":"Vitamin K deficiency"},{"label":"E","text":"von Willebrand disease R3. A 40-year-old woman with known H IV presents to clinic with complaints of difficulty and pain with swallowing. She has been experiencing substernal burning chest pain for the past 2 weeks. H er most recent CD4+ count was 80 cells/ mm3 and her medications include trimethoprim/ sulfamethoxazole (TMP-SMX) and highly active antiretroviral therapy (H AART ). On physical examination there are white plaques visible in the oral cavity and posterior pharynx that are easily removed with a tongue blade. No vesicular lesions are visible in the posterior pharynx. An endoscopy is performed that demonstrates additional white plaques in the proximal esophagus. Biopsies are significant for pseudohyphae. What is the"},{"label":"A","text":"Acyclovir"},{"label":"B","text":"Azithromycin"},{"label":"C","text":"Fluconazole"},{"label":"D","text":"Ganciclovir"},{"label":"E","text":"Sulfadiazine-pyrimethamine R4. A 55-year-old man with known alcoholic cirrhosis presents to the ED with confusion and diffuse abdominal pain. Blood pressure is 98/ 68 mm H g, temperature is"}],"priority":1,"status":"review","flags":["topic_generic","too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","long_option_manual_review","nonunique_option_labels","prior_structural_review_flag","too_many_options","too_many_options_possible_merge","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-4dacd8e00a2c","stem":"4°F, and pulse is 102 bpm. The abdomen is distended and a fluid wave present on physical examination. In the past, his ascites was controlled with furosemide and spironolactone. Paracentesis is performed and found to have an absolute polymorphonuclear (PMN ) count of 280 cells/mm3, albumin of 1 mg/ dL, and cultures are pending. Serum albumin is 2.6 g/ dL. Which of the following is the best next step? should include coverage for what organism? next best diagnostic test?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Administer oral lactulose."},{"label":"B","text":"Empiric IV ceftriaxone."},{"label":"C","text":"Empiric IV octreotide."},{"label":"D","text":"Liver transplantation."},{"label":"E","text":"Protein-restricted diet. R5. A 30-year-old woman is admitted to the shock trauma intensive care unit (ICU) after sustaining a motor vehicle collision. She has required multiple major surgeries as well as mechanical ventilation for the past week. Vital signs have been stable during this time and her chest xrays have been clear. On hospital day 8 she develops a temperature of 102.2°F, blood pressure is 110/ 70 mm H g, heart rate is 104 bpm, SpO 2 is 92%, and new purulent secretions from the endotracheal tube are sent for Gram stain and culture. A chest x-ray is found to have a new infiltrate in the right lower lobe. Initial antibiotic coverage"},{"label":"A","text":"Chlamydia pneumoniae"},{"label":"B","text":"Haemophilus influenzae"},{"label":"C","text":"Legionella pneumophila"},{"label":"D","text":"Pseudomonas aeruginosa"},{"label":"E","text":"Methicillin-sensitive Staphylococcus aureus R6. A 60-year-old man with a history of hyperlipidemia controlled on simvastatin and well-controlled hypertension complains of nonbloody, watery diarrhea for over 1 year. He complains of episodes of wheezing and increased redness and heat in his face, neck, and upper chest that last up to 5 minutes. On physical examination there is hepatomegaly and a 2/ 6 holosystolic murmur is auscultated on the left lower sternal boarder that is accentuated with inspiration. Blood pressure is 135/ 85 mm H g, heart rate is 85 bpm, and respiratory rate is 16 breaths per minute. What is the"},{"label":"A","text":"24-Hour urine 5-hydroxyindoleacetic acid"},{"label":"B","text":"24-Hour urine metanephrines"},{"label":"C","text":"Endoscopy with colonoscopy"},{"label":"D","text":"Methacholine challenge"},{"label":"E","text":"Secretin injection test R7. A 37-year-old woman with a history of intravenous (IV) drug use and prostitution presents with complaints of fatigue and increased swelling around her eyes, hands, and feet. She has also noticed increased abdominal girth. She is on no medications. Physical examination shows temperature 98.9°F, blood pressure 125/ 80 mm H g, heart rate 76 bpm, respiratory rate 14 breaths per minute, periorbital edema, and shifting dullness on abdominal examination. Laboratory values include serum albumin"}],"priority":1,"status":"review","flags":["topic_generic","too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","long_option_manual_review","nonunique_option_labels","prior_structural_review_flag","too_many_options","too_many_options_possible_merge","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-88c58589e9fd","stem":"Hour urine protein excretion is 3.7 g/ d. What is the most likely diagnosis? condition?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Diabetic nephropathy"},{"label":"B","text":"Focal segmental glomerulosclerosis"},{"label":"C","text":"IgA nephropathy"},{"label":"D","text":"Membranous nephropathy"},{"label":"E","text":"Minimal change disease R8. The patient in Question R7 suddenly develops redness, swelling, and pain in her left calf. On physical examination there is pain with dorsiflexion of the foot. What is the most likely pathophysiology of her current"},{"label":"A","text":"Increase in clotting factor VIII"},{"label":"B","text":"Decrease in antithrombin III"},{"label":"C","text":"Decrease in protein C"},{"label":"D","text":"Decrease in protein S"},{"label":"E","text":"A mutation in clotting factor V R9. A 61-year-old man presents to the hospital"}],"priority":1,"status":"review","flags":["subject_unclassified","topic_generic","too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","subject_needs_classification","subject_unclassified","too_many_options","too_many_options_possible_merge","topic_generic"],"cleaningOperations":[]},{"id":"q-9d920f962c49","stem":"best pharmacotherapy for this patient’s condition?","type":"Clinical Vignette","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3f09c136cf6e","stem":"should include coverage for what organism?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","