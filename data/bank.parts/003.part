de b) Amino acid c) Nucleic acid d) Nucleotide 30. Which amino acid has a hydrophobic side chain? A. B. C. D. E.","type":"Clinical Vignette","subject":"Medical Biochemistry","topic":"Water, pH and Buffers","topicOriginal":"Water, pH and Buffers","subtopic":"Acid","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Water, pH and Buffers","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["possible_multiple_questions_in_stem"],"cleaningOperations":[]},{"id":"q-3ae41358c762","stem":"<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"<a:clrMap xmlns:a=\"http://schemas.openxmlformats.org/drawingml/2006/main\" bg1=\"lt1\" tx1=\"dk1\" bg2=\"lt2\" tx2=\"dk2\" accent1=\"accent1\" accent2=\"accent2\" accent3=\"accent3\" accent4=\"accent4\" accent5=\"accent5\" accent6=\"accent6\" hlink=\"hlink\" folHlink=\"folHlink\"/>"},{"label":"B","text":"*€urn:schemas-microsoft-com:office:smarttags"},{"label":"C","text":"€place"},{"label":"D","text":"*€urn:schemas-microsoft-com:office:smarttags €PlaceName"},{"label":"E","text":"*€urn:schemas-microsoft-com:office:smarttags €PlaceType"},{"label":"F","text":"éqê' ̈jTÄÿ"}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOpe