:false,"publicationStatus":"unverified_draft","auditFlags":["possible_multiple_questions_in_stem","url_or_navigation_embedded"],"cleaningOperations":[]},{"id":"q-53f8fcf1d8a9","stem":"Which among of the following defines GPI anchored proteins?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-88cae14d7a28","stem":"Which is not an example of Trans membrane transport between different subcellular compartments?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-0edd12857ec9","stem":"Which is correct regarding the peptides in the Ramachandran plot?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-244886013299","stem":"Which cell organelles is involved in apoptosis?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-bdfc2666e7d9","stem":"Of these major ions found in the body, which one carries a negative charge?","type":"Single Best Answer MCQ","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Chloride"},{"label":"B","text":"Sodium"},{"label":"C","text":"Potassium"},{"label":"D","text":"Hydrogen"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{}},{"id":"q-c5139892ff75","stem":"Which equation is most accurate?","type":"Single Best Answer MCQ","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"extracellular fluid volume + interstitial fluid volume = whole body fluid volume"},{"label":"B","text":"intracellular fluid volume + interstitial fluid volume = extracellular fluid volume"},{"label":"C","text":"extracellular fluid volume - interstitial fluid volume = plasma volume"},{"label":"D","text":"plasma volume + intracellular fluid volume = extracellular fluid volume"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{}},{"id":"q-815f2120b904","stem":"What will happen if a normal cell is placed in a hypotonic solution?","type":"Single Best Answer MCQ","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It will swell in size."},{"label":"B","text":"It will shrink in size."},{"label":"C","text":"It will stay the same size."},{"label":"D","text":"The result can't be predicted."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{}},{"id":"q-a8657f374e6c","stem":"The regions of axon membrane that lie between regions of myelin are the","type":"Single Best Answer MCQ","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"islets of Langerhans."},{"label":"B","text":"nodes of Ranvier."},{"label":"C","text":"synaptic membranes."},{"label":"D","text":"glial cells."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3ce189a39c90","stem":"Which of the following statements regarding contraction of a skeletal-muscle fibre is TRUE?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Thick filaments shorten when muscle cells contract."},{"label":"B","text":"Some contractions occur without cross-bridge activation."},{"label":"C","text":"Contracting muscle fibres do not always shorten."},{"label":"D","text":"Contraction does not always require the occurrence of an action potential."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1597e0e8310e","stem":"In skeletal muscle cells, calcium initiates contraction by binding to","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the tropomyosin strand."},{"label":"B","text":"actin."},{"label":"C","text":"the troponin complex."},{"label":"D","text":"myosin."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-fa09d7c2ca03","stem":"The optimal length (Lo) of a skeletal muscle cell is","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the length at which the muscle can generate its maximum tetanic tension."},{"label":"B","text":"the shortest length the muscle can achieve while attached to bone, because the amount of overlap between thick and thin filaments is maximal then."},{"label":"C","text":"generally the length attained when the joint it crosses is fully extended."},{"label":"D","text":"the only length at which any tension can be generated by the muscle cell."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-254683561bba","stem":"Multiunit smooth muscle cells","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"generally have individual innervation of each cell."},{"label":"B","text":"have many gap junctions between cells."},{"label":"C","text":"respond to stretch by relaxing."},{"label":"D","text":"can only be excited, and not inhibited."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"54055e0d144046fe5debc71fd845d51340a24ab0"},{"id":"q-45abe1efa604","stem":"Which of the following changes would most increase the resistance to blood flow in a blood vessel?","type":"Single Best Answer MCQ","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"halving the diameter of the vessel"},{"label":"B","text":"doubling the diameter of the vessel"},{"label":"C","text":"halving the length of the vessel"},{"label":"D","text":"doubling the length of the vessel"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{}},{"id":"q-d8cbede4885f","stem":"What best represents the QRS complex in an electrocardiogram?","type":"ECG Interpretation","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"depolarization of the atria"},{"label":"B","text":"repolarization of the atria"},{"label":"C","text":"depolarization of the ventricles"},{"label":"D","text":"repolarization of the ventricles"}],"priority":2,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-33beb05f7633","stem":"Sinus nodal cells","type":"Single Best Answer MCQ","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"reach threshold only when action potentials generated by the AV node arrive through gap junctions."},{"label":"B","text":"exhibit spontaneous depolarization that is speeded by activation of their cholinergic receptors."},{"label":"C","text":"exhibit spontaneous depolarization that is speeded by activation of their beta-adrenergic receptors."},{"label":"D","text":"exhibit a steep upstroke due to the presence of the same type of Na+ channels found in neuronal membranes."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2e0bd1d677b7","stem":"A 60-year-old man visits his family practitioner for his yearly examination. He has a systolic and diastolic blood pressure of respectively, 180 and 100 mm Hg, a heart rate of 78 beats/min. His plasma cholesterol level is in the upper 25th percentile. A decrease in which of the following is the most likely explanation for the high blood pressure in this patient?","type":"Clinical Vignette","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7ea3725a54ba","stem":"Which of the following components of the circulatory system contains most of the blood volume?","type":"Short Answer","subject":"Human Anatomy","topic":"Histology and Tissues","topicOriginal":"Histology and Tissues","subtopic":"Capillar","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Histology and Tissues","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-3caefb6ec8a3","stem":"Which of the following statements concerning the process of glomerular filtration is correct?","type":"Single Best Answer MCQ","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The hydrostatic pressure in Bowman's space opposes filtration."},{"label":"B","text":"The glomerular filtration rate is limited by a transport maximum."},{"label":"C","text":"All of the plasma that enters the glomerular capillaries is filtered."},{"label":"D","text":"The osmotic force due to plasma proteins favours filtration."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4f9b8b835422","stem":"What is the role of astrocytes?","type":"Short Answer","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTop