rt Answer","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Face","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["answer_explanation_mixed_into_stem"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-a35ce396e874","stem":"Multiunit smooth muscle cells","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"generally have individual innervation of each cell."},{"label":"B","text":"have many gap junctions between cells."},{"label":"C","text":"respond to stretch by contracting."},{"label":"D","text":"can only be excited, and not inhibited."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"54055e0d144046fe5debc71fd845d51340a24ab0"},{"id":"q-01490d889643","stem":"What controls the intensity of single-unit smooth muscle contraction Neuronal and hormonal activity Local factors, such as NO released by adjacent endothelial cells Stretch of the surface membrane of the smooth muscle cells All of the above are correct","type":"Short Answer","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Face","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":fa