d","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"893db0bac0e4d191a4cdcc81c2872988ad71c031"},{"id":"q-f2b93507ecb2","stem":"Which of the following is an element of the peripheral nervous system?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Receptors"},{"label":"B","text":"Brachial plexus"},{"label":"C","text":"Ganglia"},{"label":"D","text":"Sciatic nerve"},{"label":"E","text":"All of the above"}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_duplicate_projection","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"d3e6f0c58f239f77e9a0c5434d82380184166373"},{"id":"q-638315eb9886","stem":"What are most neurons in the body?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Unipolar"},{"label":"B","text":"Pseudounipolar"},{"label":"C","text":"Bipolar"},{"label":"D","text":"Multipolar"},{"label":"E","text":"Both a and b Most neurons in the body (over 99%) are multipolar. Neurons can be classified based on the number of axons and dendrites stemming off of the cell body. A unipolar neuron has one process which branches off of it This process then immediately divides into two. Thus, a unipolar neuron is sometimes also called a pseudounipolar neuron. Sensory neurons are unipolar. A bipolar neuron has two process that branch from it: an axon and a dendrite. Bipolar neurons are not very common and are found in some of the organs for special senses. Bipolar neurons are found in the retina, inner ear, and the region of the nose involved with smell. Multipolar neurons have one axon and many (at least two) dendrites that branch off of it. Most neurons are multipolar. Motor neurons and interneurons are multipolar."}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["long_option_manual_review","repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"44637d5d148d69f525689e06c479b2f0b327bf90"},{"id":"q-7bc44f3e0960","stem":"What is the cell body of a neuron called?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ganglion"},{"label":"B","text":"Perikaryon"},{"label":"C","text":"Astrocyte"},{"label":"D","text":"Nissl"},{"label":"E","text":"Terminal bouton"}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_duplicate_projection","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"2624f1a7d82c529d78248133d5b40dbded293844"},{"id":"q-7bfd585d772f","stem":"Which type of neuron is multipolar?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Motor neurons"},{"label":"B","text":"Interneurons"},{"label":"C","text":"Sensory neurons"},{"label":"D","text":"Both a and b"},{"label":"E","text":"All of the above Both motor neurons and interneurons are multipolar."}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"25bb29efbb35305a6510f63017c5caeca11be4d3"},{"id":"q-679901372d90","stem":"Which meninx is made of a delicate web like connective tissue?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Dura mater"},{"label":"B","text":"Arachnoid"},{"label":"C","text":"Pia mater"},{"label":"D","text":"Both a and b"},{"label":"E","text":"All of the above"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"5eef5fc00c789e405432c4f83c6de041a1224ae0","manualEdits":{}},{"id":"q-1b8600ea525d","stem":"Which of the following forms myelin in the peripheral nervous system?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Schwann cells"},{"label":"B","text":"Basket cells"},{"label":"C","text":"Ganglion"},{"label":"D","text":"Neuroglia"},{"label":"E","text":"Satellite cells Schwann cells are responsible for the myelination of neurons in the peripheral nervous system. Basket cells are a type of neuron seen in the cerebellum. A ganglion is a collection of nerve cell bodies outside of the CNS. Neuroglia are the supporting cells in the central nervous system Sometimes, neuroglia called glial cells or glia. Satellite cells are found in the ganglia of the peripheral nervous system."}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"401b40613a8570e93538254c4a63e92d9817d50d"},{"id":"q-04ea4b422dbf","stem":"Which of the following is an element of the central nervous system?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Receptors"},{"label":"B","text":"Brachial plexus"},{"label":"C","text":"Sciatic nerve"},{"label":"D","text":"Ganglia"},{"label":"E","text":"Spinal cord"}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_duplicate_projection","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"d0acff56a925848c055b9e1e600ba3d8188618cd"},{"id":"q-40b26ff471c4","stem":"What are motor neurons?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Unipolar"},{"label":"B","text":"Pseudounipolar"},{"label":"C","text":"Bipolar"},{"label":"D","text":"Multipolar"},{"label":"E","text":"Both a and b Motor neurons are multipolar. Neurons can be classified based on the number of axons and dendrites stemming off of the cell body. A unipolar neuron has one process which branches off of it This process then immediately divides into two. Thus, a unipolar neuron is sometimes also called a pseudounipolar neuron. Sensory neurons are unipolar. A bipolar neuron has two process that branch from it: an axon and a dendrite. Bipolar neurons are not very common and are found in some of the organs for special senses. Bipolar neurons are found in the retina, inner ear, and the region of the nose involved with smell. Multipolar neurons have one axon and many (at least two) dendrites that branch off of it. Most neurons are multipolar. Motor neurons and interneurons are multipolar."}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["long_option_manual_review","repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"e8b13ec0f3f492780359a35923deeed2e5404f5a"},{"id":"q-c7c577556347","stem":"What is a collection of cell bodies outside the CNS called?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ganglion"},{"label":"B","text":"Perikaryon"},{"label":"C","text":"Astrocyte"},{"label":"D","text":"Nissl"},{"label":"E","text":"Terminal bouton"}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"70469970e6a36340f50c18b7e969446e08909753"},{"id":"q-bef0dbfe5f9c","stem":"What is tissue which surrounds a nerve fascicle?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Perimysium"},{"label":"B","text":"Periosteum"},{"label":"C","text":"Perichondrium"},{"label":"D","text":"Perineurium"},{"label":"E","text":"Endosteum"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"d7c2ae3c650e6aba060e63961c64a40d4293ba75"},{"id":"q-a725a61c69e2","stem":"Where is the cerebrospinal fluid?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Between the dura mater and bone"},{"label":"B","text":"Subdural space"},{"label":"C","text":"Subarachnoid space"},{"label":"D","text":"Between the pia mater and brain"},{"label":"E","text":"None of the above"}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_duplicate_projection","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"2dc5d7d743fda6c366e850b229691c538d0b0d9e"},{"id":"q-8819750ebbc0","stem":"Which of the following are considered to be part of the meninges?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Dura mater"},{"label":"B","text":"Arachnoid"},{"label":"C","text":"Pia mater"},{"label":"D","text":"Both a and c"},{"label":"E","text":"All of the above"}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_duplicate_projection","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"],"duplicateStemGroup":"611ee9173596e581bc9cf2af37249cdf682a7777"},{"id":"q-5b8040436825","stem":"Which of the following is the most abundant neuroglia cell?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Astrocytes"},{"label":"B","text":"Ependymal cells"},{"label":"C","text":"Oligodendrocytes"},{"label":"D","text":"Microglia"},{"label":"E","text":"Schwann cells Neuroglia are the supporting cells of the central nervous system. Sometimes, neuroglia called glial cells or glia. Astrocytes, ependymal cells, oligodendrocytes, and microglia are all neuroglia. Of the neuroglia cells, astrocytes are the most abundant and the largest. These are star shaped cells involved in the blood brain barrier. Ependymal cells line the ventricles and spinal canal. Oligodendrocytes form myelin in the central nervous system. Microglia are the central nervous system macrophages. Schwann cells are seen in the peripheral nervous system and are not considered neuroglia. Schwann cells are responsible for the myelination of neurons in the peripheral nervous system."}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["long_option_manual_review","repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"562a7b831e194b5506966ec61dafaa1f6fccba95"},{"id":"q-f1e18ba65db2","stem":"Which of the following is an element of the central nervous system?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Receptors"},{"label":"B","text":"Brachial plexus"},{"label":"C","text":"Brain"},{"label":"D","text":"Ganglia"},{"label":"E","text":"Sciatic nerve"}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_duplicate_projection","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"d0acff56a925848c055b9e1e600ba3d8188618cd"},{"id":"q-860b42ee5b48","stem":"Which of the following is supporting cell of the central nervous system?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ganglion"},{"label":"B","text":"Perikaryon"},{"label":"C","text":"Astrocyte"},{"label":"D","text":"Nissl"},{"label":"E","text":"Terminal bouton"}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_duplicate_projection","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"faf5a9a7a72b9df8deedd5cb63e976a40ff377ba"},{"id":"q-b977c4e22933","stem":"How many neurons are in the body of man?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"10,000 (10 to the 4th)"},{"label":"B","text":"10,000,000 (10 to the 7th)"},{"label":"C","text":"10,000,000,000 (10 to the 10th)"},{"label":"D","text":"10,000,000,000,000 (10 to the 13th)"},{"label":"E","text":"10,000,000,000,000,000 (10 to the 16th"}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"cd2482d0b774f975dbba87e41aa9afec812038a8"},{"id":"q-9a1ce51828ec","stem":"What are the gaps that occur within the myelin sheath?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Meninges"},{"label":"B","text":"Myelinated nerve fibers"},{"label":"C","text":"Cell bodies"},{"label":"D","text":"Nodes of Ranvier"},{"label":"E","text":"Neurofilaments"}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"906a8860e7fc13c1d1509a3cb1955027ce619b71"},{"id":"q-b353cccc2b87","stem":"Where is gray matter?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Outer surface of the cerebrum and cerebellum"},{"label":"B","text":"Outer surface of the spinal cord"},{"label":"C","text":"Inner portion of the spinal cord"},{"label":"D","text":"Both a and b"},{"label":"E","text":"Both a and c"}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"d473cf9a299560bf28f2489ddb4a765acf747ccc"},{"id":"q-9329e4321bdb","stem":"What surrounds a nerve?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Neurium"},{"label":"B","text":"Perineurium"},{"label":"C","text":"Epineurium"},{"label":"D","text":"Endoneurium"},{"label":"E","text":"None of the above"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"],"duplicateStemGroup":"4c5512fd26445fe8faba7d61ed3b9c165bba564d"},{"id":"q-39455b9c4cc5","stem":"Which of the following lines the ventricles?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Astrocytes"},{"label":"B","text":"Ependymal cells"},{"label":"C","text":"Oligodendrocytes"},{"label":"D","text":"Microglia"},{"label":"E","text":"Schwann cells Neuroglia are the supporting cells of the central nervous system. Sometimes, neuroglia called glial cells or glia. Astrocytes, ependymal cells, oligodendrocytes, and microglia are all neuroglia. Of the neuroglia cells, astrocytes are the most abundant and the largest. These are star shaped cells involved in the blood brain barrier. Ependymal cells line the ventricles and spinal canal. Oligodendrocytes form myelin in the central nervous system. Microglia are the central nervous system macrophages. Schwann cells are seen in the peripheral nervous system and are not considered neuroglia. Schwann cells are responsible for the myelination of neurons in the peripheral nervous system."}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["long_option_manual_review","repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"ccb6f670951820459c64489c0b6c21c81c765faf"},{"id":"q-d0c885871118","stem":"What is a collection of nerve cell bodies outside of the central nervous system called?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Schwann cells"},{"label":"B","text":"Basket cells"},{"label":"C","text":"Ganglion"},{"label":"D","text":"Neuroglia"},{"label":"E","text":"Satellite cells Schwann cells are responsible for the myelination of neurons in the peripheral nervous system. Basket cells are a type of neuron seen in the cerebellum. A ganglion is a collection of nerve cell bodies outside of the CNS. Neuroglia are the supporting cells in the central nervous system Sometimes, neuroglia called glial cells or glia. Satellite cells are found in the ganglia of the peripheral nervous system."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"8849262fbb2b5116d9ac0120415b844fceee958e"},{"id":"q-450377fc6ee0","stem":"What are sensory neurons?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Unipolar"},{"label":"B","text":"Pseudounipolar"},{"label":"C","text":"Bipolar"},{"label":"D","text":"Multipolar"},{"label":"E","text":"Both a and b Sensory neurons are unipolar. Unipolar neurons are sometimes also called pseudounipolar. Neurons can be classified based on the number of axons and dendrites stemming off of the cell body. A unipolar neuron has one process which branches off of it This process then immediately divides into two. Thus, a unipolar neuron is sometimes also called a pseudounipolar neuron. Sensory neurons are unipolar. A bipolar neuron has two process that branch from it: an axon and a dendrite. Bipolar neurons are not very common and are found in some of the organs for special senses. Bipolar neurons are found in the retina, inner ear, and the region of the nose involved with smell. Multipolar neurons have one axon and many (at least two) dendrites that branch off of it. Most neurons are multipolar. Motor neurons and interneurons are multipolar."}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["long_option_manual_review","repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"5f62f429e2af2f7f3ac616d77a10a5a3b73b750d"},{"id":"q-d422766fc522","stem":"What is the connective tissue covering around the brain and spinal cord?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Meninges"},{"label":"B","text":"Myelinated nerve fibers"},{"label":"C","text":"Cell bodies"},{"label":"D","text":"Nodes of Ranvier"},{"label":"E","text":"Neurofilaments"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"c5bfd48f8e41ab20ac25ea906f718280afaf1fc9"},{"id":"q-caba5bc16305","stem":"Which meninx is made of a dense irregular connective tissue?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Dura mater"},{"label":"B","text":"Arachnoid"},{"label":"C","text":"Pia mater"},{"label":"D","text":"Both a and b"},{"label":"E","text":"All of the above"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"2c88f937222608d62a07e2026fe970b7d7e460f6"},{"id":"q-f26a8cc6d441","stem":"What is a group of fibers traveling together?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Tracts"},{"label":"B","text":"Islets"},{"label":"C","text":"Soma"},{"label":"D","text":"Cortex"},{"label":"E","text":"Nuclei"}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"287cafe5d4973ed1b6a0bc460814c2ceca91493d"},{"id":"q-4cc464d4bbf4","stem":"Where is white matter?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Outer surface of the cerebrum and cerebellum"},{"label":"B","text":"Outer surface of the spinal cord"},{"label":"C","text":"Inner portion of the brain"},{"label":"D","text":"Both a and b"},{"label":"E","text":"Both b and c"}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"96f90fe9703a1302fa19f81b98802d15d1b056f3"},{"id":"q-a49779a22866","stem":"Which of the following forms myelin in the central nervous system?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Astrocytes"},{"label":"B","text":"Ependymal cells"},{"label":"C","text":"Oligodendrocytes"},{"label":"D","text":"Microglia"},{"label":"E","text":"Schwann cells Neuroglia are the supporting cells of the central nervous system. Sometimes, neuroglia called glial cells or glia. Astrocytes, ependymal cells, oligodendrocytes, and microglia are all neuroglia. Of the neuroglia cells, astrocytes are the most abundant and the largest. These are star shaped cells involved in the blood brain barrier. Ependymal cells line the ventricles and spinal canal. Oligodendrocytes form myelin in the central nervous system. Microglia are the central nervous system macrophages. Schwann cells are seen in the peripheral nervous system and are not considered neuroglia. Schwann cells are responsible for the myelination of neurons in the peripheral nervous system."}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["long_option_manual_review","repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"9b1fdea0dec0919181b7c8c97325570f6c0bef59"},{"id":"q-7e1f1cb5e822","stem":"Which of the following is found in the cerebellum?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Schwann cells"},{"label":"B","text":"Basket cells"},{"label":"C","text":"Ganglion"},{"label":"D","text":"Neuroglia"},{"label":"E","text":"Satellite cells Schwann cells are responsible for the myelination of neurons in the peripheral nervous system. Basket cells are a type of neuron seen in the cerebellum. A ganglion is a collection of nerve cell bodies outside of the CNS. Neuroglia are the supporting cells in the central nervous system Sometimes, neuroglia called glial cells or glia. Satellite cells are found in the ganglia of the peripheral nervous system."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"349723f91a34b40b98a06c17d69fc8d6823d40ed"},{"id":"q-2418df33b94a","stem":"What are the basophilic clusters of ribosomes and rough endoplasmic reticulum seen in neurons called?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ganglion"},{"label":"B","text":"Perikaryon"},{"label":"C","text":"Astrocyte"},{"label":"D","text":"Nissl"},{"label":"E","text":"Terminal bouton"}