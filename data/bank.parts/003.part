_generic"],"cleaningOperations":[]},{"id":"q-673d745c5900","stem":"A 60-year-old woman with known alcoholic liver cirrhosis presents with difficulty in breathing, malaise and nausea. On examination she was dyspnoec, massive ascites and generalized abdominal tenderness. The initial management of this patient include","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Gastroenterology and Hepatology","topicOriginal":"Gastroenterology and Hepatology","subtopic":"Liver","suggestedTopic":null,"options":[{"label":"A","text":"Under water seal drainage"},{"label":"B","text":"Abdominal paracentesis"},{"label":"C","text":"High soap enema"},{"label":"D","text":"Induce vomiting"},{"label":"E","text":"Gastric lavage 9"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Gastroenterology and Hepatology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"ba016eca14fd4b1238d9a83d9a001b6c769e0a89"},{"id":"q-367816dd2ec0","stem":"Which of the following is included in the management of heart failure","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Cardiology","topicOriginal":"Cardiology","subtopic":"Heart","suggestedTopic":null,"options":[{"label":"A","text":"Increase of cardiac after load"},{"label":"B","text":"Control of excessive fluids"},{"label":"C","text":"Increase sodium intake"},{"label":"D","text":"High protein diet"},{"label":"E","text":"Excessive exercise"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Cardiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlag