ect_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"2f331d34bf6c9d17d8dc2b7dca7fe9cb53d69204"},{"id":"q-7529ca705b12","stem":"Which of the following is found in the peripheral nervous system?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Astrocytes"},{"label":"B","text":"Ependymal cells"},{"label":"C","text":"Oligodendrocytes"},{"label":"D","text":"Microglia"},{"label":"E","text":"Schwann cells Neuroglia are the supporting cells of the central nervous system. Sometimes, neuroglia called glial cells or glia. Astrocytes, ependymal cells, oligodendrocytes, and microglia are all neuroglia. Of the neuroglia cells, astrocytes are the most abundant and the largest. These are star shaped cells involved in the blood brain barrier. Ependymal cells line the ventricles and spinal canal. Oligodendrocytes form myelin in the central nervous system. Microglia are the central nervous system macrophages. Schwann cells are seen in the peripheral nervous system and are not considered neuroglia. Schwann cells are responsible for the myelination of neurons in the peripheral nervous system."}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["long_option_manual_review","repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"37b79ba442199596153e38148017e40edc2f8fda"},{"id":"q-62526d8f6054","stem":"Where is the ependyma found?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Lining ventricles"},{"label":"B","text":"Lining spinal canal"},{"label":"C","text":"Covering the brain"},{"label":"D","text":"Covering the spinal cord"},{"label":"E","text":"Both a and b The ependyma lines the ventricles and spinal canal."}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"020570807511e60f5124f01ad488c236405cf818"},{"id":"q-3173a411f788","stem":"Which type of neuron is most abundant?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Sensory neurons"},{"label":"B","text":"Motor neurons"},{"label":"C","text":"Interneurons"},{"label":"D","text":"Both a and b"},{"label":"E","text":"All of the above The vast majority of neurons are interneurons."}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"d0e24eb143dbf1d056e60ba3b320d7f670ff00a2"},{"id":"q-5b33aeb4ceb8","stem":"Which meninx covers the brain intimately?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Dura mater"},{"label":"B","text":"Arachnoid"},{"label":"C","text":"Pia mater"},{"label":"D","text":"Both a and b"},{"label":"E","text":"All of the above"}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"51d3aad51727faef5b98f7dc7e88fa91988fa3a8"},{"id":"q-45d03209281c","stem":"Which of the following is NOT considered neuroglia?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Astrocytes"},{"label":"B","text":"Ependymal cells"},{"label":"C","text":"Oligodendrocytes"},{"label":"D","text":"Microglia"},{"label":"E","text":"Schwann cells Neuroglia are the supporting cells of the central nervous system. Sometimes, neuroglia called glial cells or glia. Astrocytes, ependymal cells, oligodendrocytes, and microglia are all neuroglia. Of the neuroglia cells, astrocytes are the most abundant and the largest. These are star shaped cells involved in the blood brain barrier. Ependymal cells line the ventricles and spinal canal. Oligodendrocytes form myelin in the central nervous system. Microglia are the central nervous system macrophages. Schwann cells are seen in the peripheral nervous system and are not considered neuroglia. Schwann cells are responsible for the myelination of neurons in the peripheral nervous system."}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["long_option_manual_review","repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"2a87a4e726064816d54960a8d710325e876c8add"},{"id":"q-e44681c7c44e","stem":"What is the innervation of an apocrine sweat gland?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cholinergic; parasympathetic"},{"label":"B","text":"Cholinergic; sympathetic"},{"label":"C","text":"Adrenergic; parasympathetic"},{"label":"D","text":"Adrenergic; sympathetic"},{"label":"E","text":"Cholinergic; motor Apocrine sweat glands are innervated by the sympathetic nervous system."}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"52a613a75d258f44a77de1c4209ddef802757f87"},{"id":"q-6e2503b9572d","stem":"Which of the following is NOT a substrate for gluconeogenesis? occur? What does covalent modification mean in terms of enzyme activity regulation? and pancreas? tissues? Which of the following enzymes is activated by NADH and Acetyl-coA? During starvation which amino acids prevail in circulation? glucose? haemoglobin’s affinity for oxygen? which compartment of the cell? Which of the following tissues depend on insulin for glucose uptake? cells with eventual secretion of insulin? the three inhibitors? following as a route cause? anaerobic glycolysis? Which of the following chemicals is an allosteric effector of phosphofrucokinase-1? rank fatty acids, glucose, ethanol and amino acids starting with the fastest one? membrane from matrix to the cytosol? one?","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Water, pH and Buffers","topicOriginal":"Water, pH and Buffers","subtopic":"Acid","suggestedTopic":null,"options":[{"label":"A","text":"Lactate"},{"label":"B","text":"Glycerol"},{"label":"C","text":"Pyruvate"},{"label":"D","text":"Acetyl-coA At which complex of the oxidative phosphorylation pathway does ATP synthesis"},{"label":"A","text":"Complex I"},{"label":"B","text":"Complex II"},{"label":"C","text":"Complex III"},{"label":"D","text":"Complex V"},{"label":"A","text":"Formation of covalent bond by sharing of electrons"},{"label":"B","text":"Phosphorylation / dephosphorylation strategy"},{"label":"C","text":"Phosphorylation strategy"},{"label":"D","text":"Dephosphorylation strategy Which of the following glucose transporters is mostly found in kidney, liver, intestine"},{"label":"A","text":"GLUT-2"},{"label":"B","text":"GLUT-3 1"},{"label":"C","text":"GLUT-4"},{"label":"D","text":"GLUT-5 Which of the following glucose transporters is mostly found in insulin sensitive"},{"label":"A","text":"GLUT-2"},{"label":"B","text":"GLUT-3"},{"label":"C","text":"GLUT-4"},{"label":"D","text":"GLUT-5"},{"label":"A","text":"PDH-complex"},{"label":"B","text":"PDH-kinase"},{"label":"C","text":"PDH-phosphatase"},{"label":"D","text":"Lipoyl transacetylase"},{"label":"A","text":"Alanine"},{"label":"B","text":"Glutamine"},{"label":"C","text":"Alanine and glutamine"},{"label":"D","text":"Alanine and asparagines Usually important control points of a reaction pathway are:"},{"label":"A","text":"the irreversible paths"},{"label":"B","text":"the reversible paths"},{"label":"C","text":"the high energy reactions"},{"label":"D","text":"low energy reactions What is the GROSS ATP production during anaerobic glycolysis per one mole"},{"label":"A","text":"10 ATPs"},{"label":"B","text":"8 ATPs"},{"label":"C","text":"6 ATPs"},{"label":"D","text":"4 ATPs Which of the following intermediate products of glycolysis is a regulator of"},{"label":"A","text":"2,3-diphosphoglcerate"},{"label":"B","text":"1,3-bisphosphoglycerate"},{"label":"C","text":"fructose 2,3-bisphosphate"},{"label":"D","text":"3-phosphoglyceraldehyde During gluconeogenesis, the reaction catalyzed by pyruvate carboxylase takes place in"},{"label":"A","text":"Mitochondria"},{"label":"B","text":"Endoplasmic reticulum"},{"label":"C","text":"Cytosol"},{"label":"D","text":"Nucleus 2 Even at very low blood glucose levels brain tissue can still get significant amount of glucose for energy. The reason is:"},{"label":"A","text":"Brain has a low affinity glucokinase that saturates easily with glucose."},{"label":"B","text":"Brain has a high affinity hexokinase that binds glucose and saturates at low concentrations."},{"label":"C","text":"Brain has no ability to dephosphorylate Glucose-1-P"},{"label":"D","text":"Brain tissue is able to convert fatty acids to glucose."},{"label":"A","text":"liver"},{"label":"B","text":"skeletal muscle"},{"label":"C","text":"adipose tissue"},{"label":"D","text":"both adipose and skeletal muscle tissues Which of the above glucose transporters mediates glucose uptake by pancreatic beta"},{"label":"A","text":"GLUT-4"},{"label":"B","text":"GLUT-2"},{"label":"C","text":"GLUT-5"},{"label":"D","text":"GLUT-3 Cyanide is an inhibitor of oxidative phosphorylation at complex ___acting by binding to _____"},{"label":"A","text":"Complex-IV by binding to cytochrome-c oxidase"},{"label":"B","text":"Complex-V by binding to protons"},{"label":"C","text":"Complex-II binding to cytochrome-c"},{"label":"D","text":"Complex-I by binding to cytochrome-c oxidase Cyanide, oligomycin, and 2,4-dinitrophenol (DNP) are inhibitors of mitochondrial aerobic phosphorylation. Which of the following statements correctly describes the mode of action of"},{"label":"A","text":"Cyanide and 2,4-dinitrophenol inhibit the respiratory chain, and oligomycin inhibits the synthesis of ATP."},{"label":"B","text":"Cyanide inhibits the respiratory chain, whereas oligomycin and 2,4-dinitrophenol inhibit the synthesis of ATP."},{"label":"C","text":"Cyanide, oligomycin, and 2,4-dinitrophenol compete with O2 for cytochrome oxidase (ComplexIV)."},{"label":"D","text":"Oligomycin and cyanide inhibit synthesis of ATP; 2,4-dinitrophenol inhibits the respiratory chain. Which of the following is the major circulating ketone body during starvation and or diabetes"},{"label":"A","text":"Beta-hydroxybutyrate"},{"label":"B","text":"Acetoacetate"},{"label":"C","text":"Acetone"},{"label":"D","text":"Acetoacryl-coA Almost all metabolic disturbances in alcohol toxicity can be explained by which of the"},{"label":"A","text":"Depletion of NAD+"},{"label":"B","text":"Elevated pyruvate concentration 3"},{"label":"C","text":"High ATP/AMP ratio"},{"label":"D","text":"Depletion of TCA intermediates What is the use of converting pyruvate to lactic acid during strenuous exercise or in"},{"label":"A","text":"To regenerate NAD+ from NADH so that glycolysis can continue"},{"label":"B","text":"Liver prefers lactic acid for gluconeogenesis"},{"label":"C","text":"Balance of body pH"},{"label":"D","text":"Lactic acid can be converted to glucose via Cori cycle"},{"label":"A","text":"ATP"},{"label":"B","text":"FADH"},{"label":"C","text":"hexokinase"},{"label":"D","text":"acetone Succinate-ubiqunone-oxidoreductase is also known as:"},{"label":"A","text":"Comples-II"},{"label":"B","text":"Complex-IV"},{"label":"C","text":"Complex-V"},{"label":"D","text":"Complex-I The end product of oxidation of odd carbon fatty acids is:"},{"label":"A","text":"Phytanic acid"},{"label":"B","text":"Propionic acid"},{"label":"C","text":"Acetic acid"},{"label":"D","text":"Oxaloacetate In terms of the time required to produce ATP energy on oxidation, how would you"},{"label":"A","text":"Fatty acids, glucose, amino acids and lastly ethanol"},{"label":"B","text":"Ethanol, amino acids, fatty acids and lastly glucose"},{"label":"C","text":"Glucose, fatty acids, ethanol and lastly amino acids"},{"label":"D","text":"Ethanol, glucose, fatty acids and lastly amino acids During gluconeogenesis which of the following crosses the inner mitochondrial"},{"label":"A","text":"Malic acid"},{"label":"B","text":"Oxaloacetic acid"},{"label":"C","text":"Pyruvic acid"},{"label":"D","text":"Citric acid Reactive oxygen species can result from all of the following processes except which"},{"label":"A","text":"Oxidative phosphorylation"},{"label":"B","text":"Respiratory burst"},{"label":"C","text":"Oxygen transport"},{"label":"D","text":"Glycolysis 4 Excessive carbohydrate catabolism can lead to ketone body formation"},{"label":"A","text":"TRUE"},{"label":"B","text":"FALSE Cori cycle dominates during marathon"},{"label":"A","text":"TRUE"},{"label":"B","text":"FALSE Alcohol increases acetyl-coA on oxidation thus inhibiting carbohydrate catabolism"},{"label":"A","text":"TRUE"},{"label":"B","text":"FALSE Carbon monoxide is an efficient electron transport enhancer"},{"label":"A","text":"TRUE"},{"label":"B","text":"FALSE Mobilization of liver glycogen is stimulated mainly by glucagon"},{"label":"A","text":"TRUE"},{"label":"B","text":"FALSE Lactate dehydrogenase H4 isoform is found in heart muscles"},{"label":"A","text":"TRUE"},{"label":"B","text":"FALSE The reason why erythrocytes do not have nucleus is that a nucleus would occupy too large space for hemoglobin binding and transportation"},{"label":"A","text":"TRUE"},{"label":"B","text":"FALSE Because of differences in pyruvate kinase affinities to their substrates the fetus can survive even when maternal blood is hypoglycemic."},{"label":"A","text":"TRUE"},{"label":"B","text":"FALSE Although TCA cycle produces 30 net moles of ATP, it is 100 times less efficient than oxidative phosphorylation in efficiency."},{"label":"A","text":"TRUE"},{"label":"B","text":"FALSE During fatty acid oxidation the liver secretes ketone bodies in the blood because that is the only way the liver could export metabolic fuel derived from fatty acids to extra- hepatic tissues."},{"label":"A","text":"TRUE"},{"label":"B","text":"FALSE Thiamine deficiency in childhood lead to retarded general growth"},{"label":"A","text":"TRUE"},{"label":"B","text":"FALSE Serious mutations of the pyruvate dehydrogenase complex are usually lethal"},{"label":"A","text":"TRUE 5"},{"label":"B","text":"FALSE Marching in the missing enzymes in the following diagram of glycolysis"}],"priority":2,"status":"review","flags":["too_many_options_possible_merge","duplicate_option_labels","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Water, pH and Buffers","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","duplicate_option_text","nonunique_option_labels","nonunique_option_text","prior_structural_review_flag","too_many_options","too_many_options_possible_merge"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-33acfcf048a3","stem":"PYRUVATE KINASE Defective enzymes can be as the results of ...................... Which of the following is one among the allosteric enzyme?","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Proteins and Enzymes","topicOriginal":"Proteins and Enzymes","subtopic":"Enzyme","suggestedTopic":null,"options":[{"label":"A","text":"Genetic Mutations"},{"label":"B","text":"Bacterial or Viral infections"},{"label":"C","text":"Temperature"},{"label":"D","text":"A and B Deficiencies in the quantity or Enzyme catalytic activity can result from ......................"},{"label":"A","text":"Genetic Defects"},{"label":"B","text":"Nutritional imbalances"},{"label":"C","text":"Toxins"},{"label":"D","text":"All of the above 6 Defective enzymes can be corrected by one of the following methods ..............."},{"label":"A","text":"Gene therapy"},{"label":"B","text":"Allosteric enzymes"},{"label":"C","text":"Allosteric inhibitors"},{"label":"D","text":"None of the above Enzymes deficits and imbalances can be remade by ........................"},{"label":"A","text":"Inhibitor or stimulator"},{"label":"B","text":"Gene therapy"},{"label":"C","text":"Allosteric inhibitor"},{"label":"D","text":"Balance of Salinity environment Enzymes are effective and highly specific catalysts for their ........................"},{"label":"A","text":"Active sites"},{"label":"B","text":"Catalytic sites"},{"label":"C","text":"Substrates"},{"label":"D","text":"Substrate binding sites Enzymes are stereo specific catalysts and typically catalyse reactions of only one stereoisomer of a given compound eg. ..................."},{"label":"A","text":"D-but not L sugars"},{"label":"B","text":"D and L sugars"},{"label":"C","text":"L-but not D Amino acids"},{"label":"D","text":"A and C The commonly used names of the enzymes describe the ......................"},{"label":"A","text":"Type of reaction"},{"label":"B","text":"Stereotype of the substrate"},{"label":"C","text":"Amount of substrate"},{"label":"D","text":"Discoverer Atomic rearrangements in configuration is mainly achieved by ......................."},{"label":"A","text":"Transferases"},{"label":"B","text":"Isomerases"},{"label":"C","text":"Reductases"},{"label":"D","text":"Decarboxylases Prosthetic groups, Cofactors and Coenzymes affect the catalytic capability of the enzymes by inducing the configuration of active site by binding on to ....................."},{"label":"A","text":"Hydrogen bonding"},{"label":"B","text":"Van de wall forces"},{"label":"C","text":"Aminoacyl side chains"},{"label":"D","text":"FAD Among the other, ........................... is one of the prosthetic groups which binds tightly to enzyme structure"},{"label":"A","text":"Biotin"},{"label":"B","text":"Vitamin A 7"},{"label":"C","text":"Metalloenzymes"},{"label":"D","text":"Metalloproteinase Ester compound can be catalysed by enzyme from of the following classes"},{"label":"A","text":"Esterase"},{"label":"B","text":"Hydrolases"},{"label":"C","text":"Decarboxylases"},{"label":"D","text":"Oxdoreductase Enzymes like Pyruvate decarboxylase is cosubstrated by ....................."},{"label":"A","text":"Niacin"},{"label":"B","text":"Mg2+"},{"label":"C","text":"TTP/TPP"},{"label":"D","text":"Biotin Mechanisms of enzymes catalytic activities are largely dependent on several factors including Enzyme-substrate bond strain and ..............................."},{"label":"A","text":"Proximity orientation"},{"label":"B","text":"Protein-protein interaction"},{"label":"C","text":"Hydrogen bonding"},{"label":"D","text":"Ester bond Induced fit model is further describing the enzyme catalytic power by ....................."},{"label":"A","text":"Proximity and reorientation of bonds at the active site"},{"label":"B","text":"Emphasizing key and lock model"},{"label":"C","text":"None of the options"},{"label":"D","text":"Transforming the catalytic site"},{"label":"A","text":"Aldolase"},{"label":"B","text":"phosphofructokinase-1"},{"label":"C","text":"Esterase"},{"label":"D","text":"Glycerol 6-phosphate dehydrogenase The following statements about cofactors are true EXCEPT"},{"label":"A","text":"Cofactors are the non-protein portion of the enzyme"},{"label":"B","text":"Cofactors may be altered during the enzymatic reactions."},{"label":"C","text":"Cofactors may be supplied in the diet."},{"label":"D","text":"Cofactors are not consumed by the enzymatic reaction. Turnover rate of an enzyme is defined as:"},{"label":"A","text":"Number of enzymes molecules per minute"},{"label":"B","text":"Number of substrate molecules converted to product per unit time"},{"label":"C","text":"Number of product molecules formed"},{"label":"D","text":"Concentration of substrate divide by that of product 8 In TPP deficiency, fatty acids are not completely oxidized to acetyl CoA. Gluconeogenesis during fasting is therefore low, because acetyl CoA is required to activate..."},{"label":"A","text":"Phosphoenolpyruvate carboxykinase."},{"label":"B","text":"Glucose 6-phosphatase."},{"label":"C","text":"Fructose 1,6-bisphosphatase."},{"label":"D","text":"Pyruvate carboxylase Non-competitive inhibitor"},{"label":"A","text":"Increase the rate of substrate binding"},{"label":"B","text":"Cannot be overcome by addition of more substrate"},{"label":"C","text":"Bind to the enzyme-substrate complex"},{"label":"D","text":"Can be overcome by addition of more substrate Feedback mechanism is one of mechanism of enzyme catalysed reactions"},{"label":"A","text":"True"},{"label":"B","text":"False"},{"label":"C","text":"A and B"},{"label":"D","text":"None of the above ALP is significantly used to monitor and diagnosis of Renal and Bone cirrhosis"},{"label":"A","text":"False"},{"label":"B","text":"No answer"},{"label":"C","text":"True"},{"label":"D","text":"All of the above The choice for the use of the certain enzyme to be used for clinical purposes depend on"},{"label":"A","text":"Enzyme specificity"},{"label":"B","text":"Enzyme turn over number"},{"label":"C","text":"Tissue of origin"},{"label":"D","text":"A and C The most important allosteric inhibitor of glycolysis in resting muscle is"},{"label":"A","text":"AMP."},{"label":"B","text":"H+."},{"label":"C","text":"ATP."},{"label":"D","text":"Fructose- 2, 6- bisphosphate. Enzymes involved in the process of transamination of amino acids are collectively called:"},{"label":"A","text":"Alanine transaminase"},{"label":"B","text":"Aspartate transaminase"},{"label":"C","text":"Aspartate amino transferase"},{"label":"D","text":"Amino transferases TPP and Pantothenic acid are responsible for the Oxidative decarboxylation of Pyruvate to produce Acetyl-CoA, CO2 and NADH"},{"label":"A","text":"False"},{"label":"B","text":"True"},{"label":"C","text":"Including Vit. B6 9"},{"label":"D","text":"All of the above"}],"priority":2,"status":"review","flags":["too_many_options_possible_merge","duplicate_option_labels","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Proteins and Enzymes","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","duplicate_option_text","nonunique_option_labels","nonunique_option_text","prior_structural_review_flag","too_many_options","too_many_options_possible_merge"],"cleaningOperations":["option_whitespace_normalization","whitespace/page_marker_normalization"]},{"id":"q-aa2e856f642d","stem":"Anaerobic respiration is an obligatory process for which cells?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Heart muscles"},{"label":"B","text":"Red blood cells"},{"label":"C","text":"Neurons"},{"label":"D","text":"Hepatocytes"}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"99db2594e106d3f989c20b172f877bdf3ac2ca15"},{"id":"q-102d7181586b","stem":"Between white and brown muscles which of the following is TRUE?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Brown muscles are more anaerobic than white muscles"},{"label":"B","text":"Brown muscles are more aerobic than white muscles"},{"label":"C","text":"White muscles and brown muscles have no difference"},{"label":"D","text":"White muscles are more anaerobic than brown muscles"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"795e12696c0433ab4cd4a7ff2f78a9eb695ea56f"},{"id":"q-f4994df4dd40","stem":"If someone has a defective triose-phosphate isomerase, what do you think will happen to glycolysis?","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Carbohydrate Metabolism","topicOriginal":"Carbohydrate Metabolism","subtopic":"Glycolysis","suggestedTopic":null,"options":[{"label":"A","text":"The flow of glucose through glycolysis will stop"},{"label":"B","text":"ATP production will increase by 50%"},{"label":"C","text":"Nothing will happen"},{"label":"D","text":"The efficiency of glycolysis will be reduced to half"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Carbohydrate Metabolism","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-c403aaa6a9bd","stem":"Glycerol enters the glycolytic pathway through which of the following?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Pyruvate"},{"label":"B","text":"Lactate"},{"label":"C","text":"Dihydroxyacetone-phosphate"},{"label":"D","text":"Phosphofructokinase-1 10"}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-4696b16d3e51","stem":"Presence of 2,3-bisphosphoglycerate in blood is important in which of the following?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It increase delivery of oxygen to the tissues by reducing Hb affinity for oxygen"},{"label":"B","text":"It increases the binding of oxygen to Hb in the lungs"},{"label":"C","text":"It reduces oxygen deliver to the foetus at the placenta"}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-d60dfb7bcecb","stem":"In alcohol intoxication, which of the following is the major cause of all problems?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Acetaldehyde production which causes hangover"},{"label":"B","text":"Accumulation of lactic acid in the liver"},{"label":"C","text":"Increase in NADH/NAD+ ratio halting all important catabolic pathways and gluconeogenesis"},{"label":"D","text":"Rapid absorption of alcohol thus killing most epithelial cells"}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-3e29ee699301","stem":"In gluconeogenesis, 12 molecules of acetyl-coA entering the TCA cycle can produce how many glucose molecules?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Two"},{"label":"B","text":"Six"},{"label":"C","text":"Four"},{"label":"D","text":"Zero"}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-d09f4a288122","stem":"Which of the following pathways are involved in a complete oxidation of a triacyl-glycerol to CO2 and H2O?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Pentose phosphate pathway, glycolysis, beta oxidation and TCA cycle"},{"label":"B","text":"Glycolysis, TCA and Oxiphos"},{"label":"C","text":"Oxiphos, TCA and beta oxidation"},{"label":"D","text":"Beta oxidation, glycolysis, TCA and Oxiphos"}],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-27b6224dc25b","stem":"Protein rich diets are recommended for persons with type-2 diabetes. However, amino acids from protein digestion can be converted to glucose. How is it that proteins don’t elevate blood glucose level in diabetes?","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"Diabet","suggestedTopic":null,"options":[{"label":"A","text":"Gluconeogenesis is regulated by the amount of glucose in blood"},{"label":"B","text":"Not all amino acids form glucose"},{"label":"C","text":"Most of the proteins are completely oxidized in the TCA cycle thus don’t yield glucogenic intermediate"},{"label":"D","text":"Actually blood glucose level is elevated"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Endocrinology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleanin