ging","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-3545ddd0518d","stem":"Which of the following medication is used in the treatment of hyperkalaemia in acute renal failure","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Nephrology","topicOriginal":"Nephrology","subtopic":"Renal","suggestedTopic":null,"options":[{"label":"A","text":"Amlodipine"},{"label":"B","text":"Propranolol"},{"label":"C","text":"Amiloride 2"},{"label":"D","text":"Captopril"},{"label":"E","text":"Insulin"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Nephrology","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"20c55537f00fca38d1cdabae1a681156816a3130"},{"id":"q-e8332c3a3887","stem":"A 27 years old HIV patient started ARVs 6 months ago, presents with one month history of easy fatigability and progressive palpitation on exertion. Laboratory investigation revealed Hb 6.5g/dL, with macrocytosis. The most likely offending antiretroviral for this anaemia is","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"AZT"},{"label":"B","text":"3TC"},{"label":"C","text":"FTC"},{"label":"D","text":"ABC"},{"label":"E","text":"D4T"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-e33aead9848d","stem":"For the patient with history of fever, headache and neck stiffness, the most important investigation is","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Computerized tomography scan brain"},{"label":"B","text":"Magnetic resonance imaging brain"},{"label":"C","text":"Cerebrospinal fluid examination"},{"label":"D","text":"Complete blood counts"},{"label":"E","text":"Skull x-ray"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-94c3030f4827","stem":"In the management of type two diabetes mellitus, metformin primarily works by the following mechanism","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"Diabet","suggestedTopic":null,"options":[{"label":"A","text":"Decrease postprandial rise of blood glucose and increase glucose uptake by peripheral cells"},{"label":"B","text":"Reduce hepatic gluconeogenesis and promote peripheral glucose utilization"},{"label":"C","text":"Decrease the absorption of carbohydrates from the gastro-intestinal tract"},{"label":"D","text":"Stimulate the release of endogenous insulin from the pancreatic β-cells"},{"label":"E","text":"Increase insulin sensitivity in the peripheral tissues"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Endocrinology","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-7cec351f9b63","stem":"When acute upper gastrointestinal bleeding is suspected","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Gastroenterology and Hepatology","topicOriginal":"Gastroenterology and Hepatology","subtopic":"Gastro","suggestedTopic":null,"options":[{"label":"A","text":"Endoscopy is the investigation of choice in locating the site of bleeding"},{"label":"B","text":"Nasal Gastric Tube aspiration provide an accurate amount of blood loss"},{"label":"C","text":"Hypotension without tachycardia suggests alternative diagnosis"},{"label":"D","text":"A pulse rate of >100b/minute is most likely due to anxiety"},{"label":"E","text":"The absence of anaemia suggest moderate blood loss"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Gastroenterology and Hepatology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-bee719b8966b","stem":"A 50 years old man with history of hypertension and arteriosclerotic disease presents with acute onset of severe chest pain tearing in nature radiating to the back. On physical examination, he is in pain with BP of 200/100mmHg. Chest X-ray shows widened mediastinum. The most likely diagnosis is: 3","type":"Radiological Interpretation","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Severe hypertension"},{"label":"B","text":"Myocardial infarction"},{"label":"C","text":"Aortic dissection"},{"label":"D","text":"Congestive cardiac failure"},{"label":"E","text":"Unstable angina"}],"priority":1,"status":"review","flags":["topic_ge