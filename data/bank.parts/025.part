8962b10500","stem":"A patient has become infertile because a prolactinoma has developed in her anterior pituitary gland. Instead of surgical intervention, pharmacological intervention for treating this tumor includes which of the following drugs?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Bromocriptine"},{"label":"B","text":"Pergolide"},{"label":"C","text":"Quinoglide"},{"label":"D","text":"Cabergline"},{"label":"E","text":"Pramipexole."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a2711655c90d","stem":"A patient with hyperthyroidism is scheduled for thyroid gland surgery. In order to reduce the size and vascularity of the thyroid gland, making it technically easier to excise, which of the following drugs should be given before surgery?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Thiocyanate, perchlorate, or pertechnetate"},{"label":"B","text":"131Iodide"},{"label":"C","text":"Stable inorganic iodide"},{"label":"D","text":"Propylthiouracil"},{"label":"E","text":"Methimazole."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-246943dab3f0","stem":"After an immunocompromised patient undergoes surgery, which of the following antibiotics would be appropriate based on their bacteriostatic/bacteriocidal activities?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Rifampin"},{"label":"B","text":"Aminoglycosides"},{"label":"C","text":"Macrolides"},{"label":"D","text":"Chloramphenical"},{"label":"E","text":"β-lactam antibiotics."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-3e51b98940b6","stem":"Which of the following patient groups are highly susceptible to fungal infections?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Surgical patients"},{"label":"B","text":"ICU patients"},{"label":"C","text":"Patients with long-term intravenous catheter use"},{"label":"D","text":"Patients with organ transplants"},{"label":"E","text":"Patients with protheses."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b5cb7b710277","stem":"Drug resistance to chemotherapeutic drugs is becoming a serious medical problem. Drug resistance can result from","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Bacterial transfer of plasmids"},{"label":"B","text":"Chemoprophylaxis"},{"label":"C","text":"Use of antibiotics that are not indicated for the clinical situation"},{"label":"D","text":"Insensitivity to apoptosis"},{"label":"E","text":"Combination chemotherapy."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-76c3649726cd","stem":"Synergistic drug combinations include","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Penicillin and aminoglycoside"},{"label":"B","text":"Amphotericin B and flucytosine"},{"label":"C","text":"Histamine and epinephrine"},{"label":"D","text":"Flumaxenil and benzodiazepine"},{"label":"E","text":"Morphine and naloxone."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-73cb93c8fde4","stem":"Pharmacogenomic effects based on genetic changes in drug metabolic enzymes can lead to the following changes in drug responses","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Lack of anticoagulant response to a standard dose of coumarin"},{"label":"B","text":"Lack of anticoagulant response of a standard dose of heparin"},{"label":"C","text":"Lack of muscle relaxation by suxamethonium"},{"label":"D","text":"Prolonged action of suxamethonium, requiring assisted ventialtion for hours after a surgical procedure"},{"label":"E","text":"Malignant hyperthermia by potent inhalation anesthetics."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b9937466b53e","stem":"The choice of analgesics and anesthetics during pregnancy and labor should consider drug effects on the mother and the fetus or newborn as follows","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Central Nervous System Drugs","topicOriginal":"Central Nervous System Drugs","subtopic":"Anesthetic","suggestedTopic":null,"options":[{"label":"A","text":"Pethidine delays labor more than morphine"},{"label":"B","text":"General anesthesia is preferred rather than local anesthesia for Cesarean sections"},{"label":"C","text":"Ketamine is preferred for patients with eclampsia or pre-eclampsia"},{"label":"D","text":"Sulphonamides are preferred to avoid adverse effects in the newborn"},{"label":"E","text":"β-adrenoreceptor blockers are useful to treat fetal response to hypoxia."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Central Nervous System Drugs","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a09947aaf25f","stem":"A young child requires surgery, including several pre-operative drugs, anesthesia, and post-operative drugs. Which are the most effective ways to calculate pediatric drug dosages? Based on","type":"Calculation","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Age"},{"label":"B","text":"Body weight"},{"label":"C","text":"Surface area"},{"label":"D","text":"Standard ratio of adult dose"},{"label":"E","text":"Pediatric dosage in package insert. STUDENT VERSION Postgraduate Students Clinical Pharmacology 2006-2007 SUPPLEMENTAL FINAL EXAM"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f1132cf506e3","stem":"The following drugs have selective agonist action at beta1 receptors","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Salbutamol"},{"label":"B","text":"Ephedrine"},{"label":"C","text":"Suxamethonium"},{"label":"D","text":"Salmeterol"},{"label":"E","text":"Hyoscine"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-899f4d2a243a","stem":"The following statements about benzodiazepines are true","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"CNS Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"CNS Pharmacology","options":[{"label":"A","text":"They do not reduce anxiety"},{"label":"B","text":"They are used as hypnotics"},{"label":"C","text":"They have anticonvulsant properties"},{"label":"D","text":"They are effective antidepressants"},{"label":"E","text":"They are free of the risk of dependence"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"CNS Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-32e0f6e5ab72","stem":"Alpha-adrenoceptors","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Are sub classified in a similar way to beta-adrenoceptors i.e. Alpha I-receptors in the hearts and alpha 2-receptors in other tissues e.g. Lung."},{"label":"B","text":"The classical alpha-receptor is located post-junctionally on peripheral blood vessels and promotes vasoconstriction"},{"label":"C","text":"Alpha-adrenoceptor antagonists have useful antihypertensive properties"},{"label":"D","text":"Nor adrenaline stimulates both alpha and beta adrenoceptors"},{"label":"E","text":"Stimulation of alpha2 adrenoceptors can reduce blood pressure"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ccae5b38fd61","stem":"Ant cholinesterase drugs like Neostigmine are used in the following clinical conditions","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Myasthenia gravis"},{"label":"B","text":"Glaucoma"},{"label":"C","text":"Insecticides"},{"label":"D","text":"Motion sickness"},{"label":"E","text":"To overcome the effects of neuromuscular blockers"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8cd151805bb2","stem":"Tricyclic antidepressants","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Central Nervous System Drugs","topicOriginal":"Central Nervous System Drugs","subtopic":"Antidepressant","suggestedTopic":null,"options":[{"label":"A","text":"Include amitriptyline and Imipramine"},{"label":"B","text":"Have a wide range of pharmacological properties including alpha-receptor antagonist activity,anticholinergic effects and non-specific sedative effects"},{"label":"C","text":"Are extensively metabolized by the liver"},{"label":"D","text":"Have the advantage of safety in over dosage"},{"label":"E","text":"Exert their antidepressant effects within 2 to 3 days of initiating treatment"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Central Nervous System Drugs","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"3c6b0b559f4ae9c44d2f55c5201d02a5689ef74e"},{"id":"q-10879271444a","stem":"Common unwanted effects of Chlorpromazine include","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Dystonic reactions"},{"label":"B","text":"Hallucinations"},{"label":"C","text":"Mood elevation"},{"label":"D","text":"Anxiety"},{"label":"E","text":"Jaundice"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d7aa877aefa4","stem":"Drugs that antagonizes Acetylcholine at the nicotinic receptors at the Neuro-muscular junction include","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Suxamethonium"},{"label":"B","text":"Gallamine"},{"label":"C","text":"Pancuronium"},{"label":"D","text":"Atracurium"},{"label":"E","text":"Tubocurarine"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-680b049b6acf","stem":"Clinical indications for drugs having agonist effects at beta receptors include","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Treatment of asthma"},{"label":"B","text":"Preventing threatened abortion"},{"label":"C","text":"Congestive cardiac failure"},{"label":"D","text":"Hypertension"},{"label":"E","text":"Asthma PART TWO Answer all questions:"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-599584823051","stem":"Write notes on Digoxin under the following subheadings","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Cardiovascular Drugs · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Cardiovascular Drugs","options":[{"label":"A","text":"Mechanism of action"},{"label":"B","text":"Clinical uses"},{"label":"C","text":"Adverse effects [18 marks]"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular Drugs · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-bb03aaa46430","stem":"List 6 Clinical uses of drugs with anti-muscarinic activity giving examples [12 marks]","type":"Short Answer","subject":"Pharmacology","topic":"Autonomic Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Autonomic Pharmacology","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5f05ffcbdc8b","stem":"Soluble insulin","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Endocrine Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Endocrine Pharmacology","options":[{"label":"A","text":"Is more likely to cause local discomfort in a formulation at pH 3 than at pH 7."},{"label":"B","text":"If infused in a saline drip is subjected to substantial loss as a result of binding to the tubing."},{"label":"C","text":"Has a peak action at 30 to 60 minutes when given intravenously."},{"label":"D","text":"Is particularly useful for balancing patients who have heavy glycosuria before breakfast."},{"label":"E","text":"Is the only preparation suitable for intravenous use."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrine Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-524f73c1a939","stem":"Insulin causes","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Endocrine Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Endocrine Pharmacology","options":[{"label":"A","text":"Reduction of hepatic output of glucose."},{"label":"B","text":"Reduction of protein synthesis."},{"label":"C","text":"Enhances transit of potassium into cells."},{"label":"D","text":"Increased glucose uptake in peripheral tissues."},{"label":"E","text":"Down regulation of insulin receptors when its concentration is high, a factor in insulin resistance of obese diabetics."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrine Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","short_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"da78919f35f45898cbd29370b85a5476d035d5c2"},{"id":"q-fa55930ffdd4","stem":"Metformin, a biguanide","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Endocrine Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Endocrine Pharmacology","options":[{"label":"A","text":"May cause lactic acidosis."},{"label":"B","text":"Is particularly useful in alcoholic diabetic patients."},{"label":"C","text":"Causes hypoglycemia in non-diabetic patients."},{"label":"D","text":"Should be discontinued before major elective surgery."},{"label":"E","text":"Causes anorexia and weight loss."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrine Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"af4d7b090191098f62603d495ab1702c0d11d52c"},{"id":"q-49968eecff50","stem":"Drugs which can disturb the control of a diabetic patient include","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Mono-amine oxidase inhibitors."},{"label":"B","text":"Sulphonamides."},{"label":"C","text":"Aspirin."},{"label":"D","text":"Thiazide diuretics."},{"label":"E","text":"Oral contraceptives."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-632cfa052b53","stem":"The following about thyroid hormone treatment are correct","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Liothyronine finds its main use in myxoedema coma."},{"label":"B","text":"A dose of Liothyronine gives maximum effect in about 24 hours and passes off over a week."},{"label":"C","text":"A dose of thyroxine gives a maximum effect in about 10 days and passes off over 2 to 3 weeks."},{"label":"D","text":"Over treatment causes atrial fibrillation in patients over 60 years."},{"label":"E","text":"Over treatment causes exophthalmos."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-590d96dafab2","stem":"In hyperthyroidism","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Beta blockers reduce the circulating levels of thyroid hormone."},{"label":"B","text":"Carbimazole exerts its effect within 24 to 48 hours."},{"label":"C","text":"Lithium may exacerbate the symptoms."},{"label":"D","text":"Agranulocytosis is an important adverse effect of Carbimazole."},{"label":"E","text":"Radioiodine is the treatment of choice in young patients (under 40 years)"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8c2fd474573a","stem":"The following agents are useful in oral or implanted contraceptives","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Endocrine Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Endocrine Pharmacology","options":[{"label":"A","text":"Clomiphene."},{"label":"B","text":"Ethinyl-oestradiol."},{"label":"C","text":"Mestranol."},{"label":"D","text":"Norethindrone."},{"label":"E","text":"Norgestrel."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrine Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-81bc49efc969","stem":"The following are recognized effects of oral contraceptives","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Endocrine Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Endocrine Pharmacology","options":[{"label":"A","text":"Increased risk of myocardial infarction."},{"label":"B","text":"Nausea."},{"label":"C","text":"Oedema."},{"label":"D","text":"Increased risk of endometrial cancer."},{"label":"E","text":"Decreased risk of ovarian cancer"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrine Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7a5a8af9b5a2","stem":"The following are recognized effects of natural androgens or androgenic steroids","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Growth of facial hair."},{"label":"B","text":"Increased muscle bulk."},{"label":"C","text":"Increased milk production in nursing women."},{"label":"D","text":"Induction of a growth spurt in pubertal boys."},{"label":"E","text":"Cholestatic jaundice and elevation of AST levels in the blood."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6dae8d76edaa","stem":"Combined oestrogen-progestogen oral contraceptive agents","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Endocrine Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Endocrine Pharmacology","options":[{"label":"A","text":"Suppress pituitary secretion of LH and FSH."},{"label":"B","text":"Act primarily by altering the physical properties of cervical mucus."},{"label":"C","text":"Are relatively contraindicated in hypertensive women."},{"label":"D","text":"May precipitate migraine."},{"label":"E","text":"Are associated with an increased risk of thrombo-embolic disease."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrine Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ee5accdff053","stem":"In the combined hormone oral contraceptives","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Endocrine Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Endocrine Pharmacology","options":[{"label":"A","text":"The oestrogen component causes thickening of cervical mucus."},{"label":"B","text":"The progesterone component inhibits ovulation."},{"label":"C","text":"Endogenous secretion of Follicle Stimulating Hormone (FSH) and Lutenizing Hormone (LH) are increased."},{"label":"D","text":"The progestogen component is largely responsible for thrombo-embolic side effects."},{"label":"E","text":"The risk of an adverse effect is higher in women under 35 years of age."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrine Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c00db911b357","stem":"The following may cause hypercalcaemia","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Plicamycin."},{"label":"B","text":"Calcitonin."},{"label":"C","text":"Bisphosphonates."},{"label":"D","text":"Excess Vitamin D."},{"label":"E","text":"Thiazide diuretics."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-783caf2c4674","stem":"Disodium Etidronate is used","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"By intramuscular injection."},{"label":"B","text":"In Paget’s disease."},{"label":"C","text":"In hypercalcaemia of malignancy."},{"label":"D","text":"With calcium carbonate in established vertebral osteoporosis."},{"label":"E","text":"To inhibit bone resorption and formation."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f1d2ba71b63d","stem":"Cyclophosphamide is used for its immunosuppressive action in the following indications","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cystic fibrosis."},{"label":"B","text":"Autoimmune thrombocytopenia."},{"label":"C","text":"Nephrotic syndrome with minimal microscopic glomerular changes."},{"label":"D","text":"Nephrotic syndrome due to lupus erythematosus."},{"label":"E","text":"Wegener’s granulomatosis."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-050acb1bd689","stem":"Adverse effects associated with cyclosporine include","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Nephrotoxicity."},{"label":"B","text":"Nausea and gastro-intestinal disturbances."},{"label":"C","text":"Alopecia."},{"label":"D","text":"Tremor."},{"label":"E","text":"Hypokalaemia."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-68071dba0bf9","stem":"Which of the following drugs may be used to stimulate ovulation in infertile women","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ethinyl oestradiol."},{"label":"B","text":"Clomiphene."},{"label":"C","text":"Bromocriptine."},{"label":"D","text":"Follicle Stimulating Hormone (FSH)."},{"label":"E","text":"Luteinising hormone (LH)."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b1851ba7ce74","stem":"The toxicity of thyroxine includes","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Endocrine Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Endocrine Pharmacology","options":[{"label":"A","text":"Intolerance to heat."},{"label":"B","text":"Diarrhoea."},{"label":"C","text":"Precipitation of angina pectoris."},{"label":"D","text":"Tremor."},{"label":"E","text":"Anorexia."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrine Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4455f99eb07b","stem":"The anaesthetic Thiopentone","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Central Nervous System Drugs","topicOriginal":"Central Nervous System Drugs","subtopic":"Anaesthetic","suggestedTopic":null,"options":[{"label":"A","text":"Produces analgesia."},{"label":"B","text":"May cause necrosis when given intravenously as a 2.5 percent solution."},{"label":"C","text":"Has a short duration of action because it is rapidly metabolized."},{"label":"D","text":"Is a barbiturate."},{"label":"E","text":"May cause laryngospasm."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Central Nervous System Drugs","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ab22b9dc31b6","stem":"Of Halothane, Enflurane and Isoflurane","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Halothane is most likely to cause hepatic necrosis."},{"label":"B","text":"Isoflurane is the least likely to cause cardiac dysrhythmias."},{"label":"C","text":"Halothane is used if rapid recovery is important."},{"label":"D","text":"Enflurane is the most potent anticonvulsant."},{"label":"E","text":"Isoflurane is the agent of choice during neuro-surgery."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-864b2e453fbc","stem":"Nitrous oxide","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Has a powerful analgesic property."},{"label":"B","text":"Is a powerful muscle relaxant."},{"label":"C","text":"After cessation of administration, diffusion hypoxia may occur."},{"label":"D","text":"Is contraindicated if pethidine has been administered."},{"label":"E","text":"Should not be premixed with oxygen."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["short_stem","topic_generic"],"cleaningOperations":[]},{"id":"q-a3ba8e8a942e","stem":"Propofol in comparison to Sodium Thiopentone","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cannot be used for induction of anaesthesia."},{"label":"B","text":"Has a longer elimination half-life."},{"label":"C","text":"Has no active metabolite."},{"label":"D","text":"Is less irritant."},{"label":"E","text":"Produces a more rapid ‘clear headed’ recovery."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-85323e4077ed","stem":"Lignocaine, a local anaesthetic","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Central Nervous System Drugs","topicOriginal":"Central Nervous System Drugs","subtopic":"Anaesthetic","suggestedTopic":null,"options":[{"label":"A","text":"Prevent the rapid inflow of Sodium ions which is the ionic basis of the Action Potential."},{"label":"B","text":"Causes vasoconstriction."},{"label":"C","text":"Is not absorbed from the urethra."},{"label":"D","text":"Can be combined with adrenaline for digital ‘ring’ blocks."},{"label":"E","text":"Has a shorter duration of action than Bupivacaine."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Central Nervous System Drugs","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"4ab040431a1be72ebbba947432d833f0b136004d"},{"id":"q-fc8e06d42ee8","stem":"A desirable local anaesthetic should","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Central Nervous System Drugs","topicOriginal":"Central Nervous System Drugs","subtopic":"Anaesthetic","suggestedTopic":null,"options":[{"label":"A","text":"Be non-irritant to tissues."},{"label":"B","text":"Have a slow onset of action."},{"label":"C","text":"Be soluble in water."},{"label":"D","text":"Be sterilisable by heat."},{"label":"E","text":"Have a built in vasodilator action."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Central Nervous System Drugs","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-62263b3c16f0","stem":"Butyrophenones (e.g. Haloperidol) in comparison to Phenothiazines (e.g. Chlorpromazine are generally","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Less sedating."},{"label":"B","text":"Less hypotensive."},{"label":"C","text":"Less anti-muscarinic."},{"label":"D","text":"Have more extra-pyramidal effects."},{"label":"E","text":"Not contraindicated in epilepsy."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9d30062aa761","stem":"Lithium toxicity can be precipitated by","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Sodium depression."},{"label":"B","text":"Thiazide therapy."},{"label":"C","text":"ACE-inhibitors."},{"label":"D","text":"Non-steroidal anti-inflammatory drugs."},{"label":"E","text":"Atenolol."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d92370e6cc2f","stem":"The pain of Paget’s disease of bone may be relieved by","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Improving the blood supply with Tocophero’s."},{"label":"B","text":"Inhibiting bone resorption with Calcitonin."},{"label":"C","text":"Inhibiting crystal formation with Diphosphonates."},{"label":"D","text":"Inhibiting osteoclats with a cytotoxic agent."},{"label":"E","text":"Increasing activity with Parathormone."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0489105dc7ca","stem":"The diuretic Chlorothiazide","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Cardiovascular Drugs","topicOriginal":"Cardiovascular Drugs","subtopic":"Diuretic","suggestedTopic":null,"options":[{"label":"A","text":"Is effective orally."},{"label":"B","text":"Causes Potassium retention."},{"label":"C","text":"Antagonizes the action of Digoxin."},{"label":"D","text":"Can aggravate diabetes mellitus."},{"label":"E","text":"Accelerate both Sodium and Chloride loss."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular Drugs","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ef3bd123887c","stem":"In the management of medical conditions during pregnancy","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Warfarin should never be given in the first trimester."},{"label":"B","text":"Plasma levels tend to fall during pregnancy."},{"label":"C","text":"Aspirin can safely be used except in the trimester."},{"label":"D","text":"Ampicillin is teratogenic."},{"label":"E","text":"Chlorpropamide is useful in management of diabetes mellitus."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-848c9d88cd01","stem":"In pregnancy","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Most drugs cross the placenta by active transport."},{"label":"B","text":"Ionized drugs cross the placenta more easily than unionized drugs."},{"label":"C","text":"Drugs that reduce placental blood flow can reduce birth weight."},{"label":"D","text":"Feotal blood-brain barrier is not developed until the second half of pregnancy."},{"label":"E","text":"The human placenta metabolizes endogenous steroids. SECTION B"}],"priority":0,"status":"practice_draft","flags":["short_or_incomplete_stem","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["short_or_incomplete_stem","short_stem","topic_generic"],"cleaningOperations":[]},{"id":"q-4e0789ee2bbc","stem":"What is the likely cause of her metabolic disturbance and leg weakness; and how would treat it?","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-37b7744fdba9","stem":"Advantages of intensified over conventional insulin therapy","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Endocrine Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Endocrine Pharmacology","options":[{"label":"A","text":"less injections"},{"label":"B","text":"less hypoglycaemia"},{"label":"C","text":"reduced microvascular damage"},{"label":"D","text":"Easier to implement in children"},{"label":"E","text":"Easier to implement in mentally retarded patients"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrine Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2d190974642f","stem":"Pancreatic islets","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Alpha cells (A cells) secrete the hormone insulin."},{"label":"B","text":"Beta cells (B cells) produce glucagons and are the most abundant of the islet cells."},{"label":"C","text":"Delta cells (D cells) secrete the hormone insulin"},{"label":"D","text":"Somatostatin is synthesized and secreted from alpha cells"},{"label":"E","text":"glucagon has the effect of increasing blood glucose levels"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"fb670c1f637831f9e500258db1246d2e658f2e36"},{"id":"q-349856db43ad","stem":"Increased secretion of glucagon is caused by","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"decreased plasma glucose (hypoglycemia ) and fatty acids"},{"label":"B","text":"decreased catecholamines - norepinephrine and epinephrine"},{"label":"C","text":"decreased plasma amino acids (particularly arginine)"},{"label":"D","text":"Sympathetic nervous system by an action on ß-adrenoceptors"},{"label":"E","text":"Somatostatin"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"fa88b1352d57bd447d618f549d05b47a0f0c7b87"},{"id":"q-aacf64d0badc","stem":"Angiotensin converting enzyme inhibitor .........T...reduce preload .........F...are positive inotropes ......F......do not cause cough .........T...no effect on after load .........F...causes muscles fasciculation 23 Which of the following induces microsomal enzymes?","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-e376baf3678f","stem":"Besides anxiolytic activity, benzodiazepines are useful as .........T...hypnotics .........T...muscle relaxants .........T...anticonvulsants .........F...analgesic ......F......bronchodilators SHORT ANSWER QUESTIONS Answer ALL Questions.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"CNS Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"CNS Pharmacology","options":[{"label":"A","text":"Write short notes on"},{"label":"A","text":"The effect of H2 antagonists on the absorption of Ketaconazole. (2marks) ANSWER Ketoconazole is a weak base insoluble in water ionized only at a low pH. Absorption of these compounds is heavily dependent on acidic gastric conditions in the stomach .Drugs that increase gastric pH. (e.g., H2 antagonists, proton pump inhibitors slow the dissolution of the solid dosage forms and decrease drug available for absorption in the intestinal lumen."},{"label":"B","text":"Mechanism of ACE inhibitors (4marks) ANSWER • Reversibly inhibits Angiotensin converting enzyme which converts Angiotensin I to angiotensin II • Inhibition of Angiotensin II formation reduces vasoconstriction (reduce peripheral vascular resistance) and blood pressure."},{"label":"C","text":"Difference between ACE inhibitors and AT1receptor blockers (4marks) |ACE inhibitors |AT1receptor blockers | |Cause activation of Bradykinin (Vasodilatation)-Reduce |Lack of “bradykinin” effects | |bradykinin metabolism causing angiodema | | |Competitive inhibitor of angiotensin converting enzyme |Competitive inhibitor of AT1 receptors | |Dry cough is a side effect |No dry cough | | | |"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"CNS Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-4db0eb73b6fd","stem":"Mention 4 mechanisms of drug resistance to antibiotics. (4marks) ANSWER","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Destroying or inactivating the antibiotic;"},{"label":"B","text":"Altering the target site receptor for the antibiotic"},{"label":"C","text":"Preventing the entry of the antibiotic into the bacterium"},{"label":"D","text":"Modulating gene expression"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f3be383719cb","stem":"Explain why reflex tachycardia is more pronounced in non selective alpha antagonists (phenoxybenzamine) than selective alpha one antagonist (Pazosin). (10marks) ANSWER Non alpha antagonists block α1 and α2 adrenergic receptors. α2 adrenergic receptors located in presynaptic adrenergic nerve terminals and modulates NE release through G-coupled AC inhibition. Prazosin is a relatively specific α1-adrenoceptor antagonist. It causes less tachycardia than the nonselective antagonists because the α2 adrenergic receptors which when activated reduce NE release are not blocked by this drug.","type":"Short Answer","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["possible_web_capture_contamination"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["possible_web_capture_contamination"],"cleaningOperations":[]},{"id":"q-291cb2ce410b","stem":"Thiazide diuretics","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Cardiovascular Drugs","topicOriginal":"Cardiovascular Drugs","subtopic":"Diuretic","suggestedTopic":null,"options":[{"label":"A","text":"How do they exert their effect at cellular level?(6 marks) ANSWER • Exert their diuretic effect by inhibiting the Na+ - Cl- co transport in the early distal convoluted tubules. • Less reabsorption of water and electrolytes in the distal convoluted tubule than proximal tubule or loop • Increase the loss of K+ and Mg2+, but reduce Ca2+ excretion • [pic]"},{"label":"B","text":"Mention 3 side effects associated with their use. (3marks) ANSWER • may cause hypercalcemia • hypo magnesia • hypokalemia • hyponatremia • decreased libido • hyperuriceamia • metabolic alkalosis"},{"label":"C","text":"Which other diuretic can cause hyperuriceamia? (1mark) ANSWER Loop diuretics"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular Drugs","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"3063f356560d6619bc519b80e37173c8189ebbe1"},{"id":"q-d186ee9cbaef","stem":"How alpha methyl dopa lowers blood pressure.(10 marks) ANSWER • Analogue of the catecholamine precursor L-dopa that has hypotensive actions arising from its conversion to a false transmitter alpha methylnorepinephrine to act on presynaptic or post synaptic alpha 2 receptors. • The alpha methyl norepinephrine partially displaces NE in synaptic vesicles and alpha methyl norepinephrine is released in place of neurotransmitter. • The hypotensive property of methyldopa is attributable to actions of its metabolite in the brain not in the periphery.","type":"Short Answer","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b5e78954810d","stem":"Explain the mode of action of Tricyclic antidepressants (6 marks) ANSWER ▪ They block uptake of amines by nerve terminals. Synthesis of amines, storage in synaptic vesicles and release are not directly affected. ▪ Increase the concentrations of these transmitters at the post synaptic effectors site , ▪ Specifically bock reuptake of the neurotransmitter norepinephrine and 5HT uptake by brain cells, but have much less effect on dopamine uptake.","type":"Short Answer","subject":"Pharmacology","topic":"Central Nervous System Drugs","topicOriginal":"Central Nervous System Drugs","subtopic":"Antidepressant","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Central Nervous System Drugs","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-4cb827580360","stem":"What are the major side effects of the following anti TB drugs .(10marks)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Rifampicin ANSWER • The drug has an orange red color in body excretions, this color will be imparted to all body fluids. • Induce microsomal drug metabolizing enzymes. This will decrease the half-life of some other drugs. (ie. phenytoin, digitoxin) • Skin Eruptions • G.I. reactions: Anorexia, Nausea ,Vomiting Mild abdominal pain, Hepatic Reactions in children, pregnant women and alcoholics, can result in minor elevations in serum transaminase as some jaundice"},{"label":"B","text":"Isoniazide ANSWER • hepatotoxicity. • Peripheral neuritis • haemolytic anaemia in individuals with glucose-6-phosphate deficiency • decreases the metabolism of the antiepileptic agents, phenytoin, ethosuximide and carbamazepine, resulting in an increase in the plasma concentration and toxicity of these drugs."},{"label":"C","text":"Ethambutol ANSWER • Optic neuritis, which is dose-related and is more likely to occur if renal function is decreased. It results in visual disturbances: initially red/green color blindness followed by a decrease in visual acuity. • Color vision should be monitored during prolonged treatment."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"6066b99e224492bae2cf07d436cb2bb4328a7e66"},{"id":"q-853e2eaaa0df","stem":"Write short notes on Cytochrome P450 and antifungal drug interactions. (10marks) ANSWER All of the azole-class antifungals are metabolized to some degree by the CYP P450 system. • the type of CYP metabolism and degree to which the azole is metabolized is governed by a number of factors including the physiochemical properties of the drug (lipophilicity) and pharmacokinetics. • Because ketconazole and itraconazole are highly lipophilic, their clearance is heavily dependent upon metabolism through several CYP 450 pathways including CYP 3A4. • Co-administration of azoles with drugs that induce or accelerate strongly CYP-450 metabolism, particularly CYP 3A4, can result in low or undetectable levels of the azole antifungal • Higher antifungal dosages (particularly of ketoconazole, itraconazole, voriconazole) cannot overcome this interaction.","type":"Essay / Structured Essay","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Pharmacokinetic","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-cea5925a08b8","stem":"Explain antiretroviral combination drugs used for Individuals with Tuberculosis co- infection. (10marks) ANSWER ▪ In cases of the need for TB and HIV treatment concurrently, 1st line options (ZDV/3TC/EFV or d4T/3TC/EFV. [pic]","type":"Clinical Vignette","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2bc768b7d4f6","stem":"Which of the following terms is least compatible with modern clinical studies of drugs","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Randomization of patients"},{"label":"B","text":"Conducted prospectively"},{"label":"C","text":"Control group"},{"label":"D","text":"Interventional"},{"label":"E","text":"Analysis of patient data “per protocol”"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-01db0ad47860","stem":"ACE inhibitors do not lead to","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Cardiovascular Drugs · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Cardiovascular Drugs","options":[{"label":"A","text":"Cough"},{"label":"B","text":"Hypotension"},{"label":"C","text":"Hyperkalaemia"},{"label":"D","text":"Gynecomastia"},{"label":"E","text":"Angioedema"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular Drugs · Suggested","answerAuditStatus":"independent_checked","sourceAnswerTrusted":false,"publicationStatus":"checked_explained","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e1dce7ef9145","stem":"Which of the following is not true?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"ACE treatment of a heart failure starts with a fraction of the target dose"},{"label":"B","text":"Potassium and creatinine should be regularly measured in ACE-treated patients"},{"label":"C","text":"ACE inhibitors should be combined with potassium-saving drugs"},{"label":"D","text":"ACE inhibitors should be replaced with AT1 receptor blockers in patients who develop cough"},{"label":"E","text":"ACE inhibitors can be combined with beta blockers"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"6bf59dd369bced723f8e7d95ea92533316a7bad6"},{"id":"q-70e546a31b44","stem":"Which of the following side effects is atypical for loop diuretics","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Cardiovascular Drugs","topicOriginal":"Cardiovascu