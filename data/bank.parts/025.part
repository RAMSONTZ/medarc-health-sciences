nStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0b90e084af7f","stem":"Detoxification can be accomplished by giving","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ipeacac F"},{"label":"B","text":"Fumepizole T"},{"label":"C","text":"Sodium nitrate T"},{"label":"D","text":"Deferox amine F"},{"label":"E","text":"Trientine T"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"ea3d08eb9e153b717657ec0703fad9be0b2d64d0"},{"id":"q-f6e95619ae7d","stem":"A patient who is scheduled to undergo surgery in 3 days is experiencing depression regarding the event. An antidepressant that would be appropriate to give to this patient would be","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Central Nervous System Drugs","topicOriginal":"Central Nervous System Drugs","subtopic":"Antidepressant","suggestedTopic":null,"options":[{"label":"A","text":"The tricyclic antidepressant, imipramine"},{"label":"B","text":"The selective serotonin reuptake inhibitor, fluoxetine"},{"label":"C","text":"The monoamine oxidase inhibitor, tranylcypromine"},{"label":"D","text":"The atypical antidepressant, bupropion"},{"label":"E","text":"An antidepressant is not appropriate for this patient."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Central Nervous System Drugs","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-4d4c87a78ce9","stem":"A patient has awakened from anesthetic, after a long and complicated surgical procedure. His physician advises the patient on the possibility that some permanent disability may remain with the patient. The patient responds with fear and anxiety at the prospect of loss of the ability to earn a living. To help the patient through the recovery process, the best sedative/anxiolytic agent from the following list that his doctor could give is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Central Nervous System Drugs","topicOriginal":"Central Nervous System Drugs","subtopic":"Anesthetic","suggestedTopic":null,"options":[{"label":"A","text":"Diazepam"},{"label":"B","text":"Chloral hydrate"},{"label":"C","text":"Buspirone"},{"label":"D","text":"Alprazolam"},{"label":"E","text":"Phenobarbital"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Central Nervous System Drugs","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7f1c8c11d818","stem":"A patient has completed surgery, but is having difficulty sleeping, due to the discomfort remaining after the surgery. His physician decides to give an hypnotic agent. Which drugs on the following list would be preferred based on efficacy and safety?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Secobarbital"},{"label":"B","text":"Zaleplon"},{"label":"C","text":"Flurazepam"},{"label":"D","text":"Chloral hydrate"},{"label":"E","text":"Zolpidem"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubje