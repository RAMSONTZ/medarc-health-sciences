pic":"Antimicrobials","options":[{"label":"A","text":"Gentamicin"},{"label":"B","text":"Heparin"},{"label":"C","text":"Streptomycin"},{"label":"D","text":"Digoxin"},{"label":"E","text":"Oestrogen"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e174f0d4c90a","stem":"The following are true with regard to dapsone except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Is used in the treatment of amoebiasis"},{"label":"B","text":"Is indicated in multibacillary leprosy"},{"label":"C","text":"Is used in the treatment dermatitis herpictiformis"},{"label":"D","text":"Is acylelated in the liver"},{"label":"E","text":"Has cross-sensitivity with suplphonamides"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-399d130932c6","stem":"Zidomidine (AZT)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Is used for treatment of HIV infection in this country"},{"label":"B","text":"Is administered by subcutaneous injection"},{"label":"C","text":"Is a protease inhibitor"},{"label":"D","text":"Should be stopped if co-trimoxazole is required"},{"label":"E","text":"Is of no value in alte stage AIDS"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7684b7b339ff","stem":"Adverse effects associated with AZT include all of the following except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Dose-dependent reticulocytopenia"},{"label":"B","text":"Dose-dependent granulocytopenia"},{"label":"C","text":"Nausea and vomiting"},{"label":"D","text":"Cough"},{"label":"E","text":"Blue-grey nail discoloration"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1a8b50c99669","stem":"All of the following are false with regard to chloroquine except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Only injures plasmodium when the parasite is extracellular"},{"label":"B","text":"Must be given by intravenous infusion in Pr vivax malaria"},{"label":"C","text":"Can cause irreversible visual loss when used as prolonged therapy"},{"label":"D","text":"Should not be co-prescribed with proguanil"},{"label":"E","text":"Is contraindicated in children under 10 years"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c337cf60f894","stem":"Quinine sulphate","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Is of no value in chloroquine resistant faciparum malaria"},{"label":"B","text":"Is available for intravenous use only"},{"label":"C","text":"Is effective in eradicating the hepatic parasites in P. vivax malaria"},{"label":"D","text":"Is contraindicated in renal failure"},{"label":"E","text":"Large therapeutic doses cause tinnitus SECTION II - SHORT ESSAY QUESTIONS"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"1f419a9edceb8be6b44ce39ef7b38731c20de81c"},{"id":"q-137f413329bc","stem":"Describe mechanisms of action of","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cyclosporin"},{"label":"B","text":"Isoniazid"},{"label":"C","text":"Tetracycline"},{"label":"D","text":"Praziquantel"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-eda907badbd3","stem":"Describe the drugs used as oral hypoglycaemic agents","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1b15e6719594","stem":"Which of the following induces microsomal enzymes ...T............Phenobarbitone ...T............Ethanol ...F............Diazepam ...F............Ketaconazole ...T............Nevirapine SECTION III: Matching Match the members of group A to those of group B by choosing and writing (in the space provided). The letter of the most corresponding member of group B. Members of group B shall be used only once and some neither shall nor be used at all. Group A","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-195d15f6a1a7","stem":"The antirheumatoid sulphasalazine","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Is a combination of aspirin and a salicylate"},{"label":"B","text":"It is split into its component parts by bacteria in the colon"},{"label":"C","text":"Has a bioavailability of nearly 100% after oral administration"},{"label":"D","text":"Skin reactions and leukopenia can occur but are irreversible on stopping the drug"},{"label":"E","text":"Is not a radical scavenger"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"1fc4b14faccee8561b2172569db3d7247e71f676"},{"id":"q-ff716a99267f","stem":"The gold compounds (sodium aurothiomalate and auranofin) used in the treatment of rheumatoid arthritis","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Their effect develops fast"},{"label":"B","text":"Stimulate mitogen-induced lymphocyte proliferation"},{"label":"C","text":"reduce both the release and the activity of lysosomal enzymes,"},{"label":"D","text":"potentiate chemotaxis of neutrophils"},{"label":"E","text":"increase the release of mast cell mediators"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"ddd203c01e9ef4e8892c4a524c358e744b3488a4"},{"id":"q-d98866da95ee","stem":"Chloroquine is a 4-aminoquinoline drug used mainly to treat malaria.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Has not been shown to have a role in the treatment of rheumatoid arthritis"},{"label":"B","text":"Does not inhibit phospholipase A2"},{"label":"C","text":"Does not reduce the formation of the eicosanoids"},{"label":"D","text":"May intercalate in the DNA and inhibit DNA and RNA synthesis, as it does in microorganisms"},{"label":"E","text":"Pharmacological effects in modifying rheumatoid disease appear in 4 days"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2006513c3a9d","stem":"Gout is a genetically determined metabolic disease.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"In gout, there is underproduction of purines"},{"label":"B","text":"is characterised by attacks of acute arthritis produced by the deposition of crystals of sodium chloride"},{"label":"C","text":"Allopurinol is an analogue of hypoxanthine that induces the enzyme xanthine oxidase by substrate competition"},{"label":"D","text":"Inhibition of de novo purine synthesis does not occur with prolonged use of allopurinol"},{"label":"E","text":"Alloxanthine is an allopurinol metabolite, which remains in tissue for a considerable time, and is a non-competitive inhibitor of the enzyme."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-883eb0a03e85","stem":"Allopurinol is the drug of choice in the long-term treatment of gout","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It is highly effective in the treatment of an acute attack"},{"label":"B","text":"increases the effect of mercaptopurine, an antimetabolite that may be used in cancer chemotherapy"},{"label":"C","text":"it does not increase the effect of azathioprine, which is metabolised to mercaptopurine"},{"label":"D","text":"It does not enhance the effect of another anticancer drug, cyclophosphamide"},{"label":"E","text":"Has important drug interaction with oral anticoagulants through enhancing their metabolism"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"3063f692262e13f92ebe2b1590d6686956966f19"},{"id":"q-f5a8d7c2bccb","stem":"Iron absorption","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"The site of absorption is the duodenum and upper jejunum, and the process is passive"},{"label":"B","text":"The rapid uptake of iron across the brush border is rate limiting"},{"label":"C","text":"The transfer from the interior of the cell into the plasma is energy independent"},{"label":"D","text":"Haem iron is absorbed as intact haem and the iron is released in the mucosal cell by the action of haem oxidase"},{"label":"E","text":"Is stored in the body as transferrin"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"95c0bce0ad2d5b098ee8fd12dfb60c5da083c26c"},{"id":"q-11b518dd19f4","stem":"Vitamin B12 deficiency","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The principal cause of deficiency is decreased absorption due either to overproduction of intrinsic factor or to conditions which Interfere with its absorption in the ileum."},{"label":"B","text":"Vitamin B12 is a protein secreted by the stomach and is essential for Intrinsic factor absorption"},{"label":"C","text":"Intrinsic factor is in excess in patients with pernicious anaemia"},{"label":"D","text":"B12 is carried in the plasma by B12-binding proteins called transcobalamins"},{"label":"E","text":"B12 is carried in the plasma by B12-binding proteins called methyl-cobalamins e.g. methyl-B12."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c88c51f28d4d","stem":"Cholesterol synthesis","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The irreversible conversion of 3-hydroxy-3-methylglutaryl co-enzyme A (HMG-CoA) to mevalonic acid is rate limiting"},{"label":"B","text":"HMG-CoA reductase inhibitors such as cholestyramine decrease HMG-CoA synthesis."},{"label":"C","text":"The total bile pool mass is estimated at 2 to 3 gm and is recycled about 12 times per day."},{"label":"D","text":"About 80% of the cholesterol secreted in the bile is reabsorbed as part of chylomicrons"},{"label":"E","text":"The largest of the lipoprotein particles are the triglycerides"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a3d6a630e0b9","stem":"Familial hypercholesterolemia.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Results from a rare increase in the number of LDL receptors"},{"label":"B","text":"The homozygous form appears in about 1 in 500 individuals"},{"label":"C","text":"the heterozygous form is rare (1 in l,000,000)"},{"label":"D","text":"Heterozygotes have serum cholesterol concentrations approximately ten times normal"},{"label":"E","text":"Homozygotes have cholesterol concentrations six times normal"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1b08f93c82b7","stem":"Bile Acid sequestrants","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cholestyramine and colestipol ion-exchange resins approved for use in the treatment of hypocholesteremia"},{"label":"B","text":"Cholestyramine is insoluble and colestipol is insoluble and are both administered as suspensions"},{"label":"C","text":"When bile acids are removed from the enterohepatic recirculation, the liver synthesis of bile acids is decreased"},{"label":"D","text":"When bile acids are removed from the enterohepatic recirculation it also results in an increase in LDL receptors and greater hepatic uptake of LDL"},{"label":"E","text":"Circulating concentrations of LDL are increased by 20% to 35% with maximum doses of bile acid sequestrants"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4806b2653cd1","stem":"The inhibitors of cholesterol synthesis","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Pravastatin is a pro-drug whereas lovastatin and simvastatin are administered as sodium salts"},{"label":"B","text":"They potentiate the active sites on the reductase enzyme with a much higher affinity than the natural substrate, HMG-CoA."},{"label":"C","text":"Are effective in most patients with hypocholesteremia"},{"label":"D","text":"Pravastatin is more hydrophilic than the other two agents, but all are rapidly taken up by the liver, which is the principal site of action"},{"label":"E","text":"All have less than 1000 times the affinity of the natural substrate, HMG-CoA"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7be9e94d0371","stem":"Fibric acid derivatives","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Clofibrate and gemfibrozil increase plasma cholesterol and triglyceride concentrations."},{"label":"B","text":"They also increase the amount of cholesterol secreted into bile and thereby decrease the amount of bile lost in the faeces."},{"label":"C","text":"Clofibrate has been associated with cholelithiasis and cardiac arrhythmias"},{"label":"D","text":"Studies have shown a possible decrease in malignancies with clofibrate administration"},{"label":"E","text":"Lipoprotein lipase activity is also decreased thus accelerating the peripheral mobilization of fats into the liver"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-21f3b39dd853","stem":"Epidemiological studies on the incidence of atherosclerosis indicate that","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The greatest correlation exists for LDL cholesterol"},{"label":"B","text":"There is an inverse correlation between LDL and HDL cholesterol concentrations."},{"label":"C","text":"There is usually a consistent increase in LDL cholesterol and total cholesterol concentrations."},{"label":"D","text":"All of the above are correct."},{"label":"E","text":"All of the above are incorrect"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-bbebe2fc5db6","stem":"HMG-CoA reductase inhibitors.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Are effective in reducing cholesterol concentrations in patients with hypercholesterolemia, including those who are homozygous for low-density lipoprotein absence."},{"label":"B","text":"Have a high affinity for the LDL cholesterol receptor."},{"label":"C","text":"Are all pro-drugs."},{"label":"D","text":"Result in a decreased need for exogenous cholesterol."},{"label":"E","text":"All of the above are correct. SECTION II - TRUE/FALSE QUESTIONS An incomplete statement of phrases or questions is followed by five (5) completions or responses or answers. For each completion or response or answer write in the space provided TRUE for true and FALSE for false ones with respect to the incomplete statement or phrases or questions. ONE FULL MARK FOR EACH CORRECT ANSWER ZERO MARK FOR LEAVING BLANK PENALTY 0.5 MARKS FOR A WRONG GUESS"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["answer_text_in_option","topic_generic"],"cleaningOperations":[]},{"id":"q-5dca172908df","stem":"With respect to the haemopoietic system","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ferrous ion preparations need to be converted to ferric for absorption"},{"label":"B","text":"Iron is carried in plasma bound to haemosiderin"},{"label":"C","text":"Most of the iron which enters the plasma is derived from time-expired RBCs"},{"label":"D","text":"Ferritin iron is the primary storage form of iron and is in equilibrium with plasma iron"},{"label":"E","text":"Apoferritin is a degraded form of ferritin"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"79ef1303f2e215e0f154ab1990419a04639b4be3"},{"id":"q-5e452b99d811","stem":"Intrinsic factor and vitamin B12","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Intrinsic factor is essential for folic acid absorption"},{"label":"B","text":"Intrinsic factor is secreted by gastric mucosa cells"},{"label":"C","text":"Vitamin B12, given orally is essential in patients with pernicious anaemia"},{"label":"D","text":"Vitamin B12 is necessary for the synthesis of folate polyglutamates"},{"label":"E","text":"Folate polyglutamate is a necessary cofactor in the synthesis of thymidylate"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8ade7aa2ca88","stem":"Control of lipoprotein metabolism","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Fibrates act partly by increasing the action of lipoprotein lipase"},{"label":"B","text":"There is still uncertainty as to whether decreasing LDL-cholesterol will reduce the risk of coronary artery disease"},{"label":"C","text":"Nicotinic acid may cause flushing"},{"label":"D","text":"Cholestyramine may cause an increased bleeding tendency"},{"label":"E","text":"Probucol may cause ventricular tarchycardia if used with some antihistamine drugs"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7ba9cffd6c1d","stem":"Atherosclerosis and lipid lowering drugs","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"An increased risk of atherosclerosis is associated with hyperlipoproteinaemia"},{"label":"B","text":"Some drugs lower the plasma LDL levels by stimulating synthesis of liver cell LDL receptors and thus increase receptor- mediated endocytosis"},{"label":"C","text":"Gemfibrozil can reduce the incidence of coronary heart disease in patients with abnormal concentrations of blood lipids"},{"label":"D","text":"Clofibrate is contraindicated in gall bladder disease"},{"label":"E","text":"Pravastatin is administered as a sodium salt whereas lovastatin and simvastatin are pro-drugs"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d7af5b9dd493","stem":"With respect to the non-steroid anti-inflammatory drug (NSAIDs)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"NSAIDs such as indomethacin are effective in acute attacks of gout, but aspirin is contraindicated"},{"label":"B","text":"The main mechanism of action of NSAIDs is due to direct inhibition of accumulation of inflammatory cells"},{"label":"C","text":"Arachidonate cyclo-oxygenase-2 (COX-2) is constitutively expressed in most tissues"},{"label":"D","text":"Paracetamol is a first-line agent for the treatment of acutely inflamed joint"},{"label":"E","text":"The main effect of overdosage with paracetamol is bone marrow depression"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-171a3abbde80","stem":"The non-steroid anti-inflammatory drugs (NSAIDs)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Are contraindicated in patients suffering from ___________________________"},{"label":"B","text":"Must be avoided if possible in patients suffering from _____________________"}],"priority":0,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology"