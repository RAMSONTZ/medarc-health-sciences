 once before delivery, which of the following is true about birth attendant by a trained personnel?","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"36 %"},{"label":"B","text":"50 %"},{"label":"C","text":"62 %"},{"label":"D","text":"75 %"},{"label":"E","text":"81 %"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7bf09323a472","stem":"The most carcinogenic substance in tobacco is","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Carbon monoxide"},{"label":"B","text":"Nicotine"},{"label":"C","text":"Nicotinic acid"},{"label":"D","text":"Tar"},{"label":"E","text":"Hydrocarbons"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f80995b8f531","stem":"The following statement is not true","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"All patients who get tuberculosis after treatment is due to reactivation"},{"label":"B","text":"Immunity to mycobacterium tuberculosis can be as high as 90%"},{"label":"C","text":"Immunity to mycobacterium leprosy is around 85%"},{"label":"D","text":"In reactivation the genetic finger print is the same before and after treatment"},{"label":"E","text":"Only 1% of those infected with leprosy get lepromatous manifestation"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-bb56e6820763","stem":"Secondary prophylaxis of acute rheumatic fever is important because","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"70% of patients who develop carditis in the initial attack eventually have normal hearts"},{"label":"B","text":"Penicillin can prevent primary attack of rheumatic fever"},{"label":"C","text":"It has contributed to decline of the disease in developed countries"},{"label":"D","text":"Acute rheumatic fever evolved after 2-6 weeks."},{"label":"E","text":"It is a good treatment for chorea."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7b9a9a325d11","stem":"Infertility is most correctly defined as","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[