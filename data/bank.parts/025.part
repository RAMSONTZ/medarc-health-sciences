topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Tanzania is above the African average"},{"label":"B","text":"Africa has reached the global Tuberculosis control requirement"},{"label":"C","text":"Africa has reached high case detection than Tanzania"},{"label":"D","text":"Africa has universal DOTS therapy"},{"label":"E","text":"There is high resistance to Tuberculosis in Africa"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4a30f6ffeabe","stem":"Which of the following is not correct about the under five-mortality rate?","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The accuracy of the data is the same from one country to the other as is prepared by international statistical service."},{"label":"B","text":"I s the probability of dying between 42 weeks of gestation and five years."},{"label":"C","text":"Is the probability of dying between birth and age five years expressed per 10,000 live births."},{"label":"D","text":"Is the probability of dying between birth and age five years expressed per 1,000 live births."},{"label":"E","text":"Statement d and a are not correct"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["source_attribution_in_option",