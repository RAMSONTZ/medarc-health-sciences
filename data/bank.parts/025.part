"label":"B","text":"NO promote smooth muscle proliferation F"},{"label":"C","text":"Glucoccorticoids inhibit biosynthesis of constrictive oxide synthase F"},{"label":"D","text":"Under production of neuronal NO is reported in babies with hypertrophic pyloric stenosis T"},{"label":"E","text":"Inhaled NO has therapeutic potential in respiratory distress syndrome T"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-24bed5921d7a","stem":"In myasthenia Gravis","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Many patient have elevated antibodies to muscle Ach receptors T"},{"label":"B","text":"Symptoms may be relieved by neostigmine T"},{"label":"C","text":"Endrophonium is only useful for diagnostic purposes F"},{"label":"D","text":"The skeletal muscles are spastic F"},{"label":"E","text":"The eyelid are wide open F"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"b5f9435cd9c98e464f0878b7ee804b3c6649c828"},{"id":"q-9f31497f24e9","stem":"Physiological events mediated by alpha adrenoceptors","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Increase heart rate F"},{"label":"B","text":"Hypokalaemia F"},{"label":"C","text":"Bronchoconstriction F"},{"label":"D","text":"Peripheral arteriolar constriction T"},{"label":"E","text":"Cardiac dysrhythmias F"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e0a899eceed8","stem":"Regarding drug-receptor interactions","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"In the absence of agonist the effect of an antagonist is opposite to the effect of an agonist F"},{"label":"B","text":"A non competitive antagonist binds irreversibly to the receptor T"},{"label":"C","text":"Physiologic antagonists produce opposite physiologic effects at the same receptor T"},{"label":"D","text":"Down regulation of receptor can change the clinical respond to a drug after chronic administration of the drug T"},{"label":"E","text":"Idiosyncratic responses of individuals to a drug are qualitatively the same as the responses on most other individual F"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a379fca15d07","stem":"Chemical mediators in the body","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Are present packaged in storage vesicles in various tissue T"},{"label":"B","text":"Play an important role in the functioning T"},{"label":"C","text":"Include neurotransmitter and hormone T"},{"label":"D","text":"Are synthesized on demand F"},{"label":"E","text":"Depend on the availability of calcium ions for their release T"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b9b3db6d1af2","stem":"Guanethine lowers systemic BP by action","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"On autonomic ganglia F"},{"label":"B","text":"On blocking B-receptors F"},{"label":"C","text":"To prevent release of adrenergic neurotransmitter T"},{"label":"D","text":"To deplete the adrenergic nerve ending of neurotransmitters T"},{"label":"E","text":"Directly on the smooth muscle of the arterioles F"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-aa23540335a0","stem":"Exocytosis of chemical mediators","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Occur in response to increased in intracellular Ca2+ T"},{"label":"B","text":"Is involved in the release of NO F"},{"label":"C","text":"Involve fusion between the membrane of synaptic vesicle &plasma membrane T"},{"label":"D","text":"Is triggered only by nerve stimulation F"},{"label":"E","text":"Has no role in the release of enzyme from GIT F"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8cebada01857","stem":"Synaptic transmission will not form","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"In the presence of botulinus toxin in the synaptic cleft T"},{"label":"B","text":"If Ca2+ ions are depleted from the vesicular environment T"},{"label":"C","text":"In the absence of synaptic proteins which interact with Ca2+ions T"},{"label":"D","text":"If Ca2+ can not bind SNARES T"},{"label":"E","text":"In the presence of a blocker at the post synaptic receptors T"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-45131cc32ae0","stem":"5-Hydroxtryptamine (5HT)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Is found primarily in the GIT T"},{"label":"B","text":"Is metabolized by MAO T"},{"label":"C","text":"Is depleted from body store by reserpine T"},{"label":"D","text":"Is apotent vasodilator T"},{"label":"E","text":"Has its action antagonized by methysergide through interaction with HT-2-receptor T"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-111e6c850811","stem":"The following NSAIDs are mediated by PGS","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"GIT irritation F"},{"label":"B","text":"Steven Johnson syndrome F"},{"label":"C","text":"Asthma F"},{"label":"D","text":"Salicylism F"},{"label":"E","text":"Hemolytic anaemia T"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a80804f61c04","stem":"Histamine in the body","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Is synthesized by decarboxylation of histidine T"},{"label":"B","text":"Comes mainly from intestinal bacteria F"},{"label":"C","text":"Is stored primarily in the mast cells T"},{"label":"D","text":"Is produced in large amount by growing cells T"},{"label":"E","text":"Is excreted primarily unchanged F"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_d