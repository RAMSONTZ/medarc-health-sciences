"repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"5ce80287d3ea3c0dad4667a1070a1260ccbf15e6"},{"id":"q-c8db835a3fb7","stem":"What is the median of the set of number: 2,3,7,9,100000?","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"20004.2"},{"label":"B","text":"3.5"},{"label":"C","text":"7"},{"label":"D","text":"5000"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"e481f53d8ed815e40f16526087b3b0cd749cadcc"},{"id":"q-05fb4121e250","stem":"Which of the following independent variables cannot be manipulated in a research study?","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"Gender"},{"label":"B","text":"Ethnicity"},{"label":"C","text":"Intelligence and other traits"},{"label":"D","text":"None of the above can be manipulated in a research study"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"33dd841c12b3d1e563b5571c9fb996cad7315e00"},{"id":"q-afaea32e729b","stem":"Which measure of association is most appropriate in the cross-sectional design?","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"Prevalence ratio"},{"label":"B","text":"Prevalence odds ratio"},{"label":"C","text":"Cumulative incidence"},{"label":"D","text":"None of the above"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"7d20dfbfdd8b82e50073d7e170b9aac3bd25a82b"},{"id":"q-4a3696d7b8dd","stem":"Read carefully the figure below, and then answer the following Questions (10 Marks) |ID No |Sex |Smoker | |1 |M |Y | |3 |M |Y | |5 |F |N | |7 |M |N | |8 |F |N | |9 |M |Y | |11 |M |Y | |13 |F |N | i) What type of Variable is this? ii) How many responses in each category?","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"ID No - Numerical discrete (quantitative)"},{"label":"B","text":"Sex - Categorical binary"},{"label":"C","text":"Smoker - Categorical binary Sex: 8 or 2 responses ( male and female) Smoker: 8 or 2 responses (yes and no) iii) Present both the proportion of male and females who smoke."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-009582593312","stem":"If a researcher takes a large enough sample, he/she will almost always obtain","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"virtually significant results"},{"label":"B","text":"practically significant results"},{"label":"C","text":"consequentially significant results"},{"label":"D","text":"statistically significant results"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ce27e8e8cba7","stem":"The null and alternative hypotheses divide all possibilities into","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"two sets that overlap"},{"label":"B","text":"two non-overlapping sets"},{"label":"C","text":"two sets that may or may not overlap"},{"label":"D","text":"as many sets as necessary to cover all possibilities"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7d31b86f92a7","stem":"Which of the following is true of the null and alternative hypotheses?","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"