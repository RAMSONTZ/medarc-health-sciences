"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"28c5a317d665159031b39ad53d043d7442386744"},{"id":"q-32167dfd5126","stem":"Pancreatic islets","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"F","text":"Alpha cells (A cells) secrete the hormone insulin."},{"label":"G","text":"Beta cells (B cells) produce glucagons and are the most abundant of the islet cells."},{"label":"H","text":"Delta cells (D cells) secrete the hormone insulin I. Somatostatin is synthesized and secreted from alpha cells J. glucagon has the effect of increasing blood glucose levels"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"fb670c1f637831f9e500258db1246d2e658f2e36"},{"id":"q-2d814b80178c","stem":"Which of the following side effects is atypical for metformin?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Endocrine Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Endocrine Pharmacology","options":[{"label":"F","text":"Nausea"},{"label":"G","text":"Vomiting"},{"label":"H","text":"Metallic tatse I. hypoglycaemia J. lactate acidosis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endo