les"},{"label":"C","text":"High in unprocessed carbohydrate, high in saturated fat, moderate protein, high in fruit and vegetables"},{"label":"D","text":"High in unprocessed carbohydrate, low in saturated fat, low in protein, low in fruit and vegetables"},{"label":"E","text":"Low in unprocessed carbohydrate, high in saturated fat, high in protein, low in fruit and vegetables"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f6efb94c3d81","stem":"Which of the following is not an essential ingredient of human development?","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Education"},{"label":"B","text":"Social activities"},{"label":"C","text":"Health"},{"label":"D","text":"Industrial development"},{"label":"E","text":"Adequate nutrition"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-37d66bb5aa33","stem":"Questionnaires are helpful to the public health doctor because","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It is helpful in evaluating health services"},{"label":"B","text":"It is a set of standardized questions"},{"label":"C","text":"It is useful for collecting information"},{"label":"D","text":"It is helpful in planning health services"},{"label":"E","text":"All of the above"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6b56de7baab2","stem":"The access to improved sanitation in Tanzania is","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Environmental and Occupational Health","topicOriginal":"Environmental and Occupational Health","subtopic":"Sanitation","suggestedTopic":null,"options":[{"label":"A","text":"37 %"},{"label":"B","text":"41 %"},{"label":"C","text":"53 %"},{"label":"D","text":"60 %"},{"label":"E","text":"97 %"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Environmental and Occupational Health","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-04b5a7c7067d","stem":"A child can be helped to fight infections by","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":". Giving antibiotics and vitamin B"},{"label":"B","text":". Better nutrition and immunization"},{"label":"C","text":". Adequate oral dehydration and ant diarrheas"},{"label":"D","text":". Food fortification with iodine"},{"label":"E","text":". Food fortification with iron"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1f51dcb0a390","stem":"Most of infectious organisms die at temperatures","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Above 40%"},{"label":"B","text":"Above 50%"},{"label":"C","text":"Above 60%"},{"label":"D","text":"Above 90%"},{"label":"E","text":"None of the above"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ddfe90889380","stem":"In terms of personal health characteristics. Which of the following are important","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Adequate nutritious shelter"},{"label":"B","text":"Stress management"},{"label":"C","text":"Avoid of substance abuse"},{"label":"D","text":"Balance of work, relaxation and sleep"},{"label":"E","text":"All of the above."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0b4dbba2a0c4","stem":"Fluoride levels of 2-8mg/L in drinking water may adversely affect","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The bony epiphyses"},{"label":"B","text":"The dental enamel"},{"label":"C","text":"Dentine formation"},{"label":"D","text":"Dental plaque"},{"label":"E","text":"Long bone growth and secondary teeth"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6c81785016cc","stem":"The ability of microbial agent to induce disease is known as","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Infectivity"},{"label":"B","text":"Pathogenicitz"},{"label":"C","text":"Immunogenicity"},{"label":"D","text":"Virulence"},{"label":"E","text":"None of the above"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e4de1713ff90","stem":"Safe alcohol drinking depends on the following","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Gender, when you had your last drink"},{"label":"B","text":"Your weight and fat/water content in your body"},{"label":"C","text":"Your rate of drinking"},{"label":"D","text":"Level of education"},{"label":"E","text":"Whether and when you had the last eaten."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5cc5792b2136","stem":"How much alcohol is safe?","type":"Short Answer","subject":"Community Health and Public Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-df79b6862b1e","stem":"Women 2 –3 units a day 11 Men 3 – 4 units a day 111 Pregnant women 2 – 3 a day","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Statements 1 and 11 are correct, statement 111 is not correct"},{"label":"B","text":"Statements 11 and 111 are correct, statement 11 is not correct"},{"label":"C","text":"Statements 111 and 11 are correct, statement 1 is not correct"},{"label":"D","text":"All statements are correct"},{"label":"E","text":"All statements are not correct"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d165614fb4b4","stem":"Marasmic Kwashiorkor is characterised by which of the following: I) Weight below the 60th centile II) Weight between the 60th - 80th centile III) A lethargic severely underweight child who has poor appetite IV) Upper arm circumference between 13.5 and 14.5 cm V) Oedematous exhinities with dry skin and colourless skin.","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"I, III and V"},{"label":"B","text":"II, III and V"},{"label":"C","text":"I, III and IV"},{"label":"D","text":"II and V"},{"label":"E","text":"I"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-bcbe4e8ff8ff","stem":"The following is in the highest risk group of developing iodine deficiency manifestation if the soil lack adequate iodine.","type":"OSCE / Practical Station","subject":"Community Health and Public Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Babies"},{"label":"B","text":"Young adults"},{"label":"C","text":"Old people"},{"label":"D","text":"Travelers and business people"},{"label":"E","text":"School children."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVeri