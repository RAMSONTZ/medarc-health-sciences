,"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"93b98d7fdb8e11e11b3706ef07895fb10527fe68"},{"id":"q-0ca346402064","stem":"A drug that produces natural sleep when administered systemically","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Anesthetic"},{"label":"B","text":"Tranquillizer"},{"label":"C","text":"Hypnotic"},{"label":"D","text":"anticonvulsant"},{"label":"E","text":"Tricyclic antidepressant"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a9aa8d03fd7a","stem":"Which is the mechanism of action of fluoroquinolones (e.g. ciprofloxacin)?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antimicrobials","options":[{"label":"A","text":"Inhibit DNA gyrase"},{"label":"B","text":"Inhibit reverse transcriptase enzyme"},{"label":"C","text":"Inhibit peptidyl transfer on ribosome"},{"label":"D","text":"Inhibit DNA-directed RNA polymerase"},{"label":"E","text":"Interfere with peptidoglycan synthesis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"faaa35590ef4b84dd47bb35107bd3e92e46b3e68"},{"id":"q-776c1b2fb81b","stem":"Therapeutic Characteristics of ACE Inhibitors","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Cardiovascular Drugs · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Cardiovascular Drugs","options":[{"label":"A","text":"have milder and fewer adverse effects, without changing blood lipids or glucose"},{"label":"B","text":"cause reflex sympathetic activation (or reflex tachycardia)"},{"label":"C","text":"Are not effective in hypertensives with elevated plasma renin levels"},{"label":"D","text":"blocking AT1 receptors selectively without affecting AT2 receptors"},{"label":"E","text":"they do not affect bradykinin metabolism (i.e., no coughing or angioneurotic edema)"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular Drugs · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4a564636eac7","stem":"Mention FIVE differences between LOOP and THIAZIDE diuretics. (10 marks) [pic]","type":"Short Answer","subject":"Pharmacology","topic":"Cardiovascular Drugs","topicOriginal":"Cardiovascular Drugs","subtopic":"Diuretic","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular Drugs","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningO