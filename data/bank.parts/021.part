ax"},{"label":"E","text":"none of the above"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"4e55cd41c7bea5a8f94d28837701099e5e139665"},{"id":"q-33bd7dde8d40","stem":"All of the following protozoans are transiently present or mildly pathogenic, and therefore, generally only cause medial problems in immunosuppressed individuals such as AIDS patients except....","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Trypanosoma brucei gambiense"},{"label":"B","text":"Cryptosporidium"},{"label":"C","text":"Isospora belli"},{"label":"D","text":"Toxoplasma gondi"},{"label":"E","text":"Pneumocystis"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-945becc46632","stem":"Small numbers of Toxoplasma gondii cysts can cause problems even in immunocompetent (normal) individuals when located in which location in the body?","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"brain"},{"label":"B","text":"skeletal muscle"},{"label":"C","text":"liver"},{"label":"D","text":"retina"},{"label":"E","text":"spleen"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswe