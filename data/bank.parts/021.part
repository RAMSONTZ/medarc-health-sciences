_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f254175adaa7","stem":"After developing blurred vision, you visit your optometrist (eye doctor) who explains that you are suffering from severe keratitis (disease of the outer covering of skin surrounding the cornea) caused by some kind of protozoan. Which parasite from the list below would most likely be responsible for this condition?","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Entamoeba corneae"},{"label":"A","text":"Leishmania tropica"},{"label":"C","text":"Naegleria fowleri"},{"label":"D","text":"Acanthamoeba polyphagia"},{"label":"E","text":"Entamoeba histolytica"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-53f59d6b1bb1","stem":"Who identified the anopheles mosquito as the vector for malaria?","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Protozoology","topicOriginal":"Protozoology","subtopic":"Malaria","suggestedTopic":null,"options":[{"label":"A","text":"Chet Atkins"},{"label":"B","text":"Ronald Ross"},{"label":"C","text":"William Gorgas"},{"label":"D","text":"Frederick Kuchenmeister"},{"label":"E","text":"Hans Krebs"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Protozoology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-882adf15fe1b","stem":"Trypanosoma cruzi evades the mammalian immune system by ........","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Protozoology","topicOriginal":"Protozoology","subtopic":"Trypanosomiasis","suggestedTopic":null,"options":[{"label":"A","text":"becoming intracellular"},{"label":"B","text":"penetrating into privileged sites in the body"},{"label":"C","text":"the process of antigenic variation"},{"label":"D","text":"masking with host antigens"},{"label":"E","text":"causing polyclonal stimulation"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Protozoology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-70d1d4b6456e","stem":"Identify the most lethal species of Plasmodium.","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Protozoology","topicOriginal":"Protozoology","subtopic":"Malaria","suggestedTopic":null,"options":[{"label":"A","text":"falciparum"},{"label":"B","text":"vivax"},{"label":"C","text":"ovale"},{"label":"D","text":"malariae"},{"label":"E","text":"hildreae"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Protozoology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f292ea4a41ec","stem":"The definitive host for Plasmodium vivax is a .....(where syngamy occurs)","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Protozoology","topicOriginal":"Protozoology","subtopic":"Malaria","suggestedTopic":null,"options":[{"label":"A","text":"human"},{"label":"B","text":"penguins"},{"label":"C","text":"Culex mosquitoes"},{"label":"D","text":"Anopheles mosquitoes"},{"label":"E","text":"Aedes mosquitoes"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Protozoology","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[],"manualEdits":{}},{"id":"q-43a87383d656","stem":"What causes the alternating fever and chills symptom found so characteristically in malaria patients?","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Protozoology","topicOriginal":"Protozoology","subtopic":"Malaria","suggestedTopic":null,"options":[{"label":"A","text":"the high utilization of tyrosine by merozoites in living in spinal fluid"},{"label":"B","text":"the build-up of iron in liver cells"},{"label":"C","text":"the blockage of small capillaries by infected blood cells"},{"label":"D","text":"the destruction of infected red blood cells"},{"label":"E","text":"the synchronized release of merozoite antigens MATCHING PORTION"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Protozoology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"acd36b1aaea8deb2d5203c7de9fd8d5744a94d50"},{"id":"q-b2016905beb8","stem":"Match the term below with its best definition: (38 points) ____ axostyle ____ conoids ____ syngamy ____ quartan ____ sporocysts ____ microgametocytes ____ paroxyms ____ adhesive disk ____ tachyzoites ____ hypnozoites ____ heteroxenous ____ sarcocyst ____ median (parabasal) body ____ ookinete ____ zoitocyst ____ schizogony","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"fusion of gametes"},{"label":"B","text":"merozoite-like stage found in acute Toxoplasma infections"},{"label":"C","text":"fever every 48 hours"},{"label":"D","text":"fever every 72 hours"},{"label":"E","text":"fever every 24 hours"},{"label":"F","text":"contains bradyzoites in non-muscle cells"},{"label":"G","text":"motile elongate zygote of Plasmodium in mosquito gut"},{"label":"H","text":"the structure inside of Isospora oocysts that contains (surrounds) the sporozoites I. cone of microtubules used by merozoites to penetrate cells J. skeletal rod of Trichomonas K. multiple karyokinesis with delayed simutaneous cytokinesis L. pattern of chills and fever in malaria patients M. the type of life-cycle involving more than one host N. the type of life-cycle involving only one host O. multiple fission of a zygote P. cell producing male gamete Q. cell producing female gamete R. used for attachment by Giardia S. dormant liver stage of Plasmodium T. mouth portion of the Giardia “face” U. bars of RNA visible in young Entamoeba cysts V. nucleolus-type structure in Entamoebae nucleus W. contains bradyzoites in muscle cells MATCHING PORTION"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem","too_many_options"],"cleaningOperations":[],"duplicateStemGroup":"52d747e0dec01ed0206c67d0903191a9c5250af0"},{"id":"q-425d59ebf35b","stem":"Match the protozoan species with the correct order of developmental stages which most closely corresponds to the life-cycle of that protozoan (42 points) ____ Cryptosporidium parvum ____ Toxoplasma gondi ____ Giardia intestinalis ____ Eimeria spp. ____ Trypansoma cruzi ____ Trypanosoma brucei gambiense ____ Plasmodium vivax ____ Plasmodium falciparum ____ Acanthamoeba spp. ____ Trichomonas tenax ____ Saracocystis hominis ____ Leishmania donovani ____ Leishmania tropica ____ Entamoeba gingivalis ____ Naegleria fowleri ____ Isospora belli ____ Iodamoeba buetchlii ____ Trichomonas vaginalis ____ Endolimax nana ____ Entamoeba histolytica ____ Trichomonas hominis","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Protozoology","topicOriginal":"Protozoology","subtopic":"Malaria","suggestedTopic":null,"options":[{"label":"A","text":"oocysts ➔ trophozoites ➔"},{"label":"B","text":"oocysts ➔ trophozoites ➔ merozoites ➔ schizonts ➔"},{"label":"C","text":"oocysts ➔ sporozoites ➔ trophozoites ➔ schizonts ➔ merozoites ➔ macrogametocytes ➔ microgametocytes ➔ zygotes ➔"},{"label":"D","text":"oocysts ➔ merozoites ➔ macrogametocytes ➔ microgametocytes ➔ sporozoites ➔ trophozoites ➔ schizonts ➔ zygotes ➔"},{"label":"E","text":"oocysts ➔ sporozoites ➔ trophozoites ➔ bradyzoites ➔ schizonts ➔ merozoites ➔ macrogametocytes ➔ microgametocytes ➔ zygotes"},{"label":"F","text":"oocysts ➔ sporozoites ➔ zygotes ➔ bradyzoites ➔ schizonts ➔ merozoites ➔ trophozoites ➔ macrogametocytes & microgametocytes"},{"label":"G","text":"sporozoites ➔ trophozoites ➔ schizonts ➔ merozoites ➔ macrogametocytes ➔ microgametocytes ➔ zygotes ➔ ookinetes ➔ oocysts ➔"},{"label":"H","text":"trophozoites ➔ cysts ➔ I. trophozoites only J. cysts only K. trypomastigote only L. trypomastigote ➔ amastigote ➔ epimastigote M. promastigote ➔ amastigote N. epimastigote ➔ trypomastigote ➔ promastigote ➔ amastigote ESSAY PORTION"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Protozoology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["too_many_options"],"cleaningOperations":[]},{"id":"q-e87a54ebda88","stem":"Why is Trypanosoma lewisi not generally lethal to rats, while Trypanosoma brucei is often lethal to cattle? (6 points)","type":"Short Answer","subject":"Parasitology","topic":"Protozoology","topicOriginal":"Protozoology","subtopic":"Trypanosomiasis","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Protozoology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b4f91cefdf1a","stem":"The phylum and subphylum level of classification for the protozoans is based primarily upon ..........","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"morphology of the cyst stage"},{"label":"B","text":"morphology of the trophozoite stage"},{"label":"C","text":"methods for reproduction"},{"label":"D","text":"organelles used for motility"},{"label":"E","text":"hosts used in its life-cycle"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[],"manualEdits":{}},{"id":"q-ef944c1078ee","stem":"Malaria trophozoites evade the mammalian immune system primarily .......","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Protozoology","topicOriginal":"Protozoology","subtopic":"Malaria","suggestedTopic":null,"options":[{"label":"A","text":"becoming intracellular"},{"label":"B","text":"penetrating into privileged sites in the body"},{"label":"C","text":"the process of antigenic variation"},{"label":"D","text":"masking with host antigens"},{"label":"E","text":"causing polyclonal stimulation"}],"priority":0,"status":"practi