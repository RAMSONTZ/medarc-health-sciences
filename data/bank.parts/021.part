","text":"produce keratin, assist in the immune response, and produce lymphocytes."},{"label":"D","text":"produce melanin, secrete sebum, minimise water loss."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"346910de1389e8a68080f34f50c323f08ae7516c"},{"id":"q-2670983dae7e","stem":"What do the apocrine glands of the skin secrete?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"apocrin"},{"label":"B","text":"cerumin"},{"label":"C","text":"milk"},{"label":"D","text":"sweat"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"9a0e7515ef4478efb430f3fc0803fa3e05f875b7"},{"id":"q-1d704d16fdf7","stem":"Which statement about vitamin D is INCORRECT ?","type":"Single Best Answer MCQ","subject":"Nutrition and Dietetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It is required for uptake of calcium from the gut"},{"label":"B","text":"It is made in the skin, liver and kidneys."},{"label":"C","text":"It is an essential part of our diet."},{"label":"D","text":"It is a hormone"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Nutrition and Dietetics","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"bc82adc56a5bad28acb344d1957e01aac96bde60","manualEdits":{"sourceStem":"Which statement about vitamin D is INCORRECT ?","sourceOptions":[{"label":"A","text":"It is required for uptake of calcium from the gut"},{"label":"B","text":"It is made in the skin, liver and kidneys."},{"label":"C","text":"It is an essential part of our diet."},{"label":"D","text":"It is a hormone Answer is C: As our body can make “vitamin D” it is not an essential part of our diet. As it circulates in the bloodstream, it is regarded as a type of steroid hormone. 5 Integument 113"}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-6db0753d3b62","stem":"Sudiferous glands are also known as","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"eccrine or apocrine glands."},{"label":"B","text":"sebaceous or oil glands."},{"label":"C","text":"ceruminous or apocrine glands."},{"label":"D","text":"mammary or eccrine glands."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","