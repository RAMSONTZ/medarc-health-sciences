ns","not_enough_options","prior_structural_review_flag","repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"a59064fb39ad98413e8cc213d76f385f0a2336f9"},{"id":"q-85f7b30d39a7","stem":"5 Acids, Bases and Buffers 82","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Water, pH and Buffers","topicOriginal":"Water, pH and Buffers","subtopic":"Acid","suggestedTopic":null,"options":[{"label":"C","text":"7.3–7.5"},{"label":"D","text":"7.8–8.6"}],"priority":0,"status":"review","flags":["mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Water, pH and Buffers","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag"],"cleaningOperations":["source answer/boilerplate removed from option D","whitespace/page_marker_normalization"]},{"id":"q-8aa1048c9d63","stem":"One of the buffer systems in the blood is the carbonic acid/bicarbonate buffer. It helps to maintain the body’s acid-base balance by destroying any excess","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Water, pH and Buffers","topicOriginal":"Water, pH and Buffers","subtopic":"Buffer","suggestedTopic":null,"options":[{"label":"A","text":"hydrogen ions in the blood."},{"label":"B","text":"acid or base in the blood."},{"label":"C","text":"hydroxide ions formed in the blood."},{"label":"D","text":"bicarbonate ions formed in the blood."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Water, pH and Buffers","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization","source ans