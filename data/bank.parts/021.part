n Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"f5d9820f5c7d216e5705268b99fea11fb55c6dba"},{"id":"q-3b8a8642f6ec","stem":"Which is the deepest layer of the integument?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the epidermis"},{"label":"B","text":"the dermis"},{"label":"C","text":"the stratum corneum"},{"label":"D","text":"the papillary dermal layer"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"265b9581bb6ff38ffab885f274c5bc52744f2034"},{"id":"q-5f839a400c19","stem":"One of the following statements about the stratum corneum is correct. Which one?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"cells in this layer undergo cell division to replace the skin."},{"label":"B","text":"it consists of dead cells."},{"label":"C","text":"it contains collagen, elastin and reticular fi bres."},{"label":"D","text":"the layer has sensory receptors known as Merkel discs, Meissner’s and Pacinian corpuscles."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"aa2c199c9923434fd555724b40822eba8870a8ce"},{"id":"q-ba0a103ba27a","stem":"The hypothalamus and core thermoreceptors notice if body temp too low. The hypothalamus signals smooth muscle in blood vessels to vasoconstrict and skeletal muscle to shiver. This activity causes body temp to rise, which is again noticed by hypothalamus & core thermoreceptors, so the hypothalamus turns 120 off these heat gain mechanisms. In this scenario, which of the following state- ments is correct?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Neuroanatomy · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Neuroanatomy","options":[{"label":"A","text":"The scenario describes positive feedback in action."},{"label":"B","text":"The core thermoreceptors are the effector organs."},{"label":"C","text":"The hypothalamus is the control centre."},{"label":"D","text":"Skeletal muscle is the efferent pathway to the effector organ."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Neuroanatomy · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D","whitespace/page_marker_normalization"],"duplicateStemGroup":"e18d02c8db45c076074219aaf1f38fb51c5dfb04"},{"id":"q-345df30a04da","stem":"In homeostasis, what is it that produces the response that moves the physiologi- cal variable back towards the middle of its healthy range?","type":"Single Best Answer MCQ","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the effector"},{"label":"B","text":"the receptor"},{"label":"C","text":"the integrating centre"},{"label":"D","text":"the efferent pathway"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"1716e3f23ee8c9aec601bcab920396749238ef23"},{"id":"q-70c0f4ff7a55","stem":"What causes the body to maintain a relatively constant internal environment?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"positive feedback"},{"label":"B","text":"homeostasis"},{"label":"C","text":"refl exes"},{"label":"D","text":"pH buffers"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"exact_duplicate_of_curated_provisional","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"0e81fd107c734ce170aafdb980baaf64eb3d4305"},{"id":"q-b50c968ad572","stem":"Which of the following is a correct defi nition of “negative feedback”?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The process by which the body maintains homeostasis."},{"label":"B","text":"A mechanism in which the body’s response opposes the stimulus. 6 Homeostasis 123"},{"label":"C","text":"A mechanism whereby the body responds to a stimulus by acting to enhance the stimulus."},{"label":"D","text":"The dynamic equilibrium maintained by an integrating centre which causes an effector to respond to the stimulus received by the receptor."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D","whitespace/page_marker_normalization"],"duplicateStemGroup":"03ad38f927b32ddde6a3bb086af5086c880c9923"},{"id":"q-b311c76ee66b","stem":"Which of the following would be a negative feedback response by the body to hyperthermia?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Shivering"},{"label":"B","text":"Sweating"},{"label":"C","text":"Vasoconstriction of blood vessels in the dermis"},{"label":"D","text":"An increase in metabolic rate"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"90b8479b35c2e83ae653bcc8e801e230b43659e6"},{"id":"q-036764acfa77","stem":"Which of the following statements about positive feedback and homeostasis is correct?","type":"Single Best Answer MCQ","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"They are regulation mechanisms that control most fl uctuations in the inter- nal environment of the body."},{"label":"B","text":"The response to the stimulus serves to exaggerate the feedback effect."},{"label":"C","text":"This type of feedback response only involves an effector not a specifi c stim- ulus receptor site."},{"label":"D","text":"This feedback mechanism involves adjustments at the organ level but not at the cellular level."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"dffda7eb82ead3857cd282b4252e5bd0e30f9856"},{"id":"q-8a70a8746ee1","stem":"Which of the following is NOT a bone of the axial skeleton?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"deltoid"},{"label":"B","text":"ethmoid 126"},{"label":"C","text":"sphenoid"},{"label":"D","text":"hyoid"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false