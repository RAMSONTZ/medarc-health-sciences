ion","source answer/boilerplate removed from option D"],"duplicateStemGroup":"728b4ebae574a463aa2bd501d93d317d77a7cac0"},{"id":"q-531b0b7ed318","stem":"A solution of 5 % glucose is used for an infusion. Over a 2 hour period, 300 ml of the solution were used. How much glucose in grams was infused?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"5 gm"},{"label":"B","text":"12.5 gm"},{"label":"C","text":"15.0 gm"},{"label":"D","text":"50 gm"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"],"duplicateStemGroup":"de45266d4e172c95bc5905a43d2be8dfc6aa118c"},{"id":"q-898777d0bc2b","stem":"Which strategy would be most effective in dealing with a severe case of dehydration?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Oral administration of a hypertonic solution."},{"label":"B","text":"Intravenous administration of distilled water."},{"label":"C","text":"Intravenous administration of isotonic glucose."},{"label":"D","text":"Intravenous administration of hypotonic sodium chloride."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"clea