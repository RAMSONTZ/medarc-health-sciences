lization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"c69e294a91a933b2eebda9f7bad3c164b594a3cb"},{"id":"q-5cb2e274b2dd","stem":"If a solution is shown to be able to conduct electricity, then what is true?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A: the solution is free of impurities"},{"label":"B","text":"B: the solution contains a dissolved electrolyte"},{"label":"C","text":"C: the solution contains dissolved molecules"},{"label":"D","text":"D: the solution is an aqueous solution"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"],"duplicateStemGroup":"0006101a7bf3b3ab0db48d0503c7e0ee5df131d1"},{"id":"q-751ace5803e6","stem":"What may hyponatremia be described as?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thoracic Wall and Mediastinum · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Thoracic Wall and Mediastinum","options":[{"label":"A","text":"insufficient potassium in the blood"},{"label":"B","text":"insufficient iron in the blood"},{"label":"C","text":"insufficient sodium in the blood"},{"label":"D","text":"excess sodium in the blood"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thoracic Wall and Mediastinum · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"11a9a5a30fc943232e1b27ae8ae461f2053b2f52"},{"id":"q-967aa0183ffd","stem":"What is the movement of water molecules across a plasma membrane from the side where the solution concentration is more dilute to the side where the solu- tion is more concentrated called?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"osmosis"},{"label":"B","text":"reverse osmosis"},{"label":"C","text":"diffusion"},{"label":"D","text":"hydration"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"eb24b6f83e5eec9c23391d13ad4a862d06c14444"},{"id":"q-7f3009d269ad","stem":"During dialysis, what moves across a semi-permeable membrane (and how)?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Water molecules by diffusion from the region of high solute concentration to the region of low solute concentration."},{"label":"B","text":"Water molecules by filtration from the region of high hydrostatic pressure to the region of low hydrostatic pressure."},{"label":"C","text":"Solutes by diffusion from the region of high solute concentration to the region of low solute concentration."},{"label":"D","text":"Solutes by filtration from the region of low hydrostatic pressure to the region of high hydrostatic pressure."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"274f041c420101ed01b01e45da8913295debce0e"},{"id":"q-ea7dcaefb4ea","stem":"What does “osmosis” refer to?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the constant random motion of ions and molecules."},{"label":"B","text":"the movement of ions and molecules from regions of high concentration to regions of low concentration."},{"label":"C","text":"the movement of water molecules through a semi-permeable membrane. 4 Chemistry for Physiology 65"},{"label":"D","text":"the movement of water molecules through a semi-permeable membrane from the side with higher water concentration to the side with lower water concentration."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"72a0485fe26ef08e337b9378d47ab8ce125d3c60"},{"id":"q-251709dae3cc","stem":"Which statement about the osmotic pressure of an aqueous solution is correct? Osmotic pressure","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"is an indication of the force with which pure water moves into that solution."},{"label":"B","text":"is a measure of the tendency of water to move into the solution."}],"priority":0,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"fbade74753ee8300ec95f4b2e7fda2203cde4069"},{"id":"q-e65977f0946f","stem":"3 Diffusion and Osmosis 66","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"C","text":"is the drawing power of water and depends on the number of molecules in the solution."},{"label":"D","text":"of a solution is called its osmolarity in mosmol/kg."}],"priority":0,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D","whitespace/page_marker_normalization"]},{"id":"q-b35b00ff9d96","stem":"Consider a patient undergoing kidney dialysis, whose blood has bicarbonate at a concentration of 14 mmol/L and urea at 23 mmol/L. The dialysing liquid has bicarbonate at 32 mmol/L and urea at 0 mmol/L. In which direction will these substances flow? 4 Chemistry for Physiology 67","type":"Single Best Answer MCQ","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"bicarbonate will flow from patient’s blood to dialysing liquid, urea will flow from patient’s blood into dialysing liquid."},{"label":"B","text":"bicarbonate will flow from dialysing liquid to patient’s blood, urea will flow from dialysing liquid into patient’s blood."},{"label":"C","text":"bicarbonate will flow from dialysing liquid to patient’s blood, urea will flow from patient’s blood into dialysing liquid."},{"label":"D","text":"bicarbonate will flow from patient’s blood to dialysing liquid, urea will flow from dialysing liquid to patient’s blood."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D","whitespace/page_marker_normalization"],"duplicateStemGroup":"529a30e03d4909986e3c955463ce1b2e2986b0f8"},{"id":"q-ebc9e451e006","stem":"Osmosis involves movement of water from where the","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"water concentration is lower to where it is higher"},{"label":"B","text":"solute concentration is higher to where it is lower"}],"priority":0,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"9842b7fee0d853297e089efbf01f9d5706fbf862"},{"id":"q-df51f7552b63","stem":"3 Diffusion and Osmosis 68","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"C","text":"solution is more concentrated to where it is less concentrated"},{"label":"D","text":"water concentration is higher to where it is lower"}],"priority":0,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D","whitespace/page_marker_normalization"]},{"id":"q-1b305374f9f3","stem":"The Na+/K+ ATPase pump in the plasma membrane moves Na out of the cell and K into the cell against their concentration gradient. Then Na reenters the cell and K leaks out of the cell, along their concentration gradients through their membrane channels. What is the movement of Na and K along their concentra- tion gradients called? 4 Chemistry for Physiology 69","type":"Single Best Answer MCQ","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Active transport"},{"label":"B","text":"Diffusion"},{"label":"C","text":"Facilitated diffusion"},{"label":"D","text":"Osmosis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D","whitespace/page_marker_normalization"],"duplicateStemGroup":"08ff83f2d26c528f8397cfc31526efdc5ee37bf7"},{"id":"q-9edd43ea424c","stem":"What can be correctly said of an isotonic intravenous solution? An isotonic solution","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"causes water to move out of red blood cells."},{"label":"B","text":"causes no net movement of water into or out of red blood cells."},{"label":"C","text":"has the same solutes in the same solution concentration as blood plasma 4 Chemistry for Physiology 71"},{"label":"D","text":"causes water to move into red blood cells."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"2c558d5db9ded86b4e9a2870d0549554ce2d980f"},{"id":"q-78747248b6f9","stem":"Given that one mole of Na+Cl− has a mass of 58.5 g, what would be the concen- tration of particles when 0.9 g of Na+Cl− is dissolved in 100 ml of water?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"117 mmol/L"},{"label":"B","text":"150 mmol/L"},{"label":"C","text":"150 mosmol/L"},{"label":"D","text":"300 mosmol/L"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"59518de878b375e1b7b2ea1419a7d71fc31681a6"},{"id":"q-5436d45103c2","stem":"To what does the term “mole” refer?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the smallest particle of a molecular compound."},{"label":"B","text":"the amount of solute that must be dissolved in water to make an isotonic solution."},{"label":"C","text":"an amount of substance that contains 6.02 × 1023 particles."},{"label":"D","text":"a group of 2 or more atoms bonded together."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"8764069dd8c8ac1ddb4753f486e5afa2ad50c741"},{"id":"q-4de3ae064010","stem":"Fructose is a sugar with a molecular formula C6H12O6. Given that the atomic weights are: C = 12, H = 1 and O = 16, how many moles of fructose are there in 36 grams?","type":"Calculation","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"0.01 moles"},{"label":"B","text":"0.10 moles"}],"priority":0,"status":"practice_draft","