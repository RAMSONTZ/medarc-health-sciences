raft","auditFlags":[],"cleaningOperations":[]},{"id":"q-8649bb6b5bdd","stem":"c) What is the action of the muscle when contracts?","type":"Short Answer","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-477c1d783de2","stem":"The study of joints is known as _________","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Archaeology"},{"label":"B","text":"Osteology"},{"label":"C","text":"Syndesmology"},{"label":"D","text":"Arthrology"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-f708f9c4cecc","stem":"The synovial joint are also known as _________","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Megablast"},{"label":"B","text":"Periosteum"},{"label":"C","text":"Diarthrosis"},{"label":"D","text":"Arthrois"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-a88c3bc8aedb","stem":"Sutures are immovable joints.","type":"True / False","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option B"]},{"id":"q-3c191edeace4","stem":"The joints can be classified into ________ main types.","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"2"},{"label":"B","text":"3"},{"label":"C","text":"4"},{"label":"D","text":"5 View Answer"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3f498b3d764e","stem":"Synovial joint is ___________","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Pivot joint"},{"label":"B","text":"Fibrous joint"},{"label":"C","text":"Ball and socket joint"},{"label":"D","text":"Cartilaginous joint"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-31ebd0c9f604","stem":"Which of the following pair is correctly matched?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cartilaginous joint- skull bones"},{"label":"B","text":"Gliding joint- between zygapophyses of vertebrae"},{"label":"C","text":"Hinge joint- between vertebrae"},{"label":"D","text":"Fibrous joint- between phalanges"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"],"duplicateStemGroup":"9986536913725fa7ba93f6d1fbc81d08a1661ad8"},{"id":"q-5b36f43be595","stem":"Hinge joint is present between _______ and _______","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Femur and ulna"},{"label":"B","text":"Humerus and ulna"},{"label":"C","text":"Femur and pectoral girdle"},{"label":"D","text":"Femur and pelvic girdle"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-8901515243f3","stem":"Example of pivot joint is __________","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Hip joints"},{"label":"B","text":"Ankle joints"},{"label":"C","text":"Radio ulnar joints"},{"label":"D","text":"Metacarpophalangeal joints"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-d190d0a2d469","stem":"Elbow joint is a hinge joint.","type":"True / False","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-fe9c9fadb3e8","stem":"With respect to the mediastinum: All but which of the following are tributaries of the coronary sinus of the heart? The posterior mediastinum contains all but which of the following? Which doesn’t drain into the cardiac sinus? Which muscle is not used in inspiration? Which is not found in the posterior mediastinum?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"the vagus nerves pass in front of the lung roots"},{"label":"B","text":"the phrenic nerves pass behind the lung roots"},{"label":"C","text":"the vagus nerves pass behind the lung roots"},{"label":"D","text":"the left phrenic passes anterior to the left bronchus and exits the diaphragm through the IVC opening"},{"label":"E","text":"the right recurrent laryngeal nerve hooks around the ligamentum arteriosum 10) With respect to the cardiac plexuses:"},{"label":"A","text":"the superficial plexus lies to the right of the ligamentum arteriosum, in front of the tracheal bifurcation, behind the aortic arch"},{"label":"B","text":"the deep plexus is smaller and lies in front of the ligamentum arteriosum"},{"label":"C","text":"the plexuses consist only of sympathetic and parasympathetic fibres"},{"label":"D","text":"pain fibres run with sympathetic nerves → sympathetic ganglia (3 cervical and upper 4-5 thoracic ganglia of both sides)"},{"label":"E","text":"sympathetic fibres accelerate the heart and constrict the coronary arteries 11) With respect to the heart:"},{"label":"A","text":"the inferior (diaphragmatic) surface is made up of one third right ventricle and two thirds left ventricle, separated by the posterior interventricular branch of the left coronary artery"},{"label":"B","text":"the right border of the heart extends from the lower border of the right 3rd costal cartilage to the lower border of the right 6th costal cartilage"},{"label":"C","text":"the posterior surface (base) consists almost entirely of the left atrium receiving the three pulmonary veins"},{"label":"D","text":"the left border consists of the left ventricle only"},{"label":"E","text":"the right border consists mostly of the right atrium 12)"},{"label":"A","text":"the anterior cardiac vein"},{"label":"B","text":"the great cardiac vein"},{"label":"C","text":"the middle cardiac vein"},{"label":"D","text":"the oblique vein (of the LA)"},{"label":"E","text":"the posterior vein of the LV 13)"},{"label":"A","text":"thoracic aorta"},{"label":"B","text":"oesophagus"},{"label":"C","text":"accessory hemiazygous vein"},{"label":"D","text":"the azygous vein"},{"label":"E","text":"the sympathetic trunks 14) With respect to the root of the lung:"},{"label":"A","text":"the left pulmonary artery is longer than the right"},{"label":"B","text":"the bronchial branch to the upper lobe is separate on the left"},{"label":"C","text":"the pulmonary veins lie anterior and inferior to bronchus"},{"label":"D","text":"the pulmonary ligament connects the right and left lungs directly"},{"label":"E","text":"the pulmonary trunk divides in front of the right main bronchus 15) The deep cardiac plexus:"},{"label":"A","text":"is functionally separate from the superficial cardiac plexus"},{"label":"B","text":"lies to the right of ligamentum arteriosum"},{"label":"C","text":"receives predominantly right phrenic input"},{"label":"D","text":"is posterior to the bifurcation of the trachea"},{"label":"E","text":"is smaller than the superficial cardiac plexus 16) The abdominal inferior vena cava:"},{"label":"A","text":"is shorter than the abdominal aorta"},{"label":"B","text":"enters the thorax through muscular diaphragm at T8"},{"label":"C","text":"creates a groove over the quadrate lobe of liver"},{"label":"D","text":"crosses the right renal and suprarenal arteries"},{"label":"E","text":"commences in front of the right common iliac artery 17) The testicular veins:"},{"label":"A","text":"have valves at their terminations"},{"label":"B","text":"is formed by two venae comitantes in the pelvis"},{"label":"C","text":"enter the inferior vena cava"},{"label":"D","text":"receive the suprarenal veins as tributaries"},{"label":"E","text":"none of the above 18) Regarding the ribs:"},{"label":"A","text":"the 1st costal cartilage articulates with the manubrium by a synovial joint"},{"label":"B","text":"the radiate ligament has two bands, upper and lower"},{"label":"C","text":"the typical ribs are 3rd to 10th"},{"label":"D","text":"the groove for the subclavian artery is anterior to the scalene tubercle on the 1st rib"},{"label":"E","text":"the angle of the 2nd rib is the most posterior part of its curvature 19) Regarding attachments to the thoracic cage:"},{"label":"A","text":"pectoralis major has slips of origin from the upper 8 costal cartilages"},{"label":"B","text":"the first digitation of serratus anterior attaches to the 1st and 2nd rib"},{"label":"C","text":"rectus abdominus is attached to the anterior surfaces of the 7th to 10th costal cartilages"},{"label":"D","text":"iliocostalis and longissimus, parts of erector spinae, are attached between the heads and tubercles of each rib"},{"label":"E","text":"serratus anterior is attached to the lower 8 ribs 20) In the superior mediastinum:"},{"label":"A","text":"the azygous vein arches under the right main bronchus"},{"label":"B","text":"the right brachiocephalic vein receives the thoracic duct"},{"label":"C","text":"the aortic arch is crossed on the left side by the phrenic and vagus nerves"},{"label":"D","text":"the superficial cardiac plexus contains right and left vagal and sympathetic fibres"},{"label":"E","text":"the superior vena cava receives the azygous vein at the lower border of the right 1st costal cartilage 21) Regarding the pericardium:"},{"label":"A","text":"the superior vena cava does not fuse with the fibrous pericardium"},{"label":"B","text":"the transverse sinus separates the four pulmonary veins"},{"label":"C","text":"the parietal layer of the serous pericardium has no nerve supply"},{"label":"D","text":"the strong sternopericardial ligaments connect fibrous pericardium to upper/lower ends of sternum"},{"label":"E","text":"the oblique sinus permits pulsation of the left atrium 22) Regarding the gastrointestinal tract:"},{"label":"A","text":"the oesophagus enters the abdomen at T8 level"},{"label":"B","text":"the right gastric artery is a branch of the splenic artery"},{"label":"C","text":"the hepatopancreatic ampilla opens into the horizontal part of the duodenum"},{"label":"D","text":"the taeniae coli converge at the ileocaecal valve"},{"label":"E","text":"McBurneys point is one third of the way up the oblique line that joins the right anterior superior iliac spine to the umbilicus 23) The pelvic splanchnic nerves are:"},{"label":"A","text":"derived from S1, 2, 3, 4"},{"label":"B","text":"motor to the mm of bladder neck and anal sphincter"},{"label":"C","text":"motor to all the gut"},{"label":"D","text":"secretomotor to the gut from splenic flexure dome"},{"label":"E","text":"sympathetic nerves 24) The anterior third of the serotom is supplied by:"},{"label":"A","text":"ilioinguinal nerve"},{"label":"B","text":"sciatic nerve branches"},{"label":"C","text":"peroneal branches of the posterior femoral cutaneous nerve"},{"label":"D","text":"a branch of the pudendal nerve"},{"label":"E","text":"none of the above 25) The ureters:"},{"label":"A","text":"are 25cm long"},{"label":"B","text":"are crossed anteriorly by gonadal vessels"},{"label":"C","text":"leave the psoas muscle at the bifurcation of the common iliac artery"},{"label":"D","text":"are retroperitoneal"},{"label":"E","text":"all of the above 26) Regarding intercostal blood vessels:"},{"label":"A","text":"in each space there are single anterior and posterior intercostal veins"},{"label":"B","text":"right sided superior intercostal vv drain into the brachiocephalic vein"},{"label":"C","text":"the second intercostal space does not contain a posterior intercostal artery"},{"label":"D","text":"all intercostal vv are branches of the descending thoracic aorta"},{"label":"E","text":"all this is clinically relevant 27) Regarding blood supply to the heart:"},{"label":"A","text":"the SA nodal artery is more commonly a branch of the left coronary artery"},{"label":"B","text":"40% of hearts show “left dominance”"},{"label":"C","text":"the marginal and anterior interventricular arteries are the main branches of the left coronary artery"},{"label":"D","text":"the right coronary artery arises from the posterior aortic sinus"},{"label":"E","text":"the circumflex artery travels in the atrioventricular groove 28) With respect to the bronchi:"},{"label":"A","text":"the carina lies to the left of the midline"},{"label":"B","text":"the left apicoposterior bronchus of the upper lobe rises highest from the posterior surface of the lung"},{"label":"C","text":"each lung has eight segmental bronchi"},{"label":"D","text":"the left main bronchus is shorter than the right"},{"label":"E","text":"blood supply is via the pulmonary arteries 29) The thoracic duct:"},{"label":"A","text":"commences at L1"},{"label":"B","text":"passes through the oesophageal opening of the diaphragm (T10)"},{"label":"C","text":"enters the right side of the superior mediastinum"},{"label":"D","text":"does not drain the right arm"},{"label":"E","text":"terminates in the inferior vena cava 30) The oesophageal opening in the diaphragm transmits:"},{"label":"A","text":"azygous vein"},{"label":"B","text":"vagus nerve"},{"label":"C","text":"right phrenic nerve"},{"label":"D","text":"sympathetic trunk"},{"label":"E","text":"thoracic duct 31) Regarding the intercostal space:"},{"label":"A","text":"the neurovascular space lies deep to the transversus group"},{"label":"B","text":"the collateral nerves lie just above the ribs"},{"label":"C","text":"the first intercostal nerve does not supply muscle"},{"label":"D","text":"the lower third intercostal nerves supply the abdominal wall"},{"label":"E","text":"all intercostal arteries are branches of the descending thoracic aorta 32) The azygous vein:"},{"label":"A","text":"has an avascular fibrous cord in the abdomen"},{"label":"B","text":"begins as the union of ascending lumbar vein with the subcostal vein on the left side"},{"label":"C","text":"arches over the right pulmonary artery"},{"label":"D","text":"receives veins from the upper third of the oesophagus"},{"label":"E","text":"usually enters the brachiocephalic vein 33)"},{"label":"A","text":"great cardiac vein"},{"label":"B","text":"anterior cardiac vein"},{"label":"C","text":"small cardiac vein"},{"label":"D","text":"oblique vein of the left atrium"},{"label":"E","text":"posterior vein of the left ventricle 34) The cardiac plexus:"},{"label":"A","text":"has a larger superficial part and a smaller deep part"},{"label":"B","text":"is made up of sympathetic and parasympathetic fibres only"},{"label":"C","text":"receives fibres from the left vagus nerve and left cervical sympathetic ganglion only into the superficial part"},{"label":"D","text":"the deep part lies to the left of the ligamentum arteriosum"},{"label":"E","text":"has preganglionic sympathetic fibres 35) Regarding the pericardium:"},{"label":"A","text":"the transverse sinus separates the four pulmonary veins"},{"label":"B","text":"the parietal layer of the serous pericardium has no nerve supply"},{"label":"C","text":"the fibrous pericardium is fused with the IVC"},{"label":"D","text":"the fibrous pericardium is supplied by the phrenic nerve"},{"label":"E","text":"strong sternopericardial ligaments connect the fibrous pericardium to the sternum 36)"},{"label":"A","text":"erector spinae"},{"label":"B","text":"quadratus lumborum"},{"label":"C","text":"latissimus dorsi"},{"label":"D","text":"transversus thoracis"},{"label":"E","text":"pectoralis major 37)"},{"label":"A","text":"descending thoracic aorta"},{"label":"B","text":"thoracic duct"},{"label":"C","text":"phrenic nerves"},{"label":"D","text":"azygous vein"},{"label":"E","text":"lymph nodes 38) Regarding the phrenic nerves:"},{"label":"A","text":"pass behind anterior scalene muscle"},{"label":"B","text":"the right nerve pierces the muscular part of the diaphragm"},{"label":"C","text":"they are always in contact with pleura laterally"},{"label":"D","text":"run in mediastinum behind the lung root"},{"label":"E","text":"split into four main branches – anterior, posterior, medial and lateral 39) The vagus nerve:"},{"label":"A","text":"the right vagus nerve is in contact with the trachea"},{"label":"B","text":"passes in front of the lung root"},{"label":"C","text":"the right recurrent laryngeal branch hooks around the right subclavian artery"},{"label":"D","text":"passes through the vena caval forearm"},{"label":"E","text":"the right vagus nerve supplies branches to the superficial cardiac plexus 40) Regarding the heart valves:"},{"label":"A","text":"the aortic valve usually has two semilunar cusps"},{"label":"B","text":"the pulmonary valve is at the level of the 3rd costal cartilage"},{"label":"C","text":"they do not contain elastic fibres"},{"label":"D","text":"the tricuspid valve has anterior, posterior and medial cusps"},{"label":"E","text":"the mitral valve cusps are bigger and thinner than those of the tricuspid valve Thorax Section 1 – Answer 1 C 2 E 3 B 4 D 5 D 6 D 7 B 8 C 9 C 10 D 11 B 12 A 13 E 14 C 15 B 16 D 17 A 18 E 19 B 20 C 21 E 22 E 23 D 24 A 25 E 26 C 27 E 28 A 29 D 30 B 31 B 32 A 33 B 34 C 35 D 36 D 37 C 38 C 39 A 40 B Section 2"}],"priority":0,"status":"review","flags":["too_many_options_possible_merge","duplicate_option_labels","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","duplicate_option_text","nonunique_option_labels","nonunique_option_text","prior_structural_review_flag","too_many_options","too_many_options_possible_merge"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-7461c85c70f3","stem":"The oesophagus is constricted at the following sites","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"where it is crossed by right main bronchus"},{"label":"B","text":"where it is crossed by the azygous vein"},{"label":"C","text":"where it is crossed by the left subclavian artery"},{"label":"D","text":"where it is crossed by the thoracic duct"},{"label":"E","text":"none of the above 10) The sino-atrial node is situated:"},{"label":"A","text":"on the right of the opening of the inferior vena cava"},{"label":"B","text":"within the interatrial septum"},{"label":"C","text":"at the opening of the coronary sinus"},{"label":"D","text":"just above the crista terminalis"},{"label":"E","text":"around the lower superior vena cava 11) A surface landmark which constitutes a guide to the gastro-oesophageal orifice is the:"},{"label":"A","text":"7th left costal cartilage"},{"label":"B","text":"left linea semilunaris"}],"priority":0,"status":"review","flags":["subject_unclassified","topic_generic","too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","subject_needs_classification","subject_unclassified","too_many_options","too_many_options_possible_merge","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"8fe9479ae7d8818d49fca08afadc39c8d003fcf8"},{"id":"q-1a0b12c3147d","stem":"All but which of the following are tributaries of the coronary sinus of the heart?","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"eee40ccbfcc4795712b27724e2c59bdaeefe1a64"},{"id":"q-486ada46fe25","stem":"The posterior mediastinum contains all but which of the following?","type":"Short Answer","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Mediastin","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"0c639830cc103e0c733c0a7e00b9ecbd09ad5c86"},{"id":"q-59cf5f123b5b","stem":"Which doesn’t drain into the cardiac sinus?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"a480c4aeae9bafd8d3e0adb153b154bb5556c53c"},{"id":"q-89b866198eb8","stem":"Which muscle is not used in inspiration?","type":"Short Answer","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Thorax","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"3d33d44a8cdf57f5be79590cfb531df6c0bb76e3"},{"id":"q-0d1223e6a167","stem":"Which is not found in the posterior mediastinum?","type":"Short Answer","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Mediastin","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"6d8aeffcf59c6585ccd43f8f8a6203cb7abb7a56"},{"id":"q-7889e1618ce2","stem":"Which does NOT form part of the left border of the cardiovascular silhouette on chest x-ray?","type":"Radiological Interpretation","subject":"Radiography and Medical Imaging","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Radiography and Medical Imaging","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","repeated_question_stem","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":[],"duplicateStemGroup":"abf93f72f3a83ce04a0fe29db3798ca485353605"},{"id":"q-d8ee8b3a350a","stem":"Which of the following is NOT true with respect to the ligamentum ateriosum?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"9e9add9a4a138abe05a885363b30f0d1812c1ed5"},{"id":"q-64ff0c3bd198","stem":"Which of the following do not penetrate the diaphragm?","type":"Short Answer","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Diaphragm","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"776115e35589c1caa7bba0a02c8182cc0640c80f"},{"id":"q-80474dac1a3a","stem":"Which of the following statements about the diaphragm is NOT true?","type":"Short Answer","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Diaphragm","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"3ece47c43166c9929f433489837365a85856509b"},{"id":"q-4d7019269f3c","stem":"With regard to the diaphragm, which is NOT true?","type":"Short Answer","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Diaphragm","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"01db8965cf46b258efb4108be514f77ed0040611"},{"id":"q-7463752c057d","stem":"Which is NOT located at the level of the lower border of T4 vertebra?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"d872626a64c64fd308cc864eb6af052cfe846877"},{"id":"q-8c687b700404","stem":"Which is NOT USUALLY supplied by the right coronary artery?","type":"Short Answer","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Thorax","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"3d494218d71db09eae173a06663acc2a5d54e2e5"},{"id":"q-2cd294970503","stem":"With regard to lymphatic drainage in the thorax, which is NOT true?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"9fd6c56e55e3f7cc98625a1d3cd0782c3585810b"},{"id":"q-ca0add9ee3e2","stem":"With regard to the oesophagus, which is NOT true?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"56613d26234b5d5488e26c5f7918a7cd80e454bd"},{"id":"q-3957b39e34e4","stem":"With respect to the blood supply of the hearts, which answer is INCORRECT?","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"5314d446c01f1c5f6d9fef026b82378b454f1d08"},{"id":"q-554fe5e9724e","stem":"Which of these statements about enzymes-catalyzed reactions is false?","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Proteins and Enzymes","topicOriginal":"Proteins and Enzymes","subtopic":"Enzyme","suggestedTopic":null,"options":[{"label":"A","text":"At saturating levels of substrate, the rate of an enzyme-catalyzed reaction is proportional to the enzyme concentration"},{"label":"B","text":"If enough substrate is added, the normal Vmax of a reaction can be attained even in the presence of a competitive inhibitor"},{"label":"C","text":"The activation energy for the catalyzed reaction is the same as for the unanalyzed reaction"},{"label":"D","text":"The Michaelis-Menten constant Km equals the [S] at which V = 1⁄2 Vmax e)"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Proteins and Enzymes","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"2f0eb7f5a8eacb8ace0f8b6e902e847efa1e5204"},{"id":"q-999665770692","stem":"Which of the following statement is NOT true about enzymes","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Proteins and Enzymes","topicOriginal":"Proteins and Enzymes","subtopic":"Enzyme","suggestedTopic":null,"options":[{"label":"A","text":"They function as catalyst"},{"label":"B","text":"They lower the activation energy required for chemical reactions to proceed"},{"label":"C","text":"the active site of an enzyme has a shape that is specific."},{"label":"D","text":"All of the above are true"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Proteins and Enzymes","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-33321c6d1fea","stem":"Which one of the following double-stranded DNA molecules has the lowest melting temperature ?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"GCGCGCGCGCGCGCGC"},{"label":"B","text":"GCCATGGCCGGTACCG"},{"label":"C","text":"ATATATATTATATATA"},{"label":"D","text":"GAAATTTCCTTTAAAG"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-54559384dd15","stem":"Which of the following DNA probes will form the most stable dublex with this DNA fragment? 5”-----GTTCGTAATGCT-----3”","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"5”GGCCGCGGCCGC 3”"},{"label":"B","text":"5”AGCATTACGAAC 3”"},{"label":"C","text":"5”AGCTTTTCGAAC 3”"},{"label":"D","text":"5”GTTCGTAATGCT 3”"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-2cd423aac57d","stem":"Explain on ammonia under the following sub-headings (10marks) -formation of ammonia -excretion of ammonia/urea from the body","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-0f54ab7282c8","stem":"What controls the intensity of single-unit smooth muscle contraction Neuronal and hormonal activity Local factors, such as NO released by adjacent endothelial cells Stretch of the surface membrane of the smooth muscle cells All of the above are correct Matching item questions Note: During the exam the options are available via a pulldown menu. The first column contains a list of events that occur during skeletal muscle contraction, in which myosin binds to actin and the so-called crossbridge is formed. Which of chemical compound or ion fits the event described in each phrase best. Each option may be used once, more than once, or not at al. Put in the following schematic diagram the following series of events in the kidney with an increase in arterial pressure in the correct order. The arrows indicate the direction of the effect (increase, up; decrease, down). Event | Options | Correct answer Muscle contraction is triggered by the release from the sarcoplasmic reticulum of ... | Mg2+ | Relaxation of muscle takes place after release from troponin of ... | Ca2+ | The power stroke during the crossbridge cycle is accompanied by the release from myosin of ... | ATP (adenosine triphosphate) | Detachment of myosin from actin during the crossbridge cycle is caused by the binding to myosin of ... | H+ | | Pi (inorganic phosphate) | Item | Options | Correct answer 1 | glomerular filtration |","type":"Image / Diagram Question","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Face","suggestedTopic":null,"options":[],"priority":0,"status":"review","flags":["requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["answer_explanation_mixed_into_stem","prior_structural_review_flag","requires_visual_review","visual_asset_not_transcribed"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-c707b4dc5d54","stem":"which makes the cell perform its programmed function","type":"Short Answer","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-46cc2b5a4af8","stem":"7 Which of the following is not characteristic of hypopituitarism?","type":"Short Answer","subject":"Human Physiolo