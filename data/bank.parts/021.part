"repeated_question_stem","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"],"duplicateStemGroup":"97782bc08dd46f54a2bbf126dc766e022220b15c"},{"id":"q-6cdbd108929d","stem":"Human blood has an osmolarity that lies within the range 280– 300 mosmol/L. Which of the following statements is correct?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"an isotonic solution has osmolarity that is either less than 280 or greater than 300 mosmol/L"},{"label":"B","text":"a hypotonic solution has osmolarity between 280 and 300 mosmol/L 4 Chemistry for Physiology 77"},{"label":"C","text":"a hypertonic solution has osmolarity between 280 and 300 mosmol/L"},{"label":"D","text":"an isotonic solution has osmolarity between 280 and 300 mosmol/L"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"718d25ca99d028018ddc30f9be04fc82863393de"},{"id":"q-287e29fd4f06","stem":"Given that a mole is 6 × 1023 particles, what is a millimole?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"6 × 1020 particles"},{"label":"B","text":"one thousand moles"},{"label":"C","text":"6 × 1026 particles"},{"label":"D","text":"0.0001 moles"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Huma