Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c478f9ae48a2","stem":"involving the cavernous sinus?","type":"Short Answer","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-17433e647dec","stem":"branchial arch?","type":"Short Answer","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-034f53bd3a97","stem":"geal connective tissue are formed by what?","type":"Short Answer","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6a050ad0446a","stem":"Which of the following prominences is NOT","type":"Short Answer","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-01741b4a5fb2","stem":"which is supplied by the vertebral artery (Moore","type":"Short Answer","subject":"Human Anatomy","topic":"Histology and Tissues","topicOriginal":"Histology and Tissues","subtopic":"Artery","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Histology and Tissues","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7f3b4bbc2aff","stem":"which contains the cochlea. The anterior ca","type":"Short Answer","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4fbeb29de18f","stem":"The part of the sperm containing proteolytic enzymes to digestthe zona pellucida is the","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Proteins and Enzymes","topicOriginal":"Proteins and Enzymes","subtopic":"Enzyme","suggestedTopic":null,"options":[{"label":"A","text":"capacitor"},{"label":"B","text":"head"},{"label":"C","text":"corona"},{"label":"D","text":"acrosome"},{"label":"E","text":"cumulus"},{"label":"D","text":"is correct. The acrosome is the part of the sperm containing proteolytic enzymes to digest the zona pellucida. It is exposed by the process of capacitation. Then, under the influence of substances released by corona radiata cells, it releases its proteolytic enzymes and penetrates the oocyte. 3"}],"priority":0,"status":"review","flags":["duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Proteins and Enzymes","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"51e3c77fad4b0f52050266e10f6652149e9ad0fd"},{"id":"q-92c9e01120ca","stem":"The ovulated mammalian oocyte is arrested at","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"prophase of meiosis I"},{"label":"B","text":"metaphase of meiosis I"},{"label":"C","text":"prophase of meiosis II"},{"label":"D","text":"metaphase of meiosis II"},{"label":"E","text":"none of the above"},{"label":"D","text":"is correct. The long arrest in meiosis occurs in the primary oocyte. These descendants of oogonia begin meiosis before birth and stop dividing during prophase of the first division. Years later, this first division is completed just prior to ovulation. Ovulated secondary oocytes thenstop at metaphase II until fertilized. 4"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"2074678e3b05b8220a3c34a29f24b23e568db447"},{"id":"q-c84573d40283","stem":"The seven-day blastocyst","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"has a single layer of trophoblast at the embryonic pole"},{"label":"B","text":"has an amniotic cavity"},{"label":"C","text":"is attached to the endometrial epithelium"},{"label":"D","text":"is surrounded by a degenerating zona pellucida"},{"label":"E","text":"is called the hypoblast"},{"label":"C","text":"is correct. The decidual reaction of the endometrium creates a nourishing environment for the conceptus a it buries itself by invasion of the uterine endometrial wall. Progesterone produced by the corpus luteum stimulates glandular secretion in the endometrium during thesecretory phase of menstruation or early pregnancy. 5"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"722a559f061415f9bb16b824508b2118c01fe771"},{"id":"q-6f6c08a3841c","stem":"Haploid nuclei that fuse at fertilization are called","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"homunculi"},{"label":"B","text":"mitotic figures"},{"label":"C","text":"centrioles"},{"label":"D","text":"nucleoli"},{"label":"E","text":"pronuclei"},{"label":"E","text":"is correct. After the sperm reaches the ovum, it deposits its genetic load, the male pronucleus, into the cytoplasm of the egg. After finally completing the meiotic division that had begun years before, the female pronucleus fuses with the male pronucleus to create the diploid nucleus of the zygote 6"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"fb5760f01433fc09480701b3072f592f3293b9d2"},{"id":"q-a22bac1b20ab","stem":"The first week of human development is characterized by formation of the","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"inner cell mass"},{"label":"B","text":"hypoblast"},{"label":"C","text":"trophoblast"},{"label":"D","text":"blastocyst"},{"label":"E","text":"all of the above"},{"label":"E","text":"is correct. At four days, the blastocyst cavity of blastocele forms within the morula. Trophoblast are outer cells of the blastocyst, while a knot of cells appears, protruding into the blastocele. This is the inner cell mass. Trophoblast becomes 2 layers: syncytiotrophoblast and cytotrophoblast. Inner cell mass becomes epiblast and hypoblast. 7"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"55173aed91c2ebd82673320d7a8701913973157c"},{"id":"q-2399af94b1db","stem":"During implantation, the blastocyst","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"implants in the endometrium"},{"label":"B","text":"usually attaches to endometrial epithelium at its embryonic pole"},{"label":"C","text":"usually implants in the posterior wall of the body of the uterus"},{"label":"D","text":"causes change in the endometrial tissues"},{"label":"E","text":"all of the above are correct"},{"label":"E","text":"is correct. Implantation occurs when the trophoblast cells at the embryonic pole secrete proteolytic enzymes that allow the blastocyst to penetrate the wall of the uterus, usually the posterior wall. The endometrial lining responds to implantation through the decidua reaction, by which it becomes more succulent for nourishing the blastocyst. 8"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"ccdce72fae42130a8d890fc0905366832c577c11"},{"id":"q-473a3e0c51ac","stem":"Capacitation of the sperm","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"is caused by the zona pellucida"},{"label":"B","text":"occurs in the male"},{"label":"C","text":"prevents polyspermy"},{"label":"D","text":"is essential for fertilization"},{"label":"E","text":"removes the head of the sperm"},{"label":"D","text":"is correct. Capacitation involves removing the glycoprotein coat and seminal plasma proteins from the head of the sperm, exposing the acrosome and allowing the acrosome reaction to occur. Capacitation occurswithin the female genital tract, and without its occurrence, fertilization could not occur. 9"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"708b252580d3bf13fd2686d0256ca5f4f551cf5d"},{"id":"q-45d9237c568c","stem":"The early stages of cleavage are characterized by","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"formation of a hollow ball of cells"},{"label":"B","text":"formation of the zona pellucida"},{"label":"C","text":"increase in the size of the cells in the zygote"},{"label":"D","text":"increase in the number of cells in the zygote"},{"label":"E","text":"none of the above"},{"label":"D","text":"is correct. The earliest stages of cleavage are marked by a series of mitotic divisions that increase the number of cells in the zygote without an increase in size. As the cleavage continues the zygote becomes a morula or a solid ball of 12-16 cels. A cavity forming within the morula transforms it into a blasocyst, at about day 4. 10"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"6d53b4b9db8b97385de381dac142293c1dcfad9d"},{"id":"q-d08beda6881e","stem":"The most common site for implantation in ectopic pregnancy is","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"internal os of the uterus"},{"label":"B","text":"mesentery"},{"label":"C","text":"ovary"},{"label":"D","text":"uterine tube"},{"label":"E","text":"other"},{"label":"D","text":"is correct. The most common site of ectopic implantation is the uterine tube. The growth of the embryo in this site usually causes rupture of the tube and severe hemorrhage in the mother. Abdominally, an ectopic pregnancy often occurs in the rectouterine pouch, an area between the uterusand the rectum. 11"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"b66f620a8abd0de1f90c14b801bc046b665d8cdd"},{"id":"q-ea5394edf0c2","stem":"With the light microscope, the zona pellucida appears as a translucent membrane surrounding the","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"primary oocyte"},{"label":"B","text":"zygote"},{"label":"C","text":"morula"},{"label":"D","text":"very early blastocyst"},{"label":"E","text":"all of the above are correct"},{"label":"E","text":"is correct. The zona pellucida persists until early it the blastocyst stage. It dissolves during the blastocyst stage in order that implantation may occur. 12"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"fa658964095a448f286240976c796b16f59e6246"},{"id":"q-873c030a4caa","stem":"The amniotic cavity develops","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"on the tenth day"},{"label":"B","text":"within the outer cell mass"},{"label":"C","text":"within the inner cell mass near the cytotrophoblast"},{"label":"D","text":"in extraembryonic mesoderm"},{"label":"E","text":"none of the above"},{"label":"C","text":"is correct. The amniotic cavity begins to develop around the 8th ay as a slit-like area within the epiblast near the cytotrophoblast. It usually ha athin strip of epiblast cells, called amnioblasts, between it and the cytotrophoblast. 13"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"3f5fb5bf0e01e148de1d7fc535ae889e3d8d7465"},{"id":"q-7b51c74cb7f6","stem":"During the second week of development, the trophoblast differentiates into","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"syncytiotrophoblast"},{"label":"B","text":"ectoderm"},{"label":"C","text":"intraembryonic mesoderm"},{"label":"D","text":"yolk sac (secondary)"},{"label":"A","text":"is correct. The trophoblast gives rise to both the syncytiotrophoblast and the cytotrophoblast, as well as the extraembryonic mesoderm. The ectoderm is a derivative of the epiblast, and the secondary yolk sac comes from endoderm cells that line the exocoelomic cavity or the primitive yolk sac. 14"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"680bb85da2ff1dadcc046756ef7397d6c1bedd5d"},{"id":"q-9de0662ed1aa","stem":"The first two intraembryonic germ layers to differentiate are the","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"ectoderm and hypoblast"},{"label":"B","text":"epiblast and hypoblast"},{"label":"C","text":"ectoderm and endoderm"},{"label":"D","text":"ectoderm and mesoderm"},{"label":"B","text":"is correct. The epiblast and hypoblast develop from the inner cell mass during the 2nd week. During the 3rd week, the epiblast produces cells between itself and the hypoblast, called the mesoderm. Epiblast also replaces the hypoblast with endoderm cells. Epiblast then changes its name to ectoderm, completing the process of gastrulation. 15"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"b3759324f6bc689999a6a8dce17e8a9e41bca87f"},{"id":"q-df1065f52faa","stem":"The blastocoele becomes the","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"amniotic cavity"},{"label":"B","text":"extraembryonic coelom"},{"label":"C","text":"primary yolk sac"},{"label":"D","text":"chorionic cavity"},{"label":"E","text":"secondary cavity"},{"label":"C","text":"is correct. Around the 9th day, cells from the hypoblast spread around the blastocoele, forming the exocoelomic or Heuser's membrane. When the blastocoele is surrounded by this membrane, it is referred to as the primary yolk sac or exocoelomic cavity. 16"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"a73f233502963433135853987b2cd96f64b3d6e2"},{"id":"q-b8474aec1ba8","stem":"The bilaminar germ disc","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"consists of epiblast and mesoblast"},{"label":"B","text":"is derived from the outer cells of the morula"},{"label":"C","text":"forms the embryo proper"},{"label":"D","text":"synthesizes human chorionic gonadotropin, HCG"},{"label":"C","text":"is correct. The bilaminar germ disc develops from the inner cells of the morula and inner cell mass of the blastocyst. It is composed to epiblast and hypoblast layers, and it is also called the embryoblast because it becomes the embryo. The outer cells of the morula and blastocyst become cyto- and syncytiotrophoblast. The latter produces HCG. 17"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"05367e9f135a774484fd7ee79beff309103245f7"},{"id":"q-c21194837835","stem":"The primitive streak first appears at the beginning of the week.","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"first"},{"label":"B","text":"second"},{"label":"C","text":"third"},{"label":"D","text":"fourth"},{"label":"E","text":"fifth"},{"label":"C","text":"is correct. Gastrulation, the process of formation of the three germ layers, occurs during the third week. Epiblast cells form a thickening called the primitive streak, with a primitive knot or node located at its cranial end. Epiblast cells invaginate from this streak to form the mesoderm layer and to replace hypoblast with endoderm. 18"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"571801dc6482090d746ec86ab1332ace955dc99c"},{"id":"q-f18ad330e462","stem":"Which of the following structures is believed to be a primary organizer or inducer during organogenesis?","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"somites"},{"label":"B","text":"notochord"},{"label":"C","text":"metanephric blastema"},{"label":"D","text":"lens placode"},{"label":"E","text":"none of the above"},{"label":"B","text":"is correct. The notochord is thought to be an important structure in induction of nervous system development, axial skeleton development and other organogenic events. 19"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"68e24e4bcbe07008fbe957e6ac94fec3622ef4ac"},{"id":"q-68eba72412cd","stem":"Cells from the primitive streak DO NOT become","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"endoderm"},{"label":"B","text":"intermediate mesoderm"},{"label":"C","text":"paraxial mesoderm"},{"label":"D","text":"lateral plate mesoderm"},{"label":"E","text":"amnioblasts"},{"label":"E","text":"is correct. All mesoderm is a derivative of the invaginating cells at the primitive streak. The invagination occurs at the beginning of the third week. Itis interesting that endoderm cells are also derived from the epiblast during gastrulation, replacing the hypoblast. 20"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"d28a0b339ae0cfb4222c237f0319bab966954280"},{"id":"q-fa26eb87aea5","stem":"The primitive streak","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"is derived from the outer cells of the morula"},{"label":"B","text":"is formed during the second week in development"},{"label":"C","text":"persists as the cloacal membrane"},{"label":"D","text":"is the site of involution of epiblast cells to form mesoderm"},{"label":"E","text":"was done in a bathing suit, for those who remember streaking"},{"label":"D","text":"is correct. The primitive streak begins to form on the surface of the epiblast at the beginning of the third week. It is at the primitive streak that epiblast cells invaginate to form the mesoderm, through the process of gastrulation. Streaking was a fad of the 1970's that involved running naked in public, definitely not a winter sport. 21"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"4a678bf9bbfb0537d1582ee299d32372cdc25f6c"},{"id":"q-e353030ca980","stem":"In the third week of human embryonic development","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the amnion appears"},{"label":"B","text":"a bilaminar embryonic disc is formed"},{"label":"C","text":"the body stalk moves ventrally and joins with the yolk sac stalk to form the umbilical cord"},{"label":"D","text":"the neural plate is induced by the notochordal process and associated mesoderm"},{"label":"E","text":"the uteroplacental circulation is established"},{"label":"D","text":"is correct. It is during the third week that the notochordal process and its associated mesoderm induce the neural plate. The hollow notochordal process eventually becomes the solid notochord, the forerunner of the axial skeleton. 22"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"bdec732e2b9c93eaf13106c311cd2a4a0366b69e"},{"id":"q-56964c8c9d6c","stem":"During development, the notochordal process","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"arises from involuting endodermal cells"},{"label":"B","text":"extends from the prochordal plate to the primitive node"},{"label":"C","text":"is involved in the induction of the primitive gut"},{"label":"D","text":"becomes the appendicular skeleton"},{"label":"B","text":"is correct. The notochordal process extends from the primitive node up to the prochordal plate. It develops into the notochord, around which the vertebral column forms. The notochord is not endodermal, and does not induce the primitive gut. It persists in the adult only as the nucleus pulposus of the intervertebral discs. 23"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"b630edbd5607fdd1002756a7761ad77494bb74ad"},{"id":"q-02763f8f6231","stem":"The following organs are derived from mesoderm EXCEPT","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"skeletal musculature"},{"label":"B","text":"musculature of blood vessels"},{"label":"C","text":"cardiac musculature"},{"label":"D","text":"suprarenal cortex"},{"label":"E","text":"suprarenal medulla"},{"label":"E","text":"is correct. The suprarenal or adrenal medulla is actually a part of thesympathetic nervous system. Therefore, it is a derivative of neural crest cells, and neural crest cells are ectodermal in origin. 24"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"cebbc9d83e02045876bfc5e7ff390b05c0b6aad6"},{"id":"q-9e2cc3173f7c","stem":"Almost all of the internal organs are well laid down at months.","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"1"},{"label":"B","text":"2"},{"label":"C","text":"3"},{"label":"D","text":"4"},{"label":"E","text":"5"},{"label":"B","text":"is correct By the end of the embryonic period at about two months of the development almost all of the internal organs are well established. This is important, in that most malformations occur within the first two months, while the internal organs are being formed. The rest of the gestational period allows for growth and maturation. 26"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"704bb62ccc79d8f56290bb1ee6e1bb78bd104a8c"},{"id":"q-6356254b115c","stem":"Which of the following structures does not turn under onto the ventral surface of the embryo during folding of the head?","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"prochordal plate"},{"label":"B","text":"heart"},{"label":"C","text":"notochord"},{"label":"D","text":"pericardial cavity"},{"label":"E","text":"septum transversum"},{"label":"C","text":"is correct. The buccopharyngeal membrane, heart, pericardial cavity and septum transversum all end up as ventral structures in the embryo, whereas the notochord remains dorsal. Remember, though, that before the folding of the embryo, the heart begins its development extraembryonically in a region anterior to the prochordal plate. 27"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"5cc7ab4a1ef9fd1d925384680550557a27080957"},{"id":"q-bf87887fe74c","stem":"When the amount of amniotic fluid exceeds two liters, the condition is called","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"oligohydramnios"},{"label":"B","text":"polyhydramnios or hydramnios"},{"label":"C","text":"amniotitis"},{"label":"D","text":"bag of waters"},{"label":"E","text":"hydrogravida"},{"label":"B","text":"is correct. Polyhydramnios is a condition of excess amniotic fluid exceeding 1.5 liters. It is often caused by failure of the fetus to drink the normal amount of amniotic fluid, and may be due to anencephaly, esophageal atresia, or an upper GI tract blockage. Oligohydramnios, too little amniotic fluid, may indicate urinary problems. 28"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"f26f4d61863c88402dec2869111dfd934474286f"},{"id":"q-33d6162855a9","stem":"The wall of the chorionic sac is composed of","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"cytotrophoblast and syncytiotrophoblast"},{"label":"B","text":"two layers of trophoblast lined by extraembryonic somatic mesoderm"},{"label":"C","text":"trophoblast and exocoelomic membrane"},{"label":"D","text":"extraembryonic splanchnic mesoderm and both layersof trophoblast"},{"label":"E","text":"none of the above"},{"label":"B","text":"is correct. The outer layer of chorionic sac is the cytotrophoblast shell; the sac is lined with extraembryonic mesoderm of somatic type, because it does not contact the yolk sac; lining the intervillous space is syncytium. Later, the amniotic sac pushes up against and fuses to the chorionic sac, obliterating the chorionic cavity. 29"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"463d0cc4bd604844d9279ca311f978524503c367"},{"id":"q-9c91c0a0fc44","stem":"The most distinctive characteristic of a primary chorionic villus is its","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"outer syncytiotrophoblastic layer"},{"label":"B","text":"cytotrophoblastic shell"},{"label":"C","text":"extraembryonic somatic mesodermal core"},{"label":"D","text":"bushy appearance"},{"label":"E","text":"cytotrophoblastic core"},{"label":"E","text":"is correct. All chorionic villi possess an outer layer of syncytiotrophoblast. The cytotrophoblast shell is a feature of the mature chorion. Extraembryonic somatic mesoderm forms the core of secondary villi, becoming tertiary with vascular development. Primary villi, at 14 days, are syncytial processes with a core of cytotrophoblast. 30"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"19fb59b029e93a18b42710b4c372607b28fa07cb"},{"id":"q-e1e4b84ba175","stem":"Chorionic villi are designated as secondary chorionic villi when they","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"contact the decidua basalis"},{"label":"B","text":"are covered by syncytiotrophoblast"},{"label":"C","text":"develop a mesenchymal core"},{"label":"D","text":"give rise to branch villi"},{"label":"E","text":"none of the above"},{"label":"C","text":"is correct. All chorionic villi possess an outer layer of syncytiotrophoblast. The cytotrophoblast shell is a feature of the mature chorion. Extraembryonic somatic mesoderm forms the core of secondary villi, becoming tertiary with vascular development. Primary villi, at 14 days, are syncytial processes with a core of cytotrophoblast. 31"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"ec47c4af912d6a331b80bcb1eec1670d90623016"},{"id":"q-9cc95cd90535","stem":"When chorionic villi become vascularized they are called villi.","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"branch"},{"label":"B","text":"stem"},{"label":"C","text":"tertiary"},{"label":"D","text":"anchoring"},{"label":"E","text":"mature"},{"label":"C","text":"is correct As secondary chorionic villi become vascularized, they become known as tertiary villi. Maturation of the villi involves thinning of the placental barrier, so that only a thin layer of syncytium, extracellular matrix and endothelium separates maternal and fetal blood. 32"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"beb3c6d531fff9728c52b6b1482cdcc1f2f2be84"},{"id":"q-540bc496197a","stem":"The most important region of the decidua for the nourishment of the conceptus is the decidua .","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"frondosum"},{"label":"B","text":"capsularis"},{"label":"C","text":"parietalis"},{"label":"D","text":"basalis"},{"label":"E","text":"laeve"},{"label":"D","text":"is correct. The placenta is made of maternal tissue, the decidua basalis, and fetal tissue, the chorion frondosum or bushy/villous chorion. The smooth chorion or chorion laeve is covered by decidua capsularis, which disappears as the fetus grows and smooth chorion pushes up against he decidua parietalis. 33"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"105afb7e08479a5d9fa4f8e247bdf87e72c07fef"},{"id":"q-03f6d6ebf1c9","stem":"The intervillous space contains all of the followingsubstances EXCEPT","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"oxygen"},{"label":"B","text":"carbon dioxide"},{"label":"C","text":"maternal blood cells"},{"label":"D","text":"fetal blood"},{"label":"E","text":"electrolytes"},{"label":"D","text":"is correct Maternal blood cells find their way through the dark intervillous space with electrolytes, oxygen and other good things, and they carry away bad things like carbon dioxide and fetal waste products. However, fetal blood does not normally enter the intervillous space but is separated from it by the placental barrier. 34"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"e9268fb7227af108809cbd77521a1f734175795d"},{"id":"q-bcb344c8cdc2","stem":"The portion of the decidua which does not survive until the end of pregnancy is the","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"capsularis"},{"label":"B","text":"basalis"},{"label":"C","text":"laeve"},{"label":"D","text":"parietalis"},{"label":"E","text":"frondosum"},{"label":"A","text":"is correct Chorion frondosum and the decidua basalis make up the placenta. Chorion laeve, or smooth chorion, is covered by decidua capsularis. As the fetus and chorion enlarge the chorion laeve pushes against the decidua parietalis and the capsularis disappears. 35"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"bc9cbcc2fc590610d76697484f8bef629e13189e"},{"id":"q-1438e8021952","stem":"Which of the following is NOT a component of the mature placental barrier?","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the endothelial lining of fetal capillaries"},{"label":"B","text":"the cytotrophoblast"},{"label":"C","text":"the syncytiotrophoblast"},{"label":"D","text":"the basement membrane of fetal capillaries"},{"label":"E","text":"all of the above are part of the mature placental barrier"},{"label":"B","text":"is correct. In the last half of pregnancy, the cytotrophoblast and extraembryonic mesoderm layers are lost from the placental barrier, leaving only syncytium, capillary basement membrane and capillary endothelium between maternal and fetal circulations. 36"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"6383045055caec281adac44c86fd7b1689f1ccf8"},{"id":"q-91e3950f40e8","stem":"Failure of the brain to grow may result in","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"plagiocephaly"},{"label":"B","text":"craniostenosis"},{"label":"C","text":"acrocephaly"},{"label":"D","text":"scaphocephaly"},{"label":"E","text":"microcephaly"},{"label":"E","text":"is correct. If the brain does not grow, neither will the skull. This results in microcephaly. Premature closure of cranial sutures is called craniostenosis. Early sagittal suture fusion causes scaphocephaly or a long skull. Early coronal fusion causes acrocephaly or tower skull. Asymmetric fusions produce plagiocephaly. 37"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"e96a6895bc480c193ffc700d40a6d7d673f2cf68"},{"id":"q-e0f15f191044","stem":"Somitomeres, paraxial mesoderm cranial to the somites, give rise to much of the skeletal muscle in the head EXCEPT","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Cranial","suggestedTopic":null,"options":[{"label":"A","text":"extrinsic muscles of the eye"},{"label":"B","text":"temporalis tongue muscles"},{"label":"C","text":"muscles of facial expression"},{"label":"D","text":"muscles of mastication"},{"label":"B","text":"is correct. Somitomeres provide myotomal tissue for skeletal muscledevelopment to the head. Muscles of somitomere origin include the extrinsic eye muscles, the muscles of facial expression and the muscles of mastication, of which temporalis is one. Tongue muscles and the muscles of the larynx are from somitic myotomes. 38"}],"priority":0,"status":"review","flags":["duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"0b75d67a125a77ebb0dc887dcdf1bc1c41c91b26"},{"id":"q-56b617f72f9c","stem":"The sphenoid bone is derived from which portion of the embryonic skull?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Head and Neck","options":[{"label":"A","text":"cartilaginous neurocranium"},{"label":"B","text":"membranous neurocranium"},{"label":"C","text":"cartrilaginous viscerocranium"},{"label":"D","text":"membranous viscerocranium"},{"label":"E","text":"branchial cartilage"},{"label":"A","text":"is correct. The skull consists of two parts, the neurocranium, which forms thevault protecting the brain, and the viscerocranium, which forms the bones of the face. The base of the skull, of which sphenoid is part, develops from the cartilaginous neurocranium because it forms by endochondral ossification. Skull vault is membranous. 39"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"593c241634ffd3263bfa2a95507c8b6ac1212709"},{"id":"q-670f405cf548","stem":"The notochord is replaced by the","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"ependyma"},{"label":"B","text":"nucleus pulposus"},{"label":"C","text":"spinal canal"},{"label":"D","text":"dorsal roots"},{"label":"E","text":"spinal cord"},{"label":"B","text":"is correct. The notochord is the forerunner of the vertebral column. As it is replaced by the vertebral column, it degenerates. All that remains of the notochord in the adult is the nucleus pulposus in the intervertebral discs, surrounded by the sclerotome-derived annulus fibrosus. 40"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"2e78593cda359aa022c239fb60ad846d7e855144"},{"id":"q-87997b0d9358","stem":"The intraembryonic coelom located cranial to the oropharyngeal membrane becomes the","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"oral cavity"},{"label":"B","text":"cranial foregut"},{"label":"C","text":"stomodeum"},{"label":"D","text":"pericardial cavity"},{"label":"E","text":"nasal cavity"},{"label":"D","text":"is correct. The cardiogenic region lies cranial to the prochordal plate and its descendant, the oropharyngeal membrane. The heart tubes form on the endoderm side of intraembryonic coelom in the cardiogenic region. Following the head and lateral body folding, heart and its portion of intraembryonic coelom called pericardial cavity lie in the chest. 41"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"e610a20594318054216c871f1975ec00f188e306"},{"id":"q-78d017772d7f","stem":"The derivatives of the embryonic ventral mesentery include the following structures EXCEPT","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"hepatoduodenal ligament"},{"label":"B","text":"hepatogastric ligament"},{"label":"C","text":"falciform ligament"},{"label":"D","text":"ligamentum teres hepatis"},{"label":"E","text":"lesser omentum"},{"label":"D","text":"is correct. The ligamentum teres hepatis is a remnant of the fetal umbilicalvein. Although it is contained within the ventral mesentery, it is not a derivative of it. 42"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"567a217d597cc7720b24c287a5c1680e771f9000"},{"id":"q-4698b1e79400","stem":"The following peritoneal ligaments are derived wholly or in part from the embryonic dorsal mesogastrium EXCEPT","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Abdomen","topicOriginal":"Abdomen","subtopic":"Peritone","suggestedTopic":null,"options":[{"label":"A","text":"hepatogastric ligament"},{"label":"B","text":"splenorenal or lienorenal ligament"},{"label":"C","text":"gastrosplenic or gastrolienal ligament"},{"label":"D","text":"gastrocolic ligament"},{"label":"E","text":"transverse mesocolon"},{"label":"A","text":"is correct. Splenorenal, gastrosplenic and gastrocolic ligaments are derived from the dorsal mesogastrium, while transverse mesocolon fuses with dorsal mesogastrium. The nepatogastric ligament, on the other hand, is derived from the ventral mesentery. 43"}],"priority":0,"status":"review","flags":["duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Abdomen","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"9e09d5783b5cccf4bfd8ee18eff76d17d23d9a13"},{"id":"q-f18c6dcb2b7e","stem":"After folding of the head region, the structure lying just caudal to the pericardial cavity is the","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"developing heart"},{"label":"B","text":"connecting stalk"},{"label":"C","text":"primitive streak"},{"label":"D","text":"liver"},{"label":"E","text":"septum transversum"},{"label":"E","text":"is correct. The septum transversum is the diaphragm's earliest progenitor. After folding of the head region brings the heart and its coleom region ventrally, the septum transversum is the structure that lies immediately caudal to it. Liver is not a bad guess, but remember that the diaphragm lies between it and the thorax in the adult. 44"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"12776590fe7d0e817024b8137de7ed63b62b30dd"},{"id":"q-813df3b0860e","stem":"The hypobranchial eminence contributes to formation of","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"anterior portion of the tongue"},{"label":"B","text":"posterior portion of the tongue"},{"label":"C","text":"musculature of the tongue"},{"label":"D","text":"epiglottis"},{"label":"E","text":"palatine tonsil"},{"label":"B","text":"is correct. Hypobranchial eminence forms the posterior third of the tongue. It is served by the nerve of the 3rd branchial arch, glossopharyngeal. Tongue musculature arises from occipital somites and is innervated by CN XII, hypoglossal. Epiglottis arises as an epiglottic swelling on the 4th arch. Palatine tonsil is from the 2nd pouch. 45"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"2b37af5bb872b287ce0c57ee35c3dac149f4d6a1"},{"id":"q-3c557600747f","stem":"The fact that general and special sensory information from the posterior part of the tongue is carried by glossopharyngeal nerve indicates that this part of tongue is from branchial arch .","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"I"},{"label":"B","text":"II"},{"label":"C","text":"III"},{"label":"D","text":"IV"},{"label":"E","text":"VI"},{"label":"C","text":"is correct Hypobranchial eminence forms the posterior third of the tongue. It is served by the nerve of the 3rd branchial arch, glossopharyngeal, or cranial nerve IX. Glossopharyngeal carries general sense and the special sense of taste fromthis part of the tongue. In anterior tongue, trigeminal does general and facial does special sense. 46"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"fc5f6a07754589299235a48f106a079495b19cae"},{"id":"q-f66e18801fef","stem":"Myoblasts from the occipital myotomes are believed to give rise to the muscles of the","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"eye"},{"label":"B","text":"face"},{"label":"C","text":"ear"},{"label":"D","text":"jaw, for mastication"},{"label":"E","text":"tongue"},{"label":"E","text":"is correct. Most of the muscles of the head arise from the somitomeres located cranial to the occipital somites. Occipital myotomes supply muscle for tongue, and are innervated by cranial nerve XII, hypoglossal. 47"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"914c9daed47fce96f5bee71ff1f1bd1311af7114"},{"id":"q-1cd0aff6f992","stem":"As a resident in pediatrics, you are called to see a newborn who has a unilateral cleft lip and a unilateral cleft of the primary palate. This condition is most likely the result of","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"failure of fusion of the mandibular prominences"},{"label":"B","text":"failure of fusion of the medial nasal processes"},{"label":"C","text":"failure of fusion of the maxillary prominence with the medial nasal prominence"},{"label":"D","text":"failure of fusion of the lateral palatine processes with the nasal septum"},{"label":"E","text":"failure of fusion of the paired lateral palatine processes."},{"label":"C","text":"is correct. This type of cleft is a failure of fusion, or secondary rupture of the union, of maxillary prominence with medial nasal prominence. If the palatine shelves or processes of maxillary prominences rupture or fail to fuse, a midline defect of the secondary palate will result. 48"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"7e4db427539f4f0675a31a3af6b1f9ad8e5514ed"},{"id":"q-5f596c75a6e2","stem":"Which of the following structures is NOT part of the first branchial arch?","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"malleus"},{"label":"B","text":"mandibular process"},{"label":"C","text":"sphenomandibular ligament"},{"label":"D","text":"stylohyoid ligament"},{"label":"E","text":"maxillary process"},{"label":"D","text":"is correct. Mandibular and maxillary processes are both from first arch, as are malleus and incus bones of the ear. Sphenomandibular ligament is the remnant of the perichondrium of Meckel's cartilage, around whichthe mandible forms. Second arch cartilage gives rise to stapes, styloid process, stylohyoid ligament, lesser horns and upper part of hyoid. 49"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"6b15e8628ddd04843a42244091ded367e32f9271"},{"id":"q-e0ba37918aae","stem":"The brain flexure which develops between the metencephalon and the myelencephalon is called the","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"pontine"},{"label":"B","text":"hindbrain"},{"label":"C","text":"cervical"},{"label":"D","text":"cephalic"},{"label":"E","text":"midbrain"},{"label":"A","text":"is correct. The pontine flexure occurs between the metencephalon, which forms the pons and cerebellum, and the myelencephalon, which forms the medulla. The two other flexures, the cephalic and the cervical, flex in a direction opposite that of the pontine. 50"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"0eaa51fbef55e0cf357879249d8290013a7bcb30"},{"id":"q-2397077f13b5","stem":"Which structures are derived from the intermaxillary segment of the embryonic face?","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"philtrum"},{"label":"B","text":"anterior portion of the palate"},{"label":"C","text":"anterior portion of the upper jaws"},{"label":"D","text":"upper incisor teeth"},{"label":"E","text":"all of the above are correct"},{"label":"E","text":"is correct. The intermaxillary segment gives rise to the philtrum, the upper incisors, the anterior portion of the upper jaws, and the primary palate, which lies anteriorly. 51"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"309844e838c11a74dc0ce4f23bb5b683f3dec6a1"},{"id":"q-dda23ab83518","stem":"The nasolacrimal groove separates the","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"mandibular and maxillary swellings"},{"label":"B","text":"lateral nasal swelling and maxillary swelling"},{"label":"C","text":"medial nasal swelling and maxillary swelling"},{"label":"D","text":"first and second branchial arches"},{"label":"E","text":"otic and optic vesicles"},{"label":"B","text":"is correct. The nasolacrimal groove lies between the maxillary swelling or prominence and the lateral nasal swelling. This groove ultimately forms the nasolacrimal duct and lacrimal sac. In the adult, it is the passage used by tears to travel from the eye to inferior meatus of the nasal cavity, to make your nose run when you cry. 52"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"4a38df41d33922579f52f429fded34ef8cc0986b"},{"id":"q-98845bed38a6","stem":"Many facial malformations are believed to be due to","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"a failure of the oral membrane to rupture"},{"label":"B","text":"a failure to neural crest cells to migrate into the facial processes"},{"label":"C","text":"a failure in growth of the head fold"},{"label":"D","text":"an abnormal persistence of the pharyngeal clefts"},{"label":"E","text":"none of the above"},{"label":"B","text":"is correct Proper migration of neural crest cells into the face area is vitally important to facial development. Neural crest tissue will form muchof the facial skeleton. 53"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"f4edecb092014a3c3278c691813ffa3d88b39853"},{"id":"q-dbfaec7d57dc","stem":"The foramen cecum of the adult tongue","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"marks the point of embryonic evagination of the thymus gland"},{"label":"B","text":"divides the tongue into two parts, an anterior one-third and a posterior two-thirds"},{"label":"C","text":"marks the point of embryonic evagination of the thyroid gland"},{"label":"D","text":"develops into taste buds"},{"label":"E","text":"has no embryologic significance"},{"label":"C","text":"is correct. The foramen cecum on the tongue is the point from which the thyroid gland evaginated and began its journey down into the neck. It lies at the apex of the V-shaped terminal sulcus, which divides the tongue into anterior 2/3rds, from the lateral lingual swellings and truberculum impar, and posterior 1/3rd, from the copula. 54"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"ddced78aa9ef59489720dd5350e6d6f08189c754"},{"id":"q-f45b905b6a6c","stem":"Each pharyngeal arch includes","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"derivatives of ectodermal neural crest cells"},{"label":"B","text":"an aortic arch artery"},{"label":"C","text":"a mesodermal core from paraxial mesoderm"},{"label":"D","text":"a cranial nerve"},{"label":"E","text":"all of the above"},{"label":"E","text":"is correct. The pharyngeal arches have their own mesodermal core, giving rise to cartilaginous and muscular components, cranial nerve components, vascular components and derivatives of neural crest cells, which supplement much of the connective tissue of the face. 55"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"88a02c99d9b78d6bd7dfad183f2d53b55eb61928"},{"id":"q-3c1bdf10b50b","stem":"Which of the following are associated with the 2nd pharyngeal arch?","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the malleus bone"},{"label":"B","text":"facial nerve"},{"label":"C","text":"glossopharyngeal muscle"},{"label":"D","text":"the lower portion of the hyoid bone"},{"label":"E","text":"anterior belly of digastric"},{"label":"B","text":"is correct. The stapes, styloid process, stylohyoid ligament, lesser horn of hyoid and upper part of hyoid body all come from 2nd arch. The nerve of the 2nd arch is CN VII or facial nerve, and the muscles are stapedius, stylohyoid, posterior belly of digastric and the muscles of facial expression. 56"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"2e2d24022c0eb8b1dfcda7a357b0712af2a75e8c"},{"id":"q-bbf97d329f62","stem":"Branchial cysts or lateral cervical cysts","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"are found along the anterior border of thesternocleidomastoid muscle"},{"label":"B","text":"are formed from a rupture of the membrane between pharyngeal pouches and branchial clefts"},{"label":"C","text":"are remnants of the thyroglossal duct"},{"label":"D","text":"are found in front of the ear"},{"label":"A","text":"is correct Lateral cervical cysts are remnants of the cervical sinus, which forms when the 2nd arch grows over the 3rd and 4th arches. The cysts are found along the anterior border of the sternocleidomastoid muscle, usually just below the angle of the jaw. They have nothing to do with the rupture or anything. 57"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"94f9079b956892b65ea6b1d4cddc526306233058"},{"id":"q-e36bbbd1427a","stem":"The heart is derived from","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"splanchnic mesoderm"},{"label":"B","text":"somatic mesoderm"},{"label":"C","text":"septum transversum"},{"label":"D","text":"intermediate mesoderm"},{"label":"E","text":"paraxial mesoderm"},{"label":"A","text":"is correct The heart tubes form within the cardiogenic region cranial to the oropharyngeal membrane and beneath the intraembryonic coelom. If it is beneath the intraembryonic coelom, then it lies toward the yolk sac and must be splanchnic mesoderm. Somatic mesoderm would be the other side, or roof, of the intraembryonic coelom. 58"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"29a66227792a90cbd6875fcbbf79c85faee64695"},{"id":"q-b74014829c10","stem":"The most superior part of the inferior vena cava is derived from","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"left vitelline vein"},{"label":"B","text":"right vitelline vein"},{"label":"C","text":"right umbilial vein"},{"label":"D","text":"left umbilical vein"},{"label":"E","text":"sinus venosus"},{"label":"B","text":"is correct. The vitelline veins, as they pass through the developing liver, break up into hepatic sinusoids. When the left sinus horn regresses, blood is shunted from the left vitelline vein to the right, which enlarges and ultimately forms the posthepatic portion of the inferior vena cava. 59"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"0354e35335a772773c396c98291cec74a868417e"},{"id":"q-984247a565a7","stem":"The embryonic origin of the ligamentum arteriosum is from the","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"second arch artery"},{"label":"B","text":"third arch artery"},{"label":"C","text":"fourth arch artery"},{"label":"D","text":"fifth arch artery"},{"label":"E","text":"sixth arch artery"},{"label":"E","text":"is correct The sixth arch is the pulmonary arch, from which pulmonary arteries are derived. On the left side, this arch maintains its connection with the dorsal aorta. In the fetus, this connection is patent and is called the ductus arteriosus. Postnatally, it closes and persists as the ligamentum arteriosum. 60"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"ffa7ba0010e7c2a641a1a69271594f6fe970d984"},{"id":"q-2f316886e189","stem":"The following are true statements with regard to the fetal circulation EXCEPT","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Since the fetal liver is a hemopoietic organ, it is large and well supplied with oxygenated blood."},{"label":"B","text":"Fetal brain receives relatively pure arterial blood."},{"label":"C","text":"Fetal and maternal blood vessels anastomose in the placenta"},{"label":"D","text":"In early developmental stages, one pulmonary vein buds from the left atrium of the heart."},{"label":"E","text":"Foramen primum of the interatrial septum closes after the formation of the foramen secundum."},{"label":"C","text":"is correct. In the placenta, there is no anastomosis between the maternal and fetal vessels. Maternal blood from the spiral arteries enters the cotyledons, where it bathes the villi from the fetus. This all occurs without anastomosis. 61"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"ac9709c12ce007c3c3f016b44c78363da4339324"},{"id":"q-10108765e2c3","stem":"Each of the following statements are correctly paired EXCEPT","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"right vitelline vein - inferior vena cava"},{"label":"B","text":"left vitelline vein - liver sinusoids"},{"label":"C","text":"right anterior cardinal vein - part of superior vena cava"},{"label":"D","text":"right umbilical vein - definitive umbilical vein"},{"label":"E","text":"left sinus horn - coronary sinus"},{"label":"D","text":"is correct. The right umbilical vein totally disappears. The definitive umbilical vein is the left one. After birth, it closes and becomes the ligamentum teres hepatis. 62"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"f329d848236859ef509ea0350a911609a27e5268"},{"id":"q-832a79b75cd9","stem":"The following embryonic structures are involved in theformation of the definitive right atrium EXCEPT","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"primitive atrium"},{"label":"B","text":"right sinus venosus"},{"label":"C","text":"left sinus venosus"},{"label":"D","text":"right sinus horn"},{"label":"E","text":"left sinus horn"},{"label":"E","text":"is correct. The left sinus horn regresses during development to form coronary sinus. Oblique vein of left atrium, from left common cardinal, drains to it. Coronary sinus drains blood from the heart into the right atrium. 63"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"cfd149d3ed1e4da583b8517c0a21ec588e2cc89b"},{"id":"q-06b89cee10e9","stem":"Each of the following ligaments in the adult are derived from fetal blood vessels EXCEPT","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"medial umbilical ligament"},{"label":"B","text":"median umbilical ligament"},{"label":"C","text":"round ligament of the liver (ligamentum teres hepatis)"},{"label":"D","text":"ligamentum venosum"},{"label":"E","text":"ligamentum arteriosum"},{"label":"B","text":"is correct. Median umbilical ligament, attaching to upper part of bladder, is a remnant of the urachus, which itself was a remnant of the allantois. The allantois was a connection between the urinary bladder and the yolk sac, not a fetal blood vessel. 64"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"d42c51398fa562a047158cb7d083f537787dda12"},{"id":"q-189c9e83b388","stem":"Of the following the one most closely associated with the ligamentum teres hepatis is","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"umbilical vein"},{"label":"B","text":"umbilical artery"},{"label":"C","text":"vitelline vein"},{"label":"D","text":"3rd aortic arch"},{"label":"E","text":"6th aortic arch"},{"label":"A","text":"is correct. The ligamentum teres hepatis is the remnant of the umbilical veinafter the umbilical vein closes at birth. It can be found in the falciform ligament, a ventral mesentery derivative. 65"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"34f6531ff3b809643ccb795665b5b543a06f1e25"},{"id":"q-6b462575969b","stem":"Of the following, the one most closely associated with the portal vein is","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Abdomen","topicOriginal":"Abdomen","subtopic":"Portal Vein","suggestedTopic":null,"options":[{"label":"A","text":"umbilical vein"},{"label":"B","text":"umbilical artery"},{"label":"C","text":"vitelline vein"},{"label":"D","text":"3rd aortic arch"},{"label":"E","text":"6th aortic arch"},{"label":"C","text":"is correct. The protal vein forms when an anastomotic network around the duodenum forms one vessel. This anastomotic network is from theveins of the gut, the vitelline veins. 66"}],"priority":0,"status":"review","flags":["duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Abdomen","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"f63ee8c5fc796d528000c4e3ed0f3b8aad57d6da"},{"id":"q-8d3337fe58d7","stem":"The sinus venosus","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"has a right horn which persists in the adult as the coronary sinus"},{"label":"B","text":"has a left venous valve which develops into the valve of the coronary sinus"},{"label":"C","text":"forms the smooth-walled portion of the adult right atrium"},{"label":"D","text":"receives blood directly from the portal vein"},{"label":"C","text":"is correct. The left sinus horn regresses and persists as the main vein of the heart, the coronary sinus, whose valve arises from the inferior part of the right venous valve. The right sinus horn is incorporated into the right atrium, where it forms the smooth-walled part. The portal vein does not send blood to the sinus venosus. 67"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"43f5dda4f9d765e2afb32e99ddae98ccaa76efe5"},{"id":"q-820adfb249ca","stem":"Ostium secundum defect","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"is characterized by a large opening between left and right atria"},{"label":"B","text":"may be caused by excessive resorption of septum primum"},{"label":"C","text":"may be caused by inadequate development of septum secundum"},{"label":"D","text":"may be accompanied by intracardiac shunting of blood"},{"label":"E","text":"all of the above are correct"},{"label":"E","text":"is correct. An ostium secundum defect is a large opening between the atria that can be caused either by excessive resorption of the septum primum or inadequate development of the septum secundum. Depending on the size of the defect, there can be shunting of the blood between the atria. 68"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"3e48a2d5f4ebb18660ca5ef781c3f2db60813ac7"},{"id":"q-0832527bd858","stem":"In the development of the heart","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the coronary sinus is formed from the left horn of the sinus venosus"},{"label":"B","text":"the oblique vein of the left atrium is formed from the left posterior cardinal vein"},{"label":"C","text":"the valve of the coronary sinus is formed from the left sinus valve"},{"label":"D","text":"the valve of the inferior vena cava is formed from the left sinus valve"},{"label":"A","text":"is correct. Left horn of sinus venosus forms coronary sinus and left common cardinal vein becomes oblique vein of the left atrium. The right sinus valve becomes the valve of the coronary sinus and the valve of inferior vena cava. Left sinus valve becomes part of interatrial septum. 69"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"f131db357190df032ab8113a79c6aacadd96b2d6"},{"id":"q-20eb159ee04f","stem":"The mesenchymal cells which aggregate to form blood islands are called","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"hemoblasts"},{"label":"B","text":"mesoblasts"},{"label":"C","text":"fibroblasts"},{"label":"D","text":"angioblasts"},{"label":"E","text":"none of the above"},{"label":"D","text":"is correct. Angioblasts are the cells that form the blood islands. These blood islands then develop into the blood cells and the endothelium of the blood vessels. This early blood cell and blood vessel formation occurs first in the extraembryonic mesoderm of the yolk sac, chorion and connecting stalk. 70"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"4749a6f78c13052c646425e38f0269f7f43c142e"},{"id":"q-a8fdf66381d8","stem":"Closure of the foramen primum results from fusion of the","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"septum secundum and the fused endocardial cushions"},{"label":"B","text":"septum secundum and the septum primum"},{"label":"C","text":"septum primum and the fused endocardial cushions"},{"label":"D","text":"septum primum and the septum spurium"},{"label":"E","text":"septum primum and the sinoatrial valves"},{"label":"C","text":"is correct. The septum primum and the endocardial cushions fuse to close the foramen primum. Subsequently, perforations in the upper part of the septum primum coalesce to form the foramen secundum. It is this foramen that closes postnatally when left atrial pressure equals right atrial pressure. 71"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"8cdc971e67bbc5b564ed18e132ade187caf3f920"},{"id":"q-08889dfd935f","stem":"The most common type of cardiac septal defect is","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"muscular type ventricular septal defect, or VSD"},{"label":"B","text":"secundum type atrial septal defect, or ASD"},{"label":"C","text":"membranous type VSD"},{"label":"D","text":"primum type ASD"},{"label":"E","text":"sinus venosus"},{"label":"C","text":"is correct. Although the most common ATRIAL septal defect is the secundum type ASD, the overall most common cardiac septal defect is themembranous type VSD. 72"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"b6c45339ec790f48db72f3481bc31dce8ac9a681"},{"id":"q-0b49446064a6","stem":"The fetal left atrium is mainly derived from the","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"primitive pulmonary vein"},{"label":"B","text":"primitive atrium"},{"label":"C","text":"right pulmonary vein"},{"label":"D","text":"sinus venarum"},{"label":"E","text":"sinus venosus"},{"label":"A","text":"is correct. The primitive pulmonary vein becomes incorporated into the wall of the fetal left atrium, forming most of it. The original left atrium becomes a trabeculated atrial appendage called the left auricle, because it resembles an \"ear\" on the heart. 73"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"ec688d12fd10f2cc7685ccfcfe57ae40fc359cd9"},{"id":"q-a00cd88bab76","stem":"The fetal right atrium is mainly derived from","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"primitive pulmonary vein"},{"label":"B","text":"primitive atrium"},{"label":"C","text":"right pulmonary vein"},{"label":"D","text":"sinus venarum"},{"label":"E","text":"sinus venosus"},{"label":"E","text":"is correct. The right sinus horn of the sinus venosus enlarges and forms the fetal right atrium. The left sinus horn regresses to form the main vein draining the heart muscle, the coronary sinus. The original right atrium becomes the right auricle and also part of right atrium anterior to the crista terminalis. 74"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"d52b2d48794c4b2a482d6764b80c1e7a3ea65b00"},{"id":"q-d43d46bd7b38","stem":"The remnant of the first aortic arch artery is","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Histology and Tissues","topicOriginal":"Histology and Tissues","subtopic":"Artery","suggestedTopic":null,"options":[{"label":"A","text":"stapedial artery"},{"label":"B","text":"internal carotid artery"},{"label":"C","text":"maxillary artery"},{"label":"D","text":"common carotid artery"},{"label":"E","text":"the 1st arch artery regresses without remnants"},{"label":"C","text":"is correct. First arch becomes maxillary; 2nd arch remnants are stapedial andhyoid arteries; 3rd arch becomes common and proximal internal carotid arteries; 4th arch becomes proximal right subclavian and part of arch of aorta; 6th arch becomes proximal pulmonary arteries and ductus arteriosus. 75"}],"priority":0,"status":"review","flags":["duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Histology and Tissues","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"ebecec3d558c1c2d6e468bbd9276fe1f814a76ca"},{"id":"q-cb84d6247ced","stem":"The aortic sac","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"is the area immediately distal to the ventricles"},{"label":"B","text":"is connected to the dorsal aorta via the aortic arch arteries"},{"label":"C","text":"is preserved as the region of the semilunar valves in the adult heart"},{"label":"D","text":"is also known as the truncus arteriosus"},{"label":"E","text":"none of the above"},{"label":"B","text":"is correct. The aortic sac receives blood from the truncus arteriosus and sends it into the aortic arch arteries which branch from it and connect it to the paired dorsal aortae. Aortic sac becomesthe proximal part of aortic arch and the brachiocephalic trunk. Semilunar valves arise from the walls of truncus arteriosus. 76"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","short_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-b7d73e905129","stem":"The crista terminalis is derived from","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"right horn of the sinus venosus"},{"label":"B","text":"left horn of the sinus venosus"},{"label":"C","text":"primitive atrium"},{"label":"D","text":"AV canal"},{"label":"E","text":"Right cusp of the valve of the sinus venosus"},{"label":"E","text":"is correct. This is pretty picky. Cristal terminalis is the ridge on the inner surface of the right atrium that demarcates the smooth walled part derived from sinus venosus and the pectinate muscle-containing part from primitive right atrium. It marks where the right cusp of the sinoatrial valve was before the sinus became part of atrium. 77"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"1e1196458c25fdec0342f982a2f7fad7061e0825"},{"id":"q-851727c5ffba","stem":"The region of the atrioventricular canal develops into","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the semilunar valves"},{"label":"B","text":"the atrial septum"},{"label":"C","text":"the mitral and tricuspid valves"},{"label":"D","text":"the base of the ventricle"},{"label":"E","text":"the trabeculated portion of the right atrium"},{"label":"C","text":"is correct. With a name like atrioventricular canal, you might hope it would become something to do with the atrioventricular valves. The single canal is divided by the ingrowth of the endocardial cushions. The right atrioventricular valve is the tricuspid, while the left AV valve is bicuspid, known as the mitral valve. 78"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"a0d5918bdfce9e6ae0b3ae90bbad136222318b7b"},{"id":"q-19bb11526cf2","stem":"Meckel's diverticulum is an adult remnant of the","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"urachus"},{"label":"B","text":"hindgut"},{"label":"C","text":"pars cystica"},{"label":"D","text":"vitelline duct"},{"label":"E","text":"dorsal pancreatic duct"},{"label":"D","text":"is correct. Vitelline duct is a connection between embryonic midgut and yolksac, from which gut developed. As development proceeds, vitelline duct normally regresses. If it does not, it may persist as a Meckel's diverticulum, a vitelline duct cyst, an umbilical/vitelline fistula, or a fibrous cord connecting gut to umbilicus. 79"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"bf9bb2b434b36af38be91239384b12551b3153fc"},{"id":"q-6bafa665463b","stem":"The following events in the development of the abdominal cavity are greatly affected by the rapid growth of the liver","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"urorectal septum formation"},{"label":"B","text":"dorsal mesentery morphogenesis"},{"label":"C","text":"formation of inferior recess of lesser sac"},{"label":"D","text":"herniation of midgut loop"},{"label":"D","text":"is correct. The rapid growth of the liver has considerable effect on the development of the ventral mesentery, and it promotes the herniation of the midgut by occupying space in the abdominal cavity. It does not affect urorectal septum formation or the inferior recess of the lesser sac. 80"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"71ae65c5608192260053c3a8adb9c915d2095094"},{"id":"q-a7e9df8d1321","stem":"The embryonic foregut differentiates into all or part of the","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"liver"},{"label":"B","text":"ventral pancreas"},{"label":"C","text":"esophagus"},{"label":"D","text":"lung"},{"label":"E","text":"all of the above are correct"},{"label":"E","text":"is correct Derivatives of embryonic foregut include pharynx, esophagus, lungs and respiratory tract, stomach, the part of the duodenum cranial to the hepatic diverticulum, the pancreas, liverand gall bladder. 81"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"bbfcc60f58fa88259be898f894b9bdd8061b8c07"},{"id":"q-0bae2bd40b84","stem":"Abnormal intestinal rotation during fetal development may produce the following","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"congenital umbilical hernia"},{"label":"B","text":"annular pancreas"},{"label":"C","text":"infarction and gangrene"},{"label":"D","text":"diaphragmatic hernia"},{"label":"E","text":"Meckel's diverticulum or diverticulum ilei"},{"label":"C","text":"is correct. Abnormal rotation of the intestinal loop causes it to return to the abdomen in a different order, with the colon being the first to return to the gut. This positions things backwards, and the gut may twist abnormally. Such twisting or volvulus can obstruct the blood supply to the gut, resulting infarction and gangrene. 82"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"e059cff597844d75d07af5664fe3b598bebe9187"},{"id":"q-9cfa66ce0320","stem":"All of us has \"suffered\" which one of the following types of hernia?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Abdominal Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Abdominal Surgery","options":[{"label":"A","text":"inguinal"},{"label":"B","text":"umbilical"},{"label":"C","text":"lumbar"},{"label":"D","text":"diaphragmatic"},{"label":"E","text":"femoral"},{"label":"B","text":"is correct. The herniation of the midgut out through the umbilicus is a normal event in development. However, the intestinal contents may fail to return to the abdomen, resulting in an omphalocele. Viscera may herniate later through the weak umbilical region, and this is a true umbilical hernia. 83"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Abdominal Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"1649ea188cf5564b149bcbf53415de47957a2b3c"},{"id":"q-dc498bcde386","stem":"In the digestive system","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"failure of the intestinal loops to return into the abdominal cavity forms Meckel's diverticulum"},{"label":"B","text":"an omphalocele would most likely develop around the 10th-12th week of gestation"},{"label":"C","text":"stenosis of the gut most frequently occurs in the large intestine"},{"label":"D","text":"an annular pancreas is caused by a failure in normal migration of the dorsal pancreas"},{"label":"B","text":"is correct. Return of the intestinal loops to the abdomen occurs toward the endof the third month. Failure to do so results in an omphalocele. Stenosis of the gut is most common in the duodenum. An annular pancreas results when the left portion f the ventral pancreas migrates in a direction opposite normal. 84"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"655edd2439103cf4ca3d253027295f49aafc84b8"},{"id":"q-1cbd7d8598ad","stem":"Congenital absence of neural crest cells could result in","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"absence of sympathetic chain ganglia"},{"label":"B","text":"facial malformations"},{"label":"C","text":"absence of adrenal medulla"},{"label":"D","text":"absence of pigment cells"},{"label":"E","text":"all of the above are correct"},{"label":"E","text":"is correct. Neural crest cells form all sensory and autonomic ganglia, Schwann cells, meninges of the brain and spinal cord, adrenal medulla, pigment cells of the skin and connective tissues of the head and neck, including odontoblasts for dentin of the teeth. 85"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"85993b38e792017d4199a4d2e7dbae758227b1bd"},{"id":"q-15fd2dc5b026","stem":"In the development of the midgut","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the superior mesenteric artery is the axis for clockwise rotation of the midgut loop"},{"label":"B","text":"the persistence of part of the vitelline duct leads to urachal fistala"},{"label":"C","text":"a vitelline cyst may result from abnormal remodeling of thevitelline veins"},{"label":"D","text":"an omphalocele is not synonymous with congenital umbilical hernia"},{"label":"D","text":"is correct. The midgut rotates in a counterclockwise direction around superior mesenteric artery. Persistence of the vitelline duct may cause a vitelline fistula or cyst. Omphalocele results from a failure of midgut to return to the abdominal cavity, while congenital umbilical hernia is a later herniation of gut through abdominal wall. 87"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"f3df04d99ab09eae774dd5e1586a817405e2d2e5"},{"id":"q-5c0b8d0f2567","stem":"A persistence of the vitelline duct may result in","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"ileal diverticulum"},{"label":"B","text":"Meckel's diverticulum"},{"label":"C","text":"Vitelline cyst"},{"label":"D","text":"Umbilical fistula"},{"label":"E","text":"All of the above"},{"label":"E","text":"is correct. If the vitelline duct remains patent, there will be an umbilical orvitelline fistula, leaking meconium or fetal feces at the umbilicus. Partial closure of vitelline duct may result in a vitelline cyst or a Meckel's/ileal diverticulum. The latter are found on the anti-mesenteric side of ileum within 2 feet of cecum. 88"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"80dacff32e97f48ea5b6619ee51443dc3fd373b5"},{"id":"q-55b1e9efb808","stem":"The terminal dilated part of the hindgut is called the","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"cloaca"},{"label":"B","text":"yolk stalk"},{"label":"C","text":"allantois"},{"label":"D","text":"cecum"},{"label":"E","text":"coelom"},{"label":"A","text":"is correct. The folding of the embryo brings the allantois and the hindgut into association. The dilated terminal part of the hindgut is called the cloaca, and it communicates with the allantois. Later in development the cloaca is divided by the urorectal septum into the primitive urogenital sinus and the anorectal canal. 89"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"5b57f71b78e896addac49ba24a007eec8e7bc775"},{"id":"q-82ef50511465","stem":"The tracheoesophageal septum separates the","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"laryngotracheal tube and nasopharynx"},{"label":"B","text":"esophagus and nasopharynx"},{"label":"C","text":"laryngotracheal tube and esophagus"},{"label":"D","text":"laryngotracheal tube and oropharynx"},{"label":"E","text":"esophagus and oropharynx"},{"label":"C","text":"is correct. Pharynx is the common food/air tube, so it would not be wise to put a septum between pharynx and esophagus or trachea. However, the lungs bud from the foregut as an anterior diverticulum between the 4th and 6th branchial arches, explaining why superior laryngeal and recurrent laryngeal nerves from vagus innervate larynx. 90"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"5295f9802f4c7a726ff614fa9bfe2332edbf962a"},{"id":"q-944acf8fb7d5","stem":"The omental apron of the greater omentum","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"communicates with the peritoneal cavity via the epiploic foramen of Winslow"},{"label":"B","text":"becomes retroperitoneal in the adult"},{"label":"C","text":"has the ascending colon located within its superior boundary"},{"label":"D","text":"is a quadruple layer of peritoneum"},{"label":"E","text":"is lost during embryonic development"},{"label":"D","text":"is correct. The omental apron is the portion of the greater omentum, continuous with gastrocolic ligament, which hangs from the transverse colon. Early in development, it is an open sac, communicating with the lesser sac or omental bursa. The walls of the sac are two layers of peritoneum, forming a quadruple layer when the bag fuses. 91"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"ccff42b474e50f4d6b5ec30678aa5100243557d7"},{"id":"q-74180dadf6b4","stem":"Which duct is NOT associated with urinary system development?","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"ureteric bud"},{"label":"B","text":"paramesonephric duct"},{"label":"C","text":"Wolffian duct"},{"label":"D","text":"pronephric duct"},{"label":"E","text":"mesonephric duct"},{"label":"B","text":"is correct. The paramesonephric duct arises along the urogenital ridge, separate from the urinary system. In the female, the paramesonephric duct develops into the uterine tubes, uterus and upper part of the vagina. 92"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"ce96be8e9ad2c0ab26ba67354568383cbc876627"},{"id":"q-626d5b04ba6f","stem":"The penile urethra is derived from the","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"urogenital sinus"},{"label":"B","text":"pelvic part of the vesicourethral canal"},{"label":"C","text":"phallic part of the vesicourethral canal"},{"label":"D","text":"cloaca"},{"label":"E","text":"mesonephric duct"},{"label":"A","text":"is correct. The penile urethra, all but navicular portion, develops from the urogenital sinus. The urogenital sinus also produces the urinary bladder, prostate and bulbourethral glands. 93"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"5e3831f81449e63e89d837a869bcd21fbb16d69c"},{"id":"q-971acfb2a53f","stem":"The structure dividing the cloaca into two parts is the","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"distal retention band"},{"label":"B","text":"transverse septum"},{"label":"C","text":"urogenital sinus"},{"label":"D","text":"urorectal septum"},{"label":"E","text":"cloacal membrane"},{"label":"D","text":"is correct. The urorectal septum divides the cloaca into the urogenital sinus and rectum, during the second month of development. 94"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"59560232d938cb0929f2d4d8410b0b0dd2381aaf"},{"id":"q-085f701d39d4","stem":"After the sinovaginal bulbs have proliferated and fused, they form a solid core of endodermal cells known as the","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"sinus tubercle"},{"label":"B","text":"prostatic utricle"},{"label":"C","text":"vaginal plate"},{"label":"D","text":"uterovaginal primordium"},{"label":"E","text":"vault of the vagina"},{"label":"C","text":"is correct. The sinovaginal bulbs are evaginations from the urogenital sinus inthe female. They proliferate, fuse, and form the vaginal plate, which then canalizes to form the lumen of vagina. 95"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"a0778af3677bbe3cb881feaa0b349aabacf45f80"},{"id":"q-8f739f4f97f7","stem":"The embryonic origin(s) of the labia minora is/are","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"urethral folds"},{"label":"B","text":"genital tubercle"},{"label":"C","text":"genital swellings"},{"label":"D","text":"sinovaginal bulbs"},{"label":"E","text":"cloacal membrane"},{"label":"A","text":"is correct. The labia minora develop from the urethral or urogenital folds. In the male, the urethral folds ultimately fuse, forming the ventral aspect of the penis. The labia majora and the scrotum arise from the genital folds or swellings. 96"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"091b9ec3d57ffe62c85127b7c748632abc07e2bf"},{"id":"q-c60f34cc08c7","stem":"The embryonic origin(s) of the penile urethra is/are","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"urethral folds"},{"label":"B","text":"genital tubercle"},{"label":"C","text":"genital swellings"},{"label":"D","text":"sinovaginal bulbs"},{"label":"E","text":"cloacal membrane"},{"label":"A","text":"is correct. The labia minora develop from the urethral or urogenital folds. In the male, the urethral folds ultimately fuse, enclosing the penile or spongy urethra. However, the urethra passing through the glans is formed by canalization of the glandular plate. 97"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"088a5e32b7d384c2fbb0d574e9c759eff7aff4a3"},{"id":"q-15c4174001f0","stem":"The embryonic origin(s) of the scrotum is/are","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"urethral folds"},{"label":"B","text":"genital tubercle"},{"label":"C","text":"genital swellings"},{"label":"D","text":"sinovaginal bulbs"},{"label":"E","text":"cloacal membrane"},{"label":"C","text":"is correct. The scrotum in the male and the labia majora arise from the genital swellings or folds. Cloacal membrane is subdivided into the urorectal membrane and anal membrane by the urogenital septum. These membranes should rupture during the 9th week. 98"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"d37f18c368dd654536aee695b30f518606310c93"},{"id":"q-6383d1e9c088","stem":"The following structures are directly or indirectly derived fromthe mesonephric or Wolffian duct EXCEPT","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"part of the epididymis"},{"label":"B","text":"part of the kidney"},{"label":"C","text":"part of the urinary bladder"},{"label":"D","text":"seminal vesicles"},{"label":"E","text":"prostate"},{"label":"E","text":"is correct. The prostate is derived from the urogenital sinus, with no contribution from the mesonephric ducts. Ureteric bud, from mesonephric duct, gives rise to the collecting system of the kidney. A portion of the mesonephric ducts becomes incorporated into the trigone region of the bladder. Seminal vesicles bud from the mesonephric duct. 99"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"93e21afe3a14e143c2a40d138b49d8b5c76cc2cd"},{"id":"q-384d5fdfcf72","stem":"The following structures are the derivatives of theprimitive urogenital sinus EXCEPT","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"most of the urinary bladder"},{"label":"B","text":"male urethra"},{"label":"C","text":"female urethra"},{"label":"D","text":"lower vagina"},{"label":"E","text":"ejaculatory ducts"},{"label":"E","text":"is correct. The ejaculatory ducts are derivatives of the mesonephric ducts. All of the others have at least some contribution fromthe urogenital sinus. 100"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"ce3a6232a800698dff9325925a609cd1d826588f"},{"id":"q-2580c8f71a5a","stem":"The derivatives of the Wolffian duct include each of the following except","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"longitudinal duct of Gartner"},{"label":"B","text":"round ligament of uterus"},{"label":"C","text":"ductus deferens"},{"label":"D","text":"duct of the epididymis"},{"label":"E","text":"ejaculatory duct"},{"label":"B","text":"is correct. Gartners duct, like the appendix of the epididymis, holds more importance to National Board examiners than anyone else. It is a vestigial remnant of the mesonephric duct in the female. The round ligament of the uterus is derived from the gubernaculum, rather than the mesonephric duct. 101"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"7a8205917dfc160b289f864fa68eb770221bed92"},{"id":"q-85b938e5ee04","stem":"Of the following, the one most closely associated with the oviduct is","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"mesonephric tubules"},{"label":"B","text":"mesonephric duct"},{"label":"C","text":"paramesonephric duct"},{"label":"D","text":"genital swellings"},{"label":"E","text":"urogenital sinus"},{"label":"C","text":"is correct. Paramesonephric ducts give rise to the oviducts or uterine tubes, uterus and upper portion of the vagina. In males, the prostatic utricle and the appendix of the testis are vestigial remnants of the paramesonephric ducts. 102"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"04daec3b5e43b40cec3ae908852ef4226e32a5c7"},{"id":"q-dd0d87478b1a","stem":"Of the following, the one most closely associated with the efferent ducts of the testes is","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"mesonephric tubules"},{"label":"B","text":"mesonephric duct"},{"label":"C","text":"paramesonephric duct"},{"label":"D","text":"genital swellings"},{"label":"E","text":"urogenital sinus"},{"label":"A","text":"is correct. The efferent ductules of the testes are the only functional derivatives of the mesonephric tubules. 103"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"0e30b605b8e057dd18b5885c0702aa0aa7ea1e9f"},{"id":"q-30c8afac61d1","stem":"Of the following, the one most closely associated with the vestibule in the female is","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"mesonephric tubules"},{"label":"B","text":"mesonephric duct"},{"label":"C","text":"paramesonephric duct"},{"label":"D","text":"genital swellings"},{"label":"E","text":"urogenital sinus"},{"label":"E","text":"is correct. In the male, the urogenital sinus gives rise to the urinary bladder, all but distal urethra, prostate and bulbourethral glands. In the female, it gives rise to the urinary bladder, urethra, lower part of vagina, vestibule, urethral and paraurethral glands and greater vestibular glands. 104"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"2b842ff509e0ff72e377b08a03492a138442f2c3"},{"id":"q-661d4dc11baa","stem":"Of the following, the one most closely associated with the urethra in the female is","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"mesonephric tubules"},{"label":"B","text":"mesonephric duct"},{"label":"C","text":"paramesonephric duct"},{"label":"D","text":"genital swellings"},{"label":"E","text":"urogenital sinus"},{"label":"E","text":"is correct. In the male, the urogenital sinus gives rise to the urinary bladder, prostate, bulbourethral glands and all but distal urethral. In the female, it gives rise to the urinary bladder, urethra, lower part of vagina, vestibule, urethral and paraurethral glands and greater vestibular glands. 105"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"f98712fb5a6083e74df04c35b9be36e257b7dca1"},{"id":"q-c310bcab9bc6","stem":"Which of the following associations are correct?","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"renal pelvis - ureteric bud"},{"label":"B","text":"ureter - ureteric bud"},{"label":"C","text":"urethra - urogenital sinus"},{"label":"D","text":"median umbilical ligament - urachus"},{"label":"E","text":"all of the above are correct"},{"label":"E","text":"is correct. Ureteric bud gives rise to everything from collecting ducts through ureters. Derivatives of UG sinus include bladder and urethra of both sexes, prostate and bulbourethral glands, lower vagina and urethral, paraurethral and vestibular lands. Allantois becomes urachus, which then becomes median umbilical ligament. 106"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"2b4d83e1600d1338ec2e5785beb557fdb697b17f"},{"id":"q-a7b11b95e34c","stem":"Embryologically, each uriniferous tubule consists of two parts which become confluent at the junction of the","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"ascending limb of Henle's loop and the distal convoluted tubule"},{"label":"B","text":"renal corpuscle and the proximal convoluted tubule"},{"label":"C","text":"descending and ascending limbs of the loop of Henle"},{"label":"D","text":"proximal convoluted tubule and the loop of Henle"},{"label":"E","text":"distal convoluted tubule and the collecting tubule"},{"label":"E","text":"is correct. Everything from Bowman's capsule to the distal convoluted tubule develops from the metanephric cap. Everything from the collecting tubules through the ureter develops from the ureteric bud. Therefore the junction between the two occurs between the distal convoluted tubule and the collecting tubule. 107"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"cebcbe60b5b8775a737b23bd1fd76486a280dabd"},{"id":"q-405a252e1f50","stem":"The ureteric bud appears as an outgrowth from the","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"metanephric mass"},{"label":"B","text":"lateral plate mesoderm"},{"label":"C","text":"urogenital sinus"},{"label":"D","text":"allantoic duct"},{"label":"E","text":"mesonephric duct"},{"label":"E","text":"is correct. The ureteric bud is an outgrowth of the mesonephric duct. It formsthe ureter, renal pelvis, calyces and collecting ducts. 108"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"337c7c9ed01001cf90a2cd2cae8bc4db677dfd28"},{"id":"q-7e34608cfd68","stem":"The paramesonephric ducts in female embryos give rise to the","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"uterine tubes and uterus"},{"label":"B","text":"epoohoron"},{"label":"C","text":"inferior fifth of the vagina"},{"label":"D","text":"round ligament of the uterus"},{"label":"E","text":"ovarian ligament"},{"label":"A","text":"is correct. The paramesonephric ducts in the female develop in the uterine tubes, the uterus and the upper 1/3 of the vagina. The epoophoron come fromthr mesonephric tubules. The lower portion of the vagina develops from the urogenital sinus. The round ligament and the ovarian ligament are from the gubernaculum. 109"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"9072fb3fd159aefba12feba3b8bcb73d230283de"},{"id":"q-cab5d3c03b82","stem":"Which of the following gives rise to the labia majora?","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"genital folds"},{"label":"B","text":"genital swellings"},{"label":"C","text":"genital tubercle"},{"label":"D","text":"urorectal gold"},{"label":"E","text":"inguinal fold"},{"label":"B","text":"is correct. Labia majora arise from the genital swellings. Their counterpart in the male is the scrotum, which also arises from the genital swellings. The genital tubercle forms the distal end of penis and most of clitoris. Collected by: Nahry O. Muhammad 110"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"4e84fb6b4339372d2c44e038d67133ca7411f1a8"},{"id":"q-ca2af52006ba","stem":"The optic nerve is derived from what embryonic tissue?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"neural crest"},{"label":"B","text":"head mesenchyme"},{"label":"C","text":"endoderm"},{"label":"D","text":"mesoderm"},{"label":"E","text":"ectoderm"},{"label":"E","text":"is correct. The optic nerve is derived from nervous tissue, therefore ectoderm, but not neural crest. Optic sulci of the neural folds forming the forebrain send out the optic vesicles, which then develop into the optic cups connected to forebrain by the optic stalk. The optic stalk becomes the optic nerve. DAKTARI WA ZAMU 111"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"646244c482dd4c4592fc0ac478d1ee001504fcdc"},{"id":"q-1321664c97ec","stem":"Neural crest cells differentiate into","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"postganglionic sympathetic cell bodies"},{"label":"B","text":"cells of the inferior mesenteric ganglion"},{"label":"C","text":"adrenal medullary cells"},{"label":"D","text":"cells of the enteric plexus"},{"label":"E","text":"all of the above are correct"},{"label":"E","text":"is correct. Neural crest cells give rise to the peripheral parts of the autonomic nervous system, which includes all sympathetic and parasympathetic ganglia. Neural crest cells form all sensory ganglia of the peripheral nervous system. Neural crest cells also populate the adrenal medulla. DAKTARI WA ZAMU 112"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"94d6aa7388b664c1a03b59e4304b471f8a3ca5f0"},{"id":"q-8d7b1bcf93a7","stem":"Of the following, the item most closely associated with the regulation of visceral and endocrine functions is","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"telencephalon"},{"label":"B","text":"diencephalon"},{"label":"C","text":"mesencephalon"},{"label":"D","text":"metencephalon"},{"label":"E","text":"myelencehalon"},{"label":"B","text":"is correct. The hypothalamus of the diencephalon is the control center for visceral and endocrine functions. DAKTARI WA ZAMU 113"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"a9d200caff16994222964dda98083cdef493725b"},{"id":"q-03e85da52ebb","stem":"Of the following, the item most closely associated with the pons is","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"telencephalon"},{"label":"B","text":"diencephalon"},{"label":"C","text":"mesencephalon"},{"label":"D","text":"metencephalon"},{"label":"E","text":"myelencephalon"},{"label":"D","text":"is correct. The metencephalon differentiates into the cerebellum, the coordination center for posture and movement and the pons, which serves as a neural relay center. DAKTARI WA ZAMU 114"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"58d350bf8ca15a3072582e47d201dabf9f3ddbea"},{"id":"q-7092599543ba","stem":"Of the following, the one most closely associated with the cerebrum is","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"telencephalon"},{"label":"B","text":"diencephalon"},{"label":"C","text":"mesencephalon"},{"label":"D","text":"metencephalon"},{"label":"E","text":"myelencephalon"},{"label":"A","text":"is correct. The cerebrum arises from the telencephalon. Telencephalon, the most rostral part of the brain vesicles, develops from the prosencephalon as lateral outgrowths, the cerebral hemispheres and an intermediate area, the lamina terminalis. Lamina terminalis develops into thecommissures connecting the hemispheres. DAKTARI WA ZAMU 115"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"89a7acc8c2cf033697a1dab34242fbfba1ba4bed"},{"id":"q-78c1d8323942","stem":"Of the following, the one most closely associated with the 3rd ventricle is","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"telencephalon"},{"label":"B","text":"diencephalon"},{"label":"C","text":"mesencephalon"},{"label":"D","text":"metencephalon"},{"label":"E","text":"myelencephalon"},{"label":"B","text":"is correct. The 3rd ventricle lies within the thalamic area in the diencephalon. The lateral ventricles are cavities of the forebrain cerebral vesicles, from telencephalon. The 4th ventricle lies within the metencephalon. DAKTARI WA ZAMU 116"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"1038fce3f7c30a3c0f38de4034384622713a2014"},{"id":"q-3b81cb4a14a8","stem":"Cerebrospinal fluid","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"is produced in choroid plexuses"},{"label":"B","text":"circulates in the ventricular system of the brain and in the subarachnoid spaces"},{"label":"C","text":"re-enters the venous blood at the arachnoid"},{"label":"D","text":"granulations"},{"label":"E","text":"blockage of its circulation can lead to internal orexternal hydrocephalus"},{"label":"F","text":"all of the above are correct"},{"label":"E","text":"is correct. Cerebrospinal fluid is produced by ependymal cells of the choroid plexus. It circulates within the ventricles of the brain, the central canal of the spinal cord and the subarachnoid space. It is resorbed into the venous system via arachnoid granulations. If flow is blocked, CSF accumulates and creates hydrocephalus. DAKTARI WA ZAMU 117"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"02c7911d0be501bdc14ea1029495f60f8868a787"},{"id":"q-e586f11e1b54","stem":"In the development of the nervous system","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"there are five primary brain vesicles"},{"label":"B","text":"during the 5th week, each brain vesicle subdivides into 2 parts"},{"label":"C","text":"the pontine flexure is in a direction opposite the mesencephalic and cervical flexure"},{"label":"D","text":"neural epithelial cells are found in the marginal layer"},{"label":"C","text":"is correct. There are initially 3 brain vesicles: prosencephalon, mesencephalon and rhombencephalon. The pros- and rhombencephalon divide into 2 parts. The pontine flexure is opposite to the mesencephalic and cervical flexures. The marginal layer contains the nerve fibers arising from the neuroblasts. DAKTARI WA ZAMU 118"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"45f02bdb9eb04854de9f4aa57d0ffa8568035c5a"},{"id":"q-abbdbc2c94d1","stem":"In the development of the nervous system","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the sulcus limitans is found in the diencephalon"},{"label":"B","text":"the infundibulum is an outgrowth of the telencephalon that develops into the neurohypophysis"},{"label":"C","text":"sensory nuclei in the hindbrain lie ventral to the sulcus limitans"},{"label":"D","text":"the inner ear is derived from surface ectoderm"},{"label":"D","text":"is correct. The sulcus limitans is a lateral, longitudinal groove dividing basal and alar plates. The infundibulum is an outpouching of the hypothalamic region that becomes neurohypophysis. Sensory nuclei lie dorsal to the sulcus limitans. Internal ear is from thickened surface ectoderm (otic placode) near rhombencephalon. DAKTARI WA ZAMU 119"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"45f02bdb9eb04854de9f4aa57d0ffa8568035c5a"},{"id":"q-c952c1fa1551","stem":"In the development of the nervous system","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the neural groove forms from the neural plate"},{"label":"B","text":"the neural folds are composed of neuroepithelial cells"},{"label":"C","text":"the neural tube maintains temporary contact with theamniotic cavity via neuropores"},{"label":"D","text":"neuroepithelial cells give rise to both neuroblasts and glia blasts"},{"label":"E","text":"all of the above are correct"},{"label":"E","text":"is correct. The neural groove forms the neural plate when lateral parts of the plate elevate to form neural folds. Neural folds are composed of neuroepithelium which gives rise to neuroblasts, gliablasts and ependymal cells. After the neural tube forms, it maintains contact with the amniotic cavity via cranial and caudal neuropores. 120"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"45f02bdb9eb04854de9f4aa57d0ffa8568035c5a"},{"id":"q-f88fcc8628db","stem":"With respect to the nervous system, which of the following is NOT correct","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"a muscle's nerve supply can be used as an indicator of its level of origin and path of migration"},{"label":"B","text":"Rathke's pouch is an outgrowth of oral ectoderm that becomes the anterior lobe of the hypophysis"},{"label":"C","text":"the sulcus limitans marks the boundary between motor and sensory areas"},{"label":"D","text":"sensory nuclei in the hindbrain lie ventral to motor nuclei"},{"label":"D","text":"is correct. The nerve supply travels with the muscle, indicating its origin and migration path. Rathke's pouch, from which the anterior pituitary is formed, is from oral ectoderm. Sulcus limitans divides motor and sensory areas. Sensory nuclei in the hindbrain lie dorsal to themotor nuclei. EVEN WHEN THE ROAD IS HARD JUST NEVER GIVE UP 120"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"c8ee123ec5399607784c2ffcdc7364265efc6205"},{"id":"q-5bff453a469e","stem":"Which of the listed terms is described by: “All the chemical processes that take place in the organelles and cytoplasm the cells of the body”?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thoracic Wall and Mediastinum · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Thoracic Wall and Mediastinum","options":[{"label":"A","text":"Metabolism"},{"label":"B","text":"Cellular respiration"},{"label":"C","text":"Homeostasis"},{"label":"D","text":"Physiology"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thoracic Wall and Mediastinum · Suggested","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"b9e52612db9d0243d316185d820a3336ddafd9ac"},{"id":"q-b91ec7380845","stem":"Which of the following is the best defi nition of physiology?","type":"Single Best Answer MCQ","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The microscopic study of tissues and cells"},{"label":"B","text":"The study of how the body works."},{"label":"C","text":"All the chemical processes that take place in the organelles of the body’s cells."},{"label":"D","text":"The body’s automatic tendency to maintain a relatively constant internal environment."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D","whitespace/page_marker_normalization"],"duplicateStemGroup":"508adf48b987150b61cd29a39ab504196ea67387"},{"id":"q-9ba4841e0adb","stem":"Which of the following is/are the contents of the dorsal body cavity?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"heart and lungs"},{"label":"B","text":"brain and spinal cord"},{"label":"C","text":"viscera"},{"label":"D","text":"gut, kidneys, liver, pancreas, spleen, bladder, internal reproductive organs."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"4066b1e74e775a5850c526290d9d5459ee92eaeb"},{"id":"q-27503c08a5a1","stem":"The dorsal body cavity contains which of the following organs?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The brain."},{"label":"B","text":"The brain and spinal cord. 1 Organisation of the Body 5"},{"label":"C","text":"The brain, spinal cord and heart."},{"label":"D","text":"The brain, spinal cord, heart and kidneys."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"9840205c7b8f3266fb35af5bb322272e1e191548"},{"id":"q-b189596cb774","stem":"Which of the following best describes the “anatomical position”?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thoracic Wall and Mediastinum · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Thoracic Wall and Mediastinum","options":[{"label":"A","text":"Standing vertically, arms held horizontally, legs apart so that the tips of the head, hands and feet lie on an imaginary circle, drawn around the body."},{"label":"B","text":"Standing “to attention”, with hands held so that thumbs are ventral while the fi fth digit is dorsal. 1 Organisation of the Body 6"},{"label":"C","text":"Standing “at ease” with hands clasped behind your back while adjacent and dorsal to the sacrum."},{"label":"D","text":"Standing vertically, arms parallel and lateral to the ribs with hands inferior to the elbows and supinated."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thoracic Wall and Mediastinum · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"d4698f907eb0176d5f48389d406619587e02212b"},{"id":"q-25fbaf93f210","stem":"What structure separates the thoracic cavity from the abdominal cavity?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thoracic Wall and Mediastinum · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Thoracic Wall and Mediastinum","options":[{"label":"A","text":"The mediastinum"},{"label":"B","text":"The diaphragm"},{"label":"C","text":"The peritoneum"},{"label":"D","text":"The pylorus"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thoracic Wall and Mediastinum · Suggested","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"6cd612883dd7e806a78dc35e70c9788793780ac2"},{"id":"q-6a8f22afe15d","stem":"Which structure within the cell produces ATP (adenosine triphosphate)?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the mitochondria"},{"label":"B","text":"the nucleus"},{"label":"C","text":"peripheral proteins"},{"label":"D","text":"the endoplasmic reticulum"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"663a821ab9ee103c1013c01e0c1656937476dd93"},{"id":"q-5e04d020aa56","stem":"Which of the following is a function of membrane proteins?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"to process lipids and proteins for secretion through the plasma membrane"},{"label":"B","text":"to act as receptors for hormones"},{"label":"C","text":"to synthesise proteins from amino acids"},{"label":"D","text":"to act as a cytoskeleton to support and shape the cell"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"6bad5a8aa9bb32ee8bda79c076647cc1088c8119"},{"id":"q-27fc6f35d4db","stem":"Which of the tissue types below consists of a single layer of cells?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"stratifi ed squamous epithelial tissue"},{"label":"B","text":"glandular epithelium"}],"priority":0,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"2347a4feb977ce6d2191618a189b70625c040ca2"},{"id":"q-3ab9734d1328","stem":"1 Cells and Tissues 10","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"C","text":"areolar connective tissue"},{"label":"D","text":"simple columnar epithelial tissue"}],"priority":0,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D","whitespace/page_marker_normalization"]},{"id":"q-70887101fc36","stem":"Which statement about the plasma membrane is INCORRECT ?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It is selectively permeable."},{"label":"B","text":"It is composed of two layers of glycoprotein molecules."},{"label":"C","text":"It contains receptors for specifi c signalling molecules. 2 Cells and Tissues 11"},{"label":"D","text":"The plasma membranes of adjacent cells are held together by desmosomes."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"ad489fd923ef7e5376fdc9a4d57f1856d80b5143"},{"id":"q-a1e00938e79a","stem":"What are lysosomes, centrosomes and ribosomes example of?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thoracic Wall and Mediastinum · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Thoracic Wall and Mediastinum","options":[{"label":"A","text":"stem cells"},{"label":"B","text":"organelles within a cell"},{"label":"C","text":"sensory receptors in the dermis"},{"label":"D","text":"exocrine glands"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thoracic Wall and Mediastinum · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"4f567403d6d61ad10d28ea95d7a7f57c4cc1b477"},{"id":"q-2b8469d2e266","stem":"Which of the following is NOT part of the plasma membrane of a cell?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"integral proteins"},{"label":"B","text":"glycoproteins"},{"label":"C","text":"plasma proteins"},{"label":"D","text":"peripheral proteins"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"1b5cc8bfdf0497cd20058f02ce833e6a51f9307b"},{"id":"q-bbda7b3fad84","stem":"What is a role performed by mitochondria?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"contain enzymes capable of digesting molecules"},{"label":"B","text":"produce ATP"},{"label":"C","text":"synthesise proteins"},{"label":"D","text":"synthesise fatty acids, phospholipids & cholesterol"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"],"duplicateStemGroup":"21590e5f8ca8905c853f857a188a63d4b5558ad7"},{"id":"q-cc9f94620824","stem":"What is the purpose of mitochondria?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"to store the nucleolus and chromatin"},{"label":"B","text":"to produce adenosine triphosphate 2 Cells and Tissues 15"},{"label":"C","text":"to support and shape the cell."},{"label":"D","text":"they produce enzymes to break down molecules"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"480eae0719b068188d98041d00378bfa7f580b94"},{"id":"q-ff31dff5f8a2","stem":"What is the difference between “loose” connective tissue (CT) and “dense” connective tissue?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Fibres occupy most of the volume in dense CT"},{"label":"B","text":"Dense CT includes cartilage, loose CT does not."}],"priority":0,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"b980a55022623dbb6d33ba3db29cacca6c23cded"},{"id":"q-fc1e8076111b","stem":"1 Cells and Tissues 16","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"C","text":"Loose CT has a good blood supply while dense CT does not."},{"label":"D","text":"Loose CT has no fi bres (and dense CT does)."}],"priority":0,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D","whitespace/page_marker_normalization"]},{"id":"q-a6326d9332e1","stem":"Active transport across the plasma membrane may be described by which statement?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thoracic Wall and Mediastinum · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Thoracic Wall and Mediastinum","options":[{"label":"A","text":"active transport requires energy from ATP."},{"label":"B","text":"active transport is also known as endocytosis."},{"label":"C","text":"active transport moves molecules along their concentration gradient."},{"label":"D","text":"active transport is the movement of lipid-soluble molecules through the plasma membrane."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thoracic Wall and Mediastinum · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["answer_text_in_option","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"5047ba3fed63392c862622fc4cbbad3c161f4efa"},{"id":"q-9652282c3dd6","stem":"What are the major types of tissue in the body?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"nervous, muscle, epithelial, connective."},{"label":"B","text":"squamous, cuboidal, columnar, transitional."},{"label":"C","text":"osteocytes, chondrocytes, leucocytes, adipocytes."},{"label":"D","text":"protein, adipose, cartilage, osseous."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"],"duplicateStemGroup":"830faf03f320f93a4b19f458630a3951e7bb669c"},{"id":"q-dcd75b27669f","stem":"The process of “active transport” through a membrane may be described by which of the following?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thoracic Wall and Mediastinum · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Thoracic Wall and Mediastinum","options":[{"label":"A","text":"the movement of ions and small molecules away from regions where they are in high concentration."},{"label":"B","text":"the use of energy from ATP to move ions and small molecules into regions where they are in lower concentration."},{"label":"C","text":"the plasma membrane engulfs the substance and moves it through the membrane."},{"label":"D","text":"the use of energy from ATP to move ions and small molecules against their concentration gradient."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thoracic Wall and Mediastinum · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_