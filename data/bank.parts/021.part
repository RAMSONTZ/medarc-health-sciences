ype":"Short Answer","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"53befc6194d5b6ef530083454ce439d77102a433"},{"id":"q-7d9a4fe9c94f","stem":"which of the muscle not from deep of the back of the leg...plantaris","type":"Short Answer","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"f70cecbfea5c6b6872bf33b517a6078f1b21befd"},{"id":"q-b7f55f5605e6","stem":"when the ulcer which artery affected...gastrodudenal artery","type":"Short Answer","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-097fdace4fd1","stem":"Which type of neuron is multipolar?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Motor neurons"},{"label":"B","text":"Interneurons"},{"label":"C","text":"Sensory neurons"},{"label":"D","text":"Both a and b"},{"label":"E","text":"All of the above"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"25bb29efbb35305a6510f63017c5caeca11be4d3"},{"id":"q-6bb2954f7cb2","stem":"Which of the following is an element of the central nervous system?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Receptors"},{"label":"B","text":"Brachial plexus"},{"label":"C","text":"Sciatic nerve"},{"label":"D","text":"Ganglia"},{"label":"E","text":"Spinal cord"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_duplicate_projection","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"d0acff56a925848c055b9e1e600ba3d8188618cd"},{"id":"q-09e5e331a557","stem":"How many neurons are in the body of man?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"10,000 (10 to the 4th)"},{"label":"B","text":"10,000,000 (10 to the 7th)"},{"label":"C","text":"10,000,000,000 (10 to the 10th)"},{"label":"D","text":"10,000,000,000,000 (10 to the 13th)"},{"label":"E","text":"10,000,000,000,000,000 (10 to the 16th"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"cd2482d0b774f975dbba87e41aa9afec812038a8"},{"id":"q-9dfebc86dd65","stem":"What is another term for the cell body of a neuron?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Tracts"},{"label":"B","text":"Islets"},{"label":"C","text":"Soma"},{"label":"D","text":"Cortex"},{"label":"E","text":"Nuclei"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"60a1baf3b90987e30307434267325e50347cad35"},{"id":"q-52bfce22b5ba","stem":"Where is the ependyma found?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Lining ventricles"},{"label":"B","text":"Lining spinal canal"},{"label":"C","text":"Covering the brain"},{"label":"D","text":"Covering the spinal cord"},{"label":"E","text":"Both a and b"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false