ic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"1464e13c2b5d81f8c5e31e7de76efd1f9be465d5"},{"id":"q-c3de3240a7bf","stem":"The carbonic acid and bicarbonate buffer system is one if the buffers that help to maintain the blood’s pH within the healthy range by doing which of the following?","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Water, pH and Buffers","topicOriginal":"Water, pH and Buffers","subtopic":"Acid","suggestedTopic":null,"options":[{"label":"A","text":"carbonic acid destroys excess base in the blood while bicarbonate destroys excess acid."},{"label":"B","text":"carbonic acid destroys excess acid in the blood while bicarbonate destroys excess base."},{"label":"C","text":"carbonic acid and bicarbonate destroy excess acid."},{"label":"D","text":"carbonic acid and bicarbonate destroy excess base."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Water, pH and Buffers","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":["source answer/boilerplate removed from option D"],"duplicateStemGroup":"fed8cca32a7fd1f50deb87d6a51f85dd919d9f3f"},{"id":"q-bed0affffd1b","stem":"If a sample of blood has a pH of 7.25, which of the following is true?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"it is in the healthy range"},{"label":"B","text":"it is neutral 4 Chemistry for Physiology 87"},{"label":"C","text":"it is acidic"