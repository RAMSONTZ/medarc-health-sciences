"flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"fe4d3e0d59dbf8396d25510fbc16f8efc5e1eeba"},{"id":"q-2da61469b8c1","stem":"When managing a patient with aplastic anemia: A. Always give a chance for spontaneous recovery B. Liberally use Growth factors (Erythropoietin, G-CSF, GM-CSF) C Always start looking for a stem cell donor in transplantable patients D. Try androgens as it has been found to be effective in most patients E. Correct the anemia whenever the hemoglobin drops below 10 gm/dL","type":"Clinical Vignette","subject":"Hematology","topic":"Red Cell Disorders","topicOriginal":"Red Cell Disorders","subtopic":"Anemia","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Red Cell Disorders","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-0616cab61b73","stem":"Rai and Binet staging systems are used to stage patients with chronic lymphocytic leukemia. A patient presenting with a lymphocyte count of 100,000/uL, splenomegaly, cervical and axillary lymphadenopathy is staged as: A. IA “Rai Stage I and Binet stage A” B. IB “Rai Stage I and Binet Stage B” C IIB “Rai Stage II and Binet Stage B”","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematological Malignancies","topicOriginal":"Hematological Malignancies","subtopic":"Leukemia and Lymphoma","suggestedTopic":null,"options":[{"label":"D","text":"IIIC “Rai Stage III and Binet Stage C”"},{"label":"E","text":"0A “Rai Stage O and Binet Stage A” Professor Anwar Sheikha, MD, FRCP, FRCPath., FACP One Thousand Hematology MCQ 140"}],"priority":0,"status":"review","flags":["mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematological Malignancies","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-263ed9847f96","stem":"which includes both Hemophilia A & B","type":"Short Answer","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a94357fd740b","stem":"When the majority of the neutrophil have more than 5 segments","type":"Short Answer","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-07e97893bcb9","stem":"When they are newborns","type":"Short Answer","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTr