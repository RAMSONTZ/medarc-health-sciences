e following is NOT a cell found in connective tissue?","sourceOptions":[{"label":"A","text":"adipocytes"},{"label":"B","text":"chondroblasts"},{"label":"C","text":"keratinocytes"},{"label":"D","text":"osteoblasts Answer is C: Keratinocytes are in the epidermis which is epithelial tissue. The other cell types occur in fat, cartilage and bone."}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-59f19c6b9244","stem":"What tissue has cells that are closely packed and that have one surface attached to a basement membrane and the other free to a space?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Face","suggestedTopic":null,"options":[{"label":"A","text":"epithelial tissue"},{"label":"B","text":"muscle tissue"},{"label":"C","text":"connective tissue"},{"label":"D","text":"nervous tissue"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"f512665032891533a9dca4d41afba06c13bc6786"},{"id":"q-bc8f006a018c","stem":"What is the name of the mechanism that ensures that there is a higher concen- tration of sodium ions in the extracellular fluid than in the intracellular fluid?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Facilitated diffusion"},{"label":"B","text":"The sodium-potassium pump"},{"label":"C","text":"Secondary active transport"},{"label":"D","text":"Osmosis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D","whitespace/page_marker_normalization"],"duplicateStemGroup":"42a6fd1120055289825e794930060354b3ef4ab1"},{"id":"q-d8fa9b6e4347","stem":"What are lysosomes, centrosomes and ribosomes example of?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thoracic Wall and Mediastinum · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Thoracic Wall and Mediastinum","options":[{"label":"A","text":"stem cells"},{"label":"B","text":"organelles within a cell"},{"label":"C","text":"sensory receptors in the dermis"},{"label":"D","text":"exocrine glands"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thoracic Wall and Mediastinum · Suggested","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"4f567403d6d61ad10d28ea95d7a7f57c4cc1b477"},{"id":"q-7a30ae312e35","stem":"What does simple columnar epithelial tissue refer to? Tissue with","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"a single layer of cells longer than they are wide."},{"label":"B","text":"a single layer of cells whose length, breadth and depth are about the same size."},{"label":"C","text":"several layers of cells, all of the same type."},{"label":"D","text":"several layers of cells but without a basement membrane."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{"sourceStem":"What does simple columnar epithelial tissue refer to? Tissue with","sourceOptions":[{"label":"A","text":"a single layer of cells longer than they are wide."},{"label":"B","text":"a single layer of cells whose length, breadth and depth are about the same size."},{"label":"C","text":"several layers of cells, all of the same type."},{"label":"D","text":"several layers of cells but without a basement membrane. Answer is A: simple = one layer. Columnar means oblong or shaped like a column."}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-d8b6980d82b9","stem":"Which of the following is NOT an example of connective tissue?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"blood"},{"label":"B","text":"bone"},{"label":"C","text":"tendon"},{"label":"D","text":"epidermis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{"sourceStem":"Which of the following is NOT an example of connective tissue?","sourceOptions":[{"label":"A","text":"blood"},{"label":"B","text":"bone"},{"label":"C","text":"tendon"},{"label":"D","text":"epidermis Answer is D: the epidermis (on top of the dermis) is epithelial tissue."}]}},{"id":"q-02fba2c23f59","stem":"What is the function of phospholipids in the plasma membrane?","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Lipids","topicOriginal":"Lipids","subtopic":"Lipid","suggestedTopic":null,"options":[{"label":"A","text":"to maintain the intracellular fluid at a similar composition to that of the interstitial fluid."},{"label":"B","text":"to form channels to selectively allow passage of small molecules."},{"label":"C","text":"to act as receptors for signalling chemicals."},{"label":"D","text":"to present a barrier to the passage of water-soluble molecules."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Lipids","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"a560226bf56f0ae704f1160bec549882a74b00d4","manualEdits":{"sourceStem":"What is the function of phospholipids in the plasma membrane?","sourceOptions":[{"label":"A","text":"to maintain the intracellular fluid at a similar composition to that of the interstitial fluid."},{"label":"B","text":"to form channels to selectively allow passage of small molecules."},{"label":"C","text":"to act as receptors for signalling chemicals."},{"label":"D","text":"to present a barrier to the passage of water-soluble molecules. Answer is D: molecules that are soluble in water cannot pass through lipid (fat). So the phospholipids are a barrier. The functions described by B. & C. are per- formed by other molecules in the plasma membrane."}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-c24883c7b971","stem":"Which one of the following cell types is found in epithelial tissue?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"plasma cells"},{"label":"B","text":"leucocytes"},{"label":"C","text":"keratinocytes"},{"label":"D","text":"chondroblasts"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"a71185a1bbe71ada12f2c3b32fdb0eedc0ec6b4d","manualEdits":{"sourceStem":"Which one of the following cell types is found in epithelial tissue?","sourceOptions":[{"label":"A","text":"plasma cells"},{"label":"B","text":"leucocytes"},{"label":"C","text":"keratinocytes"},{"label":"D","text":"chondroblasts Answer is C: keratinocytes produce keratin, the protein of the epidermis, which is epithelial tissue."}]}},{"id":"q-9714697d3983","stem":"Which of the following is NOT part of the plasma membrane of a cell?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"integral proteins"},{"label":"B","text":"glycoproteins"},{"label":"C","text":"plasma proteins"},{"label":"D","text":"peripheral proteins"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"1b5cc8bfdf0497cd20058f02ce833e6a51f9307b"},{"id":"q-9e7711c9333f","stem":"A major role for mitochondria is to","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"transcribe the information in DNA (deoxyribonucleic acid)"},{"label":"B","text":"produce ATP (adenosine triphosphate)"},{"label":"C","text":"synthesise proteins from amino acids"},{"label":"D","text":"use enzymes to lyse molecules"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"],"duplicateStemGroup":"e5f75cd10bb5e113a34002b26db1777db165a9d5"},{"id":"q-11fa3a350247","stem":"Choose the tissue below that is one of the four primary types of body tissue.","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"epidermal tissue"},{"label":"B","text":"epithelial tissue"},{"label":"C","text":"interstitial tissue"},{"label":"D","text":"osseous tissue"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-4806c42112da","stem":"What are the primary types of tissue in the body?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Muscle, nervous, connective and epithelial"},{"label":"B","text":"Muscle, nervous, connective, osseous and epithelial"},{"label":"C","text":"Muscle, nervous, connective, osseous, blood and epithelial"},{"label":"D","text":"Muscle, nervous, connective, glandular and epithelial"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-62c7791f0b72","stem":"What is the name of the membrane that surrounds the lungs?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Lung","suggestedTopic":null,"options":[{"label":"A","text":"visceral peritoneum"},{"label":"B","text":"parietal peritoneum"},{"label":"C","text":"visceral pleura"},{"label":"D","text":"dura mater"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-ade655b77766","stem":"What is a role performed by mitochondria?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"contain enzymes capable of digesting molecules"},{"label":"B","text":"produce ATP"},{"label":"C","text":"synthesise proteins"},{"label":"D","text":"synthesise fatty acids, phospholipids & cholesterol"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"21590e5f8ca8905c853f857a188a63d4b5558ad7"},{"id":"q-a1b299b70d96","stem":"Which of the following is NOT found in the plasma membrane?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"proteins"},{"label":"B","text":"cholesterol"},{"label":"C","text":"endoplasmic reticulum"},{"label":"D","text":"phospholipids"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-a726e840ba0c","stem":"Which one of the following cell types is found in epithelial tissue?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"mast cells"},{"label":"B","text":"adipocytes"},{"label":"C","text":"chondroblasts"},{"label":"D","text":"keratinocytes"}],"priority":0,