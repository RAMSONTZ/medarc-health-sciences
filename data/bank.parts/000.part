"label":"B","text":"deliver lipids and proteins to plasma membrane for secretion"},{"label":"C","text":"synthesise proteins from amino acids"},{"label":"D","text":"produce ATP (adenosine triphosphate)"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"],"duplicateStemGroup":"e5f75cd10bb5e113a34002b26db1777db165a9d5"},{"id":"q-35d5a64e6c80","stem":"Choose the tissue below that is NOT one of the four primary types of body tissue.","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"connective tissue"},{"label":"B","text":"muscular tissue"},{"label":"C","text":"nervous tissue"},{"label":"D","text":"osseous tissue"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-abba94e3f556","stem":"What is the purpose of mitochondria?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"to store the nucleolus and chromatin"},{"label":"B","text":"to produce adenosine triphosphate"}],"priority":0,"status":"review","flags":["topic_generic","mcq_missin