werTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-9724e73866d4","stem":"Which of the following is the correct combination of the components for the nucleic acid RNA?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Phosphate, Ribose, Uracil"},{"label":"B","text":"Phosphate, Deoxyribose, Proline"},{"label":"C","text":"Phosphate, Ribose, Thymine"},{"label":"D","text":"Phosphate, Deoxyribose, Adenine"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-d3b36bc973c3","stem":"In the nucleus of the cell DNA is used as a template to form mRNA. What is the process called?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Translation"},{"label":"B","text":"Transcription"},{"label":"C","text":"Transportation"},{"label":"D","text":"Transmutation"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-aa4882429d98","stem":"Which statement is true of the 23 chromosomes within a sperm?","type":"Single Best Answer MCQ","subject":"Medical Genetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"23 chromosomes is the diploid number"},{"label":"B","text":"11 chromosomes came from the father, 11 chromosomes came from the mother, while one of either the Y or the X came from the father or mother respectively."},{"label":"C","text":"Some of the 23 came from the father and the rest came from the mother."},{"label":"D","text":"11 chromosomes and the Y came from the father, while 11 chromosomes came from the mother."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Genetics","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"51324b69388213a27a6629809cd4e21e136ed2d9"},{"id":"q-7ce376c618ad","stem":"Say that someone’s body temperature is measured by four different devices and the resulting four measurements are given below. Which reading has an abso- lute error of ± 0.05 °C?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"38 °C"},{"label":"B","text":"37.8 °C"},{"label":"C","text":"37.85 °C"},{"label":"D","text":"37.855 °C"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"60d6d90c67dc7d20b2fbe19389607d09a9ff3a45"},{"id":"q-26ed7ff2d9f7","stem":"What can be correctly said of data that are “normally distributed”?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thoracic Wall and Mediastinum · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Thoracic Wall and Mediastinum","options":[{"label":"A","text":"The upper and lower values of the distribution describe the healthy range of physiological values."},{"label":"B","text":"The standard deviation characterises the dispersion of data and the variance characterises the central tendency of the data."},{"label":"C","text":"The mean and range are statistics that are strictly only applicable to nor- mally distributed data."},{"label":"D","text":"Sixty eight percent of all data values will be within one standard deviation from the mean."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thoracic Wall and Mediastinum · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-f9ac3c6a1cf9","stem":"If someone’s height is measured while the person is wearing shoes, the height will be overestimated. This type of error is known as which of the following?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Absolute error"},{"label":"B","text":"Parallax error"},{"label":"C","text":"Calibration error"},{"label":"D","text":"Zeroing error"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-96f538fc5748","stem":"Which of the following metric prefixes is used to denote one thousandth of a gram?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"micro"},{"label":"B","text":"milli"},{"label":"C","text":"centi"},{"label":"D","text":"kilo"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D","whitespace/page_marker_normalization"],"duplicateStemGroup":"efb3b00aac6ece580348f69fc58765aab45b6cf0"},{"id":"q-f234c6e6c7b4","stem":"What is the standard deviation used for?","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"as a measure of central tendency"},{"label":"B","text":"as a measure of dispersion"},{"label":"C","text":"as a measure of spread of data that are normally distributed"},{"label":"D","text":"as a measure of the error of the mean value"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk