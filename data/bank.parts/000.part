ic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"f4a828afa3b2f302f681915eaea7a42cf55fa76a"},{"id":"q-bf84d1973515","stem":"What is another term for lymphatic nodules?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Lymph follicles"},{"label":"B","text":"White pulp"},{"label":"C","text":"Peyer's patches"},{"label":"D","text":"Lymph node"},{"label":"E","text":"Diffuse lymphatic tissue"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"6d21a8e79ae6a2204ec959d8259a2d4d80871873"},{"id":"q-e1d560dd2e30","stem":"Which layer of the gastrointestinal tract contains the gut associated lymphatic tissue?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Mucosa"},{"label":"B","text":"Sub mucosa"},{"label":"C","text":"Muscularis externa"},{"label":"D","text":"Serosa"},{"label":"E","text":"Adventitia The mucosa is the innermost layer of the GI tract."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"8e88bb43105d0df52edb16e22c6665a1a0ff49ce"},{"id":"q-cf50ebb4aac9","stem":"Which of the following is NOT made of a framework of reticular fibers?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Bone marrow"},{"label":"B","text":"Lymph node"},{"label":"C","text":"Spleen"},{"label":"D","text":"Thymus"},{"label":"E","text":"None of the above--all are made of a framework of reticular fibers. Bone marrow, lymph nodes, the spleen and the thymus are all part of the lymphatic system. Most lymphatic organs are made of a framework of reticular fibers and reticular cells. However, the thymus is made of epithelioreticular cells instead."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"f0c481a362278b72ce44235518c789a03c7fa4a0"},{"id":"q-c62fa4a3a02f","stem":"What is the acronym for the diffuse lymphatic tissue found in the intestinal tract?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"BALT"},{"label":"B","text":"DALT"},{"label":"C","text":"FALT"},{"label":"D","text":"GALT"},{"label":"E","text":"HALT Diffuse lymphatic tissue is non-encapsulated lymphatic tissue."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"bc45bb5ff69cc11c00cf25dc893f888c7e90af13"},{"id":"q-72eaef7f51b3","stem":"What is another name for a splenic nodule?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Malpighian corpuscle"},{"label":"B","text":"Trabeculae"},{"label":"C","text":"White pulp"},{"label":"D","text":"Red pulp"},{"label":"E","text":"Cords of Billroth"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"a5c1f5fbf88ab0224f1ed1dae6ecab311ad285f0"},{"id":"q-23351491de28","stem":"What is the term for the entire lymphatic region of the spleen?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Malpighian corpuscle"},{"label":"B","text":"Trabeculae"},{"label":"C","text":"White pulp"},{"label":"D","text":"Red pulp"},{"label":"E","text":"Cords of Billroth"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"34643d5af47488fdf1a593177a87b2d540833666"},{"id":"q-60816cc147d3","stem":"Which of the following is NOT a function of the spleen?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Destruction of red blood cells"},{"label":"B","text":"Lymphocyte production"},{"label":"C","text":"Storage of blood"},{"label":"D","text":"Fetal blood cell formation"},{"label":"E","text":"All of the above are functions of the spleen"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"23409b8a6277d23d921bcce6e6a3ba96bfdcb5e6"},{"id":"q-28897d01a86d","stem":"When looking at a lymph node, where are lymphatic nodules?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Deep cortex"},{"label":"B","text":"Tertiary cortex"},{"label":"C","text":"Juxtamedullary cortex"},{"label":"D","text":"Paracortical zone"},{"label":"E","text":"Outer cortex Deep cortex, tertiary cortex, juxtamedullary cortex and paracortical zone are all terms for the same region in a lymph node. The deep cortex is the inner region of the cortex, next to the medulla. Lymphatic nodules are not found in the deep cortex. Lymphatic nodules are found in the outer cortex."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"0fb29a4e2a44deca045c49a41707493cdaf6486a"},{"id":"q-e46adde03d59","stem":"Where do T lymphocytes gain their immunocompetence?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Thymus"},{"label":"B","text":"Thyroid"},{"label":"C","text":"Bursa of Fabricus"},{"label":"D","text":"Bone marrow"},{"label":"E","text":"Lymph node T cells gain their immunocompetence in the thymus."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"75ff