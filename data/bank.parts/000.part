":["repeated_question_stem","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"],"duplicateStemGroup":"7709437e1382db1f6335c6aa6bfbcee8bab17339"},{"id":"q-2ab2d89ee418","stem":"Look at the figure of a thermometer. What is the temperature reading?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"15 °C"},{"label":"B","text":"15.4 °C"},{"label":"C","text":"17 °C"},{"label":"D","text":"20 °C"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D","whitespace/page_marker_normalization"],"duplicateStemGroup":"f78eb11045badecd164ec9bfa333ad2d2da383fb"},{"id":"q-20a87840c250","stem":"Look again at the figure of a thermometer. What is the absolute error of the tem- perature reading?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"± 0.05 °C"},{"label":"B","text":"± 0.5 °C 38 3 Measurement, Errors and Data"},{"label":"C","text":"± 1.0 °C"},{"label":"D","text":"± 5.0 °C"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D","whitespace/page_marker_normalization"],"duplicateStemGroup":"2e89b6644007e17e8b55fb4494fda3f73465480e"},{"id":"q-306c15a7d6ac","stem":"What information does the “standard deviation” of a mean value tell us?","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It gives us the healthy range of values for the measured physiological quantity."},{"label":"B","text":"It is the range within which 68 % of measured values are found."},{"label":"C","text":"It tells us that the measured values are normally distributed."},{"label":"D","text":"It tells us the number of values that were used to calculate the mean."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-51d3736a6fae","stem":"On a clinical thermometer where the smallest scale interval is 0.1 °C, a person’s temperature is measured to be 37.7 °C. Which of the listed temperatures could NOT be the person’s true temperature?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"37.72 °C"},{"label":"B","text":"37.76 °C"},{"label":"C","text":"37.67 °C"},{"label":"D","text":"37.685 °C"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-4f42e02f42d6","stem":"How many micrograms are there in 5 milligram?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"0.005"},{"label":"B","text":"0.5"},{"label":"C","text":"500"},{"label":"D","text":"5000"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-47ba0c2013bc","stem":"What does the standard deviation of the mean represent? For values that are normally distributed, it represents","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the value above and below the mean that includes 68 % of all data values"},{"label":"B","text":"the difference between the highest data value and the lowest data value"},{"label":"C","text":"the average of the difference between each data value and the mean value."},{"label":"D","text":"the spread of the normal distribution."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"e9e2f57c67753b1a1213431a3bae1602772d4f1e"},{"id":"q-3c016ebe6723","stem":"Given that a milligram 1 × 10−3 gram, what is a microgram?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"1 × 103 gram"},{"label":"B","text":"One thousand milligram"},{"label":"C","text":"1 × 10−6 gram"},{"label":"D","text":"0.001 gram"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"],"duplicateStemGroup":"a05dcd9c2ee88357b87bde3dce512532d342413a"},{"id":"q-b049de5cbdd8","stem":"How many micrograms are there in one milligram?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"0.001"},{"label":"B","text":"0.1"},{"label":"C","text":"100"},{"label":"D","text":"1000"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-5864cabe44ea","stem":"How many milligrams are there in one microgram?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"0.001"},{"label":"B","text":"1000"},{"label":"C","text":"0.1"},{"label":"D","text":"1,000,000"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"],"duplicateStemGroup":"e1d39254204b34ce9244577166f2dab4b2e4b6db"},{"id":"q-bc1271187f67","stem":"What is meant when a person’s mass is stated as 73.6 kg? That","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the mass is closer to 73.6 than it is to 73.7 or 73.5"},{"label":"B","text":"the mass is closer to 73.6 than to any other value"},{"label":"C","text":"the mass is between 73.5 and 73.7"},{"label":"D","text":"the mass is 73.6 ± 0.1 kg"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-aceb6b60721b","stem":"Which of the following statements applies to the statistic known as the “stan- dard deviation”?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It is a measure of central tendency."},{"label":"B","text":"It is only applicable to qualitative measurements."},{"label":"C","text":"Standard deviation is also known as the “variance”."},{"label":"D","text":"95 % of all data lie within two standard deviations of the mean."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"81c023f74dfe0f19223f70e6ca6061e346195d89"},{"id":"q-afc1f327ee82","stem":"Which of the following units is NOT part of the Australian metric system of units?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"mmHg for measuring blood pressure"},{"label":"B","text":"degree Celsius for measuring temperature"},{"label":"C","text":"Pascal for measuring pressure"},{"label":"D","text":"second for measuring time"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-4d4c30a9da0a","stem":"In the Australian Metric System of units, what does the prefix micro stand for?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"one thousand"},{"label":"B","text":"one thousandth"},{"label":"C","text":"one million"},{"label":"D","text":"one millionth"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerifie