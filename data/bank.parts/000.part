atus"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-4ca43a529fef","stem":"Which of the following is a function of membrane proteins?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"to process lipids and proteins for secretion through the plasma membrane"},{"label":"B","text":"to act as receptors for hormones"},{"label":"C","text":"to synthesise proteins from amino acids"},{"label":"D","text":"to act as a cytoskeleton to support and shape the cell"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"6bad5a8aa9bb32ee8bda79c076647cc1088c8119"},{"id":"q-b9c439814d19","stem":"What is the difference between simple squamous cells and simple columnar cells?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"squamous cells are flattened while columnar cells are taller than they are wide."},{"label":"B","text":"simple squamous cells are one layer thick while simple columnar cells are several layers thick."},{"label":"C","text":"simple squamous cells are epithelial tissue while simple columnar cells are connective tissue."},{"label":"D","text":"squamous cells are flattened while columnar cells are cuboidal."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"a3b09e24cf1bb8f3b83f9919bf8eb112af744d51"},{"id":"q-d161330c547f","stem":"Which of the following is NOT an example of a cell?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"macrophages"},{"label":"B","text":"lysosomes"},{"label":"C","text":"plasmocytes"},{"label":"D","text":"chondroblasts"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"7767a09a676bd0f777a445d53b9a37a5ab9b5a49"},{"id":"q-56b3f7af2fdf","stem":"Which cell organelles contain an acidic environment capable of digesting a wide variety of molecules?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","sugges