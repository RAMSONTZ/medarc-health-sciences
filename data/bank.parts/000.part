alth Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"a203194bd0afb2c357b975064a700449613ba02f"},{"id":"q-705fbf27e742","stem":"Which layer in an artery is primarily skeletal muscle?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Histology and Tissues","topicOriginal":"Histology and Tissues","subtopic":"Artery","suggestedTopic":null,"options":[{"label":"A","text":"Tunica intima"},{"label":"B","text":"Tunica media"},{"label":"C","text":"Tunica externa"},{"label":"D","text":"All of the above"},{"label":"E","text":"None of the above"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Histology and Tissues","answerAuditStatus":"independent_checked","sourceAnswerTrusted":false,"publicationStatus":"checked_explained","auditFlags":[],"cleaningOperations":[],"duplicateStemGroup":"e3b5c017b19be359622a5f90718c0d954b4d54a7"},{"id":"q-6e8fed0a354b","stem":"Which of the following is NOT a distinguishing feature between larger veins and arteries?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Histology and Tissues","topicOriginal":"Histology and Tissues","subtopic":"Vein","suggestedTopic":null,"options":[{"label":"A","text":"Veins have valves whereas arteries do not have valves"},{"label":"B","text":"The tunics in veins are not as clearly delimited as are the tunics in arteries"},{"label":"C","text":"The walls in veins are thinner than the walls in arteries"},{"label":"D","text":"The lumen of a vein is smaller than the lumen of an artery"},{"label":"E","text":"None. All of the above are true"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Histology and Tissues","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"360163f51e124f99f3f16f41a1f28e5579d53360"},{"id":"q-866122b5b7e3","stem":"In which structure are things moved across the epithelium via pinocytotic vesicles?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Continuous capillaries"},{"label":"B","text":"Fenestrated capillaries"},{"label":"C","text":"Sinusoidal capillaries"},{"label":"D","text":"AV anastomoses"},{"label":"E","text":"Venous sinus"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"01a01cd18a7e66d96a62edf6497e67d2981b3a67"},{"id":"q-6456c6cb6da6","stem":"What is a thoroughfare which is a an intermediate between an arteriole and capillary?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Metcapillary"},{"label":"B","text":"Metartery"},{"label":"C","text":"Metvenule"},{"label":"D","text":"Metarteriole"},{"label":"E","text":"None of the above A metarteriole is a thoroughfare that can be considered an intermediate between an arteriole and capillary is a metarteriole."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"e4b2b166e6414005cce4829223818aaa65b0ab14"},{"id":"q-199711ff8ad5","stem":"Which layer in an artery contains the endothelium?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Histology and Tissues","topicOriginal":"Histology and Tissues","subtopic":"Artery","suggestedTopic":null,"options":[{"label":"A","text":"Tunica intima"},{"label":"B","text":"Tunica media"},{"label":"C","text":"Tunica externa"},{"label":"D","text":"All of the above"},{"label":"E","text":"None of the above"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Histology and Tissues","answerAuditStatus":"reference_reviewed_duplicate","sourceAnswerTrusted":false,"publicationStatus":"checked_explained","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"dc83e0df9e3185761012712cb82232087ebc9195"},{"id":"q-a36f68103d6b","stem":"What do you call the simple squamous epithelium that lines the blood vessels?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Epithelioid tissue"},{"label":"B","text":"Mesothelium"},{"label":"C","text":"Endothelium"},{"label":"D","text":"Transitional"},{"label":"E","text":"Pseudostratified"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"6243bd3ea9e6385dcc2c4abb6eb5cc3f4ba10414","manualEdits":{}},{"id":"q-a625f1af9067","stem":"In which of the following is a portal system NOT found?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Kidney"},{"label":"B","text":"Liver"},{"label":"C","text":"Muscle"},{"label":"D","text":"Brain"},{"label":"E","text":"None of the above is correct; a portal system is found in all of the above The normal flow of blood is as follows: artery - arteriole - capillary - post capillary venule -vein. However, exceptions to this pattern of blood flow exist. The phenomenon when a vein is between two capillary beds is called a venous portal system. An example of this is the hepatic portal system. Another example of a venous portal system is seen in the brain between the hypothalamus and pituitary. The phenomenon when an arteriole is between two capillary beds is called an arterial portal system. This is seen in the kidney."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["long_option_manual_review","repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"27018cd9f837ba8f8ed5e9e3bf602198fad87a84"},{"id":"q-3352bd1b6ea5","stem":"What is the brachial artery?","type":"Single Best Answer MCQ","subject"