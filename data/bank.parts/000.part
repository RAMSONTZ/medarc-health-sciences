tem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"7f04daa4053989b2e89c29419b35159ff618e194"},{"id":"q-b3c32b48b588","stem":"What are the splenic cords?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cords of Billroth"},{"label":"B","text":"Cords of Paneth"},{"label":"C","text":"Cords of Bellini"},{"label":"D","text":"Cords of Rothchild"},{"label":"E","text":"Cords of Hassall The splenic cords are also called the cords of Billroth."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"422a534d186165c4b98b9d47fe8808069ec8f417"},{"id":"q-883cc9753bed","stem":"When looking at the spleen, what are the invaginations of the capsule into the splenic parenchyma called?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Malpighian corpuscle"},{"label":"B","text":"Trabeculae"},{"label":"C","text":"White pulp"},{"label":"D","text":"Red pulp"},{"label":"E","text":"Cords of Billroth"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"2fc32229003643015288cd80a5d826c5ce1f3552"},{"id":"q-eec14fc551e1","stem":"When looking at a lymph node, which term does not refer to the same region as all the others listed?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Deep cortex"},{"label":"B","text":"Tertiary cortex"},{"label":"C","text":"Outer cortex"},{"label":"D","text":"Juxtamedullary cortex"},{"label":"E","text":"Paracortical zone Deep cortex, tertiary cortex, juxtamedullary cortex and paracortical zone are all terms for the same region in a lymph node. The deep cortex is the inner region of the cortex, next to the medulla."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"d1d7b133c647a11a226466fdef9a1e2ec495bc6b"},{"id":"q-9601557cf015","stem":"What are the spherical structures seen in the medulla of the thymus called?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Psammoma bodies"},{"label":"B","text":"Corpora arenacea"},{"label":"C","text":"Hassall's corpuscles"},{"label":"D","text":"Prostatic concretions"},{"label":"E","text":"Pacinian corpuscles Psammoma bodies are collections of calcium."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"77200f966f2f78d0b44634dae6092cf8966330fe"},{"id":"q-93067328206b","stem":"Where are Peyer's patches located?","type":"Single Best Answer MCQ","subject":"Ophthalmology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Esophagus"},{"label":"B","text":"Stomach"},{"label":"C","text":"Small intestine"},{"label":"D","text":"Large intestine"},{"label":"E","text":"Rectum Peyer's patches are large nodules of lymphatic tissue."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Ophthalmology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"32cb3f3ba5ab3d43b471a36e0d2e70f63e7bf15a"},{"id":"q-98b9e9f21af3","stem":"What are the large aggregates of lymphatic tissue in the ileum?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Lymph follicles"},{"label":"B","text":"White pulp"},{"label":"C","text":"Peyer's patches"},{"label":"D","text":"Lymph node"},{"label":"E","text":"Diffuse lymphatic tissue"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"be6a1996c8c4f018c6b8662900fc0fdd75c0542f"},{"id":"q-bbc545fc9845","stem":"Where is diffuse lymphatic tissue NOT found?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Gastrointestinal tract"},{"label":"B","text":"Central nervous system"},{"label":"C","text":"Genito-urinary tract"},{"label":"D","text":"Respiratory tract"},{"label":"E","text":"None of the above-diffuse lymphatic tissue is found in all of these regions Diffuse lymphatic tissue is non-encapsulated lymphatic tissue. It is found in the gastrointestinal tract, the genito-urinary tract, and the respiratory tract. In the gastrointestinal tract it is referred to as GALT (gut associated lymphatic tissue). In the respiratory tract it is referred to as BALT (bronchi associated lymphatic tissue). Diffuse lymphatic tissue is not found in the central nervous system."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["long_option_manual_review","repeated_question_stem","subject_needs_