t":"areolar connective tissue"},{"label":"D","text":"simple columnar epithelial tissue"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"2347a4feb977ce6d2191618a189b70625c040ca2"},{"id":"q-1f8707c6f7b0","stem":"One of the following is NOT a serous membrane. Which one?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"pleura"},{"label":"B","text":"peritoneum"},{"label":"C","text":"mucosa"},{"label":"D","text":"pericardium"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-660b6b394852","stem":"Which of the following is NOT made predominantly from epithelial tissue?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"In the dermis"},{"label":"B","text":"In exocrine glands"},{"label":"C","text":"In endocrine glands"},{"label":"D","text":"In the endothelium of blood vessels"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{"sourceStem":"Which of the following is NOT made predominantly from epithelial tissue?","sourceOptions":[{"label":"A","text":"In the dermis"},{"label":"B","text":"In exocrine glands"},{"label":"C","text":"In endocrine glands"},{"label":"D","text":"In the endothelium of blood vessels Answer is A: The dermis contains connective tissue, nervous tissue & muscle as well as epithelial tissue."}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-28fd56967bcf","stem":"What are tendons and ligaments composed of?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Dense connective tissue"},{"label":"B","text":"Liquid connective tissue"},{"label":"C","text":"Muscular tissue"},{"label":"D","text":"Epithelial tissue"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"62c00842074bc20c13c7c276e56cc539e5231577"},{"id":"q-6b31e204150c","stem":"What is the composition of the intercellular matrix in connective tissue?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cells and fibres"},{"label":"B","text":"Serous and mucus membranes and lamina propria"},{"label":"C","text":"Protein fibres and ground substance"},{"label":"D","text":"Interstitial fluid"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"f0c5765aeac651da0e1b2ffcbdf19ce6898c7c3d","manualEdits":{"sourceStem":"What is the composition of the intercellular matrix in connective tissue?","sourceOptions":[{"label":"A","text":"Cells and fibres"},{"label":"B","text":"Serous and mucus membranes and lamina propria"},{"label":"C","text":"Protein fibres and ground substance"},{"label":"D","text":"Interstitial fluid Answer is C: “intercellular” means between cells. So matrix is fibres & ground substance (but no cells)."}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-5541319cb2a0","stem":"Which statement about the plasma membrane is INCORRECT?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It is selectively permeable."},{"label":"B","text":"It is composed of two layers of glycoprotein molecules."},{"label":"C","text":"It contains receptors for specific signalling molecules."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_w