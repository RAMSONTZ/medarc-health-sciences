atus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-4856f6c5fe00","stem":"Adipocytes are found in which type of tissue?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"muscle tissue"},{"label":"B","text":"epithelial tissue"},{"label":"C","text":"nervous tissue"},{"label":"D","text":"connective tissue"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-18e852704e2b","stem":"What is the role of mitochondria? To","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"function in cell division"},{"label":"B","text":"synthesise proteins"},{"label":"C","text":"form part of the plasma membrane"},{"label":"D","text":"synthesise fatty acids, phospholipids and steroids."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-494229286482","stem":"Which one of the following cell types is found in epithelial tissue?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"mast cells"},{"label":"B","text":"adipocytes"},{"label":"C","text":"chondroblasts"},{"label":"D","text":"melanocytes"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"],"duplicateStemGroup":"a71185a1bbe71ada12f2c3b32fdb0eedc0ec6b4d"},{"id":"q-284db3f24b26","stem":"What is the difference between “loose” connective tissue (CT) and “dense” connective tissue?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Fibres occupy most of the volume in dense CT"},{"label":"B","text":"Dense CT includes cartilage, loose CT does not. 16 2 Cells and Tissues"},{"label":"C","text":"Loose CT has a good blood supply while dense CT does not."},{"label":"D","text":"Loose CT has no fibres (and dense CT does)."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"b980a55022623dbb6d33ba3db29cacca6c23cded"},{"id":"q-38c7a4e24935","stem":"Facilitated diffusion refers to the process of","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"movement along a concentration gradient assisted by protein carrier molecules."},{"label":"B","text":"movement of ions and molecules along a concentration gradient."},{"label":"C","text":"transport of molecules and ions against their concentration gradient."},{"label":"D","text":"water movement through a semi-permeable membrane"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-7a883e739604","stem":"What do fibroblasts, chondroblasts, osteoblasts and haemocytoblasts have in common?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"they are all types of white blood cell."},{"label":"B","text":"they are all macrophages."},{"label":"C","text":"they are all immature cells."},{"label":"D","text":"they are all types of epithelial cell."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D","whitespace/page_marker_normalization"],"duplicateStemGroup":"9b9244c20455e6a4512710ff82bcde9c26565862"},{"id":"q-e11d91033a17","stem":"Which is NOT true of connective tissue (CT)?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the cells are closely packed"},{"label":"B","text":"the tissue contains protein fibres and ground substance."},{"label":"C","text":"types include loose CT, dense CT and liquid CT."},{"label":"D","text":"CT contains white blood cells."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"271048d9d4dbf709df13c15524550abe8f40f52a","manualEdits":{"sourceStem":"Which is NOT true of connective tissue (CT)?","sourceOptions":[{"label":"A","text":"the cells are closely packed"},{"label":"B","text":"the tissue contains protein fibres and ground substance."},{"label":"C","text":"types include loose CT, dense CT and liquid CT."},{"label":"D","text":"CT contains white blood cells. Answer is A: being close packed in a property of epithelial tissue. In CT the cells are widely spaced, being separated by the ground substance."}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-0ce8c8584548","stem":"Active transport across the plasma membrane may be described by which statement?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thoracic Wall and Mediastinum · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Thoracic Wall and Mediastinum","options":[{"label":"A","text":"active transport requires energy from ATP."},{"label":"B","text":"active transport is also known as endocytosis."},{"label":"C","text":"active transport moves molecules along their concentration gradient."},{"label":"D","text":"active transport is the movement of lipid-soluble molecules through the plasma membrane."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thoracic Wall and Mediastinum · Suggested","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["answer_text_in_option","repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"5047ba3fed63392c862622fc4cbbad3c161f4efa"},{"id":"q-720b008ca7bd","stem":"Which of the following cell types denotes an immature cell?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"macrophages"},{"label":"B","text":"monocytes"},{"label":"C","text":"osteoblasts"},{"label":"D","text":"ribosomes"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"8d77e7bc7daf98713c0565848f40383f8bfde00d"},{"id":"q-c92a000df7ae","stem":"Choose the membrane that is NOT a serous membrane.","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"pleura"},{"label":"B","text":"peritoneum"},{"label":"C","text":"pericardium"},{"label":"D","text":"lamina propria"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-957b80795d58","stem":"Which organelle is the site of ATP production?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the nucleus"},{"label":"B","text":"endoplasmic reticulum"},{"label":"C","text":"mitochondria"},{"label":"D","text":"golgi apparatus"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{"sourceStem":"Which organelle is the site of ATP production?","sourceOptions":[{"label":"A","text":"the nucleus"},{"label":"B","text":"endoplasmic reticulum"},{"label":"C","text":"mitochondria"},{"label":"D","text":"golgi apparatus Answer is C: the mitochondria is where ATP is produced."}]}},{"id":"q-6a3bb36dbd57","stem":"Which of the following is ONE major function of epithelial cells?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"movement"},{"label":"B","text":"secretion"},{"label":"C","text":"support of other cell types"},{"label":"D","text":"transmit electrical signals"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{"sourceStem":"Which of the following is ONE major function of epithelial cells?","sourceOptions":[{"label":"A","text":"movement"},{"label":"B","text":"secretion"},{"label":"C","text":"support of other cell types"},{"label":"D","text":"transmit electrical signals Answer is B: glandular tissue are one type of epithelial tissue and their function is to produce material to secrete."}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-dd722afcda83","stem":"What are the major types of tissue in the body?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"nervous, muscle, epithelial, connective."},{"label":"B","text":"squamous, cuboidal, columnar, transitional."},{"label":"C","text":"osteocytes, chondrocytes, leucocytes, adipocytes."},{"label":"D","text":"protein, adipose, cartilage, osseous."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"830faf03f320f93a4b19f458630a3951e7bb669c"},{"id":"q-2c37ad8dc7e1","stem":"Which of the following is NOT one of the organelles within a cell?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"desmosome"},{"label":"B","text":"endoplasmic reticulum"},{"label":"C","text":"mitochondrion"},{"label":"D","text":"golgi apparatus"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"a7232a7392c559c0c1d79283114e299e3b131370"},{"id":"q-e905e9e9842e","stem":"Which list contains the main body tissue types?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"glandular, connective, osseous, nervous"},{"label":"B","text":"epithelial, nervous, connective, muscle."},{"label":"C","text":"endothelial, connective, muscle, cartilaginous"},{"label":"D","text":"epithelial, cartilaginous, muscle, glandular"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-32a3e0e7d4ad","stem":"The process of “diffusion” through a membrane may be described by which of the following?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thoracic Wall and Mediastinum · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Thoracic Wall and Mediastinum","options":[{"label":"A","text":"the movement of ions and molecules away from regions where they are in high concentration towards regions where they are in lower concentration."},{"label":"B","text":"the use of energy from ATP to move ions and small molecules into regions where they are in lower concentration."},{"label":"C","text":"the plasma membrane engulfs the substance and moves it through the membrane."},{"label":"D","text":"the use of energy from ATP to move water molecules against their concen- tration gradient."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thoracic Wall and Mediastinum · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-4c2dbf7e6984","stem":"The process of “active transport” through a membrane may be described by which of the following?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thoracic Wall and Mediastinum · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Thoracic Wall and Mediastinum","options":[{"label":"A","text":"the movement of ions and small molecules away from regions where they are in high concentration."},{"label":"B","text":"the use of energy from ATP to move ions and small molecules into regions where they are in lower concentration."},{"label":"C","text":"the plasma membrane engulfs the substance and moves it through the membrane."},{"label":"D","text":"the use of energy from ATP to move ions and small molecules against their concentration gradient."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thoracic Wall and Mediastinum · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"6abe6f395d829637bbbcf9314ef7cae54c613660"},{"id":"q-a1c5b87fbe02","stem":"Which of the following is the smallest living structural unit of the body?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"atom"},{"label":"B","text":"molecule"},{"label":"C","text":"organelle D cell"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option C"]},{"id":"q-284193c58f1c","stem":"Which of the following enables ions such as sodium to cross a plasma membrane?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"phospholipid bilayer"},{"label":"B","text":"peripheral proteins"},{"label":"C","text":"integral proteins"},{"label":"D","text":"desmosomes"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverifi