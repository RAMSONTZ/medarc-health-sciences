ority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"bf8885cd4f6afd327dd87afa308b12a5a8f5668e"},{"id":"q-5a6aaae96407","stem":"What is one function of mitochondria? To","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"produce enzymes to break down molecules"},{"label":"B","text":"produce molecules of ATP"},{"label":"C","text":"hold adjacent cells together"},{"label":"D","text":"allow passage of molecules through the plasma membrane"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-a75f201b9b19","stem":"Membrane proteins perform the following functions EXCEPT one. Which One?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"form the glycocalyx"},{"label":"B","text":"act as receptor proteins"},{"label":"C","text":"form pores to allow the passage of small solutes"},{"label":"D","text":"behave as enzymes."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"e495e39102617e56b0586367b42b26656436e30b"},{"id":"q-6970204e75d8","stem":"Facilitated diffusion differs from active transport because facilitated diffusion","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"requires energy from ATP"},{"label":"B","text":"moves molecules from where they are in lower concentration to higher concentration"},{"label":"C","text":"moves molecules from where they are in higher concentration to lower concentration."},{"label":"D","text":"involves ions & molecules that pass through membrane channels."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-ef5f5be97c59","stem":"Which of the following is NOT a connective tissue?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"blood"},{"label":"B","text":"mesothelium"},{"label":"C","text":"fat"},{"label":"D","text":"tendon"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{"sourceStem":"Which of the following is NOT a connective tissue?","sourceOptions":[{"label":"A","text":"blood"},{"label":"B","text":"mesothelium"},{"label":"C","text":"fat"},{"label":"D","text":"tendon Answer is B: mesothelium is simple squamous epithelium that is found in serous membranes."}]}},{"id":"q-27f97f056787","stem":"The cells that are found in tendons are called","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"osteocytes"},{"label":"B","text":"adipocytes"},{"label":"C","text":"haemocytoblasts"},{"label":"D","text":"fibroblasts"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"7d1adf15bccf01f1149d16f9d18180c12b18936a"},{"id":"q-2fd39e055e21","stem":"Which one of the following terms best describes the structure of the cell membrane","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thoracic Wall and Mediastinum · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Thoracic Wall and Mediastinum","options":[{"label":"A","text":"fluid mosaic model"},{"label":"B","text":"static mosaic model"},{"label":"C","text":"quaternary structure"},{"label":"D","text":"multilayered structure"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thoracic Wall and Mediastinum · Suggested","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"364877d0ccd5030ab28cf597d08d6684ba2b92a9"},{"id":"q-a23c80ac07f0","stem":"Which one of the following terms best describes a phospholipid. It consists of a","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Lipids","topicOriginal":"Lipids","subtopic":"Lipid","suggestedTopic":null,"options":[{"label":"A","text":"polar head and polar tail"},{"label":"B","text":"non-polar head and a polar tail"},{"label":"C","text":"polar head and non-polar tail"},{"label":"D","text":"non-polar head and a non-polar tail"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Lipids","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[],"manualEdits":{"sourceStem":"Which one of the following terms best describes a phospholipid. It consists of a","sourceOptions":[{"label":"A","text":"polar head and polar tail"},{"label":"B","text":"non-polar head and a polar tail"},{"label":"C","text":"polar head and non-polar tail"},{"label":"D","text":"non-polar head and a non-polar tail Answer is C: polar = hydrophilic head of phosphate (which can dissolve in the aqueous extracellular solution because water molecules are polar); non-polar = hydrophobic tails of lipid, which being non-polar, cannot dissolve in aqueous solutions."}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-e928d9feb90c","stem":"One of the functions of integral proteins in cell membranes is to","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"maintain the rigid structure of the cell"},{"label":"B","text":"support mechanically the phospholipids"},{"label":"C","text":"interact with the cytoplasm"},{"label":"D","text":"form channels for transport functions"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-a3523359fddb","stem":"Which one of the following best describes what a cell membrane consists of?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thoracic Wall and Mediastinum · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Thoracic Wall and Mediastinum","options":[{"label":"A","text":"lipids, proteins, ribosomes"},{"label":"B","text":"lipids, cholesterol, proteins"},{"label":"C","text":"cholesterol, proteins, cytoplasm"},{"label":"D","text":"lipids, proteins, cytoplasm"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thoracic Wall and Mediastinum · Suggested","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"fc9cc3ada7c7b5c86e524697149ac5beeaef5de1"},{"id":"q-c274be69af4c","stem":"Which one of the following organelles is considered as the “energy producing” centre of the cell?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"rough endoplasmic reticulum"},{"label":"B","text":"Golgi apparatus"},{"label":"C","text":"mitochondria"},{"label":"D","text":"ribosomes"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-088bb300abba","stem":"What is the major function of lysosomes? They","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"package proteins"},{"label":"B","text":"detoxify toxic substances"},{"label":"C","text":"catalyse lipid metabolism"},{"label":"D","text":"digest unwanted particles within the cell"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"376f041cd50babd86f8faa3512d6db185a80657d"},{"id":"q-e6da286874b0","stem":"What is the purpose of the “sodium/potassium pump”","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"to perform endocytosis."},{"label":"B","text":"to move sodium and potassium by facilitated diffusion."},{"label":"C","text":"to perform bulk transport through the plasma membrane."},{"label":"D","text":"To produce a concentration gradient for sodium ions"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-d9a780c9c84c","stem":"Which of the following is NOT a type of cell?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"ribosome"},{"label":"B","text":"haemocytoblast"},{"label":"C","text":"neutrophil"},{"label":"D","text":"phagocyte"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-dd00b4e69974","stem":"What is the name of the mechanism that ensures that there is a higher concen- tration of sodium ions in the extracellular fluid than in the intracellular fluid?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Facilitated diffusion"},{"label":"B","text":"The sodium-potassium pump"},{"label":"C","text":"Secondary active transport"},{"label":"D","text":"Osmosis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D","whitespace/page_marker_normalization"],"duplicateStemGroup":"42a6fd1120055289825e794930060354b3ef4ab1"},{"id":"q-c5c0997fd3da","stem":"What is the name given to the type of transport where glucose or an amino acid binds to a receptor protein on the plasma membrane, which then moves the molecule into the cell without the expenditure of energy?","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Water, pH and Buffers","topicOriginal":"Water, pH and Buffers","subtopic":"Acid","suggestedTopic":null,"options":[{"label":"A","text":"facilitated diffusion"},{"label":"B","text":"bulk transport"},{"label":"C","text":"secondary active transport"},{"label":"D","text":"active transport"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Water, pH and Buffers","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-d7be8adc0379","stem":"What is the name given to the movement of glucose or amino acids from the gut into the cells lining the gut, when they bind to a transport protein that has also bound a sodium ion. The sodium ion is entering the cell along its concentration gradient.","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Water, pH and Buffers","topicOriginal":"Water, pH and Buffers","subtopic":"Acid","suggestedTopic":null,"options":[{"label":"A","text":"facilitated diffusion"},{"label":"B","text":"the sodium potassium pump"},{"label":"C","text":"active transport"},{"label":"D","text":"secondary active transport"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Water, pH and Buffers","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[],"manualEdits":{"sourceStem":"What is the name given to the movement of glucose or amino acids from the gut into the cells lining the gut, when they bind to a transport protein that has also bound a sodium ion. The sodium ion is entering the cell along its concentration gradient.","sourceOptions":[{"label":"A","text":"facilitated diffusion"},{"label":"B","text":"the sodium potassium pump"},{"label":"C","text":"active transport"},{"label":"D","text":"secondary active transport Answer is D: the sodium ion was transported out of the cell with the use of energy in order to set up the sodium concentration gradient. This gradient then allows other molecules to enter the cell along with sodium’s re-entry. This is active (because energy used), but secondary as it occurs as a result of the previ- ous active transport event."}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-7422431fdd44","stem":"Mitochondria produce which of the following?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"ATP"},{"label":"B","text":"DNA"},{"label":"C","text":"RNA"},{"label":"D","text":"proteins"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-414b7d42a99a","stem":"Why does the plasma membrane of a cell present a barrier to the movement of electrolytes through it?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"There are no channels in the membrane for the passage of electrolytes."},{"label":"B","text":"Electrolytes are not soluble in the lipid of the membrane."},{"label":"C","text":"Electrolytes are too large to pass through membrane channels."},{"label":"D","text":"Membrane proteins electrically repel charged particles."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"a26618c0a41c95c3ff50812b635f8e3b8cb903fc"},{"id":"q-e6576b0b8836","stem":"Which of the following statements about “leak channels” in the plasma mem- brane is correct?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Proteins that form these channels bind to solutes to allow them to pass into the cell."},{"label":"B","text":"They are passageways formed by proteins to allow water and ions to move passively through the membrane."},{"label":"C","text":"They allow small ions and molecules to move between adjacent cells."},{"label":"D","text":"They are formed by glycoprotein and proteoglycans to allow hormones to enter cells."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"63e9e8340d269fc793c81eebc25a6a248af75fcb"},{"id":"q-b4ce47507608","stem":"What are the primary types of body tissue?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"connective tissue, blood, muscle tissue, nervous tissue, epithelial tissue."},{"label":"B","text":"muscle tissue, osseous tissue, epithelial tissue, nervous tissue, blood, con- nective tissue."},{"label":"C","text":"nervous tissue, epithelial tissue, muscle tissue, connective tissue"},{"label":"D","text":"epithelial tissue, connective tissue, adipose tissue, muscle tissue, nervous tissue."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-31efafcfff2f","stem":"Epithelial and connective tissue differ from each other in which of the follow- ing characteristics?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"epithelial tissue contains fibres but connective tissue does not."},{"label":"B","text":"connective tissue is avascular but epithelial tissue is well-vascularised."},{"label":"C","text":"cells in epithelial tissue are closely packed, whereas in connective tissue they are not."},{"label":"D","text":"connective tissue includes tissue that makes up glands, but epithelial tissue does not occur in glands."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"a6e002d3158e98d6483e22b88314062f9109512d","manualEdits":{"sourceStem":"Epithelial and connective tissue differ from each other in which of the follow- ing characteristics?","sourceOptions":[{"label":"A","text":"epithelial tissue contains fibres but connective tissue does not."},{"label":"B","text":"connective tissue is avascular but epithelial tissue is well-vascularised."},{"label":"C","text":"cells in epithelial tissue are closely packed, whereas in connective tissue they are not."},{"label":"D","text":"connective tissue includes tissue that makes up glands, but epithelial tissue does not occur in glands. Answer is C: The other choices are not correct."}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-0eb2ad0e3ef5","stem":"Which of the following is a component of the plasma membrane of a cell?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"plasma"},{"label":"B","text":"glycolipid"},{"label":"C","text":"plasma proteins"},{"label":"D","text":"cholesterol"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"24801971664fdde59ff5a5218c1fde28bea1aa30"},{"id":"q-e52e391bd417","stem":"What term is used to describe the movement of dissolved particles along (or down) their concentration gradient?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thoracic Wall and Mediastinum · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Thoracic Wall and Mediastinum","options":[{"label":"A","text":"endocytosis"},{"label":"B","text":"active transport"},{"label":"C","text":"osmosis"},{"label":"D","text":"diffusion"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thoracic Wall and Mediastinum · Suggested","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-79c9877eb2c5","stem":"Which of the following molecules cannot pass through the plasma membrane?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"water molecules"},{"label":"B","text":"non-polar molecules"},{"label":"C","text":"amino acid based hormones"},{"label":"D","text":"fat-soluble molecules"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-deefffac9e7a","stem":"Which of the following is a connective tissue?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"pancreas"},{"label":"B","text":"spinal cord"},{"label":"C","text":"muscle"},{"label":"D","text":"blood"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{"sourceStem":"Which of the following is a connective tissue?","sourceOptions":[{"label":"A","text":"pancreas"},{"label":"B","text":"spinal cord"},{"label":"C","text":"muscle"},{"label":"D","text":"blood Answer is D: blood contains cells separated by a liquid matrix. Choices A & B are epithelial and nervous tissues."}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-f4d2cba0b541","stem":"Which of the following is an epithelial tissue?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"adipose tissue"},{"label":"B","text":"the adrenal gland"},{"label":"C","text":"the heart"},{"label":"D","text":"blood"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{"sourceStem":"Which of the following is an epithelial tissue?","sourceOptions":[{"label":"A","text":"adipose tissue"},{"label":"B","text":"the adrenal gland"},{"label":"C","text":"the heart"},{"label":"D","text":"blood Answer is B: the adrenal gland is glandular epithelial tissue."}]}},{"id":"q-bc5d2b7b9211","stem":"What is the major component of the plasma membrane of a cell?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"phospholipid"},{"label":"B","text":"glycolipid"},{"label":"C","text":"integral protein"},{"label":"D","text":"cholesterol"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"b322bd7cbeca3b4cb7f6a1c9041d740e930c5999"},{"id":"q-55c4671be5c7","stem":"Which one of the following is NOT a function of membrane proteins?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"they form a structure called a glycocalyx"},{"label":"B","text":"they attach cells to each other"},{"label":"C","text":"they form passageways to allow solutes to pass through the membrane"},{"label":"D","text":"they from receptors which can bind messenger molecules"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-1e2961e5162f","stem":"Facilitated diffusion through a membrane involves which of the following scenarios?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the diffusion of water through a selectively permeable membrane along its concentration gradient."},{"label":"B","text":"the movement of a molecule against its concentration gradient with the expenditure of energy"},{"label":"C","text":"the plasma membrane surrounding (engulfing) the molecule & the molecule moving into the cell."},{"label":"D","text":"a molecule binding to a receptor which moves the molecule through the membrane without the expenditure of energy"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"0e6c60de336f6355cc393f056d959b4f7ac16b8a"},{"id":"q-e307b54f7072","stem":"The diffusion of water through a membrane is referred to as","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"secondary active transport"},{"label":"B","text":"bulk transport"},{"label":"C","text":"osmosis"},{"label":"D","text":"endocytosis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-37c63ec85957","stem":"What is the tissue that covers the body surface and lines internal tubes called?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Face","suggestedTopic":null,"options":[{"label":"A","text":"epithelial tissue"},{"label":"B","text":"connective tissue"},{"label":"C","text":"glandular epithelium"},{"label":"D","text":"muscle tissue"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-1d2dacd6bbf0","stem":"Which of the following is true for connective tissue?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"it consists of cells, a basement membrane and intercellular matrix"},{"label":"B","text":"its cells are closely packed and held together by protein fibres."},{"label":"C","text":"it has a high rate of cell division and no blood supply"},{"label":"D","text":"it is made of cells, protein fibres and ground substance"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"f8951bb1180b4b65aa89c85019b7f026e8c72699","manualEdits":{"sourceStem":"Which of the following is true for connective tissue?","sourceOptions":[{"label":"A","text":"it consists of cells, a basement membrane and intercellular matrix"},{"label":"B","text":"its cells are closely packed and held together by protein fibres."},{"label":"C","text":"it has a high rate of cell division and no blood supply"},{"label":"D","text":"it is made of cells, protein fibres and ground substance Answer is D: Connective tissue includes fibres and cells which are not closely packed."}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-d6ac35340747","stem":"The cell membrane’s resting potential (about −70 mV inside with respect to the outside) is due mainly to which of the following mechanisms?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The sodium potassium pump."},{"label":"B","text":"The diffusion of cations and anions through the membrane along their con- centration gradients."},{"label":"C","text":"The diffusion of sodium and potassium across the cell membrane."},{"label":"D","text":"The presence inside the cell of anions too large to passively cross the cell membrane."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"]},{"id":"q-7a7f86615ee8","stem":"The term “chromatin” would be used in reference to which of the following?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"genetic substance"},{"label":"B","text":"cellular energy"},{"label":"C","text":"membrane support"},{"label":"D","text":"nuclear membrane"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-2dff6e2cfd61","stem":"In protein synthesis, where dose translation occur? In the","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"cytoplasm between ribosomes, tRNA and mRNA"},{"label":"B","text":"nucleus between ribosomes, tRNA and mRNA"},{"label":"C","text":"nucleus between DNA and mRNA"},{"label":"D","text":"cytoplasm between DNA and mRNA"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{"sourceStem":"In protein synthesis, where dose translation occur? In the","sourceOptions":[{"label":"A","text":"cytoplasm between ribosomes, tRNA and mRNA"},{"label":"B","text":"nucleus between ribosomes, tRNA and mRNA"},{"label":"C","text":"nucleus between DNA and mRNA"},{"label":"D","text":"cytoplasm between DNA and mRNA Answer is A: translation occurs in the cytoplasm (transcription occurs in the nucleus). DNA does not exist in the cytoplasm."}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-89e3d23d4489","stem":"If the DNA strand sequence of bases is CTT AGA CTA ATA, what would the tRNA read?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"GAA TCT GAT TAT"},{"label":"B","text":"CUU AGA CUA AUA"},{"label":"C","text":"GAA UCU GAU UAU"},{"label":"D","text":"GUU ACA GUA AUA"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-25780525354f","stem":"Which one of the following statements best describes DNA?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thoracic Wall and Mediastinum · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Thoracic Wall and Mediastinum","options":[{"label":"A","text":"single stranded, deoxyribonucleic acid"},{"label":"B","text":"single stranded, ribonucleic acid"},{"label":"C","text":"double stranded, deoxyribonucleic acid"},{"label":"D","text":"double stranded, ribonucleic acid"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thoracic Wall and Mediastinum · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-c906db024f9d","stem":"In which phase of mitosis would chromosomes line up at the centre of the spindle","type":"Single Best Answer MCQ","subject":"Medical Genetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"anaphase"},{"label":"B","text":"interphase"},{"label":"C","text":"prophase"},{"label":"D","text":"metaphase"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Genetics","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"26b21299b3cb1438f2f651d982852304751fd0b7","manualEdits":{"sourceStem":"In which phase of mitosis would chromosomes line up at the centre of the spindle","sourceOptions":[{"label":"A","text":"anaphase"},{"label":"B","text":"interphase"},{"label":"C","text":"prophase"},{"label":"D","text":"metaphase Answer is D: Remember the metaphase plate occupies the middle of the cell."}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-e3f398f90225","stem":"In a cell cycle which phase takes the longest time to complete","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"anaphase"},{"label":"B","text":"interphase"},{"label":"C","text":"prophase"},{"label":"D","text":"telophase"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-d61c41359bf0","stem":"What is the purpose of meiosis? To produce","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"DNA"},{"label":"B","text":"somatic cells"},{"label":"C","text":"diploid cells"},{"label":"D","text":"haploid cells"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-3808f04c421c","stem":"What results from the events that occur during metaphase of mitosis?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The nuclear membranes form around two nuclei."},{"label":"B","text":"The chromosomes are aligned on a plane in the centre of the cell."},{"label":"C","text":"The chromosomes become visible and attach to the spindle fibres."},{"label":"D","text":"The chromatids from each chromosome separate and move to opposite sides of the cell."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"dcbf44012df785a0679b193939b862f11f27b01f"},{"id":"q-f64b1d6b7307","stem":"What is the name of the process of division of a somatic cell’s nucleus into two daughter nuclei?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"prophase"},{"label":"B","text":"cytokinesis"},{"label":"C","text":"mitosis"},{"label":"D","text":"meiosis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-79105a05ce26","stem":"In a strand of DNA, what is the combination of deoxyribose and phosphate and base known as?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thoracic Wall and Mediastinum · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Thoracic Wall and Mediastinum","options":[{"label":"A","text":"A ribosome"},{"label":"B","text":"A chromatid 30 2 Cells and Tissues"},{"label":"C","text":"A codon"},{"label":"D","text":"A nucleotide"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thoracic Wall and Mediastinum · Suggested","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"6eea6b4598124a8ef0884164690c413fea46828d","manualEdits":{"sourceStem":"In a strand of DNA, what is the combination of deoxyribose and phosphate and base known as?","sourceOptions":[{"label":"A","text":"A ribosome"},{"label":"B","text":"A chromatid 30 2 Cells and Tissues"},{"label":"C","text":"A codon"},{"label":"D","text":"A nucleotide Answer is D: three nucleotides form a codon and many codons form a chromatid."}]}},{"id":"q-d2751421781a","stem":"What happens during anaphase of mitosis?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"spindle fibres pull each chromatid to opposite sides of the cell"},{"label":"B","text":"the sense and non-sense strands “unzip” along their hydrogen bonds"},{"label":"C","text":"RNA polymerase forms a complementary strand by reading the sense strand"},{"label":"D","text":"the cell cytoplasm divides into two cells"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"963db454a2519dcce360684c10b3f525d642ec58"},{"id":"q-6b79cd173f55","stem":"The process by which information is read from DNA, encoded and transported outside the nucleus is known as","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"translation"},{"label":"B","text":"transcription"},{"label":"C","text":"encoding"},{"label":"D","text":"catalysis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-9b152c34e979","stem":"How many nucleotides are required to code for a single amino acid?","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Water, pH and Buffers","topicOriginal":"Water, pH and Buffers","subtopic":"Acid","suggestedTopic":null,"options":[{"label":"A","text":"twenty"},{"label":"B","text":"five"},{"label":"C","text":"three"},{"label":"D","text":"one"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Water, pH and Buffers","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"3515af40e8a308afc970a015371412da83205531","manualEdits":{"sourceStem":"How many nucleotides are required to code for a single amino acid?","sourceOptions":[{"label":"A","text":"twenty"},{"label":"B","text":"five"},{"label":"C","text":"three"},{"label":"D","text":"one Answer is C: A sequence of three nucleotides constitute a codon. Each codon is specific for one of the 20 amino acids."}],"operations":["trailing_answer_leakage_removed"]}},{"id":"q-aa4a4d573875","stem":"The combination of a sugar, a base and at least one phosphate group is given the general term of","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"nucleoside"},{"label":"B","text":"amino acid"},{"label":"C","text":"polypeptide"},{"label":"D","text":"nucleotide"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option D"],"duplicateStemGroup":"69a32247ba8d432536b9b320a5d22ab04f8f4778"},{"id":"q-e2de98c59534","stem":"The nucleus of the cell contains the master nucleic acid","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"DNA"},{"label":"B","text":"RNA"},{"label":"C","text":"mRNA"},{"label":"D","text":"tRNA"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-02a9476beb18","stem":"Which of the following is the correct combination of the components for the nucleic acid DNA?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Phosphate, Ribose, Uracil"},{"label":"B","text":"Phosphate, Deoxyribose, Proline"},{"label":"C","text":"Phosphate, Ribose, Thymine"},{"label":"D","text":"Phosphate, Deoxyribose, Adenine"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-066a8995e695","stem":"In the ribosome of a cell, the mRNA is read to produce the particular amino acid sequence for the formation of a protein. What is this process called?","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Water, pH and Buffers","topicOriginal":"Water, pH and Buffers","subtopic":"Acid","suggestedTopic":null,"options":[{"label":"A","text":"Translation"},{"label":"B","text":"Transcription"},{"label":"C","text":"Transportation"},{"label":"D","text":"Transmutation"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Water, pH and Buffers","answerAuditStatus":"independently_reasoned_provisional_oct20","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":["source answer/boilerplate removed from option D"]},{"id":"q-cc6cd313ccf4","stem":"Which of the base pairings in DNA would be correct?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A–T pair"},{"label":"B","text":"A–G pair"},{"label":"C","text":"C–T pair"},{"label":"D","text":"C–A pair"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":fals