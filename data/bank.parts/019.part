ct":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"I/v R/lactate mixed with glucose solutions"},{"label":"B","text":"I/v R/Lactate, ORS per motion through NGT and metronidazole"},{"label":"C","text":"I/v R/lactate modified ORS per motion (30mls), monitor urine output and electrolytes immediately."},{"label":"D","text":"I/v R/lactate, ReSoMal 30mls/motion, slow K and F-75 immediately on admission"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"7151d592b833cedb9bc38bc4588c9524cfe8d6bc"},{"id":"q-b680e130ff40","stem":"All of the following are true about anthropometric measurements, except","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Weight for height is a better indicator of the nutritional status than weight for age"},{"label":"B","text":"Weight for age is good in detecting malnutrition"},{"label":"C","text":"Skin fold measurements assesses body fat content"},{"label":"D","text":"Height for age is good in detecting stunting"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-44a9708c1539","stem":"Spot the correct statement regarding malaria in young children","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A child with sickle cell trait is relatively immune for malaria"},{"label":"B","text":"Renal failure is common in children with malaria"},{"label":"C","text":"Pulmonary oedema is common in children with severe malaria"},{"label":"D","text":"Anemia malaria is less common in young children TRUE FALSE QUESTIONS Write “T” against a true statements and “F” against a false statement 1 mark for correct answer 1⁄2 a mark will be deducted from a wrongly marked statement"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["answer_text_in_option","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-01ffd28fde15","stem":"Malaria is very common in children under the age of five years. About malarial anemia.","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"....Occurs due to increased rate of erythrocyte destruction"},{"label":"B","text":"....Cytokines depress erythropoiesis"},{"label":"C","text":"....Iron sequestration is present"},{"label":"D","text":"....Red blood cells are rapidly removed from the circulation"},{"label":"E","text":"....Immune mediated hemolysis takes place"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-641d884413ed","stem":"About a baby born to a diabetic mother","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"...May develop hypoglycaemia within 24 – 48 hours after delivery"},{"label":"B","text":"...Congenital malformations are not common"},{"label":"C","text":"...Cardiomyopathy may occur"},{"label":"D","text":"....Most Babies are born with low weight"},{"label":"E","text":"...They have increased risk of neural tube defect"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"8fb9f34ce1746e1ec8c0ca1d1deff06bb8bf7926"},{"id":"q-7c268fd77276","stem":"Organophosphate is an insecticide widely used. Children are poisoned through direct contact and ingestion.","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"...Act by inhibiting the enzyme cholinesterase"},{"label":"B","text":"...Accumulation of acetylcholine leads to symptoms of toxicity."},{"label":"C","text":"...Bronchial secretions is reduced"},{"label":"D","text":"...There is constrictions of pupils"},{"label":"E","text":"...Muscle fasciculations is not common"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-8ad8e5339dbc","stem":"Hydrocephalus is abnormally large head due to excessive accumulation of cerebral spinal fluid; due to either impaired circulation, impaired absorption of cerebral spinal fluid and increased production. The following are true on the management of hydrocephalus.","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"....Acetazolamide is used to decrease the rate of CSF production\\"},{"label":"B","text":"....Medicine treatment is the best option"},{"label":"C","text":"....Ventriculo-peritoneal shunt can be used as a surgical management"},{"label":"D","text":"....Shunt infection is not a common complication of surgery"},{"label":"E","text":"....Ventriculitis is one of the complications"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-349e70f7e7dc","stem":"About intestinal worms","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"...Enterobias vermicularis lay eggs at night at perineum"},{"label":"B","text":"...Ascaris eggs can survive for one year"},{"label":"C","text":"...Strongiloides stercolaris lie eggs within large intestine"},{"label":"D","text":"...Schistosoma haematobium can be treated by using mebendazole."},{"label":"E","text":"...Hookworm cannot penetrate intact skin"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-7cabf67844a0","stem":"Syphilis is sexual transmitted disease caused by Treponema pallidum. About clinical presentation of congenital syphilis.","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"...50% are asymptomatic"},{"label":"B","text":"...May present with hepatosplenomegaly"},{"label":"C","text":"...Babies may have haemorrhagic rhinitis"},{"label":"D","text":"...Placentomegaly is uncommon"},{"label":"E","text":"...Mental retardation may occur"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-e5f98f0c19b3","stem":"Concerning problems of prematurity","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"...Respiratory distress is common because of less surfactant"},{"label":"B","text":"...Jaundice rarely occurs in preterm babies"},{"label":"C","text":"...Intraventricular hemorrhage may occur"}