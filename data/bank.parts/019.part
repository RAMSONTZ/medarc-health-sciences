s and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"They should be almost equal"},{"label":"B","text":"CSF Glucose should be between 50 – 75%of Blood Glucose"},{"label":"C","text":"There is no Glucose in the CSF"},{"label":"D","text":"CSF Glucose should be less than 30% of Blood Glucose"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5d9c2bdb3315","stem":"The following diseases belong to the group of “ atopic diseases” EXCEPT","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Asthma"},{"label":"B","text":"Bronchiolitis"},{"label":"C","text":"Allergic Rhinitis"},{"label":"D","text":"Atopic Dermatitis/ Eczema"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"d5b5056bddbd9662988674820623c4b8c34a208d"},{"id":"q-31175676f4ec","stem":"A child with a positive Bloodslide for Malaria parasites and Hemoglobinuria should be treated","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"as severe Malaria with Quinine"},{"l