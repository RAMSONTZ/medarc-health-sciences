 this boy is","type":"Single Best Answer MCQ","subject":"Ophthalmology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Carbamazepine"},{"label":"B","text":"Phenobarbitone"},{"label":"C","text":"Phenytoin"},{"label":"D","text":"Sodium Valproate"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Ophthalmology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"],"duplicateStemGroup":"45f5ccaf11fb0b0e95b3e3912563d37efc766d3b"},{"id":"q-793c4be67d0f","stem":"Which of the following is a WHO Clinical Stage 4 illness?","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Recurrent severe pneumonia"},{"label":"B","text":"Oesophageal candidiasis"},{"label":"C","text":"Molluscum contagiosum"},{"label":"D","text":"None of the above"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8d61517796a9","stem":"Tooth eruption generally occurs at what age?","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"2 months"},{"label":"B","text":"2-4 months"},{"label":"C","text":"10-14 months"},{"label":"D","text":"6-8 months"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-930fdeb26fe4","stem":"In tuberculous meningitis in childhood","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The mantoux reaction is negative"},{"label":"B","text":"The CSF glucose level is characteristically reduced"},{"label":"C","text":"The CSF reaction consists mainly of polymorphs"},{"label":"D","text":"Rifampicin is not a useful drug for treating this condition"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1dc64795ada2","stem":"The following statement is true concerning rheumatic fever","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The attack occurs commonly during the first year of life"},{"label":"B","text":"The disease characteristically follows an infection with streptococcal viridans"},{"label":"C","text":"Steroid therapy can affect the likelihood of permanent heart damage"},{"label":"D","text":"The disease follows an infection with β- hemolytic streptococcus GroupA"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"has