ed Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-c1c2c0e62738","stem":"mosome karyotype? ductive age","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-d67bdb5d9438","stem":"when universal screening of low-risk pregnancies will be appropriate.","type":"Short Answer","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-32da744519b1","stem":"when CVS is performed at the usual gestational ages, i.e., after 9 wk. There","type":"OSCE / Practical Station","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-71b1faa68c00","stem":"state. Carriers run the risk of developing cirrhosis or hepatocellular carci","type":"Short Answer","subject":"Internal Medicine","topic":"Gastroenterology and Hepatology","topicOriginal":"Gastroenterology and Hepatology","subtopic":"Cirrhosis","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Gastroenterology and Hepatology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-824538e59bdc","stem":"test negative?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["short_or_incomplete_stem","subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["short_or_incomplete_stem","short_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-3232323e9448","stem":"test, what percentage of people would actually have the disease? By and","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-8cc28266ad44","stem":"which of the following hematologic","type":"Short Answer","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b5a169421eb0","stem":"which increases the risk of neonatal hyperbilirubinemia. Nitrofurantoin may","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-607802a0ccf5","stem":"when there is a different father, which points toward an immunologic eti","type":"Short Answer","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-42aa70e571af","stem":"advanced-gestational-age fetus?","type":"OSCE / Practical Station","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-0240588218a4","stem":"which in the past was associated with depressed fetuses with low Apgar","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-c6a8b5c41b10","stem":"when the fetus is likely to have a serious metabolic compromise at birth (e.g.","type":"Short Answer","subject":"Medical Biochemistry","topic":"Metabolism · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Metabolism","options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Metabolism · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9a66ace13641","stem":"which causes milk to be expressed from the alveoli into the lactiferous","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-4e1b4cfdcb6e","stem":"After an initial pregnancy resulted in a spontaneous loss in the first trimester, your patient is concerned about the possibility of this recurring. Which of the following is an appropriate answer regarding the chance of recurrence?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"It depends on the genetic makeup of the prior abortus"},{"label":"B","text":"It is no different than it was prior to the miscarriage"},{"label":"C","text":"It is increased to approximately 50%"},{"label":"D","text":"It is increased most likely to greater than 50%"},{"label":"E","text":"It depends on the sex of the prior abortus"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3ee9f222fc73","stem":"A 24-year-old woman has had three first-trimester spontaneous abor- tions. Which of the following statements concerning chromosomal aberra- tions in abortions is true?","type":"Single Best Answer MCQ","subject":"Medical Genetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"45,X is more prevalent in chromosomally abnormal term babies than in abortus products"},{"label":"B","text":"Approximately 20% of first-trimester spontaneous abortions have chromoso- mal abnormalities"},{"label":"C","text":"Trisomy 21 is the most common trisomy in abortuses"},{"label":"D","text":"Despite the relatively high frequency of Down syndrome at term, most Down fetuses abort spontaneously"},{"label":"E","text":"Stillbirths have twice the incidence of chromosomal abnormalities as live births 1 Copyright © 2006 by The McGraw-Hill Companies, Inc. Click here for terms of use. 2 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Genetics","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","source_attribution_in_option","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"91b6e001281b868978f0b1a0bb8bbd9cc4ac8a8d"},{"id":"q-a99cea62605c","stem":"A 29-year-old G3P0 presents to your office for preconception counsel- ing. All of her pregnancies were lost in the first trimester. She has no sig- nificant past medical or past surgical history. She should be counseled that without evaluation and treatment her chance of having a live birth is which of the following?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"<20%"},{"label":"B","text":"20 to 35%"},{"label":"C","text":"40 to 50%"},{"label":"D","text":"70 to 85%"},{"label":"E","text":">85%"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b5fa7a6792e0","stem":"A 26-year-old G3P0030 has had three consecutive spontaneous abor- tions in the first trimester. As part of an evaluation for this problem, which of the following tests is most appropriate in the evaluation of this patient?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Hysterosalpinogram"},{"label":"B","text":"Chromosomal analysis of the couple"},{"label":"C","text":"Cervical biopsy in the luteal phase"},{"label":"D","text":"Postcoital test"},{"label":"E","text":"Cervical length by ultrasonography"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-78e2d10708e5","stem":"A 30-year-old G1P0 at 8 weeks gestation presents for her first prenatal visit. She has no significant past medical or surgical history. A friend of hers just had a baby with Down syndrome. The patient denies any family his- tory of genetic disorders or birth defects. You should tell her that she has an increased risk of having a baby with Down syndrome in which of the following circumstances?","type":"OSCE / Practical Station","subject":"Medical Genetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The age of the father of the baby is 40 years or older"},{"label":"B","text":"Her pregnancy has been achieved by induction of ovulation by menotropins (e.g., Follistin, Gonal-F)"},{"label":"C","text":"She has an incompetent cervix"},{"label":"D","text":"She has a luteal phase defect"},{"label":"E","text":"She has had three first-trimester spontaneous abortions Preconception Counseling, Genetics, and Prenatal Diagnosis 3"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Genetics","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-ec1f5cab39f9","stem":"A 20-year-old female presents to your office for routine well-woman examination. She has a history of acne, for which she takes minocycline and isotretinoin on a daily basis. She also has a history of epilepsy that is well controlled on valproic acid. She also takes a combined oral contraceptive birth control pill containing norethindrone acetate and ethinyl estradiol. She is a nonsmoker but drinks alcohol on a daily basis. She is concerned about the effectiveness of her birth control pill, given all the medications that she takes. She is particularly worried about the effects of her medica- tions on a developing fetus in the event of an unintended pregnancy. Which of the following drugs has the lowest potential to cause birth defects?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Endocrine Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Endocrine Pharmacology","options":[{"label":"A","text":"Alcohol"},{"label":"B","text":"Isotretinoin (Accutane)"},{"label":"C","text":"Tetracyclines"},{"label":"D","text":"Progesterones"},{"label":"E","text":"Valproic acid (Depakote)"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrine Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-027d99c1a958","stem":"A 24-year-old woman is in a car accident and is taken to an emergency room, where she receives a chest x-ray and a film of her lower spine. It is later discovered that she is 10 weeks pregnant. Which of the following is the most appropriate statement to make to the patient?","type":"Radiological Interpretation","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"The fetus has received 50 rads"},{"label":"B","text":"Either chorionic villus sampling (CVS) or amniocentesis is advisable to check for fetal chromosomal abnormalities"},{"label":"C","text":"At 10 weeks, the fetus is particularly susceptible to derangements of the central nervous system"},{"label":"D","text":"The fetus has received less than the assumed threshold for radiation damage"},{"label":"E","text":"The risk that this fetus will develop leukemia as a child is raised 4 Obstetrics and Gynecology"}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-15f09842443d","stem":"One of your patients, a 25-year-old G0, comes to your office for pre- conception counseling. She is a long-distance runner and wants to con- tinue to train during her pregnancy. This patient wants to know whether there are any potential adverse effects to her fetus if she pursues a program of regular exercise throughout gestation. You advise her of which of the fol- lowing true statements regarding exercise and pregnancy?","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"During pregnancy, women should stop exercising because such activity is com- monly associated with intrauterine growth retardation in the fetus"},{"label":"B","text":"Exercise is best performed in the supine position to maximize venous return and cardiac output"},{"label":"C","text":"It is acceptable to continue to exercise throughout pregnancy as long as the maternal pulse does not exceed 160"},{"label":"D","text":"Non-weight-bearing exercises are optimal because they minimize the risks of maternal and fetal injuries"},{"label":"E","text":"Immediately following delivery, patients can continue to exercise at prepreg- nancy levels"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5b25c1590988","stem":"year-old husband. She has a sonogram performed at 7 to 12 weeks ges- tational age that shows a quintuplet pregnancy. A 5-mm nuchal translu- cency is discovered in one of the embryos. Implications of this include which of the following?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"The embryo has a high risk of neural tube defect"},{"label":"B","text":"The embryo has a high risk of cardiac malformation"},{"label":"C","text":"The nuchal translucency will enlarge by 20 weeks"},{"label":"D","text":"If the nuchal translucency resolves, the risk of a chromosome abnormality is comparable to that of other embryos"},{"label":"E","text":"If the embryo is aneuploid, the most likely diagnosis is Turner syndrome Preconception Counseling, Genetics, and Prenatal Diagnosis 5"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-bbc9082811b9","stem":"Your patient presents for preconception counseling. She is 27 years old and has never been pregnant. Her husband is an achondroplastic dwarf. Which of the following statements is true regarding achondroplasia?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"The inheritance pattern is autosomal recessive"},{"label":"B","text":"It is rarely caused by a new genetic mutation"},{"label":"C","text":"Affected women have a low incidence of cesarean section"},{"label":"D","text":"Affected women rarely live to reproductive age"},{"label":"E","text":"Spinal cord compression is common"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9c41ead0f29a","stem":"A 25-year-old G3P0 presents for preconception counseling. She has had three first-trimester pregnancy losses. As part of her evaluation for recurrent abortion, she had karyotyping done on herself and her husband. Her hus- band is 46,XY. She was found to carry a balanced 13;13 translocation. What is the likelihood that her next baby will have an abnormal karyotype?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"<5%"},{"label":"B","text":"10%"},{"label":"C","text":"25%"},{"label":"D","text":"50%"},{"label":"E","text":"100% 6 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-6834a25bf835","stem":"A 31-year-old G1P0 presents to your office at 22 weeks gestation for a second opinion. She was told that her baby has a birth defect. She has copies of the ultrasound films and asks you to review them for her. The ultrasound image below shows the birth defect. Which of the following is the most likely defect?","type":"OSCE / Practical Station","subject":"Radiography and Medical Imaging","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A cystic hygroma"},{"label":"B","text":"An encephalocele"},{"label":"C","text":"Hydrocephaly"},{"label":"D","text":"Anencephaly"},{"label":"E","text":"An oomphalocele Preconception Counseling, Genetics, and Prenatal Diagnosis 7"}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Radiography and Medical Imaging","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-8ccdb7ab9f47","stem":"A 24-year-old white woman has a maternal serum α-fetoprotein (MSAFP) at 17 weeks gestation of 6.0 multiples of the median (MOM). Which of the following is the most appropriate next step in management?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A second MSAFP test"},{"label":"B","text":"Ultrasound examination"},{"label":"C","text":"Amniocentesis"},{"label":"D","text":"Amniography"},{"label":"E","text":"Recommendation of termination"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-623ecef3af2a","stem":"A 40-year-old woman pregnant at 6 weeks gestation presents to your office for prenatal care. She is interested in prenatal testing for genetic abnormalities. She read on the Internet that an ultrasound measurement of the neck of the fetus can be used in prenatal diagnosis. Which of the fol- lowing is correct information to tell your patient regarding ultrasound measurement of the fetal nuchal translucency for prenatal diagnosis?","type":"OSCE / Practical Station","subject":"Radiography and Medical Imaging","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It is a simple way to screen for Turner’s syndrome"},{"label":"B","text":"It can be performed by anyone trained in basic fetal ultrasonography"},{"label":"C","text":"It should be offered only to pregnant women under the age of 35"},{"label":"D","text":"It can be performed at any gestational age"},{"label":"E","text":"It is a screening test for Down syndrome performed between 10 and 13 weeks of pregnancy"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Radiography and Medical Imaging","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0e6b977653c1","stem":"A 41-year-old had a baby with Down syndrome 10 years ago. She is anxious to know the chromosome status of her fetus in her current preg- nancy. Which of the following tests has the fastest lab processing time for karyotype?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Amniocentesis"},{"label":"B","text":"Maternal serum screen"},{"label":"C","text":"Chorionic villus sampling (CVS)"},{"label":"D","text":"Doppler flow ultrasound"},{"label":"E","text":"Cystic hygroma aspiration"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6830fc8c9edf","stem":"A 39-year-old wants first-trimester prenatal diagnosis. Which of the following is an advantage of amniocentesis over CVS?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Amniocentesis can be performed earlier in pregnancy"},{"label":"B","text":"Amniocentesis is usually less painful"},{"label":"C","text":"Second-trimester diagnosis allows for safer termination of pregnancy when ter- mination is chosen by the patient"},{"label":"D","text":"CVS has a higher complication rate than midtrimester amniocentesis"},{"label":"E","text":"CVS has a higher complication rate than first-trimester amniocentesis 8 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-36ca95d969aa","stem":"A patient presents for prenatal care in the second trimester. She was born outside the United States and has never had any routine vaccinations. Which of the following vaccines is contraindicated in pregnancy?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Hepatitis A"},{"label":"B","text":"Tetanus"},{"label":"C","text":"Typhoid"},{"label":"D","text":"Hepatitis B"},{"label":"E","text":"Measles"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6a4e43cd6e5d","stem":"During preconception counseling, a woman has a question for you regarding immunizations. Correct advice for this patient includes which of the following?","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Inactivated vaccines are hazardous to the mother"},{"label":"B","text":"Congenital rubella syndrome is common in fetuses born to mothers who were immunized early in pregnancy for rubella"},{"label":"C","text":"Inactivated vaccines are hazardous to the fetus"},{"label":"D","text":"The polio virus has the ability to spread from a vaccinated individual to sus- ceptible persons in the immediate environment"},{"label":"E","text":"Hepatitis B vaccine crosses the placenta and causes neonatal jaundice"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-430089ba2774","stem":"A patient presents to your office at term with no prenatal care. An ultrasound is ordered and shows the fetus to have multiple congenital anomalies, including microcephaly, cardiac anomalies, and growth retarda- tion. You should question the patient if she has abused which of the fol- lowing substances during her pregnancy?","type":"Radiological Interpretation","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Amphetamines"},{"label":"B","text":"Barbiturates"},{"label":"C","text":"Heroin"},{"label":"D","text":"Methadone"},{"label":"E","text":"Alcohol"}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-3dc81ef2c7b5","stem":"Your 25-year-old patient is pregnant at 36 weeks gestation. She has an acute urinary tract infection. Which of the following medications is contraindicated in the treatment of the UTI in this patient?","type":"OSCE / Practical Station","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ampicillin"},{"label":"B","text":"Nitrofurantoin"},{"label":"C","text":"Bactrim"},{"label":"D","text":"Keflex"},{"label":"E","text":"Augmentin Preconception Counseling, Genetics, and Prenatal Diagnosis 9"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-c232f6d17754","stem":"You diagnose a 21-year-old woman at 12 weeks gestation with gonor- rhea cervicitis. Which of the following is the most appropriate treatment for her infection?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Doxycycline"},{"label":"B","text":"Chloramphenicol"},{"label":"C","text":"Tetracycline"},{"label":"D","text":"Minocycline"},{"label":"E","text":"Ceftriaxone"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-702212f466c8","stem":"You see a healthy 40-year-old multiparous patient for preconception counseling. She is extremely worried about her risk of having a baby with spina bifida. Five years ago, this patient delivered a baby with anencephaly who died shortly after birth. How should you counsel this woman regard- ing future pregnancies?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"She does not have a recurrence risk of a neural tube defect above that of the general population"},{"label":"B","text":"She has an increased risk of having another baby with anencephaly because she is over 35 years old"},{"label":"C","text":"When she becomes pregnant, she should undergo diagnostic testing for fetal neural tube defects with a first-trimester chorionic villus sampling"},{"label":"D","text":"When she becomes pregnant, she should avoid hyperthermia in the first trimester because both maternal fevers and the use of hot tubs have been asso- ciated with an increased risk of neural tube defects"},{"label":"E","text":"She has a recurrence risk of having another baby with a neural tube defect of less than 1%"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6f0dae58a609","stem":"A 36-year-old G1 undergoes a triple screen test at 16 weeks of preg- nancy to evaluate her risk of having a baby with Down syndrome because she is worried about being of “advanced maternal age.” Her maternal serum AFP level comes back elevated. This patient is extremely concerned and comes into your office to get additional counseling and recommenda- tions. Which of the following is the best advice to give this patient?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"An elevated serum AFP level indicates that she is at risk for having a baby with Down syndrome"},{"label":"B","text":"An ultrasound should be performed to confirm the gestational age of the fetus and to rule out any fetal anomalies"},{"label":"C","text":"She is probably going to have twins"},{"label":"D","text":"Unexplained elevated MSAFP levels have no prognostic value for her pregnancy"},{"label":"E","text":"Most women who have an elevated MSAFP have a fetus with a neural tube defect 10 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-4a2e40df4108","stem":"An obese, 25-year-old G1P0 comes to your office at 8 weeks gesta- tional age for her first prenatal visit. She is delighted to be pregnant and wants to do whatever is necessary to ensure a healthy pregnancy. She is currently 5 ft 2 in. tall and weighs 300 lb. She is concerned because she is overweight and wants you to help her with a strict exercise and diet regi- men so that she can be more healthy during the pregnancy. Which of the following should you tell your patient regarding obesity and pregnancy?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Marked obesity in pregnancy decreases the risk of developing diabetes, hyper- tension, and fetal macrosomia"},{"label":"B","text":"She should gain at least 25 lb during the pregnancy because nutritional depri- vation can result in impaired fetal brain development and intrauterine fetal growth retardation"},{"label":"C","text":"Obese women will still have adequate fetal growth in the absence of any weight gain during pregnancy"},{"label":"D","text":"She should immediately initiate a vigorous exercise program to get in shape"},{"label":"E","text":"Being obese places her at a decreased risk of needing a cesarean section for delivery"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b0878ec452e7","stem":"A 26-year-old G1P1 comes to see you in your office for preconception counseling because she wants to get pregnant again. She denies a history of any illegal drug use but admits to smoking a few cigarettes each day and occasionally drinking some beer. When you advise her not to smoke or drink at all during this pregnancy, she gets defensive because she smokes and drinks very little, and she did the same during her previous pregnancy 2 years ago and her baby was just fine. Which of the following statements is true regarding the effects of tobacco and alcohol on pregnancy?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Small amounts of alcohol, such as a glass of wine or beer a day at dinnertime, are safe; only binge drinking of large amounts of alcohol has been associated with fetal alcohol syndrome"},{"label":"B","text":"Fetal alcohol syndrome can be diagnosed prenatally via identifying fetal anom- alies on sonogram done antenatally"},{"label":"C","text":"Cigarette smoking is associated with an increased risk of spontaneous abortion"},{"label":"D","text":"In most studies, cigarette smoking has been associated with an increased risk of congenital anomalies"},{"label":"E","text":"Tobacco use in pregnancy is a common cause of mental retardation and devel- opmental delay in neonates Preconception Counseling, Genetics, and Prenatal Diagnosis 11"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"03bc3649d775beb85e35fbae913d970c69c4ecbe"},{"id":"q-625498fe15a0","stem":"A 36-year-old G0 who has been epileptic for many years is contem- plating pregnancy. She wants to go off her phenytoin because she is con- cerned about the adverse effects that this medication may have on her unborn fetus. She has not had a seizure in the past five years. Which of the following is the most appropriate statement to make to the patient?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Babies born to epileptic mothers have an increased risk of structural anomalies even in the absence of anticonvulsant medications"},{"label":"B","text":"She should see her neurologist to change from phenytoin to valproic acid because valproic acid is not associated with fetal anomalies"},{"label":"C","text":"She should discontinue her phenytoin because it is associated with a 1 to 2% risk of spina bifida"},{"label":"D","text":"Vitamin C supplementation reduces the risk of congenital anomalies in fetuses of epileptic women taking anticonvulsants"},{"label":"E","text":"The most frequently reported congenital anomalies in fetuses of epileptic women are limb defects"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ba76aba551df","stem":"A patient who works as a nurse in the surgery intensive care unit at a local community hospital comes to see you for her annual gynecologic exam. She tells you that she plans to go off her oral contraceptives because she plans to attempt pregnancy in the next few months. This patient has many questions regarding updating her immunizations and whether or not she can do this when pregnant. Which of the following is the most appro- priate recommendation?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"The patient should be checked for immunity against the rubella (German measles) virus prior to conception because the rubella vaccine contains a live virus and should not be given during pregnancy"},{"label":"B","text":"The patient should be given the tetanus toxoid vaccination prior to becoming pregnant because it is a live virus vaccine that has been associated with multi- ple fetal anomalies when administered during pregnancy"},{"label":"C","text":"The Centers for Disease Control and Prevention recommends that all pregnant women should be vaccinated against the influenza virus during the first trimester"},{"label":"D","text":"If she is exposed to chicken pox while she is pregnant she can be immunized at that time since the chicken pox vaccine is safe during pregnancy"},{"label":"E","text":"Because of her occupation, the patient is at high risk for hepatitis B; she should complete the hepatitis B vaccination series before she conceives, since that vac- cine has been associated with neonatal jaundice 12 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-bcc19a78cf59","stem":"A patient comes to see you in the office because she has just missed her period and a home urine pregnancy test reads positive. She is extremely worried because last week she had a barium enema test done as part of a workup for blood in her stools. She is also concerned because her job requires her to sit in front of a computer screen all day and she uses the microwave oven on a regular basis. The patient is concerned regarding the deleterious effects of radiation exposure on her fetus. Which of the follow- ing statements is true regarding the effects of exposure to radiation and electromagnetic fields during pregnancy?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"There is ample evidence in humans and animals that exposure to electromag- netic fields such as from high-voltage power lines, electric blankets, microwave ovens, and cellular phones causes adverse fetal outcomes"},{"label":"B","text":"There are documented adverse fetal effects with exposure to radiation doses of less than 5 rads"},{"label":"C","text":"A single diagnostic procedure, such as a barium enema, results in a radiation dose that will adversely affect the embryo or fetus"},{"label":"D","text":"There is no consistent data that exposure to radiation used for a single diagnos- tic study is associated with an increased risk of childhood leukemia in the fetus"},{"label":"E","text":"There is an increased risk of mental retardation when radiation exposure occurs at less than 8 weeks, even with low doses of radiation"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c8848e3cc537","stem":"A Jewish couple comes in to see you for preconception counseling. They are concerned that they might be at an increased risk of certain genetic diseases because of their ethnic background. The woman is 38 years old and tells you that in neither side of the family is there a family history of any genetic disorders. Which one of the following statements is a correct rec- ommendation for this couple?","type":"Single Best Answer MCQ","subject":"Medical Genetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"They are at an increased risk of having a β thalassemia, and they should both undergo screening tests with a hemoglobin electrophoresis prior to conception"},{"label":"B","text":"They are at an increased risk of having a baby born with a neural tube defect and should undergo amniocentesis in the second trimester of pregnancy for a definitive diagnosis"},{"label":"C","text":"They do not need to undergo screening for Tay-Sachs disease if there is no his- tory of affected children in their families"},{"label":"D","text":"The American College of Obstetrics and Gynecology recommends that all Jew- ish couples be screened for cystic fibrosis"},{"label":"E","text":"Canavan’s disease has a carrier frequency of 1 in 40 in the Jewish population, and the couple therefore should be screened for this genetic disease prior to conception Preconception Counseling, Genetics, and Prenatal Diagnosis 13"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Genetics","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"1fab899d409cc0af034839b7b0708c964771025e"},{"id":"q-68dc784c96f4","stem":"You have a patient who is very health-conscious and regularly ingests a large number of vitamins in megadoses and herbal therapies on a daily basis. She is a strict vegetarian as well. She is going to attempt pregnancy and wants your advice regarding her diet and nutrition intake. Which of the following is true regarding diet recommendations in pregnancy?","type":"Single Best Answer MCQ","subject":"Nutrition and Dietetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Because herbal medications are natural, there is no reason to avoid these dietary supplements in pregnancy"},{"label":"B","text":"It is recommended that in pregnancy the majority of the protein consumed be supplied from animal sources"},{"label":"C","text":"Routine supplementation of vitamin A is necessary during pregnancy because dietary intake alone does not provide sufficient amounts needed during pregnancy"},{"label":"D","text":"During pregnancy, vegetarians obtain sufficient amounts of vitamin B12 in their diet needed for the fetus"},{"label":"E","text":"Vitamin C supplementation in pregnancy is to be avoided because excessive levels can result in fetal malformations"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Nutrition and Dietetics","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"71dbd9ed2c120e3aafbe85c4db4146786031dccc"},{"id":"q-057a58d76419","stem":"A patient of yours has a history of multiple substance abuse. She is now pregnant again and tells you that she has a 2-year-old little boy who is slow in school and has difficulty concentrating. Which of the following substances has been associated with behavioral and developmental abnor- malities in children?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Tobacco"},{"label":"B","text":"Cocaine"},{"label":"C","text":"Caffeine"},{"label":"D","text":"Marijuana"},{"label":"E","text":"LSD 14 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-ded46cd38aa4","stem":"A 20-year-old G2P1 patient comes to see you at 17 weeks gestational age to review the results of her triple test done 1 week ago. You tell the patient that her MSAFP level is 2.0 MOM. The patient’s obstetrical history consists of a term vaginal delivery 2 years ago without complications. Which of the following is correct advice for your patient regarding how to proceed next?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Explain to the patient that the blood test is diagnostic of a neural tube defect and she should consult with a pediatric neurosurgeon as soon as possible"},{"label":"B","text":"Tell the patient that the blood test result is most likely a false-positive result and she should repeat the test at 20 weeks"},{"label":"C","text":"Refer the patient for an ultrasound to confirm dates"},{"label":"D","text":"Offer the patient immediate chorionic villus sampling to obtain a fetal karyotype"},{"label":"E","text":"Recommend to the patient that she undergo a cordocentesis to measure fetal serum AFP levels"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4f11da57738c","stem":"You see a 42-year-old patient in your office who is now 5 weeks preg- nant with her fifth baby. She is very concerned regarding the risk of Down syndrome because of her advanced maternal age. After extensive genetic counseling, she has decided to undergo a second-trimester amniocentesis to determine the karyotype of her fetus. You must obtain informed consent prior to the procedure. During your discussion you should tell the patient which of the following?","type":"Single Best Answer MCQ","subject":"Medical Genetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Transient leakage of amniotic fluid is common after amniocentesis so she should not be concerned if she notices a watery vaginal discharge for a few days"},{"label":"B","text":"Chorioamnionitis, although an uncommon complication of amniocentesis, can be treated with broad spectrum oral antibiotics"},{"label":"C","text":"Fetal loss rate after amniocentesis is around 5%"},{"label":"D","text":"Amniocentesis has not been associated with fetal limb reduction defects"},{"label":"E","text":"Karyotyping may not be possible as cell culture failure of the amniocytes occurs frequently Preconception Counseling, Genetics, and Prenatal Diagnosis 15 DIRECTIONS: Each group of questions below consists of lettered options followed by a set of numbered items. For each numbered item, select the one lettered option with which it is most closely associated. Each lettered option may be used once, more than once, or not at all. Questions 34–37 Match each clinical situation described, with the appropriate inheri- tance pattern."},{"label":"A","text":"Autosomal dominant"},{"label":"B","text":"Autosomal recessive"},{"label":"C","text":"X-linked recessive"},{"label":"D","text":"Codominant"},{"label":"E","text":"Multifactorial"}],"priority":1,"status":"review","flags":["topic_generic","too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Genetics","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","long_option_manual_review","nonunique_option_labels","prior_structural_review_flag","too_many_options","too_many_options_possible_merge","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-7d2fa5da7c51","stem":"Your patient’s father was just diagnosed with dementia associated with emotional disturbances and choreic body movements. She was told his dis- ease is hereditary. 16 Obstetrics and Gynecology Questions 38–46 For each ultrasonogram, select one diagnosis or diagnostic indicator.","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Obstructed urethra and bladder"},{"label":"B","text":"Nonspinal marker for spina bifida"},{"label":"C","text":"Indication of highest likelihood of a chromosomal abnormality"},{"label":"D","text":"Marker for Down syndrome (trisomy 21)"},{"label":"E","text":"Common marker for trisomies 18 and 21"},{"label":"F","text":"Osteogenesis imperfecta"},{"label":"G","text":"Mesomelic dwarfism"},{"label":"H","text":"Anencephaly i. Prune belly syndrome j. Hydrocephalus k. Spina bifida with meningocele 38. Preconception Counseling, Genetics, and Prenatal Diagnosis 17 39. 40. 18 Obstetrics and Gynecology 41. 42. Preconception Counseling, Genetics, and Prenatal Diagnosis 19 43. 44. 20 Obstetrics and Gynecology 45. 46. Preconception Counseling, Genetics, and Prenatal Diagnosis 21 Questions 47–50 Match the appropriate scenario with the antibiotic most likely respon- sible for the clinical findings presented."},{"label":"A","text":"Tetracycline"},{"label":"B","text":"Streptomycin"},{"label":"C","text":"Nitrofurantoin"},{"label":"D","text":"Chloramphenicol"},{"label":"E","text":"Sulfonamides"}],"priority":1,"status":"review","flags":["topic_generic","too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","long_option_manual_review","nonunique_option_labels","prior_structural_review_flag","too_many_options","too_many_options_possible_merge","topic_generic"],"cleaningOperations":["option_whitespace_normalization","whitespace/page_marker_normalization"]},{"id":"q-1675a8d16abf","stem":"A 2-week-old neonate who delivered at 28 weeks gestation developed pallid cyanosis, abdominal distension, and vascular collapse after exposure to an antibiotic. A few days later the baby died. 22 Obstetrics and Gynecology Questions 51–55 For each disease, select the recommendation regarding vaccination during pregnancy with which it is most likely to be associated.","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Recommended if the underlying disease is serious"},{"label":"B","text":"Recommended after exposure or before travel to endemic areas"},{"label":"C","text":"Not routinely recommended, but mandatory during an epidemic"},{"label":"D","text":"Contraindicated unless exposure to the disease is unavoidable"},{"label":"E","text":"Contraindicated"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-c9d785758d07","stem":"A 29-year-old caucasian primigravid patient is 20 weeks pregnant with twins. She found out today on her routine ultrasound for fetal anatomy that she is carrying two boys. In this patient’s case, which of the following state- ments about twinning is true?","type":"Radiological Interpretation","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"The twins must be monozygotic since they are both males"},{"label":"B","text":"If division of these twins occurred after formation of the embryonic disk the twins will be conjoined"},{"label":"C","text":"She has a higher incidence of having monzygotic twins since she is caucasian"},{"label":"D","text":"If the ultrasound showed two separate placentas, the twins must be dizygotic"},{"label":"E","text":"Twinning causes no appreciable increase in maternal morbidity and mortality over singleton pregnancies"}],"priority":1,"status":"review","flags":["requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-283e42b4d075","stem":"A 24-year-old primigravida with twins presents for routine ultrason- ography at 20 weeks gestation. Based on the ultrasound findings, the pa- tient is diagnosed with dizygotic twins. Which of the following is true regarding the membranes and placentas of dizygotic twins?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"They are dichorionic and monoamniotic only if the fetuses are of the same sex"},{"label":"B","text":"They are dichorionic and monoamniotic regardless of the sex of the fetuses"},{"label":"C","text":"They are monochorionic and monoamniotic if they are conjoined twins"},{"label":"D","text":"They are dichorionic and diamniotic regardless of the sex of the twins"},{"label":"E","text":"They are monochorionic and diamniotic if they are of the same sex 39 Copyright © 2006 by The McGraw-Hill Companies, Inc. Click here for terms of use. 40 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["source_attribution_in_option","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-a118ce2c52d7","stem":"After delivery of a term infant with Apgar scores of 2 at one minute and 7 at five minutes, you ask that umbilical cord blood be collected for pH. The umbilical arteries carry which of the following?","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Oxygenated blood to the placenta"},{"label":"B","text":"Oxygenated blood from the placenta"},{"label":"C","text":"Deoxygenated blood to the placenta"},{"label":"D","text":"Deoxygenated blood from the placenta"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ecaef99c3ea9","stem":"During the routine examination of the umbilical cord and placenta after a spontaneous vaginal delivery you notice that the baby had only one umbilical artery. Which of the following is true regarding the finding of a single umbilical artery?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Abdomen","topicOriginal":"Abdomen","subtopic":"Liver","suggestedTopic":null,"options":[{"label":"A","text":"It is a very common finding and is insignificant"},{"label":"B","text":"It is a rare finding in singleton pregnancies and is therefore not significant"},{"label":"C","text":"It is an indicator of an increased incidence of congenital anomalies of the fetus"},{"label":"D","text":"It is equally common in newborns of diabetic and nondiabetic mothers"},{"label":"E","text":"It is present in 5% of all births"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Abdomen","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-4ddf539e5a1e","stem":"A 22-year-old G1P0 at 28 weeks gestation by LMP presents to labor and delivery complaining of decreased fetal movement. She has had no prenatal care. On the fetal monitor there are no contractions. The fetal heart rate is 150 beats per minute and reactive. There are no decelerations in the fetal heart tracing. An ultrasound is performed in the radiology department and shows a 28-week fetus with normal-appearing anatomy and size con- sistent with dates. The placenta is implanted on the posterior uterine wall and its margin is well away from the cervix. A succenturiate lobe of the pla- centa is seen implanted low on the anterior wall of the uterus. Doppler flow studies indicate a blood vessel is traversing the cervix connecting the two lobes. This patient is at risk for which of the following?","type":"OSCE / Practical Station","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Premature rupture of the membranes"},{"label":"B","text":"Fetal exsanguination after rupture of the membranes"},{"label":"C","text":"Torsion of the umbilical cord due to velamentous insertion of the umbilical cord"},{"label":"D","text":"Amniotic fluid embolism"},{"label":"E","text":"Placenta accreta Maternal-Fetal Physiology and Placentation 41"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-10fce204f200","stem":"A healthy 25-year-old G1P0 at 40 weeks gestational age comes to your office to see you for a routine OB visit. The patient complains to you that on several occasions she has experienced dizziness, light-headedness, and feeling as if she is going to pass out when she lies down on her back to take a nap. What is the appropriate plan of management for this patient?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Do an ECG"},{"label":"B","text":"Monitor her for 24 h with a Holter monitor to rule out an arrhythmia"},{"label":"C","text":"Do an arterial blood gas analysis"},{"label":"D","text":"Refer her immediately to a neurologist"},{"label":"E","text":"Reassure her that nothing is wrong with her and encourage her not to lie flat on her back"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"5764010ea6af46fc86eab48e53d82e729e1f8f5a"},{"id":"q-ead0d8ef0594","stem":"A 42-year-old primigravida presents to your office for a routine OB visit at 34 weeks gestational age. She voices concern because she has noticed an increasing number of spidery veins appearing on her abdomen. She is upset with the unsightly appearance of these veins and wants to know what you recommend to get rid of them. Which of the following is the best advice to give this patient?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Tell her that this is not a serious condition and give her a referral to a vascular surgeon to have the veins removed"},{"label":"B","text":"Tell her that you are concerned that she may have serious liver disease and order liver function tests"},{"label":"C","text":"Refer her to a dermatologist for further workup and evaluation"},{"label":"D","text":"Tell her that the appearance of these blood vessels is a normal occurrence with pregnancy and will resolve spontaneously after delivery"},{"label":"E","text":"Recommend that she wear an abdominal support to relieve pressure from her abdomen and cause resolution of the blood vessels 42 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-2c58b04f08e3","stem":"A 32-year-old G2P1001 at 20 weeks gestational age presents to the emergency room complaining of constipation and abdominal pain for the past 24 h. The patient also admits to bouts of nausea and emesis since eat- ing a very spicy meal at a new Thai restaurant the evening before. She denies a history of any medical problems. During her last pregnancy, the patient underwent an elective cesarean section at term to deliver a fetus in the breech presentation. The emergency room doctor who examines her pages you and reports that the patient has a low-grade fever of 100°F, with a normal pulse and blood pressure. She is minimally tender to deep palpa- tion with hypoactive bowel sounds. She has no rebound tenderness. The patient has a WBC of 13,000, and electrolytes are normal. Which of the fol- lowing is the most appropriate next step in the management of this patient?","type":"OSCE / Practical Station","subject":"Emergency Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The history and physical exam are consistent with constipation, which is com- monly associated with pregnancy; the patient should be discharged with reassur- ance and instructions to give herself a soapsuds enema and follow a high-fiber diet with laxative use as needed"},{"label":"B","text":"The patient should be prepped for the operating room immediately to have an emergent appendectomy"},{"label":"C","text":"The patient should be reassured that her symptoms are due to the spicy meal consumed the evening before and should be given Pepto-Bismol to alleviate the symptoms"},{"label":"D","text":"The patient should be sent to radiology for an upright abdominal x-ray"},{"label":"E","text":"Intravenous antiemetics should be ordered to treat the patient’s hyperemesis gravidarum"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Emergency Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-47bcc555af8e","stem":"A healthy 34-year-old G1P0 patient comes to see you in your office for a routine OB visit at 12 weeks gestational age. She tells you that she has stopped taking her prenatal vitamins with iron supplements because they make her sick and she has trouble remembering to take a pill every day. A review of her prenatal labs reveals that her hematocrit is 39%. Which of the following statements is the correct way to counsel this patient?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Tell the patient that she does not need to take her iron supplements because her prenatal labs indicate that she is not anemic and therefore she will not absorb the iron supplied in prenatal vitamins"},{"label":"B","text":"Tell the patient that if she consumes a diet rich in iron, she does not need to take any iron supplements"},{"label":"C","text":"Tell the patient that if she fails to take her iron supplements, her fetus will be anemic"},{"label":"D","text":"Tell the patient that she needs to take the iron supplements even though she is not anemic in order to meet the demands of pregnancy"},{"label":"E","text":"Tell the patient that she needs to start retaking her iron supplements when her hemoglobin falls below 11 g /dL Maternal-Fetal Physiology and Placentation 43"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"7195f4933b030bdabd3f91c1c25dca79b8223bcb"},{"id":"q-b13a84f5309e","stem":"A pregnant patient of yours goes to the emergency room at 20 weeks gestational age with complaints of hematuria and back pain. The emer- gency room physician orders an intravenous pyelogram (IVP) as part of a workup for a possible kidney stone. The radiologist indicates the absence of nephrolithiasis but reports the presence of bilateral hydronephrosis and hydroureter, which is greater on the right side than on the left. Which of the following statements is true regarding this IVP finding?","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"The bilateral hydronephrosis is of concern, and renal function tests, including BUN and creatinine, should be run and closely monitored"},{"label":"B","text":"These findings are consistent with normal pregnancy and are not of concern"},{"label":"C","text":"The bilateral hydronephrosis is of concern, and a renal sonogram should be ordered emergently"},{"label":"D","text":"The findings indicate that a urology consult is needed to obtain recommenda- tions for further workup and evaluation"},{"label":"E","text":"The findings are consistent with ureteral obstruction, and the patient should be referred for stent placement"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7d0811390905","stem":"During a routine return OB visit, an 18-year-old G1P0 patient at 23 weeks gestational age undergoes a urinalysis. The dipstick done by the nurse indicates the presence of trace glucosuria. All other parameters of the urine test are normal. Which of the following is the most likely etiology of the increased sugar detected in the urine?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The patient has diabetes"},{"label":"B","text":"The patient has a urine infection"},{"label":"C","text":"The patient’s urinalysis is consistent with normal pregnancy"},{"label":"D","text":"The patient’s urine sample is contaminated"},{"label":"E","text":"The patient has kidney disease 44 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"37e38344902cd370b3ea9d3397bbe655154633ee"},{"id":"q-562f003db2cf","stem":"A 29-year-old G1P0 patient at 15 weeks gestational age presents to your office complaining of some shortness of breath that is more intense with exertion. She has no significant past medical history and is not on any medication. The patient denies any chest pain but sometimes feels as though her heart is pounding. She is concerned because she has always been very athletic and cannot maintain the same degree of exercise that she was accustomed to prior to becoming pregnant. On physical exam, her pulse is 90/min. Her blood pressure is 90/50. On cardiac exam, a systolic ejection murmur is identified. The lungs are clear to auscultation and per- cussion. Which of the following is the most appropriate next step to pur- sue in the workup of this patient?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Refer the patient for a ventilation-perfusion scan to rule out a pulmonary embolism"},{"label":"B","text":"Perform an arterial blood gas"},{"label":"C","text":"Refer the patient to a cardiologist"},{"label":"D","text":"Reassure the patient"},{"label":"E","text":"Order an ECG DIRECTIONS: Each group of questions below consists of lettered options followed by a set of numbered items. For each numbered item, select the one lettered option with which it is most closely associated. Each lettered option may be used once, more than once, or not at all. Questions 68–70 Match the descriptions with the appropriate placenta type."},{"label":"A","text":"Fenestrated placenta"},{"label":"B","text":"Succenturiate placenta"},{"label":"C","text":"Vasa previa"},{"label":"D","text":"Placenta previa"},{"label":"E","text":"Membranaceous placenta"},{"label":"F","text":"Placenta accreta"}],"priority":1,"status":"review","flags":["topic_generic","too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["duplicate_option_labels","prior_structural_review_flag","too_many_options_possible_merge","topic_generic"],"cleaningOperations":[]},{"id":"q-b7ff6866a9fd","stem":"The shortest distance between the sacral promontory and the sym- physis pubis is called which of the following?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Interspinous diameter"},{"label":"B","text":"True conjugate"},{"label":"C","text":"Diagonal conjugate"},{"label":"D","text":"Obstetric conjugate"},{"label":"E","text":"Biparietal diameter"}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-eaf3bf65c23b","stem":"A patient presents in labor at term. Clinical pelvimetry is performed. She has an oval-shaped pelvis with the anteroposterior diameter at the pelvic inlet greater than the transverse diameter. The baby is occiput pos- terior. The patient most likely has what kind of pelvis?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Pelvis and Perineum","topicOriginal":"Pelvis and Perineum","subtopic":"Pelvi","suggestedTopic":null,"options":[{"label":"A","text":"A gynecoid pelvis"},{"label":"B","text":"An android pelvis"},{"label":"C","text":"An anthropoid pelvis"},{"label":"D","text":"A platypelloid pelvis"},{"label":"E","text":"An androgenous pelvis"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Pelvis and Perineum","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ea90e1a254e8","stem":"On pelvic examination of a patient in labor at 34 weeks, the patient is noted to be 6 cm dilated, completely effaced with the fetal nose and mouth palpable. The chin is pointing toward the maternal left hip. This is an ex- ample of which of the following?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Face","suggestedTopic":null,"options":[{"label":"A","text":"Transverse lie"},{"label":"B","text":"Mentum transverse position"},{"label":"C","text":"Occiput transverse position"},{"label":"D","text":"Brow presentation"},{"label":"E","text":"Vertex presentation 51 Copyright © 2006 by The McGraw-Hill Companies, Inc. Click here for terms of use. 52 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["source_attribution_in_option"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-883930ea4514","stem":"The labor nurse calls you in your office regarding your patient who is 30 weeks pregnant and complaining of decreased fetal movement. The fetus is known to have a ventricular septal defect of the heart. The nurse has performed a nonstress test on the fetus. No contractions are seen. She thinks the tracing shows either a sinusoidal or saltatory fetal heart rate (FHR) pattern. Without actually reviewing the FHR tracing what can you tell the nurse?","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The FHR tracing is probably not a sinusoidal FHR pattern because this pattern can be diagnosed only if the patient is in labor"},{"label":"B","text":"The FHR tracing is probably not a saltatory FHR pattern because this pattern is almost always seen during rather than before labor"},{"label":"C","text":"The FHR tracing of the premature fetus should be analyzed by different criteria than tracings obtained at term"},{"label":"D","text":"Fetuses with congenital anomalies of the heart will invariably exhibit abnormal FHR patterns"},{"label":"E","text":"Neither sinusoidal nor saltatory fetal heart rate patterns are seen in premature fetuses because of the immaturity of their autonomic nervous systems"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-acab5c0d9367","stem":"You are counseling a 24-year-old woman who is a G2P1 at 36 weeks gestation. She delivered her first baby at 41 weeks gestation by cesarean section due to fetal distress that occurred during an induction of labor for mild preeclampsia. She would like to know if she can have a trial of labor with this pregnancy. Which of the following is the best response to this patient?","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"No, since she has never had a vaginal delivery"},{"label":"B","text":"Yes, but only if she had a low transverse cesarean section"},{"label":"C","text":"No, because once she has had a cesarean section she must deliver all of her sub- sequent children by cesarean section"},{"label":"D","text":"Yes, but only if her uterine incision was made in the uterine fundus"},{"label":"E","text":"Yes, but only if she had a classical cesarean section"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b6d178c579b9","stem":"A 32-year-old poorly controlled diabetic G2P1 is undergoing amnio- centesis at 38 weeks for fetal lung maturity prior to having a repeat cesar- ean section. Which of the following laboratory tests performed on the amniotic fluid best indicates that the fetal lungs are mature?","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Phosphatidylglycerol is absent"},{"label":"B","text":"Lecithin/sphingomyelin ratio of 1:1"},{"label":"C","text":"Lecithin/sphingomyelin ratio of 1.5:1"},{"label":"D","text":"Lecithin/sphingomyelin ratio of 2.0:1"},{"label":"E","text":"Shake test is positive Antepartum Care and Fetal Surveillance 53"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-203620ec0522","stem":"A 26-year-old G1P0 patient at 34 weeks gestation is being evaluated with Doppler ultrasound studies of the fetal umbilical arteries. The patient is a healthy smoker. Her fetus has shown evidence of intrauterine growth restriction (IUGR) on previous ultrasound examinations. The Doppler studies currently show that the systolic to diastolic ratio (S/D) in the umbil- ical arteries is much higher than it was on her last ultrasound three weeks ago and there is now reverse diastolic flow. Which of the following is cor- rect information to inform the patient?","type":"OSCE / Practical Station","subject":"Radiography and Medical Imaging","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The Doppler studies indicate that the fetus is doing well"},{"label":"B","text":"With advancing gestational age the S/D ratio is supposed to rise"},{"label":"C","text":"These Doppler findings are normal in someone who smokes"},{"label":"D","text":"Reverse diastolic flow is normal as a patient approaches full term"},{"label":"E","text":"The Doppler studies are worrisome and indicate that the fetal status is deteri- orating"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Radiography and Medical Imaging","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e5337410f68a","stem":"A 17-year-old primipara at 41 weeks wants an immediate cesarean section. She is being followed with biophysical profile testing. You cor- rectly tell her which of the following?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Biophysical profile testing includes amniotic fluid volume, fetal breathing, fetal body movements, fetal body tone, and contraction stress testing"},{"label":"B","text":"The false-negative rate of the biophysical profile is 10%"},{"label":"C","text":"False-positive results on biophysical profile are rare"},{"label":"D","text":"Spontaneous decelerations during biophysical profile testing are associated with significant fetal morbidity"},{"label":"E","text":"A normal biophysical profile should be repeated in 1 week to 10 days in a post- term pregnancy"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-fbb56c0bf304","stem":"A healthy 20-year-old G1P0 presents for her first OB visit at 10 weeks gestational age. She denies any significant medical history both personally and in her family. Which of the following tests is not part of the recom- mended first trimester blood testing for this patient?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Complete blood count (CBC)"},{"label":"B","text":"Screening for human immunodeficiency virus (HIV)"},{"label":"C","text":"Hepatitis B surface antigen"},{"label":"D","text":"Blood type and screen"},{"label":"E","text":"One-hour glucose challenge testing"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f84670bbcabf","stem":"Your patient is a healthy 28-year-old G2P1001 at 20 weeks gestational age. Two years ago, she vaginally delivered at term a healthy baby boy weighing 6 lb 8 oz. This pregnancy, she had a prepregnancy weight of 130 lb. She is 5 ft 4 in. tall. She now weighs 140 lb and is extremely ner- vous that she is gaining too much weight. She is worried that the baby will be too big and require her to have a cesarean section. How do you counsel this patient?","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Her weight gain is excessive, and she needs to be referred for nutritional coun- seling to slow down her rate of weight gain"},{"label":"B","text":"Her weight gain is excessive, and you recommend that she undergo early glu- cola screening to rule out gestational diabetes"},{"label":"C","text":"She is gaining weight at a less than normal rate, and, with her history of a small- for-gestational-age baby, she should supplement her diet with extra calories"},{"label":"D","text":"During the pregnancy she should consume an additional 300 kcal/day versus prepregnancy, and her weight gain so far is appropriate for her gestational age"},{"label":"E","text":"During the pregnancy she should consume an additional 600 kcal/day versus prepregnancy, and her weight gain is appropriate for her gestational age Antepartum Care and Fetal Surveillance 55"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"ee59d5bc824bff49bc88b20ef3e8d650c13b0553"},{"id":"q-4d8e281e9803","stem":"A healthy 31-year-old G3P2002 patient presents to the obstetrician’s office at 34 weeks gestational age for a routine return visit. She has had an uneventful pregnancy to date. Her baseline blood pressures were 100– 110/60–70, and she has gained a total of 20 lb so far. During the visit, the patient complains of bilateral pedal edema that sometimes causes her feet to ache at the end of the day. Her urine dip indicates trace protein, and her blood pressure in the office is currently 115/75. She denies any other symptoms or complaints. On physical exam, there is pitting edema of both legs without any calf tenderness. Which of the following is the most appro- priate response to the patient’s concern?","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Prescribe Lasix to relieve the painful swelling"},{"label":"B","text":"Immediately send the patient to the radiology department to have venous Doppler studies done to rule out deep vein thromboses"},{"label":"C","text":"Admit the patient to L and D to rule out preeclampsia"},{"label":"D","text":"Reassure the patient that this is a normal finding of pregnancy and no treatment is needed"},{"label":"E","text":"Tell the patient that her leg swelling is due to too much salt intake and instruct her to go on a low-sodium diet"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-43e2ebdd9d65","stem":"A 28-year-old G1P0 presents to your office at 18 weeks gestational age for an unscheduled visit secondary to right-sided groin pain. She describes the pain as sharp and occuring with movement and exercise. She denies any change in urinary or bowel habits. She also denies any fever or chills. The application of a heating pad helps alleviate the discomfort. As her obstetrician, what should you tell this patient is the most likely etiology of this pain?","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Round ligament pain"},{"label":"B","text":"Appendicitis"},{"label":"C","text":"Preterm labor"},{"label":"D","text":"Kidney stone"},{"label":"E","text":"Urinary tract infection 56 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-40bb5bd1f4c1","stem":"A 19-year-old G1P0 presents to the obstetrician’s office for a routine OB visit at 34 weeks gestation. Her pregnancy has been complicated by gestational diabetes requiring insulin for control. She has been noncompli- ant with diet and insulin therapy. She has had two prior normal ultra- sounds at 20 and 28 weeks gestation. She has no other significant past medical or surgical history. During the visit, the fundal height measures 38 cm. Which of the following is the most likely explanation for the dis- crepancy between the fundal height and the gestational age?","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Fetal hydrocephaly"},{"label":"B","text":"Uterine fibroids"},{"label":"C","text":"Polyhydramnios"},{"label":"D","text":"Breech presentation"},{"label":"E","text":"Undiagnosed twin gestation"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-cde927bd9e14","stem":"A 43-year-old G1P0 who conceived via in vitro fertilization comes into the office for her routine OB visit at 38 weeks. She denies any problems since she was seen the week before. She reports good fetal movement and denies any leakage of fluid per vagina, vaginal bleeding, or regular uterine contractions. She reports that sometimes she feels crampy at the end of the day when she gets home from work, but this discomfort is alleviated with getting off her feet. The fundal height measurement is 36 cm; it measured 37 cm the week before. Her cervical exam is 2 cm dilated. Which of the fol- lowing is the most appropriate next step in the management of this patient?","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Instruct the patient to return to the office in 1 week for her next routine visit"},{"label":"B","text":"Admit the patient for induction due to a diagnosis of fetal growth lag"},{"label":"C","text":"Send the patient for a sonogram to determine the amniotic fluid index"},{"label":"D","text":"Order the patient to undergo a nonstress test"},{"label":"E","text":"Do a fern test in the office"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1ee4fc507a73","stem":"A 30-year-old G2P1001 patient comes to see you in the office at 37 weeks gestational age for her routine OB visit. Her first pregnancy resulted in a vaginal delivery of a 9-lb 8-oz baby boy after 30 min of push- ing. On doing Leopold maneuvers during this office visit, you determine that the fetus is breech. Vaginal exam demonstrates that the cervix is 50% effaced and 1 to 2 cm dilated. The presenting breech is high out of the pelvis. The estimated fetal weight is about 7 lb. The patient denies having any contractions. You send the patient for a sonogram, which confirms a fetus with a double footling breech presentation. There is a normal amount of amniotic fluid present and the head is hyperextended in the “stargazer” position. Which of the following is the best next step in the management of this patient?","type":"OSCE / Practical Station","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"Allow the patient to undergo a vaginal breech delivery whenever she goes into labor"},{"label":"B","text":"Send the patient to labor and delivery immediately for an emergent cesarean section"},{"label":"C","text":"Schedule a cesarean section at or after 41 weeks gestational age"},{"label":"D","text":"Schedule an external cephalic version in the next few days"},{"label":"E","text":"Allow the patient to go into labor and do an external cephalic version at that time if the fetus is still in the double footling breech presentation"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-6fb2b9515666","stem":"A healthy 23-year-old G1P0 has had an uncomplicated pregnancy to date. She is disappointed because she is 40 weeks gestational age by good dates and a first-trimester ultrasound and wants to have her baby. She feels like she has been pregnant forever, and wants to have her baby now. The patient reports good fetal movement; she has been doing kick counts for the past several days and reports that the baby moves about eight times an hour on average. On physical exam, her cervix is firm, posterior, 50% effaced, and 1 cm dilated, and the vertex is at a −1 station. As her obstetri- cian, which of the following should you recommend to the patient?","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"She should be admitted for an immediate cesarean section"},{"label":"B","text":"She should be admitted for Pitocin induction"},{"label":"C","text":"You will schedule a cesarean section in 1 week if she has not undergone spon- taneous labor in the meantime"},{"label":"D","text":"She should continue to monitor kick counts and to return to your office in 1 week to reassess the situation 58 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-e1a99202182e","stem":"A 29-year-old G1P0 presents to the obstetrician’s office at 41 weeks gestation. On physical exam, her cervix is 1 centimeter dilated, 0% effaced, firm and posterior in position. The vertex is presenting at −3 station. Which of the following is the best next step in the management of this patient.","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Send the patient to the hospital for induction of labor since she has a favorable Bishop score"},{"label":"B","text":"Teach the patient to measure fetal kick counts and deliver her if at any time there are less than 20 perceived fetal movements in 3 hours"},{"label":"C","text":"Order biophysical profile testing for the same or next day"},{"label":"D","text":"Schedule the patient for induction of labor at 43 weeks gestation"},{"label":"E","text":"Schedule cesarean delivery for the following day since it is unlikely that the patient will go into labor"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-52da6756e951","stem":"Your patient had an ultrasound examination today at 39 weeks gesta- tion for size less than dates. The ultrasound showed oligohydramnios with an amniotic fluid index of 1.5 centimeters. The patient’s cervix is unfavor- able. Which of the following is the best next step in the management of this patient?","type":"Radiological Interpretation","subject":"Radiography and Medical Imaging","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Admit her to the hospital for cesarean delivery"},{"label":"B","text":"Admit her to the hospital for cervical ripening then induction of labor"},{"label":"C","text":"Write her a prescription for misoprostol to take at home orally every 4 hours until she goes into labor"},{"label":"D","text":"Perform stripping of the fetal membranes and perform a biophysical profile in 2 days"},{"label":"E","text":"Administer a cervical ripening agent in your office and have the patient present to the hospital in the morning for induction with oxytocin Antepartum Care and Fetal Surveillance 59"}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Radiography and Medical Imaging","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-72a43ec7ddaf","stem":"A healthy 30-year-old G1P0 at 41 weeks gestational age presents to labor and delivery at 11:00 P.M. because she is concerned that her baby has not been moving as much as normal for the past 24 h. She denies any com- plications during the pregnancy. She denies any rupture of membranes, regular uterine contractions, or vaginal bleeding. On arrival to labor and delivery, her blood pressure is initially 140/90 but decreases with rest to 120/75. Her prenatal chart indicates that her baseline blood pressures are 100–120/60–70. The patient is placed on an external fetal monitor. The fetal heart rate baseline is 180 bpm with absent variability. There are uter- ine contractions every 3 min accompanied by late fetal heart rate decelera- tions. Physical exam indicates that the cervix is long/closed /−2. Which of the following is the appropriate plan of management for this patient?","type":"OSCE / Practical Station","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Proceed with emergent cesarean section"},{"label":"B","text":"Administer intravenous MgSO4 and induce labor with Pitocin"},{"label":"C","text":"Ripen cervix overnight with prostaglandin E2 (Cervidil) and proceed with Pitocin induction in the morning"},{"label":"D","text":"Admit the patient and schedule a cesarean section in the morning, after the patient has been NPO for 12 h"},{"label":"E","text":"Induce labor with misoprostil (Cytotec)"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["possible_multiple_questions_in_stem","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"e965f0fe4b5dda092e63ed5188f9605003e6fd7c"},{"id":"q-c86d035049de","stem":"A 27-year-old G3P2002 who is 34 weeks gestational age calls the on- call obstetrician on a Saturday night at 10:00 P.M. complaining of decreased fetal movement. She says that yesterday her baby has moved only once per hour. For the past 6 hours she has felt no movement. She is healthy, has had regular prenatal care, and denies any complications so far during the pregnancy. Which of the following is the best advice for the on-call physi- cian to give the patient?","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Instruct the patient to go to labor and delivery for a contraction stress test"},{"label":"B","text":"Reassure the patient that one fetal movement per hour is within normal limits and she does not need to worry"},{"label":"C","text":"Recommend the patient be admitted to the hospital for delivery"},{"label":"D","text":"Counsel the patient that the baby is probably sleeping and that she should con- tinue to monitor fetal kicks. If she continues to experience less than five kicks per hour by morning, she should call you back for further instructions"},{"label":"E","text":"Instruct the patient to go to labor and delivery for a nonstress test 60 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-566d859fd13d","stem":"Your patient complains of decreased fetal movement at term. You rec- ommend a modified biophysical profile test. Nonstress testing in your office was reactive. The next part of the modified biophysical profile is which of the following?","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Contraction stress testing"},{"label":"B","text":"Amniotic fluid index evaluation"},{"label":"C","text":"Ultrasound assessment of fetal movement"},{"label":"D","text":"Ultrasound assessment of fetal breathing movements"},{"label":"E","text":"Ultrasound assessment of fetal tone"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7af395471a12","stem":"You are seeing a patient in the hospital for decreased fetal movement at 36 weeks gestation. She is healthy and has had no prenatal complica- tions. You order a biophysical profile. The patient receives a score of 8 on the test. Two points were deducted for lack of fetal breathing movements. How should you counsel the patient regarding the results of the biophysi- cal profile?","type":"OSCE / Practical Station","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The results are equivocal, and she should have a repeat BPP within 24 hours"},{"label":"B","text":"The results are abnormal, and she should be induced"},{"label":"C","text":"The results are normal, and she can go home"},{"label":"D","text":"The results are abnormal, and she should undergo emergent cesarean section"},{"label":"E","text":"The results are abnormal, and she should undergo umbilical artery Doppler velocimetry"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c14a1eb579d0","stem":"An 18-year-old G2P1001 with the first day of her last menstrual period of May 7 presents for her first OB visit at 10 weeks. What is this patient’s estimated date of delivery?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Labor and Delivery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Labor and Delivery","options":[{"label":"A","text":"February 10 of the next year"},{"label":"B","text":"February 14 of the next year"},{"label":"C","text":"December 10 of the same year"},{"label":"D","text":"December 14 of the same year Antepartum Care and Fetal Surveillance 61"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Labor and Delivery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-90048ec16fd4","stem":"A new patient presents to your office for her first prenatal visit. By her last menstrual period she is 11 weeks pregnant. This is the first pregnancy for this 36-year-old woman. She has no medical problems. At this visit you observe that her uterus is palpable midway between the pubic symphasis and the umbilicus. No fetal heart tones are audible with the Doppler stethoscope. Which of the following is the best next step in the manage- ment of this patient?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Reassure her that fetal heart tones are not yet audible with the Doppler stetho- scope at this gestational age"},{"label":"B","text":"Tell her the uterine size is appropriate for her gestational age and schedule her for routine ultrasonography at 20 weeks"},{"label":"C","text":"Schedule genetic amniocentesis right away because of her advanced maternal age"},{"label":"D","text":"Schedule her for a dilation and curettage because she has a molar pregnancy since her uterus is too large and the fetal heart tones are not audible"},{"label":"E","text":"Schedule an ultrasound as soon as possible to determine the gestational age and viability of the fetus"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-484e30a3e41d","stem":"A healthy 30-year-old G2P1001 presents to the obstetrician’s office at 34 weeks for a routine prenatal visit. She has a history of a cesarean section (low transverse) performed secondary to fetal malpresentation (footling breech). This pregnancy, the patient has had an uncomplicated prenatal course. She tells her physician that she would like to undergo a trial of labor during this pregnancy. However, the patient is interested in perma- nent sterilization and wonders if it would be better to undergo another scheduled cesarean section so she can have a bilateral tubal ligation per- formed at the same time. Which of the following statements is true and should be relayed to the patient?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"A history of a previous low transverse cesarean section is a contraindication to vaginal birth after cesarean section (VBAC)"},{"label":"B","text":"Her risk of uterine rupture with attempted VBAC after one prior low transverse cesarean section is 4 to 9%"},{"label":"C","text":"Her chance of having a successful VBAC is less than 60%"},{"label":"D","text":"The patient should schedule an elective induction if not delivered by 40 weeks"},{"label":"E","text":"If the patient desires a bilateral tubal ligation, it is safer for her to undergo a vaginal delivery followed by a postpartum tubal ligation rather than an elective repeat cesarean section with intrapartum bilateral tubal ligation 62 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-d60f6e0f9d38","stem":"A 16-year-old primigravida presents to your office at 35 weeks gesta- tion. Her blood pressure is 170/110 and she has 4+ proteinuria on a clean catch specimen of urine. She has significant swelling of her face and ex- tremities. She denies having contractions. Her cervix is closed and unef- faced. The baby is breech by bedside ultrasonography. She says the baby’s movements have decreased in the past 24 hours. Which of the following is the best next step in the management of this patient?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Send her to labor and delivery for a biophysical profile"},{"label":"B","text":"Send her home with instructions to stay on strict bed rest until her swelling and blood pressure improve"},{"label":"C","text":"Admit her to the hospital for enforced bed rest and diuretic therapy to improve her swelling and blood pressure"},{"label":"D","text":"Admit her to the hospital for induction of labor"},{"label":"E","text":"Admit her to the hospital for cesarean delivery"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f4c35466bad6","stem":"year-old G3P2002 who is 35 weeks calls you complaining of lower back pain. The patient informs you that she had been lifting some heavy boxes while fixing up the baby’s nursery. The patient’s pregnancy has been com- plicated by diet-controlled gestational diabetes. The patient denies any regular uterine contractions, rupture of membranes, vaginal bleeding, or dysuria. She denies any fever, chills, nausea, or emesis. She reports that the baby has been moving normally. On physical exam, you note that the patient is obese; her cervix is long and closed. Her abdomen is soft and nontender with no palpable uterine contractions. No flank pain can be elicited. She is afebrile. The external fetal monitor indicates a reactive fetal heart rate strip; there are rare irregular uterine contractions demonstrated on toco. The patient’s urinalysis comes back with trace glucose and protein, and is otherwise negative. The patient’s most likely diagnosis is which of the following?","type":"OSCE / Practical Station","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Labor"},{"label":"B","text":"Musculoskeletal pain"},{"label":"C","text":"Urinary tract infection"},{"label":"D","text":"Chorioamnionitis"},{"label":"E","text":"Round ligament pain Antepartum Care and Fetal Surveillance 63 DIRECTIONS: Each group of questions below consists of lettered options followed by a set of numbered clinical scenarios. For each num- bered scenario, select the one lettered option with which it is most closely associated. Each lettered option may be used once, more than once, or not at all. Questions 101–105 Match each description with the appropriate fetal heart rate tracing. If none of the tracings apply, answer e (none). a. b. 64 Obstetrics and Gynecology c. d."},{"label":"E","text":"None Antepartum Care and Fetal Surveillance 65"}],"priority":1,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["duplicate_option_labels","long_option_manual_review","prior_structural_review_flag","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-84501e262bc8","stem":"A 29-year-old G3P2 presents to the emergency center with com- plaints of abdominal discomfort for 2 weeks. A pregnancy test is positive and an ultrasound of the abdomen and pelvis reveals a viable 16-week ges- tation located behind a normal-appearing 10 × 6 × 5.5 cm uterus. Both ovaries appear normal. No free fluid is noted. Which of the following is the most likely cause of these findings?","type":"Radiological Interpretation","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ectopic ovarian tissue"},{"label":"B","text":"Fistula between the peritoneum and uterine cavity"},{"label":"C","text":"Primary peritoneal implantation of the fertilized ovum"},{"label":"D","text":"Tubal abortion"},{"label":"E","text":"Uterine rupture of prior cesarean section scar"}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-71a03257109c","stem":"A 32-year-old G2P1 at 28 weeks gestation presents to labor and delivery with the complaint of vaginal bleeding. She denies any contraction and states that the baby is moving normally. On ultrasound the placenta is anteriorly located and completely covers the internal cervial os. Which of the following would increase her risk for hysterectomy?","type":"OSCE / Practical Station","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Desire for sterilization"},{"label":"B","text":"Development of disseminated intravascular coagulopathy"},{"label":"C","text":"Placenta accreta"},{"label":"D","text":"Prior vaginal delivery"},{"label":"E","text":"Smoking 79 Copyright © 2006 by The McGraw-Hill Companies, Inc. Click here for terms of use. 80 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["source_attribution_in_option","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-840c51aeb54a","stem":"A patient at 17 weeks gestation is diagnosed as having an intrauter- ine fetal demise. She returns to your office 5 weeks later and has not had a miscarriage, although she has had some occasional spotting. This patient is at increased risk for which of the following?","type":"OSCE / Practical Station","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Septic abortion"},{"label":"B","text":"Recurrent abortion"},{"label":"C","text":"Consumptive coagulopathy with hypofibrinogenemia"},{"label":"D","text":"Future infertility"},{"label":"E","text":"Ectopic pregnancies"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9cb109046b4a","stem":"A 20-year-old gravida 1 at 32 weeks presents for her routine OB visit. She has no medical problems. She is noted to have a blood pressure of 150/96, and her urine dip shows 1+ protein. She complains of a constant headache and vision changes that are not relieved with rest or a pain reliever. The patient is sent to the hospital for further management. At the hospital her blood pressure is 158/98 and she is noted to have tonic-clonic seizure. Which of the following is indicated in the management of this patient?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Low-dose aspirin"},{"label":"B","text":"Dilantin (phenytoin)"},{"label":"C","text":"Antihypertensive therapy"},{"label":"D","text":"Magnesium sulfate"},{"label":"E","text":"Cesarean delivery Obstetrical Complications of Pregnancy 81"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-162ffb159814","stem":"During routine ultrasound surveillance of a twin pregnancy, twin A weighs 1200 g and twin B weighs 750 g. Hydramnios is noted around twin A, while twin B has oligohydramnios. Which statement concerning the ultrasound findings in this twin pregnancy is true?","type":"Radiological Interpretation","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"The donor twin develops hydramnios more often than does the recipient twin"},{"label":"B","text":"Gross differences may be observed between donor and recipient placentas"},{"label":"C","text":"The donor twin usually suffers from a hemolytic anemia"},{"label":"D","text":"The donor twin is more likely to develop widespread thromboses"},{"label":"E","text":"The donor twin often develops polycythemia"}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-252e85639f0e","stem":"A 32-year-old G5P1 presents for her first prenatal visit. A complete obstetrical, gynecological, and medical history and physical exam is done. Which of the following would be an indication for elective cerclage placement?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Three spontaneous first-trimester abortions"},{"label":"B","text":"Twin pregnancy"},{"label":"C","text":"Three second-trimester pregnancy losses without evidence of labor or abruption"},{"label":"D","text":"History of loop electrosurgical excision procedure for cervical dysplasia"},{"label":"E","text":"Cervical length of 35 mm by ultrasound at 18 weeks 82 Obstetrics and Gynecology DIRECTIONS: Each group of questions below consists of lettered op- tions followed by a set of numbered items. For each numbered item, select the one lettered option with which it is most closely associated. Each let- tered option may be used once, more than once, or not at all. Questions 113–117 Match each description with the correct type of abortion."},{"label":"A","text":"Complete abortion"},{"label":"B","text":"Incomplete abortion"},{"label":"C","text":"Threatened abortion"},{"label":"D","text":"Missed abortion"},{"label":"E","text":"Inevitable abortion"}],"priority":1,"status":"review","flags":["topic_generic","too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","too_many_options","too_many_options_possible_merge","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-d8dbb6613529","stem":"A 19-year-old primigravida is expecting her first child; she is 12 weeks pregnant by dates. She has vaginal bleeding and an enlarged-for-dates uterus. In addition, no fetal heart sounds are heard. The ultrasound shown below is obtained. Which of the following is true regarding the patient’s diagnosis?","type":"Radiological Interpretation","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The most common chromosomal makeup of a partial or incomplete mole is 46,XX, of paternal origin"},{"label":"B","text":"Older maternal age is not a risk factor for hydatidiform mole"},{"label":"C","text":"Partial or incomplete hydatidiform mole has a higher risk of developing into choriocarcinoma than complete mole"},{"label":"D","text":"Vaginal bleeding is a common symptom of hydatidiform mole"},{"label":"E","text":"Hysterectomy is contraindicated as primary therapy for molar pregnancy in women who have completed childbearing 84 Obstetrics and Gynecology"}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-0414726c75f5","stem":"A 20-year-old G1P0 presents to your clinic for follow-up for a suc- tion dilation and curettage for an incomplete abortion. She is asympto- matic without any vaginal bleeding, fever, or chills. Her exam is normal. The pathology report reveals trophoblastic proliferation and hydropic degeneration with the absence of vasculature; no fetal tissue is identified. A chest x-ray is negative for any evidence of metastatic disease. Which of the following is the best next step in her management?","type":"Radiological Interpretation","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Weekly hCG titers"},{"label":"B","text":"Hysterectomy"},{"label":"C","text":"Single-agent chemotherapy"},{"label":"D","text":"Combination chemotherapy"},{"label":"E","text":"Radiation therapy"}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-7a1658f6108f","stem":"A 22-year-old G1P0 presents to your clinic for follow-up of evacua- tion of a complete hydatiform mole. She is asymptomatic and her exam is normal. Which of the following would be an indication to start single- agent chemotherapy?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A rise in hCG titers"},{"label":"B","text":"A plateau of hCG titers for 1 week"},{"label":"C","text":"Return of hCG titer to normal at 6 weeks after evacuation"},{"label":"D","text":"Appearance of liver metastasis"},{"label":"E","text":"Appearance of brain metastasis Obstetrical Complications of Pregnancy 85"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-3216331cadcb","stem":"A 32-year-old G3P3 presents with abdominal pain. Her last men- strual period was 6 weeks ago, and a pregnancy test is positive. The speci- men shown below is obtained at laparotomy. Which of the following is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Incomplete abortion"},{"label":"B","text":"Missed abortion"},{"label":"C","text":"Hydatidiform mole"},{"label":"D","text":"Tubal ectopic pregnancy"},{"label":"E","text":"Ovarian pregnancy"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-747b20a15c95","stem":"A 19-year-old woman comes to the emergency room and reports that she fainted at work earlier in the day. She has mild vaginal bleeding. Her abdomen is diffusely tender and distended. In addition, she complains of shoulder and abdominal pain. Her temperature is 97.6°F, pulse rate is 120/min, and blood pressure is 80/42 mmHg. To confirm the diagnosis suggested by the available clinical data, which of the following is the best diagnostic procedure?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Pregnancy test"},{"label":"B","text":"Posterior colpotomy"},{"label":"C","text":"Dilation and curettage"},{"label":"D","text":"Culdocentesis"},{"label":"E","text":"Laparoscopy 86 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-1302101015ad","stem":"8-cm complex andexal mass is noted on the left. In the treatment of this patient, laparoscopic salpingostomy has what advantage over salpingec- tomy via laparotomy?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Decreased hospital stays"},{"label":"B","text":"Lower fertility rate"},{"label":"C","text":"Lower repeat ectopic pregnancy rate"},{"label":"D","text":"Comparable persistent ectopic tissue rate"},{"label":"E","text":"Greater scar formation"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-36f937ba35c9","stem":"A 27-year-old has just had an ectopic pregnancy. Which of the fol- lowing events would be most likely to predispose to ectopic pregnancy?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Previous cervical conization"},{"label":"B","text":"Pelvic inflammatory disease (PID)"},{"label":"C","text":"Use of a contraceptive uterine device (IUD)"},{"label":"D","text":"Induction of ovulation"},{"label":"E","text":"Exposure in utero to diethylstilbestrol (DES)"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"3e714902b62cabb44de2565fc861c3e34b7fb894"},{"id":"q-029b0e60e02a","stem":"An 18-year-old G1 at 8 weeks gestation complains of nausea and vomiting over the past week occurring on a daily basis. Nausea and emesis are a common symptom in early pregnancy. Which of the following signs or symptoms would indicate a more serious diagnosis of hyperemesis gravidarum?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Hypothyroidism"},{"label":"B","text":"Hypokalemia"},{"label":"C","text":"Weight gain"},{"label":"D","text":"Proteinuria"},{"label":"E","text":"Diarrhea Obstetrical Complications of Pregnancy 87"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-81ae9033867d","stem":"A 32-year-old G2P0101 presents to labor and delivery at 34 weeks of gestation, complaining of regular uterine contractions about every 5 min for the past several hours. She has also noticed the passage of a clear fluid per vagina. A nurse places the patient on an external fetal monitor and calls you to evaluate her status. The external fetal monitor demonstrates a reac- tive fetal heart rate tracing, with regular uterine contractions occurring about every 3 to 4 min. On sterile speculum exam, the cervix is visually closed. A sample of pooled amniotic fluid seen in the vaginal vault is fern- and nitrazine-positive. The patient has a temperature of 102°F, P = 102, and her fundus is tender to deep palpation. Her admission blood work comes back indicating a WBC of 19,000. The patient is very concerned because she had previously delivered a baby at 35 weeks who suffered from respiratory distress syndrome. You perform a bedside sonogram, which indicates oligohydramnios and a fetus whose size is appropriate for gesta- tional age and with a cephalic presentation. Which of the following is the most appropriate next step in the management of this patient?","type":"OSCE / Practical Station","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Administer betamethasone"},{"label":"B","text":"Administer tocolytics"},{"label":"C","text":"Place a cervical cerclage"},{"label":"D","text":"Administer antibiotics"},{"label":"E","text":"Perform emergent cesarean section 88 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-5210f430b679","stem":"A 30-year-old G1P0 with a twin gestation at 25 weeks presents to labor and delivery complaining of irregular uterine contractions and back pain. She reports an increase in the amount of her vaginal discharge, but denies any rupture of membranes. She reports that earlier in the day she had some very light vaginal bleeding, which has now resolved. She says that the babies have been active and moving as much as usual. She thinks that she may be feeling cramping because she may have overdone it with too much activity and lifting as she is trying to fix up the nursery to get it ready for the babies. She denies any change in her bowel or urine habits. She reports having had regular prenatal care during the pregnancy and denies any prior problems or complications. On arrival to L and D, she is placed on an external fetal monitor, which indicates uterine contractions every 2 to 4 min. She is afebrile and her vital signs are all normal. Her gravid uterus is nontender. The nurses call you to evaluate the patient. Which of the following is the most appropriate first step in the evaluation of vaginal bleeding in this patient?","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Vaginal exam to determine cervical dilation"},{"label":"B","text":"Ultrasound to check placental location"},{"label":"C","text":"Urine culture to check for urinary tract infection"},{"label":"D","text":"Labwork to evaluate for disseminated intravascular coagulopathy"},{"label":"E","text":"Apt test to determine if blood is from the fetus Obstetrical Complications of Pregnancy 89"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-1e71bb591f83","stem":"A 30-year-old gravida 1 with twin gestation at 28 weeks is being eval- uated for vaginal bleeding and uterine contractions. A bedside ultrasound examination indicates that both fetuses are in the cephalic presentation and rules out the presence of a placenta previa. Fetal heart rate tracing is reac- tive on both twins, and the uterine contractions are every 2 to 3 minutes and last 60 seconds. A sterile speculum exam is then performed, and a vaginal swab is obtained to perform a fern test on the vaginal discharge. The fern and nitrazine tests are negative. A subsequent digital exam indi- cates that the cervix is 2 to 3 centimers dilated and 50% effaced, and the presenting part is at −3 station. Tocolysis with magnesium sulfate is initi- ated and intravenous antibiotics are started for group B streptococcus pro- phylaxis. Betamethasone, a corticosteroid, is also administered. Which of the following statements regarding the use of betamethasone in the treat- ment of preterm labor is true?","type":"OSCE / Practical Station","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Betamethasone enhances the tocolytic effect of magnesium sulfate and decreases the risk of preterm delivery"},{"label":"B","text":"Betamethasone has been shown to decrease intraamniotic infections"},{"label":"C","text":"Betamethasone promotes fetal lung maturity and decreases the risk of respira- tory distress syndrome"},{"label":"D","text":"The anti-inflammatory effect of betamethasone decreases the risk of GBS sepsis in the newborn"},{"label":"E","text":"Betamethasone is the only corticosteroid proven to cross the placenta"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-48f0f5b4cf6e","stem":"A maternal fetal medicine specialist is consulted and performs an in- depth sonogram on a 30-year-old gravida 1 at 28 weeks with a twin gesta- tion. The sonogram indicates that the fetuses are both male, and the placenta appears to be diamniotic and monochorionic. Twin B is noted to have oligohydramnios and to be much smaller than twin A. Which of the following would be a finding associated with twin A?","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Congestive heart failure"},{"label":"B","text":"Anemia"},{"label":"C","text":"Hypovolemia"},{"label":"D","text":"Hypotension"},{"label":"E","text":"Low amniotic fluid level 90 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-171e4bb0a9f7","stem":"A 30-year-old G1 at 28 weeks gestation with a twin pregnancy is admitted to the hospital for preterm labor with regular painful contractions every 2 minutes. She is 3 cm dilated with membranes intact and a small amount of bloody show. Ultrasound reveals growth restriction of twin A and oligohydramnios, otherwise normal anatomy. Twin B has normal anatomy and has appropriate-for-gestational-age weight. Which of the fol- lowing is a contraindication to the use of indocin as a tocolytic in this patient?","type":"OSCE / Practical Station","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"Twin gestation"},{"label":"B","text":"Gestational age greater than 26 weeks"},{"label":"C","text":"Vaginal bleeding"},{"label":"D","text":"Oligohydramnios"},{"label":"E","text":"Fetal growth restriction"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b1822cb1ad81","stem":"A healthy 42-year-old G2P1001 presents to labor and delivery at 30 weeks gestation complaining of a small amount of bright red blood per vagina earlier in the day. The bleeding occurred shortly after intercourse. It started off as spotting and then progressed to a light bleeding. By the time the patient arrived at L and D, the bleeding had completely resolved. The patient denies any regular uterine contractions, but admits to occasional abdominal cramping. She reports the presence of good fetal movements. She denies any complications during the pregnancy. She reported a normal ultrasound done at 14 weeks of gestation. Her obstetrical history is signifi- cant for a previous low transverse cesarean section at term for a fetus that was footling breech. She wants to have an elective repeat cesarean section with a tubal ligation for delivery of this baby when she gets to term. Which of the following can be ruled out as a cause for her vaginal bleeding?","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Cervicitis"},{"label":"B","text":"Preterm labor"},{"label":"C","text":"Placental abruption"},{"label":"D","text":"Placenta previa"},{"label":"E","text":"Subserous pedunculated uterine fibroid"},{"label":"F","text":"Uterine rupture Obstetrical Complications of Pregnancy 91"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-1c6123095cc8","stem":"A 34-year-old G2P1 at 31 weeks gestation presents to labor and delivery with complaints of vaginal bleeding earlier in the day that resolved on its own. She denies any leakage of fluid or uterine contractions. She reports good fetal movement. In her last pregnancy, she had a low trans- verse cesarean delivery for breech presentation at term. She denies any medical problems. Her vital signs are normal and electronic external mon- itoring reveals a reactive fetal heart rate tracing and no uterine contractions. Which of the following is the most appropriate next step in the manage- ment of this patient?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Send her home, since the bleeding has completely resolved and she is experi- encing good fetal movements"},{"label":"B","text":"Perform a sterile digital exam"},{"label":"C","text":"Perform an amniocentesis to rule out infection"},{"label":"D","text":"Perform a sterile speculum exam"},{"label":"E","text":"Perform an ultrasound exam"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-029559cd9ff6","stem":"A 34-year-old G2P1 at 31 weeks gestation with a known placenta pre- via presents to the hospital with vaginal bleeding. On assessment, she has normal vital signs and the fetal heart rate tracing is 140 beats per minute with accelerations and no decelerations. No uterine contractions are demonstrated on external tocometer. Heavy vaginal bleeding is noted. Which of the following is the best next step in the management of this patient?","type":"OSCE / Practical Station","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Administer intramuscular terbutaline"},{"label":"B","text":"Administer methylergonovine"},{"label":"C","text":"Admit and stabilize the patient"},{"label":"D","text":"Perform cesarean delivery 92 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-88dc2952e137","stem":"A 34-year-old G2P1 at 31 weeks gestation with a known placenta previa is admitted to the hospital for vaginal bleeding. The patient contin- ues to bleed heavily and you observe persistent late decelerations on the fetal heart monitor with loss of variability in the baseline. Her blood pres- sure and pulse are normal. You explain to the patient that she needs to be delivered. The patient is delivered by cesarean section under general anes- thesia. The baby and placenta are easily delivered, but the uterus is noted to be boggy and atonic despite intravenous infusion of Pitocin. Which of the following is contraindicated in this patient for the treatment of uterine atony?","type":"OSCE / Practical Station","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Methylergonovine (Methergine) administered intramuscularly"},{"label":"B","text":"Prostaglandin F2α (Hemabate) suppositories"},{"label":"C","text":"Misoprostil (Cytotec) suppositories"},{"label":"D","text":"Terbutaline administered intravenously"},{"label":"E","text":"Prostaglandin E2 suppositories"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c64c13e66058","stem":"A 20-year-old G1P0 at 30 weeks gestation with a known placenta previa is delivered by cesarean section under general anesthesia for vaginal bleeding and nonreassuring fetal heart rate tracing. The baby is easily deliv- ered, but the placenta is adherent to the uterus and cannot be completely removed, and heavy uterine bleeding is noted. Which of the following is the best next step in the management of this patient?","type":"OSCE / Practical Station","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Administer methylergonovine (Methergine) intramuscularly"},{"label":"B","text":"Administer misoprostil (Cytotec) suppositories per rectum"},{"label":"C","text":"Administer prostaglandin F2α (Hemabate) intramuscularly"},{"label":"D","text":"Perform hysterectomy"},{"label":"E","text":"Close the uterine incision and perform curettage Obstetrical Complications of Pregnancy 93"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-50fd171305db","stem":"A 40-year-old G2P1001 presents to your office for a routine OB visit at 30 weeks gestational age. Her first pregnancy was delivered 10 years ago and was uncomplicated. She had a normal vaginal delivery at 40 weeks and the baby weighed 7 lb. During this present pregnancy, she has not had any complications, and she reports no significant medical history. She is a non- smoker and has gained about 25 lb to date. Despite being of advanced maternal age, she declined any screening or diagnostic testing for Down syndrome. Her blood pressure range has been 100–120/60–70. During her exam, you note that her fundal height measures only 25 cm. Which of the following is a possible explanation for this patient’s decreased fundal height?","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Multiple gestation"},{"label":"B","text":"Hydramnios"},{"label":"C","text":"Fetal growth restriction"},{"label":"D","text":"The presence of fibroid tumors in the uterus"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-16240bbcf393","stem":"A 38-year-old G4P3 at 33 weeks gestation is noted to have a fundal height of 29 centimeters on routine obstetrical visit. An ultrasound is per- formed by the maternal fetal medicine specialist. The estimated fetal weight is determined to be in the fifth percentile for the estimated gestational age. The biparietal diameter and abdominal circumference are concordant in size. Which of the following is associated with symmetric growth restriction?","type":"OSCE / Practical Station","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Nutritional deficiencies"},{"label":"B","text":"Chromosome abnormalities"},{"label":"C","text":"Hypertension"},{"label":"D","text":"Uteroplacental insufficiency"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4eef0173b787","stem":"A 37-year-old G4P2 presents to your office for new OB visit at 8 weeks. In a prior pregnancy, the fetus had multiple congenital anomalies consistent with trisomy 18, and the baby died shortly after birth. The mother is worried that the current pregnancy will end the same way, and she wants testing performed to see whether this baby is affected. Which of the following can be used for chromosome analysis of the fetus?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Biophysical profile"},{"label":"B","text":"Chorionic villus sampling"},{"label":"C","text":"Fetal umbilical Doppler velocimetry"},{"label":"D","text":"Maternal serum screen"},{"label":"E","text":"Nuchal translucency 94 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-08903fc9871a","stem":"A 26-year-old G1 at 37 weeks presents to the hospital in active labor. She has no medical problems and has a normal prenatal course except for fetal growth restriction. She undergoes an uncomplicated vaginal delivery of a female infant weighing 1950 g. The infant is at risk for which of the fol- lowing complications?","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Hyperglycemia"},{"label":"B","text":"Fever"},{"label":"C","text":"Hypertension"},{"label":"D","text":"Anemia"},{"label":"E","text":"Hypoxia"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-bf7bc162e644","stem":"A 38-year-old G1P1 comes to see you for her first prenatal visit at 10 weeks gestational age. She had a previous term vaginal delivery without any complications. You detect fetal heart tones at this visit, and her uterine size is consistent with dates. You also draw her prenatal labs at this visit and tell her to follow up in 4 weeks for a return OB visit. Two weeks later, the results of the patient’s prenatal labs come back. Her blood type is A−, with an anti-D antibody titer of 1:4. Which of the following is the most appro- priate next step in the management of this patient?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Schedule an amniocentesis for amniotic fluid bilirubin at 16 weeks"},{"label":"B","text":"Repeat the titer in 4 weeks"},{"label":"C","text":"Repeat the titer at 28 weeks"},{"label":"D","text":"Schedule PUBS to determine fetal hematocrit at 20 weeks"},{"label":"E","text":"Schedule PUBS as soon as possible to determine fetal blood type"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["possible_multiple_questions_in_stem","topic_generic"],"cleaningOperations":[]},{"id":"q-7dd5b794537b","stem":"A 23-year-old G3P1011 at 6 weeks presents for routine prenatal care. She had a cesarean delivery 3 years ago for breech presentation after a failed external cephalic version. Her daughter is Rh negative. She also had an elective termination of pregnancy 1 year ago. She is Rh-negative and is found to have a positive anti-D titer of 1:8 on routine prenatal labs. Failure to administer RhoGam at which time is the most likely cause of her sensi- tization?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"After elective termination"},{"label":"B","text":"At the time of cesarean delivery"},{"label":"C","text":"At the time of external cephalic version"},{"label":"D","text":"Within 3 days of delivering an Rh−fetus Obstetrical Complications of Pregnancy 95"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-e3aa094b72bb","stem":"A 27-year-old G2P1 at 29 weeks gestational age who is being followed for Rh isoimmunization presents for her OB visit. The fundal height is noted to be 33 centimeters. An ultrasound reveals fetal asites and a pericardial effusion. Which of the following can be another finding in fetal hydrops?","type":"OSCE / Practical Station","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Oliohydramnios"},{"label":"B","text":"Hydrocephaleus"},{"label":"C","text":"Hydronephrosis"},{"label":"D","text":"Subcutaneous edema"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f5d5311ddec7","stem":"A 39-year-old G1P0 at 39 weeks gestational age is sent to labor and delivery from her obstetrician’s office because of a blood pressure reading of 150/100 obtained during a routine OB visit. Her baseline blood pressures during the pregnancy were 100–120/60–70. On arrival to labor and deliv- ery, the patient denies any headache, visual changes, nausea, vomiting, or abdominal pain. The heart rate strip is reactive and the tocodynamometer indicates irregular uterine contractions. The patient’s cervix is 3 cm dilated. Her repeat BP is 160/90. Hematocrit is 34.0, platelets are 160,000, SGOT is 22, SGPT is 15, and urinalysis is negative for protein. Which of the follow- ing is the most likely diagnosis?","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Preeclampsia"},{"label":"B","text":"Chronic hypertension"},{"label":"C","text":"Chronic hypertension with superimposed preeclampsia"},{"label":"D","text":"Eclampsia"},{"label":"E","text":"Pregnancy-induced hypertension (gestational hypertension)"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0e05c3847d81","stem":"A 20-year-old G1 at 36 weeks is being monitored for preeclampsia; she rings the bell for the nurse because she is developing a headache and feels funny. As you and the nurse enter the room, you witness the patient undergoing a tonic-clonic seizure. You secure the patient’s airway, and within a few minutes the seizure is over. The patient’s blood pressure mon- itor indicates a pressure of 160/110. Which of the following medications is recommended for the prevention of a recurrent eclamptic seizure?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Hydralzine"},{"label":"B","text":"Magnesium sulfate"},{"label":"C","text":"Labetalol"},{"label":"D","text":"Pitocin"},{"label":"E","text":"Nifedipine 96 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["possible_multiple_questions_in_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-517ba8a334a9","stem":"You are doing postpartum rounds on a 22-year-old G1P1 who vagi- nally delivered an infant male at 36 weeks after an induction for severe preeclampsia. During her labor she required hydralazine to control her blood pressures. She is on magnesium sulfate for seizure prophylaxis. Her vital signs are blood pressure 154/98, pulse 93, respiratory rate 24, and temperature 99.2°F. She has adequate urine output at > 40cc/ h. On exam- ination, she is oriented to time and place, but she is somnolent and her speech is slurred. She has good movement and strength of her extremities, but her deep tendon reflexes are absent. Which of the following is the most likely cause of her symptoms?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Adverse reaction to hydralazine"},{"label":"B","text":"Hypertensive stroke"},{"label":"C","text":"Magnesium toxicity"},{"label":"D","text":"Sinus venous thrombosis"},{"label":"E","text":"Transient ischemic attack Obstetrical Complications of Pregnancy Answers"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-c3e5bad6a2da","stem":"A 33-year-old G3P2 at 30 weeks gestation has an infection in preg- nancy. Which of the following is a reactivation and therefore not a risk to the fetus?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Group B coxsackievirus"},{"label":"B","text":"Rubella virus"},{"label":"C","text":"Chickenpox virus"},{"label":"D","text":"Shingles"},{"label":"E","text":"Herpesvirus type 2"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b83d08c43ac4","stem":"A 22-year-old G1 at 14 weeks gestation presents to your office with a history of recent exposure to her 3-year-old nephew who had a rubella viral infection. In which time period does maternal infection with rubella virus carry the greatest risk for congenital rubella syndrome in the fetus?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Preconception"},{"label":"B","text":"First trimester"},{"label":"C","text":"Second trimester"},{"label":"D","text":"Third trimester"},{"label":"E","text":"Postpartum"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-750f07022755","stem":"A pregnant woman is discovered to be an asymptomatic carrier of Neisseria gonorrhoeae. A year ago, she was treated with penicillin for a gono- coccal infection and developed a severe allergic reaction. Which of the fol- lowing is the treatment of choice at this time?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Tetracycline"},{"label":"B","text":"Ampicillin"},{"label":"C","text":"Spectinomycin"},{"label":"D","text":"Chloramphenicol"},{"label":"E","text":"Penicillin 111 Copyright © 2006 by The McGraw-Hill Companies, Inc. Click here for terms of use. 112 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["source_attribution_in_option","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-a705915397df","stem":"A 22-year-old has just been diagnosed with toxoplasmosis. You try to determine what her risk factors were. The highest risk association is which of the following?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Eating raw meat"},{"label":"B","text":"Eating raw fish"},{"label":"C","text":"Having a dog"},{"label":"D","text":"Being English"},{"label":"E","text":"Having viral infections in early pregnancy"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ca32874c1c18","stem":"A 17-year-old woman at 22 weeks gestation presents to the emer- gency center with a 3-day history of nausea, vomiting, and abdominal pain. The pain started in the middle of the abdomen and is now located along her right side. She is noted to have a temperature of 101.2°F. She denies any past medical problems or surgeries. How does pregnancy alter the diagnosis and treatment of the disease?","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Due to anatomical and physiological changes in pregnancy, diagnosis is easier to make"},{"label":"B","text":"Surgical treatment should be delayed since the patient is pregnant"},{"label":"C","text":"Fetal outcome is improved with delayed diagnosis"},{"label":"D","text":"The incidence is unchanged in pregnancy"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c68cda5647b2","stem":"A 24-year-old woman appears at 8 weeks of pregnancy and reveals a history of pulmonary embolism 7 years ago during her first pregnancy. She was treated with intravenous heparin followed by several months of oral warfarin (Coumadin) and has had no further evidence of thromboembolic disease for more than 6 years. Which of the following statements about her current condition is true?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Having no evidence of disease for more than 5 years means that the risk of thromboembolism is not greater than normal"},{"label":"B","text":"Impedance plethysmography is not a useful study to evaluate for deep-venous thrombosis in pregnancy"},{"label":"C","text":"Doppler ultrasonography is not a useful technique to evaluate for deep-venous thrombosis in pregnancy"},{"label":"D","text":"The patient should be placed on low-dose heparin therapy throughout preg- nancy and puerperium"},{"label":"E","text":"The patient is at highest risk for recurrent thromboembolism during the second trimester of pregnancy Medical and Surgical Complications of Pregnancy 113"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-2eaf28446610","stem":"A 29-year-old G3P2 black woman in the thirty-third week of gesta- tion is admitted to the emergency room because of acute abdominal pain that has been increasing during the past 24 h. The pain is severe and is radiating from the epigastrium to the back. The patient has vomited a few times and has not eaten or had a bowel movement since the pain started. On examination, you observe an acutely ill patient lying on the bed with her knees drawn up. Her blood pressure is 100/70 mmHg, her pulse is 110/min, and her temperature is 38.8°C (100.8°F). On palpation, the abdomen is somewhat distended and tender, mainly in the epigastric area, and the uterine fundus reaches 31 cm above the symphysis. Hypotonic bowel sounds are noted. Fetal monitoring reveals a normal pattern of fetal heart rate (FHR) without uterine contractions. On ultrasonography, the fetus is in vertex presentation and appropriate in size for gestational age; fetal breathing and trunk movements are noted, and the volume of amni- otic fluid is normal. The placenta is located on the anterior uterine wall and of grade 2 to 3. Laboratory values show mild leukocytosis (12,000 cells per mL); a hematocrit of 43; mildly elevated serum glutamic-oxaloacetic transaminase (SGOT), serum glutamic-pyruvic transaminase (SGPT), and bilirubin; and serum amylase of 180 U/dL. Urinalysis is normal. Which of the following is the most likely diagnosis?","type":"OSCE / Practical Station","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Acute degeneration of uterine leiomyoma"},{"label":"B","text":"Acute cholecystitis"},{"label":"C","text":"Acute pancreatitis"},{"label":"D","text":"Acute appendicitis"},{"label":"E","text":"Severe preeclamptic toxemia"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-40332577d8f3","stem":"An 18-year-old has asymptomatic bacteriuria (ASB) at her first pre- natal visit at 15 weeks gestation. Which of the following statements is true?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The prevalence of ASB during pregnancy may be as great as 30%"},{"label":"B","text":"There is a decreased incidence of ASB in multiparas with sickle cell trait"},{"label":"C","text":"Fifteen percent of women develop a urinary tract infection after an initial nega- tive urine culture"},{"label":"D","text":"Twenty to thirty percent of women with ASB subsequently develop an acute symptomatic urinary infection during that pregnancy"},{"label":"E","text":"One percent of women with ASB have pyelographic evidence of chronic infec- tion or congenital abnormalities of the urinary tract 114 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-11c9e34d23bc","stem":"A 20-year-old female at 34 weeks of gestation develops a lower uri- nary tract infection. Which of the following is the best choice for treatment?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cephalosporin"},{"label":"B","text":"Tetracycline"},{"label":"C","text":"Sulfonamide"},{"label":"D","text":"Nitrofurantoin"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4828c2b06289","stem":"You are called in to evaluate the heart of a 19-year-old primigravida at term. Listening carefully to the heart, you determine that there is a split S1, normal S2, S3 easily audible with a 2/6 systolic ejection murmur greater during inspiration, and a soft diastolic murmur. You immediately recognize which of the following?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The presence of the S3 is abnormal"},{"label":"B","text":"The systolic ejection murmur is unusual in a pregnant woman at term"},{"label":"C","text":"Diastolic murmurs are rare in pregnant women"},{"label":"D","text":"The combination of a prominent S3 and soft diastolic murmur is a significant abnormality"},{"label":"E","text":"All findings recorded are normal changes in pregnancy"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a5c48f82d462","stem":"A 21-year-old has a positive purified protein derivative (PPD) and is about to be treated for tuberculosis. She can be reassured that her risk of which of the following is minimal?","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Respiratory Medicine","topicOriginal":"Respiratory Medicine","subtopic":"Tuberculosis","suggestedTopic":null,"options":[{"label":"A","text":"A flulike syndrome caused by rifampin"},{"label":"B","text":"A peripheral neuropathy caused by isoniazid"},{"label":"C","text":"Optic neuritis caused by INH"},{"label":"D","text":"Ototoxicity as a side effect of streptomycin"},{"label":"E","text":"A positive antinuclear antibody (ANA) titer with INH therapy Medical and Surgical Complications of Pregnancy 115"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Respiratory Medicine","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"02b4fc9f0651a7c9cd540f5ef6d28f99297fe9d5"},{"id":"q-2f0a1e54f5d7","stem":"A 33-year-old woman at 10 weeks presents for her first prenatal exam. Routine labs are drawn and her hepatitis B surface antigen is posi- tive. Liver function tests are normal and her hepatitis B core and surface antibody tests are negative. Which of the following is the best way to pre- vent neonatal infection?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Provide immune globulin to the mother"},{"label":"B","text":"Provide hepatitis B vaccine to the mother"},{"label":"C","text":"Perform a cesarean delivery at term"},{"label":"D","text":"Provide hepatitis B vaccine to the neonate"},{"label":"E","text":"Provide immune globulin and the hepatitis B vaccine to the neonate"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ba9c7aef888d","stem":"A 38-year-old G1P0 presents to the obstetrician’s office at 37 weeks gestational age complaining of a rash on her abdomen that is becoming increasingly pruritic. The rash started on her abdomen, and the patient notes that it is starting to spread downward to her thighs. The patient reports no previous history of any skin disorders or problems. She denies any malaise or fever. On physical exam, she is afebrile and her physician notes that her abdomen, and most notably her stretch marks, are covered with red papules and plaques. No excoriations or bullae are present. The patient’s face, arms, and legs are unaffected by the rash. Which of the fol- lowing is this patient’s most likely diagnosis?","type":"OSCE / Practical Station","subject":"Dermatology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Herpes gestationis"},{"label":"B","text":"Pruritic urticarial papules and plaques of pregnancy"},{"label":"C","text":"Prurigo gravidarum"},{"label":"D","text":"Intrahepatic cholestasis of pregnancy"},{"label":"E","text":"Impetigo herpetiformis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Dermatology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-15c2e5a39787","stem":"A 25-year-old G2P0 at 30 weeks gestation presents with the com- plaint of a new rash and itching on her abdomen over the last few weeks. She denies any constitutional symptoms or any new lotions, soaps, or detergents. On exam she is afebrile with a small, papular rash on her trunk and forearms. Excoriations from scratching are also noted. Which of the following is the recommended first-line treatment for this patient?","type":"OSCE / Practical Station","subject":"Dermatology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Delivery"},{"label":"B","text":"Cholestyramine"},{"label":"C","text":"Topical steroids and oral antihistamines"},{"label":"D","text":"Oral steroids"},{"label":"E","text":"Antibiotic therapy 116 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Dermatology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-c6993b588058","stem":"A 23-year-old G3P2002 presents for a routine OB visit at 34 weeks. She reports a history of genital herpes for 5 years. She reports that she has had only two outbreaks during the pregnancy, but is very concerned about the possibility of transmitting this infection to her baby. Which of the following statements is accurate regarding how this patient should be counseled?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"There is no risk of neonatal infection during a vaginal delivery if no lesions are present at the time the patient goes into labor"},{"label":"B","text":"The patient should be scheduled for an elective cesarean section at 39 weeks of gestation to avoid neonatal infection"},{"label":"C","text":"Starting at 36 weeks, weekly genital herpes cultures should be done"},{"label":"D","text":"The herpes virus is commonly transmitted across the placenta in a patient with a history of herpes"},{"label":"E","text":"Suppressive antiviral therapy can be started at 36 weeks to help prevent an out- break from occurring at the time of delivery"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2b1dd0a826ad","stem":"A 28-year-old G1 presents to your office at 8 weeks gestation. She has a history of diabetes since the age of 14. She uses insulin and she denies any complications related to her diabetes. Which of the following is the most common birth defect associated with diabetes?","type":"OSCE / Practical Station","subject":"Internal Medicine","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"Diabet","suggestedTopic":null,"options":[{"label":"A","text":"Anencephaly"},{"label":"B","text":"Encephalocele"},{"label":"C","text":"Meningomyelocele"},{"label":"D","text":"Sacral agenesis"},{"label":"E","text":"Ventricular septal defect"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Endocrinology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7d159fe4788b","stem":"A 32-year-old G1 at 10 weeks gestation presents for her routine OB visit. She is worried about her pregnancy because she has a history of insulin-requiring diabetes since the age of 18. Prior to becoming pregnant, her endocrinologist diagnosed her with microalbumuria. She has had photolaser ablation of retinopathy in the past. Which diabetic compli- cation may be worsened by pregnancy?","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Benign retinopathy"},{"label":"B","text":"Gastroparesis"},{"label":"C","text":"Nephropathy"},{"label":"D","text":"Neuropathy"},{"label":"E","text":"Proliferative retinopathy Medical and Surgical Complications of Pregnancy 117"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-6a382abb922d","stem":"A 37-year-old G3P2 presents to your office for her first OB visit at 10 weeks gestation. She has a history of Graves’ disease and has been main- tained on propylthiouracil (PTU) as treatment for her hyperthyroidism. She is currently euthyroid but asks you if her condition poses any problems for the pregnancy. Which of the following statements should be included in your counseling session with the patient?","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"She may need to discontinue the use of the thioamide drug because it is com- monly associated with leukopenia"},{"label":"B","text":"Infants born to mothers on PTU who are euthyroid may develop a goiter and be clinically hypothyroid"},{"label":"C","text":"Propylthiouracil does not cross the placenta"},{"label":"D","text":"Pregnant hyperthyroid women, even when appropriately treated, have an in- creased risk of developing preeclampsia"},{"label":"E","text":"Thyroid storm is a common complication in pregnant women with Graves’ disease"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"a50a2cb0abb38af3bae2e694d1c3ed70abdd772a"},{"id":"q-9625791b0628","stem":"A 40-year-old G3P2 obese patient at 37 weeks presents for her rou- tine OB visit. She has gestational diabetes that is controlled with diet. She reports that her fasting and postprandial sugars have all been within the normal range. Her fetus has an estimated fetal weight of 61⁄2 lb by Leopold’s maneuvers. Which of the following is the best next step in her manage- ment?","type":"OSCE / Practical Station","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Administration of insulin to prevent macrosomia"},{"label":"B","text":"Cesarean delivery at 39 weeks to prevent shoulder dystocia"},{"label":"C","text":"Induction of labor at 38 weeks"},{"label":"D","text":"Kick counts and routine return OB visit in 1 week"},{"label":"E","text":"Weekly biophysical profile 118 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-8d42a57d7d5b","stem":"A 36-year-old G1P0 at 35 weeks gestation presents to your office complaining of a several-day history of generalized malaise, anorexia, nau- sea, and emesis. She has also been experiencing abdominal discomfort, which she attributes to indigestion. She has had a poor appetite and has lost several pounds since her last office visit 1 week ago. She denies any headache or visual changes. Her fetal movement has been good, and she denies any regular uterine contractions, vaginal bleeding, or rupture of membranes. This patient is on no medications except for a prenatal vita- min, and has no history of any medical problems. On physical exam, you notice that she is mildly jaundiced and appears to be a little confused. Her vital signs indicate a temperature of 100°F, pulse of 70, and BP of 100/62. She has no significant edema, and in fact appears very dehydrated. You send her to labor and delivery for IV hydration and additional evaluation. Once in labor and delivery, the patient is hooked up to an external fetal monitor, which indicates a fetal heart rate in the 160s that is nonreactive, but with good variability. Blood is drawn and the following results are obtained: WBC = 25,000, Hct = 42.0, platelets = 51,000, SGOT/PT = 287/350, glucose = 43, creatinine = 2.0, fibrinogen = 135, PT/PTT = 16/50 s, serum ammonia level = 90 mmol/L (nl = 11–35). Urinalysis is pos- itive for 3+ protein and large ketones. Which of the following is the most likely diagnosis?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Hepatitis B"},{"label":"B","text":"Acute fatty liver of pregnancy"},{"label":"C","text":"Intrahepatic cholestasis of pregnancy"},{"label":"D","text":"Severe preeclampsia"},{"label":"E","text":"Hyperemesis gravidarum Medical and Surgical Complications of Pregnancy 119"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-87b2173014e4","stem":"A 27-year-old G1P0 at 34 weeks gestation presents to your office complaining of a 2-day history of nausea and emesis. She also complains of indigestion. She appears dehydrated and has lost several pounds since her last office visit 1 week ago. She denies any headache or visual changes. Her fetal movement has been good, and she denies any regular uterine contrac- tions, vaginal bleeding, or rupture of membranes. This patient is on no medications except for a prenatal vitamin, and has no history of any med- ical problems. On physical exam, you notice that she is icteric sclera and skin. Her vital signs indicate a temperature of 99°F, pulse of 102, and BP of 130/84. She is sent to labor and delivery for IV hydration and additional evaluation. Once in labor and delivery, the patient is hooked up to an external fetal monitor, which indicates a fetal heart rate in the 160s with good variability, but nonreactive. Blood is drawn and the following results are obtained: WBC = 22,000, Hct = 40.0, platelets = 72,000, SGOT/PT = 334/386, glucose = 58, creatinine = 2.2, fibrinogen = 209, PT/PTT = 16/50 s, serum ammonia level = 65 mmol/L (nl = 11–35). Urinalysis is pos- itive for 3+ protein and large ketones. Which of the following is the rec- ommended treatment for this patient?","type":"OSCE / Practical Station","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Immediate delivery"},{"label":"B","text":"Cholecystectomy"},{"label":"C","text":"Intravenous diphenhydramine"},{"label":"D","text":"MgSO4 therapy"},{"label":"E","text":"Bed rest and supportive measures since this condition is self-limited"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-48aafc621228","stem":"A 32-year-old G1P0 reports to your office for a routine OB visit at 14 weeks gestational age. Labs drawn at her first prenatal visit 4 weeks ago reveal a platelet count of 60,000. All her other labs were within normal lim- its. During the present visit, the patient has a blood pressure of 120/70. Her urine dip reveals the presence of trace protein. The patient denies any com- plaints. The only medication she is currently taking is a prenatal vitamin. On taking a more in-depth history you learn that, prior to pregnancy, your patient had a history of occasional nose and gum bleeds, but no serious bleeding episodes. She has considered herself to be a person who just bruises easily. Which of the following is the most likely diagnosis?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Alloimmune thrombocytopenia"},{"label":"B","text":"Gestational thrombocytopenia"},{"label":"C","text":"Immune thrombocytopenic purpura"},{"label":"D","text":"HELLP syndrome"},{"label":"E","text":"Pregnancy-induced hypertension 120 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-b620631d232e","stem":"A 23-year-old G1P0 reports to your office for a routine OB visit at 28 weeks gestational age. Labs drawn at her prenatal visit 2 weeks ago reveal a 1-h glucose test of 128, hemoglobin of 10.8, and a platelet count of 80,000. All her other labs were within normal limits. During the present visit, the patient has a blood pressure of 120/70. Her urine dip is negative for protein, glucose, and blood. The patient denies any complaints. The only medication she is currently taking is a prenatal vitamin. She does report a history of epistaxis on occasion, but no other bleeding. Which of the following medical treatments should you recommend to treat the thrombocytopenia?","type":"OSCE / Practical Station","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"No treatment is necessary"},{"label":"B","text":"Stop prenatal vitamins"},{"label":"C","text":"Oral corticosteroid therapy"},{"label":"D","text":"Intravenous immune globulin"},{"label":"E","text":"Splenectomy"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7933b25f555d","stem":"A 21-year-old G2P1 at 25 weeks gestation presents to the emergency room complaining of shortness of breath. She reports a history of asthma and states her peak expiratory flow rate (PEFR) with good control is usu- ally around 400. During speaking the patient has to stop to catch her breath between words; her PEFR is 210. An arterial blood gas is drawn and oxygen therapy is initiated. She is afebrile and on physical exam expiratory wheezes are heard in all lung fields. Which of the following is the most appropriate next step in her management?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Antibiotics"},{"label":"B","text":"Chest x-ray"},{"label":"C","text":"Inhaled β-agonist"},{"label":"D","text":"Intravenous corticosteroids"},{"label":"E","text":"Theophylline"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4d8388ea2b65","stem":"One of your obstetric patients presents to the office at 25 weeks com- plaining of severe left calf pain and swelling. The area of concern is slightly edematous, but no erythema is apparent. The patient demonstrates a posi- tive Homan sign, and you are concerned that she may have a deep vein thrombosis. Which of the following diagnostic modalities should you order?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Histology and Tissues","topicOriginal":"Histology and Tissues","subtopic":"Vein","suggestedTopic":null,"options":[{"label":"A","text":"MRI"},{"label":"B","text":"Computed tomographic scanning"},{"label":"C","text":"Venography"},{"label":"D","text":"Real-time ultrasonography Medical and Surgical Complications of Pregnancy 121 DIRECTIONS: Each group of questions below consists of lettered options followed by a set of numbered items. For each numbered item, select the one lettered option with which it is most closely associated. Each lettered option may be used once, more than once, or not at all. Questions 172–180 For each description, select the most likely causative infectious agent."},{"label":"A","text":"Cytomegalovirus"},{"label":"B","text":"Group B streptococcus"},{"label":"C","text":"Hepatitis B"},{"label":"D","text":"Herpes simplex"},{"label":"E","text":"Influenza A"},{"label":"F","text":"Parvovirus"},{"label":"G","text":"Rubella virus"},{"label":"H","text":"Rubeola i. Toxoplasma gondii j. Treponemal pallidum k. Varicella zoster"}],"priority":1,"status":"review","flags":["too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Histology and Tissues","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","too_many_options","too_many_options_possible_merge"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-da6211ab3a41","stem":"A 20-year-old G1 at 38 weeks gestation presents with regular painful contractions every 3 to 4 min lasting 60 seconds. On pelvic exam she is 3 cm dilated and 90% effaced; an amniotomy is performed and clear fluid is noted. The patient receives epidural analgesia for pain management. The fetal heart rate tracing is reactive. One hour later on repeat exam her cervix is 5 cm dilated and 100% effaced. Which of the following is the best next step in her management?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Begin pushing"},{"label":"B","text":"Initiate Pitocin augmentation for protracted labor"},{"label":"C","text":"No intervention; labor is progressing normally"},{"label":"D","text":"Perform cesarean delivery for inadequate cervical effacement"},{"label":"E","text":"Stop epidural infusion to enhance contractions and cervical change"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-18fb9df1ac84","stem":"A 30-year-old G2P0 at 39 weeks is admitted in active labor with spontaneous rupture of membranes occurring 2 h prior to admission. The patient noted clear fluid at the time. On exam her cervix is 4 cm dilated and completely effaced. The fetal head is at 0 station and the fetal heart rate tracing is reactive. Two hours later on repeat exam her cervix is 5 cm di- lated and the fetal head is at +1 station. Early decelerations are noted on the fetal heart rate tracing. Which of the following is the best next step in her labor management?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Administer terbutaline"},{"label":"B","text":"Initiate amnioinfusion"},{"label":"C","text":"Initiate Pitocin augmentation"},{"label":"D","text":"Perform cesarean delivery for arrest of descent 135 Copyright © 2006 by The McGraw-Hill Companies, Inc. Click here for terms of use. 136 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["source_attribution_in_option","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-2e6c50ffb799","stem":"A 32-year-old G3P2 at 39 weeks gestation with an epidural has been pushing for 30 minutes with good descent. The presenting fetal head is left occiput anterior with less than 45° of rotation with a station of +3 of 5. The fetal heart rate has been in the 90s for the past 5 min and the delivery is expedited with forceps. Which of the following best describes the type of forceps delivery performed?","type":"OSCE / Practical Station","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Outlet forceps"},{"label":"B","text":"Low forceps"},{"label":"C","text":"Midforceps"},{"label":"D","text":"High forceps"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b857220679f8","stem":"A 27-year-old G2P1 at 38 weeks gestation was admitted in active labor at 6 cm dilated; spontaneous rupture of membranes occurred prior to admission. Currently, the fetal heart rate tracing is reactive. Which of the following labor abnormalities would increase neonatal morbidity?","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Prolonged latent phase"},{"label":"B","text":"Protracted descent"},{"label":"C","text":"Secondary arrest of dilation"},{"label":"D","text":"Protracted active-phase dilation"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7e791b65b53e","stem":"A 38-year-old G6P4 is brought to the hospital by ambulance for vagi- nal bleeding at 34 weeks. She undergoes an emergency cesarean delivery for fetal bradycardia under general anesthesia. In the recovery room 4 h after her surgery the patient develops respiratory distress and tachycardia. Lung exam reveals rhonchi and rales in the right lower lobe. Oxygen ther- apy is initiated and chest x-ray is ordered. Which of the following is most likely to have contributed to her condition?","type":"Radiological Interpretation","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Fasting during labor"},{"label":"B","text":"Antacid medications prior to anesthesia"},{"label":"C","text":"Endotracheal intubation"},{"label":"D","text":"Extubation with the patient in the lateral recumbent position with her head lowered"},{"label":"E","text":"Extubation with the patient in the semierect position (semi-Fowler’s) Normal and Abnormal Labor and Delivery 137"}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-e5d8b4477689","stem":"A 23-year-old G1 at 38 weeks gestation presents in active labor at 6 cm dilated with ruptured membranes. On cervical exam the fetal nose, eyes, and lips can be palpated. The fetal heart rate tracing is 140 beats per minute with accelerations and no decelerations. The patient’s pelvis is ade- quate. Which of the following is the most appropriate management for this patient?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Perform immediate cesarean section without labor"},{"label":"B","text":"Allow spontaneous labor with vaginal delivery"},{"label":"C","text":"Perform forceps rotation in the second stage of labor to convert mentum poste- rior to mentum anterior and to allow vaginal delivery"},{"label":"D","text":"Allow patient to labor spontaneously until complete cervical dilation is achieved and then perform an internal podalic version with breech extraction"},{"label":"E","text":"Attempt manual conversion of the face to vertex in the second stage of labor"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-93f10c556bb8","stem":"A 32-year-old G3P2 at 39 weeks gestation presented to the hospital with ruptured membranes and 4 cm dilated. She has a history of two prior vaginal deliveries, with her largest child weighing 3800 g at birth. Over the next 2 h she progresses to 7 cm dilated. Two hours later she remains 7 cm dilated. The estimated fetal weight by ultrasound is 3200 g. Which of the following labor abnormalities best describes this patient?","type":"OSCE / Practical Station","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Prolonged latent phase"},{"label":"B","text":"Protracted active-phase dilation"},{"label":"C","text":"Hypertonic dysfunction"},{"label":"D","text":"Secondary arrest of dilation"},{"label":"E","text":"Primary dysfunction"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2b3c18db4312","stem":"You are following a 38-year-old G2P1 at 39 weeks in labor. She has had one prior vaginal delivery of a 3800-g infant. One week ago, the esti- mated fetal weight was 3200 g by ultrasound. Over the past 3 h her cervi- cal exam remains unchanged at 6 cm. Fetal heart rate tracing is reactive. An intrauterine pressure catheter reveals two contractions in 10 min with an amplitude of 40 mmHg each. Which of the following is the best manage- ment for this patient?","type":"Radiological Interpretation","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ambulation"},{"label":"B","text":"Sedation"},{"label":"C","text":"Administration of oxytocin"},{"label":"D","text":"Cesarean section"},{"label":"E","text":"Expectant 138 Obstetrics and Gynecology"}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-ceaee8851025","stem":"A primipara is in labor and an episiotomy is about to be cut. Com- pared with a midline episiotomy, which of the following is an advantage of mediolateral episiotomy?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Labor and Delivery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Labor and Delivery","options":[{"label":"A","text":"Ease of repair"},{"label":"B","text":"Fewer breakdowns"},{"label":"C","text":"Less blood loss"},{"label":"D","text":"Less dyspareunia"},{"label":"E","text":"Less extension of the incision"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Labor and Delivery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f03ddb3f6e6c","stem":"A 27-year-old woman (gravida 3, para 2) comes to the delivery floor at 37 weeks gestation. She has had no prenatal care. She complains that, on bending down to pick up her 2-year-old child, she experienced sudden, severe back pain that now has persisted for 2 h. Approximately 30 min ago she noted bright red blood coming from her vagina. By the time she arrives at the delivery floor, she is contracting strongly every 3 min; the uterus is quite firm even between contractions. By abdominal palpation, the fetus is vertex with the head deeply engaged. Fetal heart rate is 130/min. The fun- dus is 38 cm above the symphysis. Blood for clotting is drawn, and a clot forms in 4 min. Clotting studies are sent to the laboratory. Which of the fol- lowing actions can wait until the patient is stabilized?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Stabilizing maternal circulation"},{"label":"B","text":"Attaching a fetal electronic monitor"},{"label":"C","text":"Inserting an intrauterine pressure catheter"},{"label":"D","text":"Administering oxytocin"},{"label":"E","text":"Preparing for cesarean section DIRECTIONS: Each group of questions below consists of lettered options followed by a set of numbered items. For each numbered item, select the one lettered option with which it is most closely associated. Each lettered option may be used once, more than once, or not at all. Questions 191–193 For each clinical description, select the most appropriate procedure."},{"label":"A","text":"External version"},{"label":"B","text":"Internal version"},{"label":"C","text":"Midforceps rotation"},{"label":"D","text":"Low transverse cesarean section"},{"label":"E","text":"Classic cesarean section Normal and Abnormal Labor and Delivery 139"}],"priority":1,"status":"review","flags":["topic_generic","too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["duplicate_option_labels","prior_structural_review_flag","repeated_question_stem","too_many_options_possible_merge","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"b512ab2ee56fe41a626783a0450550c9e7d71084"},{"id":"q-1b2c5841ace0","stem":"A 24-year-old woman (gravida 3, para 2) is at 40 weeks gestation. The fetus is in the transverse lie presentation. Questions 194–196 Select the appropriate treatment for each clinical situation.","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Epidural block"},{"label":"B","text":"Meperidine (Demerol) 100 mg intramuscularly"},{"label":"C","text":"Oxytocin intravenously"},{"label":"D","text":"Midforceps delivery"},{"label":"E","text":"Cesarean section"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-224493945dd6","stem":"A nulliparous woman has had arrest of descent for the past 2 h and arrest of dilation for the past 3 h. The cervix is dilated to 7 cm and the ver- tex is at +1 station. Monitoring shows a normal pattern and adequate con- tractions. Fetal weight is estimated at 7.5 lb. 140 Obstetrics and Gynecology Questions 197–200 Match each description with the most appropriate type of obstetric anesthesia.","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Paracervical block"},{"label":"B","text":"Pudendal block"},{"label":"C","text":"Spinal block"},{"label":"D","text":"Epidural block"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-831d49d444c4","stem":"A 23-year-old G1 at 40 weeks gestation presents to the hospital with the complaint of contractions. She states they are occurring every 4 to 8 min and each lasts approximately 1 min. She reports good fetal movement and denies any leakage of fluid or vaginal bleeding. The nurse places an external tocometer and fetal monitor and reports that the patient is having contractions every 2 to 10 minutes. The nurse states that the contractions are mild to palpation. On exam the cervix is 2 cm dilated, 50% effaced, and the vertex is at −1 station. The patient had the same cervical exam in your office last week. The fetal heart rate tracing is 140 beats per minute with accelerations and no decelerations. Which of the following stages of labor is this patient in?","type":"OSCE / Practical Station","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Active labor"},{"label":"B","text":"Latent labor"},{"label":"C","text":"False labor"},{"label":"D","text":"Stage 1 of labor"},{"label":"E","text":"Stage 2 of labor Normal and Abnormal Labor and Delivery 141"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-3ebbb9ad9ea9","stem":"A 19-year-old G1 at 40 weeks gestation presents to the hospital with the complaint of contractions. She states they are very painful and occur- ring every 3 to 5 minutes. She reports good fetal movement and denies any leakage of fluid or vaginal bleeding. The nurse places an external tocome- ter and fetal monitor and reports that the patient is having contractions every 4 to 12 minutes. The nurse states that the contractions are mild to moderate to palpation. On exam the cervix is 1 cm dilated, 60% effaced, and the vertex is at −1 station. The patient had the same cervical exam in your office last week. The fetal heart rate tracing is 140 beats per minute with accelerations and no decelerations. Which of the following is the most appropriate next step in the management of this patient?","type":"OSCE / Practical Station","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Send her home"},{"label":"B","text":"Admit her for an epidural for pain control"},{"label":"C","text":"Rupture membranes"},{"label":"D","text":"Administer terbutaline"},{"label":"E","text":"Augment labor with Pitocin"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a7f186042526","stem":"A 38-year-old G3P2 at 40 weeks gestation presents to labor and deliv- ery with gross rupture of membranes occurring 1 h prior to arrival. The patient is having contraction every 3 to 4 min on the external tocometer, and each contraction lasts 60 s. The fetal heart rate tracing is 120 beats per minute with accelerations and no decelerations. The patient has a history of rapid vaginal deliveries, and her largest baby was 3200 g. On cervical exam she is 5 cm dilated and completely effaced, with the vertex at −2 station. The estimated fetal weight is 3300 g. The patient is in a lot of pain and request- ing medication. Which of the following is the most appropriate method of pain control for this patient?","type":"OSCE / Practical Station","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Intramuscular Demerol"},{"label":"B","text":"Pudendal block"},{"label":"C","text":"Local block"},{"label":"D","text":"Epidural block"},{"label":"E","text":"General anesthesia 142 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-28c981a5aed5","stem":"You are following a 22-year-old G2P1 at 39 weeks during her labor. She is given an epidural for pain management. Three hours after adminis- trating the pain medication, the patient’s cervical exam is unchanged. Her contractions are now every 2 to 3 min, lasting 60 s. The fetal heart rate trac- ing is 120 beats per minute with accelerations and early decelerations. Which of the following is the best next step in management of this patient?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Place a fetal scalp electrode"},{"label":"B","text":"Rebolus the patient’s epidural"},{"label":"C","text":"Place an intrauterine pressure catheter (IUPC)"},{"label":"D","text":"Prepare for a cesarean section secondary to a diagnosis of secondary arrest of labor"},{"label":"E","text":"Administer Pitocin for augmentation of labor"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9482933a17bf","stem":"A 25-year-old G3P2 at 39 weeks is admitted in labor at 5 cm dilated. The fetal heart rate tracing is reactive. Two hours later she is reexamined and her cervix is unchanged at 5 cm dilated. An intrauterine pressure catheter (IUPC) is placed and the patient is noted to have 280 Montevideo units by the IUPC. After an additional 2 h of labor the patient is noted to still be 5 cm dilated. The fetal heart rate tracing remains reactive. Which of the following is the best next step in the management of this labor?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Labor and Delivery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Labor and Delivery","options":[{"label":"A","text":"Perform a cesarean section"},{"label":"B","text":"Continue to wait and observe the patient"},{"label":"C","text":"Augment labor with Pitocin"},{"label":"D","text":"Attempt delivery via vacuum extraction"},{"label":"E","text":"Perform an operative delivery with forceps Normal and Abnormal Labor and Delivery 143"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Labor and Delivery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-1fad89fb30db","stem":"A 29-year-old G2P1 at 40 weeks is in active labor. Her cervix is 5 cm dilated, completely effaced, and the vertex is at 0 station. She is on oxytocin to augment her labor and she has just received an epidural for pain man- agement. The nurse calls you to the room because the fetal heart rate has been in the 70s for the past 3 min. The contraction pattern is noted to be every 3 min, each lasting 60 s, with return to normal tone in between con- tractions. The patient’s vital signs are blood pressure 90/40, pulse 105, res- piratory rate 18, and temperature 97.6°F. On repeat cervical exam the vertex is well applied to the cervix and the patient remains 5 cm dilated and at 0 station, and no vaginal bleeding is noted. Which of the following is the most likely cause for the deceleration?","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Labor and Delivery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Labor and Delivery","options":[{"label":"A","text":"Cord prolapse"},{"label":"B","text":"Epidural analgesia"},{"label":"C","text":"Pitocin"},{"label":"D","text":"Placental abruption"},{"label":"E","text":"Uterine hyperstimulation"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Labor and Delivery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7ebc06f58b13","stem":"You are delivering a 26-year-old G3P2002 at 40 weeks. She has a his- tory of two previous uncomplicated vaginal deliveries and has had no com- plications this pregnancy. After 15 min of pushing, the baby’s head delivers spontaneously, but then retracts back against the perineum. As you apply gentle downward traction to the head, the baby’s anterior shoulder fails to deliver. Which of the following is the best next step in the management of this patient?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Call for help"},{"label":"B","text":"Cut a symphysiotomy"},{"label":"C","text":"Instruct the nurse to apply fundal pressure"},{"label":"D","text":"Perform a Zavanelli maneuver"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c36793a3179f","stem":"You are delivering a 33-year-old G3P2 and encounter a shoulder dys- tocia. After performing the appropriate maneuvers, the baby finally deliv- ers, and the pediatricians attending the delivery note that the right arm is hanging limply to the baby’s side with the forearm extended and internally rotated. Which of the following is the baby’s most likely diagnosis?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Erb palsy"},{"label":"B","text":"Klumpke’s paralysis"},{"label":"C","text":"Humeral fracture"},{"label":"D","text":"Clavicular fracture 144 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-c6292c95017b","stem":"A 41-year-old G1P0 at 39 weeks, who has been completely dilated and pushing for 3 h, has an epidural in place and remains undelivered. She is exhausted and crying and tells you that she can no longer push. Her tem- perature is 101°F. The fetal heart rate is in the 190s with decreased vari- ability. The patient’s membranes have been ruptured for over 24 h, and she has been receiving intravenous ampicillin for a history of colonization with group B strep bacteria. The patient’s cervix is completely dilated and effaced and the fetal head is in the direct OA position and is visible at the introitus between pushes. Extensive caput is noted, but the fetal bones are at the +3 station. Which of the following is the most appropriate next step in the management of this patient?","type":"OSCE / Practical Station","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Deliver the patient by cesarean section"},{"label":"B","text":"Encourage the patient to continue to push after a short rest"},{"label":"C","text":"Attempt operative delivery with forceps"},{"label":"D","text":"Rebolus the patient’s epidural"},{"label":"E","text":"Cut a fourth-degree episiotomy"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6ac027dad368","stem":"A 28-year-old G1 at 38 weeks had a normal progression of her labor. She has an epidural and has been pushing for 2 hours. The fetal head is direct occiput anterior at +3 station. The fetal heart rate tracing is 150 beats per minute with variable decelerations. With the patient’s last push the fetal heart rate had a prolonged deceleration to the 80s for 3 min. You recom- mend forceps to assist the delivery due to the nonreassuring fetal heart rate tracing. Compared to the use of the vacuum extractor, forceps are associ- ated with an increased risk of which of the following neonatal complica- tions?","type":"OSCE / Practical Station","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cephalohematoma"},{"label":"B","text":"Retinal hemorrhage"},{"label":"C","text":"Jaundice"},{"label":"D","text":"Intracranial hemorrhage"},{"label":"E","text":"Corneal abrasions Normal and Abnormal Labor and Delivery 145"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-d4ea4fe86772","stem":"year-old G1 at 40 weeks for maternal exhaustion. The patient has been pushing for 3 h with an epidural for pain management. The fetal head is molded with a large caput. The position is direct occiput anterior and the head is visible at the introitus between pushes. Which of the following is the most appropriate forceps to use for this delivery?","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Kielland"},{"label":"B","text":"Piper"},{"label":"C","text":"Simpson"},{"label":"D","text":"Zavanelli"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-db3729451e6f","stem":"A 20-year-old G1 at 41 weeks has been pushing for 21⁄2 h. The fetal head is at the introitus and beginning to crown. It is necessary to cut an epi- siotomy. The tear extends through the sphincter of the rectum, but the rec- tal mucosa is intact. How should you classify this type of episiotomy?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"First-degree"},{"label":"B","text":"Second-degree"},{"label":"C","text":"Third-degree"},{"label":"D","text":"Fourth-degree"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0e3e247e74e6","stem":"A 16-year-old G1P0 at 38 weeks gestation comes to the labor and delivery suite for the second time during the same weekend that you are on call. She initially presented to labor and delivery at 2:00 P.M. Saturday after- noon complaining of regular uterine contractions. Her cervix was 1 cm dilated, 50% effaced with the vertex at −1 station, and she was sent home after walking for 2 h in the hospital without any cervical change. It is now Sunday night at 8:00 P.M., and the patient returns to L and D with increas- ing pain. She is exhausted because she did not sleep the night before be- cause her contractions kept waking her up. The patient is placed on the external fetal monitor. Her contractions are occurring every 2 to 3 min. You reexamine the patient and determine that her cervix is unchanged. Which of the following is the best next step in the management of this patient?","type":"OSCE / Practical Station","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Perform artificial rupture of membranes to initiate labor"},{"label":"B","text":"Administer an epidural"},{"label":"C","text":"Administer Pitocin to augment labor"},{"label":"D","text":"Achieve cervical ripening with prostaglandin gel"},{"label":"E","text":"Administer 10 mg intramuscular morphine"},{"label":"F","text":"Perform a cesarean section 146 Obstetrics and Gynecology"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-f500a4f606a7","stem":"A 25-year-old G1P0 patient at 41 weeks presents to labor and deliv- ery complaining of gross rupture of membranes and painful uterine con- tractions every 2 to 3 min. On digital exam, her cervix is 3 cm dilated and completely effaced with fetal feet palpable through the cervix. The esti- mated weight of the fetus is about 6 lb, and the fetal heart rate tracing is reactive. Which of the following is the best method to achieve delivery?","type":"Single Best Answer MCQ","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Deliver the fetus vaginally by breech extraction"},{"label":"B","text":"Deliver the baby vaginally after external cephalic version"},{"label":"C","text":"Perform an emergent cesarean section"},{"label":"D","text":"Perform an internal podalic version"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-73077125b65d","stem":"A 25-year-old G1 at 37 weeks presents to labor and delivery with gross rutpure of membranes. The fluid is noted to be clear and the patient is noted to have regular painful contractions every 2 to 3 min lasting for 60 s each. The fetal heart rate tracing is reactive. On cervical exam she is noted to be 4 cm dilated, 90% effaced with the presenting part a −3 station. The presenting part is soft and felt to be the fetal buttock. A quick bedside ultrasound reveals a breech presentation with both hips flexed and knees extended. What type of breech presentation is described?","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Frank"},{"label":"B","text":"Incomplete, single footling"},{"label":"C","text":"Complete"},{"label":"D","text":"Double footling"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2754aaa80081","stem":"Where such designations appear in this book, they have been printed with initial caps.","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatu