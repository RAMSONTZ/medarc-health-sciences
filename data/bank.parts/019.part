th Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-a0f3fd3d34da","stem":"the SINGLE most likely diagnosis?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-063f98a15ad9","stem":"and older brother has hay fever. What is the SINGLE most likely diagnosis?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-9dc51483e1fd","stem":"SINGLE most likely positive antibody?","type":"Short Answer","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-cbbc4da12109","stem":"red cell casts. What is the SINGLE most appropriate investigations?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-17b66863c817","stem":"most likely cause of her rash?","type":"Short Answer","subject":"Dermatology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Dermatology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4524e24b9acb","stem":"most likely positive antibody?","type":"Short Answer","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-13cd7f71602f","stem":"What is the SINGLE most likely diagnosis?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-b88ca327e011","stem":"What is the SINGLE most likely diagnosis in this patient?","type":"Clinical Vignette","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-143c6a063215","stem":"identify which medications are missing. On examination, the child is hypotensive","type":"Image / Diagram Question","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"review","flags":["subject_unclassified","topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topi