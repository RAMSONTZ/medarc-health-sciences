ce_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7d4830c9548b","stem":"What are the signs and symptoms of early sepsis?","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-203476953a85","stem":"What’s the most likely diagnosis?","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-091f98f55555","stem":"What is the most common serious complication of an end colostomy?","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-57c1c24bd01e","stem":"Which one of the following cases is considered a clean-contaminated wound?","type":"Clinical Vignette","subject":"General Surgery","topic":"Trauma and Emergency Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Trauma and Emergency Surgery","options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Trauma and Emergency Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-510f93894396","stem":"A 60-year-old man with a previous history of appendectomy 30 years ago presents to the emergency room complaining of abdominal pain. He describes the pain as colicky and crampy and feels it builds up, and then improves on its own. He has vomited at least 10 times since the pain started this morning. He states that he has not had a bowel movement for 2 days and cannot recall the last time he passed flatus. The abdomen is slightly distended. Abdominal auscultation reveals high-pitched bowel sounds and peristaltic rushes. Percussion reveals a tympanic abdomen. The patient is diffusely tender with palpation but has no rebound tenderness. Rectal examination reveals the absence of stool. Which of the following is the most likely diagnosis?","type":"Clinical Vignette","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-aba6f20bf5db","stem":"A 40-year-old man presents to the emergency room complaining of severe abdominal pain that radiates to his back accompanied by several episodes of vomiting. He drinks alcohol daily. On physical examination, the patient is found on the stretcher lying in the fetal position. He is febrile and appears ill. The skin of his abdomen has an area of bluish periumbilical discoloration. There is no flank discoloration. Abdominal examina- tion reveals decreased bowel sounds. The patient has severe midepigastric tenderness on palpation and complains of exquisite pain when your hands are abruptly withdrawn from his abdomen. Rectal examination is normal. Which of the following is the most likely diagnosis?","type":"Clinical Vignette","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f526213fa243","stem":"Spontaneous closure of which of the following congenital abnormalities of the abdominal wall generally occurs by the age of 4?","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5a91c51931b7","stem":"Volkmann’s ischemic contracture is associated with?","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-647c0028b1a3","stem":"Which of the following is a typical finding in a patient with compartment syndrome?","type":"Clinical Vignette","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f962d5dc4bf8","stem":"You are dispatched to a day-care center for a 3-year-old with a bruise to his right eye. The day-care provider is concerned that this child may have been abused. She states that although the child \"bonked\" his right eye on a chair 2 days earlier, he did not have the bruise yesterday, and his father was unable to produce \"a suitable explanation\" of the current presentation. Which of the following is true regarding this child's contusion and subsequent bruising?","type":"Short Answer","subject":"Ophthalmology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Ophthalmology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-92ed20eed780","stem":"A patient has sustained circumferential burns to the chest. On arrival at the hospital he is difficult to ventilate. What treatment is likely to improve his ventilation?","type":"Clinical Vignette","subject":"General Surgery","topic":"Trauma and Emergency Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Trauma and Emergency Surgery","options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Trauma and Emergency Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0fb9c51e2cf6","stem":"Which of the following statements regarding electrical burn injuries is correct?","type":"Short Answer","subject":"General Surgery","topic":"Trauma and Emergency Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Trauma and Emergency Surgery","options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Trauma and Emergency Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4ec3b3c531c8","stem":"Which of the following is true regarding brain perfusion?","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":