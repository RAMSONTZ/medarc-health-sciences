,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9a8ebfd384e8","stem":"When the patient is standing test for tomborgism","type":"Clinical Vignette","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5a35f1894bfe","stem":"Diarrhea –steatorrhea/malabsorption ?pernicious anemia","type":"Short Answer","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-01f1733b69b8","stem":"Abdominal pain-?large spleen","type":"Short Answer","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8b38fb5bbfa8","stem":"Weight loss ?","type":"Short Answer","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["short_or_incomplete_stem","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["short_or_incomplete_stem","short_stem","topic_generic"],"cleaningOperations":[]},{"id":"q-3058bbf5c563","stem":"Lymph reticular system-Lymphadenopathy ?","type":"Short Answer","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b7eca9a0f253","stem":"Ask: Is there anything else you would like to tell me?","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e8df6205bba1","stem":"List the drugs/medication patient is taking","type":"Clinical Vignette","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b1550301ad73","stem":"name of drug","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["short_or_incomplete_stem","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["short_or_incomplete_stem","short_stem","topic_generic"],"cleaningOperations":[]},{"id":"q-7a8224117f2c","stem":"Name of the patient","type":"Clinical Vignette","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d88b0112cf6b","stem":"Contrast sensitivity","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d832a1f62aed","stem":"How to use stethoscope: Stethoscope usage in physical exams mainly in: - Heart - Lungs - Abdomen the earpieces are angled – they should point anteriorly when in your ears. most stethoscopes have adjustable tension in the headset – read your manual for guidance. Bell and a diaphragm: - Bell for low frequency sounds (carotid bruit, venous hump, mitral stenosis murmer). - Diaphragm for high frequency sounds (most of sound). Only diaphragm(s): - Light contact to engage the bell function “Low frequency”. - Firm contact to engage the diaphragm function “High frequency”. Fig. 1: structure of stethoscope. 2","type":"Short Answer","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-d149fe68d41b","stem":"How to use sphygmomanometer:  A sphygmomanometer is a device that measures blood pressure. It is composes of an inflatable rubber cuff, which is wrapped around the arm (fig.2).  A measuring device indicates the cuff's pressure. A bulb inflates the cuff and a valve releases pressure. A stethoscope is used to listen to arterial blood flow sounds.  As the heart beats, blood forced through the arteries cause a rise in pressure, called systolic pressure, followed by a decrease in pressure as the heart's ventricles prepare for another beat. This low pressure is called the diastolic pressure.  We use a proper size blood pressure cuff. The length of the cuff's bladder should be at least equal to 80% of the circumference of the upper arm.  Wrap the cuff around the upper arm with the cuff's lower edge one inch above the antecubital fossa.  Lightly press the stethoscope over the brachial artery just below the cuff's edge.  Rapidly inflate the cuff to 180mmHg. Release air from the cuff at a moderate rate (3mm/sec).  Listen with the stethoscope and simultaneously observe the dial or mercury gauge. The first knocking sound (Korotkoff) is the subject's systolic pressure. When the knocking sound disappears, that is the diastolic pressure (such as 120/80).  If the subject's pressure is elevated, measure blood pressure two additional times, waiting a few minutes between measurements. Fig. 2: structure of sphygmomanometer. 3","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-13a0be68cd41","stem":"Vital signs monitoring","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Pulse rate: our heart rate can be taken at any spot on the body at which an artery is close to the surface and a pulse can be felt. The most common arteries to measure pulse rate using the palpation method is at radial artery, carotid artery .Other arteries sometimes used are brachial artery and femoral artery. You should always use your fingers to take a pulse, not your thumb, particularly when recording someone else's pulse, as you can sometimes feel your own pulse through your thumb. The normal pulse rate is 60-100 bpm."},{"label":"B","text":"Respiratory rate: The respiration rate is the number of breaths a person takes per minute. The rate is usually measured when a person is at rest and simply involves counting the number of breaths for one minute by counting how many times the chest rises. We measure the respiratory rate without getting the patient tension “for example to palpate pulse when you measuring the respiratory rate”. Normally 12-22 cycle/min. “1 respiratory cycle = inspiration + expiration”"},{"label":"C","text":"Temperature: The normal body temperature of a person varies depending on gender, recent activity, food and fluid consumption, time of day, and, in women, the stage of the menstrual cycle. Normal person's body temperature can be measured by thermometer (Fig.3) by the following ways: - orally “adding 0.3 to the result to get accurate” - rectally “the most accurate one” - axillary “adding 0.5 to the result to get accurate” - by ear - fresh passed urine Fig.3: thermometer. 4"},{"label":"D","text":"Blood pressure: Measured by many instrument like sphygmomanometer which is stated above. Category Systolic diastolic Hypotension < 90 < 60 Optimal < 120 < 80 Normal 120 – 129 80 – 84 High normal 130 – 139 85 – 89 Mild HTN (Grade 1) 140 – 159 90 – 99 Moderate HTN (Grade 2) 160 – 179 100 – 109 Sever HTN (Grade 3) > 180 > 110"},{"label":"E","text":"Random blood sugar: Usually measured by glucometer (Fig.4) from capillary circulation. But also may be measured by laboratory methods. Fig.4: glucometer."},{"label":"F","text":"Oxygen saturation: measured by pulse oximeter (Fig.5) “normal value : >95%” Fig.5: pulse oximeter."},{"label":"G","text":"Capillary refilling time: It is used to monitor dehydration and the amount of blood flow to the tissue. Measured by apply some pressure on the nail till it get white (blanching) then remove the 5 pressure and count the time takes for blood to return to the tissue. The return of blood is indicated by the nail turning back to a pink colour which return back normally in two seconds or less (Fig.6). Fig.6: Nail capillary refill test. This is an interview with a patient aimed to understanding the nature of his/her illness. It can be defined as: to know about the patient illness as he/she knows. The process of history taking cannot be restricted to a predefined pattern and has to be modified according to the patient symptoms, attitude, age and level of literacy. Following guidelines are helpful in learning the art of history taking. Before taking history you must: (3Ps)"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-ab01e36866ef","stem":"Precordium examination: Inspection: - Deformities, dressing, stitches, etc.... - Scars: median sternotomy. - Active pericardium and visible pulsation. Palpation","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Apex beat: The most inferio-lateral palpable pulse. - If it is impalpable, ask the patient to turn to the left. - The beat may be: - Normal, Tapping, heaving etc..... 11 note: Don't Forget to Warm Your Hand & Ask the patient if there is pain in the examined area. And if there is pain we start from the surrounding areas."},{"label":"B","text":"Parasternal heaves: - Place the heel of your hand over the left of the sternum with the fingers lifted slightly off the chest, In the presence of a heave, the heel will lift off the chest wall with each systole."},{"label":"C","text":"Thrill: - A palpable murmur caused by turbulent blood flow and is always pathological. Auscultation: - determine the position of apex. Should be in left side of chest at midclavicular line and 5th intercostal space. If it is not palpable in left side it may found in right side as case of Dextrocardia. - S1 and S2 (normal heart sound). - S3: comes after S2 • Physiological in: Childhood. Exercising people (athletes). Pregnancy. • Pathological in: Mitral regurgitation (MR). Aortic Regurgitation. Ventricular septa defect (VSD). Left heart failure. May be detected in the left lower sternal edge with right heart failure or constrictive. - S4 after S3, and before S1: - Always pathologic. - May be heard at the apex area in IHD, systemic HTN, MR, or AS. - Can be detected at the left lower sternal edge with pulmonary HTN or pulmonary stenosis. - Murmur: a turbulent blood flow: - Occurs with valve stenosis or regurgitation. - It can be either systolic (comes with the pulse) or diastolic. - The area of maximum intensity is the area at which the murmur is best heard. # Grades:"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","topic_generic"],"cleaningOperations":["option_whitespace_normalization","whitespace/page_marker_normalization"]},{"id":"q-b2cc58b8d90c","stem":"Local Examination “Front”: Inspection: - Shape and symmetry: Barrel shaped Pectus excavatum (funnel shape) Pectus carinatum (pigeon shaped) Harrison's sulcus: a groove in the lower edge of the chest at the insertion of the Diaphragm seen in long-term asthma, rickets. - Respiratory Rate. - Usage of accessory muscles in breathing: indicate respiratory distress. - Apex beat: visible or not (on the aid of torch). - Chest movement with respiration: detect when you standing at the leg of patient. - Type of breathing: Abdominothoracic or thoracoabdominal. - Scars. Palpation: - For tenderness. - Confirm the position of apex beat & other pulsations. - Position of trachea: normally: centralized. may be pulled : due to lung collapse or fibrosis . may be pushed : due to pleural effusion, pneumothorax, or tumer . - Subcostal angle. - Chest expansion (confirm respiratory movement). 14 -Tactile Vocal Fremitus (TVF). Note: Don't Forget to Warm Your Hand & Ask the patient if there is pain in the examined area. And if there is pain we start from the surrounding areas. Also compare between the two sides. Percussion (always compare both sides): - Start in the supraclavicular area. - Percuss directly on the clavicles, then just below them. - Percuss in the intercostal space on one side then the counter side. - Percuss on the axillae and their middle zones. - Comment: resonant: normal chest. dull (indicates consolidations): over the liver area, tumer, fibrosis or infection. stony dull: pleural effusion. hyperresonant: pneumothorax or emphysema. Techniques in percussion: - Separate your fingers from each other and press the middle finger. - Percuss by the middle over the middle fingers 2-3 hits are more than enough. - Don't forget to cut your nails. Auscultation: We Auscultate For","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thorax","topicOriginal":"Thorax","subtopic":"Diaphragm","suggestedTopic":null,"options":[{"label":"A","text":"Breath Sounds."},{"label":"B","text":"Type of breathing. (Normally is vesicular type, but may be bronchial as abnormal condition)."},{"label":"C","text":"Added Sounds."},{"label":"D","text":"Vocal Resonance."},{"label":"E","text":"Air entry. Technique of auscultation: - Auscultate the supra-clavicular area by the bell of stethoscope. - Auscultate the same areas of percussion by the diaphragm of stethoscope. - Air entry (equal, reduced). - Type of breathing (vesicular, bronchial). - On added sounds (wheeze, crackles) & if it is inspiratory or expiratory. - Vocal resonance."},{"label":"A","text":"Breath Sound: could be: Vesicular Breathing (Alveolar Breathing): -Flow of air in & out the normal lung alveoli. -Inspiration is longer than expiration. -No gap between inspiration & expiration. -Heard all over the chest. 15 Bronchial breathing: -The expiratory sounds are longer than the inspiratory sound. -There's gap between inspiratory and expiratory. -Bronchial breathing is normally heard over trachea & main bronchi (in the 2nd ICS). -Abnormally heard over cconsolidation or collapse."},{"label":"B","text":"Added Sounds: like: Wheeze (Rhonchi): - it’s a dry continuous musical sound. - Some causes of wheeze: Asthma, COPD, foreign bodies. Crepitation (Crackles): - It's moist interrupted wet sound (Non-Musical Sound). - Types: Fine: can be due to Fibrosis, TB or pneumonia. Coarse: can be due to acute pulmonary edema, bronchiectasis and lung abscess. Pleural Friction Rub: It's localized superficial leathery friction sound. - Some causes: Pleurisy, malignant involvement of the pleura."},{"label":"C","text":"Vocal Resonance: Ask the patient to say \"٤٤\" or ''99''. The voice will be heard clearly with consolidation or fibrosis and it will be very clear with COPD."}],"priority":1,"status":"review","flags":["probable_document_or_multiple_questions","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thorax","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","long_option_manual_review","long_stem_manual_review","nonunique_option_labels","prior_structural_review_flag","probable_document_or_multiple_questions","too_many_options"],"cleaningOperations":["option_whitespace_normalization","whitespace/page_marker_normalization"]},{"id":"q-f25bcb75edc8","stem":"Optic Nerve (II): (fig.6)","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Visual Acuity: - Examine near vision by reading & far vision by Snellen chart. - Each eye should examined separately."},{"label":"B","text":"Colour Vision: - By Ishihara chart."},{"label":"C","text":"Visual Field: By Confrontation Test. - Remove the patient glasses. - Patient’s head should be at the level of your head, and the distance must be Approximately 50cm. - Examine each eye separately. - Patient looks directly to examiner eye. - Close the patient’s left eye and ask him\\her to look at your right eye and vice versa - By finger or coloured pin brought in from outside until the patient can see it."},{"label":"D","text":"Fundoscopy: To examine the optic disc & retina (not routinely performed). 24 fig.6: visual acuity."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-edd7552622a4","stem":"Motor System Examination -Inspection: Scars, striae, swelling, dilated vein. Abnormal position: - Hemiplegia. - Mask face: Parkinson's. - All limbs are extended: decerebration. - Extended lower limbs, and flexed, pronated, and internally rotated upper limbs: Decortications. Muscle wasting. Abnormal movement, e.g. tremor or drifting. Deformity: - Wrist or foot drop. - Claw hand. - Fasciculations: Irregular contraction of small areas of a muscle, which have no rhythmical pattern. Can be fine or coarse. Present only at rest. - Examination of the tone","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Face","suggestedTopic":null,"options":[{"label":"A","text":"Upper limb: - Shaking hands and do supination & pronation. - Flexion and extension in the elbow."},{"label":"B","text":"Lower limb: - Rolling. - Flexion and extension in knee joint. - Raise legs up and release it to fall down. - Examination of the power:"},{"label":"A","text":"Upper limb: - Hand grip. - Flexion and extension in elbow with & without resistant. - Abduction & adduction of both arms with & without resistant."},{"label":"B","text":"Lower limb: - Abduction, adduction, flexion, extension of hip joint with & without resistant. - Flexion and extension in knee joint with & without resistant. - Eversion, inversion, planter flexion, plantar extension of feet with & without resistant. 28 Grades of power: Grade Power 0 No muscle contraction 1 Flicker of contraction 2 Active movement of limb with gravity eliminated e.g. movement of limb horizontally on the bed 3 Movement against gravity but not resistance 4 Movement against gravity & some resistance 5 Movement against gravity & full resistance ( normal power ) - Examination of the reflexes: Make sure that you exposed the target muscle, and you should know the reflex roots. If the reflex did not appear properly, apply reinforcement manoeuvres: - Upper limb reflex: ask patient to close his eyes firmly. - Limb reflex: ask patient to pull one hand against the other. The patient must be relaxed and properly positioned. Grades of muscle reflex: 0 absent +1 reduced reflex +2 normal +3 exaggerated +4 exaggerated with clonus (brisk)"},{"label":"A","text":"Deep Tendon Reflex: Reflexes Root Method Biceps C5 - C6 Flex the elbow to 120° Put your finger on the tendon and percuss over it. Triceps C6 - C7 - Flex the elbow to 90° C8 Percuss directly over the tendon Brachioradialis C5 - C6 Cause wrist extension Knee-jerk L2 - L3 - Percuss over the tendon above the tibial tuberosity. L4 Contraction of quadriceps muscle will extend the knee Both knee and ankle are flexed Ankle-jerk S1-S2 Percuss over the Achilles tendon Contraction of gastrocnemius cause planter flexion."},{"label":"B","text":"Planter reflex: 29 - Scratch from lateral surface of dorsum of foot and goes medially. - Normally there will be a planter flexion of the big toe (downwards). - Plantar extension (big toe upward) called Babinski’s sign and it indicates UMNL."},{"label":"C","text":"Superficial reflexes: i- Abdominal reflexes (epigastric T6-T9, Abdominal T9-T11, Lower Abdomen T12- L1): - By lightly stroking the abdominal wall diagonally towards umbilicus in each quadrant of the abdomen. - Normally: contraction of abdominal wall. - Absent of contractions indicates UMNL. ii- Cremasteric reflex (L1-L2): - Stroke inner part of thigh in a downward direction. - Cremasteric muscle contraction causes pull up of scrotum at same side."}],"priority":1,"status":"review","flags":["duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","long_option_manual_review","nonunique_option_labels","prior_structural_review_flag"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-0e31fc432b03","stem":"Sensory system examination","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Superficial sensation: Carried on spino-thalamic tract - Pain: A similar approach is used with stimulus being the tip of a pin, the patient should be respond by saying sharp or dull. - Temperature: Use two tubes of cold & warm water, touch the patient with one of the tubes and ask him to tell you if it's cold or warm."},{"label":"B","text":"Deep Sensation: “carried on DCML tract” - Proprioception: Hold the middle phalanx of the patient's index finger by side, then flex & extend the distal phalanx telling the patient which direction you mean by up & down, then repeat it with his eyes closed. - Vibration: By tuning fork on bony prominence while eyes are closed."}],"priority":1,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-0d808ce191c6","stem":"When the knocking sound disappears, that is the diastolic pressure (such as","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7211921f9eeb","stem":"Pregnancies (number, any problem with pregnancy?).","type":"Short Answer","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-52b2981d77f9","stem":"how long and which type.","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a172f084f3b9","stem":"Compare the power on each side.","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-19ed129bddea","stem":"investigations & treatment received for the presenting condition. History Of The Present Illness.. Analysis Of The Complaint - Pain If the main complaint is pain, ask about: O2CD-PQRST • Onset= sudden, rapid or gradual. • Offset (in pain only) = spontaneously or by drugs. • Course= progressive, intermittent...... • Duration= of the attack • Precipitating factors= if pain is related to a stimulus known by the patient • Quality(character)= dull aching, burning, colicky, throbbing, stitching, squeezing, dragging, heaviness.....etc • Severity of pain ( tolerable or not? what ↑ pain? what ↓pain ? ) • Site of pain • Radiation of pain= radiating pain = extension of pain to a distant site while the initial pain persists (e.g. acute appendicitis), referred pain = feeling pain away from its possible source (e.g. acute cholecystitis) • Time of onset (e.g. at night History Of The Present Illness.. Analysis Of The Complaint-Swelling • Onset= sudden, rapid or gradual • Course= progressive, intermittent or in-plateau • Duration • Positive pt factors= if pain is related to a stimulus known by the patient • Multiplicity= some swellings tend to be multiple as: multiple lymph nodes multiple lipomas multiple haemangiomas multiple lymphangiomas multiple papillomas (warts) multiple naevi multiple sebaceous cysts • Ever disappears (very important in hernias) • Associated symptoms=","type":"Clinical Vignette","subject":"General Surgery","topic":"Abdominal Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Abdominal Surgery","options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Abdominal Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["possible_multiple_questions_in_stem","topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-46d76955f126","stem":"Past history of traveling abroad.. Gynecological And Obstetric History Why to ask about Menstrual history ? • If early menarche & late menopause = risk group of breast cancer. • Pain & fullness in the breast during menses draws the attention to fibroadenosis. • Whether the patient is pre- or post- menopausal, it is very important in the Rx of breast cancer. Gynecological And Obstetric History... • Menstrual history; Time of Menarche Regularity Related complaints (? Pain) Post- menopausal","type":"Clinical Vignette","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-f58c8db7661c","stem":"What Is The Use Of History Taking?","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5caf6f9e2a7c","stem":"How To Start?","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["short_or_incomplete_stem","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["short_or_incomplete_stem","short_stem","topic_generic"],"cleaningOperations":[]},{"id":"q-78adc9826237","stem":"Interpret as 10 smoke pack years etc....","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-45b0c977af66","stem":"Explain who you are & what you are doing","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2909e88b27ab","stem":"List PCs: numerically, chronologically & their time course","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3ade39a37428","stem":"Describe each separate symptom or PC in detail","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4cf286562139","stem":"List the drugs/medication that pt is taking","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-cf308d19909e","stem":"Ask if allergic & to what? e.g. penicillin","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3f0ad58bab7a","stem":"Name of allergy e.g drug must be listed & recorded in patient’s file notes","type":"Clinical Vignette","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b9b540e1ca93","stem":"Identify likely anatomical & physiological basis for patient’s symptoms","type":"Clinical Vignette","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-514554212735","stem":"Record how patient appears/looks : well or unwell?","type":"Clinical Vignette","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-253ad6892eaf","stem":"List of active problems which require action","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5b3302873cd2","stem":"List of investigations for each problem","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ba77e2959c50","stem":"List treatment planned for each problem","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9761ccf9ef51","stem":"Review: need for laparotomy? Other co-morbidity, for example pneumonia, TB, immunosuppression?","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-363a32f3a39d","stem":"Do a PV examination: bleeding, cord prolapse or simply fully dilated and about to deliver?","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-eaa8f314947e","stem":"When should vaginal examination be done?","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6b4b78f78550","stem":"discuss the patient with nursing before inserting","type":"Essay / Structured Essay","subject":"Nursing","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Nursing","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-169e5ab51432","stem":"which can be asymptomatic OR present with","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3dfaba43937e","stem":"• Nuchal translucency (genetic disorders?)","type":"Short Answer","subject":"Medical Genetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Genetics","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8fdd3ce5ce0d","stem":"weight) ↔ IUGR?","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1d78daa73efc","stem":"• Umbilical cord (3vessels?)","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d48d48afe56a","stem":"Chief Complaint (C/C)","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"SOCRATES; Site, Onset, Character, Radiation,"},{"label":"B","text":"Associated factors, Timing (duration, periodicity, frequency), Exacerbating/alleviating factors, Severity"}],"priority":1,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-7c258443a133","stem":"History of Presenting Illness (HPI)","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"DOPPARA; Duration, Onset, Periodicity, Progression,"},{"label":"B","text":"Associated factors, Relieving factors, Aggravating factors"}],"priority":1,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-fa04be7f8acc","stem":"Review of Systems (ROS) iii. Difficulty swallowing (dysphagia); of solids ± liquids? iv. Painful swallowing (odynophagia); of solids ± liquids? x. History of yellowish discolouration (jaundice)?","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"HEENT; Head, ears, eyes, nose and throat i. Pain ii. Bleeding iii. Lumps iv. Discharge v. Sneezing vi. Mouth breathing vii. Snoring"},{"label":"B","text":"Central Nervous System i. Fever ii. Loss of consciousness (LOC) iii. Seizures/Collapse /blackouts/dizziness/loss of balance iv. Headache v. Problems in vision/hearing vi. Tingling (paraesthesiae) vii. Spasms and involuntary movements"},{"label":"C","text":"Cardiovascular System i. Awareness of heartbeat (palpitations) ii. Shortness of breath (SOB, dyspnoea) iii. Difficulty in breathing on lying flat (orthopnoea) iv. 'Air-hunger' at night (paroxysmal nocturnal dyspnoea, PND) v. Lower limb, ankle swelling/facial puffiness vi. History of bluish discolouration? (cyanosis)"},{"label":"D","text":"Respiratory System i. Chest pain ii. Difficulty in breathing (rapid breathing?, mouth-breathing?) iii. Nasal discharge? (rhinorrhoea), Ear discharge (otorrhoea?) iv. Cough ± sputum v. Haemoptysis"},{"label":"E","text":"Gastrointestinal i. Abdominal pain ii. 'Heart-burn' (dyspepsia) v. Nausea ± vomiting vi. Change in appetite HOODA, Faisal Hasnain 2 vii. Weight loss / gain viii. Bowel pattern and any change; constipation, diarrhoea ix. Bloody stools; streaks/gross blood, fresh/digested"},{"label":"F","text":"Genitourinary System i. Painful urination (dysuria) ii. Blood in urine/bloody urine (haematuria) iii. Waking up to urinate at night (nocturia) iv. Frequency"},{"label":"G","text":"Musculoskeletal System i. Weakness ii. Pain in limbs and back iii. Joint pain/stiffness/swelling"},{"label":"H","text":"Haematopoietic System i. Easy bruising ii. Bleeding tendencies"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","too_many_options","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"e66c82d05c9b0dabfdc5a88263c04b076bb946c2"},{"id":"q-e14d1596e548","stem":"Past Medical History (PMHx) breathing problems?, feeding difficulties?","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Previous admissions; number, time, cause"},{"label":"B","text":"History of trauma/surgical intervention; number, reason, when"},{"label":"C","text":"History of blood transfusions; number, reason, when"},{"label":"D","text":"Medications; what (herbal medication), route, duration, compliance"},{"label":"E","text":"Allergies; food/drugs"},{"label":"F","text":"Obs/Gyn Hx; in girls i. Age at Menarche ii. LNMP iii. Duration of menstrual cycle iv. Duration, amt of bleeding menstrual periods"},{"label":"G","text":"Chronic illnesses; DM, HTN, TB, SCD Antenatal History; health of mother during pregnancy"},{"label":"A","text":"ANC (antenatal clinic); date of first visit at ANC, age of pregnancy at first visit to ANC, frequency of attendance"},{"label":"B","text":"Illnesses during pregnancy; febrile?, vomiting?, bleeding?, complications?"},{"label":"C","text":"Any tests during pregnancy; (PITC?, VDRL?), when?, repeated later?"},{"label":"D","text":"Medication use during pregnancy (which?, duration?), radiation exposure Natal History; all events during childbirth and delivery"},{"label":"A","text":"Duration of pregnancy; pre-term (<37wks), term (38-42 wks), post-term (>42 wks)"},{"label":"B","text":"Duration of labour (normal is <8hrs)"},{"label":"C","text":"Type of birth; SVD/C-section; if so, why?"},{"label":"D","text":"Birth-weight; (normal: 2.5-3.5kg, low: 1.5-2.5kg, very low: 1.5-1.0kg, extremely low <1.0kg) (At 6/12: x2bwt, at 1year: x3 bwt, at 2years: x4 bwt)"},{"label":"E","text":"State of neonate at birth; any problems during newborn period; jaundice?,"},{"label":"F","text":"Resuscitation; required? , how long resuscitated?"},{"label":"G","text":"Onset of first cry"},{"label":"H","text":"Place of delivery Neonatal History; regards all events up to 1/12 after delivery"},{"label":"A","text":"Serious illnesses after birth; congenital malformations?, pallor?, jaundice?, convulsions ?,"},{"label":"B","text":"Difficulty in sucking, feeding difficulties?, weight loss?"},{"label":"C","text":"Rashes TORCHES; Toxoplasma, Other (Plasmodia, Listeria, Gonococci, Chlamydia, Candida), Rubella, Cytomegalovirus, HErpes simplex & varicella zoster, HIV, HBV, Human parvovirus B19, Human T-lymphotropic virus, Syphilis"}],"priority":1,"status":"review","flags":["topic_generic","too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","too_many_options","too_many_options_possible_merge","topic_generic"],"cleaningOperations":[]},{"id":"q-1c11855ed930","stem":"Immunisation History; according to the national Immunisation and Vaccines Development (IVD) schedule The previous immunisation schedule (Expanded programme of immunisation: EPI) was launched in December 2012, launching additional vaccines Rotarix (rotavirus vaccine) and PCV-13 (Pneumococcal conjugate vaccine, 13 most common serotypes). The current schedule (Immunisation and Vaccines Development: IVD) scheme was introduced 2014 – whereby the booster measles dose was added at 18 months. HOODA, Faisal Hasnain 3 i. Measles Booster; (also contains rubella) given on Lt shoulder IM?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Day 0: i. Oral Polio Vaccine (OPV)0; given as PO drops ii. Bacille Calmette-Guerin (BCG); given on Rt shoulder SubQ, leaves a mark. If not given at birth, give as soon as the baby presents to hospital"},{"label":"B","text":"Week 6: (2 oral vaccines + 2 IM injections) i. Oral Polio Vaccine (OPV)1; given as PO drops ii. Pentavalent Vaccine1; given on Lt shoulder IM. Consists of 5 components DPT (diphtheria, pertussis, tetanus) HiB (Haemophilus influenzae-B) HBV (Hepatitis B) iii. PCV-131; given on Rt thigh IM iv. Rotarix1; given as PO drops"},{"label":"C","text":"Week 10: (2 oral vaccines + 2 IM injections) i. Oral Polio Vaccine (OPV)2; given as PO drops ii. Pentavalent Vaccine2; given on Lt shoulder IM iii. PCV-132; given on Rt thigh IM iv. Rotarix2; given as PO drops"},{"label":"D","text":"Week 14: i. Oral Polio Vaccine (OPV)3; given as PO drops ii. Pentavalent Vaccine3; given on Lt shoulder IM iii. PCV-133; given on Rt thigh IM"},{"label":"E","text":"Month 9: i. Measles Vaccine; given on Lt shoulder IM ii. Vitamin A; then every 6 months for 5 years (often Jun, Dec of every year)"},{"label":"F","text":"Month 18: (vitamin A, albendazole every 6 months)"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-c70d99175502","stem":"Dietary History: (conclude about adequacy of quantity & quality) ii. Problems; ↓suckling?, ↓maternal milk? feeding habit: themselves?/ sharing(with whom)?","type":"Single Best Answer MCQ","subject":"Nutrition and Dietetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Breast-feeding; (recommended for 6/12 – >2years) i. Duration; exclusive breastfeeding (strictly breast milk only: atleast 6/12 )/ mixed breastfeeding (breast + bottle feeding <6/12). iii. Formula; type, duration, major formula changes"},{"label":"B","text":"Weaning; complementary food (↓breast , ↑bottle feeding, other sources >6/12), what age?, type of food given?,"},{"label":"C","text":"Current diet; what? amount ?, no. of meals per day?"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Nutrition and Dietetics","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9a0c0e522b38","stem":"Developmental History; (chronologic history of developmental milestones)","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Status: Normal for age/delayed for age/ regressed (backward progress) for age"},{"label":"B","text":"Gross motor; prone, lifts head clear of ground/ sits with support/ sits on own/ crawling/ walks alone/hops/skips"},{"label":"C","text":"Fine Motor & Vision; looks at toy mid-line/watches hands, tries grasping objects/ transfers objects from hand to hand/ building a tower of cubes/ copies drawn shapes"},{"label":"D","text":"Hearing & Speech; Vocalises with gurgles/ turns head to sound, vocalises appropriately/ says small words/ 1 meaningful word/ 2-3 meaningful words/ joining 2 words together/ HOODA, Faisal Hasnain using phrases/ speaks 3-word sentences/ counts to 10 4"},{"label":"E","text":"Behaviour & Social Skills; smiles spontaneously/ recognises mother/ finger or object feeds/ drinks from cup/ takes-off clothes/ clean and dry but occasional accidents/ brushes teeth, washes hands/ co-operative play N.B: 1 year: single words, walks | 2 years: 2 word sentences, understands 2-step commands|3 years: 3 word combos, repeats 3 digits, rides tricycle (3 wheels)| 4 years: draws square (4 sides), counts 4 objects"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-33c47dd3d1d5","stem":"Family Social History (FSHx)","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Primary care-taker; (who the child lives with)"},{"label":"B","text":"Who takes care of the child when the mother is away"},{"label":"C","text":"Occupation, age of parents"},{"label":"B","text":"Number of siblings; sex?, alive?, well?"},{"label":"C","text":"Home; water source (boiled water?), toilets?, insecticide-treated nets?, ventilation?"},{"label":"D","text":"Chronic familial illnesses; DM, HTN, SCD, haemophilia, thalassemia, heart problems Physical Exam"}],"priority":1,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"345881b22c2d59a1a06e76d63705342588677d2c"},{"id":"q-2b7b71736f61","stem":"General Exam palpebral fissures?, nasal bridge? iv. Scleral jaundice? vii. Features of vitamin A deficiency: Bitot spots?, keratomalacia?, xerophthalmia? iii. Dry, cracked lips? iv. Tongue; (atrophic) glossitis?, rash?, hairy leukoplakia? v. Oral cavity; thrush?, cleft-palate? vi. Inflammation (reddening, swelling) of throat?, tonsillitis? k. Neck; size (normal/ shorter/ longer), webbing?, masses?, lymph nodes? o. Back; normal/kyphosis? (forward bending)/ scoliosis? (lateral bending) /kyphoscoliosis?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Consciousness; alertness/ lethargic/ irritable/ unconscious"},{"label":"B","text":"Orientation to people, place and time"},{"label":"C","text":"Physique & nutrition (obesity/wasting/abnormal fat distribution)"},{"label":"D","text":"Hair; colour, distribution (normal/sparse), texture (soft, silky/ coarse, dry)"},{"label":"E","text":"Head; size? (normal/ microcephaly/ macrocephaly), shape? (normal/abnormal) i. Anterior fontanel; (closes at 9 –18 months max If still open: if bulging = ↑ICP, if depressed = dehydration) ii. Posterior fontanel; (closes at 2 –3 months)"},{"label":"F","text":"Face; i. Shape: normal/ ‘moon’-shaped (kwashiorkor: generalised oedema)/ ‘old-man’s face (marasmus: loss of subcutaneous fat) ii. Abnormalities; forehead, epicanthic folds?, ears (small?), upward sweeping"},{"label":"G","text":"Eyes; i. Position: (straight/ slanted) ii. Obvious discharge; (single/both eye(s), amount, colour, smell, texture) iii. Normal/ sunken v. Conjunctival pallor: mild/ moderate/ severe (less accurate in younger children) vi. Cataract? (associated with TORCHES)"},{"label":"H","text":"Nose; obvious discharge, shape, position, abnormality i. Mouth; i. Angular cheilosis (stomatitis)? (iron, vitamin B deficiency) ii. Cyanosis; of lips (inaccurate when child is crying/active) j. Ear; setting (normally set/ low-set), obvious discharge (otoscope: tympanic memb. exam) l. Extremities; skin texture, warm/ cold, dry/sweaty, capillary refill (<3 seconds), clubbing, splinter haemorrhages, palmar creases, palmar pallor?, syndactyly? (fusion of ≥2 digits) ± polydactyly (6 toes on one foot/hand)?, clinodactyly? (turning of digits) m. Oedema; pitting/non-pitting, location (pedal/ pre-tibial/ sacral/ anasarca) n. Superficial lymph node enlargement HOODA, Faisal Hasnain i. Site, Size 5 ii. Discrete (solitary) /matted (joined) iii. Tenderness iv. Surface, edge, consistency (hard/s oft/rubbery, irregular/regular, nodular/smooth, round) v. Mobility (usually mobile) p. Dehydration status; none/some/severe (impairment of ≥2 of the following) i. Level of consciousness: alert/ irritable/ lethargic ii. Eyes: normal/sunken iii. Drinking ability: normally/ eagerly/ unable to (test: give ORS with water, even to children <6 months) iv. Skin turgor; normal/ skin pinch goes back slow (<2 secs)/ skin pinch goes back very slow (>2 secs). (pinch anterior abdomen skin laterally right to umbilicus)"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","too_many_options"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-9147715b2267","stem":"Anthropometric Measurements","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Body weight; on admission, current"},{"label":"B","text":"Height (≥2 years, can stand unsupported) Length (<2 years, or ≥2 years but can’t stand unsupported) (2 ppl needed to accurately measure: in exam, request examiner to help!)"},{"label":"C","text":"Head circumference (<3 years); (>3SD= hydrocephalus)"},{"label":"D","text":"Mid-upper arm circumference (MUAC); (>6 months, measure of wasting) i. 6-59 months: >11.5 cm ii. 5- 9 years: >13.5 cm iii. 10-14years: >16.0 cm N.B: WFL; is a measure of acute wasting in children <2 years of age WFH; is a measure of acute wasting in children 2-5 years of age WFA; is a measure of being underweight for children <5 years BMI-for-age; is a measure of being underweight for children >5 years"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-088296aff641","stem":"Reflexes: Superficial; (present/absent)","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Pupillary Light Reflex; (CN II, III) observe direct and consensual constriction of pupils as light is shone into eye(s)."},{"label":"B","text":"Occulocephalic Reflex; (CN III, VI, VIII) movement of the eyes in an opposite direction to head movement."},{"label":"C","text":"Corneal Reflex; (CN V, VII) blinking of eyes on contact with cotton"},{"label":"D","text":"Gag Reflex; (CN IX, X) gag/choking induced as tongue is depressed using tongue spatula."},{"label":"E","text":"Apnoea Reflex; for a ventilated patient, switching-off ventilator evokes a gasping response."},{"label":"F","text":"Abdominal Reflex; stroke abdomen gently from flanks → inward. Observe the contraction of the abdominal muscles resulting in deviation of umbilicus towards the area stimulated."},{"label":"G","text":"Cremasteric Reflex; stroking inner aspect of thigh causes reflex contraction of scrotum on the same side"},{"label":"H","text":"Anal Reflex; reflexive contraction of the external anal sphincter upon stroking of the skin around the anus HOODA, Faisal Hasnain 7 i) Babinski Reflex; (down-going/up-going/equivocal) Deep; (grade 0-4)"},{"label":"A","text":"Biceps (C5, C6)"},{"label":"B","text":"Brachioradialis (C5, C6)"},{"label":"C","text":"Triceps (C6, C7)"},{"label":"D","text":"Finger (C8)"},{"label":"E","text":"Adductor (L2, L3)"},{"label":"F","text":"Knee (L3, L4)"},{"label":"G","text":"Ankle (S1)"}],"priority":1,"status":"review","flags":["topic_generic","too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","too_many_options","too_many_options_possible_merge","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-c8a350a4daf7","stem":"Sensory System","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Pin-prick"},{"label":"B","text":"Temperature"},{"label":"C","text":"Light touch"},{"label":"D","text":"Vibration sense"},{"label":"E","text":"Joint position sense"},{"label":"F","text":"2-point discrimination v. Co-ordination, Gait & Balance;"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["short_stem","topic_generic"],"cleaningOperations":[]},{"id":"q-b9ce7db2b322","stem":"Co-ordination","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Finger-to-nose"},{"label":"B","text":"Rapid alternating movement of the hand"},{"label":"C","text":"Heel-shin test"}],"priority":1,"status":"practice_draft","flags":["short_or_incomplete_stem","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayT