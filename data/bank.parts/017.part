onStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-b4bd474b4fa3","stem":"Do you feel that antenatal services adequately address gender-based violence issues? (Je, unahisi kwamba huduma za antenatal ni za kutosha katika kushughulikia masuala ya ukatili wa kijinsia?)","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-6e2a71d5ae72","stem":"What improvements would you suggest to enhance gender-based violence services in antenatal clinics? (Ni maboresho gani ungependa kupendekeza ili kuboresha huduma ya ukatili wa kijinsia katika kliniki za ujauzito?)","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-3726c1a67162","stem":"How often do you discuss gender-based violence with health care providers during clinic visits? (Mara ngapi unazungumzia ukatili wa kijinsia na watoa huduma za afya wakati wa ziara za kliniki?)","type":"Essay / Structured Essay","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"],"duplicateStemGroup":"12019db0e398669e9661be68af634edd299db1ae"},{"id":"q-ed755098dae6","stem":"Which combination of signs and symptoms is typical of preeclampia? BP > 140/90 mmHg in supine position, proteinuria (++) Excessive weight gain, pedal edema, BP 150/100 mmHg Severe headaches, pedal edema, proteinuria trace BP 140/90 mmHg Body weight of 104 kg, Multipara, BP 140/90 mm Hg no proteinuria Puffy face, pedal edema, BP normal, No proteinuria 7. What is not a cause of antepartum hemmorhage? Placenta previa Abruptio placenta Dysfunctional uterine bleeding Pregnancy with carcinoma of the cervix Show 8. What is not a cause of post partum hemorrhage? Placenta accreta Placenta increta Abruptio placenta Cervical tear Uterine atony 9. The following statements are true about malaria except: Incubation period is 5 days It can cause metabolic acidosis Thin film is used to identify the species of plasmodium The stain used at KCMC clinical laboratory is Giemsa Gamotocytes seen on the blood film represents the sexual stages of plasmodium 10. Causes of raised white cell counts include all of the following except: Myelocytic leukaemia Staphylococcal septicaemia HIV disease Acute hemorrhage Lead posoning Diabetic ketoacidosis SECTION II - SHORT ESSAY QUESTIONS 1. You being the doctor doing ward round in OG I and you want to request and obstetric ultrasound of patient in Room 5, SR, or Room 6 what do you ask for in the request form? 2. a) Describe briefly, the procedures involved in doing a bleeding time test and mention 3 causes of prolonged bleeding time. SECTION III - LONG ESSAY QUESTIONS 1. Describe the course of a normal vaginal delivery at term (Cephalic presentation). Including the cervical changes, descent and rotations of the baby in the pelvis. ùïßïßÕÈ1⁄4aš —...|ršeVMCMVMVMC „0ý^„Ð ÷í÷Þ÷í÷í÷Þ÷íÐÀíÀ3ÀíÐ ̈À÷Þ÷ „0ý^„Ð „0ý^„Ð „0ý^„Ð °Ð/ °à=!° Ú#:ÀŠ6ÿ ÂM©H> Ò æh¤PÐzú+ÿ KYjZ:61⁄4Âÿ ÿ1a`ÜˆÚ P{Îk–—”`ÿ `„0ýo( ^„Ø `„Lÿ","type":"Radiological Interpretation","subject":"Embryology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"review","flags":["probable_document_or_multiple_questions","topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Embryology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["long_stem_manual_review","possible_multiple_questions_in_stem","prior_structural_review_flag","probable_document_or_multiple_questions","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-06d9833ed0aa","stem":"Describe and/observe techniques for the following procedures","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-38c5fb3585c3","stem":"HOW TO HANDLE THE PRESCRIPTION","type":"Short Answer","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"a03a66a377aae25e0d4e24e1cceb4b303aa4f8bb"},{"id":"q-076682f3223a","stem":"HOW TO HANDLE NHIF FORMS","type":"Short Answer","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"73ef39990d3436109c112a1999bc6de7d03b181d"},{"id":"q-7b56978a63eb","stem":"HOW TO HANDLE THE PRESCRIPTION","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"HOW TO HANDLE NHIF FORMS"},{"label":"B","text":"PowerPoint Presentation"},{"label":"C","text":"PowerPoint Presentation"},{"label":"D","text":"Acknowledgements"},{"label":"E","text":"Fonts Used"},{"label":"F","text":"Slide Titles"}],"priority":1,"status":"review","flags":["duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_text","nonunique_option_text","prior_structural_review_flag","repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"a03a66a377aae25e0d4e24e1cceb4b303aa4f8bb"},{"id":"q-1e5ea73b35ec","stem":"HOW TO HANDLE NHIF FORMS","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"PowerPoint Presentation"},{"label":"B","text":"PowerPoint Presentation"},{"label":"C","text":"Acknowledgements"},{"label":"D","text":"Fonts Used"},{"label":"E","text":"Slide Titles"},{"label":"F","text":"_À‘ãd..."}],"priority":1,"status":"review","flags":["duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_text","nonunique_option_text","prior_structural_review_flag","repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"73ef39990d3436109c112a1999bc6de7d03b181d"},{"id":"q-c513a5ac220b","stem":"ID: i. Any previous scar(s)?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Name, Sex (F), Address"},{"label":"B","text":"Referral status; (self-referral from home/referred from hospital + reason for referral)"},{"label":"C","text":"Gravidity; condition of pregnancy regardless of outcome (primigravida/ multigravida)"},{"label":"D","text":"Parity; how many births (primipara/ multipara)"},{"label":"E","text":"How many children living; alive?, well? Gx Pa+b"},{"label":"F","text":"Last normal menstrual period (LNMP) x: total #of pregnancies (including index one)"},{"label":"G","text":"Expected date of delivery (EDD)"},{"label":"A","text":"total #of births beyond 28 weeks of gestation (or"},{"label":"H","text":"Gestation age; by: ≥1kg body weight) i. Dates: Naegele’s Rule"},{"label":"B","text":"total #of births of miscarriages/ termination of ii. Fundal height pregnancies <28 weeks of gestation iii. Ultrasound Naegele’s Rule: j. Known chronic illnesses (for how long) EDD= (LNMP+ 7 days) −3Mo (LNMP: April – Dec) ± medication (regular/irregular) EDD= (LNMP+ 7 days) + 9 Mo (LNMP: Jan – March) ± clinic attendance (regular/irregular) Gives EDD at 40 weeks of gestation k. When the patient was admitted this time l. If IDS (for how long, baseline CD4 count & current CD4 count, ART regimen?, TMP-SXT prophylaxis?) m. Ask for any documentation (e.g. discharge summaries, ANC & CTC card) n. Ask for any medication that the patient/relative has with them"}],"priority":1,"status":"review","flags":["topic_generic","too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","long_option_manual_review","nonunique_option_labels","prior_structural_review_flag","too_many_options","too_many_options_possible_merge","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-9e5bcc74792b","stem":"History of Presenting Illness (HPI): DOPPARA; Duration, Onset, Periodicity, Progression, a. Amplify complaints Associated factors, Relieving factors, Aggravating b. Complications factors c. Risk factors","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"D","text":"Obs/Gyn hx"},{"label":"E","text":"Course of illness"}],"priority":1,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-8aa03e9607bc","stem":"Review of Systems (ROS): iii. Difficulty swallowing (dysphagia); of solids ± liquids? iv. Painful swallowing (odynophagia); of solids ± liquids? x. History of yellowish discolouration (jaundice)?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"HEENT; Head, ears, eyes, nose and throat i. Pain ii. Bleeding iii. Discharge"},{"label":"B","text":"Central Nervous System i. Fever ii. Loss of consciousness (LOC)/ collapse/ blackouts iii. Seizures iv. Headache/ dizziness/ loss of balance v. Problems in vision/ hearing vi. Tingling (paraesthesiae) vii. Spasms/ involuntary movements/ tics"},{"label":"C","text":"Cardiovascular System @ i. Awareness of heartbeat (palpitations) ii. Shortness of breath (dyspnoea, SOB) “ iii. Difficulty in breathing on lying flat (orthopnoea) iv. 'Air-hunger' at night (paroxysmal nocturnal dyspnoea, PND) v. Lower limb, ankle swelling/ facial puffiness vi. History of bluish discolouration? (cyanosis)"},{"label":"D","text":"Respiratory System i. Chest pain ii. Difficulty in breathing (rapid breathing?, mouth-breathing?) iii. Cough ± sputum iv. Haemoptysis HOODA, Faisal Hasnain 2"},{"label":"E","text":"Gastrointestinal i. Abdominal pain (site: lower/upper, sides/centrally) ii. 'Heart-burn' (dyspepsia) v. Nausea ± vomiting vi. Change in appetite (loss: anorexia) vii. Weight loss / gain viii. Bowel pattern and any change; hard-stools (constipation), diarrhoea ix. Bloody stools; streaks/gross blood, fresh/digested"},{"label":"F","text":"Genitourinary System i. Painful urination (dysuria) ii. Blood in urine/bloody urine (haematuria) iii. Waking up to urinate at night (nocturia) iv. Urgency; an overwhelming desire to micturate v. Incontinence; inability to control urination"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"e66c82d05c9b0dabfdc5a88263c04b076bb946c2"},{"id":"q-0191f35633e6","stem":"Overflow incontinence; urine leakage secondary to retention of urine vi. Change in frequency","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"G","text":"Musculoskeletal System: (limbs, back, joints) i. Weakness ii. Pain/ stiffness iii. Swelling"},{"label":"H","text":"Haematopoietic System i. Easy bruising ii. Bleeding tendencies (ask how long it takes for bleeding to stop if injured)"}],"priority":1,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-3ce63b0c837c","stem":"Index Pregnancy: health of mother during current pregnancy (ask to see RCH card) PITC, VDRL, B/S, urinalysis, urine protein, stool analysis), when?, repeated later? i. Sulphadoxine-Pyrimethamine (SP) for malaria (white tablets)? ii. Antihelminthic treatment (mebendazole)? iii. Iron (red tablets)? iv. Folate (yellow tablets)? v. Tetanus toxoid injection?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"ANC (antenatal clinic); date of first visit at ANC, age of pregnancy at first visit to ANC frequency of attendance (ask to see ANC/RCH card)"},{"label":"B","text":"Illnesses during pregnancy; febrile?, vomiting?, bleeding?, complications?"},{"label":"C","text":"Any tests during pregnancy; (haemoglobin, ABO, Rh, BP, BMI: weight (kg)/ height (m2),"},{"label":"D","text":"Medication use during pregnancy; what, route, duration, compliance"},{"label":"E","text":"Radiation exposure"},{"label":"F","text":"Foetal kicks (quickening in primigravidae:20-24 wks, in multigravidae:16-18 wks)"}],"priority":1,"status":"quarantine","flags":["topic_generic","copyright_only"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"quarantine","auditFlags":["copyright_only","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-532c5f73923a","stem":"Past Obstetric History: list all previous pregnancies in chronological order (first → last) and for each: i. Illnesses during pregnancy; febrile?, vomiting?, bleeding?, complications? j. Complications to child? problems?, feeding difficulties? iii. Resuscitation; required?, how long resuscitated? v. Serious illnesses after birth; congenital malformations?, pallor?, jaundice?, convulsions? vi. Difficulty in sucking, feeding difficulties?, weight loss?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"How many total pregnancies (including terminations)"},{"label":"B","text":"Age at first pregnancy"},{"label":"C","text":"Mode of Delivery; if IOL, C/s why? i. Spontaneous vaginal delivery (SVD) ii. Induction of labour; uterotonic drugs/ artificial rupture of membranes (amniotomy) iii. Caesarean Section (C/s)"},{"label":"D","text":"Duration of pregnancy; pre-term (<37wks), term (37-42 wks), post-term (>42 wks)"},{"label":"E","text":"Place of delivery; hospital/ home (why?)"},{"label":"F","text":"Age, sex of child(ren); (if many, ask for first & last pregnancies)"},{"label":"G","text":"Single pregnancy/ twins?"},{"label":"H","text":"Weight of lightest, heaviest babies i. Complications to mother? (before, during, after delivery) ii. Use of any medication during pregnancy; what, route, duration, compliance iii. Prolonged duration of labour (active phase of 1st stage: normal is <18hrs) HOODA, Faisal Hasnain iv. Abnormal pregnancy; ectopic pregnancy/ molar pregnancy/ 3 v. Termination of pregnancy; spontaneous abortion/ induced abortion i. Birth-weight; (Normal: 2.5-3.5kg, low: 1.5-2.5kg, very low: 1.5-1.0kg, extremely low <1.0kg) ii. State of neonate at birth; any problems during newborn period; jaundice?, breathing iv. Delayed onset of first cry vii. Rashes"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","too_many_options","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-4556d5444349","stem":"Gynaecologic History: i. How much? ii. When it occurs? iii. Contact bleeding (after cleaning-oneself/ intercourse)? iii. Associated backache?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Age at first period? (menarche: prolonged oestrogen exposure risks endometrial hyperplasia± Ca)"},{"label":"B","text":"Last normal menstrual period (LNMP: ask specifically for first day of last menses)"},{"label":"C","text":"Average duration of menstrual cycle (normal is 21-35 days)"},{"label":"D","text":"Duration of bleeding in menstrual periods (normal is <7 days)"},{"label":"E","text":"Amount of bleeding in menstrual periods (how many pads/ tampons/ khangas used, partially-/ fully-soaked) (bleeding >80mls/>3 fully-soaked pads is abnormal)"},{"label":"F","text":"Any abnormal bleeding between periods? (intermenstrual bleeds) (menorrhagia: heavy (>80mls) regular periods/ lasting long (>7 days), metrorrhagia: irregular and frequent uterine bleeding, polymenorrhoea: abnormally frequent <21-day intervals, oligomenorrhoea: abnormally frequent cycle >35-day intervals)"},{"label":"G","text":"Pain during menstruation (dysmenorrhoea)"},{"label":"H","text":"Contraceptive use: oestrogen/progesterone pill (combined oral contraception, COC)/ progesterone-only pill (POP)/ injectable progestogens/ intrauterine contraceptive devices/ progestogen-containing vaginal rings i. Vaginal discharge; duration, quantity, smell, colour, associated blood, rash, itchiness, any symptom in partner j. Feeling of bulge at the introitus (prolapse) i. Feeling of something coming down; stays/goes away overnight or when lying down ii. Leak urine if sneeze, cough"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","too_many_options","topic_generic"],"cleaningOperations":[]},{"id":"q-0ecd7cef0db9","stem":"Sexual History: i. Severity; does intercourse have to stop?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Nature of sexual relationship; none/ single partner/ multiple partners"},{"label":"B","text":"Pain during coitus (dyspareunia; deep pain, and due to endometriosis, PID) ii. Frequency; sometimes (how often?)/at every intercourse iii. Location; superficial (near outside)/ deep on the inside iv. Any other pains in pelvic region other than that caused by sexual activity"},{"label":"C","text":"Post-coital bleeding?"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b8e09d0dad78","stem":"Past Medical History (PMHx)","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Chronic illnesses; Epilepsy, DM, HTN, Cardiac problems, TB, SCD, SLE?"},{"label":"B","text":"Previous admissions; number, reason, when"},{"label":"C","text":"History of trauma/surgical intervention; number, reason, when"},{"label":"D","text":"History of blood transfusions; number, reason, when"},{"label":"E","text":"Medication use; what? (drugs, herbal medication), route, duration, compliance"},{"label":"F","text":"Allergies; food/drugs"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3987571257da","stem":"Family Social History (FSHx)","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Marital status (single/ cohabiting/ married/ separated)"},{"label":"B","text":"Occupation (her + partner/spouse)"},{"label":"C","text":"Education level (her + partner/spouse)"},{"label":"D","text":"Smoking; how many packs (20 cigarettes)?, duration (years)"},{"label":"E","text":"Alcohol use; quantity, frequency of use"},{"label":"F","text":"Home; water source (boiled water?), toilets?, insecticide-treated nets?, ventilation?"},{"label":"G","text":"Hereditary familial illnesses; Epilepsy, DM, HTN, SCD, haemophilia, thalassemia, heart problems"},{"label":"H","text":"Plans for delivery, breastfeeding"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","too_many_options","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"345881b22c2d59a1a06e76d63705342588677d2c"},{"id":"q-42c52d9b31bc","stem":"General Exam: k. Back; normal/kyphosis? (forward bending)/ scoliosis? (lateral bending) /kyphoscoliosis?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Consciousness; (alert/ lethargic/ irritable/ unconscious)"},{"label":"B","text":"Orientation to person, place and time"},{"label":"C","text":"Physique & nutrition (obese/average-build/ wasting/abnormal fat distribution)"},{"label":"D","text":"Febrile/ afebrile (fever?)"},{"label":"E","text":"Dyspnoeic/ not dyspnoeic"},{"label":"F","text":"Anaemia: subconjunctival pallor, tongue, palmar pallor"},{"label":"G","text":"Jaundice: scleral jaundice, earlobes, tongue, nailbed"},{"label":"H","text":"Cyanosis: sublingual frenulum, nailbed i. Oedema; pitting/non-pitting, location (pedal/ pre-tibial/ sacral/ anasarca) j. Superficial lymph node enlargement i. Site & size ii. Discrete (solitary) /matted (joined) iii. Tenderness iv. Surface, edge, consistency (hard/firm/soft, smooth/nodulated) v. Mobility (mobile/fixed) l. Signs of hyperandrogenism: excess hair growth (hirsutes), male pattern baldness, acne, ↑muscle"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["too_many_options","topic_generic"],"cleaningOperations":[]},{"id":"q-863388dd8bf3","stem":"Skin; (surgical scars, traditional marks, stretch marks/shininess, superficial veins)","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Linea nigra (dark pigmented line stretching from the xiphi-sternum ≈midline through the umbilicus to the suprapubic area)"},{"label":"B","text":"Striae gravidarum (recent stretch marks are purplish in colour)"},{"label":"C","text":"Striae albicans (old stretch marks are silvery-white)"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0895f8e8f174","stem":"Superficial: tenderness?","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-101c4331d7cc","stem":"Deep: tenderness?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Left kidney"},{"label":"B","text":"Spleen; (palpable, span below costal margin)"},{"label":"C","text":"Right kidney"},{"label":"D","text":"Liver; i. Span ii. Surface; (soft/firm/hard, regular/irregular, tender/non- tender, nodular/smooth)"},{"label":"E","text":"Gallbladder (murphy’s sign?)"},{"label":"F","text":"Urinary bladder"},{"label":"G","text":"Aorta"},{"label":"H","text":"Rectus abdominis muscle i. Abdominal mass(es) i. Site, size & shape ii. Surface, edge, consistency (hard/soft, irregular/regular, nodular/smooth, round, tender/non-tender) iii. Mobility HOODA, Faisal Hasnain 6 iv. Pulsation j. Guarding / rebound tenderness iii. On percussion; tympanic note/dullness (don’t do for gravid uterus)"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","too_many_options","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"d68bd28aa3ec65b442718fdd3c7792bea0e837d1"},{"id":"q-ff03c473b7a8","stem":"Foetal Heart rate; heard from >24 weeks of gestation (normal is 110-160)","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Place one hand of radial artery to differentiate between maternal and foetal pulses"},{"label":"B","text":"Listen over the foetal back to the foetal heart sounds"},{"label":"C","text":"Rate and the rhythm of the should be determined over 1 min."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b0bb2f1475c1","stem":"Note Inflammation, swelling, soreness, ulceration or neoplasia of the vulva, perineum or anus","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Small warts (condylomata acuminata) appearing as papillary growths may occur scattered over the vulva; these are due to infection with the human papilloma virus (HPV)"},{"label":"B","text":"Clitoris and urethra are inspected"},{"label":"C","text":"Patient is asked to strain and then to cough to demonstrate uterovaginal prolapse or stress incontinence ii. Palpation;"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-1fce1775f0ac","stem":"Ovaries and fallopian tubes iii. Speculum examination","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Sim’s (single-bladed); for display vaginal wall"},{"label":"B","text":"Cusco’s (duck-bill/ bivalve type); for displaying the cervix"}],"priority":1,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-e7f51fda58ad","stem":"Level of the presenting part; measured from ischial spine","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Above (-)"},{"label":"B","text":"At (0) 'the station'"},{"label":"C","text":"Below (+)"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5a50a479384e","stem":"Size and shape of the maternal bony pelvis","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Pelvis and Perineum","topicOriginal":"Pelvis and Perineum","subtopic":"Pelvi","suggestedTopic":null,"options":[{"label":"A","text":"True (anatomical) conjugate: 11.5 cm. From the upper margin of the symphysis pubis to the sacral promontory"},{"label":"B","text":"Obstetric conjugate: 11cm. From the innermost part of the symphysis pubis to the sacral promontory"},{"label":"C","text":"Diagonal conjugate: 12.5cm. From the lower part of the symphysis to the sacral promontory. Can be measured only at patients with a contracted pelvis Alert"},{"label":"C","text":"Central Nervous System: Response to voice (lethargic) i. Central Nervous System Response to pain (obtunded) ii. Higher Centres Unconscious"}],"priority":1,"status":"review","flags":["duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Pelvis and Perineum","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag"],"cleaningOperations":[]},{"id":"q-29f7655d57a7","stem":"Power: (grade 0 - 5)","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Upper limbs"},{"label":"B","text":"Lower limbs"}],"priority":1,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-808a9858f7ba","stem":"Superficial Reflexes: (present/absent)","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"C","text":"Pupillary Light Reflex; (CN II, III) observe direct and consensual constriction of pupils as light is shone into eye(s)."},{"label":"D","text":"Occulocephalic Reflex; (CN III, VI, VIII) movement of the eyes in an opposite direction to head movement."},{"label":"E","text":"Corneal Reflex; (CN V, VII) blinking of eyes on contact with cotton"},{"label":"F","text":"Gag Reflex; (CN IX, X) gag/choking induced as tongue is depressed using tongue spatula."},{"label":"G","text":"Apnoea Reflex; for a ventilated patient, switching-off ventilator evokes a gasping response. HOODA, Faisal Hasnain 8"},{"label":"H","text":"Abdominal Reflex; stroke abdomen gently from flanks → inward. Observe the contraction of the abdominal muscles resulting in deviation of umbilicus towards the area stimulated. i. Anal Reflex; reflexive contraction of the external anal sphincter upon stroking of the skin around the anus j. Babinski Reflex; (down-going/up-going/equivocal)"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-35fbb3222a13","stem":"Deep Reflex; (grade 0-4)","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Biceps (C5, C6)"},{"label":"B","text":"Brachioradialis (C5, C6)"},{"label":"C","text":"Triceps (C6, C7)"},{"label":"D","text":"Finger (C8)"},{"label":"E","text":"Adductor (L2, L3)"},{"label":"F","text":"Knee (L3, L4)"},{"label":"G","text":"Ankle (S1)"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-796761e0a3f7","stem":"Cyanosis: at rest?","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-33606338f3b2","stem":"Arterial Pulses","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Radial"},{"label":"B","text":"Brachial"},{"label":"C","text":"Carotid"},{"label":"D","text":"Femoral"},{"label":"E","text":"Popliteal"},{"label":"F","text":"Pedal (dorsalis pedis)"},{"label":"G","text":"Middle maleolar"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"4715853f306894c6a49ed567f34bb80f1880bc5e"},{"id":"q-0496cea01df2","stem":"Breath sounds","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","tex