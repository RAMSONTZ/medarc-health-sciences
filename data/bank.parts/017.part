eral","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-37a293b948ff","stem":"area will be highlighted with a yellow – mimic lower ureteric stones oval. Can you identify phleboliths?","type":"Image / Diagram Question","subject":"General Surgery","topic":"Urology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Urology","options":[],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"General Surgery","displayTopic":"Urology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-1f4433a30407","stem":"YES Early? Sonography","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4cacb1b3eec1","stem":"Diagnosis? CT- Abdomen","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0360cf58f626","stem":"Orientation to clinical practice","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Describe elements of clinical thinking"},{"label":"B","text":"Describe the principles of Doctor-Patient relationship."},{"label":"C","text":"Describe the components of medical communication."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7e05909191f7","stem":"Communication skills and history taking","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Be able to explain the meaning of history taking as a beginning of Doctor - Patient relationship"},{"label":"B","text":"Identify verbal and non verbal communications in the interaction between Doctor and Patient and interpret them. 4"},{"label":"C","text":"Be able to take relevant l history of a patient with (Pediatric, Medical, Obstetrics and Gynaecology ,General surgery and other specialties e.g. (ENT, Ophthalmology, Dental, Urological) problems reflecting clinical thinking,desrcribing action plan and discuss it with the patient the management plan of his/her problem d)"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-f6d92c43956b","stem":"Physical Examination Describe principles of physical examination and be able to apply them meaningful","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Perform Physical and systemic examination on peers/phantom and report findings"},{"label":"B","text":"Identify ,categorize and describe main pathological findings in Physical and systemic examination"},{"label":"C","text":"Describe the concept of Physical examination and Doctor-Patient relationship"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-52db77374eb5","stem":"Clinical laboratory skills","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Labor and Delivery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Labor and Delivery","options":[{"label":"A","text":"To Describe the roles of laboratory in clinical diagnosis"},{"label":"B","text":"Identify and describe basic principles for laboratory specimen collection, transportation, preparation and examination of blood chemistry including CSF chemistry etc."},{"label":"C","text":"Process and interpret results of most common Laboratory investigations"},{"label":"A","text":"Including: urine, stool, blood (BS) in relation to clinical presentation"},{"label":"D","text":"Describe and perform common laboratory culture examinations of urine,stool,blood and other fluids"},{"label":"E","text":"Describe and perform Gram stain and Acid Fast Bacilli from sputum f)"}],"priority":1,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Labor and Delivery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-1dc68b2ec902","stem":"Basic Pathology and Post Mortem Skills","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Role of Pathology in clinical diagnosis"},{"label":"B","text":"Principles of Post Mortem examination"},{"label":"C","text":"Describe microscopic Post Mortem examination d)"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-14f4f13194a0","stem":"Clinical Problem Analysis","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Describe the steps in Clinical problem Analysis and construct problem list for a given clinical case"},{"label":"B","text":"Identify problem list in a given clinical case and discuss differential diagnosis list"},{"label":"C","text":"Describe Action plan following the process of CPA"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ce0dc901b395","stem":"Basic and advanced Life Support","type":"Single Best Answer MCQ","subject":"Emergency Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Describe the Basic and advanced Life Support measures"},{"label":"B","text":"To perform ABC of basic and advanced life support, (triage, intravenous lines and intubations)"},{"label":"C","text":"To manage transportation of injured patient to a nearby health facility"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Emergency Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e78b0ed41a41","stem":"Theatre and Aseptic Skills","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Describe the basic principles of operating theatre, safety and organization"},{"label":"B","text":"Perform basic aseptic techniques related with operating theatre/surgical/aseptic activities"},{"label":"C","text":"Rehearsals of Basic Life Support Skills ,then practice Advanced Trauma Life Support"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3a4ef4235527","stem":"Bed Side learning (When feasible)","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Short cases for Physical examination"},{"label":"B","text":"Long cases for clerking and reporting on model of patients file 5 CHAPTER 4 BLOCK PROGRAM"}],"priority":1,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-4091144527b0","stem":"2.6 SSA-2 Title: General/ Physical Examination Objectives:  To be able to describe an overview of a general impression of physical examination  To be able to describe an overview of a comprehensive physical Examination. Introduction: Most people who seek health care have health-related worries or symptoms. Thorough physical examination may help both to identify such concerns and to explain the symptoms. It gives the information to answer the patient’s questions, offers the opportunities for health education and provides baseline valuable data for future use. Physical examination may be viewed in some respect secondary to the history. Instructions:  Read Hutchinson’s clinical methods (recent edition) on general and physical examination  Additional reading Barbara Bates (recent edition) on a chapter of Physical Examination (overview and approach)  After reading the chapter you should be able to answer the following questions:  What is the order of general approach in P/E?  What are the skills to minimize patient discomfort?  What are the components of a comprehensive P/E, general survey, vital signs? Results: The answers to the above questions Outcome:  You should describe an overview of a general impression of physical examination  You should describe an overview of a comprehensive physical Examination. (W.G.6.2.7./6.2.8)","type":"Clinical Vignette","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-03cfd67b1184","stem":"2.2 SSA 1 Title: Physical examination of head and neck Background: For completeness of general examination and those complaining of head and neck symptoms, thorough physical examination of head and neck needs to be done. Leaning Objectives: To understand the anatomy of head and neck To be able to do physical examination of head and neck Instructions: o Read Hutchinson’s clinical methods 22nd edition, pages 412 - 414 on clinical examination of head and neck o Additional reading Barbara Bates’ on physical examination of head and neck List of questions to be answered:  List four diseases which have characteristic facial appearance  Which group of lymph glands are enlarged in the following conditions? Tonsillitis, TB, HIV, Cancer lesion in the mouth.  Why is it important to examine the neck from behind? Results: Student must be knowledgeable of the answers submitted of the listed questions and be ready for discussion in section 8.2.5 WG2 Student should know how physical examination of the head and neck is performed Outcome: student should be able to perform examination of head and neck correctly in 8.2.5 WG 2 Evaluation: Will be done in section 8.2.5 WG2","type":"Essay / Structured Essay","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Head","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-62ccddaa2b16","stem":"2.3 SSA 2 Title: Physical examination of the breast Background: Breast require thorough physical examination as a part of general examination and for the patients with breast symptoms since it is prone to get infection, benign and malignant lesions. Leaning Objectives: To understand the anatomy and hormonal influences on the female breast To be able to perform physical examination of breast Instructions: Read Hutchinson’s clinical methods 22nd edition page 17-18 on clinical examination of breast Additional reading; - Macleod’s clinical examination, 11th edition chapter 7page 198-203 - Das Manual on clinical surgery, 10th edition chapter 30 page 410- 433 22 List of questions to be answered: Students should answer the following questions during their reading  Define terms peau d’orange, mastalgia, galactorrhea and gynaecomastia.  Why types of nipple discharge are important in breast diseases?","type":"Essay / Structured Essay","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-36144c58a5d8","stem":"2.2 SSA Title: Physical Examination of Head and Neck Instructions: Tutor will instruct the students to go to the library and read the following","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Brief Anatomy of head and neck"},{"label":"B","text":"Disease characteristic of facial appearance"},{"label":"C","text":"Group of lymph nodes in a neck region"},{"label":"D","text":"Importance of examining the neck from behind Product: Students have knowledge on head and neck and a prepared to appear in Group work 8.2.5 Reference: Hutchinson’s Clinical methods on examination of head and neck (Recent edition) Additional Reading: Barbara Bates on Physical examination of head and neck (Recent edition)"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4c1a5e977872","stem":"2.3 WG Title: Examination of breast Instruction: Tutor will instruct the students to go to the library and read the following","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Breast and Endocrine Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Breast and Endocrine Surgery","options":[{"label":"A","text":"Anatomy and physiology of Breast"},{"label":"B","text":"Technique of Physical examination of Breast"},{"label":"C","text":"Types of nipple discharge"},{"label":"D","text":"Define terms like Peau de orange, mastalgia, galactorea, Gynecomastia"},{"label":"E","text":"Groups of lymph nodes in the axillae Product: Students must be able to submit the answered list of questions for discussion in section 8.2.6 WG3 Evaluation: Will be done in section 8.2.6 WG3"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Breast and Endocrine Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-450aad047644","stem":"2.4 WG Title: History taking and examination in a patient with surgical problem Instruction: Student will be divided in small groups and briefly will review the common symptom and physical signs in surgical conditions","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Under tutor’s guide, students will Practice history taking technique in patient with swelling, ulcer, fistula and wounds"},{"label":"B","text":"Under tutor’s guide, students will practice physical examination technique in patient with swelling, ulcer, fistula and wounds and other surgical problems. Product: At the end of this WG students should be able to take history and perform physical examination in patients with surgical condition."}],"priority":1,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-0d75931198e6","stem":"2.5 WG Title: Examination of Head and neck Instructions","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The tutor demonstrates a systematic examination of head and neck"},{"label":"B","text":"Students are divided into small groups and practice Physical Examination of head and neck in peers under the supervision of a tutor Product: Students are now able to examine head and neck on their own 28"}],"priority":1,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-e12c84439a99","stem":"2.6 WG Title :Examination of the Breast Instruction","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Breast and Endocrine Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Breast and Endocrine Surgery","options":[{"label":"A","text":"The tutor demonstrate the systematic examination of a breast on a model"},{"label":"B","text":"The tutor divides students into small groups"},{"label":"C","text":"Students perform systematic examination of a breast on models and if possible on selected patients under guidance of the tutor Product: Students will be able to perform a systematic breast examination"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Breast and Endocrine Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-78cc4dcf1338","stem":"2.7 Lecture Title: History taking in locomotor system Instruction :The tutor prepares a lecture on history taking in locomotor system to cover the following","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Brief anatomy and physiology of locomotor system"},{"label":"B","text":"Gathering information in locomotors system (Muscle,Joints(location,swelling,redness,tenderness,weakness,movement and limitations )"},{"label":"C","text":"Special technique for lower back pain with radiation."},{"label":"D","text":"Carpal tunnel syndrome (Phalens test,Tinels sign)"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-becdee21945c","stem":"2.8 WG Title: Practical Examination of locomotor system Instructions","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The tutor demonstrates examination of locomotor system in selected student/patient"},{"label":"B","text":"Students are instructed to examine locomotor system in a peer and the tutor gives feedback Product: Students are now able to examine locomotor system systematically"}],"priority":1,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-7fcb447bb062","stem":"2.10 SSA Title: Male urethral catheterization and Digital Rectal Examination Instructions: The tutor instruct the students to go to library and read the following","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Indications for male urethral catheterization"},{"label":"B","text":"Preparing the patient for male catheterization including consent, Privacy"},{"label":"C","text":"Aseptic technique for catheterization"},{"label":"D","text":"Urine sample collection and measuring urine volume"},{"label":"E","text":"An approach to digital rectal examination 29"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-9737b3e69350","stem":"2.11 WG Title: Male Urethral Catheterization and Digital rectal examination Instructions","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The tutor will divide the students into small groups"},{"label":"B","text":"Under guidance of a tutor students will practice male urethral catheterization and Digital rectal examination on models and if possible to the selected patients"}],"priority":1,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-38a6c93f0b63","stem":"2.12.SSA Title: Operating theatre aseptic technique Instructions: The tutor will instruct the students to go to library and read the operating theatre techniques with emphasis on","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Scrubbing"},{"label":"B","text":"Gowning"},{"label":"C","text":"Donning Reference :Hutchison’s clinical methods and Das Manual on Clinical Surgery"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d2acbde684b8","stem":"2.13 SSA Title: Practical Therapeutic procedures Instructions: The tutor instructs the students to go to library on their own and read different types of therapeutic procedures. This will include","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Aspiration"},{"label":"B","text":"Injection of joints, bursae and tendons"},{"label":"C","text":"Wound dressing"},{"label":"D","text":"Surgical knots"},{"label":"E","text":"Wound suturing technique"},{"label":"F","text":"Incision and drainage of an abscess"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1a2a2e15ca21","stem":"2.2 SSA-1 TITLE: Microscopic examination of blood, stool and urine parasites INTRODUCTION: To be able to understand parasites thorough examination of parasites needs to be done LEARNING OBJECTIVES: To understand parasites of blood, stool and urine INSTRUCTIONS: Read materials uploaded on LCMS, Monica Cheesbourgh and atlas of microscopy of parasites Answer the following questions: What are the common blood parasites? What are the common stool parasites? What are the common urine parasites? RESULT: Student should be able to mention and identify parasites from blood, stool and urine sample OUTCOME: Students identify parasites in blood stool and urine under microscopes in WG1","type":"Image / Diagram Question","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-69c68ef7e795","stem":"2.3 SSA-2 TITLE: Basic Hematology and blood transfusion tests 38 INTRODUCTION: For medical students to be competent in interpreting blood parameters for patient management, they have to be taught on collection of blood samples, complete blood count, ESR, Sickling test and HB estimation. LEARNING OBJECTIVE: Student should understand types of blood samples and how to collect each. Students should understand all parameters of CBC and read on sickling test, ESR, Hb estimation, blood grouping and X-match INSTRUCTIONS: Read materials uploaded on LCMS, Monica, Atlas of blood cells Answer the following questions Mention types of blood samples and explain how they are collected or prepared What are the parameters of CBC and how are they interpreted? How do you perform a sickling test ESR and HB, blood grouping and X-match? RESULT: Student able to collect blood sample and perform haematological and blood transfusion tests PRODUCT: Student demonstrate the skill in WG 3 to 5","type":"Clinical Vignette","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-554ab18daa9c","stem":"2.7 SSA 2 TITLE: Human skin Objective: • To be able to learn and understand the different layers of the skin, the cells on each layer and functions Introduction: Human skin is one of the largest organs in the body, understanding well the human skin will give us a good clue on what is happening inside the human body which can be projected on the skin. Instructions: Read the book by Andrew’s (Latest Edition) on anatomy of the skin. Hutchinson’s Clinical Method on a section of clinical specialties (Skin, Nails and Hair) Questions to be answered -What are the layers, the cells and receptors of the skin? - What are the accessory organs of the skin? -What is the function of the skin? Results: Students should be able to mention and describe in details all layers of the skin, cells and receptors. Students should be able to mention the functions of the skin and give feedback in WG 9 Outcome: You should be able to answers the questions.","type":"Short Answer","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-39cb7075ed01","stem":"2.17 WG-4 TITLE: History taking and examination of a patient with dermatological conditions Background: Skin disease may be difficult to diagnose without a proper skills in history taking and Physical examination. Practicing history taking and examination is important in order to get the clue of the diagnosis Objectives • To practice how to take history from a patient and elicit the relevant information about the condition • To practice systematic Physical examination, special areas such as mucous membrane and skin appendages in a patient with skin disease • To practice how to identify and describe the primary and secondary dermatological lesions on a patient with dermatological condition. Instructions","type":"Single Best Answer MCQ","subject":"Dermatology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Tutor demonstrates how to interview and examine the patient with skin condition."},{"label":"B","text":"Tutor demonstrates how to identify and describe skin lesions on a patient with skin disease"},{"label":"B","text":"Students will break into small groups and practice with selected patients or among themselves. Tutor goes around observing and giving feedback Product At the end of the working group, students should be able to take history, perform systematic Physical examination including identifying and describing skin lesions on a patient with dermatological condition."}],"priority":1,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Dermatology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-17d8f312579b","stem":"Download and read the PDF file- ‘Diagnostic Imaging: What is it? When and how to use it where resources are limited?’ from the World Health Organization website link given in the reference list. Then answer the questions below. Questions","type":"Short Answer","subject":"Radiography and Medical Imaging","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Radiography and Medical Imaging","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7516c7bd5485","stem":"Which imaging modalities are safest to use during pregnancy?","type":"Short Answer","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2cf22f65513b","stem":"Which imaging modality would you use to investigate a new born baby with suspected brain hemorrhage?","type":"Short Answer","subject":"Radiography and Medical Imaging","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Radiography and Medical Imaging","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c9c3e5487d65","stem":"What is the disadvantage of requesting a skull radiograph for a patient with head injury?","type":"Radiological Interpretation","subject":"Radiography and Medical Imaging","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Radiography and Medical Imaging","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-44c506f7c42b","stem":"What is the limitation of abdominal x-ray in investigating a patient with blunt trauma?","type":"Radiological Interpretation","subject":"Emergency Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Emergency Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","