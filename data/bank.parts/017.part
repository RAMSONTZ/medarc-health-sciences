publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6dd560241ab6","stem":"Mention the pre-procedural preparation for a patient who is to undergo an IVU under fluoroscopy.","type":"Clinical Vignette","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c496e156b74e","stem":"Mention the pre-procedural preparation for a patient who is to undergo barium studies. Learning outcome At the end of this session the student should be able to order various contrast radiological investigations appropriately as per indications. Evaluation: Will be done as a group discussion during the session References: Online PDF file","type":"Essay / Structured Essay","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic","possible_web_capture_contamination"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["possible_web_capture_contamination","topic_generic"],"cleaningOperations":[]},{"id":"q-6ffeb1a91041","stem":"2.7. Lecture 3. Title: Systematic interpretation and reporting of radiographs In this session students are being lectured on","type":"Radiological Interpretation","subject":"Radiography and Medical Imaging","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"General principles on how to interpret radiographs"},{"label":"B","text":"The importance of proper documentation of clinical features in the request forms in order to facilitate the radiological interpretation"},{"label":"C","text":"Understanding the principles of reading, interpretation and reporting of x-ray films and the consequences of the submitted results."},{"label":"D","text":"The rationale to dispatch urgent results in emergency clinical conditions. Reference: PDF file: General principles- How to interpret radiographs by Otto Chan, Robin Touquet"}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Radiography and Medical Imaging","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-91f8fe1b4450","stem":"2.1 Lecture 2 Title History Taking In ENT Learning Objectives Students should be lectured to understand the technique of history taking in a patient with ENT problem Instructions Tutor to prepare a presentation on techniques of history taking in a patient with ENT problem. The contents will include","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Brief Anatomy of Ear, Nose and Throat"},{"label":"B","text":"Approach in ENT History taking References Hutchinson’s Clinical Methods on history taking in ENT ( Resent Edition) Additional Reading  Barbara Bates on Chapter of Physical Examination of ENT (Resent Edition)  P.L Dhingra:Diseases of Ear ,Nose and Throat(Resent Edition Questions to be answered in WG 1"}],"priority":1,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-2c08f195aa82","stem":" What do they understand by the term communication skills?","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-29899ac0d962","stem":" What is the difference between communication skills and history taking?","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a406d1919ab4","stem":" What are the skills to minimize patient discomfort?","type":"Clinical Vignette","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Gene