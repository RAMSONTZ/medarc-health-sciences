; Helms, Clyde A.; Lippincott Williams & Wilkins (c) Diagnostic Nuclear Medicine, Lippincott Williams & Wilkins Online www.medicalimaging.org/about-mita/medical-imaging-primer/ www.who.int/diagnostic_imaging/imaging_modalities/en/ PDF file: http://whqlibdoc.who.int/hq/2001/WHO_DIL_01.1.pdf","type":"Essay / Structured Essay","subject":"Radiography and Medical Imaging","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic","possible_web_capture_contamination"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Radiography and Medical Imaging","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["possible_web_capture_contamination","topic_generic","url_or_navigation_embedded"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-bb955a910b69","stem":"What contrast agent is used in CT of the head with contrast and how would you treat a patient who suffers from anaphylactic reaction during the procedure?","type":"Clinical Vignette","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b547ba7a35d1","stem":"What equipments should be available in a room in which a contrast study takes place?","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","f