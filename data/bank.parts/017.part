[{"label":"A","text":"Heart Sounds"},{"label":"A","text":"S1, S2"},{"label":"B","text":"Extra heart sounds (gallop rhythm: S3/S4)"},{"label":"C","text":"Murmurs One. Loudness; grade (1-6) Two. Quality; pitch(low/medium/high) Three. Location; best heard at (aortic/pulmonary/tricuspid/mitral) area Four. Timing; (systolic/diastolic/ continuous) v. Other areas (report only if necessary)"}],"priority":1,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-33da9714c91c","stem":"Respiratory rate","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Rate (breaths per minute, dyspnoeic)"},{"label":"B","text":"Rhythm (regular/ irregular)"}],"priority":1,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-cf4fc6cc943b","stem":"Deep: tenderness?","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Left kidney"},{"label":"B","text":"Spleen; (palpable, span below costal margin)"},{"label":"C","text":"Right kidney"},{"label":"D","text":"Liver; i) Span ii) Surface; (soft/firm/hard, regular/irregular, tender/non-tender, nodular/smooth) HOODA, Faisal Hasnain 9"},{"label":"E","text":"Gallbladder (murphy’s sign?)"},{"label":"F","text":"Urinary bladder"},{"label":"G","text":"Aorta"},{"label":"H","text":"Rectus abdominis muscle i) Abdominal mass(es) i) Site ii) Size & shape iii) Surface, edge, consistency (hard/soft, irregular/regular, nodular/smooth, round, tender/non-tender) iv) Mobility v) Pulsation j) Guarding / rebound tenderness iii. On percussion; tympanic note/dullness"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","too_many_options","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"d68bd28aa3ec65b442718fdd3c7792bea0e837d1"},{"id":"q-ac2c21ce66b6","stem":"d. Birth; place, method of delivery (SVD / C-Section: if so, why?)","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4f85b8454ccb","stem":"h. If IDS (for how long, baseline CD4 count & current CD4 count, ART regimen?, TMP-SXT","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"opt