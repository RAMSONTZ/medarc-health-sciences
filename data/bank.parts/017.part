tatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-aea38238434b","stem":"iv. Painful swallowing (odynophagia); of solids ± liquids?","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1946f82fa757","stem":"x. History of yellowish discolouration (jaundice)?","type":"Clinical Vignette","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4100ffe93163","stem":"when the intra-abdominal pressure is raised (e.g. coughing/sneezing).","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b80fd528c2bd","stem":"j. Complications to child?","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1f63ea01b892","stem":"ii. State of neonate at birth; any problems during newborn period; jaundice?, breathing","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-abb853b6b215","stem":"problems?, feeding difficulties?","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-585c8109d4a5","stem":"iii. Resuscitation; required?, how long resuscitated?","type":"Short Answer","subject":"Emergency Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Emergency Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-bdcebf34ab62","stem":"v. Serious illnesses after birth; congenital malformations?, pallor?, jaundice?, convulsions?","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3976ce7afc12","stem":"vi. Difficulty in sucking, feeding difficulties?, weight loss?","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-aff5efaf9971","stem":"iii. Associated backache?","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c8847574ae65","stem":"https://radiopaedia.org/articles/stress-fracture-2?lang=us","type":"Short Answer","subject":"General Surgery","topic":"Trauma and Emergency Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Trauma and Emergency Surgery","options":[],"priority":1,"status":"quarantine","flags":["topic_generic","path_or_binary"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Trauma and Emergency Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"quarantine","auditFlags":["path_or_binary","prior_structural_review_flag","topic_generic","url_or_navigation_embedded"],"cleaningOperations":[]},{"id":"q-802b9e4dd441","stem":"Always auscultate before touching the abdomen . Touching the abdomen, even to percuss, may change the bowel sounds. The order for examining the abdomen is: Inspection, auscultation, percussion, palpation Before you proceed, consider your patient's comfort. Is your stethoscope warm? Are your hands warm? Are your fingernails short? Has the patient emptied his/her bladder?","type":"Clinical Vignette","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a0b306e2b362","stem":"Is the abdomen of normal contour and fullness, or distended? Is it scaphoid (sunken)? Generalized fullness or distension may be due to fat, fluid, flatus or feaces. Localized distension may be symmetrical and centred around the umbilicus; in small bowel obstruction, or asymmetrical as in gross enlargement of the spleen and liver","type":"Short Answer","subject":"General Surgery","topic":"Abdominal Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Abdominal Surgery","options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Abdominal Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7a1c3a9e5c75","stem":"When a swelling in the abdomen is palpable first make sure that it is not a normal structure. The aim of examination of a mass is to decide the organ of origin and the pathological nature. In doing this it is helpful to bear in the mind the following points.","type":"Short Answer","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-c891bf456d87","stem":"When the swelling is completely fixed it usually signifies one of three things: 1. A mass of retroperitoneal origin e.g. pancreas. 2. Part of advanced tumour with extensive spread to the abdominal walls or organs. 3. A swelling resulting from severe chronic inflammation of other organs.","type":"Short Answer","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-df655e711dd7","stem":"WHEN ABDOMINAL MASS IS PALPABLE","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Contâ€¦."},{"label":"B","text":"SIZE AND SHAPE"},{"label":"C","text":"SURFACE, EDGE AND CONSISTENCY."},{"label":"D","text":"MOBILITY AND ATTACHEMENTS"},{"label":"E","text":"Contâ€¦."},{"label":"F","text":"Contâ€¦"}],"priority":1,"status":"review","flags":["topic_generic","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_text","nonunique_option_text","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-cb2333ccd370","stem":"To ventilate patients via a LMA but care must be taken when doing this to avoid high inflation pressures. Why?","type":"Clinical Vignette","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d664d5849df6","stem":"When a difficult airway is encountered, the anesthesiologist must respond quickly and decisively. The anethesiologist needs to be prepared.","type":"Short Answer","subject":"Anesthesiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Anesthesiology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c2114a7d74d6","stem":"Why have an Autopsy done","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-96df0d94c996","stem":"HOW TO PREPARE A THIN FILM","type":"Short Answer","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7d981f555b4a","stem":"On regular meds?","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d4995037cb62","stem":"What has already been done?","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-622a0b4ce6dd","stem":"Any history of admission i. When? ii. What was the problem (diagnosis)? iii. Where was he/she attended iv. What kind of treatment/management given? v. Did it resolve (was the patient satisfied)?","type":"Clinical Vignette","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b4558abe18b2","stem":"How many people living together in the house?","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d4f42382de72","stem":"General appearance, ill?","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f7adcdf80452","stem":"List positive prognostic factors","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2fc08d684b84","stem":"List negative prognostic factors","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-816d10da04c3","stem":"ALCOHOL DRINKING ó Units of alcohol (1 unit contains 10 g of pure alcohol) Vol in mls ó The units of alcohol can be determined by the formula Î % alc by vol 1000 ó For example, 1 pint (568 ml) of beer at 3.5% abv (alcohol by volume) contains: (568 × 3.5) / 1000 = 1.988 units. ó It is important to bear in mind that alcohol strength varies widely within each category of drink, but here is a guide to the most common alcoholic drinks: ⁕ Standard-strength beer (3.5% abv): 1 pint = 2 units ⁕ Very strong lagers (6% abv): 1 pint = 3.5 units ⁕ Spirits (whisky, gin, etc., 40% abv): 1 UK pub measure (about 25 ml) = 1 unit ⁕ Wine (12%): 1 standard glass (175 ml) = 2 units ó Both men and women should keep to less than 14 units of alcohol per week. ó The CAGE assessment for alcohol dependency ⁕ C – Have you ever felt the need to Cut down your alcohol consumption? ⁕ A – Have you ever felt Angry at others criticizing your drinking? ⁕ G – Do you ever feel Guilty about excess drinking? ⁕ E – Do you ever drink in the mornings (Eye-opener)? ⁕ Two or more positive answers could indicate a problem of dependency","type":"Calculation","subject":"Ophthalmology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Ophthalmology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-92c92f1e5ef4","stem":"COMMON INVESTIGATIONS KCMC ó Labs mailto: kenedybaumba@gmail.com Kenny_onewiso ó Imaging ó Cytology SYSTEMIC EXAMINATION","type":"Single Best Answer MCQ","subject":"Radiography and Medical Imaging","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"CVS: expose chest to waist. Position: cardiac bed or sitting. Inverted J is the preferred way. ó HANDS [ Inspection ¥ Color (palor) ¥ Nicotine staining ¥ Finger clubbing ¥ Splinter hemorrhage ¥ Osler’s node [ Palpation ¥ Temperature ¥ Capillary refill time (CRT) ¥ Radial pulse • Rhythm • Rate • Volume • Character • Other radial present ó ARMS [ Measure BP (Principally should be both arms) ó JVP [ Measure JVP [ Hepatojugular reflex test ó FACE [ EYES ¥ Conjunctival palor ¥ Xanthelasma [ MOUTH ¥ Central cyanosis ¥ Angular stomatitis ¥ High arched palate (Marfan’s syndrome) ó CHEST [ Inspection ¥ Surgical scars ¥ Traditional marks ¥ Pectus carinatum Vs excavatum ¥ Visible pulsation mailto: kenedybaumba@gmail.com Kenny_onewiso [ Palpation ¥ Apex beat ¥ Heaves ¥ Thrills [ Percussion [ Auscultation ¥ Auscultate the four heart valves ó SACRAL EDEMA [ Inspect and palpate the sacrum for evidence of pitting edema ó LEGS [ Inspect and palpate for evidence of pitting edema of lower limbs"},{"label":"B","text":"RS"},{"label":"C","text":"GI"},{"label":"D","text":"Nervous system"},{"label":"E","text":"GU Describing vomitus"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Radiography and Medical Imaging","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","topic_generic"],"cleaningOperations":["option_whitespace_normalization","whitespace/page_marker_normalization"]},{"id":"q-7d6d78229bea","stem":"⁕ G – Do you ever feel Guilty about excess drinking?","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-17aef0350732","stem":"⁕ E – Do you ever drink in the mornings (Eye-opener)?","type":"Short Answer","subject":"Ophthalmology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Ophthalmology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-cf64544d4d62","stem":"Retroperitoneal eg perirenal Activity the5. Intramural read and below link the pathologies Access6. In the billiary system abdominal on tutorialhttp://www.radiologymaster­ class.co.uk/tutorials/abdo/abdo­ men_x-ray_abnormalities/patholo­ gy_introduction Kilimanjaro Christian Medical University College Interpreting abdominal radiographs Fluid levels A 68 year olf female presented with progressive abdominal distension,• Stomach vomitting and absolute constipation. What does her radiograph reveal? – Always (except supine film) Roll over image to reveal additional view. Name the two vies.• Small Bowel – Two or three levels possible – The proximal duodenum • Large Bowel – None normally Free intraperitoneal fluid Check for free intraperitoneal fluid, it dis­ olaces the properitoneal fat line laterally. Kilimanjaro Christian Medical University College Interpreting abdominal radiographs Can you identify the abnormal clacifica­Calcifications tion in the radiograph below? When you roll over the right spot the• Phleboliths area will be highlighted with a yellow – mimic lower ureteric stones oval. Can you identify phleboliths? – more rounded – Often multiple • Mesenteric nodes – mimic renal/ureteric stones • Costal cartilages • Prostate – Lies central below the bladder • Seminal Vesicles – serpiginous in appearance – lie behind the bladder Kilimanjaro Christian Medical University College Interpreting abdominal radiographs Soft tissue and bones • The bladder – density arising from the pelvic floor • Fat lines – fat surrounding the internal solid organs – properitoneal fat line • adjacent to the parietal layer of peritoneum in the flanks • Renal outlines – Position, orientation, size • Psoas shadows – Symmetrical with concave lateral borders Kilimanjaro Christian Medical University College Interpreting abdominal radiographs Foreign body and artifarcts • Artifarcts may be due to – objects placed external to the body or internally such as medical devices. – Marks on the film due to poor handling or processing – Dirt on the cassette • Foreign body – Often ingested – May be forgotten surgical tools Kilimanjaro Christian Medical University College Interpreting abdominal radiographs ABCs of emergency abdominal radiographs Diagnosis?","type":"Radiological Interpretation","subject":"Radiography and Medical Imaging","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Air – search for free intraperitoneal/abnormal air"},{"label":"B","text":"Bowel gas pattern"},{"label":"C","text":"Calcifications"},{"label":"D","text":"Densities – foreign bodies/tablets"},{"label":"E","text":"Edges – hernial orifice/ lung bases"},{"label":"F","text":"Fat planes – Psoas, Kidneys, Properitoneal S. Soft tissue and skeleton Otto Chan, et al Kilimanjaro Christian Medical University College Requesting abdominal radiographs Best practise Kilimanjaro Christian Medical University College Imaging Pathway in acute abdomen Selected conditions Perforation/ Obstruction Diverticulitis, Appendicitis Pancreatitis,Cholecistitis YES Early? Sonography NO YES AXR +/- CXR NO NO Diagnosis? CT- Abdomen YES YES GOOD WORK Kilimanjaro Christian Medical University College Take home message • Clinicians need to identify surgical emergencies • Imaging aids in confirmation of diagnosis and risk stratification • Plain radiographs are useful screening tools in suspected intestinal obstruction/perforation • Ultrasound is a safe option in imaging of young children and pregnant women • The choice of modality to employ depends on the suspected condition Kilimanjaro Christian Medical University College Bibliography"}],"priority":1,"status":"review","flags":["probable_document_or_multiple_questions","topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Radiography and Medical Imaging","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["long_option_manual_review","long_stem_manual_review","prior_structural_review_flag","probable_document_or_multiple_questions","requires_visual_review","topic_generic","url_or_navigation_embedded","visual_asset_not_transcribed"],"cleaningOperations":["option_whitespace_normalization","whitespace/page_marker_normalization"]},{"id":"q-0b0e122ac141","stem":"What is an acute abdomen?","type":"Short Answer","subject":"General Surgery","topic":"Abdominal Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Abdominal Surgery","options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Abdominal Surgery · Suggested","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0dc70dfdb036","stem":"Which investigation should you request? . . 8","type":"Short Answer","subject":"General Surgery","