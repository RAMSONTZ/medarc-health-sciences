_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-03b143b37a49","stem":"Compare : expansion both sides, look for asymmetry","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-534e6c6c6e96","stem":"Compare notes from: the same sites on both sides","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ac67b95ff456","stem":"Compare both sides & avoid auscultation at or near midline","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7ab8c377ac08","stem":"Site & Size: where they are & how large (?>1cm)","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b94780f17e82","stem":"<?xpacket begin='ï»¿' id='W5M0MpCehiHzreSzNTczkc9d'?>","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2333b00be20f","stem":"<?xpacket end='w'?>","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"ÿâ"},{"label":"B","text":"XICC_PROFILE"},{"label":"C","text":"mntrRGB XYZ"},{"label":"D","text":"acspMSFT"},{"label":"E","text":"IEC sRGB"},{"label":"F","text":"Copyright (c) 1998 Hewlett-Packard Company"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["source_attribution_in_option","topic_generic"],"cleaningOperations":[]},{"id":"q-64df905f513b","stem":"Medicine for adults ?> 13Years","