c":null,"options":[{"label":"A","text":"TRUE Of early onset, the causative agent is usually similar to those of community"},{"label":"B","text":"TRUE Dental and sinus infections are among the risk factors"},{"label":"C","text":"FALSE Is the first commonest hospital acquired infection"},{"label":"D","text":"FALSE It occurs within 24 hours of hospital admission TRUE Post- operative patients are at risk"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Respiratory","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-dbbdb45ff1ed","stem":"A patient suspected of having tuberculosis of adrenal gland may present with the following","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Renal and Urinary","topicOriginal":"Renal and Urinary","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"TRUE Nausea and vomiting"},{"label":"B","text":"TRUE Hypotension"},{"label":"C","text":"FALSE Hypernatremia"},{"label":"D","text":"FALSE Hypokalemia"},{"label":"E","text":"TRUE Pigmentation of sun-exposed areas 14"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Renal and Urinary","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"63b53ae8a5a123eeb6395eefdcd65df69729c96f"},{"id":"q-52b63a8c28b8","stem":"The following are the differential diagnosis of a patient present with crepitations during auscultation of the chest: F. FALSE Myocardio Infarction G. FALSE Acute bronchitis H. TRUE Pneumonia I. TRUE Heart failure J. FALSE Bronchial asthma","type":"Short Answer","subject":"Community Medicine","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7a8b4d7157a4","stem":"Gastric lavage is Indicated in the following poisonings","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Gastrointestinal","topicOriginal":"Gastrointestinal","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"FALSE Acid"},{"label":"B","text":"FALSE Kerosene"},{"label":"C","text":"TRUE Mushroom"},{"label":"D","text":"TRUE Organosphate"},{"label":"E","text":"FALSE Alkali 15"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Gastrointestinal","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"008506bcd0c99cfcff044d0b2355eec8829afd02"},{"id":"q-f82e68bbc2b3","stem":"The following are correct concerning administration of Cotrimoxazole prophylaxis","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"TRUE All patients who are in WHO clinical stage II,III,IV"},{"label":"B","text":"FALSE All asymptomatic HIV infected individual CD4>350"},{"label":"C","text":"FALSE HIV positive patient allergic to sulfur"},{"label":"D","text":"TRUE All HIV infected pregnant women"},{"label":"E","text":"FALSE Dosage should be twice daily"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"a98d82a82a3e16d7db23b5f65e18b4c49c479d8b"},{"id":"q-c0fbde991552","stem":"Match the following oral hypoglycemic drugs from column B with their corresponding class in column A. Column A Column B 1 G Biguanides","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"Rosiglitazone 2 F 1st generation Sulfonyl urea"},{"label":"B","text":"Glibenclamide 3 B 2nd generation Sulfonyl urea"},{"label":"C","text":"Methadone 4 A Thiazolidinediones"},{"label":"D","text":"A-Carbose 5 D Alpha glycosidase inhibitors"},{"label":"E","text":"Amiodarone F: Chlopropramide G: Metformin H: Chlorpromazine SECTION D: SHORT ANSWER QUESTIONS 40 MARKS Instructions: • This section consist of Eight (8) questions • Write your answer on the space provided in the answer booklet • Write readable handwrite; DIRTY WORK IS NOT ALLOWED 18"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"e849bf43f74c96ac0c5b419d260edc857be2d34b"},{"id":"q-0ee22532ed6c","stem":"Outline five (5) differential Diagnoses of a 40 years old male who is brought to you because of convulsions: (2.5 marks) Answers: • Epilepsy • Viral encephalitis • Severe Malaria • Meningitis 19 • Electrolyte imbalance • Hypoglycemia • Space occupying lesions","type":"Short Answer","subject":"Community Medicine","topic":"Infectious Diseases","topicOriginal":"Infectious Diseases","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Infectious Diseases","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"c68ea1125675ffe73d80318d132b834088abecae"},{"id":"q-9d0f83bc1aba","stem":"A 30 years old long distance truck driver who is HIV positive came to the health facility complaining of Painless swelling on his neck and armpits for 5 months. On examination he has generalized lymphadenopathy: What is the WHO clinical stage of the patient (1 Mark) • WHO clinical stage 1 Outline for (4) Possible causes of the above condition: (4 Mark) • HIV • Mycobacterium TB infection • Kaposis Sarcoma • Lymphoma • Pyogenic bacterial infection","type":"Short Answer","subject":"Community Medicine","topic":"Infectious Diseases","topicOriginal":"Infectious Diseases","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Infectious Diseases","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-2292854fe251","stem":"A22 years old Musician attended the health centre with complaints of fever and skin lesions on the Perineum. On examination, small tender vesicles were found on the genitalia and bilateral enlarged Inguinal Lymphnodes. What is the most likely diagnosis? (1 Mark) Answers: Genital herpes List down two important investigations (2 Marks) • HIV test • VDRL How will you treat this patient (2 Marks) • Oral acyclovir • Analgesics • Bring sexual partner(s) for testing 21","type":"Short Answer","subject":"Community Medicine","topic":"Infectious Diseases","topicOriginal":"Infectious Diseases","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Infectious Diseases","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ee115cf7415c","stem":"A 40 years old man always has alcohol and frequent falls, he moved into the suburb few months ago and is well known for habitual drinking mostly drinking spirit, he presents to you with tremors, sweating profusely and vomiting. What is the possible diagnosis: What is the possible diagnosis (1 Mark) Answers: • Alcohol withdrawal syndrome List dawn 2 Differential diagnosis (2 Marks) Answers: • Alcohol Abuse • Alcohol Dependence How are you going to treat the patient? (2 Marks) Answers: • Treat using Diazepam protocol • Refer to speliazed care","type":"Short Answer","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-af455855d881","stem":"Amida is a 60years HIV positive female who attended Misungwi hospital with history of severe headache and disorganized behavior. Mention five (5) investigations that should be done to Amida. (5 Marks) Answer: • Blood sugar • Bs for MPs • LP for CSF analysis • Blood C/S • Serum Biochemistry • Cryptococcus antigen test","type":"Short Answer","subject":"Community Medicine","topic":"Infectious Diseases","topicOriginal":"Infectious Diseases","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Infectious Diseases","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7ff5c9681ee4","stem":"A 38 years man fisherman presents at emergence department complaining of abdominal discomfort and vomiting of fresh blood mixed with clots three episodes and followed with symptoms of dizziness and awareness of heart beats. On examination, he is severely pale, not jaundiced. PR is 115bpm. BP is 100/60mmHg in supine and 80/50mmHg on erect position. Describe the cause and the management of this patient. Answer Diagnosis (2 Marks) Management Investigations (2 Marks) Treatment (8 Marks) When stable, usually after 24hour (3 Marks)","type":"Short Answer","subject":"Community Medicine","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-71b7c1ee8922","stem":"A 32 years old female presents at causality with acute onset of cough, chest tightness and wheezing. She has not taken any medication for two weeks. She is unable to complete a sentence in one breath and she is confused. On physical examination, she is dyspnoeic with respiratory rate of 38bpm, PR is 120bpm and blood pressure is 90/60mmHg. Lung auscultation scattered wheezes all over. Describe the management of this patient. Answer Diagnosis: (2 Marks) Management Investigations (2 Marks) Treatment (8 Marks) If the patient is not improving On discharge (3 Marks) 24","type":"Short Answer","subject":"Community Medicine","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-207435ca9ff1","stem":"A 64 years old male, cigarette smoker reports to you with history of sudden onset of weakness on the right side of the body for one day. He is a known Hypertensive patient for the last 10 years not on regular medication. On examination: Glasgow coma scale was 8/15, BP 150/100mmHg, Pulse 80b/m, RR 20c/min, T 37oC, mouth deviated to the left and power grade 2 on right lower and upper limbs. From this information discuss the possible diagnosis, types, risk factors, investigations, treatment and prevention of this condition at health centre level. Answer: Stroke (1 Mark) Types of stroke (2 Marks) Risk factors (3 Marks) • Investigations (3 Marks) Treatment (4 Marks) Prevention strategy/Advice to the patient (2 Marks)","type":"Short Answer","subject":"Community Medicine","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7e1198a82c4b","stem":"0 Chronic renal failure may be caused by the following except","type":"Short Answer","subject":"Community Medicine","topic":"Renal and Urinary","topicOriginal":"Renal and Urinary","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Renal and Urinary","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-fd47c535520b","stem":"2 A 56-year-old man is admitted to the hospital for chest pain of 2-hour duration. H is heart rate is 42 bpm, with sinus bradycardia on ECG, as well as STsegment elevation in leads II, III, and aVF. Which of the following is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"He is likely in good physical condition with increased vagal tone."},{"label":"B","text":"He likely has suffered an inferior wall MI."},{"label":"C","text":"He likely has an LV aneurysm. D. The low heart rate is a reflection of a good cardiac ejection fraction."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"16c92e98b94327c88ffdcdeb0c5c6f15f7993ed9"},{"id":"q-4940b9c888ba","stem":"4 A 59-year-old male smoker complains of severe substernal squeezing chest pain of 30-minute duration. The paramedics have given sublingual nitroglycerin and oxygen by nasal cannula. His blood pressure is 110/ 70 mm H g and heart rate is 90 bpm on arrival to the ER. The ECG is normal. Which of the following is the best next step?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Echocardiography"},{"label":"B","text":"Thallium stress test"},{"label":"C","text":"Aspirin D. Coronary angiography"},{"label":"E","text":"Coronary artery bypass"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"820279ba77466d7501b8a1c949ad9107b203a21f"},{"id":"q-26528fd743b9","stem":"3 A 75-year-old man is noted to have chest pain with exertion and has been passing out recently. On examination he is noted to have a harsh systolic murmur. Which of the following is the best therapy for his condition?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"Coronary artery bypass"},{"label":"B","text":"Angioplasty C. Valve replacement"},{"label":"D","text":"Carotid endarterectomy"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"13ff56e24e32c4a3a4ec5c8bf8b981ba38b7df42"},{"id":"q-1ca899b52a34","stem":"1 A 59-year-old man complains of severe chest pain that radiates to his back. His brachial pulses appear unequal between his right and left arms. He appears hemodynamically stable. On chest radiography, he has a widened mediastinum. Which of the following is the best next step?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"Initiate thrombolytic therapy."},{"label":"B","text":"Obtain CT of chest with intravenous contrast."},{"label":"C","text":"Initiate aspirin and heparin."},{"label":"D","text":"Measure serial cardiac enzyme levels."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"b067183511860a6f43799610a2a22b55a3ed053c"},{"id":"q-90a21eb09971","stem":"4 A 45-year-old man is concerned because his father died of a ruptured abdominal aortic aneurysm. On evaluation, he is found to have a bicuspid aortic valve. Which of the following is the most accurate statement regarding his condition? A. He is at risk for an aortic aneurysm of the ascending aorta.","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"B","text":"He is at risk for an abdominal aortic aneurysm."},{"label":"C","text":"He is not at increased risk for aortic aneurysms."},{"label":"D","text":"He should have surgical correction of the aortic valve."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-02d1d0314a96","stem":"2 A 45-year-old man is diagnosed with essential hypertension based on two blood pressures of 150/ 100 and 156/ 102 mm H g during two separate visits. Which of the following would most likely provide prognostic information regarding this patient?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Vascular biopsy"},{"label":"B","text":"End-organ effects from hypertension"},{"label":"C","text":"Patient’s enrolment in a clinical trial"},{"label":"D","text":"Measurement of serum homocysteine levels"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"a7caf938ff1d8b3019f7ae1ac1e785e83d728449"},{"id":"q-dd63216223ae","stem":"4 A 45-year-old man with type 2 diabetes is noted to have blood pressures of 145/ 90 and 150/ 96 mm H g on two separate occasions. Which of the following is the best initial therapy for this patient?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Hydrochlorothiazide"},{"label":"B","text":"ACE inhibitor"},{"label":"C","text":"Beta-blocker"},{"label":"D","text":"Clonidine"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"6e350012b1072ab11d4858ad48df2d1e695f2159"},{"id":"q-e950341ff2eb","stem":"2 An 80-year-old woman without a history of hypertension undergoes surgery for a hip fracture. Her blood pressure on postoperative day 1 is 178/ 110 mm Hg. She is asymptomatic except for hip pain. Which of the following is the best next step?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Transfer the patient to the intensive care unit, obtain cardiac enzyme levels, and lower the blood pressures to the 140/ 90 mm H g range."},{"label":"B","text":"Control the pain and monitor the blood pressure."},{"label":"C","text":"Start the patient on a beta-blocker and monitor the blood pressure. D. Restrict visitors and turn down television, alarms, and other noise."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"959c380981d43d664cb149a32162884005f35bd2"},{"id":"q-d77d7d33d555","stem":"4 A 58-year-old woman with aphasia and right arm weakness of 8 hours’ duration is seen in the ER. CT scan shows no intracranial haemorrhage. H er blood pressure is 162/ 98 mm H g. Which of the following is the best next step?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Normalize the blood pressure with beta-blockade."},{"label":"B","text":"Admit to ICU with sodium nitroprusside."},{"label":"C","text":"Normalize the blood pressure with an ACE inhibitor."},{"label":"D","text":"Observe the blood pressure."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"b3835e7a8e85608e6037834656b7e16c6cf7261b"},{"id":"q-074b92b1aec0","stem":"2 A 48-year-old woman is noted to have atrial fibrillation with a ventricular heart rate of 140 bpm. She is feeling dizzy and dyspneic with a systolic blood pressure of 75/ 48 mm H g. Which of the following is the most appropriate next step?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Intravenous digoxin"},{"label":"B","text":"DC cardioversion"},{"label":"C","text":"Vagal maneuvers"},{"label":"D","text":"Intravenous diltiazem (Cardizem)"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"c4c3ca0e3617e961e74c5cd0953f924e7b72c464"},{"id":"q-baccb89dce9c","stem":"4 A 59-year-old woman has been placed on warfarin (Coumadin) after being found to have had chronic atrial fibrillation. She is noted to have an INR of 5.8, is asymptomatic, and has no overt bleeding. Which of the following is the best management for this patient?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Transfuse with erythrocytes."},{"label":"B","text":"Give vitamin K."},{"label":"C","text":"Give fresh frozen plasma."},{"label":"D","text":"Hold warfarin."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"6c7f026653a8fcaba2081f381cee208eae5abf7f"},{"id":"q-49c20f390a76","stem":"1 An 18-year-old woman is brought to the emergency centre because she fainted at a rock concert. She apparently recovered spontaneously, did not exhibit any seizure activity, and has no medical history. Her heart rate is 90 bpm and blood pressure 110/ 70 mm H g. The neurologic examination is normal. The pregnancy test is negative, and an ECG shows normal sinus rhythm. Which of the following is the most appropriate management?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Admit to hospital for cardiac evaluation."},{"label":"B","text":"Obtain an outpatient echocardiogram."},{"label":"C","text":"Use 24-hour Holter monitor."},{"label":"D","text":"Reassure the patient and discharge home."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"26272d1d5209c8be36983cc54d993ea7589a2326"},{"id":"q-1c1735f3956d","stem":"3 A 74-year-old man with no prior medical problems faints while shaving. He has a quick recovery and has no neurologic deficits. His blood sugar level is normal, and an ECG shows a normal sinus rhythm. Which of the following is the most useful diagnostic test of his probable condition?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Carotid massage"},{"label":"B","text":"Echocardiogram"},{"label":"C","text":"Computed tomographic (CT) scan of head"},{"label":"D","text":"Serial cardiac enzymes"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"c971ab2c4d311b9db6074b479191ae934c7ed8cf"},{"id":"q-2a44bd806ee5","stem":"1 A 68-year-old man with a history of end-stage renal disease is admitted to the hospital for chest pain. On examination, a pericardial friction rub is noted. His ECG shows diffuse ST-segment elevation. Which of the following is the best definitive treatment?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"NSAIDs"},{"label":"B","text":"Dialysis"},{"label":"C","text":"Steroids"},{"label":"D","text":"Kayexalate (sodium polystyrene sulfonate)"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"4644371bffec2224ba547027530e3becb7573d12"},{"id":"q-e4221eae5bc7","stem":"3 A 25-year-old woman complains of pain in her PIP and metacarpophalangeal (MCP) joints and reports a recent positive antinuclear antibody (ANA) laboratory test. Which of the following clinical features would not be consistent with a diagnosis of SLE?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Obstetrics","topicOriginal":"Obstetrics","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Pleural effusion"},{"label":"B","text":"Malar rash"},{"label":"C","text":"Sclerodactyly"},{"label":"D","text":"Urinary sediment with RBC casts"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Obstetrics","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"1ae487f64bdf8d1e9038fc1d86c2ac92f2e78a5d"},{"id":"q-3106aa5ed6ef","stem":"3 While awaiting pericardiocentesis, immediate supportive care of a patient with cardiac tamponade should include which of the following?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Diuresis with furosemide"},{"label":"B","text":"Intravenous fluids"},{"label":"C","text":"Nitrates to lower venous congestion"},{"label":"D","text":"Morphine to relieve dyspnea"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"5028a99abd063a5574772abe3a6fd3166790d84e"},{"id":"q-ecf4fe4ddc52","stem":"1 A 68-year-old man is hospitalized with Streptococcus bovis endocarditis of the mitral valve and recovers completely with appropriate therapy. Which of the following is the most important next step?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"Good dental hygiene and proper denture fitting to prevent reinfection of damaged heart valves from oral flora."},{"label":"B","text":"Repeat echocardiography in 6 weeks to ensure the vegetations have resolved."},{"label":"C","text":"Colonoscopy to look for mucosal lesions."},{"label":"D","text":"Mitral valve replacement to prevent systemic emboli such as cerebral infarction."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"fe2ae961fec710ea8bfbe190191d011ff48fcf79"},{"id":"q-0b38ac825455","stem":"3 A patient with which of the following conditions requires antimicrobial prophylaxis before dental surgery?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"Atrial septal defect"},{"label":"B","text":"Mitral valve prolapse without mitral regurgitation"},{"label":"C","text":"Previous coronary artery bypass graft"},{"label":"D","text":"Previous infective endocarditis Table 12–3 • INDICATIONS FOR SURGICAL MANAGEMENT OF ENDOCARDITIS"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"fb055200ceaa8159f31b8b3af7f7d0066884b194"},{"id":"q-f6bb767daa30","stem":"2 A 31-year-old male smoker presents with resting pain in his legs and a nonhealing foot ulcer. Which of the following is the most likely cause of arterial insufficiency in this patient?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"Cholesterol embolism"},{"label":"B","text":"Fibromuscular dysplasia"},{"label":"C","text":"Thromboangiitis obliterans (Buerger disease)"},{"label":"D","text":"Takayasu arteritis"},{"label":"E","text":"Psychogenic pain"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"459c4d647f774cb42fa255def0662d9d68548c74"},{"id":"q-e0cf714edba0","stem":"4 A 62-year-old man presents with livedo reticularis and three blue toes, including one with gangrene following cardiac catheterization. Which of the following is the most likely cause of this patient’s findings?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cholesterol embolism"},{"label":"B","text":"Fibromuscular dysplasia"},{"label":"C","text":"Thromboangiitis obliterans (Buerger disease)"},{"label":"D","text":"Takayasu aortitis"},{"label":"E","text":"Psychogenic pain"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"27a8d69cc24313e6a3786b1dceb827c2ea1affff"},{"id":"q-433fe703e29a","stem":"1 A 35-year-old woman complains of calf tenderness and acute Dyspnoea. The arterial blood gas reveals partial pressure of oxygen (PO 2) of 76 mm Hg. Which of the following is the most common physical examination fining of pulmonary embolism?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Respiratory","topicOriginal":"Respiratory","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Wheezing"},{"label":"B","text":"Increase pulmonary component of the second heart sound"},{"label":"C","text":"Tachypnoea"},{"label":"D","text":"Calf swelling"},{"label":"E","text":"Pulmonary rales"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Respiratory","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"22d176e213d24470b25c0dfc11fe7ee4a760cdef"},{"id":"q-5c6ffa69ec09","stem":"3 A 54-year-ol woman is note to have cervical cancer and present with significant vaginal bleeding with a haemoglobin level of 7 g/dL. Her left leg is swollen, which on Doppler investigation reveals a deep venous thrombosis. Which of the following is the best treatment for the thrombus?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Gynecology","topicOriginal":"Gynecology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Intravenous unfractionated heparin"},{"label":"B","text":"Fractionate subcutaneous heparin"},{"label":"C","text":"Subcutaneous unfractionated heparin"},{"label":"D","text":"Oral warfarin (Coumadin)"},{"label":"E","text":"Vena cava filter RESPIRATORY"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Gynecology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"de03c61ef7d9e5243f86c1000cb8c2fcc9cb9a6f"},{"id":"q-6c35e136c7b8","stem":"2 A 56-year-old woman admits to a 60-pack-year smoking history. She complains of fatigue and dyspnea with minimal exertion, and a cough that is productive each morning. Which of the following is the most likely finding in this patient?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"Higher diffusing capacity of lung for carbon monoxide (DLCO)"},{"label":"B","text":"Decreased residual volume"},{"label":"C","text":"Normal to slightly increased FEV1"},{"label":"D","text":"Decreased FEV1/ FVC"},{"label":"E","text":"Decreased FVC"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"5608d9e6916044710779616c37792ebc6d894115"},{"id":"q-cf1ceaf1a786","stem":"1 A patient with known asthma undergoing therapy with inhaled corticosteroids and intermittent (short acting) β2-agonist presents with complaints of nocturnal awakenings secondary to cough and occasional wheezing. This episode occurs three to four times per week. Pulmonary function tests in the past have shown mild obstructive lung disease. Which of the following is the best next step?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Respiratory","topicOriginal":"Respiratory","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Oral steroids"},{"label":"B","text":"Leukotriene inhibitors"},{"label":"C","text":"Long-acting β2-agonists"},{"label":"D","text":"Theophylline"},{"label":"E","text":"Anti-reflux therapy"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Respiratory","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"6c13ba04c81357b30107bf5fa60c1ba9ca946ad3"},{"id":"q-31974afcff92","stem":"3 A 22-year-old African-American woman presents with fatigue, arthralgias, and a nagging dry cough for the past 6 weeks, but no shortness of breath. On physical examination, her lungs are clear to auscultation, and she has bilateral pretibial tender erythematous raised nodules. Which of the following is your best next step?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"Chest radiograph"},{"label":"B","text":"High-resolution CT"},{"label":"C","text":"Empiric treatment for postnasal drip"},{"label":"D","text":"Antinuclear antibody"},{"label":"E","text":"Initiation of antituberculosis therapy"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"8b82bb0cd7956e697f089398d5433af1ffd0a4a0"},{"id":"q-a268eb0a4207","stem":"1 A 55-year-old man with congestive heart failure develops bilateral pleural effusions. Which of the following is the most likely pleural fluid characteristic if thoracentesis is performed?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Pleural fluid LDH 39, LDH ratio 0.2, protein ratio 0.7"},{"label":"B","text":"Pleural fluid LDH 39, LDH ratio 0.2, protein ratio 0.1"},{"label":"C","text":"Pleural fluid LDH 599, LDH ratio 0.9, protein ratio 0.1"},{"label":"D","text":"Pleural fluid LDH 599, LDH ratio 0.9, protein ratio 0.7"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"2094905fba721eaaeb489d5300b54c7efc26fd67"},{"id":"q-61e688616430","stem":"3 A 69-year-old man complains of gradually worsening dyspnea and a nagging cough over the past 3 months but no fevers. He is found to have a right-sided pleural effusion, which is tapped and is grossly bloody. Which of the following is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Respiratory","topicOriginal":"Respiratory","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Parapneumonic effusion"},{"label":"B","text":"Malignancy in the pleural space"},{"label":"C","text":"Rupture of aortic dissection into the pleural space"},{"label":"D","text":"Pulmonary embolism with pulmonary infarction"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Respiratory","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"9cdbc40604064e65eceb2ed6b920840836f6f109"},{"id":"q-9391f37b2d99","stem":"2 A 64-year-old woman comes to your office complaining of hoarse voice for 4 months. She has not had fever, sore throat, or a cough. On examination, she has expiratory wheezes in her left mid-lung fields. Which of the following is the best next step?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"Prescribe antibiotics for bronchitis."},{"label":"B","text":"Order a chest x-ray."},{"label":"C","text":"Advise gargling with saltwater solution."},{"label":"D","text":"Prescribe an albuterol inhaler."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"8f17057891bd0e8d5b68980dfe7d8fac5195e83e"},{"id":"q-7269b00afab7","stem":"4 A 52-year-old man presents with dyspnea, and chest x-ray shows a hilar mass with ipsilateral pleural effusion. Which of the following is the best next step?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Respiratory","topicOriginal":"Respiratory","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"CT scan of the chest, head, and abdomen for cancer staging."},{"label":"B","text":"Pulmonary function testing to evaluate pulmonary reserve to evaluate for pulmonectomy."},{"label":"C","text":"Obtain a specific tissue diagnosis by biopsy of the hilar mass."},{"label":"D","text":"Initiate palliative radiation because the patient is not a candidate for curative resection."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Respiratory","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"90858b0f7d6f9334804851ac76131b6e938286fe"},{"id":"q-483209e7cf92","stem":"day history of fever and productive cough. Chest x-ray reveals a right middle lobe consolidation. Which of the following is the most appropriate initial antibiotic choice?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Infectious Diseases","topicOriginal":"Infectious Diseases","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Oral amoxicillin"},{"label":"B","text":"Intravenous linezolid"},{"label":"C","text":"Intravenous cefepime"},{"label":"D","text":"Oral azithromycin"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Infectious Diseases","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"1b7c1ed6d44a2cc25ec7c6eadbb1289df851f4d0"},{"id":"q-236dc3089861","stem":"1 A 42-year-old overweight but otherwise healthy woman presents with sudden onset of right upper abdominal colicky pain 45 minutes after a meal of fried chicken. The pain is associated with nausea and vomiting, and any attempt to eat since then has caused increased pain. Which of the following is the most likely cause?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"Gastric ulcer"},{"label":"B","text":"Cholelithiasis"},{"label":"C","text":"Duodenal ulcer"},{"label":"D","text":"Acute hepatitis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"1192e558d0fdf686bdd20142d527ea52fea55bca"},{"id":"q-192a795522a6","stem":"3 A 45-year-old man was brought to the emergency room (ER) after vomiting bright red blood. H e has a blood pressure of 88/ 46 mm H g and heart rate of 120 bpm. Which of the following is the best next step?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Intravenous fluid resuscitation and preparation for a transfusion"},{"label":"B","text":"Administration of a proton pump inhibitor"},{"label":"C","text":"Guaiac test of the stool"},{"label":"D","text":"Treatment for H pylori"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"b79dd347d12d9cbcb4c708c9652050049f40d210"},{"id":"q-b46e860db172","stem":"1 A 32-year-old woman has a history of chronic diarrhea and gallstones and now has rectovaginal fistula. Which of the following is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"Crohn disease"},{"label":"B","text":"Ulcerative colitis"},{"label":"C","text":"Systemic lupus erythematosus"},{"label":"D","text":"Laxative abuse"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"eb4717b5534b1ca8ac0b3589aaf7d66839283ccf"},{"id":"q-96b0f9fa8036","stem":"3 A 25-year-old man is hospitalized for ulcerative colitis. He has now developed abdominal distention, fever, and transverse colonic dilation of 7 cm on x-ray. Which of the following is the best next step?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"5-ASA"},{"label":"B","text":"Oral steroids"},{"label":"C","text":"IV antibiotics and prompt surgical consultation"},{"label":"D","text":"Infliximab"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"1b49bceab01df596b20bdf9bbb87b72cfd9b9926"},{"id":"q-09eded71d9dd","stem":"1 A 48-year-old woman is admitted to the hospital with left lower quadrant abdominal pain, leukocytosis, and a CT showing sigmoid wall thickening consistent with a pericolic abscess. H er only significant medical history is a similar hospitalization with the same diagnosis less than 1 year previously. Which of the following is the most appropriate treatment?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"Surgical consultation for exploratory laparotomy and sigmoid resection"},{"label":"B","text":"Intravenous antibiotics with follow-up colonoscopy after hospital discharge"},{"label":"C","text":"Intravenous antibiotics and barium enema to evaluate for possible colonic malignancy"},{"label":"D","text":"Intravenous antibiotics and recommendations for postdischarge diet high in fiber with whole grains and nuts to minimize the risk of diverticular progression"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"4032551e484025c4d583a7b4b7d5e081e6545b51"},{"id":"q-13b8afb34ec4","stem":"3 A 58-year-old man presents to the emergency room with a temperature of 102°F, abdominal pain localizing to the left lower quadrant, and mild rebound tenderness. Which of the following diagnostic tests is the best next step?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"Barium enema"},{"label":"B","text":"Flexible sigmoidoscopy"},{"label":"C","text":"CT imaging of the abdomen"},{"label":"D","text":"Laparoscopic examination"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"fa1264894254903d276462b51c601a375426e12d"},{"id":"q-3eafbabcf338","stem":"2 Which of the following findings is more consistent with an osmotic, rather than a secretory, diarrhea?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"The diarrhea persists despite a 48-hour fast."},{"label":"B","text":"Stool osmolality = 290 mOsm, stool Na = 95 mOsm, stool K = 15 mOsm."},{"label":"C","text":"Diarrhea is large volume and watery, and is accompanied by paroxysms of flushing and wheezing."},{"label":"D","text":"Profuse, painless “rice-water” stool in a patient in a cholera-endemic area."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"4d4b8250d296e5df335e7271e91a88d3b2756866"},{"id":"q-657bdc3c5727","stem":"1 A 15-year-old adolescent girl has elevated liver enzymes and a positive antinuclear antibody (ANA). Choose the one cause (A-G) that is probably responsible for the patient’s presentation.","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Gastrointestinal","topicOriginal":"Gastrointestinal","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Wilson disease"},{"label":"B","text":"Hematochromatosis"},{"label":"C","text":"Primary biliary cirrhosis"},{"label":"D","text":"Sclerosing cholangitis"},{"label":"E","text":"Autoimmune hepatitis F. Alcohol-induced hepatitis G. Viral hepatitis"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Gastrointestinal","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"2abd5999a6b4a301fe21596cc120961bd75085f9"},{"id":"q-c8cb37928717","stem":"3 A 35-year-old man presents to your clinic with progressive jaundice, pruritis, and fatigue. He has ulcerative colitis. Choose the cause that is probably responsible for the patient’s presentation.","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Gastrointestinal","topicOriginal":"Gastrointestinal","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Wilson disease"},{"label":"B","text":"Hematochromatosis"},{"label":"C","text":"Primary biliary cirrhosis"},{"label":"D","text":"Sclerosing cholangitis"},{"label":"E","text":"Autoimmune hepatitis F. Alcohol-induced hepatitis G. Viral hepatitis"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Gastrointestinal","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"a5c1536deb5b85a8b074ba23e5264e4e881afe78"},{"id":"q-29d073d189b7","stem":"4 A 56-year-old woman who presented with complaints of pruritus and fatigue has elevated alkaline phosphatase. Select the cause that is probably responsible for the patient’s presentation.","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"Wilson disease"},{"label":"B","text":"Hematochromatosis"},{"label":"C","text":"Primary biliary cirrhosis"},{"label":"D","text":"Sclerosing cholangitis"},{"label":"E","text":"Autoimmune hepatitis F. Alcohol-induced hepatitis G. Viral hepatitis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"8fc151b56d6e2c06854bd6d96aff181a1acb9ed5"},{"id":"q-1bffcb63594f","stem":"5 A 32-year-old man presents to your clinic with Kayser-Fleischer rings, dysarthria, and spasticity. Pick the cause from the following that is probably responsible for the patient’s presentation.","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"Wilson disease"},{"label":"B","text":"Hematochromatosis"},{"label":"C","text":"Primary biliary cirrhosis"},{"label":"D","text":"Sclerosing cholangitis"},{"label":"E","text":"Autoimmune hepatitis F. Alcohol-induced hepatitis G. Viral hepatitis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"a8a38393d825acc59651b7894f20db9e9814a66b"},{"id":"q-741168e09041","stem":"2 A 37-year-old woman is noted to have gallstones on ultrasonography. She is placed on a low-fat diet. After 3 months she is noted to have severe right upper quadrant pain, fever to 102°F, and nausea. Which of the following is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"Acute cholangitis"},{"label":"B","text":"Acute cholecystitis"},{"label":"C","text":"Acute pancreatitis"},{"label":"D","text":"Acute perforation of the gallbladder"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"4382cb0e8c1e8f33be69108642942a6b754b3754"},{"id":"q-87538a576636","stem":"1 A 25-year-old medical student is stuck with a hollow needle during a procedure performed on a patient known to have hepatitis B and C viral infection, but who is H IV negative. The student’s baseline laboratory studies include serology: H BsAg negative, anti-H BsAb positive, anti-H Bc IgG negative. Which of the following regarding this medical student’s hepatitis status is true?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Obstetrics","topicOriginal":"Obstetrics","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Prior vaccination with hepatitis B vaccine"},{"label":"B","text":"Acute infection with hepatitis B virus"},{"label":"C","text":"Prior infection with hepatitis B virus"},{"label":"D","text":"The student was vaccinated for hepatitis B but is not immune"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Obstetrics","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"b945f8be32a9517bc8ae056ce44b926108894816"},{"id":"q-b249f7af99fa","stem":"3 In a suicide attempt, an 18-year-old woman took 4 g of acetaminophen, approximately 8 hours previously. H er acetaminophen level is 30 μg/ mL. Which of the following is the best next step to be performed for this patient?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"Immediately start N-acetylcysteine"},{"label":"B","text":"Observation"},{"label":"C","text":"Alkalinize the urine"},{"label":"D","text":"Administer intravenous activated charcoal RENAL"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"],"duplicateStemGroup":"04682a97afc76749f9c3661ae5bc7bc1bed4f989"},{"id":"q-a7d92a8925dc","stem":"2 Which of the following laboratory findings is most consistent with poststreptococcal glomerulonephritis?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Obstetrics","topicOriginal":"Obstetrics","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Elevated serum complement levels"},{"label":"B","text":"Positive antinuclear antibody titers"},{"label":"C","text":"Elevated ASO titers"},{"label":"D","text":"Positive blood cultures"},{"label":"E","text":"Positive cryoglobulin titers"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Obstetrics","answerAuditStatus":"reasoned_duplicate_projection","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"dece9ed7faeac5b1942f4d43169b3e35d4099470"},{"id":"q-c92fcfbd3130","stem":"1 A 49-year-old woman with type 2 diabetes presents to your office for new onset swelling in her legs and face. She has no other medical problems and says that at her last ophthalmologic appointment she was told that the diabetes had started to affect her eyes. She takes glyburide daily for her diabetes. Physical examination is normal except for hard exudates and dot hemorrhages on funduscopic examination, and diminished sensation up to the mid-shin bilaterally. Her blood pressure is normal. Urine analysis shows 2+ protein and 2+ glucose (otherwise negative). Which of the following is the best treatment for this patient? A. Have the patient return in 6 weeks and check a repeat urine analysis at that time.","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Start metoprolol."},{"label":"C","text":"Change the glyburide to glipizide and have the patient return for followup in 6 weeks."},{"label":"D","text":"Start lisinopril."},{"label":"E","text":"Refer the patient to a cardiologist."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a2d993e00687","stem":"2 A 19-year-old man was seen at the university student health clinic a week ago complaining of pharyngitis, and now returns because he has noted discoloration of his urine. He is noted to have elevated blood pressure (178/ 110 mm H g), and urinalysis reveals red blood cell (RBC) casts, dysmorphic RBCs, and 1+ proteinuria. Which of the following is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"SLE"},{"label":"B","text":"Amyloidosis"},{"label":"C","text":"Poststreptococcal glomerulonephritis"},{"label":"D","text":"H IV nephropathy"},{"label":"E","text":"Diabetic nephropathy"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"aaccebd07dd840eb54504b02bfa900c183aba625"},{"id":"q-b30241902ef2","stem":"4 A 58-year-old man with type 2 diabetes is normotensive, has no known heart disease, and has a baseline creatinine of 1.8 mg/ dL. H is fasting lipid profile shows triglycerides 205 mg/ dL, total cholesterol 220 mg/ dL, high-density lipoprotein (H DL) 35 mg/ dL, and LDL 148 mg/ dL. What is the most appropriate treatment?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Niacin"},{"label":"B","text":"Low-protein diet"},{"label":"C","text":"Gemfibrozil"},{"label":"D","text":"Simvastatin"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"4b549dde2aa9c587919d61a2e906073195268690"},{"id":"q-16d4e4bbaa6f","stem":"2 A 49-year-old man with a long-standing history of chronic renal failure as a consequence of diabetic nephropathy is brought to the emergency room for nausea, lethargy, and confusion. H is physical examination is significant for an elevated jugular venous pressure, clear lung fields, and harsh systolic and diastolic sounds heard over the precordium. Serum chemistries reveal K 5.1 mEq/ L, CO 2 17 mEq/ L, BUN 145 mg/ dL, and creatinine 9.8 mg/ dL. Which of the following is the most appropriate therapy? A. Administer IV insulin and glucose.","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Renal and Urinary","topicOriginal":"Renal and Urinary","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Administer IV sodium bicarbonate."},{"label":"C","text":"Administer IV furosemide."},{"label":"D","text":"Urgent hemodialysis."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Renal and Urinary","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-68f4548e51e2","stem":"3 A 62-year-old diabetic man underwent an abdominal aortic aneurysm repair 2 days ago. H e is being treated with gentamicin for a urinary tract infection. His urine output has fallen to 300 mL over 24 hours, and his serum creatinine has risen from 1.1 mg/ dL on admission to 1.9 mg/ dL. Which of the following laboratory values would be most consistent with a prerenal etiology of his renal insufficiency?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Obstetrics","topicOriginal":"Obstetrics","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"FENa of 3%"},{"label":"B","text":"Urinary sodium level of 10 mEq/ L"},{"label":"C","text":"Central venous pressure reading of 10 mm H g"},{"label":"D","text":"Gentamicin trough level of 4 μg/ mL JOINTS"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Obstetrics","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"00064f7364e3c5374b66f94f8f97479b55e28fac"},{"id":"q-50d10021836f","stem":"1 A 35-year-old obese hotel housekeeper presents with 1 week of lower back pain. H er history and examination are without “red flag” symptoms and completely normal, except for her weight. Which of the following is the best next step? A. Regular doses of a N SAID, and activity as tolerated","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"B","text":"Six weeks of bed rest"},{"label":"C","text":"MRI of the lumbar spine"},{"label":"D","text":"Plain film x-ray of lumbosacral spine"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a7f9d2305801","stem":"3 A 70-year-old woman presents with a 4-week history of low back pain, generalized weakness, and a 15-lb weight loss over the last 2 months. H er medical history is unremarkable, and her examination is normal except that she is generally weak. Initial laboratory tests reveal an elevated sedimentation rate, mild anemia, creatinine level","type":"Short Answer","subject":"Community Medicine","topic":"Obstetrics","topicOriginal":"Obstetrics","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Obstetrics","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ca97aa7389b1","stem":"8 mg/ dL, and calcium level 11.2 mg/ dL. Which of the following is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"Osteoporosis with compression fractures"},{"label":"B","text":"Renal failure with osteodystrophy"},{"label":"C","text":"Multiple myeloma"},{"label":"D","text":"Lumbar strain"},{"label":"E","text":"Osteomyelitis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"471b642bbb7a7d5fd61061f7d10b6099c6e5df3e"},{"id":"q-e37fb18f749d","stem":"1 A previously healthy 18-year-old college freshman presents to the student health clinic complaining of pain on the dorsum of her left wrist and in her right ankle, fever, and a pustular rash on the extensor surfaces of both her forearms. She has mild swelling and erythema of her ankle, and pain on passive flexion of her wrist. Less than 1 mL of joint fluid is aspirated from her ankle, which shows 8000 PMN cells per high-power field (hpf ) but no organisms on Gram stain. Which of the following is the best initial treatment?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"Indomethacin orally"},{"label":"B","text":"Intravenous ampicillin"},{"label":"C","text":"Colchicine orally"},{"label":"D","text":"Intra-articular prednisone"},{"label":"E","text":"Intravenous ceftriaxone"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"e1a3462a92f38e2dcb870e410971f72fbb93352c"},{"id":"q-af041e3e5b49","stem":"3 A 30-year-old man is noted to have an acutely swollen and red knee. Joint aspirate reveals numerous leukocytes and polymorphonuclear leukocytes, but no organisms on Gram stain. Analysis shows few negatively birefringent crystals. Which of the following is the best initial treatment?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"Oral corticosteroids"},{"label":"B","text":"Intra-articular corticosteroids"},{"label":"C","text":"Intravenous antibiotic therapy"},{"label":"D","text":"Oral colchicine"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"ce9dd5322adca2200e1ad51a6c9021cbad23f206"},{"id":"q-e70adfedfa04","stem":"2 A 65-year-old man with a history of chronic hypertension, diabetes mellitus, and degenerative joint disease presents with acute onset of severe pain of the metatarsophalangeal (MTP) joint and swelling of the left first toe. Physical examination shows exquisite tenderness of the joint, with swelling, warmth, and erythema. The patient has no history of trauma or other significant medical problems. Synovial fluid analysis and aspiration are most likely to show which of the following?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Hemorrhagic fluid"},{"label":"B","text":"Needle-shaped, negatively birefringent crystals"},{"label":"C","text":"Gram-negative organisms D. Noninflammatory fluid"},{"label":"E","text":"Rhomboidal, positively birefringent crystals"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"ce43faddcc60cef77b3fc69fcc77e22462e1a22d"},{"id":"q-cf7bd478485f","stem":"4 A 22-year-old man presents with complaints of low back pain for 3 to 4 months and stiffness of the lumbar area, which worsen with inactivity. H e reports difficulty in getting out of bed in the morning and may have to roll out sideways, trying not to flex or rotate the spine to minimize pain. A lumbosacral (LS) spine x-ray film would most likely show which of the following?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"Degenerative joint disease with spur formation"},{"label":"B","text":"Sacroiliitis with increased sclerosis around the sacroiliac joints"},{"label":"C","text":"Vertebral body destruction with wedge fractures"},{"label":"D","text":"Osteoporosis with compression fractures of L3-L5"},{"label":"E","text":"Diffuse osteonecrosis of the LS spine"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"5321c72a3e727c05d9410bc5fd771b6388b5d0a9"},{"id":"q-cc61b16dd387","stem":"1 Which of the following patients is most likely to be a candidate for bone mineral density screening?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"A 65-year-old, thin, white woman who smokes and is 15 years postmenopausal"},{"label":"B","text":"A 40-year-old white woman who exercises daily and still menstruates"},{"label":"C","text":"A healthy 75-year-old white man who is sedentary D. A 60-year-old overweight African-American woman"},{"label":"E","text":"A 35-year-old asthmatic woman who took prednisone 40 mg/ d for a 2-week course 1 week ago"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"cec03782651a3504ec3e450510e2076b8dc60ba5"},{"id":"q-97bdd4563a59","stem":"3 A 60-year-old woman presents with the results of her DEXA scan. She has a T score of – 1.5 SD at the hip and – 2.5 at the spine. Which of the following is the most accurate interpretation of these results?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"She has osteoporosis at the spine and osteopenia at the hip."},{"label":"B","text":"She has osteoporosis in both areas."},{"label":"C","text":"This is a normal examination."},{"label":"D","text":"She has osteoporosis of the hip and osteopenia at the spine."},{"label":"E","text":"You need to know the Z score."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"a2d2b99c80652524c42c37fef7b0f3e1db17a7c3"},{"id":"q-0f43037dde56","stem":"4 You see a 70-year-old woman in your office for a routine checkup, and you order a DEXA scan for bone mineral density screening. The T score returns as – 2.5 SD in the spine and – 2.6 in the hip. Which of the following statements is most accurate?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"This patient has osteopenia."},{"label":"B","text":"Estrogen replacement therapy should be started with an anticipated rebuilding of bone mass to near-normal within 1 year."},{"label":"C","text":"Swimming will help build bone mass."},{"label":"D","text":"Bisphosphonates would reduce the risk of hip fracture by 30%-50%. STROKE"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"bb016233fb03f1a0c0789a69f6f429ad4d1c666d"},{"id":"q-4e2caf5328b6","stem":"2 One year ago, a 24-year-old woman had an episode of diplopia of 2 weeks’ duration. The symptoms resolved completely. Currently, she complains of left arm weakness but no headache. Which of the following is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"Recurrent transient ischemic attacks"},{"label":"B","text":"Subarachnoid hemorrhage"},{"label":"C","text":"Complicated migraine"},{"label":"D","text":"Multiple sclerosis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"ce21165588e300cbc4e56ca68f3e2b71d46bd6a1"},{"id":"q-3cbb1ef84b6a","stem":"4 A 62-year-old man who works at an automobile assembly line has noticed that he feels pain, fatigue, and numbness in his right arm while working for the last several months. This morning at work, he noticed vertigo, then lightheadedness, then lost consciousness for a few seconds. The blood pressure in his right arm is 30 mm H g lower than that in his left arm. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Left middle cerebral artery stroke"},{"label":"B","text":"Lacunar infarction involving right internal capsule"},{"label":"C","text":"Stenosis of right subclavian artery due to atherosclerosis"},{"label":"D","text":"Multiple sclerosis"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"e2b8e46ff06472be78a44471483b45619d56d3c8"},{"id":"q-0ec8acdae13f","stem":"2 A 74-year-old man was noted to have excellent cognitive and motor skill 12 months ago. H is wife noted that 6 months ago his function deteriorated noticeably, and 2 months ago another level of deterioration was noted. Which of the following is most likely to reveal the etiology of his functional decline?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"H IV antibody test"},{"label":"B","text":"Magnetic resonance imaging of the brain"},{"label":"C","text":"Cerebrospinal fluid (CSF) Venereal Disease Research Laboratory (VDRL) test"},{"label":"D","text":"Serum thyroid-stimulating hormone"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"380b16510ce44fa349f496dd9b6053565a65d477"},{"id":"q-073d1e8ccd08","stem":"4 Which of the following are commonly seen in brain imaging of patients with Alzheimer disease?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Chronic subdural hematoma"},{"label":"B","text":"Cortical atrophy with atrophy of medial temporal structures"},{"label":"C","text":"Ventriculomegaly without cortical atrophy"},{"label":"D","text":"Normal cerebral ventricles and normal brain tissue, acetylcholine deficiency"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Neurology","answerAuditStatus":"reasoned_duplicate_projection","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"c90ec470db200ad2d91b3468293917f1bdee89d0"},{"id":"q-3b0c8047512f","stem":"2 A 75-year-old man presents to the emergency room with the sudden onset of nausea and vomiting. H is medical history is notable for coronary artery disease and well-controlled hypertension. On examination he refuses to open his eyes or move his head, but when finally coaxed to sit up, he immediately starts to retch and vomit. Rotational nystagmus is noted. H e cannot walk because of the dizziness and nausea that walking evokes. H is noncontrast brain computed tomography (CT ) scan is read as normal for age. Which of the following is the best next step? A. MRI/ magnetic resonance angiography (MRA).","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Obtain a thorough psychosocial history."},{"label":"C","text":"Dix-H allpike maneuver."},{"label":"D","text":"Prescribe meclizine."},{"label":"E","text":"Referral to neurology."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7ed27ee135a1","stem":"3 A 65-year-old woman with a history of benign positional vertigo returns to your office for follow-up. Although manageable, the symptoms of vertigo continue to recur periodically. Between episodes she generally feels normal but occasionally somewhat “off-balance.” Today, her neurologic examination is completely normal, except that the thresholds of both air and bone conduction of a vibrating 256-H z tuning fork are elevated on the left side. Which of the following is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Intermittent benign positional vertigo"},{"label":"B","text":"Otosclerosis"},{"label":"C","text":"Acoustic neuroma"},{"label":"D","text":"Acute basilar artery infarct"},{"label":"E","text":"Panic disorder"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"813971383524b6930675efccb2dcb3012f0fbc7d"},{"id":"q-8341d3b2b13d","stem":"1 A 55-year-old accountant complains of facial and tongue swelling. H e recently started using a new bath soap. H is medical problems include osteoarthritis and hypertension, for which he takes acetaminophen and lisinopril, respectively. Which of the following is the most likely etiology?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Lisinopril"},{"label":"B","text":"Soap hypersensitivity"},{"label":"C","text":"H ypothyroidism"},{"label":"D","text":"Acetaminophen"},{"label":"E","text":"Food-related allergy"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"b9fd225a7a8bc20f2059c30687671e88c2b4ed8e"},{"id":"q-0f4223ad4be2","stem":"3 A 34-year-old man is brought into the emergency room for a severe allergic reaction caused by fire ant bites. H e is treated with intramuscular epinephrine and intravenous corticosteroids. H is oxygen saturation falls to 80%, and he becomes apneic. Which of the following is the best next step?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"Intravenous diphenhydramine"},{"label":"B","text":"Intravenous epinephrine"},{"label":"C","text":"Oxygen by nasal cannula"},{"label":"D","text":"Endotracheal intubation"},{"label":"E","text":"Electrical cardioversion"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"fb62f77a7f59c8a347667b85cf06ab96b7af8964"},{"id":"q-993997ffa46d","stem":"1 Which of the following asymptomatic patients would most benefit from treatment of the finding of more than 105 CFU/ mL of Escherichia coli on urine culture?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"A 23-year-old asymptomatic sexually active woman"},{"label":"B","text":"A 33-year-old asymptomatic pregnant woman"},{"label":"C","text":"A 53-year-old asymptomatic diabetic woman"},{"label":"D","text":"A 73-year-old asymptomatic woman in a nursing home"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"f8c9f6f4fcb9d0950dea693dd24c9eae73298298"},{"id":"q-209b48c8b363","stem":"4 A 45-year-old man is noted to have a blood pressure of 80/ 40 mm H g, heart rate of 142 bpm, and fever of 102°F. H is abdomen is tender, particularly in the right lower quadrant, and acute appendicitis is diagnosed. Three liters of 0.9% saline are infused and intravenous antibiotics are administered as he is prepared for surgery. H is blood pressure falls to 70/ 42 mm H g. Which of the following is the most appropriate next step?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Administer a beta-blocker to control his heart rate."},{"label":"B","text":"Check a cortisol level and administer corticosteroids."},{"label":"C","text":"Infuse fresh frozen plasma (FFP)."},{"label":"D","text":"Initiate norepinephrine intravenous infusion."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"174533328672e2c66026d33bc0225dd97c12610e"},{"id":"q-7a0e4774cafe","stem":"2 A 32-year-old man with acute myelogenous leukemia is undergoing chemotherapy. H e was hospitalized 7 days ago for fever to 102°F with an absolute neutrophil count of 100 cells/ mm3, and he has been placed on intravenous imipenem and vancomycin. He continues to have fever to 103°F without an obvious source. Which of the following is the best next step?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Perform lumbar puncture to assess cerebrospinal fluid."},{"label":"B","text":"Continue present therapy."},{"label":"C","text":"Stop all antibiotics because he likely has drug fever."},{"label":"D","text":"Add an aminoglycoside antibiotic."},{"label":"E","text":"Add an antifungal agent."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Hematology","answerAuditStatus":"reasoned_duplicate_projection","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"e8ff37f4f83486c9d9c61390a5aaba705aa74ac4"},{"id":"q-81535e2496a7","stem":"1 An 18-year-old with a 1-week history of fever, headache, increasing confusion, and lethargy presents to the emergency room. H is physical examination is normal, and he has no focal neurologic signs. The CT scan of his head is negative. An LP reveals a W BC count of 250/ mm3, with 78% lymphocytes and RBCs 500/ mm3 in tube 1 and 630/ mm3 in tube 2, respectively. No organisms are seen on Gram stain. Which of the following is the best next step?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Intravenous ceftriaxone, acyclovir, and vancomycin"},{"label":"B","text":"Intravenous fluconazole"},{"label":"C","text":"Intravenous azithromycin"},{"label":"D","text":"Careful observation with no antibiotics"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"07d948363e3306b3bc4de0048e9cd9554ad24816"},{"id":"q-148cde8808d7","stem":"2 A 24-year-old man has been treated with isoniazid, rifampin, and pyrazinamide for active pulmonary tuberculosis. After 3 months, he states that he is having numbness and tingling of both feet but no back pain. H e denies taking other medications. Which of the following is the most appropriate next step?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Respiratory","topicOriginal":"Respiratory","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Computed tomography (CT ) scan of the lumbar spine."},{"label":"B","text":"Initiate pyridoxine."},{"label":"C","text":"Continue the tuberculosis agents and monitor for further neurologic problems."},{"label":"D","text":"Initiate a workup for tuberculosis adenopathy compression on the femoral nerve"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Respiratory","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"8ffdd9070cff060747b950fca0e82e74166b2362"},{"id":"q-aa1ec69df7ad","stem":"4 Which of the following tests are the most important to follow for a patient receiving isoniazid and rifampin for tuberculosis treatment?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Infectious Diseases","topicOriginal":"Infectious Diseases","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Renal function tests"},{"label":"B","text":"Liver function tests"},{"label":"C","text":"Slit-lamp examinations D. Amylase and lipase tests"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Infectious Diseases","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"86a80471fc1624e48d3392afc3b8845ea72abe51"},{"id":"q-14895dd8eb54","stem":"2 As part of normal screening during pregnancy, a 28- year-old G2P1 has a positive RPR with a titer of 1 :64 and a positive MH A-TP. She is allergic to penicillin, which causes shortness of breath and “swelling of her tongue.” Which of the following treatments do you offer?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Obstetrics","topicOriginal":"Obstetrics","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Erythromycin estolate."},{"label":"B","text":"Doxycycline."},{"label":"C","text":"Tetracycline."},{"label":"D","text":"Penicillin after desensitization."},{"label":"E","text":"Vancomycin. F. Wait until delivery of the baby before treatment"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Obstetrics","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"6c6698a9840e1a92959d111f0626584edab42e84"},{"id":"q-47424305cfba","stem":"3 A 23-year-old man is found to have late latent syphilis (RPR 1 :64) as part of a workup following his diagnosis with H IV. H e is asymptomatic with a CD4 count of 150 and does not remember having lesions or rashes in the past. Prior to starting therapy with penicillin for the syphilis, the patient should undergo which of the following procedures?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"Lumbar puncture to exclude neurosyphilis"},{"label":"B","text":"Skin biopsy to confirm the diagnosis of syphilis"},{"label":"C","text":"Magnetic resonance imaging (MRI) of his brain and an electroencephalogram (EEG)"},{"label":"D","text":"Skin testing to exclude penicillin allergy"},{"label":"E","text":"Adjustment of his H IV medications to optimize his CD4 count prior to treatment for syphilis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"be8e32768baadacd6b391e83ae9ac7c52485c6fb"},{"id":"q-7c54b2e1c250","stem":"1 A 32-year-old woman with a 5-year history of H IV infection is noted to have a CD4 count of 100 cells/ mm3. She is admitted to the hospital with a 2-week history of fever, shortness of breath, and a dry cough. Which of the following diagnostic tests would most likely confirm the diagnosis?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Infectious Diseases","topicOriginal":"Infectious Diseases","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Silver stain or DFA of the sputum"},{"label":"B","text":"Gram stain of the sputum showing gram-positive diplococci"},{"label":"C","text":"Acid-fast smear of the sputum"},{"label":"D","text":"Serum cryptococcal antigen"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Infectious Diseases","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"c83a5f19f917f15fe0cc8a8f9c993ea4abcfdf25"},{"id":"q-2da4e5f0a804","stem":"4 A 36-year-old woman with H IV is admitted with new-onset seizures. The CT scan of the head reveals multiple ring-enhancing lesions of the brain. Which of the following is the best therapy for the likely condition?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Rifampin, isoniazid, ethambutol"},{"label":"B","text":"Ganciclovir"},{"label":"C","text":"Penicillin"},{"label":"D","text":"Sulfadiazine with pyrimethamine ELECTRO AND ENDOCRINE"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"2f9d5dab8630770cfa67f288fe7e922b4c8f53ba"},{"id":"q-905d5a47628c","stem":"7 mEq/ L, creatinine level is normal, and bicarbonate and chloride levels are low. Which of the following is the likely cause of his hyponatremia given his presentation? A. SIADH","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"B","text":"H ypothyroidism"},{"label":"C","text":"Gastrointestinal losses"},{"label":"D","text":"Adrenal insufficiency"},{"label":"E","text":"Renal insufficiency"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-121ffb8f6bb8","stem":"3 An 83-year-old woman comes to your clinic complaining of a headache and mild confusion. H er medical history is remarkable only for hypertension, which is well controlled with hydrochlorothiazide. H er examination and laboratory tests show no signs of infection, but her serum sodium level is 119 mEq/ L, and plasma osmolarity is 245 mOsm/ kg. She appears to be clinically hypovolemic. Which of the following is the best initial therapy?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Fluid restriction"},{"label":"B","text":"Infusion of 0.9% saline"},{"label":"C","text":"Infusion of 3% saline"},{"label":"D","text":"Infusion of 3% saline with furosemide"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"a19dff3276c5fb4f8b188174df54dbce0e1da926"},{"id":"q-76ea7f5a1d4d","stem":"1 A 42-year-old woman presents to your clinic for her annual physical examination. On examination, you note neck fullness. When you palpate her thyroid, it is enlarged, smooth, rubbery, and nontender. The patient is asymptomatic. You send her for thyroid function testing: her T 4, free T 4, and T 3 are normal, but her TSH is slightly elevated. Which of the following is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Iodine deficiency"},{"label":"B","text":"Thyroid cancer"},{"label":"C","text":"H ashimoto thyroiditis"},{"label":"D","text":"Graves disease"},{"label":"E","text":"Multinodular goiter"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Endocrinology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"937640d1bfeab2b3aab19e9f6622d5f613b3a77f"},{"id":"q-440712dc1aba","stem":"2 Which of the following laboratory tests could be performed to confirm your diagnosis of the patient in Question 48.1?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Obstetrics","topicOriginal":"Obstetrics","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Repeat thyroid function tests"},{"label":"B","text":"Thyroid ultrasound"},{"label":"C","text":"Nuclear thyroid scan"},{"label":"D","text":"Anti-thyroperoxidase (TPO) antibody tests"},{"label":"E","text":"Complete blood count with differential"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Obstetrics","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-6ea5505aa142","stem":"3 A 19-year-old gymnast active in national competition is brought to your clinic by her mother because the daughter’s menses have ceased for the last 3 months. Prior to this, she was always regular. She denies excess dieting, although she does work out with her team 3 hours daily. H er physical examination is normal except for her body mass index (BMI) of 20 kg/ m2. Which of the following laboratory tests should be ordered first?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Obstetrics","topicOriginal":"Obstetrics","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Thyroid function tests"},{"label":"B","text":"Complete blood count"},{"label":"C","text":"Luteinizing hormone (LH )/ follicle-stimulating hormone (FSH )"},{"label":"D","text":"Prolactin"},{"label":"E","text":"Beta-Hcg"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Obstetrics","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"73a459ce37105cf7a49a07c5a51c293ba51ee303"},{"id":"q-c3622454341d","stem":"4 A 35-year-old woman who was diagnosed with hypothyroidism 4 weeks ago presents to your clinic complaining of persistent feelings of fatigue and sluggishness. After confirming your diagnosis with a measurement of the TSH , you started her on levothyroxine 50 μg daily. She has been reading about her diagnosis on the Internet and wants to try desiccated thyroid extract instead of the medicine you gave her. On examination, she weighs 175 lb, her heart rate is 64 bpm at rest, and her blood pressure is normal. Which of the following is the best next step?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Tell her that this delay in resolution of symptoms is normal and schedule a follow-up visit with her in 2 months."},{"label":"B","text":"Change her medication, as requested, to thyroid extract and titrate."},{"label":"C","text":"Increase her dose of levothyroxine and have her come back in 4 weeks."},{"label":"D","text":"Tell her to start a multivitamin with iron to take with her levothyroxine."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":["whitespace/page_marker_normalization"],"duplicateStemGroup":"5ed8816e420699599412d7e4558314816e24df38"},{"id":"q-076633321e43","stem":"2 A 30-year-old woman takes prednisone 15 mg/ d for systemic lupus erythematosus. She is admitted to the hospital for a cholecystectomy. Which of the following is the most important intervention for her?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"H ydrocortisone intravenously before surgery and every 6 hours for 24 hours."},{"label":"B","text":"Double the prednisone the night before and hold her steroids the day of the surgery."},{"label":"C","text":"Use of cyclophosphamide in lieu of corticosteroids for 2 weeks following surgery to promote wound healing."},{"label":"D","text":"Cancel the surgery and use lithotripsy to break up the stones"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"eb04f52901f1ea8895726756ffb8157f371413a3"},{"id":"q-880b4b7f524f","stem":"0- 4.5 mg/ dL). She is not anemic and has no symptoms. Her medical history is significant for osteoporosis, discovered on a dual-energy x-ray absorptiometry (DEXA) scan performed last year. Which of the following is the most likely cause of her hypercalcemia?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"Multiple myeloma"},{"label":"B","text":"Parathyroid adenoma"},{"label":"C","text":"Familial hypocalciuric hypercalcemia"},{"label":"D","text":"Sarcoidosis"},{"label":"E","text":"Undiagnosed breast cancer"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"e06e043b8fa39c1d08fe4586343630650e683b83"},{"id":"q-da2cfdc7741d","stem":"3 A 22-year-old African-American woman presents with worsening cough over 6 weeks, which did not improve with a course of antibiotics or antitussives. Her serum calcium level is found to be 12.5 mg/ dL, and a chest x-ray reveals bilateral hilar lymphadenopathy. She has erythema nodosum on her legs. Which of the following is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Infectious Diseases","topicOriginal":"Infectious Diseases","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Sarcoidosis"},{"label":"B","text":"Mycoplasma pneumonia"},{"label":"C","text":"Acute lymphoblastic leukemia"},{"label":"D","text":"Squamous cell carcinoma of the lung"},{"label":"E","text":"Pulmonary embolism"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Infectious Diseases","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"95d2cf4bd2b4eb3c890a263ad776ad22f55f1adf"},{"id":"q-610426e22576","stem":"4 A 66-year-old man with known metastatic squamous cell carcinoma of the esophagus is brought to the emergency room for increasing lethargy and confusion. H e is clinically dehydrated, his serum calcium level is 14 mg/ dL, and his creatinine level is 2.5 mg/ dL but 1 month ago it was 0.9 mg/ dL. Which therapy for his hypercalcemia should be instituted first?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Neoplasia","topicOriginal":"Neoplasia","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Intravenous bisphosphonate"},{"label":"B","text":"Intravenous furosemide"},{"label":"C","text":"Glucocorticoids"},{"label":"D","text":"Intravenous normal saline"},{"label":"E","text":"Chemotherapy for squamous cell carcinoma"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Neoplasia","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"50b5921a31ba737faa36934a3866e298bb50b095"},{"id":"q-64087f2d303a","stem":"2 A 45-year-old obese Hispanic woman presents for follow-up of her diabetes. She currently takes metformin 1000 mg twice per day, and her fasting morning glucose runs approximately 170 to 200 mg/ dL. H er last H bA1C was 7.9. She states that she conscientiously follows her diet and that she walks 30 minutes to 1 hour daily. Which of the following is the best next step in her care?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Refer to an endocrinologist for an insulin pump."},{"label":"B","text":"Stop metformin and start on glimepiride."},{"label":"C","text":"Add once-a-day injection of insulin glargine (Lantus)."},{"label":"D","text":"H ospitalize her urgently."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Endocrinology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"8f0c303b5733c3a63f3d2ff954861e41155ab971"},{"id":"q-8fbe8b79187a","stem":"4 A 42-year-old woman who developed gestational diabetes with her last pregnancy which was 10 years ago, is being screened for type 2 diabetes. Which of the following screening methods has the highest sensitivity?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Obstetrics","topicOriginal":"Obstetrics","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Fasting serum glucose"},{"label":"B","text":"2-H our glucose tolerance test"},{"label":"C","text":"Hemoglobin A1C"},{"label":"D","text":"Random glucose"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Obstetrics","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"9e5121ecc6b279f5f495f11b2b368810d3dc1a61"},{"id":"q-1f0db776b01c","stem":"2 An 18-year-old man is noted to be in diabetic ketoacidosis with pH 7.20 and serum glucose level 400 mg/ dL. Which of the following is the most accurate statement regarding this patient’s potassium status?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Likely to have a potassium level less than 3 mEq/ L."},{"label":"B","text":"Likely to have a potassium level more than 5 mEq/ L."},{"label":"C","text":"Likely to have a total body potassium deficit regardless of the serum level."},{"label":"D","text":"Serum level is likely to increase with correction of the acidosis."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Endocrinology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"1c9122e69142160af27ddfd4590b214a9f728928"},{"id":"q-7fb827ef976a","stem":"4 A 59-year-old man with a long history of diabetes with chronic renal insufficiency due to diabetic nephropathy is seen in clinic for routine laboratory work. H e is asymptomatic, but his glucose is elevated at 258 mg/ dL, and his other chemistries are as follows: sodium 135 mEq/ L, potassium 5.4 mEq/ L, chloride 108 mEq/ L, and bicarbonate 18 mEq/ L. H is creatinine is stable at 2.1 mg/ dL. What is the most likely cause of his acidosis?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Obstetrics","topicOriginal":"Obstetrics","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Diabetic ketoacidosis"},{"label":"B","text":"Lactic acidosis"},{"label":"C","text":"Type 4 renal tubular acidosis"},{"label":"D","text":"Accidental salicylate overdose."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Obstetrics","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"6b01d47a8907ea6ca1134de1f68e68219077729e"},{"id":"q-a78dae77a7b8","stem":"3 A 58-year-old woman is noted to have Graves disease and has a small goiter. Which of the following is the best therapy?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Public Health and Community Medicine · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Public Health and Community Medicine","options":[{"label":"A","text":"Long-term propranolol"},{"label":"B","text":"Lifelong oral propylthiouracil (PTU)"},{"label":"C","text":"Radioactive iodine ablation"},{"label":"D","text":"Surgical thyroidectomy HAEMATOLOGY"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Public Health and Community Medicine · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"8cbe2c13cde0c8545abba106d3070b9b09729484"},{"id":"q-22e63471eaa0","stem":"2 A 22-year-old woman is pregnant and at 14-week gestation. H er haemoglobin level is 9 g/ dL. She asks why she could have iron deficiency when she is no longer menstruating. Which of the following is the best explanation?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Obstetrics","topicOriginal":"Obstetrics","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Occult gastrointestinal blood loss"},{"label":"B","text":"Expanded blood volume and transport to the fetus"},{"label":"C","text":"Hemolysis"},{"label":"D","text":"Iron losses as a result of relative alkalosis of pregnancy"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Obstetrics","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"fb19ddfbf0a8af3321843a89469dbc1b432a1472"},{"id":"q-13f21b2293c5","stem":"1 A 32-year-old man is brought into the emergency room after a motor vehicle accident. He is noted to be in hypovolemic shock with a blood pressure of 60/ 40 mm H g. He is actively bleeding from a femur fracture. The patient’s hemoglobin level is 7 g/ dL. H is wife is positive that the patient’s blood type is A positive. Which of the following is the most appropriate type of blood to be transfused?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Give AB-positive blood, uncross-matched."},{"label":"B","text":"Await cross-matched A-positive blood."},{"label":"C","text":"Give type-specific A-positive blood, uncross-matched."},{"label":"D","text":"Give O-negative blood, uncross-matched."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-82ff61707015","stem":"3 A 57-year-old man has a prosthetic aortic valve for which he takes warfarin (Coumadin) 10 mg/ d. H e is noted to have an international normalized ratio (IN R) of 7 and is actively bleeding large clots from his gums, rectum, and when urinating. Which of the following is the best management for this patient?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Administer vitamin D."},{"label":"B","text":"Transfuse with fresh frozen plasma."},{"label":"C","text":"Administer IVIg."},{"label":"D","text":"Discontinue the warfarin (Coumadin) and observe."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"3c6957fe7a28b533a793e41161b8d147c0d242da"},{"id":"q-28d534e58d40","stem":"2 A 50-year-old man has been treated for rheumatoid arthritis for many years. He currently is taking corticosteroids for the disease. On examination, he has stigmata of rheumatoid arthritis and some fullness on his left upper abdomen. H is platelet count is slightly low at 105,000/ mm3. H is white blood cell count is 3100/ mm3 with neutropenia, and hemoglobin level is 9 g/ dL. Which of the following is the most likely etiology of the thrombocytopenia?","type":"Single Best Answer MCQ","subject":"Community Medicine","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Steroid induced"},{"label":"B","text":"Splenic sequestration"},{"label":"C","text":"Autoimmune destruction"},{"label":"D","text":"Prior gold therapy"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Medicine","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_questio