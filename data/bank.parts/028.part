auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3cc99339df26","stem":"Simulated mother A mother comes with her 3 years old daughter. Take a history/examination and give your diagnosis.","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-18c7e1139855","stem":"PROCEDURE: Put together all the devices you need to take a blood culture from a school child and describe the procedure at your preferred site.","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b4dfbe5c2d9f","stem":"Interpret the full blood count and write the diagnosis Check list Description: Microcytic hypochromic anaemia Leucocytosis with neutrophilia Diagnosis: Iron deficiency anaemia Infection MD3, Checklist and instructions","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Infectious Diseases","topicOriginal":"Infectious Diseases","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Infectious Diseases","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-74184fd19272","stem":"Instructions to simulated mother My daughter has diarrhoea, vomiting and fever. She is drinking a lot Check list","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-40558f5ce6d9","stem":"Marking scheme Devices: • Povidone iodine and spirit.................................. 1 • Swabs.......................................................... 1 • Gloves......................................................... 1 • 2 ml syringe and 2 needles................................. 1 • Blood culture bottle......................................... 1 Correct description and sequence.............................. 3 Preferred site – peripheral vein of the arm (or femoral).... 2 Total 10","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-b5b48ef0773c","stem":"Check list Description: Microcytic hypochromic anaemia Leucocytosis with neutrophilia Diagnosis: Iron deficiency anaemia Infection MD 5 FINAL OSCE","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Infectious Diseases","topicOriginal":"Infectious Diseases","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Infectious Diseases","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-580ec4aaf9f5","stem":"You admit a child with vomiting and diarrhea and some dehydration, weight 12kg. Explain to the mother how to rehydrate her child. Introduction......................................... 1 ORS 750 – 850 m/s over 4 – 6 ltrs............... 2 Explain amount in practical way (cups)......... 1 Explain why ORS and not water in lay terms... 2 Explain why a drip is not indicated and ORS will help better... 1 Explain that a vomiting child can get ORS by spoon.......... 2 Thanks the mother ......................... 1","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-58d3fa3ce112","stem":"Do abdominal examination and describe your findings.","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ab2bad6e4f8a","stem":"Introduction......................................... 1 ORS 750 – 850 m/s over 4 – 6 ltrs............... 2 Explain amount in practical way (cups)......... 1 Explain why ORS and not water in lay terms... 2 Explain why a drip is not indicated and ORS will help better... 1 Explain that a vomiting child can get ORS by spoon.......... 2 Thanks the mother ......................... 1","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-5582c3015753","stem":"Marking scheme. Introduces himself to child and mother..................... 1 Explains what he/she wants to do............................... 1 Inspects abdomen.................................................. 1 Auscultates before palpation..................................... 1 Palpates abdomen and keeps a good contact to the child.... 1 Describes findings correctly.................................... 1 Reports other findings........................................... 1 Examiners questions answered correctly..................... 2 Thanks the parents/mother...................................... 1 Total 10","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-1613a07d1d10","stem":"What is the name of this instrument? -------------------------------- -------- 1 mark","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5c14c5e7a0b2","stem":"What can this instrument be used for? a).------------------------------- ------- 1 mark","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-050909fecf1f","stem":"Name 3 anatomical structures one can identify by examining the normal fundus","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":".________________________________________________________ 1 mark;"},{"label":"B","text":".________________________________________________________ 1 mark;"},{"label":"C","text":"._________________________________________________________ 1 mark."}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_text","nonunique_option_text","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-92162effc385","stem":"Explain what causes swimmer's itch. Include the type of flatworm, the developmental stage, and the bodies physiological response. Is this condition restricted to the skin? Explain. [10 points]","type":"Short Answer","subject":"Parasitology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b6c5f312e70c","stem":"Patients who are slow in activators of isoniazid are likely to develop one of the following adverse effect?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"renal insufficiency"},{"label":"B","text":"vestibular damage"},{"label":"C","text":"peripheral neuritis"},{"label":"D","text":"optic neuritis"},{"label":"E","text":"color blindness 3"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"005ba3bbd024054ddc63a9f64739084a4b63a766"},{"id":"q-717183f63b69","stem":"The absorption the on of which of the following is greatly decreased in the absence of gastric acidity","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Gastrointestinal","topicOriginal":"Gastrointestinal","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"flucytosine"},{"label":"B","text":"fluconazole"},{"label":"C","text":"nystatin"},{"label":"D","text":"ketaconazole"},{"label":"E","text":"zidovusine 4"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Gastrointestinal","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"1cc0678086a7aa75c10b42a3adeb9f8322852ce5"},{"id":"q-e7e619faf4ae","stem":"Tetracycline should not be administered with which?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Furosemide"},{"label":"B","text":"Potassium salts"},{"label":"C","text":"Iron salts"},{"label":"D","text":"Cimetidine"},{"label":"E","text":"Sodium chloride 6"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"8c45e09a6830dbe857722dcf9458cac79cc3f82e"},{"id":"q-bc18b5695ce2","stem":"Which is the mechanism of action of fluoroquinolones (e.g. ciprofloxacin?)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antimicrobials","options":[{"label":"A","text":"Inhibit DND gyrase"},{"label":"B","text":"Inhibit reverse transcriptase enzyme"},{"label":"C","text":"Inhibit peptidyl transfer on ribosome"},{"label":"D","text":"Inhibit DNA-directed RNA polymerase"},{"label":"E","text":"Interfere with peptidoglycan synthesis 9"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"faaa35590ef4b84dd47bb35107bd3e92e46b3e68"},{"id":"q-36a3501f20fa","stem":"Which of the following induces microsomal enzymes ...............Phenobarbitone ...............Ethanol ...............Diazepam ...............Ketaconazole ...............Nevirapine 12 SECTION III: Matching Group A","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-90a57637010b","stem":"Essential Drugs: • First Model list by WHO in 1977 • First National EDL of India in 1996 • Current edition of India is 17th National list of Essential Medicines. It was modified in 2011. It contains 348 drugs","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1049eaf1b777","stem":"New formula WHO-ORS was released in 2002. It contains low Na+ (75 mM), low glucose (75 mM) and has low osmolarity (245, mOsm/L)","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a599927478ce","stem":"Most of the drugs follow first order kinetics.","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-bf68157c8367","stem":"Time to reach steady state depends on t1⁄2. It takes approximately 5 half lives.","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-4f88f98b6cdb","stem":"Steady state plasma concentration acheived depends on dose rate.","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-38573cd340f5","stem":"Essential medicines are the drugs that cater to priority health-care needs of a population. Most of these are formulated as single compounds.","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAudit