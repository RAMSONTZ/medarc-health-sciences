ly diagnosis?","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Polymyalgia rheumatica"},{"label":"B","text":"Concoceal arthritis"},{"label":"C","text":"Acute gout arthritis"},{"label":"D","text":"Psoriatic arthritis"},{"label":"E","text":"Rheumatoid arthritis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1e078b0837c3","stem":"Regarding Expanded Programme in Immunization National Schedule the following are correct except","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"BCG is given at birth"},{"label":"B","text":"Measles vaccine can be given from 6 months to 9 months"},{"label":"C","text":"BCG is contraindicated in HIV"},{"label":"D","text":"Polio 0 is given at birth"},{"label":"E","text":"DPT – HB is given at one, two and third month"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d16193dd39a8","stem":"Regarding general examination of children all the following gives general impression except","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Unusual or characteristic facial features"},{"label":"B","text":"Shape of the head"},{"label":"C","text":"Body posture"},{"label":"D","text":"Attitude and social inferaction"},{"label":"E","text":"Precordial bulging"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-aa232c022e88","stem":"At what age does the anterior fontanelle closes?","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"At the age of 8 months"},{"label":"B","text":"Immediately after birth"},{"label":"C","text":"From 9 months to 18 months"},{"label":"D","text":"Soon after posterior fontenelle"},{"label":"E","text":"At the age of 4 months"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-18e6504df588","stem":"The following are true regarding gathering information during history taking except one","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Use open and close questioning"},{"label":"B","text":"Facilitation"},{"label":"C","text":"Clarification"},{"label":"D","text":"Verbal and non verbal cues are less important"},{"label":"E","text":"Establishment of dates and sequence of the events"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-466a506b9432","stem":"What is the average vertical span of the liver dullness?","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Gastrointestinal","topicOriginal":"Gastrointestinal","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"6 – 12 cm midclavicular line"},{"label":"B","text":"4 – 8 cm midclavicular line"},{"label":"C","text":"12 – 20 cm midclavicular line"},{"label":"D","text":"3 – 5 cm midclavicular line"},{"label":"E","text":"1 – 3 cm midclavicular line"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Gastrointestinal","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-9e68c05f1fbc","stem":"What are the common causes of abdominal distension?","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ascites, massive ovarian cyst, intestinal obstruction"},{"label":"B","text":"Abdominal abscess, gall stones, Ascites"},{"label":"C","text":"Urinary retention, intestinal obstruction, paralytic ileus"},{"label":"D","text":"Hookworm infestation, Ascites, fecal impaction"},{"label":"E","text":"Gastritis, Ascites, diarrhea"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerifi