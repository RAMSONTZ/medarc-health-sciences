ed","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-27449d4a118f","stem":"Which of the following is a prodrug? (AIIMS May 2008, AIIMS Nov 2006, AIIMS May 2004)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Enalapril"},{"label":"B","text":"Clonidine"},{"label":"C","text":"Salmeterol"},{"label":"D","text":"Acetazolamide"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e1146a1a97ac","stem":"Which of the following drugs is an inhibitor of cytochrome p450 enzymes? (AIIMS May 2008)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ketoconazole"},{"label":"B","text":"Rifampicin"},{"label":"C","text":"Phenytoin"},{"label":"D","text":"Phenobarbitone"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1ffc53e469ef","stem":"In metabolism of xenobiotics, all of the following reactions occur in phase one except?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Oxidation\b (AI 2012, AIIMS Nov 2008)"},{"label":"B","text":"Reduction"},{"label":"C","text":"Conjugation"},{"label":"D","text":"Hydrolysis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b53a3871a55f","stem":"Identify the wrong statement: (DPG 2009)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Acidic drugs bind to albumin in plasma"},{"label":"B","text":"Basic drugs bind to alpha-1 acid glycoprotein in plasma"},{"label":"C","text":"Drugs having higher affinity for a plasma protein can displace the other drug from the same protein"},{"label":"D","text":"Sex steroid hormones do not bind to any protein in plasma"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f3401a822db3","stem":"All of the following results in detoxification of drugs EXCEPT: (AI-2008)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"NADPH cytochrome P450 reductase"},{"label":"B","text":"Cytochrome P450"},{"label":"C","text":"Cytochrome oxidase"},{"label":"D","text":"Monooxygenase"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1c07a18f01df","stem":"Which of the following antiplatelet drugs is a prodrug? (AI 2007)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Clopidogrel"},{"label":"B","text":"Tirofiban"},{"label":"C","text":"Aspirin"},{"label":"D","text":"Dipyridamole"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-65be4411294c","stem":"The extent to which ionization of a drug takes place is dependent upon pKa of the drug and the pH of the solution in which the drug is dissolved. Which of the following statements is NOT correct? (AI 2003)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"pKa of a drug is the pH at which the drug is 50% ionized"},{"label":"B","text":"Small changes of pH near the pKa of a weak acidic drug will not affect its degree of ionization."},{"label":"C","text":"Knowledge of pKa of a drug is useful in predicting its behaviour in various body fluids."},{"label":"D","text":"Phenobarbitone with a pKa of 7.2 is largely unionized at acid pH and will be about 40% nonionized in plasma."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-bb9dc49f6e97","stem":"All of the following statements regarding bioavailability of a drug are true except: (AI 2003)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"It is a fraction of administered drug that reaches the systemic circulation in unchanged form https://kat.cr/user/Blink99/ tahir99 - UnitedVRG 21 21 General Pharmacology General Pharmacology General Pharmacology"},{"label":"B","text":"Bioavailability of an orally administered drug can be calculated by comparing the Area Under Curve after oral and intravenous administration"},{"label":"C","text":"Low oral availability always and necessarily means poor absorption"},{"label":"D","text":"Bioavailability can be determined from plasma con- centration or urinary excretion data."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-62eca22965ea","stem":"Which of the following drugs should be removed by dialysis? (AI 2001)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Digoxin"},{"label":"B","text":"Salicylates"},{"label":"C","text":"Benzodiazepines"},{"label":"D","text":"Organophosphates"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7d2021bcdbdf","stem":"Which of the following is true? (AI 2000)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"As the concentration of the drug increases over the therapeutic range, only the bound form of the drug increases"},{"label":"B","text":"The bound form is not available for metabolism but is available for excretion"},{"label":"C","text":"Acidic drugs binds to beta globulin and basic drugs bind to albumin"},{"label":"D","text":"Binding sites are non-specific and one drug can displace the other"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ceb472a49fcc","stem":"In a patient with nephrotic syndrome and hypoalbu- minemia, protein binding of which drug will not be affected: (AIIMS May, 2002)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Renal and Urinary","topicOriginal":"Renal and Urinary","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Tolbutamide"},{"label":"B","text":"Morphine"},{"label":"C","text":"Diazepam"},{"label":"D","text":"Valproate"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Renal and Urinary","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverif