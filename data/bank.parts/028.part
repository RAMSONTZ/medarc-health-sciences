lags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4101fc6275bd","stem":"RPR or VDRL are serological test for the diagnosis of which infectious organism?","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6ad1828648d2","stem":"Define the term titre. -------------------------------------------------- --------------------------------------------------- ---------------------------------------------------------------------------- ----------------------------------------------------------- ---------------------------------------------------------------------------- ---------------------------------------------------- ---------------------------------------------------------------------------- ----------------------------------------------------- BLOOD TRANSFUSION","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-839c3b6f13d5","stem":"2celcius degree. Write a prescription for him to use oral anti-malaria. Supplement with analgesic and hematinics.","type":"Short Answer","subject":"Pharmacology","topic":"Infectious Diseases","topicOriginal":"Infectious Diseases","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Infectious Diseases","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-0bbf4ec09ea5","stem":"A child comes to the clinic at the age of three months. Which immunization the child should he get today?","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"BCG"},{"label":"B","text":"Polio"},{"label":"C","text":"Measles"},{"label":"D","text":"DPT- Hb and Polio"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a5c9a7c35412","stem":"The child is presenting with cough, fever and difficult in breathing. On examination the child is tachypnoeic, chest in drawing and crepitations. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":". Brochitis"},{"label":"B","text":". Severe pneumonia"},{"label":"C","text":". URTI"},{"label":"D","text":". Pneumonia"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"7dfbdec3146fb0004c3972415883bcb473daded6"},{"id":"q-1fbaab4fd417","stem":"Which of the following findings belongs to which problem?","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"...Legs in extension, arms flexed but stiff"},{"label":"B","text":"...Legs and arms in extension and spastic"},{"label":"C","text":"...Uncontrolled involuntary movements"},{"label":"D","text":"...Sustained ankle clonus and tiptoeing ( when walking)"},{"label":"E","text":"...Broad based gait f) ...Inability to move the affected eye to a lateral(outward) position g) ...Unilateral ptosis, dilated pupil, eye deviated downward and outward"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"4d38b7ef8c40575ac78cf10830b939a2cb8569a2"},{"id":"q-0580633f7657","stem":"The partogram demonstrate the inappropriate management of above diagnosis, what were supposed to be done? MD3 OSCE 2009. Station 4. Perform sterile speculum examination in this model.","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b05697b4df40","stem":"Stress incontinence; the involuntary leakage of urine from the full bladder when the intra-abdominal pressure is raised (e.g. coughing/sneezing).","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e347b4d891b6","stem":"Overflow incontinence; urine leakage secondary to retention of urine vi. Change in frequency g. Musculoskeletal System: (limbs, back, joints) i. Weakness ii. Pain/ stiffness iii. Swelling h. Haematopoietic System i. Easy bruising ii. Bleeding tendencies (ask how long it takes for bleeding to stop if injured)","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-8d2ecf25959b","stem":"Index Pregnancy: health of mother during current pregnancy (ask to see RCH card) a. ANC (antenatal clinic); date of first visit at ANC, age of pregnancy at first visit to ANC frequency of attendance (ask to see ANC/RCH card) b. Illnesses during pregnancy; febrile?, vomiting?, bleeding?, complications? c. Any tests during pregnancy; (haemoglobin, ABO, Rh, BP, BMI: weight (kg)/ height (m2), PITC, VDRL, B/S, urinalysis, urine protein, stool analysis), when?, repeated later? d. Medication use during pregnancy; what, route, duration, compliance i. Sulphadoxine-Pyrimethamine (SP) for malaria (white tablets)? ii. Antihelminthic treatment (mebendazole)? iii. Iron (red tablets)? iv. Folate (yellow tablets)? v. Tetanus toxoid injection? e. Radiation exposure f. Foetal kicks (quickening in primigravidae:20-24 wks, in multigravidae:16-18 wks)","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Obstetrics","topicOriginal":"Obstetrics","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"quarantine","flags":["copyright_only"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Obstetrics","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"quarantine","auditFlags":["copyright_only","prior_structural_review_flag"],"cleaningOperations":[]},{"id":"q-714c2e2b2e7f","stem":"Sexual History: a. Nature of sexual relationship; none/ single partner/ multiple partners b. Pain during coitus (dyspareunia; deep pain, and due to endometriosis, PID) i. Severity; does intercourse have to stop? ii. Frequency; sometimes (how often?)/at every intercourse iii. Location; superficial (near outside)/ deep on the inside iv. Any other pains in pelvic region other than that caused by sexual activity c. Post-coital bleeding?","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Gynecology","topicOriginal":"Gynecology","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Gynecology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-122fad6346d0","stem":"Past Medical History (PMHx): a. Chronic illnesses; Epilepsy, DM, HTN, Cardiac problems, TB, SCD, SLE? b. Previous admissions; number, reason, when c. History of trauma/surgical intervention; number, reason, when d. History of blood transfusions; number, reason, when e. Medication use; what? (drugs, herbal medication), route, duration, compliance f. Allergies; food/drugs","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b141ceb614e1","stem":"Family Social History (FSHx): a. Marital status (single/ cohabiting/ married/ separated) b. Occupation (her + partner/spouse) c. Education level (her + partner/spouse) d. Smoking; how many packs (20 cigarettes)?, duration (years) e. Alcohol use; quantity, frequency of use f. Home; water source (boiled water?), toilets?, insecticide-treated nets?, ventilation? g. Hereditary familial illnesses; Epilepsy, DM, HTN, SCD, haemophilia, thalassemia, heart problems h. Plans for delivery, breastfeeding","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-989e685be8c7","stem":"Limbs (knees, elbows): numerous angular nodulations ii. Foetal lie: assess where the back is in relation to L/R of mother","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Obstetrics","topicOriginal":"Obstetrics","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Obstetrics","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-9e306aa0a39f","stem":"Compound ii. Position: where the foetus is facing (LOA is most common)","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-58708edde85a","stem":"Rearward (occipitoposterior): face is toward the woman's back—that is, face down when the woman lies on her back","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2a7a76b336cc","stem":"Unengaged (5,4,3 fifths): a moveable body will be noted which may be gently balloted","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0b2d73d368da","stem":"Engaged (2,1,0 fifths): the presenting body part is immobile i.e. fixed in pelvis ii. Attitude: relationship of the foetus' body parts to one another. The cephalic prominence is where the greatest resistance is felt.","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-88666ec85a91","stem":"Deep: tenderness? a. Left kidney b. Spleen; (palpable, span below costal margin) c. Right kidney d. Liver; i. Span ii. Surface; (soft/firm/hard, regular/irregular, tender/non- tender, nodular/smooth) e. Gallbladder (murphy’s sign?) f. Urinary bladder g. Aorta h. Rectus abdominis muscle i. Abdominal mass(es) i. Site, size & shape ii. Surface, edge, consistency (hard/soft, irregular/regular, nodular/smooth, round, tender/non-tender) iii. Mobility 6 HOODA, Faisal Hasnain iv. Pulsation j. Guarding / rebound tenderness iii. On percussion; tympanic note/dullness (don’t do for gravid uterus)","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Gastrointestinal","topicOriginal":"Gastrointestinal","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Gastrointestinal","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-adcd2bfcfe72","stem":"Foetal Heart rate; heard from >24 weeks of gestation (normal is 110-160) a. Place one hand of radial artery to differentiate between maternal and foetal pulses b. Listen over the foetal back to the foetal heart sounds c. Rate and the rhythm of the should be determined over 1 min.","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-588cd89dd7e4","stem":"Presence or absence of amniotic membranes and the state of the liquor","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-798de077f5aa","stem":"Size and shape of the maternal bony pelvis a. True (anatomical) conjugate: 11.5 cm. From the upper margin of the symphysis pubis to the sacral promontory b. Obstetric conjugate: 11cm. From the innermost part of the symphysis pubis to the sacral promontory c. Diagonal conjugate: 12.5cm. From the lower part of the symphysis to the sacral promontory. Can be measured only at patients with a contracted pelvis c. Central Nervous System: i. Central Nervous System ii. Higher Centres","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d13878ca5f49","stem":"Cyanosis: at rest? (check nail-bed, circumorally, tongue)","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-eff41501776c","stem":"Management: a. Pharmacologic b. Non-pharmacologic","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ee3a2c08c785","stem":"When presenting problems and gynaecological history the following should be avoided","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Constructive interview"},{"label":"B","text":"Questions which imply criticim"},{"label":"C","text":"Open-ended questions"},{"label":"D","text":"Gentleness of manner"},{"label":"E","text":"A genuine interest in the problem"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-988ad85fa8fc","stem":"Methods of assessing fetal-well-being include the following except","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Obstetrics","topicOriginal":"Obstetrics","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Fetal movement chart"},{"label":"B","text":"Cardiotocography (CTA)"},{"label":"C","text":"Biophysical profile (BPP)"},{"label":"D","text":"Auscultation of fetal heart rate (FHR)"},{"label":"E","text":"Meternal Q2 saturation"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Obstetrics","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-3a3eadd5f855","stem":"Airway management in patient with multiple traumas include","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Jaw thrust"},{"label":"B","text":"Chin lift"},{"label":"C","text":"Inline immobilization"},{"label":"D","text":"Rigid collar neck"},{"label":"E","text":"‘a’ and ‘b’"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6b1b3ca95e2d","stem":"Where there is no reliable laboratory support the following are bound to happen except","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Obstetrics","topicOriginal":"Obstetrics","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Patients are less likely to receive the best possible treatment"},{"label":"B","text":"Resistance to essential drugs will continue to spread"},{"label":"C","text":"The sources of disease may not be identified correctly"},{"label":"D","text":"Valuable financial resources and human resources will be utilized effectively"},{"label":"E","text":"Epidemics and the spread of major communicable diseases will not be checked reliably"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Obstetrics","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"c