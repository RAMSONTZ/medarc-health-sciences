"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Perioperative Care","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d86ed84f992a","stem":"True statement about weakly basic drugs is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"These are bound primarily to plasma albumin"},{"label":"B","text":"These are excreted faster in acidic urine https://kat.cr/user/Blink99/ tahir99 - UnitedVRG 23 23 General Pharmacology General Pharmacology General Pharmacology"},{"label":"C","text":"Are highly ionized in the intestinal juice"},{"label":"D","text":"These are absorbed mainly from stomach"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-82f6f60f659d","stem":"Which of the following statements about a drug having high plasma protein binding is true?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Volume of distribution of the drug is very high"},{"label":"B","text":"This drug will be filtered quickly by glomerulus"},{"label":"C","text":"This drug is likely to have minimum chances of drug interactions"},{"label":"D","text":"High plasma protein binding decreases the volume- of distribution"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-be9c5ab77efb","stem":"Most common phase II drug metabolizing reaction is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Glucuronidation"},{"label":"B","text":"Acetylation"},{"label":"C","text":"Oxidation"},{"label":"D","text":"Glutathione conjugation"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8e9ed7babeae","stem":"All of the following reactions are catalyzed by microsomal enzymes EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Glucuronidation"},{"label":"B","text":"Acetylation"},{"label":"C","text":"Oxidation"},{"label":"D","text":"Reduction"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6ce61e446b23","stem":"Which of the following factors has maximum effect on filtration of a drug by the glomerulus?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Lipid solubility"},{"label":"B","text":"Plasma protein binding"},{"label":"C","text":"Degree of ionization"},{"label":"D","text":"Rate of tubular secretion"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8a4f0e4d3aba","stem":"A three year old child is brought to the emergency department having just ingested a large overdose of an antihistaminic drug. This drug is a weak base capable of entering most tissues including the brain. On physical examination the heart rate is 100/ minute, blood pressure is 110/60 mm Hg and the respiratory rate is 20/ minute. In this case of poisoning","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Urinary excretion would be accelerated by adminis- tration of NH4Cl, an acidifying agent"},{"label":"B","text":"Urinary excretion would be accelerated by adminis- tration of NaHCO3, an alkalinizing agent"},{"label":"C","text":"More of the drug would be ionized at blood pH than at stomach pH"},{"label":"D","text":"Absorption of the drug would be faster from the stomach than from the small intestine."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-387d2c162b53","stem":"A patient, Rajesh with a history of wheezing, coughing and shortness of breath is being evaluated in the asthma clinic. Several drug treatments with different routes are under consideration. Which of the following statements about routes of administration is most correct?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Respiratory","topicOriginal":"Respiratory","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Administration of a bronchodilator drug by inhaled aerosol is usually associated with more adverse effects than administration of this drug by mouth."},{"label":"B","text":"The first pass effect is the result of elimination of a drug after administration and before it enters systemic circulation."},{"label":"C","text":"Bioavailability of most drugs is greater with rectal administration than with sublingual administration"},{"label":"D","text":"Administration of a drug by transdermal patch is of- ten faster but is associated with more first pass me- tabolism than oral administration"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Respiratory","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-be8a74ac90a6","stem":"Which does not induce microsomal enzymes?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cimetidine (DPG 2003)"},{"label":"B","text":"Griseofulvin"},{"label":"C","text":"Rifampicin"},{"label":"D","text":"Phenobarbitone"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-57