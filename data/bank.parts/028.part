rane except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Epinephrine\b (DNB 2006, 2003)"},{"label":"B","text":"Thyroxine"},{"label":"C","text":"Androstenedione"},{"label":"D","text":"Estrogen"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a69c3937a1da","stem":"About inverse agonism, true is: (MH 2006)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Action on the target receptors is similar to that of agonist"},{"label":"B","text":"Binds to the same receptor receptor binding-site as an agonist for that receptor but exerts the opposite pharmacological effect"},{"label":"C","text":"Acts on receptors which do not have agonist"},{"label":"D","text":"None"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4984399d5641","stem":"When two different chemicals act on two different receptors and their response is opposite to each other on the same cell, this is called as: (AP 2006)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Physiological antagonism"},{"label"