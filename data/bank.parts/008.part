splayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-fc4cc35b58b5","stem":"The management of amoebic liver abscess includes the following","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The first choice of drug is metronidazole followed by diloxanide furoate"},{"label":"B","text":"The first choice of drug is paromycin"},{"label":"C","text":"The first choice of drug is acridine dyes"},{"label":"D","text":"The first choice of drug is tindazole followed by diloxanide furoate"},{"label":"E","text":"A and D"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-c287fb36aebe","stem":"A definitive host of parasite is a host where","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Asexual reproduction occurs"},{"label":"B","text":"The pathology is most severe"},{"label":"C","text":"Sexual reproduction occurs"},{"label":"D","text":"A parasite invades host tissue"},{"label":"E","text":"None of the above"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"independent_provisional_reasoning","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-fb0278a0d968",