oli"},{"label":"D","text":"Naegleria fowleri"},{"label":"E","text":"A and D Page 8 of 13"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"7c66f89cad19aceb9fd7840efabd518fa8e25919"},{"id":"q-06e5f55d6c5f","stem":"The definition of parasite is","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A virus or bacteria"},{"label":"B","text":"A living organism living in close association with another living organism to meet some of its nutritional needs as well as need for shelter"},{"label":"C","text":"An organism that transports another organism form an infected to an unifested host"},{"label":"D","text":"A living organism who is not dependent of another organism for its survival"},{"label":"E","text":"All of the above"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7417d959697b","stem":"The infective route and mode of parasite may be","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Oral"},{"label":"B","text":"By bites"},{"label":"C","text":"By direct penetration"},{"label":"D","text":"Sexual"},{"label":"E","text":"All of the above"}],"priority":2,"status":"practice_draft","f