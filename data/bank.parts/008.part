tus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-18eec860eb83","stem":"Cerebral malaria is common in which zones of malaria transmission","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Mesoendemic"},{"label":"B","text":"Hyperendemic"},{"label":"C","text":"Hypoendemic"},{"label":"D","text":"Holoendemic"},{"label":"E","text":"A and C"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-22cab98b0d22","stem":"Which malaria parasite antigen is associated with development of cebral malaria","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Duffy binding protein FYa and FYb"},{"label":"B","text":"Plasmodium ovale, thrombospondin which binds to infected Red Blood Cells"},{"label":"C","text":"Plasmodium falciparum Erythrocytes membrane protein-1 expressed on the infected red blood cells"},{"label":"D","text":"Chondroitin sulphate A and P-selectin"},{"label":"E","text":"A and D."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-aca0767e8f58","stem":"Which major receptor is responsible for cytoadherence and sequestration of infected red blood cells in the brain","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Thrombospondin (naturally occurring CD36)"},{"label":"B","text":"Intracellular adhesion molecule-1"},{"label":"C","text":"Chondroitin sulphate A"},{"label":"D","text":"Protein VCAM and PECAM"},{"label":"E","text":"E-selectin, P-selectin, α and β integrin"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-c45ec0daa635","stem":"The periodic fever paroxysms characteristics of malaria are associated with","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The release of merozoites form the infected erythrocytes"},{"label":"B","text":"Increase in serum levels of proinflammatory cytokines such as TNF-α"},{"label":"C","text":"A period of intense chills(i.e rigor) at the beginning of paroxysms"},{"label":"D","text":"A, B and C"},{"label":"E","text":"None of the above Page 3 of 13"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-bc051c4ecf88","stem":"In which of the following situation would you expect the most morbidity and mortality associated with malaria","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A malaria epidemic"},{"label":"B","text":"A holoendemic area with stable transmission"},{"label":"C","text":"Highly seasonal transmission"},{"label":"D","text":"Both A and B would be approximately the same in regards to disease"},{"label":"E","text":"Hyper endemic"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-84f47a2f3a45","stem":"In severe malaria, anaemia occurs due to the following reasons except","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Rapid haemolysis of parasitized red blood cells"},{"label":"B","text":"Bone marrow erythropoiesis due to release of intramedullary cytokines production"},{"label":"C","text":"Destruction of red blood cells containing parasites at merogony"},{"label":"D","text":"Destrudtion of non-parasitized red blood cells"},{"label":"E","text":"A and D"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-22897ce1fecf","stem":"Tropical splenomegaly syndrome in malaria patients occurs due to","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"increased capacity to clear red blood cells form circulation both by Fc receptor mediated (immune) and by recognition of reduced deformability (filtration)"},{"label":"B","text":"Increased use of antimalarial drugs among the population living in malaria endemic areas"},{"label":"C","text":"Increased accumulation of blood in the spleen and the role it plays to compensate for anemia"},{"label":"D","text":"increased macromolecular IgM aggregates and hypertrophy of splenic reticuloendothelial due to repeated infection by malaria parasites"},{"label":"E","text":"A and D."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-47af1ae22b71","stem":"The major attributed cause of death in malaria patients is","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"hypoglycemia"},{"label":"B","text":"lactic acidosis"},{"label":"C","text":"Jaundice and Hepatic dysfunction"},{"label":"D","text":"high level of cytokines production"},{"label":"E","text":"None of the above Page 4 of 13"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-2c52fb00e956","stem":"Which combination therapy is used as first line treatment for uncomplicated malaria in Tanzania","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Amodiaquine and Artesunate"},{"label":"B","text":"Dihydroartemesinin and Proguanil"},{"label":"C","text":"Artemehter and lumefantrine"},{"label":"D","text":"sulphadoxine-pyrimethamine + Artesunate"},{"label":"E","text":"Mefloquine and Artesunate"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-3ddd26c2d2fd","stem":"Which drug is indicated for treatment of complicated malaria in endemic areas","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Amodiaquine and Artesunate"},{"label":"B","text":"Dihydroartemesinin and Proguanil"},{"label":"C","text":"Artemether and Lumefantrine4"},{"label":"D","text":"Sulphadoxine-pyrimethamine + Artesunate"},{"label":"E","text":"Quinine"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5c76952a2d7d","stem":"Which statement is not true about immunity of malaria","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Immunity to malaria develops very fast in endemic population"},{"label":"B","text":"immunity to malaria is species specific"},{"label":"C","text":"Immunity to malaria is strain specific"},{"label":"D","text":"Immunity to malaria is stage specific"},{"label":"E","text":"All of the above"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-acee59a143f8","stem":"Which of the following coccidians does not actually invade the intenstinal epithelial cells, but it is located in a compartment defined as being extracytoplasmic","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cytosporidum pavrum"},{"label":"B","text":"Cyclospora cayetanensis"},{"label":"C","text":"Isospora belli"},{"label":"D","text":"Balantidium coli"},{"label":"E","text":"None of the above since all invades cells Page 5 of 13"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0c39b813888c","stem":"Entamoeba histolytica trophozoites are characterized by","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Expression of particular GIAP allele on their surface"},{"label":"B","text":"The ability to kill cells in contact dependent manner"},{"label":"C","text":"Insensitivity to metronidazole"},{"label":"D","text":"Activate production of IgE and eosinophils"},{"label":"E","text":"All of the above"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"n