,{"label":"D","text":"typically utilize a cysticercoid metacestode in the intermediate host"},{"label":"E","text":"are not medically or economically important"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"31a10ac6c4facc62d50e985e027cc8d7a98ac38d"},{"id":"q-0e40b5f4385c","stem":"Taenia multiceps utilizes which of the following metacestode types","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"cysticercoid"},{"label":"B","text":"cysticercus"},{"label":"C","text":"coenurus"},{"label":"D","text":"plerocercoid"},{"label":"E","text":"hydatid cyst"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"independently_reasoned_provisional_oct20","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-45c056281320","stem":"Which group of flatworms possesses a parauterine organ?","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Schistosomatidae"},{"label":"B","text":"Monogenea"},{"label":"C","text":"Opisthorchiidae"},{"label":"D","text":"Mesocestoidea"},{"label":"E","text":"Cyclophyllidea"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Me