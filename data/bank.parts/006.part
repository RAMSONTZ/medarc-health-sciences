xt":"delayed"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c528bd543e47","stem":"The principal difference between cytotoxic (type II) and immune complex (type III) hypersensitivity is","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the class (isotype) of antibody."},{"label":"B","text":"the site where antigen-antibody complexes are formed."},{"label":"C","text":"the participation of complement."},{"label":"D","text":"the participation of T cells."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{}},{"id":"q-04af7246e977","stem":"A child stung by a bee experiences respiratory distress within minutes and lapses into unconsciousness. This reaction is probably mediated by","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"IgE antibody."},{"label":"B","text":"IgG antibody."},{"label":"C","text":"sensitized T cells."},{"label":"D","text":"complement."},{"label":"E","text":"IgM antibody."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-41efb7dc213c","stem":"A patient with rheumatic fever develops a sore throat from which beta-hemolytic streptococci are cultured. The patient is started on treatment with penicillin, and the sore throat resolves within several days. However, 7 days after initiation of penicillin therapy the patient develops a fever of 103°F, a generalized rash, and proteinuria. This MOST probably resulted from","type":"Single Best Answer MCQ","subject":"Dermatology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"recurrence of the rheumatic fever."},{"label":"B","text":"a different infectious disease."},{"label":"C","text":"an IgE response to penicillin."},{"label":"D","text":"an IgG-IgM response to penicillin."},{"label":"E","text":"a delayed hypersensitivity reaction to penicillin."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Dermatology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7bc88159f918","stem":"A kidney biopsy specimen taken from a patient with acute glomerulonephritis and stained with fluorescein-conjugated anti-human IgG antibody would probably show","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"no fluorescence."},{"label":"B","text":"uniform fluorescence of the glomerular basement membrane."},{"label":"C","text":"patchy, irregular fluorescence of the glomerular basement membrane."},{"label":"D","text":"fluorescent B cells."},{"label":"E","text":"fluorescent macrophages."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{}},{"id":"q-771461e58f75","stem":"A patient with severe asthma gets no relief from antihistamines. The symptoms are MOST likely to be caused by","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Respiratory Medicine","topicOriginal":"Respiratory Medicine","subtopic":"Asthma","suggestedTopic":null,"options":[{"label":"A","text":"interleukin-2."},{"label":"B","text":"slow-reacting substance A (leukotrienes)."},{"label":"C","text":"serotonin."},{"label":"D","text":"bradykinin."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Respiratory Medicine","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-cb52054e8d50","stem":"Hypersensitivity to penicillin and hypersensitivity to poison oak are both","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"mediated by IgE antibody."},{"label":"B","text":"mediated by IgG and IgM antibody."},{"label":"C","text":"initiated by haptens."},{"label":"D","text":"initiated by Th-2 cells."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b1d95afb7fa8","stem":"A recipient of a 2-haplotype MHC-matched kidney from a relative still needs immunosuppression to prevent graft rejection because","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"graft-versus-host disease is a problem."},{"label":"B","text":"minor histocompatibility antigens will not be matched."},{"label":"C","text":"minor histocompatibility antigens will not be matched."},{"label":"D","text":"complement components will not be matched."}],"priority":2,"status":"review","flags":["topic_generic","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_text","nonunique_option_text","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-19c7b294a2e1","stem":"Bone marrow transplantation in immunocompromised patients presents which major problem?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"potentially lethal graft-versus-host disease"},{"label":"B","text":"high risk of T cell leukemia"},{"label":"C","text":"inability to use a live donor"},{"label":"D","text":"delayed hypersensitivity"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0aa1963d4ca4","stem":"What is the role of class II MHC proteins on donor cells in graft rejection?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"They are the receptors for interleukin-2, which is produced by macrophages when they attack the donor cells."},{"label":"B","text":"They are recognized by helper T cells, which then activate cytotoxic T cells to kill the donor cells."},{"label":"C","text":"They induce the production of blocking antibodies that protect the graft."},{"label":"D","text":"They induce IgE which mediates graft rejection."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-006dd471e039","stem":"Grafts between genetically identical individuals (i.e., identical twins)","type":"Single Best Answer MCQ","subject":"Medical Genetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"are rejected slowly as a result of minor histocompatibility antigens."},{"label":"B","text":"are subject to hyperacute rejection."},{"label":"C","text":"are not rejected, even without immunosuppression."},{"label":"D","text":"are not rejected if a kidney is grafted, but skin grafts are rejected."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Genetics","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2e97396c0e88","stem":"Penicillin is a hapten in both humans and mice. To explore the hapten-carrier relationship, a mouse was injected with penicillin covalently bound to bovine serum albumin and, at the same time, with egg albumin to which no penicillin was bound. Of the following, which one will induce a secondary response to penicillin when injected into the mouse 1 month later?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"penicillin"},{"label":"B","text":"penicillin bound to egg albumin"},{"label":"C","text":"egg albumin"},{"label":"D","text":"bovine serum albumin"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9a9d75b8f4e6","stem":"AIDS is caused by a human retrovirus that kills","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"B lymphocytes."},{"label":"B","text":"lymphocyte stem cells."},{"label":"C","text":"CD4-positive T lymphocytes."},{"label":"D","text":"CD8-positive T lymphocytes."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-a50a97ce3cab","stem":"Chemically-induced tumors have tumor-associated transplantation antigens that","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"are always the same for a given carcinogen."},{"label":"B","text":"are different for two tumors of different histologic type even if induced by the same carcinogen."},{"label":"C","text":"are very strong antigens."},{"label":"D","text":"do not induce an immune response."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-32d0769e2583","stem":"Polyomavirus (a DNA virus) causes tumors in \"nude mice\" (nude mice do not have a thymus, because of a genetic defect) but not in normal mice. the BEST interpretation is that","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"macrophages are required to reject polyomavirus-induced tumors."},{"label":"B","text":"natural killer cells can reject polyomavirus-induced tumors without help from T lymphocytes."},{"label":"C","text":"T lymphocytes play an important role in the rejection of polyomavirus-induced tumors."},{"label":"D","text":"B lymphocytes play no role in rejection of polyomavirus-induced tumors."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-2e898f10b955","stem":"C3 is cleaved to form C3a and C3b by C3 convertase. C3b is involved in all of the following EXCEPT","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"altering vascular permeability."},{"label":"B","text":"promoting phagocytosis."},{"label":"C","text":"forming alternative-pathway C3 convertase."},{"label":"D","text":"forming C5 convertase."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d65a5893b427","stem":"After binding to its specific antigen, a B lymphocyte may switch its","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"immunoglobulin light-chain isotype."},{"label":"B","text":"immunoglobulin heavy-chain class."},{"label":"C","text":"variable region of the immunoglobulin heavy chain."},{"label":"D","text":"constant region of the immunoglobulin light chain."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{}},{"id":"q-cac42eb4196d","stem":"Diversity is an important feature of the immune system. Which one of the following statements about it is INCORRECT?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Humans can make antibodies with about 108 different VH X VL combinations."},{"label":"B","text":"A single cell can synthesize IgM antibody, then switch to IgA antibody."},{"label":"C","text":"The hematopoietic stem cell carries the genetic potential to create more than 104 immunoglobulin genes."},{"label":"D","text":"A single B lymphocyte can produce antibodies of many different specificities, but a plasma cell is monospecific."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7b887fea1c5b","stem":"C3a and C5a can cause","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"bacterial lysis."},{"label":"B","text":"vascular permeability."},{"label":"C","text":"phagocytosis of IgE-coated bacteria."},{"label":"D","text":"aggregation of C4 and C2."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-af7f3aab3c71","stem":"Neutrophils are attracted to an infected area by","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"IgM."},{"label":"B","text":"vascular permeability."},{"label":"C","text":"phagocytosis of IgE-coated bacteria."},{"label":"D","text":"aggregation of C4 and C2."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b225f972e802","stem":"Complement fixation refers to","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the ingestion of C3b-coated bacteria by macrophages."},{"label":"B","text":"the destruction of complement in serum by heating at 56°C for 30 minutes."},{"label":"C","text":"the binding of complement components by antigen-antibody complexes."},{"label":"D","text":"the interaction of C3b with mast cells."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-11311be639b0","stem":"The classic complement pathway is initiated by interaction of C1 with","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"antigen."},{"label":"B","text":"factor B."},{"label":"C","text":"antigen-IgG complexes."},{"label":"D","text":"bacterial lipopolysaccharides."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ca9ce7ab0c2f","stem":"Patients with severely reduced C3 levels tend to have","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"increased numbers of severe viral infections."},{"label":"B","text":"increased numbers of severe bacterial infections."},{"label":"C","text":"low gamma globulin levels."},{"label":"D","text":"frequent episodes of hemolytic anemia."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c37ecc191f7b","stem":"Individuals with a genetic deficiency of C6 have","type":"Single Best Answer MCQ","subject":"Medical Genetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"decreased resistance to viral infections."},{"label":"B","text":"increased hypersensitivity reactions."},{"label":"C","text":"increased frequency of cancer."},{"label":"D","text":"decreased resistance to Neisseria bacteremia."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Genetics","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b67b55045eec","stem":"Natural killer cells are","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"B cells that can kill without complement."},{"label":"B","text":"cytotoxic T cells."},{"label":"C","text":"increased by immunization."},{"label":"D","text":"able to kill virus-infected cells without prior sensitization."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-359ae58ac021","stem":"A positive tuberculin skin test (a delayed hypersensitivity reaction) indicates that","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"a humoral immune response has occurred."},{"label":"B","text":"a cell-mediated immune response has occurred."},{"label":"C","text":"both the T and B cell systems are functional."},{"label":"D","text":"only the B cell system is functional."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c23c596923ff","stem":"Reaction to poison ivy or poison oak is","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"an IgG-mediated response."},{"label":"B","text":"an IgE-mediated response."},{"label":"C","text":"a cell-mediated response."},{"label":"D","text":"an Arthus reaction."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-702ad1d62b98","stem":"A child disturbs a wasp nest, is stung repeatedly, and goes into shock within minutes, manifesting respiratory failure and vascular collapse. This is MOST likely to be due to","type":"Single Best Answer MCQ","subject":"Emergency Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"systemic anaphylaxis."},{"label":"B","text":"serum sickness."},{"label":"C","text":"an Arthus reaction."},{"label":"D","text":"cytotoxic hypersensitivity."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Emergency Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-797932be848c","stem":"\"Isotype switching\" of immunoglobulin classes by B cells involves","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"simultaneous insertion of VH genes adjacent to each CH gene."},{"label":"B","text":"successive insertion of a single VH gene adjacent to different CH genes."},{"label":"C","text":"activation of homologous genes on chromosome 6."},{"label":"D","text":"switching of light-chain types (kappa and lambda)."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a3a46a6c704f","stem":"Which one of the following pairs of genes is linked on a single chromosome?","type":"Single Best Answer MCQ","subject":"Medical Genetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"V gene for lambda chain and C gene for kappa chain"},{"label":"B","text":"C gene for gamma chain and C gene for kappa chain"},{"label":"C","text":"V gene for lambda chain and V gene for heavy chain"},{"label":"D","text":"C gene for gamma chain and C gene for alpha chain"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Genetics","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-93e46c243be7","stem":"Idiotypic determinants are located within","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"hypervariable regions of heavy and light chains."},{"label":"B","text":"constant regions of light chains."},{"label":"C","text":"constant regions of heavy chains."},{"label":"D","text":"the hinge region."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{}},{"id":"q-87bfbf936807","stem":"A primary immune response in an adult human requires approximately how much time to produce detectable antibody levels in the blood?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"12 hours"},{"label":"B","text":"3 days"},{"label":"C","text":"1 week"},{"label":"D","text":"3 weeks"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{}},{"id":"q-de9ffcc82ad1","stem":"The membrane IgM and IgD on the surface of an individual B cell","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"have identical heavy chains but different light chains"},{"label":"B","text":"are identical except for their CH regions"},{"label":"C","text":"are identical except for their VH regions"},{"label":"D","text":"have different VH and VL regions"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-03ae396c81ca","stem":"During the maturation of a B lymphocyte, the first immunoglobulin heavy chain synthesized is the","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Mu chain."},{"label":"B","text":"gamma chain."},{"label":"C","text":"epsilon chain."},{"label":"D","text":"alpha chain."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{}},{"id":"q-2ce7062534cb","stem":"In the immune response to a hapten-protein conjugate, in order to get anti-hapten antibodies it is essential that","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the hapten be recognized by helper T cells."},{"label":"B","text":"the protein be recognized by helper T cells."},{"label":"C","text":"the protein be recognized by B cells."},{"label":"D","text":"the hapten be recognized by suppressor T cells."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5cc776812358","stem":"In the determination of serum insulin levels by radioimmunoassay, which one of the following is NOT needed?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"isotope-labeled insulin"},{"label":"B","text":"anti-insulin antibody made in goats"},{"label":"C","text":"anti-goat gamma globulin made in rabbits"},{"label":"D","text":"isotope-labeled anti-insulin antibody made in goats"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0585396a20be","stem":"Which one of the following sequences is appropriate for testing a patient for antibody against the AIDS virus with the ELISA procedure? (The assay is carried out in a plastic plate with an incubation and a wash step after each addition except the final one.)","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"patient's serum/enzyme substrate/HIV antigen/enzyme-labeled antibody against HIV"},{"label":"B","text":"HIV antigen/patient's serum/enzyme-labeled antibody against human gamma globulin/enzyme substrate"},{"label":"C","text":"enzyme-labeled antibody against human gamma globulin/patient's serum/HIV antigen/enzyme substrate"},{"label":"D","text":"enzyme-labeled antibody against HIV/HIV antigen/patient's serum/enzyme substrate"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1ef132af883c","stem":"The BEST method to demonstrate IgG on the glomerular basement membrane in a kidney tissue section is the","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"precipitin test."},{"label":"B","text":"complement fixation test."},{"label":"C","text":"agglutination test."},{"label":"D","text":"indirect fluorescent-antibody test."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8141d0c666cb","stem":"A woman had a high fever, hypotension, and a diffuse macular rash. When all cultures showed no bacterial growth, a diagnosis of toxic shock syndrome was made. Regarding the mechanism by which the toxin causes this disease, which one of the following is LEAST accurate?","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The toxin is not processed within the macrophage."},{"label":"B","text":"The toxin binds to both the class II MHC protein and the T cell receptor."},{"label":"C","text":"The toxin activates many CD4-positive T cells, and large amounts of interleukins are released."},{"label":"D","text":"The toxin has an A-B subunit structure--the B subunit binds to a receptor, and the A subunit enters the cells and activates them."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ca3d2b598df8","stem":"A patient with a central nervous system disorder is maintained on the drug methyldopa. Hemolytic anemia develops, which resolves shortly after the drug is withdrawn. This is MOST probably an example of","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"atopic hypersensitivity."},{"label":"B","text":"cytotoxic hypersensitivity."},{"label":"C","text":"immune-complex hypersensitivity."},{"label":"D","text":"cell-mediated hypersensitivity."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-279368473752","stem":"Which one of the following substances is NOT released by activated helper T cells?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"interleukin-1"},{"label":"B","text":"gamma interferon"},{"label":"C","text":"interleukin-2"},{"label":"D","text":"interleukin-4"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6878401bbf58","stem":"A delayed hypersensitivity reaction is characterized by","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"edema without a cellular infiltrate."},{"label":"B","text":"an infiltrate composed of neutrophils."},{"label":"C","text":"an infiltrate composed of helper T cells and macrophages"},{"label":"D","text":"an infiltrate composed of eosinophils."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{}},{"id":"q-2f7e6bce052a","stem":"Two dissimilar inbred strains of mice, A and B, are crossed to yield an F1 hybrid strain, AB. If a large dose of spleen cells from an adult A mouse is injected into an adult AB mouse, which one of the following is MOST likely to occur? An explanation of the answer to this question is given on p. 24.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The spleen cells will be destroyed."},{"label":"B","text":"The spleen cells will survive and will have no effect in the recipient."},{"label":"C","text":"The spleen cells will induce a graft-versus-host reaction in the recipient."},{"label":"D","text":"The spleen cells will survive and induce tolerance of strain A grafts in the recipient."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6236d86e4b95","stem":"This question is based on the same strains of mice described in the previous question. If adult AB spleen cells are injected into a newborn B mouse, which one of the following is MOST likely to occur? An explanation of the answer to this question is given on p. 24.","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The spleen cells will be destroyed."},{"label":"B","text":"The spleen cells will survive without any effect on the recipient."},{"label":"C","text":"The spleen cells will induce a graft-versus-host reaction in the recipient."},{"label":"D","text":"The spleen cells will survive and induce tolerance of strain A grafts in the recipient."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-fb9c389f817c","stem":"The minor histocompatibility antigens on cells","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"are detected by reaction with antibodies and complement."},{"label":"B","text":"are controlled by several genes in the major histocompatibility complex."},{"label":"C","text":"are unimportant in human transplantation."},{"label":"D","text":"induce reactions that can cumulatively lead to a strong rejection response."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d4e84a416cf5","stem":"Which one of the following is NOT true of class I MHC antigens?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"They can be assayed by a cytotoxic test that uses antibody and complement."},{"label":"B","text":"They can usually be identified in the laboratory in a few hours."},{"label":"C","text":"They are controlled by at least three gene loci in the major histocompatibility complex."},{"label":"D","text":"They are found mainly on B cells, macrophages, and activated T cells."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6a38a0cb2206","stem":"An antigen found in relatively high concentration in the plasma of normal fetuses and a high proportion of patients with progressive carcinoma of the colon is","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"viral antigen."},{"label":"B","text":"carcinoembryonic antigen."},{"label":"C","text":"alpha-fetoprotein."},{"label":"D","text":"heterophil"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-dfd6f9d929f8","stem":"An antibody directed against the idiotypic determinants of a human IgG antibody would react with","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the Fc part of the IgG."},{"label":"B","text":"an IgM antibody produced by the same plasma cell that produced the IgG."},{"label":"C","text":"all human kappa chains."},{"label":"D","text":"all human gamma chains."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a453b5008792","stem":"Which one of the following is NOT true of the gene segments that combine to make up a heavy-chain gene?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Many V region segments are available."},{"label":"B","text":"Several J segments and several D segments are available."},{"label":"C","text":"V, D, and J segments combine to encode the antigen-binding site."},{"label":"D","text":"A V segment and a J segment are preselected by an antigen to make up the variable-region portion of the gene."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8c6c8ab6efa4","stem":"When immune complexes from the serum are deposited on glomerular basement membrane, damage to the membrane is caused mainly by","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"gamma interferon."},{"label":"B","text":"phagocytosis."},{"label":"C","text":"cytotoxic T cells."},{"label":"D","text":"enzymes released by polymorphonuclear cells."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1019585d5c1d","stem":"If an individual was genetically unable to make J chains, which immunoglobulin(s) would be affected?","type":"Single Best Answer MCQ","subject":"Medical Genetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"IgG"},{"label":"B","text":"IgM"},{"label":"C","text":"IgA"},{"label":"D","text":"IgG and IgM"},{"label":"E","text":"IgM and IgA"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Genetics","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2693bacb86b2","stem":"The antibody-binding site is formed primarily by","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the constant regions of H and L chains."},{"label":"B","text":"the hypervariable regions of H and L chains."},{"label":"C","text":"the hypervariable regions of H chains."},{"label":"D","text":"the variable regions of H chains."},{"label":"E","text":"the variable regions of L chains."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-06d112f613bd","stem":"The class of immunoglobulin present in highest concentration in the blood of a human newborn is","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"IgG."},{"label":"B","text":"IgM."},{"label":"C","text":"IgA."},{"label":"D","text":"IgD."},{"label":"E","text":"IgE."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2155b4b6d130","stem":"Individuals of blood group type AB","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"are Rh(d)-negative."},{"label":"B","text":"are \"universal recipients\" of transfusions."},{"label":"C","text":"have circulating anti-A and anti-B antibodies."},{"label":"D","text":"have the same haplotype."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c875162fa3b9","stem":"Cytotoxic T cells induced by infection with virus A will kill target cells","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"from the same host infected with any virus."},{"label":"B","text":"infected by virus A and identical at class I MHC loci of the cytotoxic T cells."},{"label":"C","text":"infected by virus A and identical at class II MHC loci of the cytotoxic T cells."},{"label":"D","text":"infected with a different virus and identical at class I MHC loci of the cytotoxic cells."},{"label":"E","text":"infected with a different virus and identical at class II MHC loci of the cytotoxic cells."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"newly_reasoned_provisional","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-43dcffc34d33","stem":"Antigen-presenting cells that activate helper T cells must express which one of the following on their surfaces?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"IgE"},{"label":"B","text":"gamma interferon"},{"label":"C","text":"class I MHC antigens"},{"label":"D","text":"class II MHC antigens"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-70a10b8d9ca2","stem":"Which one of the following does NOT contain C3b?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"classic-pathway C5 convertase"},{"label":"B","text":"alternative-pathway C5 convertase"},{"label":"C","text":"classic-pathway C3 convertase"},{"label":"D","text":"alternative-pathway C3 convertase"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"independent_reasoning_unverified_sources","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-534df629835e","stem":"Which one of the following is NOT true regarding the alternative complement pathway?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It can be triggered by infectious agents in absence of antibody."},{"label":"B","text":"It does not require C1, C2, or C4."},{"label":"C","text":"It cannot be initiated unless C3b fragments are already present."},{"label":"D","text":"It has the same terminal sequence of events as the classic pathway."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9dfd60311112","stem":"In setting up a complement fixation test for antibody, the reactants should be added in what sequence? (Ag = antigen; Ab = antibody; C = complement; EA = antibody-coated indicator erythrocytes.)","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ag + EA + C/wait/ + patient's serum"},{"label":"B","text":"C + patient's serum + EA/wait/ + Ag"},{"label":"C","text":"Ag + patient's serum + EA/wait/ + C"},{"label":"D","text":"Ag + patient's serum + C/wait/ + EA"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b42292303c12","stem":"Proteins from two samples of animal blood, A and B, were tested by the double-diffusion (Ouchterlony) test in agar against antibody to bovine albumin. Which sample(s) contain horse blood? An explanation of the answer to this question is given on p[dse2] . 24.","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"sample A"},{"label":"B","text":"sample B"},{"label":"C","text":"both samples"},{"label":"D","text":"neither sample"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-977140dbebd6","stem":"Complement lyses cells by","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"enzymatic digestion of the cell membrane."},{"label":"B","text":"activation of adenylate cyclase."},{"label":"C","text":"insertion of complement proteins into the cell membrane."},{"label":"D","text":"inhibition of elongation factor 2."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0783135d6c9f","stem":"Graft and tumor rejection are mediated primarily by","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"non-complement-fixing antibodies."},{"label":"B","text":"phagocytic cells."},{"label":"C","text":"helper T cells."},{"label":"D","text":"cytotoxic T cells."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[],"manualEdits":{}},{"id":"q-edf5f1cef58d","stem":"Which one of the following properties of antibodies is NOT dependent on the structure of the heavy-chain constant region?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"ability to cross the placenta"},{"label":"B","text":"isotype (class)"},{"label":"C","text":"ability to fix complement"},{"label":"D","text":"affinity for antigen"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c00bddaf9f86","stem":"In which one of the following situations would a graft-versus-host reaction be MOST likely to occur? (Mouse strains A and B are highly inbred; AB is an F1 hybrid between strain A and strain B.)","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"newborn strain A spleen cells injected into a strain B adult"},{"label":"B","text":"x-irradiated adult strain A spleen cells injected into a strain B adult"},{"label":"C","text":"adult strain A spleen cells injected into an x-irradiated strain AB adult"},{"label":"D","text":"adult strain AB spleen cells injected into a strain A newborn"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-23fb23f231f9","stem":"In a mixed-lymphocyte culture, lymphocytes from person X, who is homozygous for the HLA-Dw7 allele, are irradiated and then cultured with lymphocytes from person Z. It is found that DNA synthesis is NOT stimulated. The proper conclusion to be drawn is that","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"person Z is homozygous for HLA-Dw7."},{"label":"B","text":"person Z is homozygous or heterozygous for HLA-Dw7."},{"label":"C","text":"person Z is heterozygous for HLA-Dw7."},{"label":"D","text":"person Z does not carry the HLA-Dw7 allele."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6319fbf84038","stem":"A patient skin-tested with purified protein derivative (PPD) to determine previous exposure to Mycobacterium tuberculosis develops induration at the skin test site 48 hours later. Histologically, the reaction site would MOST probably show","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"eosinophils."},{"label":"B","text":"neutrophils."},{"label":"C","text":"helper T cells and macrophages."},{"label":"D","text":"B cells."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f747c35f5580","stem":"Hemolytic disease of the newborn caused by Rh blood group incompatibility requires maternal antibody to enter the fetal bloodstream. Therefore, the mediator of this disease is","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"IgE antibody."},{"label":"B","text":"IgG antibody."},{"label":"C","text":"IgM antibody."},{"label":"D","text":"IgA antibody."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4e9daff512ae","stem":"Which one of the following statements BEST explains the relationship between inflammation of the heart (carditis) and infection with group A beta-hemolytic streptococci?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Streptococcal antigens induce antibodies cross-reactive with heart tissue."},{"label":"B","text":"Streptococci are polyclonal activators of B cells."},{"label":"C","text":"Streptococcal antigens bind to IgE on the surface of heart tissue and histamine is released."},{"label":"D","text":"Streptococci are ingested by neutrophils that release proteases that damage heart tissue."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-af1efc1719ea","stem":"Your patient became ill 10 days ago with a viral disease. Laboratory examination reveals that the patient's antibodies against this virus have a high ratio of IgM to IgG. What is your conclusion?","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It is unlikely that the patient has encountered this organism previously."},{"label":"B","text":"The patient is predisposed to IgE-mediated hypersensitivity reactions."},{"label":"C","text":"The information given is irrelevant to previous antigen exposure."},{"label":"D","text":"It is likely that the patient has an autoimmune disease."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-6e82528ccb91","stem":"If you measure the ability of cytotoxic T cells from an HLA-B27 person to kill virus X-infected target cells, which one of the following statements is CORRECT?","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Any virus X-infected target cell will be killed."},{"label":"B","text":"Only virus X-infected cells of HLA-B27 type will be killed."},{"label":"C","text":"Any HLA-B27 cell will be killed."},{"label":"D","text":"No HLA-B27 cell will be killed."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-4dab27e7f635","stem":"You have a patient who makes autoantibodies against his own red blood cells, leading to hemolysis. Which one of the following mechanisms is MOST likely to explain the hemolysis?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Perforins from cytotoxic T cells lyse the red cells."},{"label":"B","text":"Neutrophils release proteases that lyse the red cells."},{"label":"C","text":"Interleukin-2 binds to its receptor on the red cells, which results in lysis of the red cells."},{"label":"D","text":"Complement is activated, and membrane attack complexes lyse the red cells."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-dc9e17b7ff15","stem":"Your patient is a child who has no detectable T or B cells. This immunodeficiency is most probably the result of a defect in","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the thymus."},{"label":"B","text":"the bursal equivalent."},{"label":"C","text":"T cell-B cell interaction."},{"label":"D","text":"stem cells originating in the bone marrow."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-88168620fc13","stem":"The role of the macrophage during an antibody response is to","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"make antibody."},{"label":"B","text":"lyse virus-infected target cells."},{"label":"C","text":"activate cytotoxic T cells."},{"label":"D","text":"process antigen and present it."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4c20ee90942e","stem":"The structural basis of blood group A and B antigen specificity is","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"a single terminal sugar residue."},{"label":"B","text":"a single terminal amino acid."},{"label":"C","text":"multiple differences in the carbohydrate portion."},{"label":"D","text":"multiple differences in the protein portion."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9916aa09cb8e","stem":"Complement can enhance phagocytosis because of the presence on macrophages and neutrophils of receptors for","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"factor D."},{"label":"B","text":"C3b."},{"label":"C","text":"C6."},{"label":"D","text":"properdin."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f5ca4787ea82","stem":"The main advantage of passive immunization over active immunization is that","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"it can be administered orally."},{"label":"B","text":"it provides antibody more rapidly."},{"label":"C","text":"antibody persists for a longer period."},{"label":"D","text":"it contains primarily IgM."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-91aa8926d71c","stem":"On January 15, a patient developed an illness suggestive of influenza, which lasted 1 week. On February 20, she had a similar illness. She had no influenza immunization during this period. Her hemagglutination inhibition titer to influenza A virus was 10 on January 18, 40 on January 30, and 320 on February 20. Which one of the following is the MOST appropriate interpretation?","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The patient was ill with influenza A on January 15."},{"label":"B","text":"The patient was ill with influenza A on February 20."},{"label":"C","text":"The patient was not infected with influenza virus."},{"label":"D","text":"The patient has an autoimmune disease."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-6e533f90335a","stem":"An individual who is heterozygous for Gm allotypes contains two allelic forms of IgG in serum, but individual lymphocytes produce only one of the two forms. This phenomenon, known as \"allelic exclusion,\" is consistent with","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"a rearrangement of a heavy-chain gene on only one chromosome in a lymphocyte."},{"label":"B","text":"rearrangements of heavy-chain genes on both chromosomes in a lymphocyte."},{"label":"C","text":"a rearrangement of a light-chain gene on only one chromosome in a lymphocyte."},{"label":"D","text":"rearrangements of light-chain genes on both chromosomes in a lymphocyte."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-bd2199bbb276","stem":"Each of the following statements concerning class I MHC proteins is correct EXCEPT","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"They are cell surface proteins on virtually all cells."},{"label":"B","text":"They are recognition elements for cytotoxic T cells."},{"label":"C","text":"They are codominantly expressed."},{"label":"D","text":"They are important in the skin test response to Mycobacterium tuberculosis."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f3d472230d91","stem":"Which one of the following is the BEST method of reducing the effect of graft-versus-host disease in a bone marrow recipient?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"matching the complement components of donor and recipient"},{"label":"B","text":"administering alpha interferon"},{"label":"C","text":"removing mature T cells from the graft"},{"label":"D","text":"removing pre-B cells from the graft"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b25155597e64","stem":"Regarding Th-1 and Th-2 cells, which one of the following is LEAST accurate?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Th-1 cells produce gamma interferon and promote cell-mediated immunity."},{"label":"B","text":"Th-2 cells produce interleukin-4 and -5 and promote antibody-mediated immunity."},{"label":"C","text":"Both Th-1 and Th-2 cells have both CD3 and CD4 proteins on their outer cell membrane."},{"label":"D","text":"Before naïve Th cells differentiate into Th-1 or Th-2 cells, they are double-positives; i.e., they produce both gamma interferon and interleukin-4."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2cfb57a41212","stem":"Each of the following statements concerning the variable regions of heavy chains and the variable regions of light chains in a given antibody molecule is correct EXCEPT","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"They have the same amino acid sequence."},{"label":"B","text":"They define the specificity for antigen."},{"label":"C","text":"They are encoded on different chromosomes."},{"label":"D","text":"They contain the hypervariable regions."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1d16bb981e39","stem":"Each of the following statements concerning class II MHC proteins is correct EXCEPT","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"They are found on the surface of both B and T cells."},{"label":"B","text":"They have a high degree of polymorphism."},{"label":"C","text":"They are involved in the presentation of antigen by macrophages."},{"label":"D","text":"They have a binding site for CD4 proteins."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{}},{"id":"q-93b1dea9a3c6","stem":"Which one of the following statements concerning immunoglobulin allotypes is CORRECT?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Allotypes are found only on heavy chains."},{"label":"B","text":"Allotypes are determined by class I MHC genes."},{"label":"C","text":"Allotypes are confined to the variable regions."},{"label":"D","text":"Allotypes are due to genetic polymorphism within a species."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{}},{"id":"q-e3f4c1144528","stem":"Each of the following statements concerning immunologic tolerance is correct EXCEPT","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Tolerance is not antigen-specific; i.e., paralysis of the immune cells results in a failure to produce a response against many antigens."},{"label":"B","text":"Tolerance is more easily induced in T cells than in B cells."},{"label":"C","text":"Tolerance is more easily induced in neonates than in adults."},{"label":"D","text":"Tolerance is more easily induced by simple molecules than by complex ones."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-45c5f447611c","stem":"Each of the following statements concerning a hybridoma cell is correct EXCEPT","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The spleen cell component provides the ability to form antibody."},{"label":"B","text":"The myeloma cell component provides the ability to grow indefinitely."},{"label":"C","text":"The antibody produced by a hybridoma cell is IgM, because heavy-chain switching does not occur."},{"label":"D","text":"The antibody produced by a hybridoma cell is homogeneous; i.e., it is directed against a single epitope."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e3af5abf6c61","stem":"Each of the following statements concerning haptens is correct EXCEPT","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A hapten can combine with (bind to) an antibody."},{"label":"B","text":"A hapten cannot induce an antibody by itself; rather, it must be bound to a carrier protein to be able to induce antibody."},{"label":"C","text":"In both penicillin-induced anaphylaxis and poison ivy, the allergens are haptens."},{"label":"D","text":"Haptens must be processed by CD8+ cells to become immunogenic. Answers (Questions 387-474): Directions (Questions 475-535): Select the ONE lettered option that is MOST closely associated with the numbered items. Each lettered option may selected once, more than one, nor not at all. Questions 475-480"},{"label":"A","text":"T cells"},{"label":"B","text":"B cells"},{"label":"C","text":"Macrophages"},{"label":"D","text":"B cells and macrophages"},{"label":"E","text":"T cells, B cells, and macrophages"}],"priority":2,"status":"review","flags":["topic_generic","too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","too_many_options","too_many_options_possible_merge","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"5829ee3534fe5a18c37c39f4c1e8fec0bc8c0e89"},{"id":"q-ed5d5434367b","stem":"Express surface immunoglobulin Questions 481-484","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Primary antibody response"},{"label":"B","text":"Secondary antibody response"}],"priority":2,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-f5f4a88ef864","stem":"Typically takes 7-10 days for antibody to appear Questions 485-488","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Blood group A"},{"label":"B","text":"Blood group O"},{"label":"C","text":"Blood groups A and O"},{"label":"D","text":"Blood group AB"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-60550a5d92fe","stem":"People with this type are called \"universal recipients.\" Questions 489-494","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Variable region of light chain"},{"label":"B","text":"variable region of heavy chain"},{"label":"C","text":"Variable regions of light and heavy chains"},{"label":"D","text":"Constant region of heavy chain"},{"label":"E","text":"Constant regions of light and heavy chains"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6a13c19d47d7","stem":"Human transferrin Questions 499-501","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Immediate hypersensitivity"},{"label":"B","text":"Cytotoxic hypersensitivity"},{"label":"C","text":"Immune-complex hypersensitivity"},{"label":"D","text":"Delayed hypersensitivity"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d681ef6509c7","stem":"Mediated by lymphokines Questions 502-505","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"IgM"},{"label":"B","text":"IgG"},{"label":"C","text":