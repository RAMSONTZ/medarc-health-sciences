t":"It has its impact on thrombin rather than the early activated factors"},{"label":"E","text":"To avoid bleeding in surgical patients, it should be given postoperatively"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a739e6def236","stem":"All but one of the following facts relates to Low Molecular Weight Heparin","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Because of its predictable action, it does not usually need monitoring"},{"label":"B","text":"It is given through the subcutaneous route"},{"label":"C","text":"It could be used prophylactically or therapeutically D It could be given intravenously"},{"label":"E","text":"Associated with less chance of Heparin Induced Thrombocytopenia"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-9774f51760a1","stem":"All but one of the followings are known complications of heparin therapy","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Osteoporosis"},{"label":"B","text":"Bleeding from over-anticoagulation"},{"label":"C","text":"Thrombosis from Heparin Induced Thrombocytopenia “HIT” D Immune thrombocytopenic Purpura “ITP”"},{"label":"E","text":"Alopecia"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,