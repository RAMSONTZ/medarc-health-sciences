xt","prior_structural_review_flag","repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"d345471c620f51033193346114ce04085734c807"},{"id":"q-75266342eb5e","stem":"<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"<a:clrMap xmlns:a=\"http://schemas.openxmlformats.org/drawingml/2006/main\" bg1=\"lt1\" tx1=\"dk1\" bg2=\"lt2\" tx2=\"dk2\" accent1=\"accent1\" accent2=\"accent2\" accent3=\"accent3\" accent4=\"accent4\" accent5=\"accent5\" accent6=\"accent6\" hlink=\"hlink\" folHlink=\"folHlink\"/>"},{"label":"B","text":"*€urn:schemas-microsoft-com:office:smarttags"},{"label":"C","text":"€Street"},{"label":"D","text":"*€urn:schemas-microsoft-com:office:smarttags"},{"label":"E","text":"€address"},{"label":"F","text":"*€urn:schemas-microsoft-com:office:smarttags €PlaceName"}],"priority":2,"status":"review","flags":["duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_text","nonunique_option_text","prior_structural_review_flag","repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"d345471c620f51033193346114ce04085734c807"},{"id":"q-2e14de56b9a4","stem":"<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"<a:clrMap xmlns:a=\"http://schemas.openxmlformats.org/drawingml/2006/main\" bg1=\"lt1\" tx1=\"dk1\" bg2=\"lt2\" tx2=\"dk2\" accent1=\"accent1\" accent2=\"accent2\" accent3=\"accent3\" accent4=\"accent4\" accent5=\"accent5\" accent6=\"accent6\" hlink=\"hlink\" folHlink=\"folHlink\"/>"},{"label":"B","text":"*€urn:schemas-microsoft-com:office:smarttags"},{"label":"C","text":"€place"},{"label":"D","text":"ˆF"},{"label":"E","text":"(2©Âqÿ"},{"label":"F","text":"Û(=8Âä ̃ ÿ"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"d345471c620f51033193346114ce04085734c807"},{"id":"q-c7fdf1be0e9d","stem":"<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"<a:clrMap xmlns:a=\"http://schemas.openxmlformats.org/drawingml/2006/main\" bg1=\"lt1\" tx1=\"dk1\" bg2=\"lt2\" tx2=\"dk2\" accent1=\"accent1\" accent2=\"accent2\" accent3=\"accent3\" accent4=\"accent4\" accent5=\"accent5\" accent6=\"accent6\" hlink=\"hlink\" folHlink=\"folHlink\"/>"},{"label":"B","text":"*€urn:schemas-microsoft-com:office:smarttags"},{"label":"C","text":"€place"},{"label":"D","text":"òOx šþT”ÿ"},{"label":"E","text":"YMÎ*6¶21ÿ"},{"label":"F","text":";ì2"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"d345471c620f51033193346114ce04085734c807"},{"id":"q-f169435df1e1","stem":"Know the difference between: WORKSHEET OF EXAM 4 1. You will not be asked to write out a definition for these words, but you should be able to match the work with its definition, and in some case know which terms are specific for a specific group of parasites (e.g. axostyle is only found among the trichomonads (Order Trichomonadida)). -whipworm 2. Be familiar with the generalized nematode life-cycle and the diversity exhibited by the various groups of nematodes. Which ones excrete embryonated eggs versus unembryonated? Which nematodes are ovoviviparous (live birth)? Which nematodes have larvae that go through a migratory phase throughout the body? Which nematode relies on cannibalism to insure its survival as a species? 3. For the parasites listed below that can infect humans during one or more stages of their life-cycle, be familiar with each life-cycle (especially the portion in humans) and general geographic distribution. When appropriate, be able to give a few examples of risk groups, be able to recognize causes of pathology, examples of symptoms, and how you would diagnosis an infection with each. o. Macracanthorhynchus 4. For the parasites listed below that normally infect domestic animals but are not usually zoonotic, be familiar with each life-cycle and general geographic distribution; be able to recognize the causes pathology, and how you would diagnosis an infection with each.","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"miracidium and coracidium"},{"label":"B","text":"sporocyst and redia"},{"label":"C","text":"cercaria and metacercaria"},{"label":"D","text":"cysticercus and coenurus and strobilocercus"},{"label":"E","text":"procercoid and plerocercoid"},{"label":"F","text":"multilocular hydatid cyst and unilocular hydatid cyst 6. How do you identify the eggs of:"},{"label":"A","text":"Schistosoma mansoni"},{"label":"B","text":"S. japonicum"},{"label":"C","text":"S. haematobium"},{"label":"D","text":"Diphyllobothrium latum"},{"label":"E","text":"Taenia solium"},{"label":"F","text":"Dipylidium caninum 7. Know the basic components of the male and female reproductive system for:"},{"label":"A","text":"Digeneans"},{"label":"B","text":"Cestodes 8. Describe differences between the following cestode groups relative to adult morphology and life-cycle:"},{"label":"A","text":"Pseudophyllideans"},{"label":"B","text":"Mesocestoideans"},{"label":"C","text":"Cyclophyllideans 9. Explain why Taenia solium is more dangerous than T. saginata 10. Explain why Echinococcus multilocularis is more dangerous than E. granulosus 11. Why is the distribution of the various cyclophyllidean cestodes more extensive than the various pseudophyllidean cestodes? 12. How could you visually differentiate a trematode egg from a pseudophyllidean egg? 13. Be able to identify example of the following body forms:"},{"label":"A","text":"distome"},{"label":"B","text":"amphistome"},{"label":"C","text":"monostome"},{"label":"D","text":"gastrostome"},{"label":"E","text":"holostome"},{"label":"F","text":"echinostome"},{"label":"G","text":"schistosome 14. What is the most important method used by adult schistosomes to evade the immune response? What stage is susceptible to damage by the immune system? In what organ does the immune system kill most of this susceptible stage? 15. Under normal circumstances, most people growing up in Schistosome endemic areas are infected with only a few worms in spite of the fact that they are exposed to cercaria are numerous occasions. Explain why. 16. Why can Dicrocoelium dendriticum utilize an entirely terrestrial life-cycle? 17. How is a parentenic host different from an intermediate host? 18. How do you typically become infected with a sparganum? 19. How is the 1st intermediate host of Pseudophyllidean tapeworms different from the 1st intermediate host of Mesocestoidean tapeworms? 20. Why does each Echinococcus stapeworm not need to produce as many eggs as each Taenia tapeworm? 21. Why can a tapeworm be refererred to as a colony; why can it be described as an individual? 22. Identify the true larval stage of cestodes. 23. Identify 5 cestodes found in dogs. 24. Why can Mesocestoides utilize a terrestrial life-cycle and still have a thin-shelled egg? 25. What distinctive characteristic does the tetrathyridium metacestode stage and the multilocular hydatid cyst have in common? 26. What type of host are cysticercoids found in? SDSU GENERAL PARASITOLOGY: 467 -acoelomate -amphids -arrowhead worm -autoinfections -bursa -bursate nematodes -caduceus -coelomate -cutaneous larval migrans (creeping eruptions or plumber's itch) -cuticle (cortical, matrix, and basal layers) -dioecious -elephantiasis -eyeworm -filariform juvenile -filariasis -heartworm -herringworm disease -hookworm disease (old world & new world) -hydroskeleton -hypodermis -ivermectin -juvenile -J1-J4 -microfilaria -myocytons -myofibrils -onchocerciasis -parthenogenetic -phasmids -pinworms -pseudocoel -pseudocoelomates -rhabditiform juvenile -renette cells -river blindness -spicule -stichocyte -stichosome -transuterine -trichinosis -vicseral larval migrans"},{"label":"A","text":"Strongyloides stercoralis"},{"label":"B","text":"Ancylostoma duodenale"},{"label":"C","text":"Ancylostoma caninum"},{"label":"D","text":"Necator americanus"},{"label":"E","text":"Ascaris lumbricoides"},{"label":"F","text":"Toxacara canis"},{"label":"G","text":"Baylisascaris sp."},{"label":"H","text":"Anisakis spp. i. Enterobis vermicularis j. Wuchereria bancrofti k. Trichuris trichiura l. Trichinella spiralis m. Onchocerca volvulus n. Loa loa"},{"label":"A","text":"Ascaris suum"},{"label":"B","text":"Toxacara cati"},{"label":"C","text":"Oxyuris equi"},{"label":"D","text":"Dirofilaria immitis"},{"label":"E","text":"Trichuris suis 5. Be able to draw and label the generalized internal anatomy of a nematode, both in longitudinal and cross-section. Know the basic components of the nematode cuticle and the muscular system. Why is the muscular system of nematodes considered to be unusual. Why is the excretory system considered to be unusual. 6. Explain why pinworms are the most prevalent helminth in the U.S.A. Why is it generally recommended that you treat the whole family if one member is shown to be infected. What precaution needs to be taken prior to testing for pinworms. 7. What characteristic of the Strongyloides life-cycle makes it dangerous to AIDS patients? 8. Why must clinicians be careful of the time of day when drawing blood to be used in checking for the presence of microfilaria? 9. List 2 common methods for killing Trichinella spiralis. Why has the invention of the microwave oven increased parasitologists concern for this disease. 10. What is the difference between elephantiasis and filariasis? 11. How does the resistance of Ascaris eggs to desiccation compare to that of hookworm eggs? What features of this nematode egg provides this resistance? 12. Explain the differences between cutaneous larval migrans and visceral larval migrans; which is potentially more dangerous? Why are raising baby raccoons such a bad idea? 13. Trichinosis costs the U.S. farmer considerably more than simply the dollars lost on condemned carcasses. Explain why. 14. What portion of the Ascaris lumbricoides life-cycle typically causes health problems in humans? 15. Which strain of Trichinella spiralis is able to survive colder temperatures (bear vs pig strain), and speculate why? 16. Both hookworms and whipworms can cause anemia because they both damage the intestinal mucosa; however, why is it that only whipworms cause secondary bacterial infections as a result of this mucosal damage? 17. Speculate why Ancylostoma infections cause more blood loss than Necator infections. 18. Speculate why Drucunculus medinensis has specifically been singled out by the WHO and Jimmy Carter Foundation for elimination (i.e. what is it about the life-cycle of this species that makes it a good candidate)? (NOT FOR 2007 EXAM) 19. How does the location of the microfilaria of Onchocerca differ from that of Wuchereria? 20. Apart from differences in their definitive host, how are the life-cycles of Toxacara and Baylisascaris different from that of Ascaris? REVIEW INFORMATION FOR LECTION EXAM Most of the review questions will deal with the non-nematode members of WHO's Top Ten List for parasitic diseases. Therefore, you should expect questions on malaria, Entamoeba histolytica, schistosomes, Giardia, trypanosomes and Leishmania spp. I am attempting to ask questions concerning the more practical side of parasitology (i.e. how the diseases are transmitted and diagnosed, general regional distribution, etc.). Remember that my own research areas deal with Cryptosporidium parvum and taeniid tapeworms, especially Echinococcus multilocularis. It is difficult for me to resist asking questions about my own interests. Due to the relevancy of Toxoplasma to people like yourselves of child-bearing age, you should also expect similar questions concerning this disease. To round out the field, you might expect a couple questions on parasites common to South Dakota such as lice and/or ticks. KNOW WHO'S TOP 10 LIST!!! including their relative position and those parasites which are the most lethal REVIEW INFORMATION FOR COMPREHENSIVE LAB EXAM Be able to identify the following parasites: Arthropoda Hard Tick Soft Tick Bird Mite (Mesostigmata mite) Scabies Mite Follicular Mite Human Head or Body Louse Human Pubic Louse Flea Bed Bug Protozoan Trypanosoma Leishmania Giardia Trichomonas Intestinal Coccidian (i.e. Isospora or Eimeria) Entamoeba Plasmodium Sarcocystis Toxoplasma Trematoda Digenea Fasciola Schistosoma Clinorchis Miracidium developmental stage Cercaria developmental stage Cestoda Pseudophyllidean Mesocestoidean Cyclophyllidean Taenia Echinococcus Dipylidium Egg (oncosphere) developmental stage Cysticercoid metacestode stage Cysticercus metacestode stage Strobilocercus metacestode stage Hydatid cyst metacestode stage SDSU GENERAL PARASITOLGY: 467 LECTURE EXAM #2: OCTOBER 13, 2004 For questions 1-24, choose the best answer; if all of the answers are correct, you must choose that option [48 points] 1. The primary mechanism used by Toxoplasma gondii to evade the mammalian immune system is ........ a. becoming intracellular b. penetrating into privileged sites in the body c. the process of antigenic variation d. masking with host antigens e. causing polyclonal stimulation 2. Identify the protozoan from the list below that can occasionally contain both a flagellum and pseudopods. a. Toxoplasma gondi b. Giardia intestinalis c. Naegleria fowleri d. Trypanosoma cruzi e. Trichomonas vaginalis 3. Identify the procedure still being used successfully for diagnosing chronic Trypanosoma c African Sleeping Sickness in several clinically significant way. Describe 4 of these ways [8 points]"}],"priority":2,"status":"review","flags":["too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","long_option_manual_review","nonunique_option_labels","prior_structural_review_flag","too_many_options","too_many_options_possible_merge"],"cleaningOperations":[]},{"id":"q-2f18b6e29903","stem":"Cryptosporidium parvum 29. Why is malaria often referred to as “black water fever”? What causes this condition? (Hint: what cells does malaria damage, and what is the secondary effects of that damage?) [10 points]","type":"Short Answer","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-bc6e18c699ae","stem":"On the back of this sheet, draw and label the monoxenous Apicomplexa life-cycle; making sure that you at least include the following terms: gametogony, macrogametocytes, merozoites, microgametocytes, oocysts, schizont, sporogony, sporozoites, trophozoites, and zygote. [10 points] 31. Explain why hospital diagnostic labs generally purchase both IgG and IgM serological ELISA’s for diagnosing toxoplasmosis in humans. In other words, why would a physician need to diagnose acute toxoplasmosis and why would they need to diagnose chronic? [10 points]","type":"Image / Diagram Question","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-f6735967dfbf","stem":"Describe in detail the physiological basis for the anemia and neurological symptoms associated with Trypanosoma brucei gambiense infections [5 points]. HYPERLINK \"javascript:WPShow('WPComment1',%20WPComment1%20)\" INCLUDEPICTURE \"http://biomicro.sdstate.edu/hildrethm/zoo467/Exams/3lec04/commenticon.gif\" \\* MERGEFORMATINET Total Points: 190 Multiple Choice Points: 3 X 25 = 75 Matching Points: (3 X 20) + (7 X 3) = 81 Essay Points: 34 HYPERLINK \"javascript:WPHide('WPComment1')\" ___. (4 points) 31. Define the word “premunition”. Next, descripe how premunition minimizes the amount of pathology caused by Schistosoma mansoni to individuals who grow up in areas endemic to this parasite. [15 points] 32. How is a parentenic host different from an intermediate host (be specific)? [5 points]","type":"Essay / Structured Essay","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["possible_multiple_questions_in_stem","url_or_navigation_embedded"],"cleaningOperations":[]},{"id":"q-c6a947f6e9dd","stem":"Explain why Taenia solium is more dangerous to humans than Taenia saginata? [6 points] 34. Why is Echinococcus multilocularis more dangerous than Echinococcus granulosus? [6 points]","type":"Short Answer","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-eb219aefbd13","stem":"Contrast current global distribution of Echinococcus multilocularis to that of Echinococcus granulosus (you can draw maps if you like). What intermediate host limits the distribution of E. granulosus? [10 points]","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"HYPERLINK \"javascript:WPShow('WPComment1',%20WPComment1%20)\""},{"label":"B","text":"INCLUDEPICTURE \"http://biomicro.sdstate.edu/hildrethm/zoo467/Exams/05exam3lc/commenticon.gif\" \\* MERGEFORMATINET"},{"label":"C","text":"Total Points: 190 Multiple Choice Points: 3 X 25 = 75 Matching Points: (3 X 20) + (7 X 3) = 81 Essay Points: 34"},{"label":"D","text":"HYPERLINK \"javascript:WPHide('WPComment1')\""}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-3e2cb25b9aa2","stem":"Explain what causes swimmer's itch. Include the type of flatworm, the developmental stage, and the bodies physiological response. Is this condition restricted to the skin?","type":"Short Answer","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-75692b0e00e3","stem":"Why can the trematode Dicrocoelium dendriticum utilize an entirely terrestrial life-cycle? [5 points]","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"HYPERLINK \"javascript:WPShow('WPComment1',%20WPComment1%20)\""},{"label":"B","text":"INCLUDEPICTURE \"http://biomicro.sdstate.edu/hildrethm/zoo467/Exams/05exam3lc/commenticon.gif\" \\* MERGEFORMATINET"},{"label":"C","text":"Total Points: 190 Multiple Choice Points: 3 X 25 = 75 Matching Points: (3 X 20) + (7 X 3) = 81 Essay Points: 34"},{"label":"D","text":"HYPERLINK \"javascript:WPHide('WPComment1')\""}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"366e4d41a3d38d62233cc59d3218d47526b3417e"},{"id":"q-3b52ad7a4224","stem":"Why can the trematode Dicrocoelium dendriticum utilize an entirely terrestrial life-cycle? [5 points]","type":"Short Answer","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"366e4d41a3d38d62233cc59d3218d47526b3417e"},{"id":"q-e759140748fd","stem":"g. schistosome 14. What is the most important method used by adult schistosomes to evade the immune response? What stage is susceptible to damage by the immune system? In what organ does the immune system kill most of this susceptible stage? 15. Under normal circumstances, most people growing up in Schistosome endemic areas are infected with only a few worms in spite of the fact that they are exposed to cercaria are numerous occasions. Explain why. 16. Why can Dicrocoelium dendriticum utilize an entirely terrestrial life-cycle? 17. How is a parentenic host different from an intermediate host? 18. How do you typically become infected with a sparganum? 19. How is the 1st intermediate host of Pseudophyllidean tapeworms different from the 1st intermediate host of Mesocestoidean tapeworms? 20. Why does each Echinococcus stapeworm not need to produce as many eggs as each Taenia tapeworm? 21. Why can a tapeworm be refererred to as a colony; why can it be described as an individual? 22. Identify the true larval stage of cestodes. 23. Identify 5 cestodes found in dogs. 24. Why can Mesocestoides utilize a terrestrial life-cycle and still have a thin-shelled egg? 25. What distinctive characteristic does the tetrathyridium metacestode stage and the multilocular hydatid cyst have in common? 26. What type of host are cysticercoids found in?","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"SDSU GENERAL PARASITOLOGY: 467"},{"label":"B","text":"WORKSHEET OF EXAM 4 1. You will not be asked to write out a definition for these words, but you should be able to match the work with its definition, and in some case know which terms are specific for a specific group of parasites (e.g. axostyle is only found among the trichomonads (Order Trichomonadida))."},{"label":"C","text":"-acoelomate"},{"label":"D","text":"-amphids"},{"label":"E","text":"-arrowhead worm"},{"label":"F","text":"-autoinfections"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["possible_multiple_questions_in_stem"],"cleaningOperations":[]},{"id":"q-42b2857745b6","stem":"whipworm 2. Be familiar with the generalized nematode life-cycle and the diversity exhibited by the various groups of nematodes. Which ones excrete embryonated eggs versus unembryonated? Which nematodes are ovoviviparous (live birth)? Which nematodes have larvae that go through a migratory phase throughout the body? Which nematode relies on cannibalism to insure its survival as a species? 3. For the parasites listed below that can infect humans during one or more stages of their life-cycle, be familiar with each life-cycle (especially the portion in humans) and general geographic distribution. When appropriate, be able to give a few examples of risk groups, be able to recognize causes of pathology, examples of symptoms, and how you would diagnosis an infection with each.","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"a. Strongyloides stercoralis"},{"label":"B","text":"b. Ancylostoma duodenale"},{"label":"C","text":"c. Ancylostoma caninum"},{"label":"D","text":"d. Necator americanus"},{"label":"E","text":"e. Ascaris lumbricoides"},{"label":"F","text":"f. Toxacara canis"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a66749612e35","stem":"Intestinal protozoa that do not have a cyst stage in the life cycle include the following","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Dientamoeba fragilis and Entamoeba hartmanni"},{"label":"B","text":"Entamoeba hartmanni and Iodamoeba bütschlii"},{"label":"C","text":"Iodamoeba bütschlii and Pentatrichomonas hominis"},{"label":"D","text":"Pentatrichomonas hominis and Dientamoeba fragilis wer is d. 3. An amebic cyst measuring 9 μm and containing four nuclei and chromatoidal bars with smooth, rounded ends is most likely:"},{"label":"A","text":"Endolimax nana"},{"label":"B","text":"Entamoeba hartmanni"},{"label":"C","text":"Iodamoeba bütschlii"},{"label":"D","text":"Entamoeba histolytica f a patient has watery diarrhea, the stage in the life cycle of the intestinal protozoa that is most likely to be seen in the permanent stained smear is the:"},{"label":"A","text":"Cyst"},{"label":"B","text":"Precyst"},{"label":"C","text":"Trophozoite"},{"label":"D","text":"Pretrophozoite oan stage most likely to be seen will be the trophozoite. The term \"pretrophozoite\" is not a correct term. The correct"},{"label":"A","text":"Entamoeba histolytica/E. dispar trophozoites"},{"label":"B","text":"Entamoeba hartmanni trophozoites"},{"label":"C","text":"Entamoeba dispar trophozoites"},{"label":"D","text":"Entamoeba histolytica trophozoites the cytoplasm or the use of specific immunoassay reagents, it will be impossible to identify these organisms as the pathogen, E. histolytica or the nonpathogen, E. dispar. The morphology of both trophozoites are basically identical (without the presence of ingested RBCs). The correct"}],"priority":2,"status":"review","flags":["too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["answer_text_in_option","duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","too_many_options","too_many_options_possible_merge"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"],"duplicateStemGroup":"3df80fe51ffd496d3486865daf6325d4524e4c02"},{"id":"q-86f9cc98e5a0","stem":"The presence of Charcot-Leyden (C-L) crystals in the permanent stained smear indicates","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Blood in the stool"},{"label":"B","text":"Excess yeast cells"},{"label":"C","text":"An immune response"},{"label":"D","text":"Nothing harcot-Leyden crystals are formed from the breakdown products of eosinophils, thus the correct answer is (c). These crystals are an indication of an immune response, which may or may not be linked to a parasitic infection. 7. A small lemon-shaped cyst is present in the permanent stained smear, and it has a single nucleus and a curved fibril that has been called \"the shepherd's crook\" - this organism is most likely:"},{"label":"A","text":"Pentatrichomonas hominis"},{"label":"B","text":"Enteromonas hominis"},{"label":"C","text":"Retortamonas intestinalis"},{"label":"D","text":"Chilomastix mesnili hilomastix mesnili is a non-pathogenic flagellate that can be found in the feces. The description above accurately describes the cyst form of this organism (lemon-shaped, single nucleus, curved fibril called the shepherd's crook.. The correct"},{"label":"A","text":"The patient has ingested something contaminated with fecal material containing infective cysts"},{"label":"B","text":"The patient is likely to become symptomatic within a few days to two weeks"},{"label":"C","text":"The patient will remain asymptomatic for at least a month"},{"label":"D","text":"The patient also has pathogenic protozoa in the intestinal tract if additional stools are examined within 10 days e cysts. It does not necessarily mean pathogens are also present, nor does it mean the patient will become symptomatic. The correct"},{"label":"A","text":"Blastocystis hominis and Entamoeba histolytica"},{"label":"B","text":"Endolimax nana and Entamoeba coli"},{"label":"C","text":"Giardia lamblia and Iodamoeba bütschlii"},{"label":"D","text":"Entamoeba hartmanni and Dientamoeba fragilis s hominis, Entamoeba histolytica, Giardia lamblia, and Dientamoeba fragilis. Therefore, the correct"},{"label":"A","text":"Giardia lamblia"},{"label":"B","text":"Trichomonas vaginalis"},{"label":"C","text":"Dientamoeba fragilis"},{"label":"D","text":"Pentatrichomonas hominis protozoan cyst that contains four nuclei, median bodies, and axonemes can be identified as Giardia lamblia. None of the other intestinal flagellates mentioned have a cyst in the life cycle. The correct"}],"priority":2,"status":"review","flags":["topic_generic","too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["answer_text_in_option","duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","too_many_options","too_many_options_possible_merge","topic_generic"],"cleaningOperations":["answer-leak or footer removed"],"duplicateStemGroup":"1d49d737a91a0d013ba20bef050617f9ae51e740"},{"id":"q-eae61ea80e35","stem":"Characteristics of Dientamoeba fragilis include all of the following except","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"This organism is a flagellate with internal flagella"},{"label":"B","text":"Transmission is thought to occur through the ingestion of specific helminth eggs"},{"label":"C","text":"This organism is pathogenic and tends to be more commonly found in children"},{"label":"D","text":"Trophozoites contain a single nucleus, while the cysts contain two nuclei ll of the responses (except d) contain correct information regarding the characteristics of Dientamoeba fragilis. Therefore, the correct answer is d, this organism does not have a cyst form in the life cycle."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["answer_text_in_option","repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"678de52fe69b7a5839f145d60d31cbe3d856611e"},{"id":"q-d6979cc87e6b","stem":"Cryptosporidium parvum, Cyclospora cayetanensis, and Isospora belli are considered to be","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Metazoa"},{"label":"B","text":"Microsporidia"},{"label":"C","text":"Sporozoa"},{"label":"D","text":"Coccidia kely to be seen in a direct wet mount from fresh stool?"},{"label":"A","text":"Entamoeba dispar cysts"},{"label":"B","text":"Blastocystis hominis trophozoites"},{"label":"C","text":"Entamoeba coli cysts"},{"label":"D","text":"Giardia lamblia trophozoites ilia, so that answer is eliminated. Therefore, the correct answer is d; flagellate trophozoites move using their flagella for motility. 14. Which of the following organisms are most likely to be recovered from duodenal aspirate material?"},{"label":"A","text":"Isospora belli and hookworm"},{"label":"B","text":"Giardia lamblia and Strongyloides stercoralis"},{"label":"C","text":"Cryptosporidium parvum and Enterobius vermicularis"},{"label":"D","text":"Microsporidia and Ascaris lumbricoides stercoralis, Cryptosporidium parvum, and the microsporidia. Therefore, the correct"},{"label":"A","text":"Entamoeba dispar"},{"label":"B","text":"Entamoeba coli"},{"label":"C","text":"Giardia lamblia"},{"label":"D","text":"Balantidium coli this organism. So, the most common and most accurate response of those listed above would be Giardia lamblia. Therefore, the correct"},{"label":"A","text":"Coccidian oocysts"},{"label":"B","text":"Amebic cysts"},{"label":"C","text":"Fungal spores"},{"label":"D","text":"Bacteria ome stains. This appearance tends to mimic bacteria or very small yeast. Therefore, the correct"},{"label":"A","text":"1 to 4 μm"},{"label":"B","text":"4 to6 μm"},{"label":"C","text":"8 to10 μm"},{"label":"D","text":"None of the above tal \"stripe\" or \"bar\" seen in microsporidial spores is actually the:"},{"label":"A","text":"Feeding groove fibril"},{"label":"B","text":"Polar tubule"},{"label":"C","text":"Vacuole outline"},{"label":"D","text":"Axostyle support rod stripe\" or \"bar\" that provides evidence that the object is a true microsporidial spore and not artifact. Therefore, the correct"},{"label":"A","text":"Sporozoites"},{"label":"B","text":"Gametocytes"},{"label":"C","text":"Blastocysts"},{"label":"D","text":"Sporoblasts ryptosporidium oocysts measure approximately 4 to 6 microns, are immediately infective when passed in the stool and contain four sporozoites. Although these sporozoites are not visible within every oocyst, the oocyst is still infective. Therefore, the correct"},{"label":"A","text":"Entamoeba histolytica cysts and Isospora belli oocysts"},{"label":"B","text":"Giardia lamblia trophozoites and Cyclospora cayetanensis oocysts"},{"label":"C","text":"Microsporidian spores and Endolimax nana trophozoites"},{"label":"D","text":"Cryptosporidium parvum oocysts and Entamoeba coli cysts lthough protozoan cysts are generally infectious when passed, trophozoites are not. Neither Isospora or Cyclospora oocysts are infective when passed. Therefore, the correct"},{"label":"A","text":"Entamoeba dispar"},{"label":"B","text":"Enterocytozoon bieneusi"},{"label":"C","text":"Pentatrichomonas hominis"},{"label":"D","text":"Giardia lamblia spar and Pentatrichomonas hominis are nonpathogenic, and, although Giardia lamblia is pathogenic, the infection in the compromised host may not be that different from that seen in the immunocompetent host. Therefore, the correct"},{"label":"A","text":"White blood cells (WBCs) and Blastocystis hominis"},{"label":"B","text":"Red blood cells (RBCs) and Entamoeba histolytica"},{"label":"C","text":"Budding yeast cells and Giardia lamblia"},{"label":"D","text":"Charcot-Leyden crystals and microsporidian spores enerally, it is not recommended that intestinal protozoa be quantitated on the report form; however, there is one exception and that is Blastocystis hominis. There may be a relationship between numbers and symptoms, so the recommendation is to report and quantitate this particular organism. It is also recommended that WBCs, RBCs, and budding yeast cells should be quantitated when reported. Therefore, the correct"},{"label":"A","text":"Entamoeba histolytica trophozoites"},{"label":"B","text":"Entamoeba coli trophozoites"},{"label":"C","text":"Entamoeba dispar trophozoites"},{"label":"D","text":"Entamoeba histolytica/E. dispar trophozoites a/E. dispar trophozoites. Unless RBCs were seen in the cytoplasm of the trophozoite, one could not identify the organism as a true pathogen, Entamoeba histolytica. Entamoeba coli would tend to have uneven nuclear chromatin with a large, eccentric karyosome. The correct"},{"label":"A","text":"Permanent stained smear"},{"label":"B","text":"Direct wet preparation"},{"label":"C","text":"Concentration wet preparation"},{"label":"D","text":"Agar plate culture ecause Balantidium coli trophozoites and cysts are so large, they tend to overstain on the permanent stained smear and can be confused with helminth eggs and/or artifacts. The best approach to identification is the examination of the concentration wet preparation, where the morphology (including cilia on the trophozoite) can be easily seen. Therefore, the correct"},{"label":"A","text":"Cryptosporidium parvum"},{"label":"B","text":"Enterocytozoon bieneusi"},{"label":"C","text":"Balantidium coli"},{"label":"D","text":"Trichomonas vaginalis orrect"},{"label":"A","text":"Macrophages"},{"label":"B","text":"Polymorphonuclear leukocytes"},{"label":"C","text":"Epithelial cells"},{"label":"D","text":"Eosinophils ymorphonuclear leukocytes (PMNs) are in the stool for some time, the lobed nuclei come apart and can resemble protozoan cysts with four separate \"nuclei\" - however, these \"protozoan cysts\" are really human cells. Therefore, the correct"}],"priority":2,"status":"review","flags":["too_many_options_possible_merge","duplicate_option_labels","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["answer_text_in_option","duplicate_option_labels","duplicate_option_text","long_option_manual_review","nonunique_option_labels","nonunique_option_text","prior_structural_review_flag","repeated_question_stem","too_many_options","too_many_options_possible_merge"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"],"duplicateStemGroup":"45d42b60ff60ad8461149509253200d1fa87656d"},{"id":"q-937c5fce9505","stem":"Charcot-Leyden crystals in human clinical material are frequently associated with an immune response and are thought to be the breakdown products of Ô3Ç’qÎîãμ{ü?","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Neutrophils"},{"label":"B","text":"Eosinophils"},{"label":"C","text":"Monocytes"},{"label":"D","text":"Lymphocytes harcot-Leyden (CL) crystals are formed from the breakdown products of eosinophils. Therefore, the correct"},{"label":"A","text":"Pentatrichomonas hominis"},{"label":"B","text":"Dientamoeba fragilis"},{"label":"C","text":"Trichomonas vaginalis"},{"label":"D","text":"Enteromonas hominis rrect"},{"label":"A","text":"Urine"},{"label":"B","text":"Urethral discharge"},{"label":"C","text":"Prostatic discharge"},{"label":"D","text":"Feces ecovery of this organism is the stool specimen. The correct"},{"label":"A","text":"Formalin concentrate"},{"label":"B","text":"Trichrome stained smear"},{"label":"C","text":"Modified acid-fast stained smear"},{"label":"D","text":"Giemsa stain ientamoeba fragilis is a pathogenic flagellate that has no known cyst form in the life cycle. Therefore, the most important method for the identification of this organism is the permanent stained smear (trichrome, iron-hematoxylin, etc.); without using this approach, the majority of infections using wet mount examination only will be missed. Therefore, the correct"}],"priority":2,"status":"review","flags":["too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["answer_text_in_option","duplicate_option_labels","long_option_manual_review","nonunique_option_labels","prior_structural_review_flag","too_many_options","too_many_options_possible_merge"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization","whitespace/page_marker_normalization"]},{"id":"q-2384411adeca","stem":"Explain what you understand by the term \"critical hatching conditions\" and its significance in the epidemiology of nematode infections in UK.","type":"Short Answer","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-de041b40c04c","stem":"Explain what you understand by the term \"enzootic stability\" and how it relates to the epidemiology of bovine babesiosis in UK.","type":"Short Answer","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-84dbc3075130","stem":"Describe briefly the routes of transmission used by Toxocara canis","type":"Short Answer","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-446ed0cdd2c8","stem":"Describe briefly the migration routes used by nematodes in the final host.","type":"Short Answer","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-5fcd435439ca","stem":"Differentiate between intermediate, paratenic and transport hosts.","type":"Short Answer","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b03f2ef387fb","stem":"Describe briefly how Toxoplasma gondii causes abortion in sheep.","type":"Short Answer","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b8d715155525","stem":"Describe briefly the role of earthworms in the transmission of nematode parasites.","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b5da4a6ba3d8","stem":"Describe briefly how Type I Ostertagiasis differs from Type II Ostertagiasis.","type":"Short Answer","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-59bac32da0ec","stem":"List the range of infective forms used by nematodes giving named examples.","type":"Short Answer","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-3b452f4a099f","stem":"Describe briefly the life cycle of Haemonchus highlighting features of epidemiological and pathological importance.","type":"Short Answer","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-127527286549","stem":"d. Cryptosporidium parvum oocysts and Entamoeba coli cysts ANSWER: Although protozoan cysts are generally infectious when passed, trophozoites are not. Neither Isospora or Cyclospora oocysts are infective when passed. Therefore, the correct","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"a. Entamoeba dispar"},{"label":"B","text":"b. Enterocytozoon bieneusi"},{"label":"C","text":"c. Pentatrichomonas hominis"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["answer_explanation_mixed_into_stem"],"cleaningOperations":["answer-leak or footer removed"]},{"id":"q-0e05528d7abc","stem":"d. Giardia lamblia ANSWER: It has been well documented that microsporidial infections (Enterocytozoon bieneusi) in the compromised host can cause major symptoms/disease. Both Entamoeba dispar and Pentatrichomonas hominis are nonpathogenic, and, although Giardia lamblia is pathogenic, the infection in the compromised host may not be that different from that seen in the immunocompetent host. Therefore, the correct","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"a. White blood cells (WBCs) and Blastocystis hominis"},{"label":"B","text":"b. Red blood cells (RBCs) and Entamoeba histolytica"},{"label":"C","text":"c. Budding yeast cells and Giardia lamblia"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["answer_explanation_mixed_into_stem","possible_multiple_questions_in_stem"],"cleaningOperations":["answer-leak or footer removed"]},{"id":"q-ff03ccdbaf3b","stem":"d. Agar plate culture ANSWER: Because Balantidium coli trophozoites and cysts are so large, they tend to overstain on the permanent stained smear and can be confused with helminth eggs and/or artifacts. The best approach to identification is the examination of the concentration wet preparation, where the morphology (including cilia on the trophozoite) can be easily seen. Therefore, the correct","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"a. Cryptosporidium parvum"},{"label":"B","text":"b. Enterocytozoon bieneusi"},{"label":"C","text":"c. Balantidium coli"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["answer_explanation_mixed_into_stem","topic_generic"],"cleaningOperations":["answer-leak or footer removed"]},{"id":"q-5b2375283c21","stem":"____________ Black flies","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"G","text":"Tunga penetrans"},{"label":"B","text":"Match the following by writing the correct letter on the space provided (1 mark each) 1. ____ Sporocysts 2. ____ Adhesive disk 3. ____ Tachyzoites 4. ____ Schistosomatidae 5. ____ Veneral transmission 6. ____ Dwarf tapeworm used for attachment by Giardia lamblia Gynecophoral canal Toxoplasma gondii Taenia. Saginata Biomphalaria spp Trichomonas vaginalis Amastigote Hymenolepiasis SHORT ANSWERS QUESTIONS: 1. You have just tested positive for the HIV virus, and negative for chronic toxoplasmosis. Describe three precautions that you could take to prevent yourself from becoming infected with Toxoplasma gondii. (3 marks) a.____________________________________________________________________ ______________________________________________________________________ b.______________________________________________________________________ ________________________________________________________________________ c.______________________________________________________________________ ________________________________________________________________________ 2. Name a parasite that has no cyst stage. (2 marks) a. _____________________________________________________________ What is the mode of transmission"}],"priority":2,"status":"review","flags":["mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["long_option_manual_review","mcq_missing_options","not_enough_options","prior_structural_review_flag"],"cleaningOperations":[]},{"id":"q-d68a2a617f68","stem":"<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"<a:clrMap xmlns:a=\"http://schemas.openxmlformats.org/drawingml/2006/main\" bg1=\"lt1\" tx1=\"dk1\" bg2=\"lt2\" tx2=\"dk2\" accent1=\"accent1\" accent2=\"accent2\" accent3=\"accent3\" accent4=\"accent4\" accent5=\"accent5\" accent6=\"accent6\" hlink=\"hlink\" folHlink=\"folHlink\"/>"},{"label":"B","text":"*€urn:schemas-microsoft-com:office:smarttags"},{"label":"C","text":"€country-region"},{"label":"D","text":"*€urn:schemas-microsoft-com:office:smarttags"},{"label":"E","text":"€place"},{"label":"F","text":"òOx šþT”ÿ"}],"priority":2,"status":"review","flag