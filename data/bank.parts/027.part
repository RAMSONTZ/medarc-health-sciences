uditFlags":[],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-b62b0a17ede6","stem":"................ May lead to caries and tooth discoloration when given to children","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-6ec2fd6c5413","stem":"...............may result in the Gray Syndrome when given to neonates","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-1b8b20192d10","stem":"................anticonvulsive drug which can induce its own metabolism","type":"Short Answer","subject":"Pharmacology","topic":"CNS Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"CNS Pharmacology","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"CNS Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-79870cdbe801","stem":"year- old man 2 hours after an excessive exposure to which to the following cholinergic poisons?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Autonomic Pharmacology","options":[{"label":"A","text":"Carbaryl"},{"label":"B","text":"Donepezil"},{"label":"C","text":"Parathion"},{"label":"D","text":"Pilocarpine"},{"label":"E","text":"Flumazenil"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"66129cb1113334b9b7a79067c88f8311549f5403"},{"id":"q-777e57336550","stem":"The following drugs induce mammalian cytochrome-P450 and mediates metabolism of azole ...... ......isoniazid ...... ......rifampicin ...... ...... Carbamazepine ......... ... Phenytoin ...... ...... Phenobarbital","type":"Short Answer","subject":"Pharmacology","topic":"Antimicrobials · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antimicrobials","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-44489de8a93c","stem":"Loop diuretics ......... ...... all are sulfonamide derivatives except ethacrynic acid ......... ...... Act by inhibiting Na+/K+/2Cl- cotransporter in the thick ascending limb of Henle's loop ......... ...... increased Ca2+ excretion ......... ...... increase Mg2+ excretion ......... ...... used for relief of edema due to congestive heart failure, kidney disease","type":"Short Answer","subject":"Pharmacology","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-c30d175f2ff3","stem":"Ethambutol ......... ...... visual disturbances: initially red/green color blindness ......... ...... Color vision should be monitored during prolonged treatment. ......... ...... unwanted side effect gout, which is associated with high concentrations of plasma urates ......... ...... cause haemolytic anaemia in individuals with glucose-6-phosphate deficiency ......... ...... decreases the metabolism of the antiepileptic agents, phenytoin, and carbamazepine","type":"Short Answer","subject":"Pharmacology","topic":"Neurology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-93517ff6f524","stem":"Angiotensin converting enzyme inhibitor ...T...... ......reduce preload ...F...... ......is positive inotrope ...F...... ......do not cause cough ...F...... ......no effect on after load ...F......... ...causes muscles fasiculation 23 Which of the following induces microsomal enzymes ...... .........Phenobarbitone ...... .........Ethanol ...... .........Diazepam ......... ......Ketaconazole ......... ......Nevirapine","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-abbcfd0bd056","stem":"Tolerance and physiological dependence occur for which of the following? ......... ......Phenobarbitone ......... ......Diazepam ......... ......Buspirone ......... ......Alcohol ......... ......Imipramine","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-16b58f4ed7d3","stem":"Activity of the following drugs depend on the release of formmaldehyde.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"nalidixic acid. F"},{"label":"B","text":"nifurtinox F © nitrofurantoin F"},{"label":"D","text":"procarbazine F"},{"label":"E","text":"methenamine. T"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-92c6fa8c30d2","stem":"The following may be used in the treatment of tumors of the prostate.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Neoplasia","topicOriginal":"Neoplasia","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"tamoxifen. F"},{"label":"B","text":"frutamide.T ©cyproterone.T"},{"label":"D","text":"stilborestrol.T"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Neoplasia","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f749d6a8c6d9","stem":"The following drugs mimics effects of natural mediators when they combine with mediators.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Tamoxifen. F"},{"label":"B","text":"Morphine.T © Terfenadine. F"},{"label":"D","text":"Captopril. F"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-76546d8e0891","stem":"Metronidazole is used to treat all of the following.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Trichomonal infections. T"},{"label":"B","text":"Giardias. T © amoebic dysentery. T"},{"label":"D","text":"Tetanus.F"},{"label":"E","text":"gas gangrene. T"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-dc338a8f1fa2","stem":"Neomyocin is used in patients who suffer from hepatic failure and hepatic coma because neomyocin causes.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Gastrointestinal","topicOriginal":"Gastrointestinal","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Destruction of highly pathogenic bacterial which often causes sepsis. F"},{"label":"B","text":"Destruction of intestinal bacteria and this lessens the load of bacterial products such as ammonia which may be absorbed. T © Inhibition of hepatotoxic effects of absorbed bacterial by-products. F"},{"label":"D","text":"Diuresis by drawing third space fluid into the gut. F"},{"label":"E","text":"Alleviation of ascending choleangitis, which is usually a factor in hepatic coma secondary to hepatic failure. F"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Gastrointestinal","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e788b6a59aef","stem":"The following oral drugs do not require absorption from gut to exert a therapeutic effect.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"Arcabose. T"},{"label":"B","text":"Methionine F. © Cholestyamine.T"},{"label":"D","text":"Sulfasalazine. T"},{"label":"E","text":"Vancomyocin. T"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-102b5105ecab","stem":"Ethambutol is administered concurrently with streptomyocin in the treatment of TB in order to","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Reduce the pain of injection."},{"label":"B","text":"Facilitate penetration of the BBB. T © Retard the development of organisms resistant to streptomyocin."},{"label":"D","text":"delay excretion of streptomyocin by the kidneys."},{"label":"E","text":"Retard absorption after IM injection."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a8c1414c11ab","stem":"The following statements are true","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Renin is an enzyme."},{"label":"B","text":"Angiotensin I is converted to angiotensin II in the lungs. T © Angiotensin II can promote Na+ retention."},{"label":"D","text":"Angiotensin II is a potent vasodilator."},