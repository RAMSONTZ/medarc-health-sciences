":"B","text":"Substances produced by some microorganisms and their synthetic analogues that selectively kill or inhibit the growth of another microorganisms"},{"label":"C","text":"Substances produced by some microorganisms and their synthetic analogues that inhibit the growth of organism cells"},{"label":"D","text":"Synthetic analogues of natural substances that kill protozoa and helminthes"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Infectious Diseases","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"ca41357f34b886f197114f481758ee5b4bd31aa9"},{"id":"q-cff5d72fd693","stem":"All of the following drugs demonstrate a prolonged effect, EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Penicillin G"},{"label":"B","text":"Procain penicillin 127"},{"label":"C","text":"Bicillin-1"},{"label":"D","text":"Bicillin-5"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"044612ea660a6ba1d57115e098a111823b74d4bc"},{"id":"q-fb58847af794","stem":"Choose the characteristics of lincozamides","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Broad-spectum. Demonstrates a bactericidal effect."},{"label":"B","text":"Influenc