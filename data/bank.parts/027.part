aningOperations":[]},{"id":"q-f7ac625b676f","stem":"Mark the wrong statement","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"CAISSON disease is a kind of decompression sickness"},{"label":"B","text":"Amniotic fluid embolism occurs in cases where uterine veins rupture"},{"label":"C","text":"Less than 20 cc of air are required to cause a lethal gas embolism"},{"label":"D","text":"In divers disease air bubbles are formed and cause generalized small necrosis in various organs"},{"label":"E","text":"A typical clinical symptom of air embolism in divers are the agonizing pains throughout the body so that the patient appears with bending of the back"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"b396f59efc08cfccdd890009c706392cb155eae3"},{"id":"q-259c1cc435bb","stem":"Mark the wrong statement","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"In case of an insulin over dosage an endocrine shock might be the consequence"},{"label":"B","text":"The extreme water loss in cholera can lead to a hypovolaemic shock"},{"label":"C","text":"A typical finding in early shock lung is hyaline membranes"},{"label":"D","text":"A finding in very early stage of shock is the formation of microthrombi – that is why patients in shock appear with a cold and sweaty skin"},{"label":"E","text":"After administration of a contrast medium (e.g. iv-pyelography) some patients might develop an anaphylactic shock"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"b396f59efc08cfccdd890009c706392cb155eae3"},{"id":"q-1200f0ce2eaa","stem":"Mark the wrong statement; Septic Shock","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Has still the highest mortality worldwide"},{"label":"B","text":"Is mostly caused by GRAM-negative bacilli"},{"label":"C","text":"Can be induced by injections with LPS (lipopolysaccharides) - which is the main substance in endotoxins - in the absence of bacteria"},{"label":"D","text":"Is mostly caused by GRAM-positive bacilli and fungi"},{"label":"E","text":"Is clinically characterized by diminished myocardial contractility"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-871a9faf669c","stem":"Mark the correct statement. One of the following pathophysiological mechanism is not typical for shock","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Activation of mediator substances in the lung leading to the formation oof hyaline membranes"},{"label":"B","text":"Increased sympathicotonus with high output of adrenerg substances, leading to increased cardiac contractility"},{"label":"C","text":"Activation of the coagulation system, leading to DIC"},{"label":"D","text":"Acidosis leading to haemolysis of the erythrocytes"},{"label":"E","text":"Acidosis leading to capillary damage"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-90df7ad95ee3","stem":"Mark the correct answer. First aid in a shock situation outside the hospital is","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"To set an infusion in order to keep the veins open"},{"label":"B","text":"To stabilize respiration and cardiac activity"},{"label":"C","text":"To put the legs up"},{"label":"D","text":"To do an immediate blood transfusion"},{"label":"E","text":"To stop any visible bleeding"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["answer_explanation_mixed_into_stem","repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"be654de6c3fd264e5ae5290f214e55b0de3223ed"},{"id":"q-7007a5a67c45","stem":"Fill the gaps (10 marks)","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Malignant tumors in the GIT show their first metastases in ...liver............. (which organ ?)"},{"label":"B","text":"A primary lung carcinoma sets metastases in ......brain ............................ (Which organ ?)"},{"label":"C","text":"A primary ovarian carcinoma can set metastases in ...stomach....................... (which organ ?)"},{"label":"D","text":"An osteosarcoma of the femur causes its first metastases...lungs................. (which organ ?)"},{"label":"E","text":"Peritoneal carcinosis can be suspected when a ..........is seen after taping ( = removing fluid from the abdominal cavity)"},{"label":"F","text":"The most common cancer in women in Tanzania is ...cervix......................"},{"label":"G","text":"The most common cancer in men in Tanzania is ......colonic.................."},{"label":"H","text":"The consumption of cigrate......... and ...g nuts...... multiply the danger of incurring cancers of the upper aero-digestive tract. i. There are cancer types which can be inherited, for example...b lyimphoma............ j. A typical precancerous condition is ...itching...... of the oral cavity or external genitalia"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","too_many_options"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"e9d11443fed7a7d22d5cb39c90a631ce4b71d063"},{"id":"q-7afc233ca787","stem":"Mark the wrong statement","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A carcinoma originates from epithelial cells"},{"label":"B","text":"Mesenchymal cells are the origin of carcinoma"},{"label":"C","text":"Sarcomas originate from mesenchymal cells .D. CARCINOMA ARE MORE THAN SARCOMA E Carcinosarcomas can be found in the female genital tract."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"b396f59efc08cfccdd890009c706392cb155eae3"},{"id":"q-1a915234f02a","stem":"Mark the wrong statement","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A fibroadenoma is a benign tumor of the breast"},{"label":"B","text":"Papillomas are benign tumors of squamous or transitional epithelium"},{"label":"C","text":"THe higher the grade of anaplasia the better the prognosis of a carcinoma"},{"label":"D","text":"Adenomas are benign tumors of the"},{"label":"E","text":"Undifferentiated carcinoma cause early metastases"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"b396f59efc08cfccdd890009c706392cb155eae3"},{"id":"q-12fdb6bb386c","stem":"Mark the wrong statement","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Peritoneal carcinosis often causes haemorrhagic ascites"},{"label":"B","text":"The metastasis of a carcinoma always expresses the same grade of differentiation as the primary tumor"},{"label":"C","text":"A malignant tumor can recur after more than 10 years"},{"label":"D","text":"Ovarian tumors have a tendency to set metastases in the peritoneum"},{"label":"E","text":"The growth of tumor cells inside lymphatic vessels is called lymphangiosis carcinomatosa(lymphangitic carcinomatosis)"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"b396f59efc08cfccdd890009c706392cb155eae3"},{"id":"q-c9fe21e1fd9b","stem":"Mark the wrong statement: the most common site for metastases is","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Liver T"},{"label":"B","text":"bones"},{"label":"C","text":"lung T"},{"label":"D","text":"lymphnodes T"},{"label":"E","text":"heart"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"76f47b6d690cd4998a231dfeedadb1e0ac78284f"},{"id":"q-d711a27771ff","stem":"Mark the correct statement.","type":"Single Best Answer MCQ","subject":"General Pathology","to