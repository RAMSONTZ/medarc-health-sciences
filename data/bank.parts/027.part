,"answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5e2f636d8b48","stem":"Which of the following vitamins can be also synthesized from a dietary precursor?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Vitamin С"},{"label":"B","text":"Vitamin A"},{"label":"C","text":"Vitamin B1"},{"label":"D","text":"Vitamin B6"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-68f1a9985453","stem":"Which of the following vitamins resembles with hormone","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Vitamin К 105"},{"label":"B","text":"Vitamin A"},{"label":"C","text":"Vitamin D"},{"label":"D","text":"Vitamin E"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-bd5f80cf653a","stem":"All of the following statements concerning vitamin A functions are true EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Transmission of light stimuli to the brain, via combination with a specific protein, opsin, to form a visual pigment, rhodopsin, in the retina of the eye"},{"label":"B","text":"Regulation of cell growth and differentiation in epithelium, connective tissues (including bone and cartilage) and hematopoietic tissues by retinoic acid, a highly bioactive metabolite of retinol"},{"label":"C","text":"Retinoic acid is especially important during embryogenesis"},{"label":"D","text":"Acts as a hormone involved in regulation of calcium and phosphorus homeostasis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b80ef026a294","stem":"All of the following statements concerning vitamin E functions are true, EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"An extremely important antioxidant, which protects cell membrane lipids from peroxidation by breaking the chain reaction of free radical formation to which polyunsaturated fatty acids are particularly vulnerable"},{"label":"B","text":"Antisterility and antiabortion factor"},{"label":"C","text":"Specifically required for synthesis of prothrombin and several other clotting factors 106"},{"label":"D","text":"An essential for oxidative processes regulation"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-820ef8c524b4","stem":"Which of the following statements concerning vitamin B1 functions are true","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"An extremely important antioxidant, which protects cell membrane lipids from peroxidation by breaking the chain reaction of free radical formation to which polyunsaturated fatty acids are particularly vulnerable"},{"label":"B","text":"An essential coenzyme for oxidative decarboxylate of alpha-keto acids, most important being conversion of pyruvate to acetyl coenzyme A"},{"label":"C","text":"Specifically required for synthesis of prothrombin and several other clotting factors"},{"label":"D","text":"Essential constituent of the flavoproteins, flavin mononucleotide (FMN) and flavin adenine dinucleotide (FAD)"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6ccc2cf80852","stem":"All of the following statements concerning vitamin B2 functions are true EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Essential constituent of flavoproteins, flavin mononucleotide (FMN) and flavin adenine dinucleotide (FAD)"},{"label":"B","text":"Plays key roles in hydrogen transfer reactions associated with glycolysis, TCA cycle and oxidative phosphorylation"},{"label":"C","text":"An essential coenzyme for oxidative decarboxylate of alpha-keto acids, most important being conversion of pyruvate to acetyl coenzyme A"},{"label":"D","text":"Deficiency symptoms are cheilitis, cheilosis and angular stomatitis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1118114460cb","stem":"Which of the following statements concerning vitamin PP (B3, niacin) functions are true","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Active group of the coenzymes nicotinamide-adenine dinucleotide (NAD) and nicotinamide-adenine phosphate (NADP)"},{"label":"B","text":"An essential coenzyme for oxidative decarboxylate of alpha-keto acids, most important being conversion of pyruvate to acetyl coenzyme A"},{"label":"C","text":"Specifically required for synthesis of prothrombin and several other clotting factors"},{"label":"D","text":"Essential constituent of flavoproteins, flavin mononucleotide (FMN) and flavin adenine dinucleotide (FAD)"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8b49cd907b30","stem":"Which of the following statements concerning pyridoxine (vitamin B6) functions are true","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Active functional form is pyridoxal phosphate, which is an essential coenzyme for transamination and decarboxylation of amino acids in more than 50 different enzyme systems"},{"label":"B","text":"Active group of the coenzymes nicotinamide-adenine dinucleotide (NAD) and nicotinamide-adenine phosphate (NADP)"},{"label":"C","text":"Essential constituent of flavoproteins, flavin mononucleotide (FMN) and flavin adenine dinucleotide (FAD)"},{"label":"D","text":"An extremely important antioxidant, which protects cell membrane lipids from peroxidation by breaking the chain reaction of free radical formation to which polyunsaturated fatty acids are particularly vulnerable"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2b70eeb92e8f","stem":"Which of the following statements concerning pantothinic acid functions are true","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Active functional form is pyridoxal phosphate, which is an essential coenzyme for transamination and decarboxylation of amino acids in more than 50 different enzyme systems"},{"label":"B","text":"Essential constituent of coenzyme A, the important coenzyme for acyl transfer in the TCA cycle and de novo fatty acid synthesis"},{"label":"C","text":"An extremely important antioxidant, which protects cell membrane lipids from peroxidation by breaking the chain reaction of free radical formation to which polyunsaturated fatty acids are particularly vulnerable"},{"label":"D","text":"Coenzyme for several reactions involving CO2 fixation into various compounds e.g. acetyl CoA to malonyl CoA (acetyl CoA carboxylase) – initial step in de novo fatty acid synthesis; propionyl CoA to methylmalonyl CoA (propionyl CoA carboxylase), pyruvate to oxaloacetate (pyruvate carboxylase)"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-bb8e9cb52d61","stem":"Which of the following statements concerning biotin functions are true","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Active functional form is pyridoxal phosphate, which is an essential coenzyme for transamination and decarboxylation of amino acids in more than 50 different enzyme systems"},{"label":"B","text":"Essential constituent of coenzyme A, the important coenzyme for acyl transfer in the TCA cycle and de novo fatty acid synthesis"},{"label":"C","text":"An extremely important antioxidant, which protects cell membrane lipids from peroxidation by breaking the chain reaction of free radical formation to which polyunsaturated fatty acids are particularly vulnerable"},{"label":"D","text":"Coenzyme for several reactions involving CO2 fixation into various compounds e.g. acetyl CoA to malonyl CoA (acetyl CoA carboxylase) – initial step in de novo fatty acid synthesis; propionyl CoA to methylmalonyl CoA (propionyl CoA carboxylase), pyruvate to oxaloacetate (pyruvate carboxylase)"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-fa61a650fe9e","stem":"Which of the following statements concerning vitamin B12 (cyanocobalamin) functions are true","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Active functional form is pyridoxal phosphate, which is an essential coenzyme for transamination and decarboxylation of amino acids in more than 50 different enzyme systems"},{"label":"B","text":"Essential constituent of coenzyme A, the important coenzyme for acyl transfer in the TCA cycle and de novo fatty acid synthesis"},{"label":"C","text":"Coenzyme for numerous metabolic reaction, including transformation of methylamlonyl CoA to succinyl CoA in the metabolism of propionate; DNA synthesis (acts in concert with folic acid); transmethylation e.g. methionine synthesis from homocysteine"},{"label":"D","text":"An extremely important antioxidant, which protects cell membrane lipids from peroxidation by breaking the chain reaction of free radical formation to which polyunsaturated fatty acids are particularly vulnerable"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-76bcdc931282","stem":"Which of the following statements concerning folic acid (folacin) functions are true","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Active functional form is pyridoxal phosphate, which is an essential coenzyme for transamination and decarboxylation of amino acids in more than 50 different enzyme systems 107"},{"label":"B","text":"Essential constituent of coenzyme A, the important coenzyme for acyl transfer in the TCA cycle and de novo fatty acid synthesis"},{"label":"C","text":"Carrier of one-carbon (e.g. methyl) groups that are added to, or removed from, metabolites such as histidine, serine, methionine, and purines"},{"label":"D","text":"An extremely important antioxidant, which protects cell membrane lipids from peroxidation by breaking the chain reaction of free radical formation to which polyunsaturated fatty acids are particularly vulnerable"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9192e892a280","stem":"Which of the following statements concerning vitamin C functions are true","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Active functional form is pyridoxal phosphate, which is an essential coenzyme for transamination and decarboxylation of amino acids in more than 50 different enzyme systems"},{"label":"B","text":"Essential constituent of coenzyme A, the important coenzyme for acyl transfer in the TCA cycle and de novo fatty acid synthesis"},{"label":"C","text":"Carrier of one-carbon (e.g. methyl) groups that are added to, or removed from, metabolites such as histidine, serine, methionine, and purines"},{"label":"D","text":"Has antioxidant properties and is required for various hydroxylation reactions e.g. proline to hydroxypoline for collagen synthesis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverif