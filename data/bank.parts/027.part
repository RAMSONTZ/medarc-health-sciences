Operations":[],"duplicateStemGroup":"793614997c187d73bb5c286c0b50dd2d5ca56fca"},{"id":"q-470dd4fdc77b","stem":"Mark the correct statement: fulminant pulmonal thrombembolism","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"always causes lung infarction"},{"label":"B","text":"causes a (L) heart failure"},{"label":"C","text":"causes chronic congestion in the liver F"},{"label":"D","text":"causes acute ® heart failure F"},{"label":"E","text":"causes ascites and pleural effusion F"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"a394f3151b71c377cd935c638ca38d274da01323"},{"id":"q-1a4129116fcc","stem":"Mark the wrong statement","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"There is a higher risk to develop thrombembolism in young men who are smokers T"},{"label":"B","text":"Most pulmonary emboli are clinically silent T"},{"label":"C","text":"Obese patients are at a higher risk to develop venous thrombosis and thrombembolism F"},{"label":"D","text":"Sudden ® heart failure occurs when more than 60 % of the pulmonary circulation is obstructed with emboli T"},{"label":"E","text":"Recurrent pulmonary embolism can lead to chronic pulmonary hypertension T"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"b396f59efc08cfccdd890009c706392cb155eae3"},{"id":"q-4765066e74f5","stem":"Mark the most correct statement","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"CAISSON disease is a specific type of pulmonary thrombembolism in divers T"},{"label":"B","text":"Schistosoma worms can cause thrombosis of intestinal veins"},{"label":"C","text":"Early mobilization after an operation can provoke thrombembolism F"},{"label":"D","text":"Increased blood pressure can prevent the formation of thrombi in the deep veins of the leg F"},{"label":"E","text":"gasembolism has never such severe complications or outcome – especially pulmonary involvement - as thrombembolism"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"57408180e1c6e909932005abfea73963b56068e4"},{"id":"q-e113c00880f6","stem":"Mark the correct answer. First aid in a shock situation outside the hospital is","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"To set an infusion in order to keep the veins open"},{"label":"B","text":"To stabilize respiration and cardiac activity"},{"label":"C","text":"To put the legs up"},{"label":"D","text":"To do an immediate blood transfusion"},{"label":"E","text":"To stop any visible bleeding Section II - SHORT NOTES"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["answer_explanation_mixed_into_stem","repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"be654de6c3fd264e5ae5290f214e55b0de3223ed"},{"id":"q-4509e41509c5","stem":"Fill the gaps (10 marks)","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Malignant tumors in the GIT show their first metastases in ...[liver]............. (which organ ?)"},{"label":"B","text":"A primary lung carcinoma sets metastases in [brain].................................. (Which organ ?)"},{"label":"C","text":"A primary ovarian carcinoma can set metastases in...[stomach]....................... (which organ ?)"},{"label":"D","text":"An osteosarcoma of the femur causes its first metastases...[lungs]................. (which organ ?)"},{"label":"E","text":"Peritoneal carcinosis can be suspected when a ..........is seen after taping ( = removing fluid from the abdominal cavity)"},{"label":"F","text":"The most common cancer in women in Tanzania is ...[cervix]......................"},{"label":"G","text":"The most common cancer in men in Tanzania is ...[colon]....................."},{"label":"H","text":"The consumption of cigarette ......... and aflatoxins......... multiply the danger of incurring cancers of the upper aero- digestive tract. i. There are cancer types which can be inherited, for example...lymphoma............ j. A typical precancerous condition is [itching]......... of the oral cavity or external genitalia"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","too_many_options"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"e9d11443fed7a7d22d5cb39c90a631ce4b71d063"},{"id":"q-f105361466ca","stem":"Cellular injury and adaptation Home 19. Which of the following changes is associated with irreversible cell damage?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"glycogen depletion"},{"label":"B","text":"flocculent densities in mitochondria"},{"label":"C","text":"cellular swelling."},{"label":"D","text":"loss of microvilli."},{"label":"E","text":"detachment of ribosomes from rER. SUBJECT Pathology SUBJECT CATEGORY Cellular injury and adaptation SUBCATEGORY --- FILE NUMBER"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-489d264a0d78","stem":"Irreversible cellular injury is characterised by all, EXCEPT ??.??.??","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"progressive loss of phospholipids."},{"label":"B","text":"decreased activity of Na+ / K+ ATPase causing cellular swelling."},{"label":"C","text":"damage to the cellular cytoskeleton."},{"label":"D","text":"the presence of reactive O2 species."},{"label":"E","text":"the loss of the intracellular amino acids glycine and L-alanine. SUBJECT Pathology SUBJECT CATEGORY Cellular injury and adaptation SUBCATEGORY --- FILE NUMBER SOURCE OF QUESTION TEXT Robbins EDITION 5th PAGE(s) 9 ORIGINATOR Masonic Hospital primary exam course DATE 1996 CORRECT RESPONSE D APPLICATION"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"400afb052465c6336108802d244891881fb7f885"},{"id":"q-05c2a583a06a","stem":"Free radicals ??.??.??","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"are not a byproduct of metabolism."},{"label":"B","text":"can only form in the presence of oxygen."},{"label":"C","text":"may arise by absorption of radiant energy."},{"label":"D","text":"are removed with the aid of Vitamin A derivatives."},{"label":"E","text":"contain an extra protein that may bind to and destroy organic molecules. SUBJECT Pathology SUBJECT CATEGORY Cellular injury and adaptation SUBCATEGORY --- FILE NUMBER SOURCE OF QUESTION TEXT Robbins EDITION 5th PAGE(s) 11-12 ORIGINATOR Masonic Hospital primary exam course DATE 1996 CORRECT RESPONSE C APPLICATION"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generi