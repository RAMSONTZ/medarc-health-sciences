Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e6b8e92949c6","stem":"Mark the correct statement","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Angina pectoris is caused by an insufficient blood supply of the lungs"},{"label":"B","text":"Lymphedema is never a consequence of cardiac insufficiency"},{"label":"C","text":"Anasarca is a type of exudate"},{"label":"D","text":"Transudate is usually caused by inflammation"},{"label":"E","text":"Ascites in patients with liver cirrhosis is a transudate"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"793614997c187d73bb5c286c0b50dd2d5ca56fca"},{"id":"q-e9bd8f419dd7","stem":"Mark the correct answer – one of the following factors can not cause embolism","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Parasites"},{"label":"B","text":"bone marrow"},{"label":"C","text":"amniotic fluid"},{"label":"D","text":"ascites fluid"},{"label":"E","text":"fat"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAn