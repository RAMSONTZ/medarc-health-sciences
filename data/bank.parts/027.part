ditFlags":[],"cleaningOperations":[]},{"id":"q-fbc7b766dbf9","stem":"Insulin dose may need to be increased in the following except: F. Febrile diseases G. Treatments with glucocorticoid hormones H. Treatments with thyroid hormones or in hyperthyreosis I. Imminent sport activity J. Treatments with thiazides","type":"Short Answer","subject":"Pharmacology","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrinology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-87bf021c9d80","stem":"Which of the following side effects is atypical for heparins? F. Hypotension G. Bleeding H. Thrombocytopenia I. Osteoporosis J. Local or systemic allergic reactions","type":"Short Answer","subject":"Pharmacology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ba5f54c4205c","stem":"Warfarin is frequently applied in patients with the following conditions except: F. Atrial fibrillation G. Deep vein thrombosis H. Artificial heart valves I. Treatment of acute myocardial infarction J. Secondary prophylaxis of myocardial infarcion","type":"Short Answer","subject":"Pharmacology","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"disp