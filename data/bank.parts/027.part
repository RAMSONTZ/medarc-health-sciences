rology","topicOriginal":"Neurology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Acrochordons (skin tags)"},{"label":"B","text":"Neurofibromas"},{"label":"C","text":"Neurilemmomas (Schwannomas)"},{"label":"D","text":"Granular cell tumours"},{"label":"E","text":"‘a’ and ‘b’ 8"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Neurology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"cace5978758f3b53311424967428279592d6d140"},{"id":"q-cd6815232cd1","stem":"The following are present in patient with thyrotoxicosis except","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Nervousness"},{"label":"B","text":"Heat intolerance"},{"label":"C","text":"Muscular weakness"},{"label":"D","text":"Polyuria"},{"label":"E","text":"None of the above 9"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"6fb99d394a91a4e1c9b072bb19a5e6fd6f954517"},{"id":"q-2891a391a83d","stem":"An abscess is a collection of pus. Bacteria which cause pus (Pyogenic Bacteria) reach the infected area by","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Direct infection from outside"},{"label":"B","text":"Local extension fro