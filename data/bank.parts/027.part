options":[{"label":"A","text":"Carbonic anhydrase inhibition leads to increased reabsorption of NaHCO3"},{"label":"B","text":"Loop diuretics decrease Na+ reabsorption at the loop of Henle by competing for the Cl- site on the Na+/K+/2Cl- cotransporter"},{"label":"C","text":"In general, the potency of a diuretic is determined by where it acts in the renal tubule"},{"label":"D","text":"Hydrochlorothiazide decreases urinary calcium excretion"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Renal and Urinary","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"e45c5e514b02fe4b65a12c80823ea2627ace8336"},{"id":"q-292bf8ef005a","stem":"Chronic use of this drug can lead to distal tubular hypertrophy, which may reduce its diuretic effect","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Cardiovascular Drugs · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Cardiovascular Drugs","options":[{"label":"A","text":"Acetazolamide (Diamox)"},{"label":"B","text":"Amiloride (Midamor)"},{"label":"C","text":"Furosemide (Lasix)"},{"label":"D","text":"Hydrochlorothiazide (HydroDiuril)"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular Drugs · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3667a0133f60","stem":"The drug has a steroid-like structure which is responsible for its anti-androgenic effect","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggest