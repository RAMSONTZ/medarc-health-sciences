e,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_text","nonunique_option_text","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-613908f15708","stem":"List 5 classical local signs of inflammation","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"__________________________________________________"},{"label":"B","text":"__________________________________________________"},{"label":"C","text":"___________________________________________________"},{"label":"D","text":"___________________________________________________"},{"label":"E","text":"___________________________________________________ 14"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_text","nonunique_option_text","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"e65ddcf67efbc01ec957f3d8814844ec4b31f67a"},{"id":"q-fe4e1e5ec1de","stem":"List the indications for admission in burn patient","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Trauma and Emergency Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Trauma and Emergency Surgery","options":[{"label":"A","text":"________________________________________________"},{"label":"B","text":"________________________________________________"},{"label":"C","text":"________________________________________________"},{"label":"D","text":"________________________________________________"},{"label":"E","text":"________________________________________________ f) ________________________________________________"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Trauma and Emergency Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_text","nonunique_option_text","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-918526ced149","stem":"Mention the indications for tube thoracostomy","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"__________________________________________________________"},{"label":"B","text":"__________________________________________________________"},{"label":"C","text":"__________________________________________________________"},{"label":"D","text":"__________________________________________________________"},{"label":"E","text":"__________________________________________________________ f) __________________________________________________________"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_text","nonunique_option_text","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-54c2f1ed5674","stem":"A patient with 60kgs body weight come with 6 hours old burn injury involving 40% of his body surface. Name the fluids that you will administer. Calculate the amount needed per 1st 24 hours and how is distributed. __________________________________________________________________ __________________________________________________________________ __________________________________________________________________ __________________________________________________________________ __________________________________________________________________ __________________________________________________________________ __________________________________________________________________ __________________________________________________________________","type":"Short Answer","subject":"General Surgery","topic":"Trauma and Emergency Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Trauma and Emergency Surgery","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Trauma and Emergency Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c271c6117d03","stem":"List down 4 of the 6 P’s of clinical manifestation of acute arterial occlusion","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"____________________________________________________________"},{"label":"B","text":"____________________________________________________________"},{"label":"C","text":"____________________________________________________________"},{"label":"D","text":"_____________________________________________________________"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_text","nonunique_option_text","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-1c4cf4767983","stem":"Intubation / mechanical ventilation - if worsening fatigue and RR Q-9 A 54 year old man has just had a cardiac arrest. He is currently being managed in the Intensive Care Unit (ICU). He is on a ventilator. His vitals were taken and are as follows: Pulse 120 beats/minute Blood pressure 100/50 mmHg An arterial blood gas was also done for this patient and the results are as follows: pH 7.03 pCO2 9.8 kPa PaO2 12 kPa Page 35 of 821 HCO3 18 mmol/L What is the SINGLE most appropriate next step in management of this patient?","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Bicarbonate"},{"label":"B","text":"Intravenous fluid"},{"label":"C","text":"Inotropic drugs"},{"label":"D","text":"Increase ventilation"},{"label":"E","text":"Increase FiO2 ANSWER: Increase ventilation EXPLANATION: In order to answer this question, we need to analyse this patient’s arterial blood gas results."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"01c125c1a6667226aebba713eef84014c02878d3"},{"id":"q-6f9aaee86166","stem":"40% EXPLANATION: STAGES OF HYPOVOLAEMIC SHOCK For adults, the clinical staging relating to loss of blood volume can be classified as: Stage 1 Stage 2 Stage 3 Stage 4 Blood loss","type":"Short Answer","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ab6b3d9a52da","stem":"3 ml adrenaline intramuscularly EXPLANATION: Adrenaline is by far the most important drug in anaphylaxis and should be given as soon as possible. This girl is 9 years old hence 0.3ml of adrenaline is appropriate for her age (6 to 12 years old). The recommended doses for adrenaline are as follows: Adrenaline < 6 months 150 micrograms (0.15 ml 1 in 1,000) 6 months to 6 years 150 micrograms (0.15 ml 1 in 1,000)","type":"Short Answer","subject":"Internal Medicine","topic":"Renal and Urinary","topicOriginal":"Renal and Urinary","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Renal and Urinary","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-262199b12a4d","stem":"12 years 300 micrograms (0.15 ml 1 in 1,000) Adult and child > 12 years 500 micrograms (0.5 ml 1 in 1,000) Page 87 of 821 Adrenaline is the most important drug in anaphylaxis and should be given intramuscularly as soon as possible. Once adrenaline is administered, hydrocortisone and chlorpheniramine should follow. ANAPHYLAXIS ALGORITHM","type":"Short Answer","subject":"Internal Medicine","topic":"Renal and Urinary","topicOriginal":"Renal and Urinary","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Renal and Urinary","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-5bdcb7c527bd","stem":"Which of the following statement is correct regarding acute abdomen?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Abdominal Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Abdominal Surgery","options":[{"label":"A","text":"Parietal pain from the midgut structures is felt at the umbilical region"},{"label":"B","text":"Characteristic pain of acute appendicitis is radiating pain from the umbilicus to the right iliac www.webrand.co.tz SEND Email: wecare@webrand.co.tz Page 2 SOLVED SURGERY UE -2022"},{"label":"C","text":"In the late stages of intestinal obstruction, the patient presents with silent abdomen"},{"label":"D","text":"Somatic pains are usually difficult to localize"},{"label":"E","text":"Signs of peritonism includes muscle guarding, rebound tenderness and hyperactive abdomen."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Abdominal Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"abf5a89595562d75cd70a75b6f8ca1a3f9ee0660"},{"id":"q-13ed620c403c","stem":"In blunt abdominal trauma, what is the investigation of choice in grading severity of liver injury?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Gastrointestinal","topicOriginal":"Gastrointestinal","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Abdominal ultrasound"},{"label":"B","text":"Abdominal CT scan"},{"label":"C","text":"Abdominal X-ray"},{"label":"D","text":"Chest X-ray"},{"label":"E","text":"Diagnostic Peritoneal Lavage (DPL) SOLUTION www.webrand.co.tz SEND Email: wecare@webrand.co.tz Page 5 SOLVED SURGERY UE -2022 The correct answer is B. Abdominal CT scan Abdominal CT (computed tomography) scan is a highly sensitive and specific imaging modality for evaluating the extent and severity of liver injuries. It provides detailed information about the location, size, and vascular involvement of liver injuries, helping in the grading of trauma severity."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Gastrointestinal","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["answer_text_in_option","long_option_manual_review","repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"78ef0258887160a11e4d2b118c6727cdc1f034bc"},{"id":"q-5250bf6f1422","stem":"Which of the following is a correct statement regarding the types of edges?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A malignant ulcer presents with raised edges"},{"label":"B","text":"Beaded edges indicate squamous cell carcinoma"},{"label":"C","text":"Rolled out edges indicate basal cell carcinoma"},{"label":"D","text":"Syphilitic ulcer presents with undermined edge"},{"label":"E","text":"Trophic ulcers usually present with sloppy edge. SOLUTION www.webrand.co.tz SEND Email: wecare@webrand.co.tz Page 6 SOLVED SURGERY UE -2022 Rolled out edges indicates basal cell carcinoma (BBC) i.e., Rodent ulcer. REFFERENCE: Class lecture Notice on Examination of Ulcers, Sinus and Fistula Slide #31 www.webrand.co.tz SEND Email: wecare@webrand.co.tz Page 7 SOLVED SURGERY UE -2022"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"0cfba464f3eaac298a092ea48f76d61be88da443"},{"id":"q-c68bd5da78e0","stem":"Which of the following are classifications are used in grading severity of diabetic foot","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Forrest classification"},{"label":"B","text":"University of San Francisco classification"},{"label":"C","text":"Atlanta's classification"},{"label":"D","text":"Wegner's classification"},{"label":"E","text":"John Hopkin's classification. SOLUTION • Wagner's classification: This widely used system grades diabetic foot ulcers based on depth, infection, and ischemia, with higher grades indicating greater severity and risk of amputation. ***For this question you might not get the correct response if you try chatGPT-3.5"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Endocrinology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"09e6c64d1e0996cfd59b8d0193dd6f2a1568f471"},{"id":"q-eecd4686c816","stem":"An OGD (Esophago-gastroduodenoscopy) was done to a patient with an epigastric mass and it revealed a fungating tumor, easily bleeding at the body of the stomach, what Borman's type does this tumor indicates?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Gastrointestinal","topicOriginal":"Gastrointestinal","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Type 1"},{"label":"B","text":"Type 2"},{"label":"C","text":"Type 3"},{"label":"D","text":"Type 4"},{"label":"E","text":"Type 5 www.webrand.co.tz SEND Email: wecare@webrand.co.tz Page 8 SOLVED SURGERY UE -2022 SOLUTION The Borrmann classification for gastric cancer has only four types, not five. Therefore, option E is immediately eliminated. Based on the description, the tumor in the OGD findings most likely indicates C. Type"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Gastrointestinal","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"66d26b2bda29537c86465791cb82b56a35d2f706"},{"id":"q-8fa172109d64","stem":"Let's see why: Fungating tumor: This characteristic aligns with Type 3 Borrmann tumors, which have an ulcerated and raised appearance with irregular margins. Easily bleeding at the body of the stomach: This further solidifies the possibility of Type 3, as bleeding is associated with the ulceration and friability of these tumors. Here's a breakdown of the Borrmann types and their characteristics","type":"Short Answer","subject":"General Surgery","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7ad4f2ddf369","stem":"All of the following are presentations of a patient with gastric tumor EXCEPT www.webrand.co.tz SEND Email: wecare@webrand.co.tz Page 9 SOLVED SURGERY UE -2022","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Gastrointestinal","topicOriginal":"Gastrointestinal","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Difficulty in swallowing"},{"label":"B","text":"Epigastric mass"},{"label":"C","text":"Non-specific symptoms of abdominal pain, early satiety and abdominal fullness"},{"label":"D","text":"Projectile and bilious vomiting, usually 1 to 2 hours after eating"},{"label":"E","text":"Succussion splash positive on per abdominal examination. SOLUTION The correct answer is D. Projectile and bilious vomiting, usually 1 to 2 hours after eating. While other options can be presentations of a gastric tumor, projectile and bilious vomiting, especially occurring 1-2 hours after eating, is more suggestive of a pyloric stenosis, a condition where the pylorus (outlet of the stomach) becomes narrowed or blocked. This blockage prevents food from emptying from the stomach, leading to delayed vomiting of large amounts of undigested food and bile. Here's why the other options can be associated with gastric tumors: • Difficulty in swallowing: This can occur in advanced tumors that obstruct the upper part of the esophagus or stomach. • Epigastric mass: Some gastric tumors can be palpable as a mass in the upper abdomen. • Non-specific symptoms of abdominal pain, early satiety and abdominal fullness: These are common symptoms of various gastrointestinal conditions, including gastric tumors, but lack specificity for diagnosis. • Succussion splash positive on per abdominal examination: This sign, indicating the presence of fluid and air in the stomach, can be present in various conditions, including gastric tumors, but isn't a reliable indicator alone."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Gastrointestinal","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["answer_text_in_option","long_option_manual_review","url_or_navigation_embedded"],"cleaningOperations":[]},{"id":"q-85284ce24821","stem":"In a patient with gastric malignancy, all of the following are indicators of advanced and unresectable tumor, EXCEPT","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Gastrointestinal","topicOriginal":"Gastrointestinal","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Krukenberg's tumor"},{"label":"B","text":"Irish node"},{"label":"C","text":"Virchow's node"},{"label":"D","text":"Sr. Marry Joseph nodules"},{"label":"E","text":"Peritoneal carcinomatosis. SOLUTION The answer is D. Sr. Marry Joseph nodules www.webrand.co.tz SEND Email: wecare@webrand.co.tz Page 10 SOLVED SURGERY UE -2022 • Sr. Mary Joseph's nodules refer to palpable nodules in the umbilicus, which can be a sign of metastatic spread in cases of intra-abdominal malignancies, including gastric cancer. However, the presence of Sr. Mary Joseph nodules alone does not necessarily indicate unresectability (Removing/cutting/ treating the tumor by surgery means) The other options (A, B, C, and E) are commonly associated with advanced and unresectable gastric tumors: • Krukenberg's tumor: Ovarian metastasis, often indicative of advanced gastric cancer. • Irish node: Supraclavicular lymph node metastasis, often indicative of advanced gastric cancer. • Virchow's node: Left supraclavicular lymph node metastasis, also indicative of advanced gastric cancer. • Peritoneal carcinomatosis: The presence of cancer cells in the peritoneal cavity, often seen in advanced and unresectable cases."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Gastrointestinal","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"1983252cd81c95b6deb723326a80f0d6e6df66f8"},{"id":"q-ef16e78f2b6a","stem":"During examination of axillary lymph nodes in a breast cancer patient, which of the following is a true statement?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Neoplasia","topicOriginal":"Neoplasia","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"To palpate the pectoral group, use the right hand for the right axilla"},{"label":"B","text":"To palpate the brachial group, left hand is used for the right axilla"},{"label":"C","text":"The subcapsular group is best examined from the front"},{"label":"D","text":"The central group of the left axilla is examined with the left hand"},{"label":"E","text":"To examine the supra clavicular lymph nodes, the clinician stands behind the patient. SOLUTION Supra-Clavicular Lymph nodes examination. www.webrand.co.tz SEND Email: wecare@webrand.co.tz Page 11 SOLVED SURGERY UE -2022"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Neoplasia","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"99fcff61d46dc7caddb15b2c7e23bb48fbee22a7"},{"id":"q-63c83dafc7ac","stem":"The following are the features of T4 disease breast cancer EXCEPT","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Neoplasia","topicOriginal":"Neoplasia","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Fixed to pectoralis major muscle"},{"label":"B","text":"Peaud' orange"},{"label":"C","text":"Breast mass which associates with tenderness, hyperemia and warmth. www.webrand.co.tz SEND Email: wecare@webrand.co.tz Page 12 SOLVED SURGERY UE -2022"},{"label":"D","text":"Ulceration"},{"label":"E","text":"A fungating mass. SOLUTION The option that is NOT typically associated with inflammatory breast carcinoma (IBC) is: C. Breast mass which associates with tenderness, hyperemia, and warmth. • Inflammatory breast carcinoma (IBC) often presents with the following features: ✓ Fixed to pectoralis major muscle: Inflammatory breast carcinoma can infiltrate and involve the underlying tissues, including the pectoralis major muscle. ✓ Peau d'orange: \"Orange peel\" appearance of the skin due to edema and blocked lymphatic drainage is a characteristic feature of IBC. ✓ Ulceration: IBC can lead to ulceration of the skin overlying the affected breast. ✓ A fungating mass: IBC may present with a fungating or irregular mass. Option C, with tenderness, hyperemia, and warmth, is more characteristic of an infection or inflammation rather than typical features of inflammatory breast carcinoma. In IBC, the skin changes are often rapid and may not be associated with tenderness, hyperemia, and warmth in the same way as an infection."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Neoplasia","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"3c3b67f743b23a4862d13e86cb4fd6bba185b7f8"},{"id":"q-a323e8d7afd8","stem":"A patient with breast cancer T2 N3c M0 is regarded to be in which stage?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Neoplasia","topicOriginal":"Neoplasia","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"STAGE II"},{"label":"B","text":"STAGE III A"},{"label":"C","text":"STAGE III B"},{"label":"D","text":"STAGE III C"},{"label":"E","text":"STAGE IV SOLUTION www.webrand.co.tz SEND Email: wecare@webrand.co.tz Page 13 SOLVED SURGERY UE -2022 REFERENCE: Class Lecture Notice; BREAST CANCER Slide #51"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Neoplasia","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"301cfb73ee4be541445487eaa19f12a444e1974f"},{"id":"q-ee9de0119ae4","stem":"Which is most likely route for metastasis of breast cancer to the lumber spine?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Neoplasia","topicOriginal":"Neoplasia","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Lymphatic spread"},{"label":"B","text":"Trans celomic spread"},{"label":"C","text":"Batson's Plexus"},{"label":"D","text":"Direct extension"},{"label":"E","text":"Both hematogenous and lymphatics. SOLUTION REFERENCE: Class Lecture Notice: BREAST CANCER Slide #11 **For this question you may not get the correct response if you try chatGPT 3.5"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Neoplasia","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"c13c8c672afc2ff512fa6627e6121d337b21ecaf"},{"id":"q-805d184f748b","stem":"In a patient with obstructive jaundice due to choledocholithiasis, a gallbladder can be palpable in which of the following scenarios?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Gastrointestinal","topicOriginal":"Gastrointestinal","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Primary choledocholithiasis."},{"label":"B","text":"Double impaction of stones at the common bile duct and common hepatic duct"},{"label":"C","text":"Double impaction of stones at the left and right hepatic ducts"},{"label":"D","text":"Double impaction of two stones at the common bile duct"},{"label":"E","text":"Mirizzi syndrome, when a stone obstructing at the confluence. www.webrand.co.tz SEND Email: wecare@webrand.co.tz Page 14 SOLVED SURGERY UE -2022 SOLUTION The scenario in which a gallbladder would be palpable in a patient with obstructive jaundice due to choledocholithiasis is A. Primary choledocholithiasis. Here's why: • Primary choledocholithiasis: In this case, the stones originate in the bile ducts themselves, not the gallbladder. The lack of obstruction in the cystic duct allows bile to continue filling the gallbladder, potentially making it palpable on examination. • Double impaction: In scenarios B, C, D, and E, where there are stones obstructing at different locations within the biliary system, including the cystic duct, bile flow into the gallbladder is impeded. This leads to a shrunken, non-distended gallbladder, making it unlikely to be palpable. • Mirizzi syndrome: In this situation, a stone impacted in the cystic duct compresses the common hepatic duct, preventing bile flow. Similar to other double impaction scenarios, the gallbladder wouldn't be palpable due to lack of distention. Therefore, in primary choledocholithiasis, where the cystic duct remains unobstructed, bile continues to accumulate in the gallbladder, potentially making it palpable on physical examination. This contrasts with other scenarios involving double impaction or cystic duct obstruction, where the gallbladder shrinks and becomes impalpable. ***Attention you may get incorrect response if try chatGPT-3.5 for this question. www.webrand.co.tz SEND Email: wecare@webrand.co.tz Page 15 SOLVED SURGERY UE -2022"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Gastrointestinal","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"fccf0e105709ee51d0792f7db515d398471ae91e"},{"id":"q-0a95d58ba94c","stem":"Which of the following is true regarding obstructive jaundice?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Gastrointestinal","topicOriginal":"Gastrointestinal","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Conjugated bilirubin level is elevated twice than unconjugated bilirubin"},{"label":"B","text":"Conjugated bilirubin level is elevated more than half of the unconjugated bilirubin"},{"label":"C","text":"Total bilirubin level is elevated more than half of the conjugated bilirubin"},{"label":"D","text":"Both conjugated and unconjugated bilirubin levels are equally elevated"},{"label":"E","text":"Conjugated bilirubin level is elevated more than half of the total bilirubin. SOLUTION The correct answer regarding obstructive jaundice is E. Conjugated bilirubin level is elevated more than half of the total bilirubin. Let's explain why: • In obstructive jaundice, the flow of bile from the liver to the intestines is blocked due to various reasons like gallstones, tumors, or inflammation. This blockage prevents the excretion of conjugated bilirubin, a type of bilirubin that has been processed by the liver for elimination. www.webrand.co.tz SEND Email: wecare@webrand.co.tz Page 16 SOLVED SURGERY UE -2022 • As a result, the conjugated bilirubin level rises significantly, often to more than half of the total bilirubin level. Unconjugated bilirubin, which hasn't been processed by the liver, might increase slightly but typically not as much as the conjugated bilirubin. • Therefore, in obstructive jaundice, the ratio of conjugated bilirubin to total bilirubin is greater than 0.5. This ratio helps differentiate obstructive from non- obstructive jaundice, where the unconjugated bilirubin level tends to be dominant."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Gastrointestinal","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["answer_text_in_option","long_option_manual_review","repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"5c906661a3705cfc4a570b584ae82c9ac634cbc8"},{"id":"q-c294020cef69","stem":"The following are possible complications of gallstones EXCEPT?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Mucocele of the gallbladder"},{"label":"B","text":"Nephrolithiasis"},{"label":"C","text":"Acute pancreatitis"},{"label":"D","text":"Intestinal obstruction"},{"label":"E","text":"Post hepatic jaundice. SOLUTION The correct answer is B. Nephrolithiasis. www.webrand.co.tz SEND Email: wecare@webrand.co.tz Page 18 SOLVED SURGERY UE -2022 While gallstones can lead to various complications, nephrolithiasis (kidney stones) is not directly caused by them. Here's why the other options are possible complications of gallstones: • Mucocele of the gallbladder: This occurs when cholesterol stones block the cystic duct, causing gallbladder mucus to accumulate and distend the organ. • Acute pancreatitis: Gallstones can migrate into the pancreatic duct, blocking it and causing inflammation of the pancreas. • Intestinal obstruction: Gallstones can sometimes migrate into the intestines and cause blockage, leading to constipation, vomiting, and abdominal pain. • Post hepatic jaundice: This occurs when gallstones block the common bile duct, preventing bile from reaching the intestines and causing yellowing of the skin and eyes. Therefore, while it's important to be aware of all potential complications associated with gallstones, nephrolithiasis is a separate condition with different causes and risk factors."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["answer_text_in_option","long_option_manual_review","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"a466b8db293aa3e9a711ce123f8f248bd6fd65a9"},{"id":"q-d727ce2a86f6","stem":"What is the length of inguinal canal in adults?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"4cm"},{"label":"B","text":"6 cm"},{"label":"C","text":"8 cm."},{"label":"D","text":"10 cm"},{"label":"E","text":"12 cm SOLUTION www.webrand.co.tz SEND Email: wecare@webrand.co.tz Page 20 SOLVED SURGERY UE -2022"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"5b0f90a30d58ddc8e01362a28b56993241696cef"},{"id":"q-194dc03cc1e2","stem":"Which of the following is the commonest complaint of patients with right sided colonic cancer?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Neoplasia","topicOriginal":"Neoplasia","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Passing of blood in stool"},{"label":"B","text":"Tenesmus"},{"label":"C","text":"Palpable mass in Digital Rectal exam"},{"label":"D","text":"Mass at the right lower abdomen"},{"label":"E","text":"Gross abdominal swelling. SOLUTION The commonest complaint of patients with right-sided colonic cancer is: D. Mass at the right lower abdomen Patients with right-sided colonic cancer may present with vague abdominal discomfort or a palpable mass in the right lower abdomen. Right-sided colon cancers often cause subtle symptoms and may not manifest with the classic signs of left- sided colon cancers, such as rectal bleeding or tenesmus. The other options (A, B, C, and E) are less commonly associated with right-sided colonic cancer: www.webrand.co.tz SEND Email: wecare@webrand.co.tz Page 21 SOLVED SURGERY UE -2022 • Passing of blood in stool is more commonly associated with left-sided colonic cancer. • Tenesmus is not a typical complaint of patients with right-sided colonic cancer. • A palpable mass in digital rectal exam is more likely to be associated with rectal or left-sided colonic cancer. • Gross abdominal swelling is not a common presentation of right-sided colonic cancer."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Neoplasia","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"19c25f6a0aaf995180f7e217b9828a017adc8b53"},{"id":"q-1e4009e8c461","stem":"The following statements are true about achalasia cardia EXCEPT?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It affects lower esophageal end"},{"label":"B","text":"It is due to loss of inhibitory neurons"},{"label":"C","text":"The proximal dilated esophagus contains normal ganglion cells."},{"label":"D","text":"In vigorous achalasia normal ganglion cells are present"},{"label":"E","text":"Its cause is unknown. SOLUTION The statement that is not true about achalasia cardia is C. The proximal dilated esophagus contains normal ganglion cells. Here's why: • A. It affects lower esophageal end: True. Achalasia cardia primarily affects the lower esophageal sphincter (LES) at the junction of the esophagus and stomach. • B. It is due to loss of inhibitory neurons: True. Achalasia cardia is characterized by the loss of inhibitory neurons in the myenteric plexus of the esophageal muscle, leading to impaired relaxation of the LES and difficulty swallowing. • D. In vigorous achalasia normal ganglion cells are present: True. Vigorous achalasia is a subtype where despite the presence of normal ganglion cells, the esophageal muscle exhibits hypercontractility, contributing to swallowing difficulties. • E. Its cause is unknown: False. While the exact cause of achalasia remains unclear, it is believed to involve both genetic and environmental factors, potentially leading to the loss of inhibitory neurons in the esophagus. -Therefore, since achalasia involves damage to the myenteric plexus and ganglion cells within the esophagus, the proximal dilated esophagus typically lacks normal functioning ganglion cells. www.webrand.co.tz SEND Email: wecare@webrand.co.tz Page 22 SOLVED SURGERY UE -2022"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"bcfd6bd32eec72846fa315c8a0f9133ca0cceaa3"},{"id":"q-d30214fe07b8","stem":"The following are the cardiovascular causes of dysphagia EXCEPT which one?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Aneurysm of ascending aorta"},{"label":"B","text":"dilatation of left atrium"},{"label":"C","text":"dysphagia lusoria"},{"label":"D","text":"Aneurysm of descending aorta"},{"label":"E","text":"Hypertrophy of the left atrium SOLUTION www.webrand.co.tz SEND Email: wecare@webrand.co.tz Page 23 SOLVED SURGERY UE -2022"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"3fb99717a6a4f0a78f63e44b77fcf05e0be23554"},{"id":"q-90983a5dad14","stem":"Which of the following is a risk factor for squamous cell carcinoma of the esophagus?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Neoplasia","topicOriginal":"Neoplasia","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Barrett's esophagus"},{"label":"B","text":"Obesity"},{"label":"C","text":"Reflux esophagitis"},{"label":"D","text":"Achalasia"},{"label":"E","text":"H. pylori infection. www.webrand.co.tz SEND Email: wecare@webrand.co.tz Page 24 SOLVED SURGERY UE -2022 SOLUTION A risk factor for squamous cell carcinoma of the esophagus is: D. Achalasia Achalasia is a risk factor for the development of squamous cell carcinoma of the esophagus. Chronic irritation and inflammation associated with achalasia may contribute to the increased risk. The other options are more commonly associated with adenocarcinoma of the esophagus: o Barrett's esophagus: A premalignant condition for adenocarcinoma. o Obesity: Obesity is a risk factor for gastroesophageal reflux disease (GERD) and, subsequently, Barrett's esophagus and adenocarcinoma. o Reflux esophagitis: Chronic reflux can lead to Barrett's esophagus and increase the risk of adenocarcinoma."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Neoplasia","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"9669f8e5ce68d59a9123a33ccdc935a66198bdcd"},{"id":"q-bf179275f69e","stem":"Which of the following is NOT a risk factor for gastric cancer?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Gastrointestinal","topicOriginal":"Gastrointestinal","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cigarette smoking"},{"label":"B","text":"Blood group O"},{"label":"C","text":"Alcohol intake"},{"label":"D","text":"Atrophic gastritis"},{"label":"E","text":"Intake of smoked foods. SOLUTION The factor that is NOT typically considered a risk factor for gastric cancer is: B. Blood group O. • Blood group O is actually associated with a lower risk of gastric cancer. Individuals with blood group A or B have been found to have a higher risk compared to those with blood group O. www.webrand.co.tz SEND Email: wecare@webrand.co.tz Page 25 SOLVED SURGERY UE -2022"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Gastrointestinal","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"e7d5ebf03d96de7c5161070bd8b46ac5a0e99d20"},{"id":"q-773d9cdf5966","stem":"Which of the following is NOT in the Alvarado score in making a diagnosis of Acute appendicitis?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Gastrointestinal","topicOriginal":"Gastrointestinal","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Nausea"},{"label":"B","text":"Vomiting"},{"label":"C","text":"Diarrhea"},{"label":"D","text":"Fever"},{"label":"E","text":"Abdominal pain SOLUTION www.webrand.co.tz SEND Email: wecare@webrand.co.tz Page 29 SOLVED SURGERY UE -2022"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Gastrointestinal","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"19d4599ec8748c911a8550ff70d83d5181d05549"},{"id":"q-e34b8513dc61","stem":"Which of the following clinically differentiates superficial partial thickness and deep partial thickness loss burn injuries?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Trauma and Emergency Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Trauma and Emergency Surgery","options":[{"label":"A","text":"Presence of blisters in superficial partial thickness burn while deep partial thickness burn has no blisters"},{"label":"B","text":"Intact skin appendages in superficial partial thickness burn while deep partial thickness burn has lost the skin appendages"},{"label":"C","text":"Superficial partial thickness burn presents with hyperemia without skin peeling while in deep partial thickness burn There is skin peeling"},{"label":"D","text":"Discharge in superficial thickness burn is serous while that of deep partial thickness burn is serosanguinous"},{"label":"E","text":"Superficial partial thickness burn is usually accompanied with compartment syndrome. www.webrand.co.tz SEND Email: wecare@webrand.co.tz Page 30 SOLVED SURGERY UE -2022 SOLUTION www.webrand.co.tz SEND Email: wecare@webrand.co.tz Page 31 SOLVED SURGERY UE -2022"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Trauma and Emergency Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"122d943863003e70db7259824781923befc742f2"},{"id":"q-b3e37e47fcdf","stem":"A patient presented with ptosis bilaterally, difficult to initiate swallowing and muscle weakness. CT scan shows an intrathoracic mass. What is the most possible diagnosis for that thoracic mass?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Lymphoma"},{"label":"B","text":"Neurogenic tumor"},{"label":"C","text":"Thymoma"},{"label":"D","text":"Substernal thyroid"},{"label":"E","text":"Germ cell tumor SOLUTION The correct answer here is C. Thymoma Here's why the other options are less likely: • Lymphoma: While lymphomas can cause mediastinal masses and muscle weakness, ptosis and swallowing difficulties are less common initial presentations. • Neurogenic tumor: These tumors rarely involve the mediastinum and don't typically cause the specific symptoms mentioned. • Substernal thyroid: A substernal goiter might compress the trachea and cause swallowing difficulties, but ptosis is not a typical feature. • Germ cell tumor: These tumors usually occur in younger individuals and rarely present with such symptoms. Thymoma can directly compress surrounding structures like the esophagus, nerves supplying muscles involved in swallowing, and even cause pressure effects on the www.webrand.co.tz SEND Email: wecare@webrand.co.tz Page 32 SOLVED SURGERY UE -2022 diaphragm leading to weakness. Additionally, thymomas can sometimes produce hormones that contribute to neuromuscular symptoms like ptosis."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["answer_text_in_option","long_option_manual_review","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"f36181a605f5e39733120f16f87da64ec92667d3"},{"id":"q-10e5e12a83f9","stem":"Refer to the patient in question 49 above, what is the most possible location of the thoracic mass?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Anterior mediastinum"},{"label":"B","text":"Middle mediastinum"},{"label":"C","text":"Posterior mediastinum"},{"label":"D","text":"Inferior mediastinum"},{"label":"E","text":"Thoracic inlet ====== BEST LUCK ===== www.webrand.co.tz SEND Email: wecare@webrand.co.tz Page 33 SOLVED SURGERY UE -2022 SECTION B (50 marks)"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"e3c54001f299a18fc460160c8813e708480cbee9"},{"id":"q-81f49e438e8c","stem":"A 30yrs old female presents to you at the clinic with an anterior neck swelling for months. She is seen by your second on call who diagnosed her with a toxic goitre.","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Breast and Endocrine Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Breast and Endocrine Surgery","options":[{"label":"A","text":"What symptoms do you expect to find in this lady (at least 8)? (4 Marks)"},{"label":"B","text":"What signs will you elicit on this patient (at least 8)? (4 Marks)"},{"label":"C","text":"Mention 4 other differential diagnosis of an anterior neck swelling (2 Marks) ====== THE END ====="}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Breast and Endocrine Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"8c1ed5060c43d7a1056bad38a55fb4e03dc3a661"},{"id":"q-ca39c9b256c3","stem":"Which of the following statements about homeostasis are false? A It is defined as a stable state of the normal body. B The central nervous system, heart, lungs, kidneys and spleen are the essential organs that maintain homeostasis at a normal level. C Elective surgery should cause little disturbance to homeostasis. D Emergency surgery should cause little disturbance to homeostasis. E Return to normal homeostasis after an operation would depend upon the presence of co-morbid conditions. ➜Stress response","type":"Short Answer","subject":"General Surgery","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a5232c695185","stem":"In stress response, which of the following statements are false? A It is graded. B Metabolism and nitrogen excretion are related to the degree of stress. C In such a situation there are physiological, metabolic and immunological changes. D The changes cannot be modified. E The mediators to the integrated response are initiated by the pituitary. ➜Mediators","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-00a8a9635a06","stem":"Which of the following statements about mediators are true? A They are neural, endocrine and inflammatory. B Every endocrine gland plays an equal part. C They produce a model of several phases. D The phases occur over several days. E They help in the process of repair. ➜The recovery process","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-572aca858b50","stem":"With regard to the recovery process, identify the statements that are true. A All tissues are catabolic, resulting in repair at an equal pace. B Catabolism results in muscle wasting. C There is alteration in muscle protein breakdown. D Hyperalimentation helps in recovery. E There is insulin resistance. ➜Optimal perioperative care","type":"Short Answer","subject":"General Surgery","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Endocrinology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-4f17c1a8924f","stem":"Which of the following statements are true for optimal perioperative care? A Volume loss should be promptly treated by large intravenous (IV) infusions of fluid. B Hypothermia and pain are to be avoided. C Starvation needs to be combated. D Avoid immobility. E Helpful measures can be taken. PRINCIPLES 4 Answers: Multiple choice questions ➜Homeostasis","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f28d44716f71","stem":"Which of the following statements are true? A Cells change from aerobic to anaerobic metabolism when perfusion to tissues is reduced. B The product of aerobic respiration is lactic acid. C The product of anaerobic respiration is carbon dioxide. D The accumulation of lactic acid in the blood produces systemic respiratory acidosis. E Lack of oxygen and glucose in the cell will eventually lead to failure of sodium/ potassium pumps in the cell membrane and intracellular organelles. ➜Hypovolaemic shock","type":"Short Answer","subject":"General Surgery","topic":"Respiratory","topicOriginal":"Respiratory","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Respiratory","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-720c2aa5e36e","stem":"Which of the following statements regarding hypovolaemic shock are true? A It is associated with high cardiac output. B The vascular resistance is high. C The venous pressure is low. D The mixed venous saturation is high. E The base deficit is low. ➜Ischaemia-reperfusion syndrome","type":"Short Answer","subject":"General Surgery","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b7bd68517f52","stem":"Which of the following statements about ischaemia-reperfusion syndrome is correct? A This refers to the cellular injury because of the direct effects of tissue hypoxia. B It is seen after the normal circulation is restored to the tissues following an episode of hypoperfusion. C The increased sodium load can lead to myocardial depression. D This is influenced by the duration and extent of tissue hypoperfusion. E It usually does not cause death. ➜Responses in shock","type":"Short Answer","subject":"General Surgery","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d43d58777006","stem":"In which of the following cases might tachycardia accompany shock? A Hypovolaemia due to gastrointestinal (GI) bleeds B Patients on alpha-blockers C Patients with implanted pacemakers D Fit young adults with normal pulse rate of 50/min E Cardiogenic shock.","type":"Short Answer","subject":"General Surgery","topic":"Gastrointestinal","topicOriginal":"Gastrointestinal","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Gastrointestinal","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-86d196a70c2b","stem":"Which of the following regarding blood pressure in shock are false? A Elderly patients who are normally hypertensive may present with a ‘normal’ blood pressure. B Children and fit young adults are able to maintain blood pressure until the final stages of shock. C Hypotension is one of the first signs of shock. D Beta-blockers may prevent a tachycardic response. E Blood pressure is increased by reduction in stroke volume and peripheral vasoconstriction. ➜Compensated shock","type":"Short Answer","subject":"General Surgery","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-cd38e9afddc9","stem":"Which of the following statements about compensated shock are false? A The preload is preserved by the cardiovascular and endocrinal compensatory responses. B Tachycardia and cool peripheries may be the only clinical signs. C The perfusion to the skin, muscle and GI tract is increased. 2 Shock and blood transfusion","type":"Short Answer","subject":"General Surgery","topic":"Trauma and Emergency Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Trauma and Emergency Surgery","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Trauma and Emergency Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0e5c143c7f34","stem":"Which of the following statements are false? A Administration of inotropic agents to an empty heart will help to increase diastolic filling and coronary perfusion. B In all cases, regardless of classification, hypovolaemia and preload must be addressed first. C Long, wide-bore catheters allow rapid infusion of fluids. D The oxygen-carrying capacity of both colloids and crystalloids is zero. E Hypotonic solutions are poor volume expanders and should not be used in shock except in conditions of free water loss or sodium overload. ➜Inotropic support in shock","type":"Short Answer","subject":"General Surgery","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-54cf1860bd3a","stem":"Which of the following are true regarding inotropic support in shock? A This is the first-line therapy in hypovolaemic shock. B Phenylephrine and noradrenaline are indicated in distributive shock states. C Dobutamine is the agent of choice in cardiogenic shock or septic shock complicated by low cardiac output. D Vasopressin may be used when the vasodilatation is resistant to catecholamines. E Use in the absence of adequate preload may be harmful. ➜Mixed venous saturation","type":"Short Answer","subject":"General Surgery","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d2df52a4edb3","stem":"Which of these statements about mixed venous saturation are false? A The percentage saturation of oxygen returning to the heart from the body is a measure of the oxygen delivery and extraction by the tissues. B The normal mixed oxygen saturation levels are 30–40 per cent. C Accurate measurements are via analysis of blood drawn from a line placed in the superior vena cava (SVC). D Levels below 50 per cent indicate inadequate oxygen delivery consistent with hypovolaemic shock. E High mixed venous saturation levels are seen in sepsis. ➜Reactionary haemorrhage","type":"Short Answer","subject":"General Surgery","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-47b83c161cae","stem":"Which of the following about reactionary haemorrhage are false? A This is delayed haemorrhage occurring within 24 h after operation. B It is usually caused by dislodgement of clot, normalisation of blood pressure or slippage of ligature. C It is associated with infection. D It can be significant, requiring re-exploration. E It is usually venous. ➜Blood transfusion","type":"Short Answer","subject":"General Surgery","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e44384059ab3","stem":"Which of the following about blood transfusion are false? A A haemoglobin level of 10 g/dL or less is now considered a typical indication. B Fresh frozen plasma (FFP) is considered as the first-line therapy in coagulopathic haemorrhage. C Cryoprecipitate is useful in low- fibrinogen states and in factor VIII deficiency. D Platelets have a shelf life of 3 weeks. E Patients can pre-donate blood up to 3 weeks before surgery for autologous transfusion.","type":"Short Answer","subject":"General Surgery","topic":"Trauma and Emergency Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Trauma and Emergency Surgery","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Trauma and Emergency Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-df0a2e213c6f","stem":"A, C Resuscitation should not be delayed in order to definitively diagnose the cause of the shocked state. The first-line therapy is intravenous (IV) access administration of IV fluids using short, wide-bore catheters that allow rapid infusion of fluids. Hypotonic fluids are poor volume","type":"Short Answer","subject":"General Surgery","topic":"Trauma and Emergency Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Trauma and Emergency Surgery","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Trauma and Emergency Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a0045ae9d570","stem":"B, C The percentage saturation of oxygen returning to the heart from the body is a measure of the oxygen delivery and extraction by the tissues. Accurate measurement is by a long line placed in the right atrium. Samples from the SVC give slightly higher values. Normal mixed venous oxygen saturation levels are 50–70 per cent. Levels below 50 per cent indicate inadequate oxygen delivery and increased oxygen extraction by the cells. This is consistent with hypovolaemic or cardiogenic shock. High mixed venous saturation levels (>70 per cent) are seen in sepsis and some forms of distributive shock. ➜Reactionary haemorrhage","type":"Short Answer","subject":"General Surgery","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-789b8ea0918c","stem":"A, D The transfusion trigger was historically 10 g /dL. It is now believed, however, that a level of 6 g /dL is acceptable in patients who are not bleeding, not symptomatic and not about to undergo major surgery. Levels between 6 and 8 g /dL are selectively transfused. Also see Table 2.3.","type":"Short Answer","subject":"General Surgery","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-736a07fda252","stem":"SHOCK AND BLOOD TRANSFUSION 15 5A This is completely avoidable and hence should never happen. While prescribing and administering blood, it is essential that the correct patient receives the correct transfusion. Care should be taken to ensure correct labelling of samples. Two individuals should check the patient’s details against the prescription and the label of the donor blood. Additionally the donor blood serial number should be checked against the issue slip for that patient. 16 Multiple choice questions ➜Wound healing","type":"Short Answer","subject":"General Surgery","topic":"Trauma and Emergency Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Trauma and Emergency Surgery","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Trauma and Emergency Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e758458546ee","stem":"Which of these factors influences healing of a wound? A Vascular insufficiency B Diabetes mellitus C Malnutrition D Site of wound E Smoking.","type":"Short Answer","subject":"General Surgery","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Endocrinology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-6e0b6009c04e","stem":"Which of the following statements about the process of wound healing are true? A The inflammatory phase begins 2–3 days after the injury. B The proliferative phase lasts from 3 days to 3 weeks following the injury. C The remodelling phase involves fibroblast activity and production of collagen and ground substance. D Fibroblasts require vitamin C to produce collagen. E The white cells stick to the damaged endothelium and release adenosine diphosphate (ADP) and cytokines.","type":"Short Answer","subject":"General Surgery","topic":"Trauma and Emergency Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Trauma and Emergency Surgery","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Trauma and Emergency Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8a889ce3b14d","stem":"Which of the following statements are true? A Healing by primary intention results in minimum inflammation and the best scar. B Granulation, contraction and epithelialisation are seen in healing by secondary intention. C Tertiary intention involves immediate closure of the wound. D A crushed and contaminated wound is best suited for healing by primary intention. E Primary repair of all structures should be attempted in an untidy wound. ➜Management of wounds","type":"Short Answer","subject":"General Surgery","topic":"Trauma and Emergency Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Trauma and Emergency Surgery","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Trauma and Emergency Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9e97e49b986a","stem":"Which of the following statements regarding management of the acute wound are correct? A A bleeding wound should be elevated and a pressure pad applied. B Clamps may sometimes need to be put on bleeding vessels blindly. C Anaesthesia is usually not required in the assessment of wounds. D A thorough debridement is essential. E Repair of all damaged structures may be attempted in a tidy wound.","type":"Short Answer","subject":"General Surgery","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-48a2cdac52ef","stem":"Which of the following statements regarding the management of specific wounds are true? A A haematomata should never require release. B Anaerobic and aerobic organism prophylaxis is needed in bite wounds. C Puncture wounds should always be explored. D Degloving injuries will require serial excision until viable tissue is confirmed. E Compartment syndrome typically occurs in a closed lower limb injury. ➜Chronic wounds","type":"Short Answer","subject":"General Surgery","topic":"Trauma and Emergency Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Trauma and Emergency Surgery","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Trauma and Emergency Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-78eaab7fcf50","stem":"Which of the following statements are true? A The most common chronic wound in developed countries is the leg ulcer. B Pressure sores occur in approximately 5 per cent of all hospitalised patients. C Surgical treatment is usually required in the treatment of leg ulcers. D Bed-bound patients should be turned every 4 h to prevent pressure sores. 3 Wounds, tissue repair and scars","type":"Short Answer","subject":"General Surgery","topic":"Trauma and Emergency Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Trauma and Emergency Surgery","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Trauma and Emergency Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-46ac4e82c223","stem":"Pressure sores can occur over which of the following areas? A Sacrum B Heel C Occiput D Greater trochanter E Ischium. ➜Necrotising soft-tissue infections","type":"Short Answer","subject":"General Surgery","topic":"Infectious Diseases","topicOriginal":"Infectious Diseases","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Infectious Diseases","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-efeaa50056a1","stem":"Which of the following statements about necrotising soft-tissue infections are true? A They are usually polymicrobial infections. B The onset is usually gradual and they run a chronic course. C ‘Dishwater pus’ is a characteristic feature. D Clostridial species cause toxic shock syndrome. E Treatment is essentially medical using antibiotics. ➜Scars","type":"Short Answer","subject":"General Surgery","topic":"Infectious Diseases","topicOriginal":"Infectious Diseases","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Infectious Diseases","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-5d3677bbc4b6","stem":"Which of the following statements are true? A Scars continue maturing for 3 months. B Keloids contain an excess of type B collagen. C Suture marks can be reduced by using polyfilament sutures. D The tensile strength of the scar never reaches that of the normal skin. E A hypertrophied scar extends beyond the boundaries of the previous incision. ➜Keloids","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-573efad47055","stem":"WOUNDS, TISSUE REPAIR AND SCARS 19 F Fibrous polymer G Biological membranes Choose and match the correct description with each of the wound dressings below: 1 Kaltostat, Sorbsan 2 Intrasite, Lyofoam 3 Porcine skin, amnion 4 Benoxyl-benzoic acid 5 Granuflex 6 Opsite, Tegaderm 7 Silastic (Elastomer). Answers: Multiple choice questions ➜Wound healing","type":"Short Answer","subject":"General Surgery","topic":"Trauma and Emergency Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Trauma and Emergency Surgery","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Trauma and Emergency Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-41025b753eb7","stem":"A, B Tertiary intention is also called delayed primary intention and in this the wound is initially left open and the edges later opposed when healing conditions are favourable. A crushed and contaminated wound is best managed by debridement on one or several occasions before definitive repair can be carried out. Primary repair of all structures should be attempted in a tidy wound. ➜Management of wounds","type":"Short Answer","subject":"General Surgery","topic":"Trauma and Emergency Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Trauma and Emergency Surgery","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Trauma and Emergency Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4e57feca7114","stem":"A, B, E An ulcer is defined as a break in the epithelial continuity. A prolonged inflammatory phase leads to an overgrowth of granulation tissue, and attempts to heal by scarring leaves a fibrotic margin. Necrotic tissue, often at the ulcer centre, is called slough. Most ulcers are managed by dressings and simple treatments. An ulcer not responsive to this treatment should be biopsied to rule out malignant change (Marjolin’s ulcer). Effective treatment of any ulcer depends on treating the cause, and diagnosis is hence vital. Surgical treatment is only indicated if non-operative methods have failed and the patient has intractable pain. Meshed skin grafts are more successful than sheet grafts. ➜Pressure sores","type":"Short Answer","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9a9f5b61bfe2","stem":"A, C These are rare but often fatal infections that are usually seen after trauma or surgery with wound contamination. They are polymicrobial infections involving Gram-positive aerobes (S. aureus, S. pyogenes), Gram-negative aerobes (E. coli, P. aeruginosa), Clostridia, Bacteroides and beta- haemolytic Streptococcus. The infections are characterised by sudden presentation and rapid progression. There are two main types of necrotising infections – clostridial and non-clostridial (streptococcal gangrene and necrotising fasciitis). Streptococcus pyogenes causes toxic shock syndrome and is often called ‘flesh-eating bug’. Treatment is surgical excision with tissue being sent for culture. Wide raw areas are often left behind which may require skin graft. ➜Scars","type":"Short Answer","subject":"General Surgery","topic":"Infectious Diseases","topicOriginal":"Infectious Diseases","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Infectious Diseases","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-2536e5405d06","stem":"WOUNDS, TISSUE REPAIR AND SCARS 21 almost acellular as the fibroblasts and blood vessels reduce. The scar then becomes paler, flat and soft. Most of the changes take place over the first 3 months but a scar will continue to mature for 1–2 years. The strength gradually increases but will never reach that of normal skin. Suture marks can be reduced by using monofilament sutures. A hypertrophic scar is defined as excessive scar tissue that does not extend beyond the boundary of the original incision or wound. It results from a prolonged inflammatory phase of wound healing and from unfavourable siting of the scar. ➜Keloids","type":"Short Answer","subject":"General Surgery","topic":"Trauma and Emergency Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Trauma and Emergency Surgery","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Trauma and Emergency Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b0270e3211dd","stem":"Which of the following are part of Koch’s postulates? A It must be found in considerable numbers in the septic focus. B A reduction in the organisms should be achieved by using appropriate antibiotics. C It should be possible to culture it in a pure form from the septic focus. D Healing of a wound is possible without pus formation. E It should be able to produce similar lesions when injected into another host. ➜Natural barriers to infection","type":"Short Answer","subject":"General Surgery","topic":"Infectious Diseases","topicOriginal":"Infectious Diseases","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Infectious Diseases","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-c3687838eede","stem":"Which of the following is a natural barrier to infection? A Intact epithelial surface B High gastric pH C Antibodies D Antibiotics E Macrophages. ➜Host resistance to infection","type":"Short Answer","subject":"General Surgery","topic":"Gastrointestinal","topicOriginal":"Gastrointestinal","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Gastrointestinal","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-bfc46c24ffe2","stem":"Which of the following is a cause of reduced host resistance to infection? A Malnutrition B Heart failure C Cancer D AIDS E Systemic sclerosis. ➜Risk factors for wound infection","type":"Short Answer","subject":"General Surgery","topic":"Cardiovascular","topicOriginal":"Cardiovascular","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Cardiovascular","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-4ff520a10c59","stem":"Which of the following is a risk factor for wound infection? A Poor perfusion B Use of skin clips for wound closure. C Poor surgical technique D Not using prophylactic antibiotics E Uraemia. ➜Secondary infections","type":"Short Answer","subject":"General Surgery","topic":"Infectious Diseases","topicOriginal":"Infectious Diseases","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Infectious Diseases","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-1faf36ffbbc8","stem":"Which of the following is a cause of secondary (or exogenous) infection? A Poor hand-washing technique B Community C Perforated diverticular disease D Anastomotic leak E Inadequate air filtration in the theatre. ➜Surgical site infections","type":"Short Answer","subject":"General Surgery","topic":"Infectious Diseases","topicOriginal":"Infectious Diseases","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Infectious Diseases","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-6895f2315c77","stem":"Which of the following statements about surgical site infections (SSIs) are true? A Infection in the musculofascial tissues is known as deep SSI. B The patient may have systemic signs in a minor SSI. C Infection causing delay in hospital discharge is a major SSI. D The differentiation between major and minor SSIs is not important. E Surveillance for surgical site infection should be done for a year after implanted joint surgery. ➜Abscesses","type":"Short Answer","subject":"General Surgery","topic":"Infectious Diseases","topicOriginal":"Infectious Diseases","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Infectious Diseases","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-6017ac9f1859","stem":"Which of the following statements regarding abscesses are true? A Staphylococcus aureus is one of the most common causative organisms. B The abscess wall is composed of epithelium. C Most wound-site abscesses occur before the patient is discharged from the hospital. D Antibiotics are indicated if there is evidence of cellulitis. E Actinomyces can cause a chronic abscess. 4 Surgical infection","type":"Short Answer","subject":"General Surgery","topic":"Infectious Diseases","topicOriginal":"Infectious Diseases","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Infectious Diseases","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-53f7f11e9974","stem":"Which of the following statements regarding cellulitis are true? A This is non-suppurative invasive infection of tissues. B It is poorly localised. C It is commonly caused by Clostridium perfringens. D Systemic signs are not present. E Blood culture is usually positive. ➜Systemic inflammatory response syndrome (SIRS)","type":"Short Answer","subject":"General Surgery","topic":"Infectious Diseases","topicOriginal":"Infectious Diseases","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Infectious Diseases","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-621f071d1e2d","stem":"Which if the following can be seen in SIRS? A Hypothermia ( <36 o C) B White cell count (WCC) < 4 \u0002 1000/dL C No documented infection D Tachycardia ( >90/min) E Tachypnoea ( >20/min). ➜Severe sepsis (sepsis syndrome)","type":"Short Answer","subject":"General Surgery","topic":"Infectious Diseases","topicOriginal":"Infectious Diseases","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Infectious Diseases","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-9a638c7b8fc3","stem":"Which of the following statements about severe sepsis (sepsis syndrome) are true? A Acute respiratory distress syndrome (ARDS) is common. B There is absence of documented infection. C Multiple organ dysfunction syndrome (MODS) is the systemic effect of infection. D Multiple system organ failure (MSOF) is the end stage of uncontrolled MODS. E MSOF is mediated by released cytokines such as interleukins (IL-6) and tumour necrosis factor (TNF)-alpha. ➜Clostridial wound infections","type":"Short Answer","subject":"General Surgery","topic":"Respiratory","topicOriginal":"Respiratory","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Respiratory","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-93f43eb35ee9","stem":"Which of the following statements regarding clostridial wound infections are true? A Clostridia are Gram-positive aerobic spore-bearing cocci. B Thin, brown and sweet-smelling exudate is seen in gas gangrene. C Necrotic and foreign material in wounds increase risk. D The spores are widely spread in soil and manure. E The signs and symptoms are due to the endotoxins. ➜Treatment of surgical infections","type":"Short Answer","subject":"General Surgery","topic":"Infectious Diseases","topicOriginal":"Infectious Diseases","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Infectious Diseases","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b2f0606732bb","stem":"Which of the following statements are true? A Identification of the causative organism should be done before starting antibiotics. B Wounds are best managed by delayed primary or secondary closure. C Subcuticular continuous skin closure decreases the incidence of wound infection. D Polymeric films can be useful in infected wounds. E Administration of antibiotic preparations locally is more effective than the oral route. ➜Prophylactic antibiotics","type":"Short Answer","subject":"General Surgery","topic":"Infectious Diseases","topicOriginal":"Infectious Diseases","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Infectious Diseases","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d463e175381c","stem":"Which of the following affects the choice of prophylactic antibiotic? A The expected spectrum of organisms likely to be encountered B Cost C Personal preference D Hospital policies E Local resistance strains.","type":"Short Answer","subject":"General Surgery","topic":"Infectious Diseases","topicOriginal":"Infectious Diseases","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Infectious Diseases","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a4e94ceaf90e","stem":"Which of the following may require more than one dose of prophylactic antibiotic? A Prolonged operations B Excessive blood loss C Gastrointestinal surgery D Insertion of prosthesis E Unexpected contamination. ➜Surgical wound infection","type":"Short Answer","subject":"General Surgery","topic":"Gastrointestinal","topicOriginal":"Gastrointestinal","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Gastrointestinal","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-75470e630bfc","stem":"Which of the following measures is useful in reducing surgical wound infection? A Antiseptic skin preparation B Shaving of area PRINCIPLES 24 C Avoid hypothermia perioperatively D Increasing hospital stay to