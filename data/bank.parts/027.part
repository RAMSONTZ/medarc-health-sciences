ages."},{"label":"B","text":"polycythemia."},{"label":"C","text":"splenomegaly."},{"label":"D","text":"hepatomegaly."},{"label":"E","text":"disseminated intravascular coagulation. SUBJECT Pathology SUBJECT CATEGORY Infectious disease SUBCATEGORY General features of other infectious diseases FILE NUMBER"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"9c74ba21b2e80264fafb4fce94b8d8aaf2df760a"},{"id":"q-4854ebee6205","stem":"Giardia Lamblia may be spread by the faecal-oral route to people from all of the following EXCEPT: ??.??.??","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"people"},{"label":"B","text":"cats"},{"label":"C","text":"beavers"},{"label":"D","text":"bears"},{"label":"E","text":"moose SUBJECT Pathology SUBJECT CATEGORY SUBCATEGORY FILE NUMBER SOURCE OF QUESTION TEXT Robbins EDITION 5th PAGE(s) 334 ORIGINATOR Masonic Hospital primary exam course DATE 1996 CORRECT RESPONSE E APPLICATION"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-7