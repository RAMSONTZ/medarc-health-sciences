xt":"Endocrine diagnosis"},{"label":"D","text":"Beta-blocker poisoning"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7f960c267591","stem":"Main complications of insulin therapy include the following","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Hypoglycemia"},{"label":"B","text":"Insulin allergy"},{"label":"C","text":"Lipodystrophy at an injection site"},{"label":"D","text":"All of the above PART III The Gonadal Hormones & Inhibitors"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrinology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-77407ece787d","stem":"The major natural estrogens produced by women are following, EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Estradiol (Estradiol-17β, E2)"},{"label":"B","text":"Estron (E1)"},{"label":"C","text":"Ethinyl estradiol"},{"label":"D","text":"Estriol (E3)"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]}