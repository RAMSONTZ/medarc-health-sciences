ySubject":"Microbiology","displayTopic":"Virology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a728f71bb278","stem":"Which statement is not correct concerning Salmonella","type":"Short Answer","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7d45d4abd432","stem":"Which is the false statement concerning tetanus?","type":"Short Answer","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-9a649198342c","stem":"Cytokines always act xc","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"At long range"},{"label":"B","text":"synergistically with other cytokines"},{"label":"C","text":"By binding to specific receptors"},{"label":"D","text":"In an autocrine fashion"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-3957a594c6bb","stem":"Opsonisation means","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"specific antibody binding to bacteria making it more susceptible to phagocytosis"},{"label":"B","text":"opposing the action of antibody by an antigen"},{"label":"C","text":"Activation of complement by antibodies"},{"label":"D","text":"Hypersensitivity reaction type II 15.... 16..................secretory IgA antibody?xc"},{"label":"A","text":".Activate complement by classical pathway"},{"label":"B","text":"Is found in the saliva and tears"},{"label":"C","text":"confers immunity on mucosal surfaces"},{"label":"D","text":"appears as a dimer at the surface of action"}],"priority":0,"status":"review","flags":["duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","too_many_options"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"6f8d715b86f9e59c885415d769bca29a5070439a"},{"id":"q-7397f8abf1ca","stem":"which could be true or false. Each question will have at least one part which is true. For each part, you should indicate whether","type":"Short Answer","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e0f4668f93cc","stem":"which you have indicated \"don’t know\".","type":"Short Answer","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-2bea2bdcbfba","stem":"Which of the following statements is INCORRECT?","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"If we keep the sample size fixed, the confidence interval gets wider as we increase the confidence coefficient."},{"label":"B","text":"A confidence interval for a mean always contains the sample mean."},{"label":"C","text":"If we keep the confidence coefficient fixed, the confidence interval gets narrower as we increase the sample size."},{"label":"D","text":"If the population standard deviation increases, the confidence interval decreases in width."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"a09e939eb72ba527775ee65cdc175f40412b8203"},{"id":"q-ec7febf26f24","stem":"You have measured the systolic blood pressure of a random sample of 25 employees of a company. A 95% confidence interval for the mean systolic blood pressure for the employees is computed to be (122,138). Which of the following statements gives a valid interpretation of this interval?","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Biostatistics","topicOriginal":"Biostatistics","subtopic":"Statistical Inference","suggestedTopic":null,"options":[{"label":"A","text":"About 95% of the samples of employees have a systolic blood pressure between 122 and 138."},{"label":"B","text":"About 95% of the employees in the company have a systolic blood pressure between 122 and 138"},{"label":"C","text":"If the sampling procedure were repeated many times, then approximately 95% of the resulting confidence intervals would contain the mean systolic blood pressure for employees in the company."},{"label":"D","text":"If the sampling procedure were repeated many times, then approximately 95% of the sample means would be between 122 and 138."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Biostatistics","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"a8c8b6dcd28f15a35b28406c4b1dd9090047c07d"},{"id":"q-d92dde1468a7","stem":"A 95 percent confidence interval for the mean time taken to process new insurance policies is (11, 12) days. This interval can be interpreted to mean that","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Biostatistics","topicOriginal":"Biostatistics","subtopic":"Statistical Inference","suggestedTopic":null,"options":[{"label":"A","text":"Only 5 percent of all policies take less than 11 or more than 12 days to process"},{"label":"B","text":"Only 5 percent of all policies take between 11 and 12 days to process"},{"label":"C","text":"About 95 out of every 100 such intervals constructed from random samples of the same size will contain the population mean processing time"},{"label":"D","text":"The probability is .95 that all policies take between 11 and 12 days to process"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Biostatistics","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-268ba1da86fc","stem":"A 95% confidence interval for p the proportion of Canadian beer drinkers who prefer Lion Red was found to be (0.236 to 0.282). Which of the following is correct?","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Biostatistics","topicOriginal":"Biostatistics","subtopic":"Statistical Inference","suggestedTopic":null,"options":[{"label":"A","text":"About 95% of beer drinkers have between a 23.6% and a 28.2% chance of drinking Lion Red."},{"label":"B","text":"There is a 95% probability that the sample proportion lies between 0.236 and 0.282."},{"label":"C","text":"If a second sample was taken, there is a 95% chance that its confidence interval would contain 0.25."},{"label":"D","text":"we are reasonably certain that the true proportion of beer drinkers who prefer Lion Red is between 24% and 28%."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Biostatistics","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-852e955d155f","stem":"A study was conducted to estimate the effectiveness of doing assignments in an introductory statistics course. Students in one section taught by instructor A received no assignments. Students in another section taught by instructor B, received assignments. The final grade of each student was recorded. A 95% confidence interval for the difference in the mean grades (Section A - Section B) was computed to be −3.5 ± 1.8. This means","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Biostatistics","topicOriginal":"Biostatistics","subtopic":"Statistical Inference","suggestedTopic":null,"options":[{"label":"A","text":"There is evidence that doing assignments improves the average grade because the difference in the population means is less than zero."},{"label":"B","text":"There is little evidence that doing assignments improves the average because the 95% confidence interval does not cover 0."},{"label":"C","text":"There is evidence that doing assignments improves the average grade because the 95% confidence interval does not cover 0."},{"label":"D","text":"There is evidence that doing assignments does not improve the average grade because the 95% confidence interval does not cover 0."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Biostatistics","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"5e971f191db30469abf287e9f8051fb8ea9e6fbc"},{"id":"q-25e20ca2da62","stem":"Which of the following can best be described as a categorical variable?","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"age"},{"label":"B","text":"annual income"},{"label":"C","text":"grade point average"},{"label":"D","text":"religion"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"b8695f314c482660f8e4088ca20f75f93a01f165"},{"id":"q-196af8768389","stem":"According to the text, most of the outcome/dependent variable characteristics and attributes measured in educational research probably exist at the ______________ level of measurement.","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"Nominal"},{"label":"B","text":"Ordinal"},{"label":"C","text":"Interval"},{"label":"D","text":"d. Ratio"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"528a395f88b59b14bad160ce5acdcb6bb9bdb721"},{"id":"q-b3c65247d1a4","stem":"An ordinal scale is","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"The simplest form of measurement"},{"label":"B","text":"A rank-order scale of measurement"},{"label":"C","text":"A scale with equal intervals between adjacent numbers"},{"label":"D","text":"A scale with an absolute zero point"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"8c5f3f586f70cdf0b134eaf5aa458c8c06552bc6"},{"id":"q-b083694ee49c","stem":"Which of the following sampling techniques is an equal probability selection method (i.e., EPSEM) in which every individual in the population has an equal chance of being selected?","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Simple random sampling"},{"label":"B","text":"Systematic sampling"},{"label":"C","text":"Proportional stratified sampling"},{"label":"D","text":"All of the above are EPSEM"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"a53beb0b9294252d48fdbf6a0e671bee8f97e4e2"},{"id":"q-34093b40aa19","stem":"Which of the following is not a form of nonrandom sampling?","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Snowball sampling"},{"label":"B","text":"Convenience sampling"},{"label":"C","text":"Quota sampling"},{"label":"D","text":"They are all forms of nonrandom sampling"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"d8285909a0c1cd15a93e9f37789ae7dc96d55a76"},{"id":"q-ae539f9281f4","stem":"If we took the 500 people attending a school in New York City, divided them by gender, and then took a random sample of the males and a random sampling of the females, the variable on which we would divide the population is called the.","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Biostatistics","topicOriginal":"Biostatistics","subtopic":"Statistical Inference","suggestedTopic":null,"options":[{"label":"A","text":"Independent variable"},{"label":"B","text":"Dependent variable"},{"label":"C","text":"Stratification variable"},{"label":"D","text":"Sampling variable"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Biostatistics","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"c2e36e409c71e4f34fe4e42e9ceb7ed68099181d"},{"id":"q-3bcd434a8fed","stem":"When research is done to test hypotheses and theories about how and why phenomena operate as they do, then the primary purpose of such research is","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"Descriptive"},{"label":"B","text":"Predictive"},{"label":"C","text":"Explanatory"},{"label":"D","text":"Non of the above"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"d63389bbcf73babefa0de06b65365027c49a6b79"},{"id":"q-690dfe5e7de7","stem":"Which of the following independent variables cannot be manipulated in a research study?","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"Gender"},{"label":"B","text":"Ethnicity"},{"label":"C","text":"Intelligence and other traits"},{"label":"D","text":"None of ht above can be manipulated in a research study"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"33dd841c12b3d1e563b5571c9fb996cad7315e00"},{"id":"q-b1c70e4d0708","stem":"In epidemiology, the term prevalence","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Measures and Study Designs","suggestedTopic":null,"options":[{"label":"A","text":"represents the number of new cases occurring in a given period"},{"label":"B","text":"always relates to a denominator population"},{"label":"C","text":"relates to the number of cases per population at a given time or for a given period is expressed as a percentage"},{"label":"D","text":"represents the total number of cases in a given population for a given period or at a given time"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e671c1020ef8","stem":"Active immunization is available against all of the following diseases except","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"tuberculosis;"},{"label":"B","text":"smallpox;"},{"label":"C","text":"poliomyelitis;"},{"label":"D","text":"malaria;"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"6586cdbebac0add06a38d45b11cfc7f610459c99"},{"id":"q-07566be21b6b","stem":"If there is a complete list of all individuals in the population, the selection of person to be included in a survey can be done by","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"Simple random sampling."},{"label":"B","text":"Cluster sampling."},{"label":"C","text":"Systematic sampling."},{"label":"D","text":"(b) and (c)"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d070623f8474","stem":"Which of the following statements sounds like a null hypothesis?","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Biostatistics","topicOriginal":"Biostatistics","subtopic":"Statistical Inference","suggestedTopic":null,"options":[{"label":"A","text":"The coin is not fair"},{"label":"B","text":"There is a correlation in the population"},{"label":"C","text":"There is no difference between male and female incomes in the population"},{"label":"D","text":"The defendant is guilty"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Biostatistics","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"5ab0f24967afc5e9edb3acab5efff7afabbc8380"},{"id":"q-bf8bf10f9285","stem":"As a general rule, researchers tend to use ____ percent confidence intervals.","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Biostatistics","topicOriginal":"Biostatistics","subtopic":"Statistical Inference","suggestedTopic":null,"options":[{"label":"A","text":"99%"},{"label":"B","text":"95%"},{"label":"C","text":"50%"},{"label":"D","text":"none of the above"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Biostatistics","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"41d76086a02d79cec2063f06b95af816d7948481"},{"id":"q-ff262cd0b47b","stem":"Which of the following is the researcher usually interested in supporting when he or she is engaging in hypothesis testing?","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Biostatistics","topicOriginal":"Biostatistics","subtopic":"Statistical Inference","suggestedTopic":null,"options":[{"label":"A","text":"The alternative hypothesis"},{"label":"B","text":"The null hypothesis"},{"label":"C","text":"Both the alternative and null hypothesis"},{"label":"D","text":"Neither the alternative or null hypothesis"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Biostatistics","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"4df8ef3f3987e5e10a04e9dcd7c640b774e49556"},{"id":"q-72305282532c","stem":"_____ results if you fail to reject the null hypothesis when the null hypothesis is actually false.","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Biostatistics","topicOriginal":"Biostatistics","subtopic":"Statistical Inference","suggestedTopic":null,"options":[{"label":"A","text":"Type I error"},{"label":"B","text":"Type II error"},{"label":"C","text":"Type III error"},{"label":"D","text":"Type IV error"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Biostatistics","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b714c98249bc","stem":"A good way to get a small standard error is to use a ________.","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"Repeated sampling"},{"label":"B","text":"Small sample"},{"label":"C","text":"Large sample"},{"label":"D","text":"Large population"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a38d027daab1","stem":"Identify which of the following steps would not be included in hypothesis testing.","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Biostatistics","topicOriginal":"Biostatistics","subtopic":"Statistical Inference","suggestedTopic":null,"options":[{"label":"A","text":"State the null and alternative hypotheses"},{"label":"B","text":"Set the significance level before the research study"},{"label":"C","text":"Eliminate all outliers"},{"label":"D","text":"Obtain the probability value using a computer program such as SPSS"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Biostatistics","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"313d9299c360faca5d703ba9055d4a71f690e080"},{"id":"q-6160e8fa4d2c","stem":"A ________ is a range of numbers inferred from the sample that has a certain probability of including the population parameter over the long run.","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"Hypothesis"},{"label":"B","text":"Lower limit"},{"label":"C","text":"Confidence interval"},{"label":"D","text":"Probability limit"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[],"manualEdits":{}},{"id":"q-30c23d827d9c","stem":"________ is the standard deviation of a sampling distribution.","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Standard error"},{"label":"B","text":"Sample standard deviation"},{"label":"C","text":"Replication error"},{"label":"D","text":"Meta error"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-77d7769126bc","stem":"The cutoff the researcher uses to decide whether to reject the null hypothesis is called the","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Biostatistics","topicOriginal":"Biostatistics","subtopic":"Statistical Inference","suggestedTopic":null,"options":[{"label":"A","text":"Significance level"},{"label":"B","text":"Alpha level"},{"label":"C","text":"Probability value"},{"label":"D","text":"Both a and b are correct"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Biostatistics","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-fd6d0a97cb29","stem":"__________ is the failure to reject a false null hypothesis.","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Biostatistics","topicOriginal":"Biostatistics","subtopic":"Statistical Inference","suggestedTopic":null,"options":[{"label":"A","text":"Type I error"},{"label":"B","text":"Type II error"},{"label":"C","text":"Type A error"},{"label":"D","text":"Type B error"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Biostatistics","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-cbc8c186ab41","stem":"Which of the following statements is/are true according to the logic of hypothesis testing?","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Biostatistics","topicOriginal":"Biostatistics","subtopic":"Statistical Inference","suggestedTopic":null,"options":[{"label":"A","text":"When the null hypothesis is true, it should be rejected"},{"label":"B","text":"When the null hypothesis is true, it should not be rejected"},{"label":"C","text":"When the null hypothesis is false, it should be rejected"},{"label":"D","text":"Both b and c are true"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Biostatistics","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"37464390e0097371dd1c9fddfc6c2769d8383f5e"},{"id":"q-edfcd3ce1d42","stem":"A Type I error is also known as a ______.","type":"Single Best Answer MCQ","subject":"Com