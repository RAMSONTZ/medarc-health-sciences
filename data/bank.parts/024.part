","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"antibodies to virus proteins expressed on infected cell membranes"},{"label":"B","text":"B7."},{"label":"C","text":"CD16."},{"label":"D","text":"toxic oxygen radicals."},{"label":"E","text":"virus peptides expressed on infected cell membrane MHC."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[],"manualEdits":{}},{"id":"q-d4f593ffcd63","stem":"NK cells kill their targets in ADCC using","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"complement-mediated lysis."},{"label":"B","text":"Fas and FasL."},{"label":"C","text":"oxidative burst."},{"label":"D","text":"perforins and granzymes."},{"label":"E","text":"all of the above."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-dd659428278c","stem":"Mast cells release their granule contents to stimulate inflammation in response to","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"antigen binding to IgE on mast cell FcεR."},{"label":"B","text":"antigen binding to IgG on mast cell FcγR."},{"label":"C","text":"antigen binding to mast cell antigen receptors."},{"label":"D","text":"antigen binding to mast cell FcεR."},{"label":"E","text":"IgE-coated antigen binding to mast cell FcεR."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-fc3a4f036019","stem":"Successful immune responses to helminth parasites depends on the production of","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"active complement."},{"label":"B","text":"armed effector CTL."},{"label":"C","text":"neutralizing IgA."},{"label":"D","text":"opsonizing IgE."},{"label":"E","text":"opsonizing IgG. Problems"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-69c4d39f89a7","stem":"Innate immune responses are important in the initiation of adaptive responses because","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"antigen cannot bind B cells until it has first bound complement."},{"label":"B","text":"inflammatory chemokines attract naïve B and T cells to the infection site to be activated."},{"label":"C","text":"inflammatory cytokines and acute phase proteins stimulate the expression of co-stimulatory molecules on dendritic cells."},{"label":"D","text":"lymphocytes cannot enter the secondary lymphoid organs until inflammatory cytokines upregulate CAM expression on HEV."},{"label":"E","text":"T cells are stimulated to express co-stimulatory molecules by acute phase proteins."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-95ba160787fb","stem":"Th0 differentiation into Th1 or Th2 cells is influences by all of the following EXCEPT","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"antigen density on the APC MHC."},{"label":"B","text":"avidity of peptide binding to TCR."},{"label":"C","text":"cytokines being produced by nearby dendritic cells."},{"label":"D","text":"cytokines being secreted by nearby T cells."},{"label":"E","text":"whether the T0 cell has already begun to make IL-2."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b66be9fc7c78","stem":"Armed effector CTL find and kill their target cells in","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"draining lymph nodes."},{"label":"B","text":"the site of pathogen entry into the body."},{"label":"C","text":"the spleen."},{"label":"D","text":"whatever tissues have APC to provide co-stimulatory signals."},{"label":"E","text":"whatever tissues are infected."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[],"manualEdits":{}},{"id":"q-cded2079434c","stem":"Naïve lymphocytes enter the lymph nodes","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"any time they pass by the lymph node HEV."},{"label":"B","text":"any time inflammatory chemokines signal them to go to the lymph nodes."},{"label":"C","text":"only during infection."},{"label":"D","text":"only when their specific antigen is NOT present in the tissues."},{"label":"E","text":"only when their specific antigen is present."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7b5ab107a5c9","stem":"Effector B cells (plasma cells) secrete antibody in the","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"bone marrow."},{"label":"B","text":"germinal centers."},{"label":"C","text":"primary follicles."},{"label":"D","text":"secondary follicles."},{"label":"E","text":"T cell follicles."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f6a17665bb11","stem":"Immune memory is provided by persisting","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"antibody molecules."},{"label":"B","text":"effector CTL."},{"label":"C","text":"memory cells that can be activated by antigen to become effectors."},{"label":"D","text":"plasma cells"},{"label":"E","text":"All of the above contribute to immune memory."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-0454aee6f258","stem":"Lymphocytes which are part of the MALT do not generally recirculate through the peripheral lymph nodes because","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"MALT lymphocytes do not recirculate."},{"label":"B","text":"the antigens for which they are specific cannot go to the lymph nodes."},{"label":"C","text":"the APC that activate them are found only in the MALT."},{"label":"D","text":"they are negatively selected against MALT self antigens in the bone marrow and must stay in the MALT to avoid inducing autoimmunity"},{"label":"E","text":"they bind better to MAdCAM on the mucosal vascular endothelium than they do to CD34 on the lymph node HEV."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-8e5d38649717","stem":"All of the following are part of the gut-associated lymphoid tissue EXCEPT the","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"adenoids."},{"label":"B","text":"appendix."},{"label":"C","text":"enterocytes."},{"label":"D","text":"M cells."},{"label":"E","text":"Peyer's Patches."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-20a71171c6d4","stem":"The function of the M cells is to","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"induce apoptosis in food antigens."},{"label":"B","text":"kill infected enterocytes."},{"label":"C","text":"migrate to the Peyer's Patches and present antigen to T cells."},{"label":"D","text":"phagocytose or endocytose antigen."},{"label":"E","text":"secrete neutralizing IgA."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-8459c70c4ef2","stem":"The mucosal equivalent of the lymph node, where naïve T and B cells are activated, is the","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"appendix."},{"label":"B","text":"crypt."},{"label":"C","text":"MAdCAM-1 vesicle."},{"label":"D","text":"Peyer's Patches."},{"label":"E","text":"submucosal lymphoid tissue."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-1d2e02a79860","stem":"Plasma cells activated in the gut-associated lymphoid tissue secrete IgA in the","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"bone marrow."},{"label":"B","text":"lamina propria lymphoid tissues."},{"label":"C","text":"mucosa of gut, lungs, and genital tracts."},{"label":"D","text":"Peyer's Patches."},{"label":"E","text":"spleen"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d8ac8fb7e181","stem":"Specialized γδ T cells in the mucosal epithelium","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"are educated in the thymus to be tolerant to food antigens."},{"label":"B","text":"become αβ T cells when stimulated by Th1 cytokines."},{"label":"C","text":"kill infected enterocytes expressing MIC-1 and MIC-2."},{"label":"D","text":"recognize peptides presented on Class I MHC."},{"label":"E","text":"remove food antigens before they can be phagocytosed by M cells."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ad634f908439","stem":"The principal effector function that eliminates intestinal pathogens is","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":"Mucosal immunology","options":[{"label":"A","text":"CTL in the Peyer's Patches."},{"label":"B","text":"macrophages in the intestinal lumen."},{"label":"C","text":"neutralizing secretory IgA in the mucus."},{"label":"D","text":"opsonizing secretory IgA on M cells."},{"label":"E","text":"tolerance."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"independent_checked","sourceAnswerTrusted":false,"publicationStatus":"checked_explained","auditFlags":[],"cleaningOperations":[]},{"id":"q-3cb93534824c","stem":"Normal flora in the intestine","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"are neither harmful nor beneficial."},{"label":"B","text":"block adherence of pathogens by secreting toxins that kill them."},{"label":"C","text":"cannot cause disease."},{"label":"D","text":"induce no immune response unless they damage the intestinal epithelium."},{"label":"E","text":"None of the above is true."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-8429aa1f3443","stem":"Intestinal pathogens","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"cannot survive in the stomach because of the low pH there."},{"label":"B","text":"mimic food antigens to avoid the immune response."},{"label":"C","text":"must enter the body to cause disease."},{"label":"D","text":"stimulate inflammatory cytokine secretion to suppress immune responses."},{"label":"E","text":"use M cells as an entry way into the body."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-51bd918982c3","stem":"Food antigens induce tolerance by","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"activating regulatory cells that suppress immune responses."},{"label":"B","text":"entering the body through enterocytes instead of M cells."},{"label":"C","text":"failing to induce inflammatory cytokine production."},{"label":"D","text":"inducing clonal proliferation in specific T cells."},{"label":"E","text":"Both a and c are correct."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-0bc512b534a1","stem":"A secondary humoral response","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"becomes detectable in serum overnight following antigen stimulation."},{"label":"B","text":"is T cell independent."},{"label":"C","text":"produces antibody of lower average affinity than a primary response"},{"label":"D","text":"requires the presence of antibody from the primary response to initiate activation of memory cells."},{"label":"E","text":"results in high serum levels of IgG."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b8b7e3285e5e","stem":"Primary and secondary humoral immune responses do NOT differ in their","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"antibody affinities."},{"label":"B","text":"effector mechanisms."},{"label":"C","text":"kinetics."},{"label":"D","text":"peak antibody titers"},{"label":"E","text":"ratio of IgM:IgG."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-89390cbfdb09","stem":"An Elvis impersonator comes to you with a sore throat. You run some tests and learn that his C3 levels are low, IgM levels are moderate, and IgG levels are very high. This laboratory data tells you that your patient","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"does not have an infection, because complement levels rise during an infection."},{"label":"B","text":"has not previously been exposed to the infectious organism."},{"label":"C","text":"is probably undergoing a secondary immune response."},{"label":"D","text":"must have a bacterial infection, since viruses cannot induce an IgG response."},{"label":"E","text":"must be the King himself."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-6e65c0625646","stem":"Original antigenic sin","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"activates memory cells more quickly than naïve cells."},{"label":"B","text":"indicates that memory responses suppress the activation of naïve cells."},{"label":"C","text":"occurs in response to eating apples."},{"label":"D","text":"occurs when an autoimmune response is produced."},{"label":"E","text":"only occurs during responses to influenza virus. Problem"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-9dd95982b29a","stem":"Pathogens evade immune detection by","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"altering their antigens periodically."},{"label":"B","text":"binding the Fc region of IgG to block complement activation and opsonization."},{"label":"C","text":"degrading IgA directed against them"},{"label":"D","text":"living in the cytoplasm of host cells."},{"label":"E","text":"All of the above are ways pathogens evade immunity."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-2cea21236381","stem":"Which has NO effect on immune function?","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Age."},{"label":"B","text":"Body temperature."},{"label":"C","text":"Nutrition."},{"label":"D","text":"Steroid hormones."},{"label":"E","text":"All of the above affect immune function."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ff19c08439f3","stem":"A virus that can remain latent in a cell avoids elimination by","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Virology","topicOriginal":"Virology","subtopic":"Viruses","suggestedTopic":null,"options":[{"label":"A","text":"ADCC."},{"label":"B","text":"CTL."},{"label":"C","text":"macrophages."},{"label":"D","text":"neutralizing antibodies."},{"label":"E","text":"opsonizing antibodies."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Virology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a913734bb5cf","stem":"Staphylococcus aureus protein A, that binds the Fc region of Ig γ chains, allows the bacterium to avoid elimination by","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Bacteriology","topicOriginal":"Bacteriology","subtopic":"Bacterial Pathogens","suggestedTopic":null,"options":[{"label":"A","text":"ADCC."},{"label":"B","text":"antibody opsonization."},{"label":"C","text":"classical complement activation."},{"label":"D","text":"antibody-mediated phagocytosis."},{"label":"E","text":"All of the above."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Bacteriology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-0e67be89e13f","stem":"A virus could avoid CTL recognition by inhibiting the expression of","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Virology","topicOriginal":"Virology","subtopic":"Viruses","suggestedTopic":null,"options":[{"label":"A","text":"β2 microglobulin."},{"label":"B","text":"chaperones."},{"label":"C","text":"proteasomal enzymes."},{"label":"D","text":"TAP."},{"label":"E","text":"All of the above."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Virology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-433fe32a99de","stem":"Mycobacterium leprae that induce a Th2 response avoid immune elimination by","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Bacteriology","topicOriginal":"Bacteriology","subtopic":"Bacterial Pathogens","suggestedTopic":null,"options":[{"label":"A","text":"activated macrophages."},{"label":"B","text":"ADCC."},{"label":"C","text":"antibodies."},{"label":"D","text":"CTL."},{"label":"E","text":"NK cells."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Bacteriology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a40dadb2e304","stem":"Tissue damage caused by the immune system responding to pathogens is usually due to","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"cytotoxicity by CTL."},{"label":"B","text":"cytotoxicity by NK cells."},{"label":"C","text":"inflammation."},{"label":"D","text":"memory cells."},{"label":"E","text":"superantigens."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-4b6dc89a5910","stem":"Expression of endogenous MMTV superantigen on host cells","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"activates host cells to produce virus."},{"label":"B","text":"deletes host T helper cells specific for superantigen."},{"label":"C","text":"eliminates the host immune response to MMTV."},{"label":"D","text":"both b and c are correct."},{"label":"E","text":"a, b, and c are correct."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b604baf5f8e2","stem":"HIV can kill CD4 T cells by","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Virology","topicOriginal":"Virology","subtopic":"Viruses","suggestedTopic":null,"options":[{"label":"A","text":"diverting all their protein synthesis into virus production."},{"label":"B","text":"expressing gp120 on T cell membranes to make them targets for ADCC."},{"label":"C","text":"inducing apoptosis by binding to CD4 without being presented on Class II MHC."},{"label":"D","text":"inducing their lysis by HIV-specific CTL"},{"label":"E","text":"All of the above probably occur."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Virology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-2ba2dff66285","stem":"A person has AIDS when s/he","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"becomes infected with HIV."},{"label":"B","text":"dies from HIV."},{"label":"C","text":"has fewer than 200 CD4 T cells/μl of blood."},{"label":"D","text":"has more than 200 HIV particles/μl of blood."},{"label":"E","text":"is seropositive for HIV."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[],"manualEdits":{}},{"id":"q-3315f4b66e63","stem":"Clinical latency means that","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"a balance exists between virus production and elimination."},{"label":"B","text":"anti-viral medications are still effective against HIV."},{"label":"C","text":"HIV is latent in host cells."},{"label":"D","text":"no disease symptoms are experienced."},{"label":"E","text":"no free virions are detectable in the blood."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-8ab6a91fa5b2","stem":"People with AIDS","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"are always highly infectious."},{"label":"B","text":"die from opportunistic infections."},{"label":"C","text":"live a normal life-span if they take their medications on schedule."},{"label":"D","text":"rarely suffer side effects from the anti-viral medications."},{"label":"E","text":"would be expected to live on average another 10 years."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-0550305306f8","stem":"Current medications used to treat HIV infection interfere with all of the following EXCEPT","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Virology","topicOriginal":"Virology","subtopic":"Viruses","suggestedTopic":null,"options":[{"label":"A","text":"CCR5."},{"label":"B","text":"integrase."},{"label":"C","text":"opportunistic infections."},{"label":"D","text":"protease."},{"label":"E","text":"reverse transcriptase."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Virology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-598e9f24498d","stem":"All of the following contribute to the difficulty in developing an HIV vaccine EXCEPT the","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Virology","topicOriginal":"Virology","subtopic":"Viruses","suggestedTopic":null,"options":[{"label":"A","text":"antigenic variation of the virus."},{"label":"B","text":"difficulty in inducing sterilizing immunity."},{"label":"C","text":"ethical considerations that require prevention and disease treatment during any vaccine trial."},{"label":"D","text":"need to induce opsonizing antibodies for protective immunity."},{"label":"E","text":"potential danger of a vaccine to HIV. Problem"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Virology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-c304ce4d126c","stem":"Combined cellular and humoral immune deficiencies result from lack of all of the following EXCEPT","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"a thymus."},{"label":"B","text":"Class II MHC."},{"label":"C","text":"HIV infection of CD4 T cells."},{"label":"D","text":"RAG-1 or RAG-2 products."},{"label":"E","text":"TAP."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[],"manualEdits":{}},{"id":"q-1133a3ab2bfd","stem":"If Class II MHC is not expressed in the thymus, the resulting immune deficiencies would include all of the following EXCEPT reduced","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"alternative complement activation."},{"label":"B","text":"CD8 T cell-mediated cytotoxicity."},{"label":"C","text":"macrophage activation to vesicular pathogens."},{"label":"D","text":"IgG synthesis."},{"label":"E","text":"All of the above would be involved."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e260f29c1dfb","stem":"Infants are most susceptible to bacterial infection due to low circulating levels of IgG","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Bacteriology","topicOriginal":"Bacteriology","subtopic":"Bacterial Pathogens","suggestedTopic":null,"options":[{"label":"A","text":"in utero (before birth)."},{"label":"B","text":"at 0-3 months of age."},{"label":"C","text":"at 3-12 months of age."},{"label":"D","text":"at 12-24 months of age."},{"label":"E","text":"after the age of 2 years."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Bacteriology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e112836285e3","stem":"Chronic granulomatous disease results from a failure to perform oxidative burst. This deficiency would be most likely to interfere with","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"CTL killing of viruses."},{"label":"B","text":"dendritic cell activation to become a mature APC."},{"label":"C","text":"infected cell processing of virus peptides."},{"label":"D","text":"macrophage intracellular killing of bacteria."},{"label":"E","text":"M cell uptake of mucosal antigens."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-99e55bfe3b11","stem":"Bare lymphocyte syndrome due to lack of Class I MHC expression would be expected to result in an inability to","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"activate Th1 cells to promote macrophage killing of vesicular pathogens."},{"label":"B","text":"educate any T cells in the thymus."},{"label":"C","text":"make an inflammatory response to bacterial LPS."},{"label":"D","text":"produce any CD8 T cells."},{"label":"E","text":"process endogenous antigen for presentation."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-18fc512f2386","stem":"X-linked Hyper IgM syndrome, resulting in high levels of serum IgM and low levels of serum IgG, is caused by a defect in CD40L expression. The specific immune event that would be prevented by a defective CD40L would be","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"activation of B cells by T-independent antigens."},{"label":"B","text":"failure of B cells to provide co-stimulation for Th2 activation."},{"label":"C","text":"failure of dendritic cells to provide co-stimulation for Th2 activation."},{"label":"D","text":"failure of Th2 cells to provide co-stimulation for B cell isotype switching."},{"label":"E","text":"failure of Th2 cells to provide co-stimulation for B cell proliferation."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b53a23ee0f77","stem":"DiGeorge's syndrome is characterized by the lack of a thymus. The mouse model closest to this human disease would be a","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"knock-out mouse for RAG-1 and RAG-2."},{"label":"B","text":"knock-out mouse for a thymus."},{"label":"C","text":"nude mouse."},{"label":"D","text":"recombinant mouse for CD3."},{"label":"E","text":"SCID mouse."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-9b392203f9ec","stem":"A selective IgA deficiency would be expected to result in problems with","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"bacterial infections."},{"label":"B","text":"infections following dental work due to bacteria entering the bloodstream."},{"label":"C","text":"mucosal pathogens."},{"label":"D","text":"pathogens which can survive inside macrophages."},{"label":"E","text":"viral infections."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-bd2a0d5bfa1a","stem":"Bone marrow given to an infant with SCID must","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"be irradiated to eliminate GVHD."},{"label":"B","text":"contain hematopoietic stem cells that have been transduced with corrected copies of defective genes."},{"label":"C","text":"contain mature T cells that can begin making immune responses immediately."},{"label":"D","text":"come from a donor that shares some MHC alleles with the recipient."},{"label":"E","text":"come from one of the child's parents."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-0cb75b2899eb","stem":"Difficulties with somatic gene therapy arise from all of the following EXCEPT","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"GVHD caused by mature T cells in the transplanted cells."},{"label":"B","text":"inserting a gene so that it will function properly."},{"label":"C","text":"limited life span of more mature hematopoietic cells."},{"label":"D","text":"obtaining enough stem cells."},{"label":"E","text":"transducing genetic material into stem cells. Problems"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e31788c505b4","stem":"Name two ways in which a deficiency in each molecule below would affect immunity. For example, \"No thymus\" would result in lack of mature T cells (Th and Tc) in the circulation and in the secondary lymphoid organs. Increased infections with viruses and vesicular pathogens would occur, and B cells would be unable to isotype switch to IgG.","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Virology","topicOriginal":"Virology","subtopic":"Viruses","suggestedTopic":null,"options":[{"label":"A","text":"CHα immunoglobulin gene."},{"label":"B","text":"Complement C3."},{"label":"C","text":"MHC invariant chain (Ii)."},{"label":"D","text":"CD3."},{"label":"E","text":"RAG-1 or RAG-2."},{"label":"F","text":"B7"},{"label":"G","text":"Fas"},{"label":"H","text":"Class I MHC i. Perforin j. Selectin"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Virology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["too_many_options"],"cleaningOperations":[]},{"id":"q-17b83fe1116b","stem":"How could you deplete marrow of mature T cells before using it for transplantation?","type":"Short Answer","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ad1019283ad8","stem":"Upon initial exposure to allergen, plasma cells secrete antigen-specific IgE that binds to mast cell FcεRI. The mast cells are said to be","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"activated."},{"label":"B","text":"allergenic."},{"label":"C","text":"anaphylactic."},{"label":"D","text":"sensitized."},{"label":"E","text":"tolerized."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e84a1a8af162","stem":"An immediate allergic mediator released by mast cells is","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"epinephrine."},{"label":"B","text":"IgE."},{"label":"C","text":"IL-4."},{"label":"D","text":"histamine."},{"label":"E","text":"prostaglandin."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"4b5fdf0d003696250aa277d22c3258b5fd995da8"},{"id":"q-358978be529f","stem":"Humans probably make IgE responses because","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"IgE binds more efficiently to low doses of antigen than IgG"},{"label":"B","text":"IgE is protective against dangerous pollens."},{"label":"C","text":"IgE triggers eosinophils to release products toxic to helminth parasites"},{"label":"D","text":"their T cells were not properly tolerized to self IgE in the thymus."},{"label":"E","text":"they cannot produce enough IgG to protect themselves against allergens."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-220a3cb6befb","stem":"All of the following are Type I hypersensitivities EXCEPT","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"an allergy to peanuts."},{"label":"B","text":"an anaphylactic reaction to bee stings."},{"label":"C","text":"a blood transfusion reaction."},{"label":"D","text":"asthma induced by cat dander."},{"label":"E","text":"hay fever."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-174be3c503c9","stem":"Fran walks outside on a beautiful day and takes a deep breath of ragweed pollen, to which she has a strong Type I hypersensitivity. Which event below will NOT occur within 30 minutes due to this hypersensitivity?","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A local inflammatory response in the nose is induced, resulting in a runny or stuffy nose."},{"label":"B","text":"IgE specific for ragweed pollen is synthesized by B cells in the local lymph nodes."},{"label":"C","text":"Mast cells respond to the antigen-IgE signal by releasing preformed histamine"},{"label":"D","text":"Ragweed pollen antigen binds to IgE present on mast cell FcεRI in the respiratory tract."},{"label":"E","text":"Systemic effects of hypersensitivity such as anaphylactic shock may occur."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-8279827f59ba","stem":"Type II hypersensitivities involve","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"anaphylactic shock."},{"label":"B","text":"complement-mediated lysis of antibody-coated cells."},{"label":"C","text":"cytotoxic T cell mediated lysis of antibody coated cells"},{"label":"D","text":"chemotaxis of eosinophils."},{"label":"E","text":"IgE-mediated degranulation of mast cells."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-170f2a186d7c","stem":"All of the following are Type II hypersensitivities EXCEPT","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"a blood transfusion reaction to AB antigens on erythrocytes."},{"label":"B","text":"autoimmune hemolytic anemia, production of autoantibodies to erythrocyte antigens."},{"label":"C","text":"drug-induced hemolytic anemia, production of antibodies to medications which can bind to erythrocytes."},{"label":"D","text":"Grave's disease, production of autoantibodies to TSH receptor on thyroid cells."},{"label":"E","text":"serum sickness, production of antibodies to passively administered foreign antibodies."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-9d6865d8dc23","stem":"Type II hypersensitivity results in all of the following EXCEPT","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"attraction and activation of inflammatory cells."},{"label":"B","text":"increased vascular permeability."},{"label":"C","text":"lysis of antibody coated cells by NK cells."},{"label":"D","text":"mediator release by CTL."},{"label":"E","text":"release of cytokines by macrophages."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-0cd2e94999a9","stem":"A Type III hypersensitivity reaction is mediated by","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"antibody reacting with membrane antigen epitopes."},{"label":"B","text":"autoimmune reactions to self tissue antigens."},{"label":"C","text":"complement activation by immune complexes deposited in the blood vessel walls, kidneys, and joints."},{"label":"D","text":"cytokine release by Th1 cells."},{"label":"E","text":"the cell-mediated branch of the immune system."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-761ece8b4d9c","stem":"As he cleared brush near his home, Frank was bitten by a rattlesnake. He went to the emergency room for treatment with horse IgG anti-rattlesnake venom. About a week after the treatment, Frank experienced a rash, fever, swollen lymph nodes, and pains in his joints, all symptoms of serum sickness. These symptoms are probably due to","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"a T cell memory response to horse IgG."},{"label":"B","text":"cross reactivity between horse IgG and human IgG."},{"label":"C","text":"late phase damage caused by the rattlesnake venom"},{"label":"D","text":"production of IgG anti-horse immunoglobulin, which triggered a Type III hypersensitivity."},{"label":"E","text":"production of IgG anti-rattlesnake venom, which triggered a Type III hypersensitivity."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-8f86b01a8d07","stem":"In the situation described in Question 10 above, Frank can be treated with","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"antiserum to complement to block its activation."},{"label":"B","text":"human anti-horse IgG to more quickly clear the horse antibody."},{"label":"C","text":"immunosuppressive drugs to block B cell production of antibody."},{"label":"D","text":"plasmapheresis to remove antigen-antibody complexes from the blood."},{"label":"E","text":"rattlesnake venom to absorb the horse anti-venom antibody."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-2490ce60dc6a","stem":"Type IV hypersensitivity (DTH)","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"can be passively transferred with CD4 T cells."},{"label":"B","text":"causes chicken pox."},{"label":"C","text":"involves cell damage induced by IgG antibodies which are produced late in an immune response."},{"label":"D","text":"is mediated by memory macrophages."},{"label":"E","text":"occurs 1-2 weeks after antigen exposure."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-873397976c78","stem":"During Delayed Type Hypersensitivity reactions, macrophages","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"are not antigen specific."},{"label":"B","text":"are stimulated by IFNγ."},{"label":"C","text":"do not depend on antibody for antigen recognition."},{"label":"D","text":"kill neighboring cells, whether infected or not."},{"label":"E","text":"all of the above are true."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-334ecb0242fa","stem":"A positive skin reaction to tuberculin means that one has","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"an active case of tuberculosis."},{"label":"B","text":"an allergy to Mycobacterium tuberculosis."},{"label":"C","text":"antibodies specific for M. tuberculosis."},{"label":"D","text":"macrophages containing M. tuberculosis in their phagolysosomes."},{"label":"E","text":"memory CD4 T cells specific for M. tuberculosis."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b8688817ffab","stem":"A common feature of all hypersensitivities is","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"activation of CTL."},{"label":"B","text":"activation of Th2 cells."},{"label":"C","text":"antibody synthesis."},{"label":"D","text":"inflammation."},{"label":"E","text":"all of the above. Problems"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ec47d0849a51","stem":"Could one simultaneously develop both Type I and Type II hypersensitivities to aspirin?","type":"Short Answer","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b59f9eb9d225","stem":"Some people are \"allergic\" to hot or cold temperatures; they experience swelling in their extremities or difficulty in breathing. Other people experience asthma following vigorous exercise. Can you propose a mechanism for these allergic attacks?","type":"Short Answer","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f67d8412e9bc","stem":"How could you modify horse anti-rattlesnake venom to prevent serum sickness if Frank (Question 10 above) is bitten again by a rattlesnake?","type":"Short Answer","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a2ed482ecfe8","stem":"All of the following probably contribute to the development of autoimmunity EXCEPT","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"cross-reactivity of pathogen and self antigens."},{"label":"B","text":"expression of self antigen in the thymus or bone marrow."},{"label":"C","text":"low avidity presentation of some self peptides in the thymus."},{"label":"D","text":"random generation of TCR and BCR specificities."},{"label":"E","text":"tissue injury which releases normally hidden self antigens."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-2a0c495cbd49","stem":"The elimination of self-reactive T cells during thymus education is called","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"apoptosis."},{"label":"B","text":"clonal selection."},{"label":"C","text":"clonal anergy."},{"label":"D","text":"negative selection."},{"label":"E","text":"positive selection."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7cd4a4471a11","stem":"An autoimmune disease mediated by Type III hypersensitivity is","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"autoimmune hemolytic anemia caused by anti-A blood group antigen."},{"label":"B","text":"Grave's Disease caused by anti-TSH receptor antibodies."},{"label":"C","text":"IDDM caused by CTL to islet antigens."},{"label":"D","text":"Lyme arthritis caused by immune complexes resulting from a persistent infection with Borrelia burgdorferi."},{"label":"E","text":"Myasthenia gravis, caused by antibodies to the acetylcholine receptor"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-bfc900fd87d8","stem":"Tolerance is induced by all of the following EXCEPT","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"administration of antigen with adjuvant."},{"label":"B","text":"clonal anergy of self-reactive mature T cells which bind antigen without co-stimulation."},{"label":"C","text":"clonal deletion of self-reactive immature B cells whose BCR is extensively cross-linked by antigen."},{"label":"D","text":"failure of particular MHC alleles to present certain peptides."},{"label":"E","text":"regulatory T cells that suppress immune responses."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7ea12f8f6034","stem":"Autoimmune diseases which are Type II hypersensitivities include all of the following EXCEPT","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Goodpasture's syndrome cause by autoantibodies to Type IV collagen."},{"label":"B","text":"insulin-resistant diabetes caused by autoantibodies to insulin receptor."},{"label":"C","text":"multiple sclerosis caused by Th1 cells specific for proteins in the brain and spinal cord."},{"label":"D","text":"pemphigus vulgaris caused by autoantibodies to epidermal cadherin."},{"label":"E","text":"rheumatic fever caused by antibodies to streptococcal antigens that cross-react with heart tissue."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d62284fde30e","stem":"Induction of autoimmunity usually involves","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"activation of antigen-specific T cells."},{"label":"B","text":"anergy of antigen-specific B cells."},{"label":"C","text":"development of autoimune disease in everyone with certain HLA alleles."},{"label":"D","text":"occurrence of infection in the absence of inflammation."},{"label":"E","text":"recruitment of antigen-specific dendritic cells to T cell areas of the lymph nodes."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-168e0ee1293b","stem":"The chances of developing a given autoimmune disease are linked to all of the following EXCEPT","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"contracting an infectious disease."},{"label":"B","text":"gender."},{"label":"C","text":"having an identical twin with the disease."},{"label":"D","text":"inheriting certain HLA alleles."},{"label":"E","text":"total absence of thymus education."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-cd161455316f","stem":"Autoantibodies to a cell surface receptor","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"bind the cell to mimic the action of the natural ligand for that receptor"},{"label":"B","text":"block cell activation via that receptor."},{"label":"C","text":"cause the destruction of the cell by ADCC."},{"label":"D","text":"cause the destruction of the cell via complement-mediated lysis."},{"label":"E","text":"All of the above are possible consequences."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b25ebf5c2657","stem":"Organ-specific autoimune diseases include all of the following EXCEPT","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"autoimmune hemolytic anemia."},{"label":"B","text":"Hashimoto's thyroiditis."},{"label":"C","text":"insulin-dependent diabetes mellitus (IDDM)."},{"label":"D","text":"myasthenia gravis."},{"label":"E","text":"rheumatoid arthritis."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-334ff16fa497","stem":"Increased risk of developing Type 1 diabetes (IDDM) associated with HLA DR3 and DR4","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"can be lowered by the presence of HLA DR2."},{"label":"B","text":"has been discovered to be due to a genetic mutation in those alleles induced by closely linked DQβ."},{"label":"C","text":"means that everyone with those HLA alleles will develop diabetes during his or her lifetime."},{"label":"D","text":"occurs because DR3 and DR4 cannot present self antigen in the thymus."},{"label":"E","text":"protects individuals with IDDM from malaria."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-0ff383205864","stem":"Of the following, it is usually the easiest to identify specific","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"antigens for which autoimmune T cells are specific."},{"label":"B","text":"antigens to which autoantibodies are being produced."},{"label":"C","text":"environmental factors which promoted development of autoimmunity."},{"label":"D","text":"pathogen antigens which initiated the autoimmune response."},{"label":"E","text":"All of the above are equally easy to determine."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-02fbdd4c4510","stem":"Determinant spreading occurs when","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"antigenic epitopes move from one cell to another."},{"label":"B","text":"B cells specific for one epitope provide co-stimulation to Th2 cells specific for different epitopes."},{"label":"C","text":"CTL killing leads to release of new antigens to which B cells can produce antibodies."},{"label":"D","text":"Th2 cells specific for one epitope on an antigen complex activate B cells specific for several different epitopes on that same complex."},{"label":"E","text":"Answers b, c and d are examples of how determinant spreading could occur."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-60b7d51bb1ea","stem":"Feeding of myelin basic protein (MBP) to mice prevents them from later developing experimental autoimmune encephalomyelitis when they are injected with MBP and adjuvant. The mechanism by which antigen feeding prevents EAE is though to be","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"activation of regulatory T cells producing IFNγ."},{"label":"B","text":"activation of regulatory T cells producing TGFβ."},{"label":"C","text":"clonal anergy of all MBP-specific T cells."},{"label":"D","text":"clonal deletion of all MBP-specific T cells."},{"label":"E","text":"induction of an IgE response instead of an IgG response to MBP."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-5012d544bd35","stem":"Immunological ignorance to an antigen occurs when","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"all lymphocytes specific for that antigen have undergone clonal deletion or clonal anergy."},{"label":"B","text":"the antigen is absent from the body (non-self)."},{"label":"C","text":"the antigen is presented on self MHC with such high avidity that specific T cells are activated to undergo apoptosis."},{"label":"D","text":"the antigen is presented on self MHC at such low avidity that specific T cells are not activated."},{"label":"E","text":"the antigen is sequestered in the cell cytoplasm."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-25d373dbc37f","stem":"Self-specific B cells are not generally responsible for the induction of autoimmunity because they","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"are not present in the body."},{"label":"B","text":"can be activated by self antigens but not produce any self-specific antibodies."},{"label":"C","text":"cannot be activated by binding cell surface antigen."},{"label":"D","text":"require activation by self-specific T cells, whose activates are more tightly regulated than those of B cells."},{"label":"E","text":"undergo somatic recombination, which eliminates self-specific B cells."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-8f2e737137a0","stem":"Immune deviation might alleviate autoimmune disease by","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"activating cytotoxic T cells to become regulatory T cells."},{"label":"B","text":"distracting the immune system to respond to a different, less harmful self antigen."},{"label":"C","text":"substituting allogeneic T cells for autoimmune T cells via bone marrow transplantation."},{"label":"D","text":"switching the autoimmune response from a Th1 response to a less damaging Th2 response."},{"label":"E","text":"targeting the immune response to an immunologically privileged site."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d86392786bbe","stem":"The link between infection and autoimmunity is related to four of the following observations. Find the exception. Type IV sections of the table. Why are some diseases listed in more than one section?","type":"Multiple Response","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Antigens on pathogens may induce the production of antibodies which bind self antigen."},{"label":"B","text":"Infection stimulates the production of inflammatory cytokines which induce dendritic cells to express more B7."},{"label":"C","text":"Infection stimulates the production of inflammatory cytokines which induce dendritic cells to express more MHC molecules."},{"label":"D","text":"Molecular mimicry of self antigen by pathogens antigen results in clonal deletion of self-reactive T cells that might otherwise cause autoimmunity."},{"label":"E","text":"People who suffer more parasite infections are less likely to develop SLE than people of similar genetic backgrounds who are not infected by those parasites. Problem Select one of the autoimmune diseases described in the table above under Type II and briefly describe the immune mechanism(s) of tissue damage. How could there be T cells specific for self antigen present after negative selection in the thymus? Has the autoantigen been identified in the disease you picked? Why is it often difficult to identify the autoantigen? Does the presence of antibody to an antigen indicate that that antigen triggered the autoimmunity? Do the same for a disease in the Type III and QSTNS ON Transplantation:-"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review"],"cleaningOperations":[]},{"id":"q-b6702ee311be","stem":"John Doe needs a kidney transplant. The best MHC match for John would probably be","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"an unrelated cadaver."},{"label":"B","text":"his brother"},{"label":"C","text":"his cousin."},{"label":"D","text":"his mother."},{"label":"E","text":"his wife."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-8acb401708b4","stem":"The serological tissue typing test is","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"an ELISA for donor antibodies to recipient MHC antigens."},{"label":"B","text":"the best test to predict if the recipient will reject the donor tissue."},{"label":"C","text":"used to match Class I MHC for a heart transplant."},{"label":"D","text":"used to match Class I MHC for a kidney transplant."},{"label":"E","text":"used to match Minor H antigens between donor and recipient."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d35f44f8a6b3","stem":"One of the ways by which allograft rejection is prevented is through administration of","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"antibodies to CD3."},{"label":"B","text":"antibody to the foreign MHC."},{"label":"C","text":"IL-2."},{"label":"D","text":"IgE."},{"label":"E","text":"Rhogam."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-ce1f63ce9d13","stem":"Hyperacute graft rejection","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"always occurs if HLA-B or HLA-DR alleles are mismatched."},{"label":"B","text":"can be controlled with Cyclosporin A and anti-CD3."},{"label":"C","text":"causes most transplantation failures."},{"label":"D","text":"is due to the presence of antibodies against graft surface antigens."},{"label":"E","text":"is due to T cell recognition of more than three differences in MHC alleles."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7da76a114bcd","stem":"The best test to determine whether a kidney graft from a relative would be rejected would be","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"agglutination of donor kidney cells by anti-MHC antibodies from the recipient."},{"label":"B","text":"51Cr release assay using donor target cells and recipient T cells."},{"label":"C","text":"ELISA of donor kidney molecules with enzyme-labeled recipient anti-kidney antibodies."},{"label":"D","text":"flow cytometry of donor cells using antibodies to recipient MHC alleles."},{"label":"E","text":"limit dilution assays of the frequency of recipient cells which will recognize the donor HLA."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f4429a582163","stem":"Acute rejection occurs due to","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"activation of recipient B cells by donor MHC on recipient Th2 cells."},{"label":"B","text":"activation of recipient Tc cells by donor MHC on donor APC."},{"label":"C","text":"activation of recipient Tc cells by donor MHC on recipient APC."},{"label":"D","text":"activation of recipient Th1 cells by donor MHC on donor APC."},{"label":"E","text":"activation of recipient Th1 cells by donor minor H antigens on recipient APC."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-cd7a641a9a76","stem":"All of the following statements about tissue matching are true EXCEPT","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Many HLA antigens have not yet been identified."},{"label":"B","text":"Minor H antigens are often not encoded in the MHC."},{"label":"C","text":"The serological typing test can report a match when HLA antigens are different."},{"label":"D","text":"Tissue between HLA-identical siblings can sometimes be rejected."},{"label":"E","text":"Time for bone marrow typing is limited by the ability of the marrow cells to survive outside the donor."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d519cde33fbf","stem":"Xenografts of pig organs into people has so far failed because","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"high numbers of human T cells recognize pig MHC as foreign."},{"label":"B","text":"humans are allergic to pig tissue."},{"label":"C","text":"humans have preexisting antibodies to pig carbohydrates."},{"label":"D","text":"humans have preexisting antibodies to pig MHC."},{"label":"E","text":"pig organs are too small for most humans."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f27a318e08fd","stem":"Long-term allograft survival is affected by all of the following EXCEPT","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"cause of the original organ failure."},{"label":"B","text":"CMV infections."},{"label":"C","text":"number of HLA antigens that are matched."},{"label":"D","text":"pre-formed antibodies to alloantigens."},{"label":"E","text":"toxicity of the anti-rejection drugs."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-8c98c5c36862","stem":"Possible immunotherapeutic strategy for treating autoimmunity would NOT include administration of","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"adjuvants to tolerize APC."},{"label":"B","text":"antibodies to CD3."},{"label":"C","text":"azathioprine to block T cell division."},{"label":"D","text":"Cyclosporin A to block IL-2 production during T cell activation."},{"label":"E","text":"prednisone to reduce inflammation."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-6f8658197979","stem":"Bone marrow transplantation differs from organ transplantation because","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"activation of Tc cells by foreign HLA is the principal mechanism of acute rejection."},{"label":"B","text":"minor H antigens do not occur on marrow cells and do not contribute to rejection."},{"label":"C","text":"mature Tc cells in the graft can recognize and reject recipient tissue."},{"label":"D","text":"the donor is alive and can give permission for the transplant."},{"label":"E","text":"the recipient has no immune system and cannot reject the donor marrow cells.."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b8e6f3fa3c8b","stem":"The developing fetus is not rejected by the pregnant mother because","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the fetus has no antigens that are foreign to the mother's immune system."},{"label":"B","text":"the mother cannot make antibodies to paternal HLA antigens."},{"label":"C","text":"the mother's T cells are never exposed to fetal antigens."},{"label":"D","text":"trophoblast cells express MHC identical to that of the mother."},{"label":"E","text":"trophoblast cells secrete immunosuppressive cytokines."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-cf51baaf7871","stem":"Side effects of immune suppression include all of the following EXCEPT","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"cancer."},{"label":"B","text":"hair loss."},{"label":"C","text":"HAMA response."},{"label":"D","text":"infections."},{"label":"E","text":"weight gain."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-6467178feecc","stem":"Prednisone is a(n)","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"anti-inflammatory drug."},{"label":"B","text":"cholesterol drug."},{"label":"C","text":"cytotoxic drug."},{"label":"D","text":"drug that blocks T cell activation."},{"label":"E","text":"steroid inhibitor."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-897a5ab998a7","stem":"It is easier to treat transplant rejection than to treat autoimmunity because current therapy?","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"HLA antigens are better characterized than autoantigens."},{"label":"B","text":"mechanisms for graft rejection are better understood than those for autoimmunity."},{"label":"C","text":"more drugs are available for controlling rejection than for controlling autoimmunity."},{"label":"D","text":"once an immune response is established it is harder to block."},{"label":"E","text":"the foreign antigens can be removed with a transplant but not with a self antigen. Problem How would monoclonal anti-CD4, anti CD40L, and a fusion protein of CTLA-4 and the Fc region of human antibody inhibit graft rejection? What specific effector cells would they target? Would the inhibition be less likely to increase infection risk than QSTNS ON Tumor Immunology:-"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ca2bc5c71660","stem":"Cancer is caused by","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"chemicals."},{"label":"B","text":"radiation."},{"label":"C","text":"spontaneous mutations."},{"label":"D","text":"viruses."},{"label":"E","text":"all of the above."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-943ed356b522","stem":"Tumor-associated antigens CANNOT be","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"expressed on non-tumor cells."},{"label":"B","text":"onco-fetal antigens."},{"label":"C","text":"over-expressed self antigens."},{"label":"D","text":"presented on MHC Class I."},{"label":"E","text":"tumor-specific."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-35631bf0c962","stem":"Tumors do NOT escape immune surveillance by","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"downregulating their expression of MHC Class I."},{"label":"B","text":"expressing antigens which are not found on other self tissues."},{"label":"C","text":"failing to express B7."},{"label":"D","text":"producing immunosuppressive cytokines like TGFβ."},{"label":"E","text":"shedding their membrane antigens."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b0fab172a60a","stem":"A virus molecule expressed on the membrane of a virus-induced tumor cell is an example of a(n)","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Virology","topicOriginal":"Virology","subtopic":"Viruses","suggestedTopic":null,"options":[{"label":"A","text":"angiogenic molecule."},{"label":"B","text":"carcinoembryonic antigen."},{"label":"C","text":"proto-oncogene."},{"label":"D","text":"tumor-associated antigen."},{"label":"E","text":"tumor-specific antigen."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Virology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-110fa7f12d8b","stem":"Proto-oncogenes can be activated to become oncogenes and cause cancer by","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"carcinogens in cigarette smoke."},{"label":"B","text":"overexposure to UV radiation in sunlight."},{"label":"C","text":"spontaneous mutations."},{"label":"D","text":"virus infection."},{"label":"E","text":"all of the above."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-0db611a4b833","stem":"Enhancing antibodies","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"enhance the ability of CTL to eliminate tumor cells."},{"label":"B","text":"enhance tumor growth by blocking access of CTL to tumor cells."},{"label":"C","text":"kill tumor cells when administered to the cancer patient."},{"label":"D","text":"promote APC uptake of tumor antigen via FcR."},{"label":"E","text":"promote tumor detection when used to generate a HAMA response."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-91a92bb768a5","stem":"Experimental approaches that may result in new immunotherapies for cancer include all of the following EXCEPT","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"monoclonal antibodies to tumor antigens coupled with cytotoxic drugs."},{"label":"B","text":"patient dendritic cells pulsed with tumor heat shock proteins."},{"label":"C","text":"vaccines containing live tumor cells to induce vigorous CTL responses."},{"label":"D","text":"vaccines containing tumor cells transfected with a gene for B7."},{"label":"E","text":"vaccines containing tumor cells transfected with an antisense gene for TGFβ. Problem Melanomas are fast-growing skin tumors which metastasize to distant locations in the body. They express tumor-associated antigens MAGE-1 and MAGE-3, which are also found on testicular tissue. How could you use monoclonal antibodies to MAGE to kill metastatic cancer? Include a description of the side effects of this therapy and why it might not be successful. QSTNS ON Vaccines:-"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review"],"cleaningOperations":[]},{"id":"q-8819542e7fb2","stem":"Advantages of the oral polio vaccine compared with the killed polio vaccine are all of the following EXCEPT that it","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"elicits IgA as well as IgG synthesis."},{"label":"B","text":"induces cellular as well as humoral immunity."},{"label":"C","text":"induces secretion of protective mucosal neutralizing antibodies."},{"label":"D","text":"is less expensive to administer."},{"label":"E","text":"is safer to give to immunosuppressed children."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-c3acf15f0dbc","stem":"To make a recombinant vaccine to a virus, the virus DNA is expressed","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Virology","topicOriginal":"Virology","subtopic":"Viruses","suggestedTopic":null,"options":[{"label":"A","text":"covalently linked with a polysaccharide."},{"label":"B","text":"in a genetic variant of the same virus."},{"label":"C","text":"in a less virulent vector, which may be a virus or a bacterium."},{"label":"D","text":"in muscle cells of the immunized person."},{"label":"E","text":"on an ISCOM."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Virology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e57c9fccdb5c","stem":"An advantage of giving passive immunization is that it provides ___________ immunity.","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"cellular"},{"label":"B","text":"faster"},{"label":"C","text":"longer lasting"},{"label":"D","text":"more specific"},{"label":"E","text":"safer"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a6a9a99aac17","stem":"Bacterial polysaccharide vaccines are conjugated to proteins so that","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Bacteriology","topicOriginal":"Bacteriology","subtopic":"Bacterial Pathogens","suggestedTopic":null,"options":[{"label":"A","text":"the polysaccharide can act as an adjuvant to induce better immunity to the protein."},{"label":"B","text":"the polysaccharide looks less like blood typing antigens to the immune system."},{"label":"C","text":"the protein can act as an adjuvant to upregulate B7 expression on APC."},{"label":"D","text":"the protein can stimulate T cell help for polysaccharide-specific B cells."},{"label":"E","text":"none of the above."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Bacteriology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-6ea5e35d1015","stem":"Hepatitis B surface antigen vaccine, a recombinant vaccine produced in yeast cells","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Virology","topicOriginal":"Virology","subtopic":"Viruses","suggestedTopic":null,"options":[{"label":"A","text":"cannot be given to immunosuppressed children."},{"label":"B","text":"employs the yeast cells as an adjuvant to increase its immunogenicity."},{"label":"C","text":"is less safe to administer than killed Hepatitis B virus vaccine."},{"label":"D","text":"is more immunogenic than the whole Hepatitis virus would be."},{"label":"E","text":"requires several boosters because it is also a subunit vaccine."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Virology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-167f232be2dc","stem":"Passive immunization to a bacterial toxin would be recommended if","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Bacteriology","topicOriginal":"Bacteriology","subtopic":"Bacterial Pathogens","suggestedTopic":null,"options":[{"label":"A","text":"exposure to the toxin had already occurred in an unimmunized person."},{"label":"B","text":"the person who needed the immunization had been recently immunized with the toxoid."},{"label":"C","text":"the toxin could not reproduce in the body."},{"label":"D","text":"the toxin was not immunogenic."},{"label":"E","text":"the toxoid was available only as part of a conjugate vaccine."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","disp