miolog","suggestedTopic":null,"options":[{"label":"A","text":"Histogram"},{"label":"B","text":"Pie chart"},{"label":"C","text":"Scatter diagram"},{"label":"D","text":"Bar chart"},{"label":"E","text":"Line graph"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ad6c26084c8e","stem":"Simply by scanning the values in each distribution below, identify the distribution with the largest standard deviation","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"1, 10, 15, 18, 20, 22, 25, 30, 39"},{"label":"B","text":"1, 3, 8, 10, 20, 20, 30, 32, 37, 39"},{"label":"C","text":"1, 15, 17, 19, 20, 20, 21, 23, 25, 39"},{"label":"D","text":"41, 42, 43, 44, 45, 45, 46, 47, 48, 49"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-997dc66ef182","stem":"In the definition of epidemiology, ‘distribution’ refers to all of the following except","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Measures and Study Designs","suggestedTopic":null,"options":[{"label":"A","text":"Who"},{"label":"B","text":"When"},{"label":"C","text":"Where"},{"label":"D","text":"Why"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSou