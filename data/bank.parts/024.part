gy","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"Minimise bias"},{"label":"B","text":"Optimize external validity"},{"label":"C","text":"Reduces or eliminate known confounders"},{"label":"D","text":"Produce similar groups that differ by the intervention only"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"32415bb37507f80dd40ca210cbe84c2a5cfa4ce9"},{"id":"q-0f4ca797f89a","stem":"All of the following should be true of a disease for which screening is planned except","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"The disease must be treatable"},{"label":"B","text":"The natural history of the disease must be understood"},{"label":"C","text":"The disease should be rare"},{"label":"D","text":"The disease should be serious"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-523cbbff36db","stem":"In screening programme, an effect comparable to the late look bias is called","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"Recall bias, because only severe illness is recalled"},{"label":