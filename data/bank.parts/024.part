:"B","text":"granzymes."},{"label":"C","text":"IFNγ."},{"label":"D","text":"perforin."},{"label":"E","text":"TNFβ."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[],"manualEdits":{}},{"id":"q-46711f960ff0","stem":"IL-1 is produced by macrophages and acts on the hypothalamus to induce fever. This is an example of _____ cytokine action.","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"autocrine."},{"label":"B","text":"endocrine."},{"label":"C","text":"paracrine."},{"label":"D","text":"pleiotropic."},{"label":"E","text":"synergistic."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-52b184e52052","stem":"CD40 on macrophages binding to CD40L on Th1 cells signals the macrophages to","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"die."},{"label":"B","text":"kill cytoplasmic viruses."},{"label":"C","text":"phagocytose the Th1 cells."},{"label":"D","text":"respond to IFNγ by expressing more membrane MHC."},{"label":"E","text":"secrete IL-2."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-04eab941cd81","stem":"Activated CTL can regulate immune responses by signaling activated lymphocytes to undergo","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"apoptosis."},{"label":"B","text":"clonal deletion."},{"label":"C","text":"clonal proliferation."},{"label":"D","text":"cytotoxicity."},{"label":"E","text":"somatic hypermutation."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-8d46e55fcd6c","stem":"Cellular immunity includes all of the following except","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"activated macrophages killing phagocytosed bacteria."},{"label":"B","text":"CD8 T cells inducing apoptosis using Fas-FasL binding."},{"label":"C","text":"complement-mediated lysis of bacterial cells."},{"label":"D","text":"MHC-restricted cytotoxic T cells killing virus-infected cells."},{"label":"E","text":"NK cells performing natural killing of tumor cells."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-aa7f48058a3c","stem":"CTL binding and destruction of target cells depends on","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"a co-stimulatory signal from the target cell."},{"label":"B","text":"antigen presentation on the surface of the target cell."},{"label":"C","text":"lack of a negative signal from MHC to prevent cytotoxicity."},{"label":"D","text":"presence of virus proteins in the membrane of the target cell."},{"label":"E","text":"secretion of cytokines by the infected cell to attract CTL."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-c14ff41577d1","stem":"CTL use perforin to","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"activate the classical complement cascade to lyse the target."},{"label":"B","text":"allow granzymes to enter the target cell and initiate apoptosis."},{"label":"C","text":"promote target cell lysis by macrophages."},{"label":"D","text":"stimulate the target cells to express Fas on their membranes"},{"label":"E","text":"substitute for C9 in the alternative complement pathway."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-879b2feadb37","stem":"CTL do not damage uninfected cells because","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"CTL do not bind uninfected cells using their CAMs."},{"label":"B","text":"granzymes and perforin are secreted only in the space between the CTL and the infected target cells."},{"label":"C","text":"uninfected cells cannot undergo apoptosis."},{"label":"D","text":"uninfected cells have no membrane Class I MHC because they have no pathogen peptides to present."},{"label":"E","text":"None of the above is true."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-fc47abfbde5b","stem":"Granzymes are","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"enzymes which cut DNA into ladders to induce apoptosis."},{"label":"B","text":"present in an inactive form in resting CD8 cells."},{"label":"C","text":"secreted in large amounts by CTL to kill many target cells simultaneously."},{"label":"D","text":"structurally similar to macrophage cytokines that kill vesicular pathogens."},{"label":"E","text":"synthesized by CTL before they bind to target cells."}],"priority":0,"status":"practice_draft","flags":["short_or_incomplete_stem"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["short_or_incomplete_stem","short_stem"],"cleaningOperations":[]},{"id":"q-23191e89396f","stem":"Which of the following would you NOT expect to result in reduced CTL killing activity?","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"absence of the gene for β2 microglobulin."},{"label":"B","text":"absence of the gene for HLA DM."},{"label":"C","text":"absence of the gene for perforin."},{"label":"D","text":"presence of anti-CD8 antibodies."},{"label":"E","text":"presence of monoclonal antibodies specific for multiple TCR Vα and Vβ specificities."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-87b8bbac7a16","stem":"IFNγ does all of the following EXCEPT","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"activate macrophages."},{"label":"B","text":"cut DNA in target cells into 200bp fragments."},{"label":"C","text":"directly inhibit viral replication in infected cells."},{"label":"D","text":"induce macrophages to express higher levels of MHC on their membranes."},{"label":"E","text":"starve intracellular parasites of tryptophan."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-3d0ef5f8a3ef","stem":"Macrophage activation by Th1 cells is an important immune mechanism for eliminating","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"bacteria which can resist lysosomal degradation."},{"label":"B","text":"bacteria whose capsule makes them resistant to phagocytosis."},{"label":"C","text":"enveloped viruses."},{"label":"D","text":"parasites that infect T cells."},{"label":"E","text":"viruses that infect macrophages."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a7fc9156a563","stem":"T cells which activate macrophages do all of the following EXCEPT","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"activate macrophages at the site of infection."},{"label":"B","text":"activate only macrophages presenting specific antigen on MHC."},{"label":"C","text":"become activated effector cells in response to antigen plus co-stimulation."},{"label":"D","text":"have membrane CD4."},{"label":"E","text":"provide granzymes that the macrophages use to kill vesicular pathogens."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-3ecea4bb5416","stem":"Th1 cells promote cellular immunity by secreting primarily","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"IL-1 and IL-6."},{"label":"B","text":"IL-2 and IFNγ."},{"label":"C","text":"IL-4 and IL-5."},{"label":"D","text":"IL-10 and IL-12."},{"label":"E","text":"TNFα and FasL."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-68993be336fe","stem":"Macrophages kill pathogens using all of the following EXCEPT","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"nitric oxide."},{"label":"B","text":"oxygen radicals."},{"label":"C","text":"perforins."},{"label":"D","text":"peroxides."},{"label":"E","text":"proteolytic enzymes."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-c17b02be4bba","stem":"Th1 cells make IL-3 and GM-CSF, which","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"activate macrophages."},{"label":"B","text":"induce apoptosis in old macrophages."},{"label":"C","text":"stimulate macrophages to kill vesicular pathogens."},{"label":"D","text":"stimulate macrophage production in the bone marrow."},{"label":"E","text":"None of the above is a function of IL-3 and GM-CSF."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ca79b5b09729","stem":"Leishmania major is a protozoan parasite that infects macrophages and monocytes, where it escapes destruction by lysosomal enzymes and escapes to replicate in vesicles. Different mouse strains respond differently to L. major infection: BALB/c mice produce primarily activated Th2 cells, while C57Bl/6 mice produce primarily activated Th1 cells. Which mouse strain would you expect to be more resistant to Leishmania infection, and why? What Leishmania-specific effector cells would be present in infected mice from each strain?","type":"Short Answer","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ad31a7948c59","stem":"T independent antigens do NOT","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"bind to BCR."},{"label":"B","text":"get presented on MHC Class II."},{"label":"C","text":"have repeating epitopes."},{"label":"D","text":"induce B cell proliferation."},{"label":"E","text":"provide co-stimulatory signals to B cells"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-131204700008","stem":"The humoral immune response to T-independent antigens includes production of","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"IgA."},{"label":"B","text":"IgM."},{"label":"C","text":"memory B cells."},{"label":"D","text":"memory T cells."},{"label":"E","text":"all of the above."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-eac2e5a3b4a7","stem":"T-independent antigens are often","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"components of self cell membranes."},{"label":"B","text":"polyclonal B cell activators."},{"label":"C","text":"repeating peptide epitopes"},{"label":"D","text":"too small to be phagocytosed and presented."},{"label":"E","text":"none of the above"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-4cac7f97c097","stem":"Before a B cell can receive T cell help, the B cell must","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"express membrane B7."},{"label":"B","text":"express membrane CD40L."},{"label":"C","text":"express membrane IFNγ receptors."},{"label":"D","text":"go to the site of infection."},{"label":"E","text":"process and present peptide on Class II MHC."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-41d2962c025c","stem":"Antigen-binding B cells entering the secondary lymphoid organs initially go to the","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"B cell areas where they can bind antigen presented by follicular dendritic cells."},{"label":"B","text":"B cell areas where they can process and present antigen to T cells."},{"label":"C","text":"plasma cell areas where they can secrete antibody."},{"label":"D","text":"T cell areas where they can be the predominant activator of naïve T cells."},{"label":"E","text":"T cell areas where they can find specific helper T cells."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-45ccf9bfdade","stem":"Germinal centers are","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"areas of lymphocyte generation in the bone marrow."},{"label":"B","text":"common in unimmunized mice."},{"label":"C","text":"sites of rapid antigen-induced B cell division in the lymph nodes and spleen."},{"label":"D","text":"surrounded by naïve T cells waiting to be activated."},{"label":"E","text":"None of the above is true"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-fdecdd0aa49c","stem":"In order for T cells to provide help to B cells, T cell and B cell epitopes must be","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"covalently linked."},{"label":"B","text":"identical."},{"label":"C","text":"non-identical."},{"label":"D","text":"peptides."},{"label":"E","text":"T-dependent."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-aeec7ca4b26b","stem":"B cell isotype switching is important for","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"increasing the avidity of the antibody."},{"label":"B","text":"providing antibodies of many different antigen specificities."},{"label":"C","text":"providing antibodies which can perform different effector functions."},{"label":"D","text":"signaling the B cells to become activated by follicular dendritic cells"},{"label":"E","text":"signaling B cells to leave the lymph nodes and secrete antibody at the site of infection."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-20b438f464c5","stem":"Affinity maturation of the humoral immune response is due to","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"continued stimulation of B cells by high levels of antigen on the FDC."},{"label":"B","text":"DNA recombination by products of the RAG genes."},{"label":"C","text":"isotype switching."},{"label":"D","text":"negative selection of T cells with the lowest helper potential."},{"label":"E","text":"positive selection of B cells with the highest affinity for antigen."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ee87d9606ee6","stem":"Isotype switching by B cells occurs in response to T cell","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"IFNγ."},{"label":"B","text":"IL-4."},{"label":"C","text":"IL-5."},{"label":"D","text":"IL-6."},{"label":"E","text":"all of the above."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-48c47eb01e83","stem":"Isotype switching resembles somatic recombination because both processes","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"are catalyzed by the products of RAG-1 and RAG-2."},{"label":"B","text":"are regulated by helper T cell cytokines."},{"label":"C","text":"can result in stop codons in coding sequences."},{"label":"D","text":"occur in developing B cells in the bone marrow."},{"label":"E","text":"result in the irreversible loss of DNA from the B cell."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"8120a4e4fe62b7729a049d83afb9c4e63fdae1ca","manualEdits":{}},{"id":"q-24db97a9430c","stem":"Somatic hypermutation results in","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"antibody with different CDR than the membrane Ig which originally bound antigen."},{"label":"B","text":"B cell apoptosis."},{"label":"C","text":"B cells with higher affinity for the stimulating antigen."},{"label":"D","text":"B cells which can no longer bind the stimulating antigen."},{"label":"E","text":"All of the above result from somatic hypermutation"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-6ae4bdc52584","stem":"Plasma cells","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"are all very long-lived."},{"label":"B","text":"divide and differentiate into memory B cells."},{"label":"C","text":"produce most of their antibody at the site of infection."},{"label":"D","text":"secrete antibodies as long as antigen binds their membrane Ig receptors."},{"label":"E","text":"None of the above are true."}],"priority":0,"status":"practice_draft","flags":["short_or_incomplete_stem"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["short_or_incomplete_stem","short_stem"],"cleaningOperations":[]},{"id":"q-cf58d380ed23","stem":"Which of the following is NOT a similarity between the cellular and humoral immune responses?","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Antigen-specific lymphocytes undergo clonal selection and expansion."},{"label":"B","text":"Cytokine signals promote effector cell differentiation."},{"label":"C","text":"Memory cells are generated."},{"label":"D","text":"Macrophage cytotoxicity is increased."},{"label":"E","text":"Receptor isotype switching occurs."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-675d2a54bd06","stem":"Humoral immunity involves all of the following EXCEPT","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"antibody-dependent cell-mediated cytotoxicity."},{"label":"B","text":"antibody secretion by plasma cells."},{"label":"C","text":"B cell activation by antigen plus cytokines."},{"label":"D","text":"immunoglobulin isotype switching."},{"label":"E","text":"macrophage activation by Th1 cells"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-75aa94a512af","stem":"In the problem below dealing with linked T and B cell immune responses to haptens, the investigators chose to look at production of IgG rather than IgM because","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"IgG antibodies are easier to detect than IgM."},{"label":"B","text":"IgG is made before IgM in an immune response."},{"label":"C","text":"no IgM antibody can be produced to a hapten."},{"label":"D","text":"production of IgG requires T cell help but production of IgM does not."},{"label":"E","text":"None of the above is true."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-201747b6c103","stem":"In the practice problem below dealing with linked T and B cell immune responses to haptens, IgG is not produced in experiment #4 because","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"HEL is not an effective carrier for PC."},{"label":"B","text":"PC cannot be presented to B cells."},{"label":"C","text":"T and B cell epitopes need to be identical in order for the T cells to provide help."},{"label":"D","text":"T and B cell epitopes need to be physically linked in order for the T cell to provide help."},{"label":"E","text":"the same antigen epitopes were not given in both primary and secondary exposures."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft",