biology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-15df91c2224d","stem":"A secondary immune response is NOT","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"faster t`an a primAry response."},{"label":"B","text":"larger than a primary response."},{"label":"C","text":"longer lasting than a primary response."},{"label":"D","text":"more likely do result ij increaced adaptive immunity than a primary response."},{"label":"E","text":"preceded by a longer lag period than a primary response."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-c9766fcc6809","stem":"Antibody effector functions include all of the following EXCEPT","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"activating complement on bacterial surfaces to promote phagocytosis by neutrophils."},{"label":"B","text":"binding extracellular viruses to block their entry into host cells."},{"label":"C","text":"binding intracellular viruses to initiate cytotoxicity."},{"label":"D","text":"blocking uptake of bacterial toxins by host cells."},{"label":"E","text":"coating bacteria to promote their phagocytosis by neutrophils."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ba2e0c518bf8","stem":"Effector functions of complement include all of the following EXCEPT","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"attracting phagocytes to the site of infection."},{"label":"B","text":"facilitating phagocytosis of complement-coated bacteria."},{"label":"C","text":"increasing blood vessel permeability to plasma proteins."},{"label":"D","text":"lysing bacterial cells."},{"label":"E","text":"presenting antigen to B cells."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[],"manualEdits":{}},{"id":"q-1338f366ae3d","stem":"Jenner observed that milkmaids who were infected with cowpox were later immune to smallpox infections. This is an example of a(n)","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"acquired immunity of barrier skin cells."},{"label":"B","text":"active immunization with a non-related organism that causes similar symptoms."},{"label":"C","text":"innate immunity of milkmaids to smallpox."},{"label":"D","text":"memory response to a cross-reactive antigen."},{"label":"E","text":"passive immunization from contact with cow's milk antibodies."}],"priority":0,"status":"practice_draft","flags":[],"keyVerif