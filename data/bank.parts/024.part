ion","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-babc98fed1c2","stem":"Junctional diversity affects primarily the amino acid sequence in","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"all CDR equally."},{"label":"B","text":"CDR1."},{"label":"C","text":"CDR2."},{"label":"D","text":"CDR3."},{"label":"E","text":"FR3."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-8ea76240c42c","stem":"Isotype switching","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"changes the leader sequence exon so the antibody is secreted."},{"label":"B","text":"improves the antigen binding specificity of an Ig molecule."},{"label":"C","text":"increases the affinity of antibodies in a process called affinity maturation."},{"label":"D","text":"increases the functional diversity of Ig molecules."},{"label":"E","text":"occurs randomly between switch regions."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a00f6988ed9d","stem":"Isotype switching resembles somatic recombination because both processes","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"are catalyzed by the products of RAG1 and RAG2"},{"label":"B","text":"are regulated by helper T cell cytokines."},{"label":"C","text":"can result in stop codons in coding sequences."},{"label":"D","text":"occur in developing B cells in the bone marrow."},{"label":"E","text":"result in the irreversible loss of DNA from the B cell."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"8120a4e4fe62b7729a049d83afb9c4e63fdae1ca"},{"id":"q-4ea859a2de7a","stem":"Alternative mRNA splicing","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"allows the B cell to improve its antigen-binding fit after antigen contact."},{"label":"B","text":"allows the B cell to make membrane IgM from the mature mRNA for secreted IgD."},{"label":"C","text":"can be used for the simultaneous production of any two Ig isotypes."},{"label":"D","text":"is a process by which a B cell can simultaneously synthesize μ and δ chains."},{"label":"E","text":"occurs in response to T cell cytokines."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-8a9f1a5b7558","stem":"Because of the order of the CH gene segments (Cμ, Cδ, Cγ3, Cγ1, pseudogene Cε, Cα1, Cγ2, Cγ4, Cε, and Cα2), a human B cell which undergoes isotype switching from IgM to IgG1 can never in the future secrete","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"IgA."},{"label":"B","text":"IgE."},{"label":"C","text":"IgG2."},{"label":"D","text":"IgG3."},{"label":"E","text":"IgG4."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b131efa3a52d","stem":"Isotype switching is always productive because","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"B cells produce all isotypes simultaneously."},{"label":"B","text":"isotype switching does not involve recombination of DNA gene segments."},{"label":"C","text":"no DNA is deleted from the chromosome in isotype switching."},{"label":"D","text":"no effector diversity results from isotype switching."},{"label":"E","text":"recombination between switch sites occurs in introns so it cannot introduce stop codons into coding regions."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-3f68fca796cd","stem":"Somatic hypermutation does NOT","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"occur by somatic recombination."},{"label":"B","text":"occur during B cell proliferation."},{"label":"C","text":"occur in the B cell following antigen stimulation."},{"label":"D","text":"result in increased affinity of antibodies secreted later in immune responses."},{"label":"E","text":"result in the death of some B cells which no longer bind antigen. Problem"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[],"manualEdits":{}},{"id":"q-d464273da759","stem":"Make a line drawing of germline DNA encoding an Ig H chain, with several VH, DH, and JH segments and with Cμ. Now make a second drawing showing the same DNA following somatic recombination of one of your D and one of your J segments. What DNA did you eliminate? Do the same for the H chain DNA after V-DJ joining. Does somatic recombination ever eliminate the DNA between J and Cμ? How is it that this DNA is not expressed in the H chain protein.","type":"Short Answer","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-cadde25e79a5","stem":"Which of the following is NOT True about TCR?","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"All TCRs on a particular T cell have identical idiotypes."},{"label":"B","text":"CDR3 of TCR has the most sequence variability from molecule to molecule."},{"label":"C","text":"TCR has binding sites for both antigen and self MHC."},{"label":"D","text":"TCR is a disulfide-bonded heterodimer."},{"label":"E","text":"The αβ or γδ isotype of TCR determines the biological function of its secreted form."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-abd547c63131","stem":"The antigen-binding region of TCR is formed by the folding of","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Vα and Vβ chains."},{"label":"B","text":"Vα, Vβ, and CD3 chains."},{"label":"C","text":"Vα and Vβ2-microglobulin chains."},{"label":"D","text":"Vγ and Vα chains."},{"label":"E","text":"VL and VH chains."}],"priority":0,"status":"review","flags":["duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["duplicate_option_text","prior_structural_review_flag"],"cleaningOperations":[]},{"id":"q-ff5550d5f264",