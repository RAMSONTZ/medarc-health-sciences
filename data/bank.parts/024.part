":"Parasitology","displayTopic":"Protozoology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-fa933880fde6","stem":"The insecticide marketed as “NGAO” in Tanzania is","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Carbamete"},{"label":"B","text":"Organochloride."},{"label":"C","text":"Organophosphate."},{"label":"D","text":"Pyrethroide."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ed648f419915","stem":"In the classification of parasites, the correct sequence is","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Kingdom, Phylum, Class, Sub-family."},{"label":"B","text":"Kingdom, Sub-kingdom, Phylum, Sub-class."},{"label":"C","text":"Kingdom, Phylum, Class, Order, Family."},{"label":"D","text":"Kingdom, Phylum, Class, Genus, Species."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-3965ca1f292d","stem":"Which of the following is not recommended for malaria control in Dar es Salaam?","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Protozoology","topicOriginal":"Protozoology","sub