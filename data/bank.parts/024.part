istics and Research","displayTopic":"Biostatistics","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-175378cfcf12","stem":"Select the correct answer. Randomization","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"Helps to avoid misclassification of exposure status in randomized controlled trials."},{"label":"B","text":"Reduces the probability of selection bias in randomized controlled trials. 3"},{"label":"C","text":"Helps to avoid the necessity of performing an adjustment."},{"label":"D","text":"Helps to avoid interaction"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["answer_explanation_mixed_into_stem","repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"25c443aa6e9db79f5a98d652c3179de69fcfebda"},{"id":"q-5fd97566e13e","stem":"According to the text, which of the following orders is the recommended in the flowchart of the development of a research idea?","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"Research topic, research problem, research purpose, research question, hypothesis"},{"label":"B","text":"Research topic, research purpose, research problem, research question, hypothesis 7"},{"label":"C","text":"Research topic, research problem, research purpose, research question, hypothesis"},{"label":"D","text":"Research topic, hypothesis, research problem, research question, research purpose"}],"priority":0,"status":"review","flags":["duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_text","nonunique_option_text","prior_structural_review_flag","repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"361c28f7b865b6c0a4eb3f8033d9eee1e5d8b7c2"},{"id":"q-41f2b269826a","stem":"A review of the literature prior to formulating research questions allows the researcher to do which of the following?","type":"Calculation","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"To become familiar with prior research on the phenomenon of interest"},{"label":"B","text":"To identify potential methodological problems in the research area"},{"label":"C","text":"To develop a list of pertinent problems relative to the phenomenon of interest"},{"label":"D","text":"All of the above"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"33bb239170a5aaeb1c73cc7269dc39f796997122"},{"id":"q-0f99a4f72278","stem":"The research participants are described in detail in which section of the research plan?","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":