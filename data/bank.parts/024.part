Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"membrane μ chain + surrogate L chain."},{"label":"B","text":"membrane IgD."},{"label":"C","text":"Membrane IgM."},{"label":"D","text":"germline IgM."},{"label":"E","text":"RAG-1, RAG-2 and TdT."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-cc1ff53718e3","stem":"Bone marrow stromal cells","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"are important because they provide physical support for B cells (hence, their name from the Greek word for mattress)."},{"label":"B","text":"are present only in the center of the marrow."},{"label":"C","text":"present foreign antigen to B cells to stimulate somatic hypermutation ."},{"label":"D","text":"present self antigen on self MHC to B cells for negative selection."},{"label":"E","text":"secrete cytokines such as IL-7 that signal developing B cells to divide and differentiate."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-2475e6f605a3","stem":"Cell adhesion molecules (CAMs)","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"are found only on bone marrow stromal cells."},{"label":"B","text":"are specific receptors for cytokines that promote cell-cell binding."},{"label":"C","text":"function primarily to hold developing B cells in one location until they are fully developed."},{"label":"D","text":"signal developing B cells to divide and differentiate."},{"label":"E","text":"signal developing B cells to die because they have bound self."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-c61336ebae06","stem":"The developmental step that commits a cell to the B lineage is","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"expression of both membrane IgM and IgD."},{"label":"B","text":"expression of membrane μ chain."},{"label":"C","text":"expression of recombinase enzymes."},{"label":"D","text":"joining of a VH gene segment to a DH gene segment."},{"label":"E","text":"joining of a DH gene segment to a JH gene segment"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-1ba5bf6da748","stem":"Which statement about B cell development is FALSE?","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cells which fail to synthesize and express μ chains usually die."},{"label":"B","text":"Each DNA joining event in Ig genes has a 67% probability of resulting in a nonproductive rearrangement."},{"label":"C","text":"The earliest developing B cell which could be stained with FITC-anti-μ chain would be a pro B cell."},{"label":"D","text":"The earliest developing B cell which could be stained with FITC-anti- κ chain would be an immature B cell."},{"label":"E","text":"The enzyme which can add nucleotides not encoded in the DNA to Ig genes during recombination is TdT."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-8e52e1b24af6","stem":"Once H chain genes have been productively rearranged and expressed on the pre-B cell membrane, the next event to occur in the cell is","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"death of cells binding self antigen."},{"label":"B","text":"expression of membrane IgD."},{"label":"C","text":"expression of membrane of IgM."},{"label":"D","text":"proliferation of the pre-B cells."},{"label":"E","text":"somatic recombination of light chain genes."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-c602439a819d","stem":"In a productive rearrangement of Ig DNA, what is produced must be","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"a functional membrane Ig protein chain."},{"label":"B","text":"a loop of DNA that is then removed."},{"label":"C","text":"an mRNA for H or L chain."},{"label":"D","text":"a shorter piece of DNA."},{"label":"E","text":"successful antibody secretion in response to antigen."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e9a779336229","stem":"Proliferation of large pre-B cells","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"is part of clonal selection."},{"label":"B","text":"makes the pre-B cells more susceptible to apoptosis following self antigen binding"},{"label":"C","text":"results in production of many B cells with the same antigen specificity."},{"label":"D","text":"results in the production of many B cells with the same VH chain but different antigen specificities due to different VL regions."},{"label":"E","text":"requires the presence of RAG-1 and RAG-2."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-168ae51073ed","stem":"Which of the following statements is TRUE?","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Isotypic exclusion on individual B cells pertains to expression of a single heavy chain isotype on each mature naive B cell."},{"label":"B","text":"Pre-B cells must receive a signal from specific antigen binding to pre-B receptor before they can proceed to the next stage in development."},{"label":"C","text":"Membrane μ chain is always expressed with Igα and Igβ"},{"label":"D","text":"Membrane μ chain is always expressed with VpreB and λ5."},{"label":"E","text":"Transgenic mice for recombined H and L immunoglobulin genes have germline H and L genes in non-B cells."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"248a6c54f8445b675f896816d3de20b31c35fe86"},{"id":"q-458f1bc46b6f","stem":"Light chain rescue","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"allows self-specific B cells to repeat somatic recombination of light chain gene segments."},{"label":"B","text":"is a signal received through binding to the surrogate light chain that rescues the developing B cell from death."},{"label":"C","text":"results from multiple V-J joining events on a single chromosome until productive rearrangement of light chain occurs or all J segments have been recombined."},{"label":"D","text":"signals the developing B cell through IgαIgβ to begin recombination of light chain gene segments."},{"label":"E","text":"None of the above is true."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-4e4e9c9ff110","stem":"Regulatory nucleotide sequences in the DNA that control Ig protein synthesis are","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"inducers and promoters."},{"label":"B","text":"initiation sites and enhancers."},{"label":"C","text":"promoters and enhancers."},{"label":"D","text":"promoters and switch regions."},{"label":"E","text":"recombination signal sequences and promoters."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a74a8a43cfc0","stem":"Transgenic mice for BCR","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"are given a completely new set of Ig genes."},{"label":"B","text":"express the recombined H chain gene on every cell in the body."},{"label":"C","text":"have germline H chain gene segments in all their cells except B cells."},{"label":"D","text":"suppress their own H chain V-D-J recombination if they have been given a recombined H chain gene."},{"label":"E","text":"synthesize Ig with the same amount of diversity as non-transgenic mice."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-97bb7a0f6730","stem":"If the Ig V regions encoded in the transgenes were specific for self MHC, the transgenic mice","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"might be able to produce low numbers of non-self-specific B cells through receptor editing."},{"label":"B","text":"would produce normal numbers of B cells because MHC is not expressed in the marrow."},{"label":"C","text":"would die of autoimmunity."},{"label":"D","text":"would fail to produce any B cells."},{"label":"E","text":"would not die of autoimmunity because only T cells bind MHC."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a44b76e2bf8e","stem":"In general, a knock-out mouse","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"does not show allelic exclusion of Ig."},{"label":"B","text":"has a mutant TdT that removes (knocks out) N nucleotides instead of inserting them during somatic recombination."},{"label":"C","text":"has no Ig gene segments."},{"label":"D","text":"has a normal gene replaced with a nonfunctional gene for the same protein."},{"label":"E","text":"is often used to produce monoclonal antibody."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-62707f4b7c08","stem":"Knock-out mice which have μ gene segments from which the membrane domain has been removed","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"cannot synthesize any μ chain."},{"label":"B","text":"can splice the Cμ segments to the membrane segment for δ and express normal amounts of membrane μ chain."},{"label":"C","text":"have normal pro-B cells but no later stages of developing or mature B cells."},{"label":"D","text":"have normal pro-B cells and pre-B cells but no mature B cells."},{"label":"E","text":"have no cells with rearranged Ig genes."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-0888ba099dc4","stem":"B cells which express Igα with a truncated cytoplasmic domain (lacking the ITAMS)","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"become \"stuck\" in the immature B cell stage of development."},{"label":"B","text":"can express pre-B cell receptor but not proceed to divide and then recombine light chain genes."},{"label":"C","text":"develop normally since Igβ has its ITAM sequences."},{"label":"D","text":"express both IgM and IgD but cannot be activated by antigen."},{"label":"E","text":"require more antigen for activation."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-6b7031d00783","stem":"The ability of an individual B cell to express only one H chain allotype is called","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":"Immunoglobulin genetics","options":[{"label":"A","text":"allelic exclusion."},{"label":"B","text":"co-dominant expression."},{"label":"C","text":"isotypic exclusion."},{"label":"D","text":"nonproductive rearrangement."},{"label":"E","text":"survival of the fittest."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"independent_checked","sourceAnswerTrusted":false,"publicationStatus":"checked_explained","auditFlags":[],"cleaningOperations":[]},{"id":"q-bd84251f1541","stem":"Once they leave the marrow, in order to survive mature naive B cells must enter the","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"circulation"},{"label":"B","text":"lymph microenvironment."},{"label":"C","text":"primary lymphoid follicles."},{"label":"D","text":"secondary lymphoid follicles."},{"label":"E","text":"thymus."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-9807ade68e06","stem":"Negative selection of B cells occurs when","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"immature B cells bind self antigen and undergo apoptosis."},{"label":"B","text":"immature B cells fail to bind self MHC and die."},{"label":"C","text":"lymphoid progenitor cells become committed to becoming T cells and leave the marrow for the thymus."},{"label":"D","text":"mature B cells fail to bind antigen in the lymphoid follicles and die."},{"label":"E","text":"pre-B cells bind ligand with their pre-B receptor and stop rearranging H chain genes."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-768a99f9a5be","stem":"A mature lymphocyte which has specific antigen receptors but cannot respond to that antigen is called","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"anergic."},{"label":"B","text":"apoptotic."},{"label":"C","text":"deleted."},{"label":"D","text":"lazy."},{"label":"E","text":"memory."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ae8dd5b9824b","stem":"Immature B cells which bind soluble self antigen","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"become apoptotic."},{"label":"B","text":"escape clonal deletion and can potentially cause autoimmune disease in adults."},{"label":"C","text":"go on to express normal levels of IgM and IgD but cannot respond to self antigen."},{"label":"D","text":"undergo clonal deletion in the bone marrow."},{"label":"E","text":"usually cannot enter the primary lymphoid follicles and soon die in the periphery."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-000b6d9f4236","stem":"Immature B cells from inbred mouse strain q (expressing the q allele of every MHC molecule: Dq, Kq, Lq, IAq, and IEq) which also express transgenic H and L chains specific for H-2 IAs (the s allele of Class II MHC IA) will undergo clonal deletion when","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"exposed to macrophages from an \"s\" strain mouse (expressing the \"s\" allele of every MHC molecule)."},{"label":"B","text":"exposed to T cells from an s strain mouse."},{"label":"C","text":"exposed to their own macrophages."},{"label":"D","text":"exposed to their own T cells."},{"label":"E","text":"Both 1 and 2 are correct."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-1ab68a661e2f","stem":"Chickens have very few functional V, D, and J gene segments and therefore","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"are very susceptible to disease."},{"label":"B","text":"have many self-specific lymphocytes and usually die of autoimmune disease."},{"label":"C","text":"insert diverse sequences from VH pseudogenes into their H chains while B cells are immature."},{"label":"D","text":"make mature B cells which are all specific for the same antigen."},{"label":"E","text":"use gene conversion to introduce diversity into Ig gene sequences as B cells divide in response to foreign antigen."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a19a35b5926c","stem":"The B cells with the longest life span are the","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"anergized B cells."},{"label":"B","text":"immature B cells."},{"label":"C","text":"mature naive B cells."},{"label":"D","text":"memory cells."},{"label":"E","text":"plasma cells."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-c36de35c6651","stem":"Receptor editing","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"allows self-specific B cells to repeat somatic recombination."},{"label":"B","text":"is responsible for allelic exclusion of Ig on individual B cells."},{"label":"C","text":"kills self-specific B cells before they leave the marrow."},{"label":"D","text":"occurs during the small pro-B cell stage of development."},{"label":"E","text":"occurs only for light chains of self-specific B cells."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-781b193e652a","stem":"The antibody secreted by B-1 B cells often","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"binds common bacterial carbohydrates."},{"label":"B","text":"has a high affinity for antigen."},{"label":"C","text":"is IgG."},{"label":"D","text":"neutralizes common viral receptor proteins."},{"label":"E","text":"neutralizes self antigens."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-667a9d32eb56","stem":"As cells become mature naive B cells, they","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"become more antigen-independent."},{"label":"B","text":"leave the marrow and never return."},{"label":"C","text":"stay in one location and wait for antigen and T cells to come to them."},{"label":"D","text":"stay in the same locations as T cell to be able to receive helper signals."},{"label":"E","text":"use CAMs to enter the appropriate lymphoid organ locations."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e5012fee89b2","stem":"A germinal center is where B cells","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"become mature."},{"label":"B","text":"divide in response to antigen."},{"label":"C","text":"first bind antigen."},{"label":"D","text":"secrete antibody."},{"label":"E","text":"undergo somatic recombination."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-cf08119ea847","stem":"If you wanted to check for the presence of memory B cells from your vaccine subjects by taking some of their B cells and re- stimulating them in vitro (outside the body) with antigen, the best place to get some memory cells would be from","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"blood."},{"label":"B","text":"bone marrow."},{"label":"C","text":"lymph nodes."},{"label":"D","text":"spleen."},{"label":"E","text":"tonsils."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b74fa41aa286","stem":"Multiple myeloma is a cancer which has arisen from a","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"B-1 B cell."},{"label":"B","text":"lymphoid progenitor."},{"label":"C","text":"mature B cell."},{"label":"D","text":"plasma cell."},{"label":"E","text":"pre-B cell."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[],"manualEdits":{}},{"id":"q-05476e35b81d","stem":"If a B cell tumor is monoclonal, it can be differentiated from normal B cells of the same person by its unique membrane Ig","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"allotype."},{"label":"B","text":"H chain."},{"label":"C","text":"idiotype."},{"label":"D","text":"isotype."},{"label":"E","text":"L chain."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a81599f74dc2","stem":"An oncogene is a","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"gene for a virus protein that causes cancer."},{"label":"B","text":"gene for tumor antigens on B cells."},{"label":"C","text":"mutated gene that causes cancer."},{"label":"D","text":"normal gene that can cause cancer if its normal function is disrupted."},{"label":"E","text":"translocated Ig gene. Problems"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-1f5d50eac616","stem":"I have goat anti-rabbit γa and γb, antibodies specific for the \"a\" and \"b\" allotypic determinants on the rabbit γ heavy chain. I also have a rabbit heterozygous for the \"a\" and \"b\" alleles of γ chain. The goat anti- γa is tagged with FITC; the goat anti γb is tagged with PE. How can I prove with these reagents that IgG is allelically excluded on the rabbit's B cells?","type":"Short Answer","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7537cc0884cf","stem":"Cells were removed from the bone marrow of an adult mouse and incubated with FITC-anti mouse μ chain and PE-anti mouse δ chain. Draw the flow cytometric representation of the data. What cell types are in each quadrant of the graph: stem cells, lymphoid progenitors, myeloid progenitors, pro-B cells, pre-B cells, immature B cells, mature B cells, neutrophils, macrophages? What would be the pattern of fluorescence you would see if you stained spleen cells with the same antibodies? Are the kinds of cells in each quadrant the same? HINT: consider all the kinds of leukocytes which are found in the spleen. How would this pattern change if you used mice lacking RAG-1 and RAG-2?","type":"Short Answer","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-17255d202c4c","stem":"Make a line drawing of germline DNA and DNA from an early pro-B cell, a late pro-B cell, a large pre-B cell, and an immature B cell for both H and κ genes. Write a rule that would allow you to identify each of line drawings: • A sequence must be germline H chain DNA if... • A sequence must be H chain DNA in an early pro-B cell if ... • A sequence must be H chain DNA in a late pro-B cell if ... • A sequence must be H chain DNA in an immature B cell if ... • A sequence must be germline L chain DNA if... • A sequence must be L chain DNA in an early pro-B cell if ... • A sequence must be L chain DNA in an late pro-B cell if ... • A sequence must be L chain DNA in an immature B cell if ... Would the sequence be any different in a mature B cell? In a plasma cell secreting IgG1 in the lymph nodes? In a plasma cell secreting IgA2 in the MALT?","type":"Image / Diagram Question","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"review","flags":["requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-5348c0c3c4ed","stem":"Starting with two cell lines from a mouse, one with cytotoxic activity and one with helper activity, how could you prepare and purify a rabbit anti-mouse CD4?","type":"Short Answer","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f169c19cb05c","stem":"T cells differ from B cells by expressing","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"antigen receptor of only one idiotype."},{"label":"B","text":"antigen receptor of only one isotype."},{"label":"C","text":"RAG-1 and RAG-2 during somatic recombination."},{"label":"D","text":"a surrogate chain before somatic recombination of the second receptor chain is complete."},{"label":"E","text":"signal transduction molecules with their antigen receptor."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a0c1f627fa6e","stem":"The step that commits a cell to becoming a T cell is","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"expression of CD4 and CD8."},{"label":"B","text":"expression of CD3."},{"label":"C","text":"migration to the thymus."},{"label":"D","text":"somatic recombination of β chain."},{"label":"E","text":"somatic recombination of α chain."}],"priority":0,"status":"review","flags":["duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["duplicate_option_text","prior_structural_review_flag","repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"a3d10249000e0a78a653139ad36be63785168334"},{"id":"q-cae2b6f9c70e","stem":"The thymic equivalent of the bone marrow stromal cells are the thymic","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"dendritic cells."},{"label":"B","text":"epithelial cells."},{"label":"C","text":"hormones."},{"label":"D","text":"macrophages."},{"label":"E","text":"thymocytes."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f7ac4b5cf731","stem":"Of the cells that enter the thymus, ___% become mature naive T cells.","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"100"},{"label":"B","text":"75"},{"label":"C","text":"50"},{"label":"D","text":"33"},{"label":"E","text":"3"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d9c9b4f4a39e","stem":"Double positive T cells express","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"both αβ and γδ TCR."},{"label":"B","text":"both CD3 and CD4."},{"label":"C","text":"both CD3 and CD8."},{"label":"D","text":"both CD4 and CD8."},{"label":"E","text":"TCR of more than one antigen specificity."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d2ad095ffac8","stem":"A developing T cell has more chances to productively rearrange β chain than a developing B cell has for H chain because","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"if T cells fail to rearrange β, they can rearrange γ chain."},{"label":"B","text":"there are many more Vβ than VH segments."},{"label":"C","text":"T cells have four alleles of each set of β gene segments, while B cells have only two alleles of each set of H chain segments."},{"label":"D","text":"there are two sets of D, J, and C β loci so that if rearrangement at the first locus fails, rearrangement can still occur at the second."},{"label":"E","text":"a developing T cell and developing B cell have exactly the same opportunities for productive rearrangements."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f5e2e737316b","stem":"The surrogate light chain that is expressed with newly rearranged β chain","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"binds self MHC."},{"label":"B","text":"can signal the T cell without CD3."},{"label":"C","text":"is CD44."},{"label":"D","text":"is unique for each developing T cell."},{"label":"E","text":"is pTα chain."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-34d04fc8eabe","stem":"α chains are rearranged","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"after the T cell binds self antigen."},{"label":"B","text":"before γ chains."},{"label":"C","text":"before T cells become CD3+."},{"label":"D","text":"in double negative T cells."},{"label":"E","text":"in double positive T cells."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a858b1874155","stem":"Because individual T cells can rearrange more than one α chain, each cell","type":"Multiple Response","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"can bind multiple antigens."},{"label":"B","text":"can bind both Class I and Class II MHC."},{"label":"C","text":"can participate in both cellular and humoral immunity."},{"label":"D","text":"is not allelically excluded for α chain."},{"label":"E","text":"is not isotypically excluded for α chain"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e17457aabee3","stem":"Cells that have just successfully expressed both α and β chains","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"are called single positive thymocytes because they have a single specificity of TCR on each cell."},{"label":"B","text":"are all committed to becoming either Th or Tc."},{"label":"C","text":"divide rapidly before undergoing positive selection."},{"label":"D","text":"have lower amounts of membrane TCR than mature T cells."},{"label":"E","text":"have only αβ receptors, while mature T cells express αβ and γδ receptors."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ab4ca44b4c9a","stem":"Single positive T cells","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"are either mature Th or mature Tc cells."},{"label":"B","text":"are found only in the thymus."},{"label":"C","text":"are ready to undergo positive selection."},{"label":"D","text":"divide rapidly before leaving the thymus."},{"label":"E","text":"undergo apoptosis if they leave the thymus and encounter foreign antigen."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a09ecea5f8fd","stem":"Most of our T cells are produced when we are","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"asleep."},{"label":"B","text":"less than 12 years old."},{"label":"C","text":"between 12 and 22 years old."},{"label":"D","text":"between 22 and 42 years old."},{"label":"E","text":"making a cellular response."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a3acc021077a","stem":"Nude mice have no","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"B cells."},{"label":"B","text":"clothes."},{"label":"C","text":"RAG-1."},{"label":"D","text":"skin."},{"label":"E","text":"thymic stroma."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7890be7b4f34","stem":"Nude mice would be unable to protect themselves from infection using","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"antibody."},{"label":"B","text":"antigen-specific cytotoxicity."},{"label":"C","text":"complement."},{"label":"D","text":"inflammation."},{"label":"E","text":"natural killer cells."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d1cc01d38619","stem":"To give SCID mice a normal immune system, one would have to","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"inject antibody."},{"label":"B","text":"infuse lymphoid progenitors."},{"label":"C","text":"infuse mature T cells."},{"label":"D","text":"transplant a thymus."},{"label":"E","text":"None of the above would restore a functional immune system to a SCID mouse."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-3c5c13410c04","stem":"The term \"MHC restriction\" refers to the","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"ability of MHC genes to regulate TCR rearrangement."},{"label":"B","text":"inheritance of a limited number of MHC antigens."},{"label":"C","text":"problems associated with allograft rejection."},{"label":"D","text":"requirement for antigen to be recognized in association with MHC molecules."},{"label":"E","text":"requirement for MHC molecules in order to reject grafts"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e11c6ddc3b13","stem":"T cells from an MHCaxb F1 mouse","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"all recognize antigen presented only on MHCa."},{"label":"B","text":"all recognize antigen presented only on MHCb."},{"label":"C","text":"each recognize antigen on both MHCa and MHCb."},{"label":"D","text":"each recognize antigen on either MHCa or MHCb."},{"label":"E","text":"fail to recognize antigen on any MHC except MHCaxb."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a5c163bb8975","stem":"A radiation chimera made by giving bone marrow cells from an MHCaxb mouse to an irradiated MHCa mouse produces T cells that","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"are positively selected on MHCaxb cells in the thymus."},{"label":"B","text":"can only see foreign antigen presented on MHCa APC."},{"label":"C","text":"can only see foreign antigen presented on MHCaxb APC."},{"label":"D","text":"will reject MHCa skin grafts."},{"label":"E","text":"will reject MHCb skin grafts."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-8b21879a94dd","stem":"Positive selection for the production of HLA A7-restricted CD8+ T cells requires all of the following EXCEPT","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"expression of CD8 that binds the invariant part of HLA-A7."},{"label":"B","text":"expression of foreign peptide on HLA- A7."},{"label":"C","text":"expression of HLA -A7 on thymic epithelial cells."},{"label":"D","text":"rearrangement of TCR V gene segments that bind HLA -A7."},{"label":"E","text":"TAP-1 and TAP-2."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-21bf61134013","stem":"Mice which were deficient in H-2M and presented CLIP on all their class II MHC molecules","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"developed autoimmunity."},{"label":"B","text":"failed to produce any CD4+ T cells."},{"label":"C","text":"failed to produce any CD8+ T cells."},{"label":"D","text":"produced CD4+ T cells that could only recognize CLIP presented on syngeneic MHC of normal mice."},{"label":"E","text":"produced CD4+ T cells that could recognize self peptides presented on syngeneic MHC of normal mice."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-90cd4e5f9746","stem":"Which of the following is NOT associated with negative selection?","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Apoptosis of thymocytes."},{"label":"B","text":"Bone-marrow derived APC."},{"label":"C","text":"Recognition of self-MHC molecules."},{"label":"D","text":"Recognition of foreign antigen."},{"label":"E","text":"Self tolerance."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-1913cf9705ba","stem":"Double positive T cells with a transgenic TCR specific for H-Y (male) antigen on self Class I MHC","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"would develop normally because H-Y is a membrane 