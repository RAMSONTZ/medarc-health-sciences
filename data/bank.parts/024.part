:[],"cleaningOperations":[]},{"id":"q-b2e0d2413012","stem":"Reliability of a test is best defined as","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"The extent to which it gives the same result on a repeated administrations in the same circumstances"},{"label":"B","text":"The extent to which the test gives two different results when two different observers interpret results"},{"label":"C","text":"The extent to which the test is correct once the protocol for the test is followed"},{"label":"D","text":"The extent to which the test reliable to the one who is diseased"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-6e7c559bbf4b","stem":"Predictive values id defined as","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"The likely hood of people with disease to test positive"},{"label":"B","text":"The likelihood of that the people with positive test results have the disease"},{"label":"C","text":"The likelihood that the test has high sensitivity"},{"label":"D","text":"The likelihood that the test has high specificity and sensitivity"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a68df835a5b9","stem":"About statistical significance","type":"Single Best Answer MCQ","subject":"Community Health and Public Health","topic":"Epidemiology","topicOriginal":"Epidemiology","subtopic":"Epidemiolog","suggestedTopic":null,"options":[{"label":"A","text":"Is the probability of obtaining a result as extreme or more extreme as that observed even if the null hypothesis is true"},{"label":"B","text":"The probability that the observed result is true and not chance"},{"label":"C","text":"The probability that the risk of disease is truly observed to be true"},{"label":"D","text":"a and c are correct"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Community Health and Public Health","displayTopic":"Epidemiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-67ce2da767c6","stem":"Sampling and sample size","type":"Single Best Answer MCQ","subject":"Biostatistics and Research","topic":"Biostatistics","topicOriginal":"Biostatistics","subtopic":"Statistical Inference","suggestedTopic":null,"options":[{"label":"A","text":"Randomisation is the best way to control bias"},{"label":"B","text":"Randomisation is the best way to control selection bias"},{"label":"C","text":"Representative sample is selected through random sampling technique and is the best way for generalizing the results"},{"label":"D","text":"b and c are most correct"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Biostatistics","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"84ba31928515dc441b0872e3aca0ab6235363e