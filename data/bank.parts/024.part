ceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f82ff86eda8d","stem":"The Order Amoebida has the following parasites except","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Entamoeba coli"},{"label":"B","text":"Entamoeba histolytica."},{"label":"C","text":"Giardia lamblia"},{"label":"D","text":"Acanthamoeba."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b8980b77b51c","stem":"Which of the following is not true of a genus","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Must be underlined or italicized."},{"label":"B","text":"Can be singular of compound."},{"label":"C","text":"Must be a single word."},{"label":"D","text":"Must begin with a capital letter."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-be6e56371b38","stem":"In protozoal infections, the following are not true except","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Generally immune response is non-specific."},{"label":"B","text":"Frequently predispose to opportunistic infections."},{"label":"C","text":"Domestic animals have a role in transmission."},{"label":"D","text":"Non-vector transmission does not take place."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7252eb760cce","stem":"Pathophysiological effects of Plasmodium falcipatum is due to","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Protozoology","topicOriginal":"Protozoology","subtopic":"Malaria","suggestedTopic":null,"options":[{"label":"A","text":"Haemolysis of parasitized erythrocytes."},{"label":"B","text":"Release of cytokines."},{"label":"C","text":"Blockage of capillaries."},{"label":"D","text":"All of the above."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Protozoology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e124158f597a","stem":"In heavy falciparum malaria, blood smear may not show schizonts because","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Protozoology","topicOriginal":"Protozoology","subtopic":"Malaria","suggestedTopic":null,"options":[{"label":"A","text":"Tendency of parasitized erythrocytes to be in deep tissues."},{"label":"B","text":"Parasitization of younger RBCs."},{"label":"C","text":"Suppressive effects of immunity in semi-immunes."},{"label":"D","text":"Use of chemosuppressive drugs."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Protozoology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-4089718b6876","stem":"All of the above are striking features of malaria except","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Protozoology","topicOriginal":"Protozoology","subtopic":"Malaria","suggestedTopic":null,"options":[{"label":"A","text":"Palmar pallor."},{"label":"B","text":"Splenomegaly."},{"label":"C","text":"Liver hypertrophy."},{"label":"D","text":"Capillary occlusions."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Protozoology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-0e2b29372ad1","stem":"Erthrocytic schizogony for Plasmodium falciparum is","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Protozoology","topicOriginal":"Protozoology","subtopic":"Malaria","suggestedTopic":null,"options":[{"label":"A","text":"44-48 hours."},{"label":"B","text":"72 hours."},{"label":"C","text":"16 hours."},{"label":"D","text":"24-44 hours."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Protozoology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-02a1d0e85abc","stem":"The longest prepatent and incubation period is found in","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Plasmodium falciparum."},{"label":"B","text":"Plasmodium malariae."},{"label":"C","text":"Plasmodium ovale."},{"label":"D","text":"Plasmodium vivax."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-bc1ecdd4dfd3","stem":"In the life cycle of trypanosomes, the following ar true except","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Protozoology","topicOriginal":"Protozoology","subtopic":"Trypanosomiasis","suggestedTopic":null,"options":[{"label":"A","text":"Man is infected by tsetse fly bite during a blood meal."},{"label":"B","text":"The infective stages for the vector are the rapidly dividing slender forms."},{"label":"C","text":"The infective stages for the vector are the non-dividing short forms."},{"label":"D","text":"Both male and female tsetse flies take a blood meal."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Protozoology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-136be48d1b24","stem":"In the clinical features of huma African trypanosomiasis, the following are true except","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Protozoology","topicOriginal":"Protozoology","subtopic":"Trypanosomiasis","suggestedTopic":null,"options":[{"label":"A","text":"In Trypanosoma brucei gambiese the first sign is a chancre."},{"label":"B","text":"In Trypanosoma brucei rhodesiense, after the chancre, the Winterbottom’s sign follows."},{"label":"C","text":"For both T.b. gambiense and T.b. rhodesiense, the first stage of the disease is characterized by fever."},{"label":"D","text":"In T.b. rhodensinse, in the first stage of the disease around 10 % of patient may die."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Protozoology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-fff62c8e28cc","stem":"The following statements about human African trypanosomiasis, are true except","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Protozoology","topicOriginal":"Protozoology","subtopic":"Trypanosomiasis","suggestedTopic":null,"options":[{"label":"A","text":"Humans are believe to be the only reservoir of Trypanosoma brucei gambiese."},{"label":"B","text":"Trypanosoma brucei rhodesiense is transmitted by tsetse flies of the Glossina morsitans group."},{"label":"C","text":"Trypanosoma brucei gambiense is an anthroponosis with extensive animal reservoir in wild and domestic animals."},{"label":"D","text":"Trypanosoma brucei rhodesiense is endemic in East Africa."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Protozoology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-81846859cba3","stem":"The following statements about the control of human African trypanosomiasis are true except","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Protozoology","topicOriginal":"Protozoology","subtopic":"Trypanosomiasis","suggestedTopic":null,"options":[{"label":"A","text":"Both active and passive surveillance for patients are carried out."},{"label":"B","text":"In active surveillance patients present themselves actively to the health facility at the acute stage of the disease."},{"label":"C","text":"In Trypanosoma brucei rhodesiense, control of relies on passive case detection at health centre facilities."},{"label":"D","text":"Active surveillance is the feasible strategy for the control of Trypanosoma brucei gambiense."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Protozoology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-737bf943ce49","stem":"In the epidemiology of giardiasis the following are true except","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"In endemic giardiasis children below 5 years of age are 3-4 times more affected than adults."},{"label":"B","text":"Endemic giardiasis is common in rural eareas and is family infection."},{"label":"C","text":"Commonly children excrete large numbers of cysts, while adults excrete a few cysts."},{"label":"D","text":"Epidemic giardiasis is normally food-borne and commoly occurs iat household level."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a2ec61933225","stem":"The following are true regarding the life cycle of Toxoplasma gondii except","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The primary infection occurs in cats."},{"label":"B","text":"Toxoplasma gondii infection is both faecal and meat borne."},{"label":"C","text":"In cats, Toxoplasma gondii undergoes the sexual cycle of development."},{"label":"D","text":"In humans, only the extraintestinal development occurs."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a733e7fbb125","stem":"Regarding human toxoplasmosis, the following statements are true","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Infection occurs through ingestion of sporulated oocysts or tissue cysts."},{"label":"B","text":"Infection occurs via blood products and organ transplant."},{"label":"C","text":"In congenital infection, a live baby may be born and later on develop cerebral toxoplasmosis."},{"label":"D","text":"Majority are symptomatic and a large number of individual have antibodies indicating active toxoplasmosis."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-70baac74d3fa","stem":"Regarding Cryptosporidium and Isospora, the following are true except","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Both are intestinal protozoa."},{"label":"B","text":"Both are opportunistic infections."},{"label":"C","text":"Both are zoonotic infections that can be acquired by calves."},{"label":"D","text":"Both are transmitted faeco-orally."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-4d672e2b28e6","stem":"Red blood cells may be found in the trophozoites of","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Entamoeba histolytica"},{"label":"B","text":"Entamoeba coli"},{"label":"C","text":"Dientamoeba fragilis"},{"label":"D","text":"Entamoeba gingivalis."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a20bfc7deed6","stem":"The following are true regarding Cryptosporidium except","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It is a zoonosis."},{"label":"B","text":"Infective stage is thick-walled oocyst."},{"label":"C","text":"Causes blood stained watery diarrhoea."},{"label":"D","text":"More common in HIV patients."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-0586324ba290","stem":"The symptomatology of intestinal amoebiasis includes all of the fo