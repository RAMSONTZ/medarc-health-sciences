judicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-5e58504935d2","stem":"To detect a humoral immune response to influenza virus, you would measure","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Virology","topicOriginal":"Virology","subtopic":"Viruses","suggestedTopic":null,"options":[{"label":"A","text":"cytotoxicity of virus-infected cells in the lung."},{"label":"B","text":"cytotoxicity of virus-infected cells in tissue culture."},{"label":"C","text":"dividing T cells in the draining lymph nodes."},{"label":"D","text":"plasma cytokine levels."},{"label":"E","text":"serum antibody titer."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Virology","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[],"manualEdits":{}},{"id":"q-9885cf98f62d","stem":"During the lag period between antigen contact and detection of adaptive immunity","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"antigen is hidden from the immune system in macrophages."},{"label":"B","text":"cellular immunity can be detected but antibodies cannot."},{"label":"C","text":"innate immune effectors are eliminating antigen."},{"label":"D","text":"innate immunity blocks the activation of adaptive immune effector cells."},{"label":"E","text":"new B and T cells with the appropriate antigen specificity must be produced in the bone marrow."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditS