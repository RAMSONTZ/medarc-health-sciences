yTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-bdf4800f19ee","stem":"Why can a small cerebellar hematoma be dangerous?","type":"Short Answer","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-cf0c313f267f","stem":"Why is EVD used in IVH?","type":"Short Answer","subject":"Internal Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-cf864973b6eb","stem":"mazepine, 21. Ganciclovir ......T... ...... use is limited to life or site threatening CMV infection in immunocompromised patients ......F... ...... is effective only against Influenza A ......F... ...... Nucleotide reverse transcriptase inhibitor ......T... ...... competes with guanosine triphosphate for incorporation into viral DNA ......T... ...... concomitant use of potential bone marrow depressant drugs should be avoided 22. Angiotensin converting enzyme inhibitor ......... ......reduce preload ......... ......is positive inotrope ......... ......do not cause cough ......... ......no effect on after load ............ ...causes muscles fasiculation 23 Which of the following induces microsomal enzymes ...... T.........Phenobarbitone ......F .........Ethanol ......F .........Diazepam ......F... ......Ketaconazole ......T... ......Nevirapine 24. Tolerance and physiological dependence occur for which of the following?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"ñàÎàÁ¶Áñ¦¶Á¦Áñ–ñ¦ñŠÁñÁñÁñ¦ÁñÁñ¦Á¦Á~rd"},{"label":"B","text":"„0ý^„Ð"},{"label":"C","text":"`„0ýgd3uU"},{"label":"D","text":"„0ý^„Ð"},{"label":"E","text":"`„0ýgd3uU"},{"label":"F","text":"`„0ýgd3uU"}],"priority":1,"status":"review","flags":["topic_generic","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_text","nonunique_option_text","prior_structural_review_flag","topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-819c91178a35","stem":"<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"<a:clrMap xmlns:a=\"http://schemas.openxmlformats.org/drawingml/2006/main\" bg1=\"lt1\" tx1=\"dk1\" bg2=\"lt2\" tx2=\"dk2\" accent1=\"accent1\" accent2=\"accent2\" accent3=\"accent3\" accent4=\"accent4\" accent5=\"accent5\" accent6=\"accent6\" hlink=\"hlink\" folHlink=\"folHlink\"/>"},{"label":"B","text":"*€urn:schemas-microsoft-com:office:smarttags"},{"label":"C","text":"€place"},{"label":"D","text":"*€urn:schemas-microsoft-com:office:smarttags"},{"label":"E","text":"€stockticker"},{"label":"F","text":"!LT%’„dÿ"}],"priority":1,"status":"review","flags":["subject_unclassified","topic_generic","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_text","nonunique_option_text","prior_structural_review_flag","repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"d345471c620f51033193346114ce04085734c807"},{"id":"q-f89ae76b01b2","stem":"<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"<a:clrMap xmlns:a=\"http://schemas.openxmlformats.org/drawingml/2006/main\" bg1=\"lt1\" tx1=\"dk1\" bg2=\"lt2\" tx2=\"dk2\" accent1=\"accent1\" accent2=\"accent2\" accent3=\"accent3\" accent4=\"accent4\" accent5=\"accent5\" accent6=\"accent6\" hlink=\"hlink\" folHlink=\"folHlink\"/>"},{"label":"B","text":"*€urn:schemas-microsoft-com:office:smarttags"},{"label":"C","text":"€stockticker"},{"label":"D","text":"*€urn:schemas-microsoft-com:office:smarttags"},{"label":"E","text":"€place"},{"label":"F","text":"*€urn:schemas-microsoft-com:office:smarttags"}],"priority":1,"status":"review","flags":["subject_unclassified","topic_generic","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_text","nonunique_option_text","prior_structural_review_flag","repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"d345471c620f51033193346114ce04085734c807"},{"id":"q-12eac8552653","stem":"5 mg daily in nucleoside-naïve adults Renal adjustment; higher dose in selected resistant/decompensated cases. Schistosomiasis Praziquantel 40 mg/kg total for S. mansoni in common WHO-style regimens Follow national program/protocol. Dose safety These are educational adult reference doses, not patient-specific prescriptions. Check renal function, weight, pregnancy, local antimicrobial resistance, drug interactions and KCMC/Tanzania protocols. Liver Disease · Master-Level Internal Medicine High-yield liver viva questions with model answers Why does cirrhosis cause ascites? Portal hypertension causes splanchnic vasodilation and reduced effective arterial volume, activating RAAS/SNS/ADH; sodium/water retention plus high portal hydrostatic pressure drives ascites. Why does schistosomiasis cause portal hypertension but preserve liver function initially? Egg-driven granulomas produce periportal/presinusoidal fibrosis and obstruct portal branches, while hepatocyte lobular architecture is relatively preserved compared with cirrhosis. Why does GI bleeding precipitate hepatic encephalopathy? Digested blood creates a large gut nitrogen load, increasing ammonia and other neurotoxins. Why is lactulose useful? It acidifies colonic contents, traps ammonia as ammonium, alters gut flora and increases nitrogen excretion through catharsis.","type":"Clinical Vignette","subject":"Internal Medicine","topic":"Cardiology","topicOriginal":"Cardiology","subtopic":"Hypertension","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Cardiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-8b44512074bf","stem":"Why not restrict protein in HE?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-95c38c9062bf","stem":"Why is INR not a good bleeding-risk test in cirrhosis?","type":"Short Answer","subject":"Internal Medicine","topic":"Gastroenterology and Hepatology","topicOriginal":"Gastroenterology and Hepatology","subtopic":"Cirrhosis","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Gastroenterology and Hepatology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-27acd0498dc8","stem":"Why albumin after large-volume paracentesis?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-1d4cd2435128","stem":"Why is octreotide given before endoscopy in variceal hemorrhage?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-3007e88ca39c","stem":"4 Research Question What is the knowledge and practice in preventing osteoporosis among post menopausal women?","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-10906c0f8014","stem":"which of the following are 2 surgically correctable forms of hypertension?","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Cardiology","topicOriginal":"Cardiology","subtopic":"Hypertension","suggestedTopic":null,"options":[{"label":"A","text":"Pheochromocytoma and idiopathic hyperaldosteronism"},{"label":"B","text":"Aldosterone-producing adenoma and Cushing syndrome"},{"label":"C","text":"Pheochromocytoma and Aldosterone-producing adenoma"},{"label":"D","text":"Addisons disease and virilizing syndromes"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Inte