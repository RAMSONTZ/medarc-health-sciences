icrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Cardiotonic action"},{"label":"B","text":"Pharmacokinetic properties"},{"label":"C","text":"Toxic properties"},{"label":"D","text":"All of the above"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f691e4db73f5","stem":"Aglycone is essential for","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Plasma protein binding"},{"label":"B","text":"Half-life"},{"label":"C","text":"Cardiotonic action"},{"label":"D","text":"Metabolism"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-1d1bac65f354","stem":"Choose the derivative of the plant Foxglove (Digitalis)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Digoxin"},{"label":"B","text":"Strophantin K"},{"label":"C","text":"Dobutamine"},{"label":"D","text":"Amrinone"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-4720726873ad","stem":"All of the following statements regarding cardiac glycosides are true EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"They inhibit the Na+/K+-ATPase and thereby increase intracellular Ca++ in myocardial cells"},{"label":"B","text":"They cause a decrease in vagal tone"},{"label":"C","text":"Children tolerate higher doses of digitalis than do adults"},{"label":"D","text":"The most frequent cause of digitalis intoxication is concurrent administration of diuretics that deplete K+"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"b638eb59db241072543de0dace82b82dd371856c"},{"id":"q-c48884f89196","stem":"An important action of digitalis is to increase vagal tone. It’s","type":"True / False","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-649eac2b050f","stem":"Digoxin is thought to increase intracellular concentrations of calcium in myocardial cells by indirectly slowing the action of the sodium-calcium exchanger. This consideration is","type":"True / False","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-909247dc3974","stem":"Compare the half-life of digoxin and the half-life of digitoxin","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Digoxin is greater than digitoxin"},{"label":"B","text":"Digitoxin is greater than digoxin"}],"priority":1,"status":"review","flags":["mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag"],"cleaningOperations":[]},{"id":"q-7fcfae9f132e","stem":"All of the following statements regarding cardiac glycosides are true EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"They inhibit the activity of the Na+/K+-ATPase"},{"label":"B","text":"They decrease intracellular concentrations of calcium in myocytes"},{"label":"C","text":"They increase vagal tone"},{"label":"D","text":"They have a very low therapeutic index"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","display