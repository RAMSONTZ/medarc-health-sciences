ified","topic_generic"],"cleaningOperations":[]},{"id":"q-bc4306349031","stem":"Who stated that leadership is \"a process of one individual influencing another individual or group to achieve particular objectives\"? • A) Chester Barnard • B) Peter Drucker • C) Douglas McGregor • D) Suzan Komives and colleagues • ) Suzan Komives and colleagues","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-9e41b5dc068b","stem":"In which leadership style do subordinates participate in the decision-making process? • A) Autocratic • B) Democratic • C) Laissez-faire • D) Bureaucratic • ) Democratic","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-5c733739b952","stem":"Who stated that leadership is \"the one who guides and directs other people\"? • A) Henri Fayol • B) Peter Drucker • C) Mary Parker Follett • D) Allen • ) Allen","type":"Short Answer","subject":"Un