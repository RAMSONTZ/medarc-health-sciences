iology","topicOriginal":"Cardiology","subtopic":"Heart","suggestedTopic":null,"options":[{"label":"A","text":"A cardiac lesion that impairs cardiac output"},{"label":"B","text":"An increase in peripheral vascular resistance"},{"label":"C","text":"A decrease in preload"},{"label":"D","text":"An increase in sodium and water retention"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Cardiology","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-17e8a40a7533","stem":"All of the following are compensatory mechanisms that occur during the pathogenesis of congestive heart failure EXCEPT","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Cardiology","topicOriginal":"Cardiology","subtopic":"Heart","suggestedTopic":null,"options":[{"label":"A","text":"An increase in ventricular end-diastolic volume"},{"label":"B","text":"An increase in the concentration of plasma catecholamines"},{"label":"C","text":"An increase in vagal tone"},{"label":"D","text":"Increased activity of the renin-angiotensin-aldosterone system"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Cardiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d22c39ad45bb","stem":"All of the following are recommended at the initial stages of treating patients with heart failure EXCEPT","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Cardiology","topicOriginal":"Cardiology","subtopic":"Heart","suggestedTopic":null,"options":[{"label":"A","text":"Reduced salt intake"},{"label":"B","text":"Verapamil"},{"label":"C"