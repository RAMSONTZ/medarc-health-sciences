rology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Clonazepam"},{"label":"B","text":"Carbamazepine"},{"label":"C","text":"Phenytoin"},{"label":"D","text":"Primidone"},{"label":"E","text":"Levodopa"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b451b8e63010","stem":"K+ ion channels sensitive to intracellular ATP, i.e. K+ ATP channels","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Are found in pancreatic beta islet cells and are activated by glibenclamide"},{"label":"B","text":"Are found on vascular smooth muscle and are blocked by diazoxide"},{"label":"C","text":"Control K+ entry into the cells"},{"label":"D","text":"Are opened by cromakalim to cause hyperpolarisation"},{"label":"E","text":"Are not found in the myocardium"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7bd2bf69eb88","stem":"Which of the following statements about angiotensin II is correct","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It causes a profound fall in blood pressure resulting in shock"},{"label":"B","text":"It constricts blood 