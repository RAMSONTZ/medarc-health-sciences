7e679c5","stem":"14 Intradermal drug sensitivity tests can detect the pres- ence of following type of hypersensitivity","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Type I (anaphylactic)"},{"label":"B","text":"Type II (cytolytic)"},{"label":"C","text":"Type III (retarded)"},{"label":"D","text":"All of the above (p. 64)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-efa69ebce7ef","stem":"15 An addicting drug which produces little or no physical dependence is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Diazepam"},{"label":"B","text":"Phenobarbitone"},{"label":"C","text":"Amphetamine"},{"label":"D","text":"Methadone (p. 65, 113)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"637e086042a609bd4f355fd5bb1b5a9a5dafd335"},{"id":"q-99547f5c2ea8","stem":"16 The essential feature in drug addiction is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Physical dependence"},{"label":"B","text":"Psychological dependence"},{"label":"C","text":"Both physical and psychological dependence"},{"label":"D","text":"Psychiatric abnormality (p. 65)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-79a6834d6095","stem":"17 Adaptive neurophysiological changes produced by repeated administration of a drug, which result in the appearance of characteristic withdrawal syndrome on discontinuation of the drug is called","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Drug addiction"},{"label":"B","text":"Drug abuse"},{"label":"C","text":"Psychological dependence"},{"label":"D","text":"Physical dependence (p. 65)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b41dc0f2da61","stem":"18 Which of the following constitutes ‘drug abuse’","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Physician prescribed use of penicillin G for the cure of viral fever"},{"label":"B","text":"Self administration of aspirin to relieve headache"},{"label":"C","text":"Repeated self administration of morphine to derive euphoria"},{"label":"D","text":"All of the above (p. 65)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2c266f1552c3","stem":"19 ‘Addiction’ and ‘habituation’","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Are fundamentally different phenomena"},{"label":"B","text":"Are produced by different set of drugs/substances"},{"label":"C","text":"Differ from one another by the presence or absence of physical dependence"},{"label":"D","text":"Differ from each other in the degree of attendant psychological dependence (p. 65)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"ea9087cb1f8b7bcb63300fe0a2129379639dd1f6"},{"id":"q-da9f8e8489a6","stem":"20 Adverse consequences may follow sudden discon- tinuation of the following drug after chronic intake","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cocaine"},{"label":"B","text":"Cannabis"},{"label":"C","text":"Clonidine"},{"label":"D","text":"All of the above (p. 65, 510)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-47603b5bb7fe","stem":"21 The most vulnerable period of pregnancy for the causation of foetal malformations due to drugs is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"18-55 days of gestation"},{"label":"B","text":"56-84 days of gestation"},{"label":"C","text":"Second trimester"},{"label":"D","text":"36 weeks onwards (p. 65)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ccc33b373d90","stem":"22 The following is a proven human teratogen","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Chloroquine"},{"label":"B","text":"Warfarin sodium"},{"label":"C","text":"Dicyclomine"},{"label":"D","text":"Methyldopa (p. 66, 517, 601, 740)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-460c26f14260","stem":"23 Select the drug which has been found to be a strong human teratogen","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Isoniazid"},{"label":"B","text":"Isotretinoin"},{"label":"C","text":"Hydralazine"},{"label":"D","text":"Propylthiouracil (p. 66, 232, 512, 707, 801)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"6dcaacd2f79977e4fb197002cf39d8dfe7afafe0"},{"id":"q-30dacb72f181","stem":"1 Which of the following organs is innervated only by parasympathetic nerves","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Upper Limb","topicOriginal":"Upper Limb","subtopic":"Arm","suggestedTopic":null,"options":[{"label":"A","text":"Iris muscles"},{"label":"B","text":"Ciliary muscle"},{"label":"C","text":"Sweat glands"},{"label":"D","text":"Splenic capsule (p. 72)"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Upper Limb","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-1a165cf8b6ca","stem":"2 The sympathetic and parasympathetic systems exert functionally opposite influences on the following para- meters except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology","topicOriginal":"Autonomic Pharmacology","subtopic":"Sympathetic","suggestedTopic":null,"options":[{"label":"A","text":"Heart rate"},{"label":"B","text":"Atrial refractory period"},{"label":"C","text":"Pupil diameter"},{"label":"D","text":"Intestinal motility (p. 72)"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7338d40a3fed","stem":"3 Tetrodotoxin blocks nerve impulse/junctional trans- mission by","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Upper Limb","topicOriginal":"Upper Limb","subtopic":"Arm","suggestedTopic":null,"options":[{"label":"A","text":"Anticholinergic action"},{"label":"B","text":"Depleting acetylcholine"},{"label":"C","text":"Blocking Na+ channels"},{"label":"D","text":"Blocking Ca2+ channels"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Upper Limb","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"4a9ff8d55e233ea16cd6b939c79efc73a0ab9495","manualEdits":{"sourceStem":"3 Tetrodotoxin blocks nerve impulse/junctional trans- mission by","sourceOptions":[{"label":"A","text":"Anticholinergic action"},{"label":"B","text":"Depleting acetylcholine"},{"label":"C","text":"Blocking Na+ channels"},{"label":"D","text":"Blocking Ca2+ channels (p. 74)"}]}},{"id":"q-b898ac771f7f","stem":"4 The cotransmitter may serve the following function/ functions","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Regulate the release of the primary trans- mitter from the nerve ending"},{"label":"B","text":"Alter postjunctional action of the primary transmitter"},{"label":"C","text":"Itself act as an alternative transmitter"},{"label":"D","text":"All of the above (p. 75)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f59e3f006d5e","stem":"5 The following cotransmitter is most probably involved in mediating nonadrenergic noncholinergic (NANC) relaxation of the gut","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology","topicOriginal":"Autonomic Pharmacology","subtopic":"Adrenergic","suggestedTopic":null,"options":[{"label":"A","text":"Neuropeptide Y (NPY)"},{"label":"B","text":"Adenosine"},{"label":"C","text":"Nitric oxide (NO)"},{"label":"D","text":"Kallidin (p. 75, 603)"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d4029d9d683b","stem":"1 The major postjunctional cholinergic receptor is of the muscarinic type at the following site","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Postganglionic parasympathetic"},{"label":"B","text":"Adrenal medulla"},{"label":"C","text":"Autonomic ganglia"},{"label":"D","text":"Neuromuscular junction (p. 77)"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-c399f21e650c","stem":"2 Pseudocholinesterase differs from true cholinesterase in that","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It does not hydrolyse acetylcholine"},{"label":"B","text":"It hydrolyses acetylcholine at a slower rate"},{"label":"C","text":"It is more susceptible to inhibition by physo- stigmine"},{"label":"D","text":"It is the only form of circulating cholinesterase (p. 78)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c5518643fa90","stem":"3 The choline ester resistant to both true and pseudo- cholinesterase is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Methacholine"},{"label":"B","text":"Bethanechol"},{"label":"C","text":"Benzoylcholine"},{"label":"D","text":"Butyrylcholine (p. 78, 80) 55555 ..... 44444 D 55555 ..... 55555 C 66666 ..... 11111 A 66666 ..... 22222 B 66666 ..... 33333 B 3232323232 MCQs in Pharmacology"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"8bacb64f6a7328d0b19f0c10f5edb21d59bebc78"},{"id":"q-e4c9b2424f49","stem":"4 Muscarinic cholinergic receptors","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Are located only on parasympathetically innervated effector cells"},{"label":"B","text":"Mediate responses by opening an intrinsic Na+ ion channel"},{"label":"C","text":"Are present on vascular endothelium which has no cholinergic nerve supply"},{"label":"D","text":"Predominate in the autonomic ganglia (p. 77, 78)"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-8c333e7a202e","stem":"5 The cardiac muscarinic receptors","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Are of the M1 subtype"},{"label":"B","text":"Are of the M2 subtype"},{"label":"C","text":"Are selectively blocked by pirenzepine"},{"label":"D","text":"Function through the PIP2 → IP3/DAG path- way (p. 78)"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-762bd97757bd","stem":"6 Cholinergic muscarinic receptor stimulation produces the following effects except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Sweating"},{"label":"B","text":"Rise in blood pressure"},{"label":"C","text":"Bradycardia"},{"label":"D","text":"Urination (p. 80)"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-43b4165ea684","stem":"7 The smooth muscle structure that is relaxed by choli- nergic drugs is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Colon"},{"label":"B","text":"Gastric fundus"},{"label":"C","text":"Major bronchi"},{"label":"D","text":"Bladder trigone (p. 80)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2a7373e91f08","stem":"8 Which of the following secretions is not stimulated by acetylcholine","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Autonomic Pharmacology","options":[{"label":"A","text":"Tear"},{"label":"B","text":"Bile"},{"label":"C","text":"Pancreatic juice"},{"label":"D","text":"Sweat (p. 80)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"6c4ed4da8b5de8856de064b9b0f8a9b663d1f298"},{"id":"q-25db8de8b3bc","stem":"9 Acetylcholine has no therapeutic application because","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Autonomic Pharmacology","options":[{"label":"A","text":"None of its actions are beneficial in any condition"},{"label":"B","text":"Its effects are transient"},{"label":"C","text":"It produces wide spread actions affecting many organs"},{"label":"D","text":"Both ‘B’ and ‘C’ are correct (p. 80)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3f10acde286b","stem":"10 Pilocarpine is used for","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Glaucoma"},{"label":"B","text":"Paralytic ileus"},{"label":"C","text":"Urinary retention"},{"label":"D","text":"All of the above (p. 81)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-de59449e282d","stem":"11 Actions of pilocarpine include the following except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Sweating"},{"label":"B","text":"Salivation"},{"label":"C","text":"Miosis"},{"label":"D","text":"Cycloplegia (p. 81)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9c2bc55666ed","stem":"12 The following inhibitor binds only to the ani-onic site of the cholinesterase enzyme","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Proteins and Enzymes","topicOriginal":"Proteins and Enzymes","subtopic":"Enzyme","suggestedTopic":null,"options":[{"label":"A","text":"Neostigmine"},{"label":"B","text":"Physostigmine"},{"label":"C","text":"Edrophonium"},{"label":"D","text":"Dyflos (p. 83)"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Proteins and Enzymes","answerAuditStatus":"independent_provisional_reasoning","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-d4dc7c39650e","stem":"13 Reactivation of cholinesterase enzyme occurs on hydrolysis of the inhibitor by the same enzyme mole- cule in case of the following anticholinesterase","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Proteins and Enzymes","topicOriginal":"Proteins and Enzymes","subtopic":"Enzyme","suggestedTopic":null,"options":[{"label":"A","text":"Edrophonium"},{"label":"B","text":"Neostigmine"},{"label":"C","text":"Dyflos"},{"label":"D","text":"Tacrine (p. 83)"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Proteins and Enzymes","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"7e2af531db38b31450366126702ef9b17de9f1fc"},{"id":"q-7215d22f3f20","stem":"14 The anticholinesterase action of edrophonium is short lasting because termination of its action depends on","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Dissociation and diffusion of the drug from the enzyme"},{"label":"B","text":"Hydrolysis of the drug by the enzyme"},{"label":"C","text":"Synthesis of fresh enzyme molecules"},{"label":"D","text":"A combination of the above three processes (p. 83)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-12a935baf028","stem":"15 The organophosphates produce irreversible inhibition of cholinesterase because","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"They bind to an allosteric site of the enzyme resulting in unfavourable conformation of este- ratic site to bind acetylcholine"},{"label":"B","text":"Regeneration time of the phosphorylated enzyme is longer than the turnover time of the enzyme molecules"},{"label":"C","text":"Phosphorylation results in rapid degradation of enzyme molecules"},{"label":"D","text":"They are neither metabolized nor excreted from the body (p. 83)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a1b0198d89eb","stem":"16 Out of two anticholinesterases, drug ‘X’ is a tertiary amine while drug ‘Y’ is a quarternary ammonium com- pound. Then","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Drug ‘X’ is likely to be more potent than ‘Y’"},{"label":"B","text":"Drug ‘X’ will be more suitable to be used as a miotic"},{"label":"C","text":"Drug ‘Y’ will be completely metabolized in the body"},{"label":"D","text":"Drug ‘Y’ will produce CNS effects (p. 84)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"8ac01c14f6ee6897c76e0a52e97b7175eca1ad18"},{"id":"q-8a074098cd9e","stem":"17 Neostigmine is preferred over physostigmine for treat- ing myasthenia gravis because","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It is better absorbed orally"},{"label":"B","text":"It has longer duration of action"},{"label":"C","text":"It has additional direct agonistic action on nicotinic receptors at the muscle end plate"},{"label":"D","text":"It penetrates blood-brain barrier (p. 84, 89)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-383835d8039e","stem":"18 The mechanism by which neostigmine improves con- traction of myasthenic muscle involves","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Upper Limb","topicOriginal":"Upper Limb","subtopic":"Arm","suggestedTopic":null,"options":[{"label":"A","text":"Repetitive binding of the acetylcholine mole- cules to the same receptors at the muscle end- plate"},{"label":"B","text":"Diffusion of acetylcholine released from motor nerve endings to a wider area activating neigh- bouring receptors"},{"label":"C","text":"Activation of motor end-plate receptors by neostigmine molecules themselves"},{"label":"D","text":"All of the above (p. 89)"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Upper Limb","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-54a166f6bfec","stem":"19 Pyridostigmine differs from neostigmine in that","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It is more potent orally"},{"label":"B","text":"It is longer acting"},{"label":"C","text":"It produces less muscarinic side effects"},{"label":"D","text":"It does not have any direct action on NM receptors (p. 84)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-85d9a77d69ff","stem":"20 Edrophonium is more suitable for differentiating myas- thenic crisis from cholinergic crisis because of its","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology","topicOriginal":"Autonomic Pharmacology","subtopic":"Cholinergic","suggestedTopic":null,"options":[{"label":"A","text":"Shorter duration of action"},{"label":"B","text":"Longer duration of action"},{"label":"C","text":"Direct action on muscle end-plate"},{"label":"D","text":"Selective inhibition of true cholinesterase (p. 84, 90)"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"c82f913575d3db1a3e75866157847a718c2e0669"},{"id":"q-68696207f450","stem":"21 Which of the following is a relatively cerebroselective anticholinesterase found to afford symptomatic improvement in Alzheimer's disease","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Donepezil"},{"label":"B","text":"Gemfibrozil"},{"label":"C","text":"Pyridostigmine"},{"label":"D","text":"Pyritinol (p. 84-85, 439)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b3240af98d0c","stem":"22 Pilocarpine reduces intraocular tension in open angle glaucoma by","type":"Single Best Answer MCQ","subject":"Ophthalmology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Contracting sphincter pupillae"},{"label":"B","text":"Increasing tone of ciliary muscle"},{"label":"C","text":"Reducing aqueous formation"},{"label":"D","text":"Enhancing uveo-scleral outflow (p. 87)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Ophthalmology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-862d184ee7b4","stem":"23 The site of action of miotics for therapeutic effect in angle closure glaucoma is","type":"Single Best Answer MCQ","subject":"Ophthalmology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Canal of Schlemm"},{"label":"B","text":"Ciliary body"},{"label":"C","text":"Ciliary muscle"},{"label":"D","text":"Sphincter pupillae muscle (p. 89)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Ophthalmology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3e84d63daa61","stem":"24 Currently, the first choice drug for open angle glaucoma is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Miotic eye drops"},{"label":"B","text":"Ocular α2 adrenergic agonists"},{"label":"C","text":"Ocular prostaglandin analogues"},{"label":"D","text":"Ocular β adrenergic blockers (p. 85, 88)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"n