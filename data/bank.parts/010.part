,{"id":"q-cc8a61f1c78b","stem":"22 The most important risk in the use of sumatriptan for treatment of migraine is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Precipitation of seizures"},{"label":"B","text":"Precipitation of psychosis"},{"label":"C","text":"Development of hypertension"},{"label":"D","text":"Coronary vasospasm (p. 154)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"4dbd721a24cd70f9d82a43ce4103fce530985969"},{"id":"q-866da2d0dc0e","stem":"23 Choose the correct statement about sumatriptan","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It activates serotonergic neurones in raphe nuclei"},{"label":"B","text":"It tends to suppress both pain and vomiting in migraine"},{"label":"C","text":"It does not carry risk of precipitating coro- nary vasospasm"},{"label":"D","text":"It is combined with ergotamine for treatment of severe migraine (p. 153)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-33fa1cec738b","stem":"24 Which of the following drugs is most commonly used for prophylaxis of migraine","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ergotamine"},{"label":"B","text":"Propranolol"},{"label":"C","text":"Methysergide"},{"label":"D","text":"Sumatriptan (p. 154)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0cfe4e82ec9c","stem":"25 Select the β blocker which does not afford prophylaxis in migraine","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Propranolol"},{"label":"B","text":"Timolol"},{"label":"C","text":"Atenolol"},{"label":"D","text":"Pindolol (p. 154)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a3fe7e639e31","stem":"26 Prophylactic therapy of migraine","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Is recommended in all cases"},{"label":"B","text":"Benefits upto 70% patients of moderate to severe migraine"},{"label":"C","text":"Needs to be continued lifelong without inter- ruption"},{"label":"D","text":"Reduces the severity but increases the frequency of migraine attacks (p. 154)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"d51b6627b56a598b03d06d64b2ca9182d2e70fdd"},{"id":"q-57f0e1e4b767","stem":"27 The calcium channel blocker used for prophylaxis of migraine but not for angina pectoris is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Verapamil"},{"label":"B","text":"Diltiazem"},{"label":"C","text":"Flunarizine"},{"label":"D","text":"Amlodipine (p. 154)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f96a822885b6","stem":"1 The following eicosanoid is generated through the lipoxygenase pathway","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Prostaglandin E2"},{"label":"B","text":"Thromboxane A2"},{"label":"C","text":"Leukotriene C4"},{"label":"D","text":"Prostacyclin (p. 157)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-de6ddf4e7a4f","stem":"2 There are no preformed stores of the following autacoid/autacoids","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Prostaglandins"},{"label":"B","text":"Leukotrienes"},{"label":"C","text":"Angiotensin II"},{"label":"D","text":"All of the above (p. 157, 445)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-be2ac2b893bb","stem":"3 The cyclooxygenase isoenzymes COX-1 and COX-2 differ from each other in that","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Proteins and Enzymes","topicOriginal":"Proteins and Enzymes","subtopic":"Enzyme","suggestedTopic":null,"options":[{"label":"A","text":"They catalyse different pathways in prosta- noid biosynthesis"},{"label":"B","text":"COX-1 is inhibited by aspirin but not COX-2"},{"label":"C","text":"COX-2 is inhibited by ibuprofen but not COX-1"},{"label":"D","text":"COX-1 is constitutive while COX-2 is largely inducible (p. 157-158)"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Proteins and Enzymes","answerAuditStatus":"independently_reasoned_provisional_oct20","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-a85a45df5c49","stem":"4 Which of the following is an irreversible inhibitor of cyclooxygenase","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Aspirin"},{"label":"B","text":"Phenylbutazone"},{"label":"C","text":"Indomethacin"},{"label":"D","text":"Piroxicam (p. 158)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"f6b630ac320360e9d08e19ee874ddf174d7954b2"},{"id":"q-6938b2ae4ec2","stem":"5 The prostanoid that consistently constricts blood vessels is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Prostaglandin E2"},{"label":"B","text":"Prostaglandin F2α"},{"label":"C","text":"Thromboxane A2"},{"label":"D","text":"Prostacyclin (p. 159, 160)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d5c2aeb538b5","stem":"6 Dysmenorrhoea is often associated with excess production of the following autacoid by the endo- metrium","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Bradykinin"},{"label":"B","text":"Prostaglandin"},{"label":"C","text":"Platelet activating factor"},{"label":"D","text":"5-Hydroxytryptamine (p. 159, 169)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8c70f211fdfb","stem":"7 Actions of prostaglandin E2 include the following except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Fall in blood pressure"},{"label":"B","text":"Bronchoconstriction"},{"label":"C","text":"Uterine contraction"},{"label":"D","text":"Inhibition of gastric acid secretion (p. 159, 160)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f49ac4d22e0e","stem":"8 The following prostanoid is a potent inducer of platelet aggregation","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Prostacyclin"},{"label":"B","text":"Prostaglandin E2"},{"label":"C","text":"Prostaglandin D2"},{"label":"D","text":"Thromboxane A2 (p. 159, 160)"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e1d9bd016d7b","stem":"9 Prostaglandins play pathophysiological role in the following except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Patency of ductus arteriosus"},{"label":"B","text":"Regulation of renal tubular salt absorption"},{"label":"C","text":"Ventricular remodeling after myocardial infarction"},{"label":"D","text":"Initiation of labour (p. 159-161, 446)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"c6e953f51f88a784b2d226f2e82f31af2da71ccd"},{"id":"q-3bc0c516c7f8","stem":"10 Low doses of aspirin prolong bleeding time by selec- tively inhibiting synthesis of the following mediator in the platelets","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Thromboxane A2"},{"label":"B","text":"5-Hydroxytryptamine"},{"label":"C","text":"Platelet activating factor"},{"label":"D","text":"Prostacyclin (p. 159)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8b880a113a83","stem":"11 Aspirin in low doses produces longlasting inhibition of platelet cyclooxygenase (COX) because","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Platelets contain low quantity of COX"},{"label":"B","text":"Platelets cannot synthesize fresh COX mole- cules"},{"label":"C","text":"Platelets bind aspirin with high