ject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Atropine"},{"label":"B","text":"Hyoscine"},{"label":"C","text":"Homatropine"},{"label":"D","text":"Cyclopentolate (p. 98, 99)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-933241f911bc","stem":"16 Choose the correct statement about drotaverine","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It is a smooth muscle antispasmodic acting by non-anticholinergic mechanisms"},{"label":"B","text":"It is a papaverine congener used in peripheral vascular diseases"},{"label":"C","text":"It is a synthetic atropine substitute used to control diarrhoea"},{"label":"D","text":"It is a M1/M3 selective antagonist used for spastic constipation (p. 98)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"77a1081b0102820ebad8b9ca4ae611a86889fb93"},{"id":"q-6110f7d96455","stem":"17 The most effective antidote for belladonna poisoning is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Neostigmine"},{"label":"B","text":"Physostigmine"},{"label":"C","text":"Pilocarpine"},{"label":"D","text":"Methacholine (p. 100)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-26558b71c000","stem":"18 Atropine is contraindicated in","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Autonomic Pharmacology","options":[{"label":"A","text":"Pulmonary embolism"},{"label":"B","text":"Digitalis toxicity"},{"label":"C","text":"Iridocyclitis"},{"label":"D","text":"Raised intraocular tension (p. 100)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-bc935ea556d2","stem":"19 Choose the correct statement about nicotine","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It selectively stimulates parasympathetic gan- glia"},{"label":"B","text":"It has no clinical application"},{"label":"C","text":"It is used as an aid during smoking cessation"},{"label":"D","text":"It is used in Alzheimer's disease (p. 101)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAns