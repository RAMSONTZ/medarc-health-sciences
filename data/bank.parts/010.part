opic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-44a980dfc569","stem":"24 Which of the following statements most closely reflects the current status of estrogens in post- menopausal women","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Estrogens should be prescribed routinely to all menopausal women"},{"label":"B","text":"Estrogens should be prescribed when menopausal symptoms are severe"},{"label":"C","text":"Estrogens should be prescribed only when there is radiological evidence of osteoporosis"},{"label":"D","text":"Estrogens should be prescribed along with a progestin after considering risk:benefit ratio in individual patients (p. 276-277)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"333e8bf1043418e545feb3d91fbe85e9270404b2"},{"id":"q-8c6e4b39d841","stem":"25 Estrogen therapy can worsen the following asso- ciated conditions except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Migraine"},{"label":"B","text":"Cholelithiasis"},{"label":"C","text":"Acne vulgaris"},{"label":"D","text":"Endometriosis (p. 276)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-94bb7604e99f","stem":"26 Addition of a progestin for 10-12 days each month to estrogen replacement therapy in menopausal women is recommended because the progestin","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Blocks the increased risk of myocardial infarction due to estrogen"},{"label":"B","text":"Blocks the increased risk of endometrial carcinoma due to estrogen"},{"label":"C","text":"Reverses vulval atrophy occurring in post- menopausal women"},{"label":"D","text":"Enhances the metabolic benefits of estrogen treatment (p. 277)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9117e6d8e728","stem":"27 The estrogen commonly used for hormone replace- ment therapy in menopausal women is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ethinylestradiol"},{"label":"B","text":"Estradiol benzoate"},{"label":"C","text":"Diethylstilbestrol"},{"label":"D","text":"Conjugated estrogens (p. 277)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-51a07d13eb83","stem":"28 The daily dose of estrogen for hormone replacement therapy in postmenopausal women is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Same as for contraception"},{"label":"B","text":"Higher than that for contraception"},{"label":"C","text":"Lower than that for contraception"},{"label":"D","text":"Variable depending on the age of the woman (p. 277)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"5b59ca555a928b9c394b67963ddca69101658748"},{"id":"q-f64fd6ec50f1","stem":"29 Select the compound which used for hormone rep- lacement therapy in postmenopausal women serves the purpose of both estrogen and progestin with weak androgenic activity","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Tibolone"},{"label":"B","text":"Mestranol"},{"label":"C","text":"Desogestrel"},{"label":"D","text":"Gestodene (p. 277)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e8bc2e0e7047","stem":"30 Select the correct statement about tibolone","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It is an antiestrogen used for palliative treat- ment of carcinoma breast"},{"label":"B","text":"It is an estrogenic + progestational steroid used for hormone replacement therapy in postmenopausal women"},{"label":"C","text":"It is an antiandrogen used for male pattern baldness"},{"label":"D","text":"It is a nonsteroidal estrogen used topically for senile vaginitis (p. 277)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a0b6943d6b1f","stem":"31 Estrogens are palliative in the following malignancy","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Carcinoma breast"},{"label":"B","text":"Carcinoma cervix"},{"label":"C","text":"Endometrial carcinoma"},{"label":"D","text":"Carcinoma prostate (p. 278)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7e9d9afa0f09","stem":"32 Estrogen replacement therapy for postmenopausal women is contraindicated in subjects with","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Leg vein thrombosis"},{"label":"B","text":"Undiagnosed vaginal bleeding"},{"label":"C","text":"Migraine"