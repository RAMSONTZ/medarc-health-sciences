ons":[],"duplicateStemGroup":"d69543814ffde741799285ada01d239459e214cc"},{"id":"q-c0fb1153af54","stem":"18 A patient of chronic bronchial asthma maintained on oral prednisolone 20 mg daily and inhaled salbuta- mol as required develops chest infection. Which of the following measures is recommended","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Respiratory Medicine","topicOriginal":"Respiratory Medicine","subtopic":"Asthma","suggestedTopic":null,"options":[{"label":"A","text":"Stop prednisolone"},{"label":"B","text":"Reduce prednisolone dose to 5 mg/day"},{"label":"C","text":"No change/increase in prednisolone dose"},{"label":"D","text":"Substitute prednisolone with inhaled bude- sonide (p. 262)"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Respiratory Medicine","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-96df9bad8d3a","stem":"19 Corticosteroid therapy is practically mandatory in the following condition","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Septic shock"},{"label":"B","text":"Renal transplant"},{"label":"C","text":"Rheumatoid arthritis"},{"label":"D","text":"Ulcerative colitis (p. 262-264, 789)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c6edffea4d4e","stem":"20 For limiting cerebral edema due to brain tumour, the preferred corticosteroids are betamethasone/dexa- methasone because","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"They do not cause Na+ and water retention"},{"label":"B","text":"They are more potent"},{"label":"C","text":"They can be administered intravenously"},{"label":"D","text":"They inhibit brain tumours (p. 263)"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e2142d0be99b","stem":"21 Along with effective antimicrobial therapy, cortico- steroids are indicated in the following infective conditions except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antimicrobial","suggestedTopic":null,"options":[{"label":"A","text":"Tubercular meningitis"},{"label":"B","text":"Severe P. carinii pneumonia in AIDS patient"},{"label":"C","text":"Herpes simplex keratitis"},{"label":"D","text":"Erythema nodosum leprosum (p. 263, 714)"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-fd6c1a8782a3","stem":"22 Systemic corticosteroid therapy is not used routi- nely and is reserved only for severe cases of","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Exfoliative dermatitis"},{"label":"B","text":"Posterior uveitis"},{"label":"C","text":"Acute rheumatic fever"},{"label":"D","text":"Hodgkin’s disease (p. 262)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-183d1116ed3d","stem":"23 The following adverse effect of corticosteroids is mainly due to their mineralocorticoid action","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Osteoporosis"},{"label":"B","text":"Rise in blood pressure"},{"label":"C","text":"‘Moon face’"},{"label":"D","text":"Increased susceptibility to infection (p. 264)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-cb1fd079587b","stem":"24 Which of the following bones is affected more by glucocorticoid induced osteoporosis","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Upper Limb","topicOriginal":"Upper Limb","subtopic":"Arm","suggestedTopic":null,"options":[{"label":"A","text":"Lumber vertebra"},{"label":"B","text":"Humerus"},{"label":"C","text":"Radius"},{"label":"D","text":"Femur (p. 264)"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Upper Limb","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-67d367ffeea4","stem":"25 After chronic systemic therapy, withdrawal of corti- costeroids should be gradual because","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Corticosteroids produce psychological depen- dence"},{"label":"B","text":"Abrupt withdrawal may reactivate the under- lying disease"},{"label":"C","text":"Abrupt withdrawal produces rebound hyper- tension"},{"label":"D","text":"All of the above are correct (p. 264-265)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0593ccc1f34a","stem":"26 The following measure can minimise pituitary-adrenal suppression during long-term corticosteroid therapy","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Use of betamethasone in place of predniso- lone"},{"label":"B","text":"Use of prednisolone on alternate days"},{"label":"C","text":"Division of the daily dose in three equal 8 hourly doses"},{"label":"D","text":"Administration of the total daily dose at bed time (p. 265)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGr