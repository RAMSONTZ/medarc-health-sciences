ated for","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Prevention of osteoporosis"},{"label":"B","text":"Hastening fracture union"},{"label":"C","text":"Peripheral neuritis"},{"label":"D","text":"All of the above (p. 299)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f700c5921143","stem":"3 Bone resorption is accelerated by","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Upper Limb","topicOriginal":"Upper Limb","subtopic":"Arm","suggestedTopic":null,"options":[{"label":"A","text":"Estrogens"},{"label":"B","text":"Parathormone"},{"label":"C","text":"Bisphosphonates"},{"label":"D","text":"Calcitonin (p. 298, 300)"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Upper Limb","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a56f0218f12c","stem":"4 The primary action of parathormone is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"To increase intestinal calcium absorption"},{"label":"B","text":"To increase calcium reabsorption in kidney tubules"},{"label":"C","text":"To promote calcium deposition in extraos- seus tissues"},{"label":"D","text":"To increase resorption of calcium from bone (p. 300)"}],"priority":2,"status":"practice_draft","flags":["topic_gene