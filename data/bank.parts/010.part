ients"},{"label":"C","text":"Is associated with higher incidence of hypo- glycaemic reactions"},{"label":"D","text":"Both A and C are correct (p. 242-243)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrine Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"c9426aff8530fbdf1bd0b8b1591f3b87073051d2"},{"id":"q-322b812ad4d2","stem":"14 In a patient of diabetes mellitus maintained on insulin therapy, administration of the following drug can vitiate glycaemia control","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Endocrine Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Endocrine Pharmacology","options":[{"label":"A","text":"Prednisolone"},{"label":"B","text":"Prazosin"},{"label":"C","text":"Paracetamol"},{"label":"D","text":"Phenytoin (p. 242)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrine Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-441ab57a247c","stem":"15 Insulin therapy is required for the following category/ categories of type 2 diabetes mellitus patients","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"Diabet","suggestedTopic":null,"options":[{"label":"A","text":"Patients with ketoacidosis"},{"label":"B","text":"Patients undergoing surgery"},{"label":"C","text":"Pregnant diabetic"},{"label":"D","text":"All of the above (p. 242