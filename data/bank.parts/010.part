ified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8c08a4f1c8e2","stem":"34 Dorzolamide is a","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Topically applied ocular carbonic anhydrase inhibitor"},{"label":"B","text":"Second generation sulfonylurea hypoglycaemic"},{"label":"C","text":"Topical sulfonamide antibacterial"},{"label":"D","text":"Luminal amoebicide (p. 88)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-11babfd2a1d8","stem":"35 Choose the correct statement about latanoprost","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It is a PGF2α derivative used in glaucoma"},{"label":"B","text":"It is a selective α1 blocker used in benign hypertrophy of prostate"},{"label":"C","text":"It is a 5-α-reductase inhibitor used to reduce the size of enlarged prostate gland"},{"label":"D","text":"It is a PGE2 analogue used intravaginally for cervical priming (p. 88)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"b25fd305c2fb9705a23780705d2c8a569abfc610"},{"id":"q-85e81138cdb0","stem":"36 Select the diuretic that is most effective in acute congestive glaucoma","type":"Single Best Answer MCQ","subject":"Ophthalmology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Indapamide"},{"label":"B","text":"Amiloride"},{"label":"C","text":"Mannitol"},{"label":"D","text":"Furosemide (p. 89)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Ophthalmology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a269b37bbe25","stem":"37 Neostigmine is beneficial in cobra envenomation because","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It binds to and inactivates cobra toxin"},{"label":"B","text":"It reverses coma due to cobra toxin"},{"label":"C","text":"It counteracts the cardio-depressant action of cobra toxin"},{"label":"D","text":"It antagonizes the paralysing action of cobra toxin (p. 91)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-434b67a975b2","stem":"38 A suspected case of poisoning has been brought to the casualty with weakness, fainting, involuntary passage of urine and stools, profuse sweating, salivation, water- ing from nose and eyes. His pulse is 120/min, low volume, BP 90/60 mm Hg, respiration shallow, pupil constricted, muscles flabby with occasional fascicu- lations. Which is the most likely type of poisoning","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Upper Limb","topicOriginal":"Upper Limb","subtopic":"Arm","suggestedTopic":null,"options":[{"label":"A","text":"Belladonna"},{"label":"B","text":"Barbiturate"},{"label":"C","text":"Anticholinesterase"},{"label":"D","text":"Dicophane (DDT) (p. 91)"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Upper Limb","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-26f8e6473461","stem":"39 Which is the most important drug in the treatment of organophosphate poisoning","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Atropine sulfate"},{"label":"B","text":"Pralidoxime"},{"label":"C","text":"Diazepam"},{"label":"D","text":"Adrenaline (p. 91)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"218685252c7f109abf0d594649ad4a7ce37194c4"},{"id":"q-0b10440a429a","stem":"40 Atropine does not antagonise the following feature of anticholinesterase poisoning","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Autonomic Pharmacology","options":[{"label":"A","text":"Hypotension"},{"label":"B","text":"Central excitation"},{"label":"C","text":"Muscle paralysis"},{"label":"D","text":"Bronchoconstriction (p. 91)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology · Suggested","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-98418e39407a","stem":"41 Pralidoxime can reactivate cholinesterase enzyme that has been inactivated by","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Proteins and Enzymes","topicOriginal":"Proteins and Enzymes","subtopic":"Enzyme","suggestedTopic":null,"options":[{"label":"A","text":"Carbamate anticholinesterases"},{"label":"B","text":"Organophosphate anticholinesterases"},{"label":"C","text":"Both carbamate and organophosphate anti- cholinesterases"},{"label":"D","text":"Reversible anticholinesterases (p. 91-92)"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Proteins and Enzymes","answerAuditStatus":"independent_provisional_reasoning","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-f748fc7f1d41","stem":"1 Initial bradycardia caused by intramuscular injection of atropine is believed to be caused by","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Autonomic Pharmacology","options":[{"label":"A","text":"Stimulation of medullary vagal centre"},{"label":"B","text":"Stimulation of vagal ganglia"},{"label":"C","text":"Blockade of M2 receptors on SA nodal cells"},{"label":"D","text":"Blockade of muscarinic autoreceptors on vagal nerve endings (p. 94)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAns