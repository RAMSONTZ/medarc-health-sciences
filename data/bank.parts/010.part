","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Facilitation of sperm movement through cervical canal"},{"label":"B","text":"Increased cervical tone"},{"label":"C","text":"Softening of cervix"},{"label":"D","text":"Increased cervical secretions (p. 164)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8ab9013e6afb","stem":"17 The following drug is used for cervical priming to facilitate labour","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Oxytocin"},{"label":"B","text":"Clomiphene"},{"label":"C","text":"Progesterone"},{"label":"D","text":"Prostaglandin E2 (p. 164)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b677480e89e2","stem":"18 Prolonged airway hyperreactivity is characteristically caused by","type":"Single Best Answer MCQ","subject":"Anesthesiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Histamine"},{"label":"B","text":"Prostaglandin E2"},{"label":"C","text":"Platelet activating factor"},{"label":"D","text":"Bradykinin (p. 165)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Anesthesiology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"94cc4a23af9f58cad42bbecf9c1f9400fa100e59"},{"id":"q-ad09a8886889","stem":"19 The actions of platelet activating factor include the following except","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Increased capillary permeability"},{"label":"B","text":"Bronchodilatation"},{"label":"C","text":"Vasodilatation"},{"label":"D","text":"Erosion of gastric mucosa (p. 165)"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-9a0eb4c19836","stem":"1 The following analgesic lacks antiinflammatory action","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Paracetamol"},{"label":"B","text":"Ibuprofen"},{"label":"C","text":"Diclofenac sodium"},{"label":"D","text":"Piroxicam (p. 167, 181)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0b76d6f34760","stem":"2 Choose the correct statement about nonopioid analgesics","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"CNS Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"CNS Pharmacology","options":[{"label":"A","text":"All have antiinflammatory property"},{"label":"B","text":"All lack dependence producing liability"},{"label":"C","text":"All act exclusively at peripheral pain mechanisms"},{"label":"D","text":"All inhibit prostaglandin synthesis (p. 167) Note: Paracetamol and nefopam are nonopioid analgesics that do not inhibit PG synthesis and have no/weak antiinflammtory property. Metamizol and propiphenazone also have poor antiinflammatory activity."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"CNS Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e26eac70450a","stem":"3 The distinctive feature of the isoenzyme cyclooxyge- nase-2 is","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Proteins and Enzymes","topicOriginal":"Proteins and Enzymes","subtopic":"Enzyme","suggestedTopic":null,"options":[{"label":"A","text":"It is not inhibited by indomethacin"},{"label":"B","text":"It is inducible"},{"label":"C","text":"It generates cytoprotective prostagladins in gastric mucosa"},{"label":"D","text":"It is found only in foetal tissues (p. 158, 168)"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Proteins and Enzymes","answerAuditStatus":"independently_reasoned_provisional_oct20","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"a1dbbfcdcbdfc05f88916c46808d56681cc5011d"},{"id":"q-8a8ce2a31d16","stem":"4 Aspirin produces analgesia by","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Preventing sensitization of peripheral pain receptors"},{"label":"B","text":"Affecting gating of pain impulses at spinal level"},{"label":"C","text":"Raising pain threshold at subcortical level"},{"label":"D","text":"Both ‘A’ and ‘C’ are correct (p. 170)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-19f0734a021b","stem":"5 Select the drug which inhibits cyclooxygenase irreversibly","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Aspirin"},{"label":"B","text":"Mephenamic acid"},{"label":"C","text":"Naproxen"},{"label":"D","text":"Diclofenac (p. 168)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c5fc451579ea","stem":"6 Inhibitors of prostaglandin synthesis share the following features except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Prolongation of bleeding time"},{"label":"B","text":"Prolongation of prothrombin time"},{"label":"C","text":"Prolongation of labour"},{"label":"D","text":"Gastric mucosal damage (p. 168, 169)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5800b5f3dac8","stem":"7 Selective COX-2 inhibitors differ from nonselective COX-1/COX-2 inhibitors in that they","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Are antiinflammatory but not analgesic"},{"label":"B","text":"Donot bring down fever"},{"label":"C","text":"Have no renal effects"},{"label":"D","text":"Do not inhibit platelet aggregation (p. 169, 180)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-67ce703e7b16","stem":"8 Inhibition of prostaglandin synthesis does not underlie the following action of aspirin","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Analgesia"},{"label":"B","text":"Closure of patent ductus arteriosus"},{"label":"C","text":"Hyperventilation"},{"label":"D","text":"Bleeding tendency (p. 171)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"96d03bec94c462e096781c40f3e08ac2bfbefa7d"},{"id":"q-8d4fe64f3076","stem":"9 Metabolic effects that generally attend antiinflamma- tory doses of aspirin include the following except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Increased CO2 production"},{"label":"B","text":"Hepatic glycogen depletion"},{"label":"C","text":"Metabolic acidosis"},{"label":"D","text":"Compensated respiratory alkalosis (p. 171)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9ecb3af90a53","stem":"10 Which of the following is seen at low (analgesic) doses of aspirin","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Respiratory stimulation"},{"label":"B","text":"Increased occult blood loss in stools"},{"label":"C","text":"Increased cardiac output"},{"label":"D","text":"Hyperglycaemia (p. 171)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-89c5e934a341","stem":"11 Aspirin reduces fever by","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Decreasing heat production in the body"},{"label":"B","text":"Enhancing cutaneous blood flow"},{"label":"C","text":"Inducing sweating"},{"label":"D","text":"Both ‘B’ and ‘C’ are correct (p. 170-171)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7affaca3aa39","stem":"12 The isoenzyme cyclooxygenase-2 (COX-2) is expressed constitutively at the following site","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Proteins and Enzymes","topicOriginal":"Proteins and Enzymes","subtopic":"Enzyme","suggestedTopic":null,"options":[{"label":"A","text":"Gastric mucosa"},{"label":"B","text":"Neutrophils"},{"label":"C","text":"Blood platelets"},{"label":"D","text":"Juxtaglomerular apparatus"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Proteins and Enzymes","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[],"manualEdits":{"sourceStem":"12 The isoenzyme cyclooxygenase-2 (COX-2) is expressed constitutively at the following site","sourceOptions":[{"label":"A","text":"Gastric mucosa"},{"label":"B","text":"Neutrophils"},{"label":"C","text":"Blood platelets"},{"label":"D","text":"Juxtaglomerular apparatus (p. 168, 169, 181)"}]}},{"id":"q-9b7014ce9de8","stem":"13 Antiinflammatory dose of aspirin given to diabetics is prone to cause","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Hyperglycaemia"},{"label":"B","text":"Hypoglycaemia"},{"label":"C","text":"Ketoacidosis"},{"label":"D","text":"Alkalosis (p. 171)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"687fc75dca4d18fd434e596992f0803f3c844d66"},{"id":"q-17afac293f71","stem":"14 The plasma half life of aspirin (along with salicylic acid released from it)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"Remains constant irrespective of dose"},{"label":"B","text":"Is longer for antiinflammatory doses compa- red to that for analgesic dose"},{"label":"C","text":"Is shorter for antiinflammatory doses compa- red to that for analgesic dose"},{"label":"D","text":"Can be shortened by acidifying urine (p. 172)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-079f0277c96b","stem":"15 In the treatment of chronic inflammatory diseases, the most important limitation of aspirin is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Acid-base and electrolyte disturbances"},{"label":"B","text":"Hypersensitivity and idiosyncratic reactions"},{"label":"C","text":"Gastric mucosal damage"},{"label":"D","text":"Salicylism (p. 172)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c84c0235ea98","stem":"16 Generally the earliest manifestation of salicylism is","type":"OSCE / Practical Station","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Visual disturbance"},{"label":"B","text":"Excitement"},{"label":"C","text":"Hyperventillation"},{"label":"D","text":"Tinnitus (p. 172)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a658b229f141","stem":"17 Aspirin is contraindicated in children suffering from influenza or similar viral infection because of increased risk of","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Gastric bleeding"},{"label":"B","text":"Thrombocytopenia"},{"label":"C","text":"Fancony syndrome"},{"label":"D","text":"Reye’s syndrome (p. 173)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a4e7fffb4dbf","stem":"18 Aspirin is contraindicated in pregnant women near term because","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Labour may be delayed and prolonged"},{"label":"B","text":"Blood loss during delivery may be more"},{"label":"C","text":"Foetus may suffer premature closure of ductus arteriosus"},{"label":"D","text":"All of the above risks (p. 173)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"eea53ddc08ba6edb64cd4d53c8fcf621d73c4004"},{"id":"q-11bfb0499e86","stem":"19 Concurrent administration of aspirin interacts unfavourably with the following drugs except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Furosemide"},{"label":"B","text":"Spironolactone"},{"label":"C","text":"Codeine"},{"label":"D","text":"Methotrexate (p. 173, 427)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f8998cb66172","stem":"20 Choose the correct statement about aspirin","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"In an afebrile patient acute overdose of aspirin produces hypothermia"},{"label":"B","text":"Aspirin suppresses flushing attending large dose of nicotinic acid"},{"label":"C","text":"Aspirin therapy prevents granulomatous lesions and cardiac complications of acute rheumatic fever"},{"label":"D","text":"Long term aspirin therapy increases the risk of developing colon cancer (p. 173, 174)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-02ffa7bc2a4c","stem":"21 Choose the action for which the dose of aspirin required is the lowest","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Analgesic"},{"label":"B","text":"Antipyretic"},{"label":"C","text":"Antiinflammatory"},{"label":"D","text":"Antiplatelet aggregatory (p. 173-174)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3708d5ea2c26","stem":"22 Selective inhibition of thromboxane A2 synthesis by low dose aspirin therapy might retard the progression of","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Pregnancy induced hypertension"},{"label":"B","text":"Steroid induced hypertension"},{"label":"C","text":"Renal hypertension"},{"label":"D","text":"Malignant hypertension (p. 174)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"d50fb40442d64d2f5cc19ed3f6ad712b7e14f196"},{"id":"q-fec4f7685749","stem":"23 Phenylbutazone should be used only in patients not responding to other nonsteroidal antiinflammatory drugs (NSAIDs) because","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It has lower antiinflammatory efficacy than other NSAIDs"},{"label":"B","text":"It has potential to cause agranulocytosis"},{"label":"C","text":"It has weak analgesic action"},{"label":"D","text":"It alters the protein binding and metabolism of many drugs (p. 175)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4db1ffb37f6b","stem":"24 The NSAIDs aggravate the following diseases except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Hypertension"},{"label":"B","text":"Congestive heart failure"},{"label":"C","text":"Peptic ulcer"},{"label":"D","text":"Chronic gout"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{"sourceStem":"24 The NSAIDs aggravate the following diseases except","sourceOptions":[{"label":"A","text":"Hypertension"},{"label":"B","text":"Congestive heart failure"},{"label":"C","text":"Peptic ulcer"},{"label":"D","text":"Chronic gout (p. 176)"}]}},{"id":"q-392787810608","stem":"25 Which of the following analgesics itself frequently causes headache as a side effect","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Indomethacin"},{"label":"B","text":"Mephenamic acid"},{"label":"C","text":"Piroxicam"},{"label":"D","text":"Metamizol (p. 176)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-79f0cc222b76","stem":"26 The patient taking the following non-steroidal antiinflammatory drug should be cautioned not to drive motor vehicle","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Celecoxib"},{"label":"B","text":"Indomethacin"},{"label":"C","text":"Naproxen"},{"label":"D","text":"Diclofenac sodium (p. 176)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"762397c07ebe8c0a8628806c14fe54527434436e"},{"id":"q-b5e119c06934","stem":"27 Choose the correct statement about nonsteroidal antiinflammatory drugs (NSAIDs)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"NSAIDs attenuate hypoglycaemic action of sulfonylureas"},{"label":"B","text":"NSAIDs potentiate antihypertensive action of ACE inhibitors"},{"label":"C","text":"Serum lithium levels are lowered by concurrent administration of NSAIDs"},{"label":"D","text":"Combined therapy with prednisolone and NSAIDs carries higher risk of gastric bleeding (p. 175)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c33d1137e6ac","stem":"28 The constellation of adverse effects associated with nonsteroidal antiinflammatory drugs include the following except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Sedation"},{"label":"B","text":"Gastric irritation"},{"label":"C","text":"Fluid retention"},{"label":"D","text":"Rashes (p. 170)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-be3744e964f2","stem":"29 Which analgesic-antiinflammatory drug is more appropriate in musculo-skeletal disorder where pain is more prominent than inflammation","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ibuprofen"},{"label":"B","text":"Piroxicam"},{"label":"C","text":"Indomethacin"},{"label":"D","text":"Nimesulide (p. 183)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ba3f0976d5e6","stem":"30 The following nonsteroidal antiinflammatory drug is a preferential cyclooxygenase-2 (COX-2) inhibitor","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Tenoxicam"},{"label":"B","text":"Meloxicam"},{"label":"C","text":"Diclofenac sod."},{"label":"D","text":"Ketoprofen (p. 179-180)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"e572a05dff04603ad7aa5daa05158a7d891fd15e"},{"id":"q-3fc96a25515a","stem":"31 Which of the following is an efficacious antiinflamma- tory drug but a relatively weak inhibitor of cyclo- oxygenase","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Nimesulide"},{"label":"B","text":"Paracetamol"},{"label":"C","text":"Ketoprofen"},{"label":"D","text":"Indomethacin (p. 179)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7eb70d0ea770","stem":"32 What is true of nimesulide","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It exerts antiinflammatory action by several mechanisms in addition to cyclooxygenase inhibition"},{"label":"B","text":"It is preferred for long-term use in rheuma- toid arthritis"},{"label":"C","text":"It is contraindicated in aspirin intolerant asthma patients"},{"label":"D","text":"All of the above (p. 179)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0435ff6b4b9d","stem":"33 The distinctive feature of nimesulide is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It does not inhibit prostaglandin synthesis"},{"label":"B","text":"It does not cause gastric irritation"},{"label":"C","text":"It is usually well tolerated by aspirin intolerant asthma patients"},{"label":"D","text":"It is not bound to plasma proteins (p. 179)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4af32e25ddf8","stem":"34 Among the following, choose the NSAID with the highest COX-2 selectivity","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Nimesulide"},{"label":"B","text":"Nabumetone"},{"label":"C","text":"Rofecoxib"},{"label":"D","text":"Celecoxib (p. 180)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"2151a5549f75df4749d3923bcc12d3157c131c5b"},{"id":"q-2b8ff78cce7f","stem":"35 The selective COX-2 inhibitors have the following advantage(s) over the nonselective NSAIDs","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"They are less likely to cause gastric ulcers and their complications"},{"label":"B","text":"They are likely to be more effective in rheumatoid arthritis"},{"label":"C","text":"They are not likely to produce renal complications"},{"label":"D","text":"All of the above (p. 180-181)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f5b5c62f1bf1","stem":"36 Choose the correct statement about paracetamol","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It increases uric acid excretion"},{"label":"B","text":"It is the most common drug implicated in causing analgesic nephropathy"},{"label":"C","text":"In equianalgesic doses it is safer than aspirin"},{"label":"D","text":"It stimulates cellular metabolism (p. 181)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f26f74337df1","stem":"37 Select the drug which inhibits cyclooxygenase in the brain but not at peripheral sites of inflammation","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Nimesulide"},{"label":"B","text":"Paracetamol"},{"label":"C","text":"Ketorolac"},{"label":"D","text":"Mephenamic acid (p. 181)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-22b333c8dafd","stem":"38 N-acetyl cysteine is beneficial in acute paracetamol poisoning because","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It reacts with paracetamol to form a nontoxic complex"},{"label":"B","text":"It inhibits generation of the toxic metabolite of paracetamol"},{"label":"C","text":"It is a free radical scavenger"},{"label":"D","text":"It replenishes hepatic glutathione which in turn binds the toxic metabolite of paraceta- mol (p. 182)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"e258000b3a2909d4f620efd804c60ccfbee9852f"},{"id":"q-bf5c87c96839","stem":"39 Paracetamol has the following advantage(s) over NSAIDs","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It is the first choice analgesic for majority of osteoarthritis patients"},{"label":"B","text":"It can be given safely to all age groups from infants to elderly"},{"label":"C","text":"It is not contraindicated in pregnant or breast feeding women"},{"label":"D","text":"All of the above (p. 182)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9240bfb53975","stem":"40 For a patient of peptic ulcer, the safest nonopioid analgesic is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"CNS Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"CNS Pharmacology","options":[{"label":"A","text":"Celecoxib"},{"label":"B","text":"Diclofenac sodium"},{"label":"C","text":"Paracetamol"},{"label":"D","text":"Ibuprofen (p. 181)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"CNS Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1826f40563b5","stem":"41 Choose the correct statement about nefopam","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It is a nonopioid analgesic which does not inhibit prostaglandin synthesis"},{"label":"B","text":"It is an orally active opioid analgesic"},{"label":"C","text":"It is an analgesic with potent antiinflam- matory activity"},{"label":"D","text":"It is a preferential COX-2 inhibitor (p. 182)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-cff69c306b5a","stem":"42 Choose the correct statement about topical NSAID preparations","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"They produce high drug levels in the blood by avoiding hepatic first pass metabolism"},{"label":"B","text":"They produce high drug levels in the subjacent muscle and joint tissues upto a depth/distance of 10 cm from the site of application"},{"label":"C","text":"They elicit symptomatic relief in soft tissue rheumatism mainly by a strong placebo effect"},{"label":"D","text":"Interindividual variability in clinical response to these preparations is minimal (p. 183)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"4337ca87a8cb9d0b43be1fdbeff65ec82bacfbd6"},{"id":"q-c1a79308704f","stem":"43 The following antiinflammatory analgesic has been cleared for pediatric use","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Indomethacin"},{"label":"B","text":"Ibuprofen"},{"label":"C","text":"Ketorolac"},{"label":"D","text":"Piroxicam (p. 184)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-34433b236c14","stem":"1 Which of the following is a reserve drug but not a disease modifying drug in rheumatoid arthritis","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Chloroquine"},{"label":"B","text":"Sulfasalazine"},{"label":"C","text":"Prednisolone"},{"label":"D","text":"Methotrexate (p. 184, 187)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e0c215d202ea","stem":"2 Choose the correct statement about use of gold sod. thiomalate in rheumatoid arthritis","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It affords more rapid symptomatic relief than NSAIDs"},{"label":"B","text":"The NSAIDs therapy is discontinued when it is started"},{"label":"C","text":"It is used as an alternative to corticosteroids"},{"label":"D","text":"It is used only in severe cases when other diseases modifying antirheumatic drugs have failed (p. 185-186)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3280bdc0c98b","stem":"3 Choose the correct statement(s) about auranofin","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It is an orally active gold compound"},{"label":"B","text":"It is equally effective but less toxic than injected gold-sodium-thiomalate"},{"label":"C","text":"Its major adverse effect is dermatitis"},{"label":"D","text":"All of the above are correct (p. 186)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"409f04d4064436a46c66c8aeda58b1c1e0e27fe0"},{"id":"q-6f69feedddf1","stem":"4 Used as a remission inducing agent in rheumatoid arthritis, hydroxychloroquine","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Is more effective than chloroquine"},{"label":"B","text":"Produces a lower incidence of retinal damage than chloroquine"},{"label":"C","text":"Is more effective and more toxic than gold"},{"label":"D","text":"Both ‘A’ and ‘B’ are correct (p. 186)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ffb137f9f513","stem":"5 Sulfasalazine is used in the following disease(s)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Bacillary dysentery"},{"label":"B","text":"Ulcerative colitis"},{"label":"C","text":"Rheumatoid arthritis"},{"label":"D","text":"Both ‘B’ and ‘C’ are correct (p. 186-187, 620)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-890d79ba553a","stem":"6 Disease modifying antirheumatic drugs are indicated in rheumatoid arthritis","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"In place of NSAIDs in patients who donot tolerate the latter"},{"label":"B","text":"Along with NSAIDs in patients with pro- gressive disease"},{"label":"C","text":"Only when NSAIDs fail to afford symptomatic relief"},{"label":"D","text":"In all patients irrespective of disease status/ concurrent medication (p. 185-187)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-be30ceb05f14","stem":"3 months of therapy","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"The disease does not recurr once they induce remission"},{"label":"C","text":"They are to be used life long"},{"label":"D","text":"Concurrent use of more than one disease modifying drug is not recommended (p. 185-187)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGr