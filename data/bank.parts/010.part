ted","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-54e8449ea9da","stem":"35 For the treatment of female infertility, clomiphene citrate is used in the following manner","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Daily from 5th to 10th day of menstrual cycle"},{"label":"B","text":"On alternate days over the last two weeks of menstrual cycle"},{"label":"C","text":"Cyclically for 3 weeks with one week gap"},{"label":"D","text":"Continuously till conception occurs (p. 278)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-cc47c6901c0e","stem":"36 The following is an orally active ovulation inducing agent","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Menotropin"},{"label":"B","text":"Mifepristone"},{"label":"C","text":"Danazol"},{"label":"D","text":"Clomiphene citrate (p. 278)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-bc7bb11e6522","stem":"37 Which of the following is a selective estrogen receptor modulator that improves bone mineral density in postmenopausal women","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Clomiphene citrate"},{"label":"B","text":"Raloxifene"},{"label":"C","text":"Ormeloxifene"},{"label":"D","text":"Alendronate (p. 279, 306)"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"c49089be373608873b3397228dc8521e1348ddf0"},{"id":"q-debe279338de","stem":"38 What is true of tamoxifen","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It can induce endometrial proliferation in postmenopausal women"},{"label":"B","text":"It exerts antiestrogenic activity in bone"},{"label":"C","text":"It raises LDL-cholesterol levels"},{"label":"D","text":"It is ineffective in estrogen receptor-negative breast cancer (p. 279)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8c9f057c7c0a","stem":"39 Benefits of tamoxifen citrate therapy include the following except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Reduction in recurrence rate of breast cancer"},{"label":"B","text":"Improved bone mass"},{"label":"C","tex