":[]},{"id":"q-c34ee97f7861","stem":"29 Betaxolol differs from timolol in that it","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Is a β1 selective blocker"},{"label":"B","text":"Is more efficacious in glaucoma"},{"label":"C","text":"Produces less ocular side effects"},{"label":"D","text":"Is longer acting (p. 87)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-991487835f4b","stem":"30 Select the longer acting ocular beta blocker","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Cardiovascular Drugs · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Cardiovascular Drugs","options":[{"label":"A","text":"Timolol"},{"label":"B","text":"Betaxolol"},{"label":"C","text":"Cartiolol"},{"label":"D","text":"Levobunolol (p. 87)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular Drugs · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"cc3e0d306e9b4809ef782bd51d98a96cc6c2fe4e"},{"id":"q-abf545a11851","stem":"31 The following is an α2 adrenergic agonist used as eyedrops to lower intraocular pressure","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology","topicOriginal":"Autonomic Pharmacology","subtopic":"Adrenergic","suggestedTopic":null,"options":[{"label":