ons":[]},{"id":"q-16fd09829cc8","stem":"6 Complications of over treatment with thyroxine include the following except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Endocrine Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Endocrine Pharmacology","options":[{"label":"A","text":"Auricular fibrillation"},{"label":"B","text":"Angina pectoris"},{"label":"C","text":"Congestive heart failure"},{"label":"D","text":"Acceleration of atherosclerosis (p. 228)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrine Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"f33c23969fc0ef7a36cd9531c76d886cf99e988a"},{"id":"q-57ec0b1a3d86","stem":"7 Thyroxine therapy is indicated in the following conditions except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Endocrine Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Endocrine Pharmacology","options":[{"label":"A","text":"Euthyroid status with raised TSH level"},{"label":"B","text":"Diffuse nontoxic goiter"},{"label":"C","text":"Nonfunctional thyroid nodule"},{"label":"D","text":"Benign functioning thyroid nodule (p. 229, 230)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrine Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9bb7b566ef3f","stem":"8 Triiodothyronine is preferred over thyroxine in the treatment of","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Endocrine Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Endocrine Pharmacology","options":[{"label":"A","text":"Endemic goiter"},{"label":"B","text":"Cretinism"},{"label":"C","text":"Papillary carcinoma of thyroid"},{"label":"D","text":"Myxoedema coma (p. 229)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrine Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3f8590960f55","stem":"9 The following thyroid inhibitor does not produce goiter when given in over dose","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Propyl thiouracil"},{"label":"B","text":"Carbimazole"},{"label":"C","text":"Radioactive iodine"},{"label":"D","text":"Sodium thiocyanate (p. 230)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5b780f39f090","stem":"10 Carbimazole acts by inhibiting","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Iodide trapping"},{"label":"B","text":"Oxidation of iodide"},{"label":"C","text":"Proteolysis of thyroglobulin"},{"label":"D","text":"Synthesis of thyroglobulin protein (p. 231)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-86fa7720ef6d","stem":"11 Antithyroid drugs exert the following action","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Inhibit thyroxine synthesis"},{"label":"B","text":"Block the action of thyroxine on pituitary"},{"label":"C","text":"Block the action of TSH on thyroid"},{"label":"D","text":"Block the action of thyroxine on peripheral tissues (p. 230-231)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"2ebba570ca19fccb2e254a9a63c66ef0d7aae776"},{"id":"q-da055b913075","stem":"12 The following thyroid inhibitor interferes with peripheral conversion of thyroxine to triiodothyronine","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Endocrine Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Endocrine Pharmacology","options":[{"label":"A","text":"Propyl thiouracil"},{"label":"B","text":"Methimazole"},{"label":"C","text":"Carbimazole"},{"label":"D","text":"Radioactive iodine (p. 231)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrine Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-780b3d226d5d","stem":"13 Overtreatment with the following thyroid inhibitor results in enlargement of the thyroid","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Lugol’s iodine"},{"label":"B","text":"Radioactive iodine"},{"label":"C","text":"Carbimazole"},{"label":"D","text":"All of the above (p. 231)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-594a2682f353","stem":"14 A 60-year-old male presents with severe hyperthy- roidism and multinodular goiter. It was decided to treat him with 131I. The most appropriate course of treatment would be","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Immediate 131I dosing with no other drug before or after"},{"label":"B","text":"Propranolol for 1 week followed by 131I"},{"label":"C","text":"Propranolol + carbimazole till severe thyro- toxicosis is controlled—1 week gap—131I— resume carbimazole after 1 week for 2-3 months"},{"label":"D","text":"Propranolol + Lugol’s iodine for 2 weeks— 131I—continue Lugol’s iodine for 2-3 months (p. 232, 234)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-36ca9c01c179","stem":"15 Carbimazole differs from propylthiouracil in that","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It is dose to dose less potent"},{"label":"B","text":"It has a shorter plasma half life"},{"label":"C","text":"It does not produce an active metabolite"},{"label":"D","text":"It does not inhibit peripheral conversion of thyroxine to triiodothyronine (p. 231) 11111 77777 ..... 11111 22222 A 11111 77777 ..... 11111 33333 C 11111 77777 ..... 11111 44444 C 11111 77777 ..... 11111 55555 D Hormones 109109109109109"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"b946c5498d0a953eaa1682da60a8db2e9a5aac61"},{"id":"q-14237e5eac44","stem":"16 The thyroid inhibitor which produces the fastest response is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Lugol’s iodine"},{"label":"B","text":"Radioactive iodine"},{"label":"C","text":"Propylthiouracil"},{"label":"D","text":"Lithium carbonate (p. 232)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-36314c3cd89d","stem":"17 Choose the correct statement about carbimazole","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It induces improvement in thyrotoxic symp- toms afer 1-4 weeks therapy"},{"label":"B","text":"Control of thyrotoxic symptoms with carbi- mazole is accompanied by enlargement of thyroid gland"},{"label":"C","text":"Its long term use in Grave's disease leads to ‘thyroid escape’"},{"label":"D","text":"It mitigates thyrotoxic symptoms without lowering serum thyroxine levels (p.231-232)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b1bddf8a16ab","stem":"18 In the treatment of hyperthyroidism, carbimazole has the following advantage over radioactive iodine","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cost of treatment is lower"},{"label":"B","text":"It is preferable in uncooperative patient"},{"label":"C","text":"It is better tolerated by the patients"},{"label":"D","text":"Hypothyroidism when induced is reversible (p. 232)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ffa3e5adc6aa","stem":"19 Lugol’s iodine is used in hyperthyroidism","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"As long term definitive monotherapy"},{"label":"B","text":"Preoperatively for 10-15 days"},{"label":"C","text":"Postoperatively for 10-15 days"},{"label":"D","text":"As adjuvant to carbimazole for long term therapy (p. 233) 11111 77777 ..... 11111 66666 A 11111 77777 ..... 11111 77777 A 11111 77777 ..... 11111 88888 D 11111 77777 ..... 11111 99999 B 110110110110110 MCQs in Pharmacology"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"0d08566e9943c61bc4365b0be3c2895b7b7ff17b"},{"id":"q-48c8fbb5803a","stem":"20 The aim of iodine therapy before subtotal thyroid- ectomy in Grave’s disease is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"To render the patient euthyroid"},{"label":"B","text":"To restore the iodine content of the thyroid gland"},{"label":"C","text":"To inhibit peripheral conversion of thyroxine into triiodothyronine"},{"label":"D","text":"To reduce friability and vascularity of the thyroid gland (p. 233)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4fbbb9c93496","stem":"21 The uses of sodium/potassium iodide include the following except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Preoperative preparation of Grave’s disease patient"},{"label":"B","text":"Prophylaxis of endemic goiter"},{"label":"C","text":"As antiseptic"},{"label":"D","text":"As expectorant (p. 233, 806)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-771fc1254d8f","stem":"22 The physical half life of radioactive 131I is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"8 hours"},{"label":"B","text":"8 days"},{"label":"C","text":"16 days"},{"label":"D","text":"60 days (p. 233)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-855f5ebbdf72","stem":"23 The most important drawback of radioactive iodine treatment of Grave’s disease is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Subsequent hypothyroidism in many patients"},{"label":"B","text":"Marked side effect for 1-2 weeks after treat- ment"},{"label":"C","text":"High cost"},{"label":"D","text":"Permanent cure cannot be achieved (p. 234)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8364ca602a71","stem":"24 Propranolol is used in hyperthyroidism","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"As short-term symptomatic therapy till effect of carbimazole develops"},{"label":"B","text":"As long-term therapy after subtotal thyroid- ectomy"},{"label":"C","text":"In patients not responding to carbimazole"},{"label":"D","text":"To potentiate the effect of radioactive iodine (p. 234) 11111 77777 ..... 22222 00000 D 11111 77777 ..... 22222 11111 C 11111 77777 ..... 22222 22222 B 11111 77777 ..... 22222 33333 A 11111 77777 ..... 22222 44444 A Hormones 111111111111111"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"5bcfa0474b467ac7e2f83a910eef6244ad64b957"},{"id":"q-91705e03a9a5","stem":"25 Radioactive iodine is the treatment of choice for the following category of thyrotoxic patients","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Children"},{"label":"B","text":"Young adults with recent oneset of Grave’s disease"},{"label":"C","text":"Elderly patients with ischaemic heart disease"},{"label":"D","text":"Pregnant women (p. 234)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-82edd4397e9c","stem":"1 Insulin release from pancreatic β cells is augmented by the following except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Endocrine Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Endocrine Pharmacology","options":[{"label":"A","text":"Ketone bodies"},{"label":"B","text":"Glucagon"},{"label":"C","text":"Vagal stimulation"},{"label":"D","text":"Alfa adrenergic agonists (p. 237)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrine Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7bb5e8e02fc8","stem":"2 Action of Insulin does not include the following","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Endocrine Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Endocrine Pharmacology","options":[{"label":"A","text":"Facilitation of glucose transport into cells"},{"label":"B","text":"Facilitation of glycogen synthesis by liver"},{"label":"C","text":"Facilitation of neoglucogenesis by liver"},{"label":"D","text":"Inhibition of lipolysis in adipose tissue (p. 238)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrine Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f500d66ecb01","stem":"3 The major limitation of the thiazolidinediones in the treatment of type 2 diabetes mellitus is","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"Diabet","suggestedTopic":null,"options":[{"label":"A","text":"Frequent hypoglycaemic episodes"},{"label":"B","text":"Hyperinsulinemia"},{"label":"C","text":"Lactic acidosis"},{"label":"D","text":"Low hypoglycaemic efficacy in moderate to severe cases (p. 235, 250)"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Endocrinology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ffa3a5ba2ac8","stem":"4 Glucose entry into the cells of the following organ/ tissue is highly dependent on the presence of insulin","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Endocrine Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Endocrine Pharmacology","options":[{"label":"A","text":"Brain"},{"label":"B","text":"Liver"},{"label":"C","text":"Adipose tissue"},{"label":"D","text":"Kidney tubules (p. 238) 11111 77777 ..... 22222 55555 C 11111 88888 ..... 11111 D 11111 88888 ..... 22222 C 11111 88888 ..... 33333 D 11111 88888 ..... 44444 C 112112112112112 MCQs in Pharmacology"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrine Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"b92c678ce0933d36244f85bdb11bae62254819c6"},{"id":"q-3dc2faa040e1","stem":"5 Choose the correct statement(s) about actions of insulin","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Endocrine Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Endocrine Pharmacology","options":[{"label":"A","text":"It favours translocation of glucose trans- porters from intracellular site to the plasma membrane"},{"label":"B","text":"It enhances transcription of lipoprotein lipase in vascular endothelium"},{"label":"C","text":"It increases production of the enzyme gluco- kinase"},{"label":"D","text":"All of the above (p. 238, 239)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrine Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-712fad5e07fa","stem":"6 The insulin receptor is a","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Ion channel regulating receptor"},{"label":"B","text":"Tyrosine protein kinase receptor"},{"label":"C","text":"G-protein coupled receptor"},{"label":"D","text":"None of the above (p. 239)"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrus