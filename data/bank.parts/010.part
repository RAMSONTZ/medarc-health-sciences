,"cleaningOperations":[],"duplicateStemGroup":"fb58607d2187900407cd69f07b41abe408dace63"},{"id":"q-5afffa231196","stem":"41 Interindividual variations in equieffective doses of a drug are most marked if it is disposed by","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Glomerular filtration"},{"label":"B","text":"Tubular secretion"},{"label":"C","text":"Both glomerular filtration and tubular secretion"},{"label":"D","text":"Hepatic metabolism (p. 52)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5b6562e3327e","stem":"42 The pharmacokinetics of drugs in the neonate differs from that in adults, because their","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Pharmacokinetic","suggestedTopic":null,"options":[{"label":"A","text":"Intestinal transit is fast"},{"label":"B","text":"Drug metabolizing enzymes are overactive"},{"label":"C","text":"Tubular transport mechanisms are not well developed"},{"label":"D","text":"Glomerular filtration rate is high (p. 53)"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-2f7270a6ce26","stem":"43 Which adverse drug effect is more common in children than in adults","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Isoniazid induced neuropathy"},{"label":"B","text":"Chlorpromazine induced muscle dystonia"},{"label":"C","text":"Digoxin induced cardiac arrhythmia"},{"label":"D","text":"Penicillin hypersensitivity (p. 53, 397)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-dbfeb6856f65","stem":"44 The elderly patients are relatively intolerant to","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Digoxin"},{"label":"B","text":"Salbutamol"},{"label":"C","text":"Propranolol"},{"label":"D","text":"Nifedipine (p. 54, 463)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-25bc8fa2fd91","stem":"45 The following drug adverse effect is specially noted in men compared to women","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Tardive dyskinesia due to neuroleptics"},{"label":"B","text":"Levodopa induced abnormal movements"},{"label":"C","text":"Ampicillin induced loose motions"},{"label":"D","text":"Ketoconazole induced loss of libido (p. 54, 720)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"af6f153d3ea0286e35fa902448c48b8d3ec0333f"},{"id":"q-10746a67da20","stem":"46 Which racial difference in response to drugs has been mentioned incorrectly below","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Africans require higher concentration of atro- pine to dilate pupils"},{"label":"B","text":"Black races are more responsive to antihyper- tensive action of beta blockers"},{"label":"C","text":"Japanese are more prone to develop SMON due to halogenated hydroxyquinolines"},{"label":"D","text":"Chloramphenicol induced aplastic anaemia is rare among Indians (p. 54)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-92d28e5365ef","stem":"47 Which of the following adverse drug reactions is due to a specific genetic abnormality","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Tetracycline induced sunburn like skin lesions"},{"label":"B","text":"Quinidine induced thrombocytopenia"},{"label":"C","text":"Metoclopramide induced muscle dystonia"},{"label":"D","text":"Primaquine induced massive haemolysis (p.54)"}],"priority":2,"status":"practice_draft"