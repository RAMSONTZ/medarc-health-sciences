nal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Pentagastrin"},{"label":"B","text":"Promethazine"},{"label":"C","text":"Aluminium hydroxide"},{"label":"D","text":"Ranitidine"},{"label":"E","text":"Magnesium hydroxide"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f986fd4abe24","stem":"Abnormally high urinary 5 hydroxyindole acetic acid (5-HIAA) suggests possible carcinoid tumor","type":"True / False","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b092f1c26755","stem":"Astemizole and terfenadine may cause fatal arrhythmia when used in combination with some macrolides or antifungal agents","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[{"label":"A","text":"By lengthening QT interval via direct action on cardiac H2 receptors"},{"label":"B","text":"Increasing metabolism of macrolide antibiotics"},{"label":"C","text":"Forming cardiotoxic complexes with, for example, ketaconazole"},{"label":"D","text":"Due to accumulation following inhibition of CYP3A4, a cytochrome p450 enzyme"