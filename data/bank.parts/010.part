:[{"label":"A","text":"Formation of male external genitalia in the foetus"},{"label":"B","text":"Prostatic hypertrophy in elderly males"},{"label":"C","text":"Pubertal changes in the male adolescent"},{"label":"D","text":"Spermatogenesis (p. 268)"}]}},{"id":"q-3a188e415d7f","stem":"3 Testosterone therapy started in a boy of 8 years and continued till puberty is likely to","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Increase adult stature"},{"label":"B","text":"Reduce adult stature"},{"label":"C","text":"Have no effect on adult stature"},{"label":"D","text":"Cause hypertrophy of penis (p. 269)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-40f85b53d82b","stem":"4 For the treatment of hypogonadism and impotence, testosterone/dihydrotestosterone can be adminis- tered by the following route/routes","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Oral"},{"label":"B","text":"Intramuscular"},{"label":"C","text":"Transdermal"},{"label":"D","text":"Both 'B' and 'C' (p. 268, 269)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ae60b8b57eef","stem":"5 The following androgen does not produce cholestatic jaun