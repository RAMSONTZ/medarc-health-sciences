rmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-030610ddf402","stem":"A 50 year old patient is having propranolol due to his cardiac problems but his physician now wants to stop this drug; which of the following is the most important reason for this step?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Familial tremor."},{"label":"B","text":"Partial AV heart block."},{"label":"C","text":"Mild hypertension."},{"label":"D","text":"Angina pectoris."},{"label":"E","text":"Supraventricular tachycardias. Key: b Topic Specification: Sedative-Hypnotics/ Anxiolytics (MCQ 7 – 9) Reference: Lippincott’s Pharmacology, 3rd Ed."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c3f7af40e8a9","stem":"A young man of 24 years is suffering from Generalized Anxiety Disorder; which drug may be preferred for his problem?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Zolpidem."},{"label":"B","text":"Buspiron."},{"label":"C","text":"Midazolam."},{"label":"D","text":"Triazolam."},{"label":"E","text":"Phenobarbital. Key: b"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answer