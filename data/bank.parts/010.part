ology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cornification of vaginal epithelium"},{"label":"B","text":"Proliferation of endometrium"},{"label":"C","text":"Maturation of graafian follicle"},{"label":"D","text":"Anabolism (p. 273, 274)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7a3f7fa275ed","stem":"20 Estrogen therapy in postmenopausal women has been implicated in increasing the risk of the follow- ing disorders except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Gall stones"},{"label":"B","text":"Osteoporosis"},{"label":"C","text":"Endometrial carcinoma"},{"label":"D","text":"Breast cancer (p. 276-277)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"5d55834b9a68386102ebefe2a0ed513e2b4de97a"},{"id":"q-90648416945f","stem":"21 Metabolic actions of estrogens tend to cause the following except","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Metabolism · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Metabolism","options":[{"label":"A","text":"Anabolism"},{"label":"B","text":"Impaired glucose tolerance"},{"label":"C","text":"Rise in plasma 