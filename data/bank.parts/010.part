ric"],"cleaningOperations":[]},{"id":"q-022c2fe3b391","stem":"42 The following effect(s) of tamoxifen citrate indi- cate(s) that it possesses tissue specific estrogenic action as well","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Inhibition of breast cancer cells"},{"label":"B","text":"Endometrial proliferation"},{"label":"C","text":"Hot flushes in premenopausal women"},{"label":"D","text":"All of the above (p. 279)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"c8dcc172862c5a48fb6afccca5fbd95e25140e0e"},{"id":"q-c39f597eda82","stem":"43 The following is true of raloxifene except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It acts as an estrogen agonist in bone"},{"label":"B","text":"It exerts estrogen antagonistic action on endometrium"},{"label":"C","text":"It increases risk of developing breast cancer"},{"label":"D","text":"It can induce/aggravate menopausal hot flushes (p. 279)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b96ceda2c8a0","stem":"44 Choose the selective estrogen receptor modulator that is useful in dysfunctional uterine bleeding by acting as estrogen antagonist in endometrium, but does not alter vaginal epithelium or cervical mucus","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Ormeloxifene"},{"label":"B","text":"Tamoxifen"},{"label":"C","text":"Centchroman"},{"label":"D","text":"Danazol (p. 280)"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-88994bdc7834","stem":"45 Progesterone administration","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Endocrine Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Endocrine Pharmacology","options":[{"label":"A","text":"Suppresses onset of menstruation"},{"label":"B","text":"Induces watery cervical secretion"},{"label":"C","text":"Sensitizes the uterus to oxytocin"},{"label":"D","text":"Cornifies vaginal epithelium (p. 281)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrine Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7f3a4403bc5b","stem":"46 The 19-Norprogestins differ from progesterone deri- vatives in that they","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Endocrine Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Endocrine Pharmacology","options":[{"label":"A","text":"Have potent antiovulatory activity"},{"label":"B","text":"Have no additional androgenic activity"},{"label":"C","text":"Have no additional estrogenic activity"},{"label":"D","text":"Are preferred for use in endometriosis (p. 280)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrine Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4fdbae3d6e8d","stem":"47 The distinctive features of desogestrel include the following except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It is a prodrug"},{"label":"B","text":"It has both strong progestational and strong antiovulatory activities"},{"label":"C","text":"It has additional androgenic acitivity"},{"label":"D","text":"It does not counteract the beneficial effect of estrogen on lipid profile (p. 280)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"fff037f62ae3b4c4461250df8b6e52950f5bac4d"},{"id":"q-ef874040d6b8","stem":"48 Actions of progesterone include the following except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Endocrine Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Endocrine Pharmacology","options":[{"label":"A","text":"Rise in body temperature"},{"label":"B","text":"Endometrial proliferation"},{"label":"C","text":"Proliferation of acini in mammary gland"},{"label":"D","text":"Suppression of cell mediated immunity (p. 281)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrine Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-348bad8d4d3e","stem":"49 Select the progestin preparation for coadministration with estrogen for hormone replacement therapy that does not counteract the beneficial effect of the latter on lipid profile due to lack of androgenic activity","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Lipids","topicOriginal":"Lipids","subtopic":"Lipid","suggestedTopic":null,"options":[{"label":"A","text":"Micronized oral progesterone"},{"label":"B","text":"Norethindrone"},{"label":"C","text":"Lynestrenol"},{"label":"D","text":"Medroxyprogesterone acetate (p. 281-282)"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Lipids","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-62ff9df73416","stem":"50 Select the indication for which a progestin is used alone without combining with an estrogen","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Threatened abortion"},{"label":"B","text":"Dysfunctional uterine bleeding"},{"label":"C","text":"Hormone replacement therapy"},{"label":"D","text":"Premenstrual tension (p. 283)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d8b8a110f637","stem":"51 Side effects of cyclic progestin therapy include the following except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Headache"},{"label":"B","text":"Gastroesophageal reflux"},{"label":"C","text":"Breast dyscomfort"},{"label":"D","text":"Irregular bleeding (p. 282-283)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b9862d59a5f5","stem":"52 Addition of a progestin for 10-12 days every month to cyclic estrogen replacement therapy during meno- pause is recommended because the progestin","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Prevents osteoporosis"},{"label":"B","text":"Prevents irregular bleeding"},{"label":"C","text":"Blocks increased risk of endometrial car- cinoma"},{"label":"D","text":"Both ‘B’ and ‘C’ are correct (p. 283)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"823c93b53c0d51627880970865cf9240825f4441"},{"id":"q-c1a46e3a6e86","stem":"53 The following is/are beneficial in endometriosis","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Norethindrone"},{"label":"B","text":"Nafarelin"},{"label":"C","text":"Danazol"},{"label":"D","text":"All of the above (p. 221, 271, 283)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-45cf11ef8429","stem":"54 Select the drug which administered orally causes cervical ripening in pregnant women to facilitate surgical abortion or induction of labour","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Mifepristone"},{"label":"B","text":"Raloxifene"},{"label":"C","text":"Natural progesterone"},{"label":"D","text":"Levonorgestrel (p. 284)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-df7c73bc9581","stem":"55 Mifepristone possesses the following activities","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Potent antiprogestin + weak androgenic"},{"label":"B","text":"Potent antiprogestin + weak antiglucocorti- coid"},{"label":"C","text":"Potent antiestrogenic + weak antiprogestin"},{"label":"D","text":"Potent antiestrogenic + weak glucocorticoid (p. 283)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ba620e48ebfb","stem":"56 Which of the following drugs is an antiprogestin","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Gemeprost"},{"label":"B","text":"Megestrol"},{"label":"C","text":"Mifepristone"},{"label":"D","text":"Tamoxifen (p. 283)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-bea0d9df1ffe","stem":"57 The most important indication of mifepristone is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Endometriosis"},{"label":"B","text":"Cushing's syndrome"},{"label":"C","text":"First term abortion"},{"label":"D","text":"Second term abortion (p. 284)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"a13196b832dac4806b798cbbd641d25c826b99bc"},{"id":"q-d06f497c753f","stem":"58 Administration of mifepristone in the late luteal phase","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Induces menstruation"},{"label":"B","text":"Postpones menstruation"},{"label":"C","text":"Prevents luteolysis"},{"label":"D","text":"Causes decidualization of endometrium (p. 284)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2e186e5d5b13","stem":"59 Which of the following can act as a single dose postcoital contraceptive","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Endocrine Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Endocrine Pharmacology","options":[{"label":"A","text":"Clomiphene citrate"},{"label":"B","text":"Mifepristone"},{"label":"C","text":"Danazol"},{"label":"D","text":"Medroxyprogesterone acetate (p. 284)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrine Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9f89faace288","stem":"60 The following regimen is preferred for nonsurgical termination of pregnancy in the first 7 weeks","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Intravenous oxytocin infusion"},{"label":"B","text":"Intramuscular carboprost"},{"label":"C","text":"Intravaginal mifepristone followed by intra- amniotic dinoprost"},{"label":"D","text":"Oral mifepristone followed by oral miso- prostol (p. 284)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b881fd51100c","stem":"61 The most popular form of hormonal contraception is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Combined estrogen + progestin oral pill"},{"label":"B","text":"Phased estrogen + progestin oral pill"},{"label":"C","text":"Postcoital estrogen + progestin pill"},{"label":"D","text":"Depot progestin injection (p. 285)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-bd25222a1dc1","stem":"62 The purpose/purposes served by the progestin com- ponent of the combined estrogen + progestin contraceptive pill is/are","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Endocrine Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Endocrine Pharmacology","options":[{"label":"A","text":"Suppression of ovulation"},{"label":"B","text":"Prompt bleeding at the end of the course"},{"label":"C","text":"Blockade of increased risk of endometrial carcinoma"},{"label":"D","text":"All of the above (p. 285)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrine Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"20b59dc9130866aa53ecc19cd44c05dad0d9843a"},{"id":"q-bba1d31ab82d","stem":"63 The progestin used in combined oral contraceptive pill is a 19-nortestosterone derivative because","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Endocrine Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Endocrine Pharmacology","options":[{"label":"A","text":"They have potent antiovulatory action of their own"},{"label":"B","text":"They do not produce any metabolic effects"},{"label":"C","text":"They produce fewer side effects"},{"label":"D","text":"They are longer acting (p. 285)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrine Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-398521313e7f","stem":"64 In which of the following forms of oral contraception, pills are taken continuously without interruption","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Combined pill"},{"label":"B","text":"Phased pill"},{"label":"C","text":"Minipill"},{"label":"D","text":"Both 'B' and 'C' (p. 285)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-435ebb9b5b79","stem":"65 A progestin and an estrogen are combined in oral contraceptive pill because","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Endocrine Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Endocrine Pharmacology","options":[{"label":"A","text":"The estrogen blocks the side effects of the progestin"},{"label":"B","text":"The progestin blocks the side effects of the estrogen"},{"label":"C","text":"Both synergise to suppress ovulation"},{"label":"D","text":"Both synergise to produce hostile cervical mucus (p. 285)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrine Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7d06ea1a7369","stem":"1 mg taken twice 12 hour apart","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Levonorgestrel 0.75 mg taken twice 12 hour apart"},{"label":"C","text":"Mifepristone 600 mg single dose"},{"label":"D","text":"All of the above (p. 286)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"312ca740fee79befbcf17d85d02fffba5351929e"},{"id":"q-50137c13b7b1","stem":"67 The most common and important undesirable effect of injectable contraceptive depot medroxyprogest- erone acetate is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Endocrine Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Endocrine Pharmacology","options":[{"label":"A","text":"Nausea and vomiting"},{"label":"B","text":"Disruption of cyclic menstrual bleeding"},{"label":"C","text":"Venous thrombosis"},{"label":"D","text":"Hypertension (p. 287)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrine Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0432437894a8","stem":"68 The primary mechanism of action of the combined estrogen-progestin oral contraceptive pill is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Endocrine Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Endocrine Pharmacology","options":[{"label":"A","text":"Production of cervical mucus hostile to sperm penetration"},{"label":"B","text":"Suppression of FSH and LH release"},{"label":"C","text":"Making endometrium unsuitable for imp- lantation"},{"label":"D","text":"Enhancing uterine contractions to dislodge the fertilized ovum (p. 287, 288)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrine Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e8891c3693a2","stem":"69 Which of the following is advised when a woman on combined oral contraceptive pill misses a dose","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Endocrine Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Endocrine Pharmacology","options":[{"label":"A","text":"Continue with the course without regard to the missed dose"},{"label":"B","text":"Take 2 pills the next day and continue with the course"},{"label":"C","text":"Take 2 pills everyday for the remaining part of the course"},{"label":"D","text":"Discontinue the course and use alternative method of contraception (p. 288)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Endocrine Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-bf2fd1a45c5d","stem":"70 The currently used injectable hormonal contracep- tive contains","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Long acting progestin"},{"label":"B","text":"Long acting estrogen"},{"label":"C","text":"Both long acting estrogen and progestin"},{"label":"D","text":"Chorionic gonadotropin (p. 287)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["