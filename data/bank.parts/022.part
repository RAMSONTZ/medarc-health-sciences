ic"],"cleaningOperations":[]},{"id":"q-b7dc1b1d8b82","stem":"Name three syndromes caused by leishmania parasites and the main differences among them SPECIFIC FOR MD&BSC (LAB)","type":"Short Answer","subject":"Psychiatry","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Psychiatry","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-71b9af581673","stem":"(a) Taenia saginata (b) Taenia solium © Echinococcus granulosus","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Helminthology","topicOriginal":"Helminthology","subtopic":"Cestodes","suggestedTopic":null,"options":[{"label":"A","text":"Echinococcus multilocuralis"},{"label":"B","text":"Trichinella spiralis"}],"priority":0,"status":"review","flags":["mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Helminthology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag"],"cleaningOperations":[]},{"id":"q-780263dc6b54","stem":"(a) Echinococcus granulosus (b) Echinococcus multilocuralis Acquired by: Hand to mouth transfer of eggs after association with infected dogs or indirectly through contaminated food, water, soil or fomites. - In some instances flies have dispesed eggs after feeding on infected faces. Treatment","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cysts in the liver, lungs and in more unusual sites such as brain may be removed by operation"},{"label":"B","text":"Treated with Albendazo, Mebendazole, Praziquantel."}],"priority":0,"status":"review","flags":["mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag"],"cleaningOperations":[]},{"id":"q-86d4b3f23e9b","stem":"( 3 points - 3 marks)","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Avoid close contact with cats and their feces. Have someone who is healthy to change your cat's litter box daily. If this is not possible, wear gloves and clean the litter box every day, because the parasite found in cat feces needs one or more days after being passed to become infectious. Wash your hands well with soap and water afterwards. Dispose cat faeces and litter daily (before sporocysts become infective)"},{"label":"B","text":"Wear gloves when you garden or do anything outdoors that involves handling soil. Cats, which may pass the parasite in their feces, often use gardens and sandboxes as litter boxes. Wash your hands well with soap and water after outdoor activities, especially before you eat or prepare any food."},{"label":"C","text":"When preparing raw meat, wash any cutting boards, sinks, knives, and other utensils that might have touched the raw meat thoroughly with soap and hot water to avoid cross-contaminating other foods. Wash your hands well with soap and water after handling raw meat."},{"label":"D","text":"Infection may also be acquired by ingesting sarcocysts in undercooked meat. This can be prevented by thoroughly cooking the meet before eating. Avoid row meat. No raw meat for you and your kitty."},{"label":"E","text":"Cook all meat thoroughly; that is, to an internal temperature of 160° F and until it is no longer pink in the center or until the juices become colorless. Do not taste meat before it is fully cooked."},{"label":"F","text":"Wash all fruits and vegetable."},{"label":"G","text":"Wash hands Thoroughly before eating and after handing raw meat or having contact with soil possibly contaminated with cat faeces."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-8d411223bb46","stem":"(3 parasites- 3 marks)","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ascaris lumbricoides"},{"label":"B","text":"Trichuris trichuria"},{"label":"D","text":"Entrobius vermicularis"},{"label":"E","text":"Toxocara canis"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-f7eb34235b56","stem":"Enterobiasis can be diagnosed through three of the following: (2 marks @)","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Microscopic identification eggs in feces"},{"label":"B","text":"Identification of eggs from perianal scrapings or swabs from finger nails"},{"label":"C","text":"Finding an adult around the anus mainly at night during when it lay eggs"},{"label":"D","text":"The use of adhesive scotch tape. A swab on perineal region and examine the tape microscopically for eggs (material obtained early in the morning before bathing or defacation)"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"b13262847290db58a0e27ae98b90fae69cc44e55"},{"id":"q-8807212f58fc","stem":"Prevention of infection by Enterobius vermicularis are can be done through any six of these: (1 mark @)","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Treatment of diagnosed individuals to reduce source of infection in the community"},{"label":"B","text":"Hand washing before food and after toilet"},{"label":"C","text":"Cutting finger nails short"},{"label":"D","text":"Frequent change and washing of under clothing (preferably after bathing), night clothes and bed sheets"},{"label":"E","text":"Body cleanliness through taking bath especially in the morning"},{"label":"F","text":"Educate the public in general hygiene."},{"label":"G","text":"Reduce overcrowding in living accommodations"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-2061737d349c","stem":"Biting/chewing lice are members of which Order?","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Mallophaga"},{"label":"B","text":"Siphonaptera"},{"label":"C","text":"Hemiptera"},{"label":"D","text":"Anoplura"},{"label":"E","text":"Diptera"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"841d0108762ba853d0a92a6b64922c20e845716b"},{"id":"q-28c21c054116","stem":"Which two of the following insects species feed at night (noctumal feeders)","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Chrysops"},{"label":"B","text":"Simulium neavei"},{"label":"C","text":"Culicoides spp"},{"label":"D","text":"Phlebotomus spp"},{"label":"E","text":"Tritaioma spp"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"a74f2b50338d5cc9bf6b6e60e2e782e61b37fac1"},{"id":"q-517c8c271cc7","stem":"Two of th