","text":"Bind antibodies attached to cell surfaces and to lyse these cells"},{"label":"D","text":"phagocytize antigens"},{"label":"E","text":"cross link allergens"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-35743551ac42","stem":"One principal function of the Class I and Class II major histocompatibility complex S proteins is to","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"transduce the signal to the T-cell interior following antigen binding"},{"label":"B","text":"mediate immunoglobulin class switching"},{"label":"C","text":"present antigen for recognition by the T-cell antigen receptor"},{"label":"D","text":"stimulate production of interleukins"},{"label":"E","text":"bind complement"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-14e2688c4d25","stem":"The major role of the complement system is to work in conjunction with","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"antibodies to lyse cells via the C8 and C9 components"},{"label":"B","text":"the major histocompatibility complex for cell recognition"},{"label":"C","text":"antibodies to opsonize cells"},{"label":"D","text":"the T-cell receptor for production of lymphokines"},{"label":"E","text":"antibodies to lyse cells via the perforin molecules"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{}},{"id":"q-3d9f05bf81b7","stem":"T-cell antigen receptors are distinguished from antibodies by which of the following","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"T-Cell receptors are glycosylated"},{"label":"B","text":"T-cell receptors must interact with antigen uniquely presented by other cells but not with free antigen"},{"label":"C","text":"T-Cell receptors bind various cytokines"},{"label":"D","text":"T-Cell receptors bind complement to lyse cells"},{"label":"E","text":"T-cell receptors are mediators of allergic reactions"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5f8bf25776c4","stem":"T-cell receptors or antibodies react with antigens","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"because both are made by lymphocytes"},{"label":"B","text":"because of complementary of molecular fit of both with antigen"},{"label":"C","text":"because both 'have light chain and heavy chain polypeptides"},{"label":"D","text":"cause histamine release"},{"label":"E","text":"facilitate perforin release"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5b7bb174b8ce","stem":"All of the following are true of antigen EXCEPT which one of the following?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"They contain epitopes."},{"label":"B","text":"They will react with antibodies."},{"label":"C","text":"They contain antigenic determinants."},{"label":"D","text":"They can elicit an immune response."},{"label":"E","text":"They contain paratopes."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"9cf63a47cb18a77de7f62d18a35d6b8681410f09"},{"id":"q-ea6dea36e771","stem":"All of the following are true with respect to IgE molecules, EXCEPT which one?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"They are the principal immunoglobulin class involved in allergic reactions."},{"label":"B","text":"They are involved in mediating anti-parasitic immune responses."},{"label":"C","text":"They will cross the placenta and fix complement."},{"label":"D","text":"They can effect the release of histamine and other chemical mediators."},{"label":"E","text":"They are the least abundant immunoglobulin in the serum."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-78b366db1ea5","stem":"Which of the following immunoglobulins is present normally in plasma at the highest concentration?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"IgG"},{"label":"B","text":"IgM"},{"label":"C","text":"IgA"},{"label":"D","text":"IgD"},{"label":"E","text":"IgE"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d4574c1041e4","stem":"All of the following are true about antibodies, EXCEPT which one?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"They fix complement."},{"label":"B","text":"They occur on the surface of B-lymphocyte"},{"label":"C","text":"They predominate the primary immune response to antigen."},{"label":"D","text":"They are glycoproteins."},{"label":"E","text":"They are molecule with a single, defined amino acid sequence."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f91f9c3d5de9","stem":"The major immunoglobulin family to which a particular immunoglobulin belongs can be determined by sequential analysis of the 110 amino acids beginning from the","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Water, pH and Buffers","topicOriginal":"Water, pH and Buffers","subtopic":"Acid","suggestedTopic":null,"options":[{"label":"A","text":"Amino terminus of the light chain."},{"label":"B","text":"Carboxy terminus of the light chain."},{"label":"C","text":"Amino terminus of the heavy chain."},{"label":"D","text":"Carboxy terminus of the heavy chain."},{"label":"E","text":"None of the above"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Water, pH and Buffers","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7e5cf36e0480","stem":"The immunoglobulin Joining chain (J-chain) is","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"only produced by T-Cells"},{"label":"B","text":"only produced by neutrophils"},{"label":"C","text":"associated with only multimeric forms of lgM and IgA"},{"label":"D","text":"associated with IgE for histamine release"},{"label":"E","text":"only produced by mast cells"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{}},{"id":"q-732b4a3e368d","stem":"All of the following are true EXCEPT","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"An epitope is a small portion of a macromolecule"},{"label":"B","text":"the variable region domains contain the antigen recognition site"},{"label":"C","text":"an antigenic determinant is a paratope"},{"label":"D","text":"The class of an immunoglobulin is determined by its heavy chain"},{"label":"E","text":"An IgG antibody is bivalent"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"7b4989edd75ed698efc0f39082026a649b0e033b"},{"id":"q-516a7c2b8b25","stem":"Which immunoglobulin is the principal one found in secretions such as milk?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"IgG"},{"label":"B","text":"IgM"},{"label":"C","text":"IgA"},{"label":"D","text":"IgD"},{"label":"E","text":"IgE"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-532a3a713a60","stem":"Individuals unable to make the J protein found in certain immunoglobulins would be expected to have frequent infections of the","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"brain."},{"label":"B","text":"blood."},{"label":"C","text":"liver."},{"label":"D","text":"pancreas."},{"label":"E","text":"intestinal tract."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{}},{"id":"q-9b4d9aa45ab6","stem":"Which of the following statements best characterizes an antibody?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"An antibody contains high molecular weight RNA as its basic structure."},{"label":"B","text":"An antibody is composed of protein and cannot be distinguished from the albumin fraction of the serum proteins."},{"label":"C","text":"An antibody is composed of four identical protein subunits which may be caused to dissociate by treatment with urea."},{"label":"D","text":"An antibody contains protein as its major chemical component and its synthesis may be elicited by the administration of a foreign protein or polysaccharide."},{"label":"E","text":"An antibody contains mucopolysaccharides as its major chemical component and the synthesis of these may be elicited by the administration of a foreign protein or polysaccharide."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-718f822c125d","stem":"The immunoglobulin class which is the least abundant in the normal adult is","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"IgG"},{"label":"B","text":"IgA"},{"label":"C","text":"IgM"},{"label":"D","text":"IgD"},{"label":"E","text":"IgE."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-05cc22e322b1","stem":"Class switching of immunoglobulins occurs","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Usually with booster immunizations, going from IgM to IgG"},{"label":"B","text":"binds complement"},{"label":"C","text":"causes the histamine release"},{"label":"D","text":"mediates immunoglobulin class switching"},{"label":"E","text":"results in the glycosylation of immunoglobulins"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-15154871bf19","stem":"When a B-cell undergoes immunoglobulin class switching","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the variable region of the light chain changes, but its constant region remains the sam"},{"label":"B","text":"the variable region of the light chain remains the same, but its constant region changes"},{"label":"C","text":"the variable region of the heavy chain remains the same but its constant region changes"},{"label":"D","text":"the variable region of the heavy chain changes but its constant region remains the same"},{"label":"E","text":"both the variable and constant regions change"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-043c970c8bba","stem":"The class of an immunoglobulin","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"is determined by Class I and Class II major histocompatibility complex proteins"},{"label":"B","text":"is determined by the carbohydrate attached to the light chain is"},{"label":"C","text":"determined by the antigen"},{"label":"D","text":"is determined by the heavy chain type"},{"label":"E","text":"Is determined by the J-chain"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7dc2c3d15b20","stem":"The class of an immunoglobulin is determined by","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the variable region"},{"label":"B","text":"the J-chain"},{"label":"C","text":"the heavy chain"},{"label":"D","text":"the carbohydrate"},{"label":"E","text":"the T3 polypeptide complex"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{}},{"id":"q-b2484c99133e","stem":"Light chains are","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"specific for each class of antibody"},{"label":"B","text":"not specific for each class of antibody"},{"label":"C","text":"reactive with antigen"},{"label":"D","text":"have only a constant region"},{"label":"E","text":"are composed only of carbohydrate"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-df170bfb4546","stem":"Each of the following is a characteristic of antibodies, EXCEPT which one?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"they are proteins with variable and constant regions"},{"label":"B","text":"they contain carbohydrates"},{"label":"C","text":"they are only secreted by T-cells"},{"label":"D","text":"they can combine very specifically with antigen"},{"label":"E","text":"they are structurally organized in globular domains"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[],"manualEdits":{}},{"id":"q-b35f7950b8b7","stem":"The T3 complex of the T-cell receptor","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"probably functions to transduce a signal to the cell's interior following binding of complexed antigen"},{"label":"B","text":"binds complement"},{"label":"C","text":"causes the histamine"},{"label":"D","text":"mediates Immunoglobulin class switching"},{"label":"E","text":"results in the glycosylation of jmmunoglobuiins"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b244cb47aca2","stem":"Cytokines are produced by cells of the immune system in response to various physiological stimuli","type":"Single Best Answer MCQ","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"modulate cell function through subsequent cell differentiation or cell proliferation"},{"label":"B","text":"facilitate cell lysis"},{"label":"C","text":"cause glycosylation of Immunoglobins"},{"label":"D","text":"cause histamine release"},{"label":"E","text":"facilitate perforin release"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-454e360231ec","stem":"Which of the following uniquely distinguishes the T-cell receptor (TCR) from an antibody?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The TCR can bind an antigen fragment only in a trimolecular complex with either the class I or class II surface proteins of the major histocompatibility complex"},{"label":"B","text":"The TCR can function as a cell surface antigen receptor"},{"label":"C","text":"The TCR is composed of two different types of polypeptide chains"},{"label":"D","text":"The TCR is capable of participating in a cytotoxic reaction."},{"label":"E","text":"The TCR polypeptides is composed of domains - an amino terminal variable portion at determines the binding specificity and a constant portion that determines the class of the polypeptide chain."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f9f4c21a39b5","stem":"Which of the following is NOT true of interleukins?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"They are cytokines which can be produced by various cells of the immune system."},{"label":"B","text":"They are hormones which allow one cell to communicate with another cell."},{"label":"C","text":"They are in need of receptors on the target cell in order to mediate their effects."},{"label":"D","text":"They are able bind antigen with a high level of specificity."},{"label":"E","text":"They are able to modulate various aspects of the B-cell arm of immune system."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-23cd63e6a96f","stem":"Which of the following is NOT true of T4 and T8 cell markers?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"These are both surface glycoproteins expressed on T-cells."},{"label":"B","text":"These serve to distinguish different types of T-cells, e.g., helper, suppressor and cytotoxic, from each other."},{"label":"C","text":"These are not found associated with immunoglobulins."},{"label":"D","text":"The T4 proteins serve both to mediate T-cell helper function as well as the receptor for the AIDS virus."},{"label":"E","text":"Both of the markers are present on ALL T-cells."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-37ee849a9716","stem":"Which of the following is NOT true of the ability of the T-cell receptor (TCR) to specifically recognize antigen?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The antigen must be \"processed\" first by an accessory cell of immune system in order for it to bind to the TCR."},{"label":"B","text":"The recognition of the antigen by the TCR can mediate helper, suppressor or cytotoxic function."},{"label":"C","text":"The recognition of antigen by the TCR can result in cytokine secretion and/or an increase in cell proliferation within the immune system."},{"label":"D","text":"The antigen is recognized by the T3-TCR complex only when it is associated with a protein of the major histocompatibility complex"},{"label":"E","text":"Only the alpha chain of the TCR is necessary for antigen [pic] For the following questions, choose: A if only 1,2, and 3 are true B if only 1 and 3 are true C if only 2 and 4 are true D if only 4 is true E if all are true"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-31143c4a478d","stem":"Which of the following are true statements","type":"Short Answer","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-210f10b8210d","stem":"Which Is TRUE for BOTH the T-cell antigen receptor and the antibody","type":"