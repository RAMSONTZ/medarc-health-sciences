tFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-846853b75ea1","stem":"In antithrombin III deficiency","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the inheritance is autosomal recessive"},{"label":"B","text":"thromboembolism commencing in pregnancy is common"},{"label":"C","text":"long-term heparinisation is the treatment of choice"},{"label":"D","text":"antithrombin III levels of 45% may predispose to embolus"},{"label":"E","text":"the presence of lupus anticoagulant is a common associated feature"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-74cc51833c40","stem":"In coarctation of the aorta","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"congestive failure is usually due to hypertension"},{"label":"B","text":"rupture of the aorta is a recognised complication"},{"label":"C","text":"cerebrovascular haemorrhage is a known hazard"},{"label":"D","text":"infective endocarditis of the bicuspid valves is a very rare occurence"},{"label":"E","text":"hypertension is most frequently of the systolic type"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-0b0adce20ac5","stem":"The following statements are true of typhoid fever","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the initial clinical presentation may be mistaken for a psychiatric disorder"},{"label":"B","text":"spastic paraparesis is a recognised complication"},{"label":"C","text":"neutrophil leucocytosis is usually a feature during the first week of illness"},{"label":"D","text":"can treated successfully with cefotaxime"},{"label":"E","text":"heart failure is a recognised complication"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-98a1eae3bb64","stem":"Pneumococcal meningitis","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"has its peak age incidence in childhood"},{"label":"B","text":"has subarachnoid block as a recognised complication"},{"label":"C","text":"is a recognised late sequel to splenectomy in children"},{"label":"D","text":"should be treated with 100 000 units benzyl penicillin intrathecally daily for seven days"},{"label":"E","text":"can be effectively treated with chloramphenicol in patients hypersensitive to penicillin"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-359a6519682e","stem":"An otherwise healthy woman of 30 has a second attack of renal colic in two years and passes a stone. Blood urea is normal. The following investigations are indicated","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Xray of the hands"},{"label":"B","text":"estimation of the fasting serum calcium concentration"},{"label":"C","text":"culture of the urine"},{"label":"D","text":"renal biopsy"},{"label":"E","text":"urinary amino-acid chromatography"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-9036c7188772","stem":"An unconscious man is brought to hospital as an emergency. He is a known methylated-spirit drinker. If he is suffering from methyl alcohol poisoning","type":"Single Best Answer MCQ","subject":"Emergency Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Kussmaul's breathing (air hunger) would be expected as a prominant feature"},{"label":"B","text":"therapy with nikethamide is indicated to restore consciousness"},{"label":"C","text":"papilloedema would be consistant with the condition"},{"label":"D","text":"the methyl alcohol is metabolized to acetaldehyde"},{"label":"E","text":"the plasma bicarbonate would be very low"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Emergency Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-0312a5835025","stem":"Diabetic retinopathy","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"spares non-insulin dependant diabetic patients"},{"label":"B","text":"indicates poor diabetic control"},{"label":"C","text":"of the backround type requires laser photocoagulation therapy"},{"label":"D","text":"first presents with AV nipping"},{"label":"E","text":"is a common cause of blindness in the population over the age of 60 years"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-ae92be189883","stem":"Proliferative glomerulonephritis","type":"Single Best Answer MCQ","subject":"Un