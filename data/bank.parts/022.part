_unclassified","topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"29f33305d88d45fae1ca6cbc2e01cc2d906bd129"},{"id":"q-28f9f9b8a6db","stem":"A 7 year old girl came to paedriatic OPD of the hospital along with her mother. The mother. Mother complained that her child is having abdominal pain, diarrhea and severe itching around the perianal area for more than three weeks. She also mentioned that her child is not sleeping well during nights. Few days back she noticed a few minute white small threads like structures inside undergarment of her child. The girl has no fever, cough or any rash. Her physical examination was unremarkable. Stool examination for parasites did not show any parasitic ova.","type":"Single Best Answer MCQ","subject":"Dermatology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Which intestinal nematode is the most likely cause in this case? (1 mark)"},{"label":"B","text":"Why the parasitic ova were not demonstrated in the stool specimens? (1 mark)"},{"label":"C","text":"Which other specimens can be collected to demonstrate the parasitic ova? (1 mark)"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Dermatology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperation