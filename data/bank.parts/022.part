,"topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-38251e5482fb","stem":"A girl of 16 years who has suffered from cystic fibrosis from early childhood is admitted to hospital with a haematemesis. Examination is likely to reveal the following signs","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"clubbing of the fingers"},{"label":"B","text":"tenderness in the epigastrium"},{"label":"C","text":"absenc of bowel sounds"},{"label":"D","text":"enlargement of the spleen"},{"label":"E","text":"distension of the abdomen"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-c852d3a5cd23","stem":"With regard to the Philadelphia chromosome (Ph)","type":"Single Best Answer MCQ","subject":"Medical Genetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"In chronic myeloid leukaemia following therapy, the Ph cell line disappears from the blood but persists in the bone marrow"},{"label":"B","text":"it has been detected only in erythroblasts"},{"label":"C","text":"the Ph negative form of CML rarly has a white cell count > 100 000/mm3"},{"label":"D","text":"the Ph negative form of CML has a better response to chemotherapy than the Ph +ve"},{"label":"E","text":"it is the karyotype abnormality found in the majority of cases of chronic myeloid leukaemia"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Genetics","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization","source answer/boilerplate removed from option E"]},{"id":"q-9bb763fbcb40","stem":"In oliguric renal failure the dosage of the following drugs must be greatly reduced or the drug avoided altogether","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"cephaloridine"},{"label":"B","text":"erythromycin"},{"label":"C","text":"streptomycin"},{"label":"D","text":"sodium fusidate"},{"label":"E","text":"amphotericin B"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-f3fc6141f0ad","stem":"A presumed male child of 6 years has apparent hypospadias and no palpable testes. The following would be in favour of the child being female","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"buccal mucosa chromatin -ve"},{"label":"B","text":"high urinary 17-ketosteroid excretion"},{"label":"C","text":"pubic hair present"},{"label":"D","text":"abnormally tall stature"},{"label":"E","text":"retarded bone maturation"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAns