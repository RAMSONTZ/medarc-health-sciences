gOperations":[]},{"id":"q-69ed6b1699b8","stem":"How does a competitive inhibitor differ from an allosteric inhibitor?","type":"Short Answer","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Pharmacodynamic","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-40f9a3f4ea6c","stem":"What are the advantages of using an agonist with an allosteric activator?","type":"Short Answer","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Pharmacodynamic","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-2e5362cdefd3","stem":"Which of the following drugs are safe to use at the end of Pregnancy F (a) Aspirin. F (b)Indomethacin. F © Morphine. F (d) Warfarin. F (e) Chlordiazeproxide.","type":"Short Answer","subject":"Pharmacology","topic":"Cardiovascular Drugs · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Cardiovascular Drugs","options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular Drugs · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5bdea52680e7","stem":"Which of the following drugs will increase the serum concentration of zidovudine?","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"36ebb53f9d032dbddcb54984c3402db501be4fd4"},{"id":"q-e7a6c56d5ddd","stem":"Which of the following drugs act by nucleophilic attack on nitrogen 7 of guanine to disrupt the base pairing patterns. T (a) Cyclophosphamide. F (b) Fluorouracil. F © Methotrexate. F (d) Prednisolone. F (e) thioguanine.","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-01c42029d1ac","stem":"Which non-pharmacological measures should I recommend to a patient with hypertension?","type":"Clinical Vignette","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b7489171c276","stem":"<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"<a:clrMap xmlns:a=\"http://schemas.openxmlformats.org/drawingml/2006/main\" bg1=\"lt1\" tx1=\"dk1\" bg2=\"lt2\" tx2=\"dk2\" accent1=\"accent1\" accent2=\"accent2\" accent3=\"accent3\" accent4=\"accent4\" accent5=\"accent5\" accent6=\"accent6\" hlink=\"hlink\" folHlink=\"folHlink\"/>"},{"label":"B","text":"à...ŸòùOh"},{"label":"C","text":"KA`BANGE"},{"label":"D","text":"Normal"},{"label":"E","text":"LENOVO"},{"label":"F","text":"Microsoft Office Word"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"d345471c620f51033193346114ce04085734c807"},{"id":"q-890b2e94856b","stem":"A 60-year-old patient with AIDS presents to the emergency department with a temperature of 102°F,confused, and is going in and out of consciousness. He exhibits rapid respiration and a blood pressure of 80/40.You determine that both the sputum and urine are negative by Gram staining. Which of the following is the best choice?","type":"Clinical Vignette","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5f28a2996b13","stem":"A patient refuses to continue to take erythromycin because it makes him vomit. This is an example of which patient–drug–pathogen interaction?","type":"Clinical Vignette","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Pharmacokinetic","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-02347511e9cc","stem":"A 65-year-old man with acute leukemia recently underwent induction chemotherapy and subsequently developed neutropenia and fever (with no source of fever identified). Fever persisted despite the use of empirical antibacterial therapy, and amphotericin B has been prescribed for possible fungal sepsis. Which laboratory test is LEAST helpful in monitoring for toxicities associated with amphotericin B?","type":"Short Answer","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-09cceb215246","stem":"A 55-year-old obese woman with adult-onset diabetes mellitus has been receiving amoxicillin for treatment of an acute exacerbation of chronic bronchitis. After a week of therapy, the patient develops dysuria and increased urinary frequency. Urinalysis shows 10 to 50 white blood cells per high-powerfield, and Gram stain of urine shows many budding yeasts. Which antifungal agent would be best in treating this patient for Candida cystitis?","type":"Clinical Vignette","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-2c045086d512","stem":"A 43-year-old woman recently underwent allo geneic bone marrow transplantation after chemotherapy failed in the treatment of metastatic breast carcinoma. The patient has had a stormy hospital course after her transplant, with respiratory failure requiring mechanical ventilation. A month into her hospitalization, surveillance sputum cultures reveal Aspergillus fumigatus, and a new infiltrate appears on her chest radiograph. Which antifungal agent is recommended for the treatment of invasive pulmonary aspergillosis in this patient?","type":"Radiological Interpretation","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":true,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-c33bd570c2ae","stem":"A 57-year-old man with extensive onychomycosis (fungal toenail infection) asks you for an evaluation. He requests a prescription for itraconazole for treatment of this problem after seeing a television advertisement for this drug. He has chronic heart burn attributed to gastroesophageal reflux disease and is treated with the proton pump inhibitor omeprazole. He is taking lovastatin for treatment of hyperlipidemia. Three years ago he underwent cadaveric renal transplantation for end-stage kidney disease secondary to polycystic kidney disease and is taking cyclosporin to prevent transplant rejection. In prescribing itraconazole for this patient, what adjustments in his medication regimen do you recommend? (A) Discontinue omeprazole and substitute the H2 blocker ranitidine. (B) Discontinue omeprazole and substitute liquid antacids. (C) Discontinue omeprazole. (D) Continue lovastatin. (E) Increase cyclosporin dosing. LIPPINCOTT pg34 Questions 1 - 3: For each numbered phrase, select the ONE drug (A-E) that is most closely associated with it. Each drug may be selected once, more than once, or not at all.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[{"label":"A","text":"Flucytosine"},{"label":"B","text":"Griseofulvin"},{"label":"C","text":"Penicillin G"},{"label":"D","text":"Amphotericin-B"},{"label":"E","text":"Ketoconazole"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-bae2020f259b","stem":"Which one of the following drugs is not used for the treatment of systemic fungal infections?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[{"label":"A","text":"Amphotericin B."},{"label":"B","text":"Flucytosine."},{"label":"C","text":"Ketoconazole."},{"label":"D","text":"Griseofulvin."},{"label":"E","text":"Fluconazole."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-47652049a4e0","stem":"All of the following statements correctly describe ketoconazole EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[{"label":"A","text":"It inhibits the conversion of lanosterol to ergosterol."},{"label":"B","text":"It may produce gastrointestinal upsets."},{"label":"C","text":"It can cause gynecomastia in males."},{"label":"D","text":"It penetrates into the cerebrospinal fluid."},{"label":"E","text":"It should not be combined with amphotericin B."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-777221cf09a7","stem":"All of the following statements concerning griseofulvin are correct EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[{"label":"A","text":"It is only effective against dermatophytic infections."},{"label":"B","text":"It exacerbates acute intermittent porphyria."},{"label":"C","text":"It induces the hepatic cytochrome P-450 system."},{"label":"D","text":"It enhances CNS depressant effects of ethanol."},{"label":"E","text":"Its use in therapy for superficial mycotic infections is usually short term (several days)."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-3d3f6a9ccfcc","stem":"A 25-year-old male AIDS patient has a fever of 102°F and complains of severe headaches during the past week. Staining of his cerebrospinal fluid with India ink reveals Cryptococcus neoformans. The patient is admitted to the hospital and is treated with","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Intravenous amphotericin B plus flucytosine."},{"label":"B","text":"Oral ketoconazole."},{"label":"C","text":"Intrathecal amphotericin B."},{"label":"D","text":"Oral fluconazole."},{"label":"E","text":"Intravenous amphotericin B plus ketoconazole."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-4de6bae8f102","stem":"A 30-year-old male has had a heart transplant and is being maintained on the immunosuppressant, cyclosporine. He develops a Candida infection and is treated with ketoconazole. Why is this poor therapy?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Ketoconazole is not effective against Candida."},{"label":"B","text":"Ketoconazole reacts with cyclosporine to inactivate it."},{"label":"C","text":"Ketoconazole has a potential for cardiotoxicity."},{"label":"D","text":"Ketoconazole inhibits cytochrome P-450 enzymes that inactivate cyclosporine."},{"label":"E","text":"Ketoconazole causes gynecomastia and decreased libido in the male."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8bb0f5471e48","stem":"Which one of the following statements about fluconazole is most accurate?","type":"Clinical Vignette","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-cd0b6169b523","stem":"Which of the following is the drug of choice if this patient is suffering from persistent lung lesions or disseminated disease due to Coccidioides immitis?","type":"Clinical Vignette","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7ce41463111e","stem":"Which one of the following drugs is LEAST likely to be effective in the treatment of esophageal candidiasis if it is used by the oral route?","type":"Short Answer","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e48b271c4359","stem":"Which one of the following statements about flucytosine is accurate?","type":"Short Answer","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-689c8fd9c1d0","stem":"Which one of the following statements about terbinafine is false?","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b661d2acc7d5","stem":"Which one of the following drugs is most appropriate for oral use in vaginal candidiasis?","type":"Short Answer","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-1ab4785fe474","stem":"Since the portal of entry of a pathogen could not be positively identified, the patient was treated empirically (day 7) to cover for microorganisms known to cause systemic infections in a hospitalized patient with neutropenia. Such pathogens include Enterobacteriaceae, Pseu- domo,as aeruginosa, and staphylococci. What antibiotic regimen would be appropriate to cover for such microorganisms?","type":"Clinical Vignette","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-3dd883631864","stem":"What drugs would be used to cover for opportunistic infections due to drug-resistant staphylococci in the hospitalized neutropenic patient?","type":"Clinical Vignette","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d22b0611efad","stem":"What antifungal agents are used for treatment of candidiasis in the neutropenic patient?","type":"Clinical Vignette","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a504f112c908","stem":"Which drug, compared with the rest, would be expected to produce a significantly higher concentration of active metabolite in cells infected with its target virus?","type":"Short Answer","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-ed3d50d688fd","stem":"Which of the following drugs should not be given incombination with zidovudine because of an increased risk of myelosuppression?","type":"Short Answer","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-dc2a07d7fc66","stem":"Caitlyn Doe is a 24-year-old woman in her third month of pregnancy. She has had severe pain,swelling, and redness in both eyes for several days and has been unable to see well enough to go to work.Ms. Doe’s physician diagnosed herpes simplex keratoconjunctivitis; the infection has spread deep into the surrounding tissues.Which drug is indicated for HSV keratoconjunctivitis but is least likely to harm the fetus?","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d83f9bc33a20","stem":"Mitchell Jones, a 35-year-old man, began treatment for hepatitis C with interferon- -2b and ribavirin (Rebetron)4 weeks ago. On returning to his doctor for routine monitoring of his blood count and liver function, he complained of general fatigue and exertion when walking. His hemoglobin, CBC, differential, and platelet counts are shown in the accompanying table. Which is the most likely explanation of any abnormality?","type":"Short Answer","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-79727b09465d","stem":"All of the following statements about acyclovir are correct EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[{"label":"A","text":"It is the treatment of choice for influenza infections."},{"label":"B","text":"It is incorporated into the viral DNA causing premature DNA chain termination."},{"label":"C","text":"It is the treatment of choice in herpes simplex encephalitis."},{"label":"D","text":"It reduces the duration of lesions associated with genital herpes infections."},{"label":"E","text":"It inhibits only actively replicating viruses, not latent ones."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-0aa676256afd","stem":"All of the following statements about amantadine are correct EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[{"label":"A","text":"It is effective in the prophylaxis of influenza A infections."},{"label":"B","text":"It causes CNS disturbances at high doses."},{"label":"C","text":"It reduces the duration and severity of systemic symptoms of active influenza A."},{"label":"D","text":"It is extensively metabolized."},{"label":"E","text":"It is effective in the treatment of some cases of Parkinson's disease."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-11ee9544bb17","stem":"Which one of the following antiviral agents exhibits the greatest selective toxicity for the invading virus?","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Interferon"},{"label":"B","text":"Amantadine."},{"label":"C","text":"Acyclovir."},{"label":"D","text":"Zidovudine."},{"label":"E","text":"Ribavirin."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-0056a58d52f4","stem":"All of the following statements about zidovudine (AZT) are correct EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[{"label":"A","text":"It must be converted to the nucleotide form to express its antiviral activity."},{"label":"B","text":"It is incorporated into growing viral but not mammalian nuclear DNA."},{"label":"C","text":"It is currently used to treat severe herpesvirus and respiratory syncytial virus infections as well as AIDS."},{"label":"D","text":"It is toxic to bone marrow and causes adverse hematologic effects."},{"label":"E","text":"It penetrates the CNS. Questions 5 - 7: For each numbered phrase, select the ONE drug (A-E) that is most closely associated with it. Each drug (A-E) may be selected once, more than once, or not at all."},{"label":"A","text":"Amantadine"},{"label":"B","text":"Zidovudine (AZT)"},{"label":"C","text":"Ribavirin"},{"label":"D","text":"Vidarabine"},{"label":"E","text":"Ganciclovir"}],"priority":2,"status":"review","flags":["too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","too_many_options","too_many_options_possible_merge"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-48a73e197cff","stem":"Which one of the following statements about the mechanisms of action of antiviral drugs is LEAST accurate?","type":"Clinical Vignette","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antiviral","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-9b4e8648ff9d","stem":"Which one of the following statements about antiviral agents is LEAST accurate?","type":"Clinical Vignette","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antiviral","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-713ef87db292","stem":"Which of the following drugs is most likely to cause additive anemia and neutropenia if ad- ministered to an AIDS patient taking zidovudine?","type":"Clinical Vignette","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-4dd52911fe31","stem":"Which of the following drugs is most likely to be prescribed a| this time?","type":"Short Answer","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-2adfa5c517d3","stem":"Which one of the following statements about the drug management of genital herpes in this pa- tient is LEAST accurate?","type":"OSCE / Practical Station","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antiviral","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-48baca2d6cc7","stem":"Regarding interferon alpha, which one of the following statements is LEAST accurate?","type":"Clinical Vignette","subject":"Human Anatomy","topic":"Upper Limb","topicOriginal":"Upper Limb","subtopic":"Arm","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Upper Limb","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-81b6253850d7","stem":"Which one of the following statements about stavudine is accurate?","type":"Short Answer","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-c8c6c8da8e0a","stem":"A 35-year-old man under treatment for pulmonary tuberculosis has acute-onset right big toe pain, swelling, and low- grade fever. His physical examination was consistent with gouty arthritis, and he was found to have high serum uric acid levels. Which of the following antituberculosis drugs is known to cause high uric acid levels?","type":"Short Answer","subject":"Internal Medicine","topic":"Respiratory Medicine","topicOriginal":"Respiratory Medicine","subtopic":"Tuberculosis","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Respiratory Medicine","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"cbda09f9133f3b08588321e178a22c4009c9ded8"},{"id":"q-cdc55b54dd7b","stem":"A 26-year-old truck driver, a recent immigrant from Mexico, could not obtain a Florida driving license because of his poor performance in red-green color vision discrimination. He denies any family history of color vision–related problems in the past. He is taking a four-drug regimen for pulmonary tuberculosis. He does not recall the names of the drugs.Which of the following antituberculosis drugs is responsible for his lack of color vision discrimination?","type":"Clinical Vignette","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"b35dc5250bd8f99623b9ba1baa37aa4b76dca860"},{"id":"q-80aca66f3764","stem":"A 68-year-old white South African man receiving treatment for lepromatous leprosy has increasing red-brown pigmentation.Which of the following antileprosy drugs is responsible for the patient’s skin pigmentation?","type":"Clinical Vignette","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-cdba9810cac3","stem":"A 23 year-old college student is diagnosed with Neisseria meningitidis based on his clinical presentation, gram-negative diplococci on Gram stain, and isolation of bacteria from cerebrospinal fluid.Which of the following drugs can be used as a prophylactic agent for roommates and other close contacts?","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"accc0987f3945623d2474b3aa96fbbdea733af44"},{"id":"q-de943bac4c6b","stem":"A 32-year-old Haitian man has acute-onset confusion and suicidal ideation.Two weeks ago he began combination therapy for multi–drug resistant pulmonary tuberculosis. He has a history of depression that required intermittent treatment in the past.Which of the following antitubercular agents is responsible for the patient’s neurological symptoms?","type":"Clinical Vignette","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"5bf59276c9d92dc2cb6a860d932600859ba6ce60"},{"id":"q-0bd2c1882764","stem":"When treatment is started, which one of the following drug regimens should be initiated in this patient?","type":"Clinical Vignette","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b1bd56454f45","stem":"Which of the following statements concerning the possible use of isoniazid (INH) in this pa- tient is false?","type":"Short Answer","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-af9b87612a9c","stem":"Which one of the following statements concerning drugs used in leprosy is false?","type":"Clinical Vignette","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-c70e24877983","stem":"A 10-year-old boy has uncomplicated pulmonary tuberculosis. After initial hospitalization, he is now being treated at home with isoniazid, rifampin, and ethambutol. Which one of the fol- lowing statements about this case is false?","type":"Clinical Vignette","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b70228d56fc1","stem":"Which one of the following statements about ethambutol is false?","type":"Short Answer","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-61d444d1489a","stem":"Which one of the following statements about pyrazinamide is false?","type":"Clinical Vignette","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-da62ee3882e1","stem":"Which one of the following drugs is most likely to cause loss of equilibrium and auditory damage?","type":"Radiological Interpretation","subject":"Internal Medicine","topic":"Respiratory Medicine","topicOriginal":"Respiratory Medicine","subtopic":"Tuberculosis","suggestedTopic":null,"options":[],"priority":2,"status":"review","flags":["requires_visual_review"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":true,"displaySubject":"Internal Medicine","displayTopic":"Respiratory Medicine","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-8cb4566ff9b7","stem":"What is the most appropriate drug regimen if resistance to INH is known to exceed 4%?","type":"Clinical Vignette","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-67ee890dfbca","stem":"What factors influence the risk of multidrug-resistant tuberculosis?","type":"Clinical Vignette","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-9939ab2464a7","stem":"What is the most appropriate drug regimen if there is known resistance to both 1NH and rifampin?","type":"Clinical Vignette","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-dadd1e63c7d4","stem":"1 All of the following statements about rifampin are correct EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[{"label":"A","text":"It is frequently used prophylactically for household members exposed to meningitis caused by meningococci or Haemophilus influenzae."},{"label":"B","text":"It colors body secretions orange-red."},{"label":"C","text":"It disrupts bacterial lipid metabolism as its major mechanism of action."},{"label":"D","text":"Although rare, it can cause serious hepatotoxicity."},{"label":"E","text":"When used alone, there is a high risk of the emergence of resistant strains of mycobacteria."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e742b0df6d70","stem":"2 All of the following statements about isoniazid are correct EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[{"label":"A","text":"It produces age-dependent hepatotoxicity."},{"label":"B","text":"It readily penetrates into infected cells."},{"label":"C","text":"It inhibits mycolic acid synthesis in susceptible mycobacteria."},{"label":"D","text":"It may induce the symptoms of cyanocobalamin (vitamin B12) deficiency."},{"label":"E","text":"It potentiates the adverse effects of phenytoin when the patient receives both medications concurrently. =MODERN PHAMACOLOGY= Aminoglycoside Antibiotics"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-3ebc1aeb003a","stem":"Many antibiotics are not useful in treating infections in the central nervous system because they do not readily penetrate the blood-brain barrier.Which one of the following agents does get into the brain in reasonable concentrations?","type":"Short Answer","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-9ccb5492b6d3","stem":"Aminoglycoside antibiotics are frequently used incombination with the bete-lactam antibiotics.Which of the following choices best explains the rationale for this use?","type":"Short Answer","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-4c146629d890","stem":"Which of the following best treats the initial stage of Lyme disease in adults?","type":"Short Answer","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-c51f752f616b","stem":"Chloramphenicol is the drug of choice for which of the following?","type":"Short Answer","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d084dfcc5f28","stem":"A 39-year-old man has AIDS and a CD4 count less than 50. Recently he has had chills and fever.Several blood cultures drawn especially for acid-fast bacilli are positive.Which antibiotic should be included in a treatment regimen for this disease?","type":"Short Answer","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-6647f170ff78","stem":"A 37-year-old postal worker has a job at a mail sort facility.An envelope that passed through the facility and was delivered to a governmental office was noted upon opening to have anthrax spores. One of the postal worker’s fellow employees subsequently developed inhalation anthrax. Because of this, medical authorities recommended that other employees working at the same facility be tested and receive prophylactic antimicrobial therapy.The drug of choice is a quinolone. However, this employee has a history of allergy to ciprofloxacin.Which of the following antibiotics is also recognized as being effective prophylactic therapy for potential anthrax exposure?","type":"Clinical Vignette","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antimicrobial","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-8a4075dde36a","stem":"Which glycopeptide or polypeptide antibiotic is still investigational and not used in the United States for parenteral therapy?","type":"Short Answer","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-bf25d58e1dc9","stem":"A 35-year-old man under treatment for pulmonary tuberculosis has acute-onset right big toe pain,swelling, and low- grade fever. His physical examination was consistent with gouty arthritis, and he was found to have high serum uric acid levels. Which of the following antituberculosis drugs is known to cause high uric acid levels?","type":"Short Answer","subject":"Internal Medicine","topic":"Respiratory Medicine","topicOriginal":"Respiratory Medicine","subtopic":"Tuberculosis","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Respiratory Medicine","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"cbda09f9133f3b08588321e178a22c4009c9ded8"},{"id":"q-49f9c839be1f","stem":"A 26-year-old truck driver, a recent immigrant from Mexico, could not obtain a Florida driving license because of his poor performance in red-green color vision discrimination. He denies any family history of color vision–related problems in the past. He is taking a four-drug regimen for pulmonary tubercu, losis. He does not recall the names of the drugs. Which of the following antituberculosis drugs is responsible for his lack of color vision discrimination?","type":"Clinical Vignette","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"b35dc5250bd8f99623b9ba1baa37aa4b76dca860"},{"id":"q-0ccab9cddbad","stem":"A 23 year-old college student is diagnosed with Neisseria meningitidis based on his clinical presentation, gram-negative diplococci on Gram stain, and isolation of bacteria from cerebrospinal fluid.Which of the following drugs can be used as a prophylactic agent for roommates and other close contacts?","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"accc0987f3945623d2474b3aa96fbbdea733af44"},{"id":"q-98a32a32798f","stem":"A 32-year-old Haitian man has acute-onset confusion and suicidal ideation.Two weeks ago he began combination therapy for multi–drug resistant pulmonary tuberculosis. He has a history of depression that required intermittent treatment in the past.Which of the following antitubercular agents is responsible for the patient’s neurological symptoms?","type":"Clinical Vignette","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"5bf59276c9d92dc2cb6a860d932600859ba6ce60"},{"id":"q-009dd45e6b8a","stem":"following statements is accurate?","type":"Short Answer","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f7bfa40cd6fc","stem":"would be extremely useful in treating this condition?","type":"Short Answer","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antifungal","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b477e8bdfce1","stem":"Binding of a drug to plasma proteins will tend to","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Decrease half-life."},{"label":"B","text":"Decrease its rate of glomerular filtration."},{"label":"C","text":"Increase its rate of biotransformation."},{"label":"D","text":"Increase its concentration in the plasma."},{"label":"E","text":"Increase its pharmacological activity."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a239c750e1ca","stem":"Dose-response curves are used for drug evaluation in the animal laboratory and in the clinic. Quantal dose-response curves are","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Used for determining the therapeutic index of a drug"},{"label":"B","text":"Used for determining the maximal efficacy of a drug"},{"label":"C","text":"More precisely quantitated than ordinary graded dose-response curves"},{"label":"D","text":"Obtainable from the study of intact subjects but not from isolated tissue preparations"},{"label":"E","text":"Used to determine statistical variation (standed deviation) of the maximal response to the drug"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"e6173bf264e2c6c0ef1774584f339b186922628c"},{"id":"q-7349aecf5f3e","stem":"Compared to the average adult dose, the recommended dose of a drug for elderly patients will likely be","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Less than average due to increased biotransformation."},{"label":"B","text":"Less than average due to decreased renal function or excretion"},{"label":"C","text":"More than average due to decreased plasma protein binding capacity."},{"label":"D","text":"More than average due to increased renal excretion."},{"label":"E","text":"Totally unpredictable."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-557ee7daa097","stem":"Which one of the following statements is applicable to absorption of drugs from the gastrointestinal tract?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"Absorption of weak acids occurs only from the stomach and not from the small intestine."},{"label":"B","text":"Some drugs are metabolized extensively by the liver and do not reach the general circulation (first-pass effect)"},{"label":"C","text":"All the drugs are stable at the low pH of the stomach."},{"label":"D","text":"Rectal administration is the best way to give irritating drugs."},{"label":"E","text":"Ingesting drugs with food always enhances drug absorption."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"d66755fac5e7ec9c4c784b5fee9303c5e4dc0e92"},{"id":"q-fcd87c364544","stem":"Which of the following statements about spare receptor is MOST correct","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Spare receptors, in the absence of drug, are sequestered in the cytoplasm"},{"label":"B","text":"Spare receptors may be detected by finding that the drug-receptor interaction longer than the intracellular effect"},{"label":"C","text":"Spare receptors influence the maximal efficacy of the drug-receptor system"},{"label":"D","text":"Spare receptors activate the effector machinery of the cell without the need for a drug"},{"label":"E","text":"Spare receptors may be detected by the finding that the EC50 is smaller than the Kd for the agonist"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"]},{"id":"q-f7dc4d8c6dbb","stem":"A patient is treated chronically with a drug (A) metabolized by CYP 3A4. Recently he administer another drug (B) which is an enzymatic inducer of the CYP2D6.Which of the following is likely to occur","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Longer half life of drug (A)"},{"label":"B","text":"Longer half life of drug (B)"},{"label":"C","text":"Enhanced pharmacological effect of drug A"},{"label":"D","text":"No significant drug interaction"},{"label":"E","text":"Reduced pharmacological effect of drug B"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4cc1ba0ffcc9","stem":"All of the following are applicable to the concept of the blood-brain barrier EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Restricts the entry of hydrophilic compounds into the brain."},{"label":"B","text":"Has as one component, endothelial cells with pores accessible only by compounds of less than 200 Daltons."},{"label":"C","text":"Is penetrated only by organic solvents which are used as general anesthetic agents."},{"label":"D","text":"Is between the plasma space and the interstitial space of the brain."},{"label":"E","text":"Drugs which are well absorbed from the G.I.T penetrate well into the brain."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-26530b675041","stem":"What happen if valproic acid ( strongly bound to albumin) and imipramine, a tricyclic antidepressant ( bound to alpha acid glycoprotein)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Central Nervous System Drugs","topicOriginal":"Central Nervous System Drugs","subtopic":"Antidepressant","suggestedTopic":null,"options":[{"label":"A","text":"Potential toxicity of valproic acid."},{"label":"B","text":"significant increase in free level of both drugs."},{"label":"C","text":"Enhanced biotransformation of valproic acid."},{"label":"D","text":"increase in volume of distribution of imipramin"},{"label":"E","text":"No interference in protein binding is expected / No pharmacokinetic drug- drug interaction is expected"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Central Nervous System Drugs","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-2b6f1492a357","stem":"A drug with half life of about 24h was prescribe orally at the dose of 100mg once daily. After two weeks, the dose was changed to, 200mg once daily. Following this change in treatment","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"The mean plasma concentration doubles."},{"label":"B","text":"The plasma half life of the drug doubles"},{"label":"C","text":"the difference between the maximum plasma concentration (peak) and minimal (trough) become very small."},{"label":"D","text":"the volume of distribution of the drug double."},{"label":"E","text":"The time required to reach the steady state of concentration decrease by a half"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-38fde57b37a7","stem":"In general, biotransformation usually results in a product which is more","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Likely to produce side effects."},{"label":"B","text":"Likely to distribute intracellularly."},{"label":"C","text":"Lipid soluble than the original drug."},{"label":"D","text":"Likely to be reabsorbed by kidney tubules."},{"label":"E","text":"Water soluble than the original drug."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"]},{"id":"q-87082878d780","stem":"For a drug eliminated by a first-order kinetic process","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A constant amount of drug is eliminated per unit time."},{"label":"B","text":"The duration of action will be longer than for a drug eliminated by zero-order process."},{"label":"C","text":"The elimination rate constant will be independent of the dose administered."},{"label":"D","text":"It is unlikely to bind significantly to plasma albumin."},{"label":"E","text":"The apparent volume of distribution will vary with time."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0850558260eb","stem":"Enzyme inhibitors such as Cimetidine and Erythromycin are likely to produce","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Proteins and Enzymes","topicOriginal":"Proteins and Enzymes","subtopic":"Enzyme","suggestedTopic":null,"options":[{"label":"A","text":"Increase rate of breakdown of some drugs"},{"label":"B","text":"increase free level of some drugs"},{"label":"C","text":"inhibition of certain enzymes which break down some drugs."},{"label":"D","text":"improvement of bioavailability of some drugs"},{"label":"E","text":"Reduction the toxicity of some drugs."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Proteins and Enzymes","answerAuditStatus":"independent_provisional_reasoning","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-b532480bff27","stem":"A competitive reversible antagonist","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Shifts the dose-response curve of an agonist to the right."},{"label":"B","text":"Decreases the maximal response produced by agonists acting on the same receptor."},{"label":"C","text":"Produces an effect which is mathematically equivalent to decreasing the efficacy of the agonist."},{"label":"D","text":"Increases the efficacy of the agonist."},{"label":"E","text":"Binds to the receptor by covalent bonding."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-af3ef4c28d68","stem":"Regarding binding of drugs to plasma albumin","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"All drugs are strongly bound to albumin."},{"label":"B","text":"Binding of drugs enhance there therapeutic effects."},{"label":"C","text":"Binding of drugs to albumin enhance their elimenation."},{"label":"D","text":"Albumin binds reversibly certain acidic drugs."},{"label":"E","text":"drugs bound to albumin crosses membranes easily."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c4b3a3d0728a","stem":"An experiment was performed to determine the median effective dose (ED50) for causing hypnosis and the median lethal dose (LD50) of a drug. The ED50 was found to be 1 mg. The LD50 was found to be 300mg. What is the therapeutic index for this drug?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"300."},{"label":"B","text":"30."},{"label":"C","text":"Less than 10."},{"label":"D","text":"3."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-cda330b1f9d7","stem":"The following statement concerning pre-systemic metabolism are true except","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Molecular Biology","topicOriginal":"Molecular Biology","subtopic":"Gene","suggestedTopic":null,"options":[{"label":"A","text":"is the metabolism of administrated drugs before reaching systemic circulation."},{"label":"B","text":"it can be avoided by giving the drug via another route of administration."},{"label":"C","text":"it usually leads to decrease drug bioavailability."},{"label":"D","text":"drugs with extensive first pass effect may be ineffective orally."},{"label":"E","text":"it is usually occurs due to enzyme induction or inhibition."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Molecular Biology","answerAuditStatus":"independent_provisional_reasoning","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"]},{"id":"q-9973d0292c16","stem":"Which of the following is a receptor that is not located on the plasma membrane?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Nicotinic receptor."},{"label":"B","text":"Muscarinic receptor."},{"label":"C","text":"G protein."},{"label":"D","text":"Adenylyl cyclase."},{"label":"E","text":"Steroid receptor."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-86f4366366e6","stem":"Enzyme inducers, such as phenyoin and carbamazepine are likely to produce","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Proteins and Enzymes","topicOriginal":"Proteins and Enzymes","subtopic":"Enzyme","suggestedTopic":null,"options":[{"label":"A","text":"An increase in bioavailability of many drugs."},{"label":"B","text":"decrease of absorption of many other drugs."},{"label":"C","text":"An increase in effect of many other drugs"},{"label":"D","text":"a possible acceleration of the catabolism of certain other drugs"},{"label":"E","text":"a decrease in protein binding of many drugs"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Proteins and Enzymes","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[],"manualEdits":{}},{"id":"q-483712281e47","stem":"The following statements concerning drugs metabolism are true. Except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Metabolites are generally more polar than parent drug."},{"label":"B","text":"metabolites are usually inactive or less active than the parent drug."},{"label":"C","text":"neonates have deficiency in phase II (conjugation) metabolic pathway."},{"label":"D","text":"metabolizing enzyme can't be inhibited by other drugs."},{"label":"E","text":"the rate of metabolism by certain CYP are genetically."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-aa03b5f342e6","stem":"Substances strongly suspected or known to be capable of harming the fetus when consumed by a pregnant woman include all of the following EXCEPT","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Sex hormones."},{"label":"B","text":"Oral anticoagulants (warfarin)."},{"label":"C","text":"Alcohol."},{"label":"D","text":"Anticancer (cytotoxic) drugs."},{"label":"E","text":"Penicillins."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-582477dc5b41","stem":"Which of the following names best describes an antagonist that interacts directly with the agonist and not at all, or only incidentally, with the receptor","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Chemical antagonist"},{"label":"B","text":"Noncompetitive antagonist"},{"label":"C","text":"Partial agonist"},{"label":"D","text":"Pharmacologist antagonist"},{"label":"E","text":"Physiologic antagonist"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-62a2efecaf2f","stem":"The following route of administration is likely to associated with significant first pass effect observed with certain drugs","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"oral"},{"label":"B","text":"sublingual"},{"label":"C","text":"intramuscular"},{"label":"D","text":"Rectal"},{"label":"E","text":"transdermal."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"]},{"id":"q-51e40f88e13d","stem":"All of the following statements regarding adverse drug reactions are correct EXCEPT?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Pharmacokinetic mechanisms are unimportant in causation."},{"label":"B","text":"Young children cannot be regarded as “small adults” as far as liability to adverse drug reactions is concerned."},{"label":"C","text":"The first few weeks of life is a period of special risk."},{"label":"D","text":"Old age is a period of special risk."},{"label":"E","text":"Atmospheric pollution in hospitals may be a cause."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-40d273349bb0","stem":"All the following statements regarding adverse drug reactions are correct EXEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Pharmacokinetic mechanisms are unimportant in causation."},{"label":"B","text":"Young children cannot be regarded as \"small adults\" as far as liability to adverse drug reactions is concerned."},{"label":"C","text":"The first few weeks of life is a period of special risk."},{"label":"D","text":"Re-exposure to a small dose is enough to cause illness."},{"label":"E","text":"Atmospheric pollution in hospitals may be a cause."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6e658637cef0","stem":"Which of the following provides information about the variation in sensitivity to a drug within the population studied","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Drug potency"},{"label":"B","text":"Graded-dose-response curve"},{"label":"C","text":"Maximal efficacy"},{"label":"D","text":"Quantal dose-response curve"},{"label":"E","text":"Therapeutic index"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-61cbd4cb2c56","stem":"kinetic that are characteristic of elimination of ethanol, high dose of aspirin and phenytoin are called","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"distribution"},{"label":"B","text":"excretion"},{"label":"C","text":"first pass effect"},{"label":"D","text":"first order elimination"},{"label":"E","text":"zero order elimination"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b8b808d4a5a0","stem":"The following statements concerning renal elimination of drug are true. Except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"alklinization of urine will enhance elimination certain acidic drugs."},{"label":"B","text":"measurement of creatinine clearance can be used for assessment of renal function."},{"label":"C","text":"some drugs are mainly eliminated by kidney"},{"label":"D","text":"renal elimination is greatly affected by age & gender."},{"label":"E","text":"most drugs are eliminated by active tubular secretion"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-57b3ef00cd9f","stem":"All of the following are phase I biotransformation reactions EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Sulfoxide formation."},{"label":"B","text":"Sulfate conjugation."},{"label":"C","text":"Nitro reduction."},{"label":"D","text":"Ester hydrolsis."},{"label":"E","text":"Deamination."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"]},{"id":"q-937f14331725","stem":"Important manifestations of drug allergy include all of the following EXCEPT","type":"OSCE / Practical Station","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Thrombocytopenia."},{"label":"B","text":"Leukemia."},{"label":"C","text":"Aplastic anemia."},{"label":"D","text":"Hemolysis."},{"label":"E","text":"Granulocytopenia."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c2d1cd477b5a","stem":"Which of the following most accurately describes the transmembrane signaling process involved in steroid hormone action?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Action on a membrane-spanning tyrosine kinase?"},{"label":"B","text":"Activation of G protein, which activates or inhibits adenyl cyclase."},{"label":"C","text":"Diffusion across the membrane and binding to an intracellular receptor."},{"label":"D","text":"Diffusion of STAT molecules across the membrane."},{"label":"E","text":"Opening of the transmembrane ion channnel."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"9377d4b3c7563a23fe66468d70683fcb01110e7f"},{"id":"q-b5c1474e61eb","stem":"Variation in the sensitivity of a population of individuals to increasing doses of a drug is best determined by which of the following?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Efficacy"},{"label":"B","text":"Potency"},{"label":"C","text":"Therapeutic Index"},{"label":"D","text":"Graded dose-response curve"},{"label":"E","text":"Quantal dose-response curve"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5f9d478abd29","stem":"In the absence of other drugs, pindolol causes an increase in heart rate by activating beta adrenoceptors. In the presence of highly effective beta stimulants. However, pindolol causes a dose-dependant, reversible decrease in heart rate. Therefore, pindolol should be classified as","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A chemical antagonist"},{"label":"B","text":"An irreversible antagonist"},{"label":"C","text":"A partial agonist"},{"label":"D","text":"A physiologic antagonist"},{"label":"E","text":"A spare receptor agonist"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-59873bdd961a","stem":"All of the following statements related to the binding of drugs by plasma proteins are correct EXCEPT?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Bound drug is unable to diffuse into tissue until it becomes unbound."},{"label":"B","text":"A drug that is bound by plasma proteins will have a smaller apparent volume of distribution than if it were not bound."},{"label":"C","text":"Displacement of the bound drug by another drug can increase the effects of a given dosage of the first drug."},{"label":"D","text":"Acidic drugs are bound mostly to plasma albumin."},{"label":"E","text":"bound drug is the pharmacologically active part of the drug."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-824a4fce3f2e","stem":"The term that refers to the rapid diminution of responsiveness following administration of a drug is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Hyporeactivity."},{"label":"B","text":"Tachyphylaxis."},{"label":"C","text":"Idiosyncratic drug response."},{"label":"D","text":"Tolerance."},{"label":"E","text":"Drug inactivation."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"]},{"id":"q-0608af961da7","stem":"Correct statements concerning characteristics of a particular route of drug administration include all of the following EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Intravenous administration provides a rapid response."},{"label":"B","text":"Oral administration requires that the patient be alert."},{"label":"C","text":"Intramuscular administration requires sterile technique."},{"label":"D","text":"Subcutaneous administration may cause local irritation."},{"label":"E","text":"Inhalation provides slow access to the general circulation."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d41abddc92f6","stem":"Factors affecting drug bioavailability include the following except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"its physiochemical properties ( molecular weight, stability in GIT etc)"},{"label":"B","text":"binding of drugs to plasma protein ( albumin or a-acid glycoprotein)"},{"label":"C","text":"dosage form ( table, syrup etc)"},{"label":"D","text":"physiological & pathological variables ( gastric emptying time, diarrhea)"},{"label":"E","text":"its interaction with food or other drugs."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a4abe589fd31","stem":"Which one of the following is TRUE for a drug whose elimination from plasma shows first-order Kinetics?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"The half-life of the drug is proportional to the drug concentration in the plasma."},{"label":"B","text":"The amount eliminated per unit time is constant."},{"label":"C","text":"The rate of elimination is proportional to the plasma concentration."},{"label":"D","text":"Elimination involves a rate-limiting enzymic reaction operating at its maximal velocity (Vm)."},{"label":"E","text":"A plot of drug concentration versus time is a straight line ."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-974ba43d3a6c","stem":"According to alphabetical classification of types of adverse drug effects, anaphylaxis from penicillin injection is an adverse drug effect type","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antimicrobials","options":[{"label":"A","text":"A."},{"label":"B","text":"B."},{"label":"C","text":"C."},{"label":"D","text":"D."},{"label":"E","text":"E."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c5fab558d30c","stem":"All of the following statements are true EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Aspirin (pka=3.5) is 90% in its lipid-soluble, protonated form at pH=2.5."},{"label":"B","text":"Absorption of a weakly basic drug is likely to occur faster from the intestine than from the stomach."},{"label":"C","text":"The basic drug promethazine ( pKa=9.1) is more ionized at pH =7.4 than at pH=2."},{"label":"D","text":"Acidification of the urine accelerates the secretion of a weak base, pKa=8."},{"label":"E","text":"Uncharged molecules more readily cross cell membranes than charged molecules."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"5aa92e4fca419989e4c3d66877d572fac2df9fc4"},{"id":"q-86a7b0fd78a0","stem":"In pregnancy the following statements are correct EXCEPT","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Antenatal Care · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antenatal Care","options":[{"label":"A","text":"Gross anatomical defects in the fetus are unlikely to result from drugs in late pregnancy."},{"label":"B","text":"Sex hormones, when taken during pregnancy, may harm the fetus."},{"label":"C","text":"A vasoconstrictor drug may cause fetal distress."},{"label":"D","text":"Cytotoxic or anticancer drugs given to the mother are safe during pregnancy."},{"label":"E","text":"Teratogenic drugs may produce harmful effect, especially if given in early pregnancy. | P a g e ٨ General Pharmacology MCQs"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Antenatal Care · Suggested","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-290bafad4747","stem":"All of the following drugs are hepatic microsomal enzyme inducers EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Phenobarbitone."},{"label":"B","text":"Phenylbutazone."},{"label":"C","text":"Phenytoin."},{"label":"D","text":"Rifampin."},{"label":"E","text":"Cimetidine."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-20364107c59f","stem":"The following reactions are related to pharmacogenetic abnormalities EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Succinylcholine apnea."},{"label":"B","text":"Slow and fast acetylation of isoniazed and sulfonamide."},{"label":"C","text":"Glucose -6- phosphate dehydrogenase deficiency induced hemolytic anemia after exposure to primaquine."},{"label":"D","text":"Increased resistance to the anticoagulant action of warfarin."},{"label":"E","text":"Bradycardia due to β- adrenoreceptor antagonists."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0b8b14e4bf4b","stem":"Drug X and Y have the same mechanism of antihypertensive action. Drug X in a dose of 10 mg produces the same response as 100 mg of drug Y. This suggests that","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Cardiovascular Drugs","topicOriginal":"Cardiovascular Drugs","subtopic":"Antihypertensive","suggestedTopic":null,"options":[{"label":"A","text":"Drug Y is less efficacious than drug X."},{"label":"B","text":"Toxicity of drug X is less than that of drug Y."},{"label":"C","text":"Drug X is about 10 times more potent than drug Y."},{"label":"D","text":"Drug X is safer than drug Y."},{"label":"E","text":"Drug X will have a shorter duration of action than drug Y because less of drug X is present for a given time."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular Drugs","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-090f83a978af","stem":"Which of the following are methods for avoiding “first-pass “metabolism of the drug by the liver ?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"Subcutaneous injection of epinephrine."},{"label":"B","text":"Sublingual administration of nitroglycerin."},{"label":"C","text":"Intramuscular administration of propranolol."},{"label":"D","text":"Transdermal application of nitroglycerin."},{"label":"E","text":"All of the above."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-88c35e391d6e","stem":"A 55-year-old woman with heart failure is to be treated with a diuretic drug. Drugs X and Y have the same mechanism of diuretic actions. Drug X in a dose of 5 mg produces the same magnitude of dieresis as 500 mg of drug Y. this suggests that","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Cardiovascular Drugs","topicOriginal":"Cardiovascular Drugs","subtopic":"Heart Failure","suggestedTopic":null,"options":[{"label":"A","text":"drug Y is less efficacious than drug X"},{"label":"B","text":"drug X is about 100 times more potent than drug Y"},{"label":"C","text":"toxicity of drug X is less than that of drug Y"},{"label":"D","text":"drug X is a safer drug than drug Y"},{"label":"E","text":"drug X will have shorter duration of action than drug Y because less of drug X is present for a given effect"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular Drugs","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-228244aa5435","stem":"Concerning drug-plasma protein binding","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Volume of distribution is not influenced by protein binding"},{"label":"B","text":"Drug clearance is not influenced by the extent of protein binding"},{"label":"C","text":"Drug-plasma albumin binding is usually highly selective"},{"label":"D","text":"Renal failure may decrease drug bound fraction because of reduced plasma albumin"},{"label":"E","text":"Drugs are seldom bound to plasma proteins"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"]},{"id":"q-90bb50cbc6dc","stem":"Termination of pharmacological action of thiopental occurs mainly by","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Metabolism"},{"label":"B","text":"Rabid excretion"},{"label":"C","text":"Redistribution"},{"label":"D","text":"Strong binding to plasma protein"},{"label":"E","text":"Inactivation in the brain tissues"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-79b8fee010b0","stem":"Characteristics of drug conjugates (following conjugation reactions)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Are more polar compounds"},{"label":"B","text":"Are less readily excreted"},{"label":"C","text":"Are typically more pharmacologically active"},{"label":"D","text":"Usually occurs in the kidneys"},{"label":"E","text":"Usually involve hydrolysis , oxidation and reduction"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2822b38f1ffa","stem":"Cytochrome P450 induction (increased, amount of P450 enzyme protein) is often associated with","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Proteins and Enzymes","topicOriginal":"Proteins and Enzymes","subtopic":"Enzyme","suggestedTopic":null,"options":[{"label":"A","text":"Increased enzyme synthesis rates and metabolism for certain drugs"},{"label":"B","text":"Redacted enzyme synthesis rates and metabolism for certain drugs"},{"label":"C","text":"Enhanced protein binding for certain drugs"},{"label":"D","text":"Enhanced bioavailability for certain drugs"},{"label":"E","text":"Prolonged half-life for certain drugs"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Proteins and Enzymes","answerAuditStatus":"independent_provisional_reasoning","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-2f299e0bd0de","stem":"Features that influence drug bioavailability include all of the following except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"First pass hepatic metabolism"},{"label":"B","text":"Lipid solubility of the drug"},{"label":"C","text":"Chemical stability of the drug"},{"label":"D","text":"Nature of drug formulation"},{"label":"E","text":"plasma protein binding of the drug"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-bed30a5b8322","stem":"The following statements concerning distribution of drugs are true . Except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the rate of delivery of drugs to tissues such as muscles , is usually slow."},{"label":"B","text":"blood brain barrier prevents many polar drugs from entering into the brain."},{"label":"C","text":"Protein bound drugs can’t distribute into tissues."},{"label":"D","text":"Drugs strongly bound to plasma proteins usually show low volume of distribution."},{"label":"E","text":"Volume of distribution is used to calculate the dosing interval."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d0f5b3276c35","stem":"The therapeutic index of a drug is a measure of its","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"Potency"},{"label":"B","text":"Efficacy"},{"label":"C","text":"Safety"},{"label":"D","text":"Dose variability"},{"label":"E","text":"Affinity"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1e08a8fee6d7","stem":"Which one of the following statements is applicable to absorption of drugs from the gastrointestinal tract?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"Absorption of weak acids occurs only from the stomach and not from the small intestine."},{"label":"B","text":"Some drugs are metabolized extensively by the liver and do not reach the general circulation(first-pass effect)"},{"label":"C","text":"All the drugs are stable at the low pH of the stomach."},{"label":"D","text":"IM rout of administration do not require sterile techniques."},{"label":"E","text":"Ingesting drugs with food always enhances drug absorption."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"],"duplicateStemGroup":"d66755fac5e7ec9c4c784b5fee9303c5e4dc0e92"},{"id":"q-240662b5a7b9","stem":"The addition of glucoronic acid to a drug","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Decrease its water solubility"},{"label":"B","text":"Usually leads to inactivate the drug"},{"label":"C","text":"Is an example of phase I reaction"},{"label":"D","text":"Occur at the same rate in adults & newborns"},{"label":"E","text":"Involves cytochrome P450"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f5d6f78dfb08","stem":"All of the following conditions tend to increase the patient response to drugs except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Congestive heart failure"},{"label":"B","text":"Hepatic cirrhosis"},{"label":"C","text":"Hyperthyroidism"},{"label":"D","text":"Hypothyroidism"},{"label":"E","text":"Hyperalbuminemia"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ef6ecc8ffaf1","stem":"Type A adverse reaction is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Not related to the normal pharmacological effect"},{"label":"B","text":"Related to the normal pharmacological effect"},{"label":"C","text":"Related to the normal pharmacological effect with exaggerated response"},{"label":"D","text":"An immunological reaction of the drug"},{"label":"E","text":"A genetically determined drug-related reaction"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-126908d5570a","stem":"Two drugs may act on the same tissue or organ through independent receptors, resulting in effects in opposite directions. This is known as","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Physiologic antagonism"},{"label":"B","text":"Competitive antagonism"},{"label":"C","text":"Irreversible antagonism"},{"label":"D","text":"Chemical antagonism"},{"label":"E","text":"Dispositional antagonism"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7bb6877db87b","stem":"The pharmacokinetic value that most reliably reflects the amount of drug reaching the target tissue after oral administration is the","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Pharmacokinetic","suggestedTopic":null,"options":[{"label":"A","text":"Peak blood concentration"},{"label":"B","text":"Time to peak blood concentration"},{"label":"C","text":"Product of the Vd and the first-order rate constant"},{"label":"D","text":"Vd"},{"label":"E","text":"Area under the blood concentration-time curve (AUC)"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d37f49535fb3","stem":"Which one of the following is phase II biotransformation reaction","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Sulfoxide formation."},{"label":"B","text":"Nitro reduction."},{"label":"C","text":"Ester hydrolysis."},{"label":"D","text":"Sulfate conjugation."},{"label":"E","text":"Deamination."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3c0a7ee60d4d","stem":"Pharmacokinetic drug interactions can result from all of the following except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Pharmacokinetic","suggestedTopic":null,"options":[{"label":"A","text":"Impaired absorption"},{"label":"B","text":"Induction of the drug microsomal enzyme metabolizing system"},{"label":"C","text":"Inhibition of the drug microsomal enzyme metabolizing system"},{"label":"D","text":"Inhibition of renal excretion"},{"label":"E","text":"The combination of a bacteriostatic and bacteriosidal antibiotic"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"]},{"id":"q-d417597ad00f","stem":"Most weak acid drugs as well as weak base drugs are absorbed primary from the small intestine after oral administration because","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Both types are more ionized in the small intestine"},{"label":"B","text":"Both types are less ionized in the small intestine"},{"label":"C","text":"The blood flow is greater in the small intestine than that of other parts of the gut"},{"label":"D","text":"The surface area of the intestine is greater than other parts of the gut"},{"label":"E","text":"The small intestine has non-specific carriers for most drugs"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ec9cdf144436","stem":"Which of the following statements is correct","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"If 10 mg drug A produces the same response as 100 mg of drug B, Drug A is more efficacious than drug B"},{"label":"B","text":"The greater the efficacy, the greater the potency of a drug"},{"label":"C","text":"In selecting a drug , potency is usually more important than efficacy"},{"label":"D","text":"A competitive antagonist increases the ED50"},{"label":"E","text":"Variation in response to a drug among different individuals is most likely to occur with a drug showing a large therapeutic index"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"0d28a95bedf91d4d0aa49ac7fa44d552aa3415fb"},{"id":"q-d63d406f9dae","stem":"A patient is administered to the ER for treatment of drug overdose. The identity of the drug is unknown, but it is observed that when the urine pH is acidic, the renal clearance of the drug is less than the glomerular filtration rate, and when the urin pH is alkaline, the clearance is greater than the glomerular filtration rate. The drug probably a","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"Strong acid"},{"label":"B","text":"Strong base"},{"label":"C","text":"Non-electrolyte"},{"label":"D","text":"Weak base"},{"label":"E","text":"Weak acid"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-99ee7eca7b1f","stem":"After an intravenous bolus injection of lidocaine, the major factors determining the initial plasma concentration are","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Dose & apparent volume of distribution"},{"label":"B","text":"Dose & clearance"},{"label":"C","text":"Apparent volume of distribution & clearance"},{"label":"D","text":"Clearance & half-time"},{"label":"E","text":"Half-time & dose"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e5b97e2f4bc9","stem":"Which of the following statement is most correct ?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Maximum efficacy of a drug is directly correlated with its potency"},{"label":"B","text":"The therapeutic index is the LD50 ( or TD50 ) divided by ED50"},{"label":"C","text":"A partial agonist has no effect on its receptors unless another drug is present"},{"label":"D","text":"Graded dose-response data provide information about the standard deviation of sensitivity to the drug in the population studied"},{"label":"E","text":"Quantal dose-response curves provide information about the efficacy of a drug"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-943fdbcc7532","stem":"Receptors that communicate their activation by turning on an integral intracellular tyrosine kinase are typically","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Acetylcholine nicotinic receptors"},{"label":"B","text":"G protein-coupled"},{"label":"C","text":"Insulin or epidermal growth factor receptors"},{"label":"D","text":"Steroid receptors"},{"label":"E","text":"Vitamin D receptors"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"]},{"id":"q-6b96c4a92f40","stem":"If the plasma concentration of a drug declines with first-order kinetics, this means that","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"There is only one metabolic path for drug distribution"},{"label":"B","text":"The half-life is the same regardless of the plasma concentration"},{"label":"C","text":"The drug is largely metabolized in the liver after oral administration and has low bioavailability"},{"label":"D","text":"The rate of elimination is proportionate to the rate of administration at all times"},{"label":"E","text":"The drug is not distributed outside the vascular system"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a14a3f26a944","stem":"A physical process by which a weak acid becomes less water-soluble and more lipid-soluble at low pH is","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Water, pH and Buffers","topicOriginal":"Water, pH and Buffers","subtopic":"Acid","suggestedTopic":null,"options":[{"label":"A","text":"distribution"},{"label":"B","text":"elimination"},{"label":"C","text":"first pass effect"},{"label":"D","text":"permeation"},{"label":"E","text":"protonation"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Water, pH and Buffers","answerAuditStatus":"independent_provisional_reasoning","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-9bebd2b5f322","stem":"Hepatic drug metabolism is often decreased by all of the following diseases states except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Diseases affecting liver architecture or function"},{"label":"B","text":"Heavy metal poisoning"},{"label":"C","text":"Hyperthyroidism"},{"label":"D","text":"Cardiac diseases"},{"label":"E","text":"Malignant hepatic tumor"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8f426d218212","stem":"Regarding adverse drug reactions, which of the following statements is incorrect?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Are unlikely to follow abrupt discontinuation of drugs"},{"label":"B","text":"May be dose-related"},{"label":"C","text":"Of the idiosyncratic type account for most fatalities"},{"label":"D","text":"May follow long-term use of neuroleptics"},{"label":"E","text":"May affect the next biological generation"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6dcf92adecb7","stem":"All of the following would increase the bioavailability of a drug administered by the oral rout except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"Increased time of gastric emptying"},{"label":"B","text":"Increased lipid solubility of drug"},{"label":"C","text":"Increased hepatic metabolism of a drug"},{"label":"D","text":"Increased rate of drug dissolution"},{"label":"E","text":"Increased proportion of drug remaining uncharged"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7cc3c9b9fa94","stem":"All of the following would decrease the therapeutic index of a drug except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"Renal failure"},{"label":"B","text":"Hepatic impairment"},{"label":"C","text":"Increase in clearance"},{"label":"D","text":"Increase in neurotoxicity"},{"label":"E","text":"Increase in allergic reaction to drug"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"]},{"id":"q-0fd511820504","stem":"Concerning potency and efficacy","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Potency refers to the maximal effect a drug is capable of producing"},{"label":"B","text":"Efficacy refers to lack of toxicity of a drug"},{"label":"C","text":"Efficacy refers to the amount of a drug required to produce one-half of the maximal effect"},{"label":"D","text":"Their efficacy is more important than their potency when comparing the usefulness of morphine and codeine as analgesics"},{"label":"E","text":"Their potency is more important than their efficacy when comparing the usefulness of morphine and codeine as analgesics"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b89414b6efb4","stem":"According to alphabetical classification of types of adverse drug effects into A, B, C, D and E. type B is a bizarre effects that are unpredictable and are uncommon. All of the following effects are considered as type B reactions EXEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Anaphylaxis due to penicillin injection."},{"label":"B","text":"Bradycardia due to ß-adrenoreceptor blockers."},{"label":"C","text":"Acute hepatic necrosis due to use of halogenated anesthetic."},{"label":"D","text":"Bone marrow damage due to chloramphenicol."},{"label":"E","text":"Acute interstitial nephritis due to one of the non-steroidal anti-inflamatory drugs."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-eff91b85bd71","stem":"A new anticoagulant is developed. The drug exist in only one form which is highly lipid soluble and is excreted unchanged in the urine. Its volume of distribution is equal to plasma volume. The drug is not metabolized by enzymes in the GI tract. What would be the bioavailability of this compound?","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Lipids","topicOriginal":"Lipids","subtopic":"Lipid","suggestedTopic":null,"options":[{"label":"A","text":"1.0"},{"label":"B","text":"0.6"},{"label":"C","text":"0.3"},{"label":"D","text":"0.1"},{"label":"E","text":"0"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Lipids","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-db333feb70cd","stem":"You are concerned about the drug interactions caused by changes in drug metabolism in your patient. Drug metabolism usually results in a product that is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"More likely to distribute intracellularly."},{"label":"B","text":"less lipid-soluble than the original drug."},{"label":"C","text":"More likely to be reabsorbed by kidney tubules."},{"label":"D","text":"less water-soluble than the original drug."},{"label":"E","text":"More likely to produce adverse effects."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4761a3b85fed","stem":"If therapy with multiple drugs causes induction of drug metabolism in your asthma patient, it will","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Result in increased smooth endoplasmic reticulum."},{"label":"B","text":"Result in decreased rough endoplasmic reticulum."},{"label":"C","text":"Result in decreased enzymes in the soluble cytoplasmic function."},{"label":"D","text":"Require 3-4 months to reach completion."},{"label":"E","text":"Be irreversible."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"d6fb121ba42e9615597d03e9c84428d26e83d538"},{"id":"q-419ab56bb299","stem":"Which of the following is NOT a phase I drug-metabolizing reaction?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Acelylation."},{"label":"B","text":"Deamination."},{"label":"C","text":"Hydrolysis."},{"label":"D","text":"Oxidation."},{"label":"E","text":"Reduction. | P a g e ٤١ General Pharmacology MCQs"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-f01846ef9134","stem":"All the following statements about unwanted effects of drugs (adverse reactions) are correct EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"There is a fundamental biological distinction between therapeutic and adverse effects of drugs."},{"label":"B","text":"Some adverse effects are due to normal predictable pharmacological effects of drugs and may occur in any patient taking the drug."},{"label":"C","text":"Some adverse effects are due to abnormalities in the patient and will only occur in some patients taking the drug."},{"label":"D","text":"The terms intolerant and tolerant refer to individuals at either extreme of the normal distribution curve."},{"label":"E","text":"some adverse effects may affect the next biological generation."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b4b20b7fbba1","stem":"All the following statements about drugs and Pregnancy are correct EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"In early pregnancy, drugs may damage the embryo or fetus directly."},{"label":"B","text":"In late pregnancy, gross anatomical defects are unlikely to result from drugs."},{"label":"C","text":"Non-steroidal anti-inflammatory drugs can delay the onset of labor."},{"label":"D","text":"cytotoxic or anti-cancer drugs are unsafe during early pregnancy."},{"label":"E","text":"A vasoconstrictor drug such as ergot alkaloids given to mother during labor will not affect the fetus."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a499ff2937a7","stem":"All the following statements regarding signal transduction are true EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It allows cells to communicate with each other."},{"label":"B","text":"The signal is initiated by extracellular ligands."},{"label":"C","text":"Activation of G proteins occur."},{"label":"D","text":"Activation of protein kinases occur."},{"label":"E","text":"Hormones and neurotransmitters are the final products of transduction."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-849062eff823","stem":"Clinically important adverse drug interactions are likely to occur with the following EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Drugs that have shallow dose-response curve and high therapeutic index."},{"label":"B","text":"drugs that exhibit saturable metabolism (zero order kinetics)."},{"label":"C","text":"In severely ill patients who are receiving several drugs at the same time."},{"label":"D","text":"In patients with significantly impaired liver or kidney functions."},{"label":"E","text":"In the elderly since have multiple pathology."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b72c7f590146","stem":"Conditions responsible for excessive or unusual drug effects include","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Unusual sensitivity, either allergic in nature or an idiosyncratic."},{"label":"B","text":"Administration of the drug too frequently or for a prolonged period of time."},{"label":"C","text":"the presence of other drugs."},{"label":"D","text":"the age of the individual."},{"label":"E","text":"All the above."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-dbeeb9009ed4","stem":"All the following statements about partial agonists are true EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"they can reduce the effect of full agonists acting at the same receptor sites."},{"label":"B","text":"They are unable to occupy 100% of the receptors."},{"label":"C","text":"They are unable to elicit responses as large as those elicited by full agonists, even at high concentrations."},{"label":"D","text":"Their effects can be blocked by noncompetitive antagonists."},{"label":"E","text":"Their effects can be blocked by competitive antagonists."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"]},{"id":"q-0d120fc7ab6b","stem":"Which of the following mechanisms is common to the synaptic transmitters: acetylcholine, Gamma-aminobutyric acid, glycin, aspartate and glutamate?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Autonomic Pharmacology · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Autonomic Pharmacology","options":[{"label":"A","text":"They regulate the flow of ions through plasma membrane channels."},{"label":"B","text":"They activate tyrosine kinases through transmembrane receptors."},{"label":"C","text":"They activate Gs-guanine nucleotide binding proteins."},{"label":"D","text":"They bind to receptors that regulate gene expression in the nucleus."},{"label":"E","text":"They activate soluble guanylyl cyclase."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Autonomic Pharmacology · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-851c0d77d738","stem":"All the following statements concerning drug distribution into and out of the central nervous system (CNS) are true EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The blood-brain barrier, which involves drug movement through glial cell membranes as well as capillary membranes, is the main hindrance to drug distribution to the CNS."},{"label":"B","text":"Most drugs enter the CNS by simple diffusion at rates proportional to the lipid solubility of the non-ionized form of the drug."},{"label":"C","text":"Receptor-mediated transport allows certain peptides to gain access to the brain."},{"label":"D","text":"Strongly ionized drugs freely enter the CNS through carrier-mediated transport systems."},{"label":"E","text":"Some drugs leave the CNS by passing from the cerebrospinal into the dural blood sinuses through the arachnoid villi."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a5508319c79d","stem":"Properties of drug absorption include all the following EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"The route of administration is an important factor affecting drug absorption."},{"label":"B","text":"The rate of absorption varies after oral administration."},{"label":"C","text":"After rectal administration, drug follows first-order kinetics."},{"label":"D","text":"After intramuscular administration, drug absorption follows first-order kinetics."},{"label":"E","text":"With intravenous administration, drug absorption follows first-order kinetics."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-dddf098703ea","stem":"The greater proportion of the dose of a drug administred orally will be absorbed in the small intestine. However, on the assumption that passive transport of the non- ionized form of a drug determines its rate of absorption, which of the following compounds will be absorbed to the least extent in the stomach?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"Ampicillin (pKa=2.5)"},{"label":"B","text":"Aspirin (pKa=3.0)"},{"label":"C","text":"Warfarin (pKa=5.0)"},{"label":"D","text":"Phenobarbital (pKa=7.4)"},{"label":"E","text":"Propranolol (pKa=9.4)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-39a18203d83f","stem":"All of the following statements are true EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Biotransformation of drugs in the body usually yields products that diffuse across renal tubular membranes less readily than the parent compounds"},{"label":"B","text":"Biotransformation reactions often yield products that are inactive pharmacologically"},{"label":"C","text":"Biotransformation reactions can yield products that are pharmacologically more active than the parent compound"},{"label":"D","text":"Biotransformation reactions can yield products that are more lipophilic than the parent compound"},{"label":"E","text":"In some cases, biotransformation reactions enhance the toxicity of chemicals introduced into the body"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"],"duplicateStemGroup":"5aa92e4fca419989e4c3d66877d572fac2df9fc4"},{"id":"q-50517ded0548","stem":"Which of the following are characteristic of phase 2 biotransformation reactions?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"They oxidize primary amines"},{"label":"B","text":"They hydroxylate aliphatic compounds"},{"label":"C","text":"They conjugate compounds with endogens substances such as glucuronic acid or sulfate"},{"label":"D","text":"They hydrolyze esters"},{"label":"E","text":"They reduce carbonyl oxygen to form hydroxyl groups"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-cf551f2b2025","stem":"All of the following statements about efficacy and potency are true EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Efficacy is usually a more important clinical consideration than potency"},{"label":"B","text":"Efficacy is indicated by the height of the log dose-response curve"},{"label":"C","text":"The ED50 is a measure of the drug’s efficacy"},{"label":"D","text":"Drugs that produce a similar pharmacologic effect can have very different levels of efficacy"},{"label":"E","text":"On log dose-response curve, two drugs with the same action but with different potencies usually have parallel curves"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"6da8ea526d01ada6aac01feec08beaa3fd453c35"},{"id":"q-7ceb42170100","stem":"All of the following statements are correct EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Weak acids are absorbed efficiently across the epithelial cells of the stomach"},{"label":"B","text":"Coadministration of atropine delays the absorption of a second drug"},{"label":"C","text":"A drug showing a large Vd may indicate that the drug is highly bound in peripheral tissues"},{"label":"D","text":"First pass hepatic metabolism of a drug may greatly reduce its bioavailability"},{"label":"E","text":"Generally drugs are more effectively absorbed from the stomach than through the small intestine"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b7dce48c80b0","stem":"Which of the following results in a doubling of the steady state concentration of a drug?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Doubling the rate of infusion"},{"label":"B","text":"Maintaining the infusion rate but doubling the loading dose"},{"label":"C","text":"Doubling the rate of infusion and doubling the concentration of the infused drug"},{"label":"D","text":"Tripling the rate of infusion"},{"label":"E","text":"Quadrupling the rate of infusion"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-38c550ea4292","stem":"All of the following are examples of parenteral drug delivery EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Rectal"},{"label":"B","text":"Transdermal"},{"label":"C","text":"Intravenous"},{"label":"D","text":"Subcutaneous"},{"label":"E","text":"Intramuscular"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5badcbdb2914","stem":"All of the following are true concerning drug distribution EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Fenestrations in brain capillaries constitute a blood brain barrier"},{"label":"B","text":"A hydrophobic drug given intravenously would be distributed more rapidly to the brain than to adipose tissue"},{"label":"C","text":"A drug that is a weak base will become trapped in the stomach"},{"label":"D","text":"A hydrophilic IV drug would be distributed rapidly to the kidneys"},{"label":"E","text":"Closed capillaries limit drug distribution more than open capillaries"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"]},{"id":"q-b1c96428dc3d","stem":"All of the following clinical situation in a patient would increase the half life of a drug except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"Heart failure"},{"label":"B","text":"Renal failure"},{"label":"C","text":"Hepatitis"},{"label":"D","text":"Hemorrhage"},{"label":"E","text":"Decrease in volume of distribution"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-367d8e5ebb17","stem":"All of the following would increase the rate of elimination of a drug from the body EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"Vasoconstriction of afferent arteriole in renal glomerulus"},{"label":"B","text":"Increase in glomerular filtration rate"},{"label":"C","text":"Increase in renal plasma flow"},{"label":"D","text":"Increase in proximal tubule secretion rate"},{"label":"E","text":"Increase in liver microsomal enzymes"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7203aca6bafd","stem":"Which one of the following statements is INCORRECT?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Conjugation (phase 2) reactions involving drugs or their metabolites are not mediated by the cytochrome P-450 system in the liver"},{"label":"B","text":"Metabolism of a drug usually decreases its lipid solubility"},{"label":"C","text":"The extent to which a drug is bound to plasma proteins is not directly predictive of its rate of renal excretion"},{"label":"D","text":"For drugs with first order elimination kinetics, constant amount of drug is lost per unit time"},{"label":"E","text":"For drugs with zero order elimination kinetics, the relationship between drug dosage and maximally attained plasma concentration is non linear"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"4e65aa08892cda4a1cddcdfc8b5b6a9a233161e4"},{"id":"q-ae8bc74213fb","stem":"All of the following may shorten the duration of a drug’s effects EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Extensive plasma protein binding of the drug"},{"label":"B","text":"Compensatory reflexes"},{"label":"C","text":"Redistribution of the drug into skeletal muscle or adipose tissue"},{"label":"D","text":"Renal excretion of the drug"},{"label":"E","text":"Metabolism of the drug"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8a7c2d07b844","stem":"All of the following statements regarding drugs in early pregnancy are correct EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Drugs may damage the embryo or fetus indirectly by altering the mother’s physiology"},{"label":"B","text":"Ergot alkaloids can cause abortion"},{"label":"C","text":"Abortion may go unrecognized"},{"label":"D","text":"Cytotoxics are safe"},{"label":"E","text":"Teratogens are likely to have their most devastating effects"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-289066f515a8","stem":"Two drugs with the same pharmacological effect were given together the next effect produced was greater than the sum of their individual effects. This phenomenon is termed","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Potentiation"},{"label":"B","text":"Synergism"},{"label":"C","text":"Addition"},{"label":"D","text":"Cross tolerance"},{"label":"E","text":"Tachyphylaxis"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"]},{"id":"q-e60140dfa76a","stem":"All of the following statements about drug allergy are incorrect EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"All drugs are antigens"},{"label":"B","text":"If antibodies to a drug are present in patients, then they will suffer an adverse reaction if they receive the drug again"},{"label":"C","text":"Drugs or drug metabolites combine with a body protein to form an antigen"},{"label":"D","text":"Allergic reactions reproduce, only with greater intensity, the normal pharmacological actions of the causative drug"},{"label":"E","text":"Drugs elicit only type 1 (immediate or anaphylactic) allergic reactions"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a93bd15a69db","stem":"All of the following are affected by G proteins EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Inositol-1,4,5,-triphosphate"},{"label":"B","text":"Cyclic AMP"},{"label":"C","text":"Acetylcholine"},{"label":"D","text":"Diacylglycerol"},{"label":"E","text":"Cyclic GMP"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d51e9dd81e28","stem":"A partial agonist","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Has a lower affinity than a full agonist"},{"label":"B","text":"Has a higher efficacy than a full agonist"},{"label":"C","text":"Has a lower efficacy than a full agonist"},{"label":"D","text":"Has a higher affinity than a full agonist"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-731b04d3f532","stem":"The therapeutic index is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"A measure of the relative effectiveness of a drug"},{"label":"B","text":"A reference book in which one can look up all the drugs which are indicated for a particular therapeutic use"},{"label":"C","text":"A measure of the relative safety of a drug"},{"label":"D","text":"Routinely available from published studies with human subjects"},{"label":"E","text":"Calculated by using data obtained from a graded dose-response curve"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-aa05e43dc2af","stem":"These proteins serve as transducers between membrane receptors and intracellular second messenger systems","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Vitamin C"},{"label":"B","text":"C protein"},{"label":"C","text":"G protein"},{"label":"D","text":"muscarinic receptors"},{"label":"E","text":"Ligand gated ion channels"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-1a92cbdc5981","stem":"Drug handling in the neonate may be markedly different than in young adult because the neonate has","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Immature active transport systems for organic anions and cations"},{"label":"B","text":"A lower glomerular filtration rate"},{"label":"C","text":"Immature liver microsomal systems"},{"label":"D","text":"A reduced ability to glucuronidate phase 1 biotransformation products"},{"label":"E","text":"All of the above"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"]},{"id":"q-9fffedef9d86","stem":"The major factor in the altered sensitivity of older patients (>65 years of age) to many drugs is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Increased drug biotransformation"},{"label":"B","text":"Decreased plasma esterases"},{"label":"C","text":"Decreased absorption after oral administration"},{"label":"D","text":"Decreased renal function"},{"label":"E","text":"Increased plasma protein binding"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-cde3927b7055","stem":"A competitive antagonist","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Combines with the same site on the receptor as does the agonist"},{"label":"B","text":"Increases metabolism of agonist drugs"},{"label":"C","text":"Binds to a different receptor molecule than the agonist"},{"label":"D","text":"Is irreversible"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-dce1deecf991","stem":"Compared to a graded dose-response curve, a quantal dose-response curve","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Provides more information about the half life of a drug"},{"label":"B","text":"Provides more information about the variation in individual response to a drug"},{"label":"C","text":"Is less useful when comparing therapeutic and adverse drug responses"},{"label":"D","text":"Requires the same number of test subjects to construct"},{"label":"E","text":"Is just another way to express exactly the same information"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-36942c69f926","stem":"Which determined from a graded dose-response curve, median effective dose (ED50) refers to the dose at which","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"50% of all receptors are occupied"},{"label":"B","text":"50% of all individuals first show response"},{"label":"C","text":"50% of all individuals show a 50% maximum response"},{"label":"D","text":"50% of all individuals show a maximum response"},{"label":"E","text":"50% of the maximum response is observed"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-96dc4d222338","stem":"The following question is based on the following paragraph: Which one of the following statements i s true concerning the dose-response curves","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Curves A, B, C represents responses to weak agonists with C being the least potent"},{"label":"B","text":"Curve A represents the responses to a full agonist and curves B and C represents the responses to the agonist in the presence of two concentrations of a competitive antagonist"},{"label":"C","text":"Curves A, B, C represents 3 drugs which are acting at different recpetors because their potencies are different"},{"label":"D","text":"Curve D could be the response to agonist A in the presence of a competitive inhibitor"},{"label":"E","text":"Curve D represents an agonist with a high intrinsic efficacy because the dose needed for a given effect is larger than that of agonist A, B or C"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"]},{"id":"q-3fc3fc43ec11","stem":"Which of the following terms best describes a drug that blocks the action of epinephrine at its receptors by occupying those receptors without activating them?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Pharmacologic antagonist"},{"label":"B","text":"Partial agonist"},{"label":"C","text":"Physiological antagonist"},{"label":"D","text":"Chemical antagonist"},{"label":"E","text":"Non-competitive antagonist"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"2178e6f59238adbcdd49d78f53d434e5e1237189"},{"id":"q-5448adefac19","stem":"The results shown in the graph below were obtained in a comparison of positive inotropic agents. Which of the following statements is MOST correct ?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Drug A is most effective"},{"label":"B","text":"Drug B is least potent"},{"label":"C","text":"Drug C is most potent"},{"label":"D","text":"Drug B is more potent than drug C and more effective than drug A"},{"label":"E","text":"Drug A is more potent than drug B and more effective than drug C"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-861b82178095","stem":"Features that influence drug bioavailability may include all of the following Except","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"First-pass hepatic metabolism."},{"label":"B","text":"Lipid soulibility of the drug."},{"label":"C","text":"Chemical stability of the drug."},{"label":"D","text":"Nature of drug formulation."},{"label":"E","text":"Plasma protein binding of the drug"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"]},{"id":"q-e5997a5d1f52","stem":"The antimicrobial drug, tetracycline, is found to be therapeutically effective when 250mg of drug are present in the body. The T1/2 of tetracycline is 8 hours. What is the correct rate of infusion?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antimicrobial","suggestedTopic":null,"options":[{"label":"A","text":"7 mg/hour."},{"label":"B","text":"12 mg/hour."},{"label":"C","text":"22 mg/hour."},{"label":"D","text":"37 mg/hour."},{"label":"E","text":"45 mg/hour."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a30356a1ac27","stem":"A drug with a half life 8 hours is administered by continuous intravenous infusion. How long will it take for the drug to reach 90% of its final steady-state level?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"12 hours."},{"label":"B","text":"18 hours."},{"label":"C","text":"25 hours."},{"label":"D","text":"30 hours."},{"label":"E","text":"40 hours."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e05e0d84d48f","stem":"A drug has an elimination rate constant ( Ke ) of 0.1 hr-1. It is administered in a dose of 250 mg every 8 hours. Practically the steady state level will be attained after","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"First dose ."},{"label":"B","text":"Two doses."},{"label":"C","text":"Four doses."},{"label":"D","text":"Five days."},{"label":"E","text":"Seven days. A patient with heart disease require immediate treatment with the antiarrythmic drug procainamide. The text book lists the following pharmacokinetic value for procainamide in a 70-kg person : Vd = 80L, Cl = 25 L/hour, and therapeutic concentration = 5mg/L : Answer the coming 3 questions in relation to the case"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e632cf606b54","stem":"What intravenous loading dose should be administered ?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"180 mg"},{"label":"B","text":"225 mg"},{"label":"C","text":"400 mg"},{"label":"D","text":"520 mg"},{"label":"E","text":"800"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"8cc9d4d27a3fb0baa2516e65b6452e11cd460593"},{"id":"q-b6811d497b84","stem":"What constant intravenous infusion rate should be used to maintain the therapeutic concentration of 5mg/L ?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"90 mg/hour"},{"label":"B","text":"125 mg/hour"},{"label":"C","text":"180 mg/hour"},{"label":"D","text":"250 mg/hour"},{"label":"E","text":"650 mg/hour"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"],"duplicateStemGroup":"b5f06971e0b5f6924dad48c636cb23280a2ae5a1"},{"id":"q-2baf9ce4db5b","stem":"What is the predicted half-life of procainamide in this patient ?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"2.22 hrs"},{"label":"B","text":"2.4 hrs"},{"label":"C","text":"3.6 hrs"},{"label":"D","text":"5.0 hrs"},{"label":"E","text":"10.0 hrs"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-11ff471886a1","stem":"A drug with a half life 12 hours is administered by continuous intravenous infusion. How long will it take for the drug to reach 90% of its final steady-state level?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"18 hours."},{"label":"B","text":"24 hours."},{"label":"C","text":"30 hours."},{"label":"D","text":"40 hours."},{"label":"E","text":"90 hours."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-39850c217936","stem":"A drug with a half-life 10 hours is administered by continuous intravenous infusion. How long will it take for the drug to reach 75% of its final steady-state level?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"10 hours."},{"label":"B","text":"20 hours."},{"label":"C","text":"25 hours."},{"label":"D","text":"33 hours."},{"label":"E","text":"48 hours. A 35-kg child with heart disease requires immediate treatment with the antiarrhythmic drug procainamide. The textbook lists the following pharmacokinetic values for procainamide in a 70-kg person: Vd= 160 L, Cl= 50 L/hour, oral availability 83% and therapeutic concentration 5 mg/L. Answer the coming 3 questions in relation to this case:"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-91dfdd9e89f2","stem":"What intravenous loading dose should be administered?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"180 mg."},{"label":"B","text":"225 mg."},{"label":"C","text":"400 mg."},{"label":"D","text":"520 mg."},{"label":"E","text":"600 mg."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"8cc9d4d27a3fb0baa2516e65b6452e11cd460593"},{"id":"q-62209ca6378a","stem":"What constant intravenous infusion rate should be used to maintain the therapeutic concentration of 5 mg/L?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"90 mg/hour."},{"label":"B","text":"125 mg/hour."},{"label":"C","text":"180 mg/hour."},{"label":"D","text":"217 mg/hour."},{"label":"E","text":"650 mg/hour."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"],"duplicateStemGroup":"b5f06971e0b5f6924dad48c636cb23280a2ae5a1"},{"id":"q-84e08dbbacfc","stem":"What is the predicted half-life of procainamide in this child?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"2.22 hrs."},{"label":"B","text":"2.4 hrs."},{"label":"C","text":"3.6 hrs."},{"label":"D","text":"5.0 hrs."},{"label":"E","text":"10.0 hrs"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-95a09afc14c3","stem":"A 19-year-old woman is brought to the hospital with sever asthmatic wheezing. You decide to use IV theophyline for treatment. The pharmacokinetics of the theophyline include the following average parameters: Vd 35 L, Cl 48 ml/min, half- life 8 hours. If an IV infusion of theophyline is started at a rate of 0.48 mg/min, how long will it take to reach 93.75 of the final steady state?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Pharmacokinetic","suggestedTopic":null,"options":[{"label":"A","text":"Approximately 48 minutes"},{"label":"B","text":"Approximately 5.8 hours."},{"label":"C","text":"Approximately 6 hours."},{"label":"D","text":"Approximately 8 hours."},{"label":"E","text":"Approximately 32 hours. A patient is admitted to General Hospital with pneumonia due to gram-negative bacteria. The antibiotic tobramysin is ordered. The CL and Vd of tobramysin in the patient are 80 mL/min and 50 L, respectively. Answer the coming 2 questions"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-9b79f5f31955","stem":"What maintenance dose should be administered intravenously every 6 hours to eventually obtain average steady state plasma concentration of 6 mg/L?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"0.24 mg."},{"label":"B","text":"0.48 mg."},{"label":"C","text":"0.60 mg."},{"label":"D","text":"10.0 mg."},{"label":"E","text":"50 mg."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-950e2f331911","stem":"If you wish to give the patient an IV loading dose to achieve the therapeutic plasma concentration of 6 mg/L rapidly, how much should be given?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"10 mg."},{"label":"B","text":"100 mg."},{"label":"C","text":"150 mg."},{"label":"D","text":"200 mg."},{"label":"E","text":"300 mg."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d9d6fa745be4","stem":"A normal volunteer will receive a new drug in a phase 1 clinical trial. The clearance and volume of distribution of the drug in this subject are 1.386 L/h and 80 L, respectively. The half-life of the drug in this subject will be approximately","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"90 hr."},{"label":"B","text":"80 hr."},{"label":"C","text":"40 hr."},{"label":"D","text":"20 hr."},{"label":"E","text":"2 hr."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"],"duplicateStemGroup":"1fa558200b70dafbbde6c7a294e1d3f51d664c5a"},{"id":"q-881aaa7d3d9d","stem":"Gentamicin is often given in intermittent IV bolus doses of 100 mg three times a day to achieve target peak plasma concentration of about 5 mg/L. Gentamicin's clearance (normally 5.4 L/h/70kg) is almost entirely by glomerular filtration. Your patient, however, is found to have a creatinine clearance one-third of normal. Your initial dosage regimen for this patient would probably be","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"33 mg three times daily."},{"label":"B","text":"66 mg three times daily."},{"label":"C","text":"72 mg three times daily."},{"label":"D","text":"100 mg twice daily."},{"label":"E","text":"150 mg twice daily."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"67cce4232607f5e9b26367a3cfaec20787530788"},{"id":"q-5e0d005eb976","stem":"A narcotic addict is brought to the emergency room in a deep coma. His friends state that he took a large dose of morphine 6 hours earlier. An immediate blood analysis show a morphine blood level of 0.25 mg/L. Assuming that the pharmacokinetics of morphine in this patient are Vd 200 L and half life 3 hours, how much morphine did the patient inject 6 hours earlier?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Pharmacokinetic","suggestedTopic":null,"options":[{"label":"A","text":"25 mg."},{"label":"B","text":"50 mg."},{"label":"C","text":"100 mg."},{"label":"D","text":"200 mg."},{"label":"E","text":"Too few data to predict."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b0a49caeb58a","stem":"The total body clearance of a drug is 50 ml/min. the optimal IV infusion rate to maintain a plasma level of 10 μg/ml is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"0.1 mg/min"},{"label":"B","text":"0.2 mg/min"},{"label":"C","text":"0.5 mg/min"},{"label":"D","text":"0.75 mg/min"},{"label":"E","text":"1 mg/min"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-d650985deede","stem":"A drug has a volume of distribution of 0.27 L/Kg, what is the loading dose (mg/Kg) to attain a peak plasma level of approximately 10 μg/ml?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"0.05 mg/Kg"},{"label":"B","text":"0.1 mg/Kg"},{"label":"C","text":"1.0 mg/Kg"},{"label":"D","text":"2.5 mg/Kg"},{"label":"E","text":"4 mg/Kg"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-b2d7a5cbc46e","stem":"What would be the half life of a drug with a volume of distribution of 0.15 L/Kg and a clearance of 48 ml/min in a 70 Kg man?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"1.5 hr"},{"label":"B","text":"2.5 hr"},{"label":"C","text":"4.5 hr"},{"label":"D","text":"8.5 hr"},{"label":"E","text":"24 hr"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"]},{"id":"q-2c433f3032e6","stem":"What orally administered loading dose would achieve a plasma concentration of 10 μg/ml for a drug that has a volume of distribution (Vd) of 100 L and 75% bioavailability?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"1.3 mg"},{"label":"B","text":"3.6 mg"},{"label":"C","text":"12 mg"},{"label":"D","text":"24 mg"},{"label":"E","text":"48 mg"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-451ddbc5ef84","stem":"A drug dose repeated at the elimination half-life, just prior to the third administration, approaches the steady state of further administrations by what percentage?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"50%."},{"label":"B","text":"62.5%."},{"label":"C","text":"75%."},{"label":"D","text":"82.5%."},{"label":"E","text":"90%."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"]},{"id":"q-171f50f886ca","stem":"1 Which one of the following statements is correct?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Weak bases are absorbed efficiently across the epithelial cells of the stomach."},{"label":"B","text":"Coadministration of atropine speeds the absorption of a second drug."},{"label":"C","text":"Drugs showing a large Vd can be efficiently removed by dialysis of the plasma."},{"label":"D","text":"Stressful emotions can lead to a slowing of drug absorption."},{"label":"E","text":"If the Vd for a drug is small, most of the drug is in the extraplasmic space."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-bdd937097510","stem":"2 Which one of the following is true for a drug whose elimination from plasma shows first-order kinetics?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"The half-life of the drug is proportional to the drug concentration in plasma."},{"label":"B","text":"The amount eliminated per unit of time is constant."},{"label":"C","text":"The rate of elimination is proportional to the plasma concentration."},{"label":"D","text":"Elimination involves a rate-limiting enzymic reaction operating at its maximal velocity (Vm)."},{"label":"E","text":"A plot of drug concentration versus time is a straight line."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6859f7f4b5ac","stem":"3 A patient is treated with drug A, which has a high affinity for albumin and is administered in amounts that do not exceed the binding capacity of albumin. A second drug, B, is added to the treatment regimen. Drug B also has a high affinity for albumin but is administered in amounts that are 100 times the binding capacity of albumin. Which of the following occurs after administration of drug B?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"An increase in the tissue concentrations of drug A."},{"label":"B","text":"A decrease in the tissue concentrations of drug A."},{"label":"C","text":"A decrease in the volume of distribution of drug A."},{"label":"D","text":"A decrease in the half-life of drug A."},{"label":"E","text":"Addition of more drug A significantly alters the serum concentration of unbound drug B."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-58e1b447453d","stem":"4 The addition of glucuronic acid to a drug","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Decreases its water solubility."},{"label":"B","text":"Usually leads to inactivation of the drug."},{"label":"C","text":"Is an example of a Phase I reaction."},{"label":"D","text":"Occurs at the same rate in adults and newborns."},{"label":"E","text":"Involves cytochrome P450."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e8a401f48fbd","stem":"5 Drugs showing zero-order kinetics of elimination","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"Are more common than those showing first-order kinetics."},{"label":"B","text":"Decrease in concentration exponentially with time."},{"label":"C","text":"Have a half-life independent of dose."},{"label":"D","text":"Show a plot of drug concentration versus time that is linear."},{"label":"E","text":"Show a constant fraction of the drug eliminated per unit of time."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"]},{"id":"q-fafd2a02e868","stem":"6 A drug, given as a 100-mg single dose, results in a peak plasma concentration of 20 μg/mL. The apparent volume of distribution is (assume a rapid distribution and negligible elimination prior to measuring the peak plasma level)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"0.5 L."},{"label":"B","text":"1 L."},{"label":"C","text":"2 L."},{"label":"D","text":"5 L."},{"label":"E","text":"10 L."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-ada1791a922a","stem":"7 A drug with a half-life of 12 hours is administered by continuous IV infusion. How long will it take for the drug to reach ninety percent of its final steady-state level?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"18 hours."},{"label":"B","text":"24 hours."},{"label":"C","text":"30 hours."},{"label":"D","text":"40 hours."},{"label":"E","text":"90 hours."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-da035caec34e","stem":"8 Which of the following results in a doubling of the steady-state concentration of a drug?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Doubling the rate of infusion."},{"label":"B","text":"Maintaining the rate of infusion but doubling the loading dose."},{"label":"C","text":"Doubling the rate of infusion and doubling the concentration of the infused drug."},{"label":"D","text":"Tripling the rate of infusion."},{"label":"E","text":"Quadrupling the rate of infusion. Pharmacodynamics"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-bb7e97618300","stem":"1 Which of the following statements is correct?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"If 10 mg of Drug A produces the same response as 100 mg of Drug B, Drug A is more efficacious than Drug B."},{"label":"B","text":"The greater the efficacy, the greater the potency of a drug."},{"label":"C","text":"In selecting a drug, potency is usually more important than efficacy."},{"label":"D","text":"A competitive antagonist increases the ED50."},{"label":"E","text":"Variation in response to a drug among different individuals is most likely to occur with a drug showing a large therapeutic index."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e34ac2b54d8a","stem":"2 Variation in the sensitivity of a population of individuals to increasing doses of a drug is best determined by which of the following?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Efficacy."},{"label":"B","text":"Potency."},{"label":"C","text":"Therapeutic index."},{"label":"D","text":"Graded dose-response curve."},{"label":"E","text":"Quantal dose-response curve."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a5869091ce0b","stem":"3 Which of the following statements most accurately describes a system having spare receptors?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"The number of spare receptors determines the maximum effect."},{"label":"B","text":"Spare receptors are sequestered in the cytosol."},{"label":"C","text":"A single drug-receptor interaction results in many cellular response elements being activated."},{"label":"D","text":"Spare receptors are active even in the absence of agonist."},{"label":"E","text":"Agonist affinity for spare receptors is less than their affinity for nonspare receptors."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"]},{"id":"q-f0e2d7c0febd","stem":"A 3-year-old child is brought to the emergency department having just ingested a large over-dose of promethazine, an antihistaminic drug. Promethazine is a weak base with a pK a of 9.1 .It is capable of entering most tissues, including the brain. On physical examination, the heart rate is 100/rain, blood pressure 110/60 mm Hg, and respiratory rate 20/min. In this case of promethazine overdose","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Urinary excretion would be accelerated by administration of NH4C1"},{"label":"B","text":"Urinary excretion would be accelerated by giving NaHCO 3"},{"label":"C","text":"More of the drug would be ionized at blood pH than at stomach pH"},{"label":"D","text":"Absorption of the drug would be faster from the stomach than from the small intestine"},{"label":"E","text":"Hemodialysis is the only effective therapy"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9e52af66c54d","stem":"All of the following are general mechanisms of drug permeation EXCEPT","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Aqueous diffusion"},{"label":"B","text":"Aqueous hydrolysis"},{"label":"C","text":"Lipid diffusion"},{"label":"D","text":"Pinocytosis or endocytosis"},{"label":"E","text":"Special carrier transport"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-17ac053d20c4","stem":"Which one of the following processes is best suited for permeation of very large protein molecules into cells ?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Aqueous diffusion"},{"label":"B","text":"Aqueous hydrolysis"},{"label":"C","text":"Lipid diffusion"},{"label":"D","text":"Endocytosis"},{"label":"E","text":"Special carrier transport"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b554310c955a","stem":"A patient with a history of episodic attacks of coughing, wheezing, and shortness of breath is being evaluated in the asthma clinic. Several drug treatments with different routes of administration are under consideration. Which of the following statements about routes of administration is MOST correct?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Blood levels often rise more slowly after intramuscular injection than after oral dosing"},{"label":"B","text":"The \"first-pass\" effect is the result of metabolism of a drug after administration and before it enters the systemic circulation"},{"label":"C","text":"Administration of antiasthmatic drugs by inhaled aerosol is usually associated with more adverse effects than is administration of these drugs by mouth"},{"label":"D","text":"Bioavailability of most drugs is greater with rectal (suppository) administration than with sublingual administration."},{"label":"E","text":"Administration of a drug by transdermal patch is often faster but is associated with more first-pass metabolism than oral administration"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5ae99a7587d0","stem":"Aspirin is a weak organic acid with a pKa of 3.5. What percentage of a given dose will be in the lipid-soluble form in the duodenum at a pH of 4.5?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"About 1%"},{"label":"B","text":"About 10%"},{"label":"C","text":"About 50%"},{"label":"D","text":"About 90%"},{"label":"E","text":"About 99%"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"]},{"id":"q-64ebe7ad3e90","stem":"If the plasma concentration of a drag declines with \"first-order kinetics,\" this means that","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"There is only one metabolic path for drug disposition"},{"label":"B","text":"The half-life is the same regardless of the plasma concentration"},{"label":"C","text":"The drug is largely metabolized in the liver after oral administration and has low bioavailability"},{"label":"D","text":"The rate of elimination is proportionate to the rate of administration at all times"},{"label":"E","text":"The drug is not distributed outside the vascular system"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e7ef68c4c7b8","stem":"Regarding termination of drug action ،","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Drugs must be excreted from the body to terminate their action"},{"label":"B","text":"Metabolism of drugs always increases their water solubility"},{"label":"C","text":"Metabolism of drugs always abolishes their pharmacologic activity"},{"label":"D","text":"Hepatic metabolism and renal excretion are the two most important mechanisms involved"},{"label":"E","text":"Distribution of a drug out of the bloodstream terminates the drug's effects"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-034c15eeee2a","stem":"Distribution of drugs to specific tissues","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Is independent of blood flow to the organ"},{"label":"B","text":"Is independent of the solubility of the drug in that tissue"},{"label":"C","text":"Depends on the unbound drug concentration gradient between blood and the tissue"},{"label":"D","text":"Is increased for drugs that are strongly bound to plasma proteins"},{"label":"E","text":"Has no effect on the half-life of the drug"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c39586806237","stem":"Timolol is being considered for the treatment of glaucoma in a 58-year-old patient. Except for elevated intraocular pressure, the patient's history and physical exam are unremarkable. Timlol is a weak base of pKa 9.2 .Which of the following statements is FALSE ?","type":"Single Best Answer MCQ","subject":"Ophthalmology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"After parenteral administration, the concentration of timolol in the aqueous humor (pH 7.8) will be lower than the concentration in the duodenum (pH 5.5)"},{"label":"B","text":"When administered as eye drops, the rate of absorption into the eye will be slower if the drops are alkaline (pH 8.0) than if they are acidic (pH 5.0)"},{"label":"C","text":"Excretion in the urine will be slower if urine pH is alkaline (.pH 8.0) than if the urine pH is acidic (pH 5.8)"},{"label":"D","text":"The proportion of timolol in the protonated form will be approximately 10% at pH"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Ophthalmology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-469eaaee2820","stem":"For which of the following drugs will excretion be most significantly accelerated by acidification of the urine ?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Weak acid with pK of 5.5"},{"label":"B","text":"Weak base with pK of 3.5"},{"label":"C","text":"Weak acid with pK of 7.5"},{"label":"D","text":"Weak base with pK of 6.5"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"]},{"id":"q-18b40c421eeb","stem":"The set of properties that characterize the effect of a drug on the body is called","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"distribution"},{"label":"B","text":"permeation"},{"label":"C","text":"pharmacodynamics"},{"label":"D","text":"pharmacokinetics"},{"label":"E","text":"protonation"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-aede8c0c3be5","stem":"The set of properties that characterize the effect of the body on a drug is called","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"absorption"},{"label":"B","text":"distribution"},{"label":"C","text":"elimination"},{"label":"D","text":"first order kinetics"},{"label":"E","text":"pharmacokinetics"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1af75209ed12","stem":"The most general term for the process by which the amount of active drug in the body is reduced after absorption into the systemic circulation","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"distribution"},{"label":"B","text":"elimination"},{"label":"C","text":"excretion"},{"label":"D","text":"first-order elimination"},{"label":"E","text":"metabolism"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-53c529e849eb","stem":"The process by which the amount of drug in the body is reduced after administration but before entering the systemic circulation","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"excretion"},{"label":"B","text":"first-order elimination"},{"label":"C","text":"first-pass effect"},{"label":"D","text":"metabolism"},{"label":"E","text":"pharmacokinetics"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-09401aa90639","stem":"The kinetics that is characteristic of the elimination of ethanol and high doses of phenytoin and aspirin are called","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"distribution"},{"label":"B","text":"excretion"},{"label":"C","text":"first-pass effect"},{"label":"D","text":"first-order elimination"},{"label":"E","text":"zero-order elimination"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"]},{"id":"q-80e9dc41a961","stem":"A 55-year-old woman with heart failure is to be treated with a diuretic drug. Drugs X and Y have the same mechanism of diuretic action. Drug X in a dose of 5 mg produces the same magnitude of diuresis as 500 mg of drug Y. This suggests that","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Cardiovascular Drugs","topicOriginal":"Cardiovascular Drugs","subtopic":"Heart Failure","suggestedTopic":null,"options":[{"label":"A","text":"Drug Y is less efficacious than drug X"},{"label":"B","text":"Drug X is about 100 times more potent than drug Y"},{"label":"C","text":"Toxicity of drug X is less than that of drug Y"},{"label":"D","text":"Drug X is a safer drug than drug Y"},{"label":"E","text":"Drug X will have a shorter duration of action than drug Y because less of drug X is present for a given effect"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular Drugs","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-48f6bb6fec7c","stem":"Dose-response curves are used for drug evaluation in the animal laboratory and in the clinic. Quantal dose-response curves are","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Used for determining the therapeutic index of a drug"},{"label":"B","text":"Used for determining the maximal efficacy of a drug"},{"label":"C","text":"more precisely quantitated than ordinary graded dose-response curves"},{"label":"D","text":"Obtainable from the study of intact subjects but not from isolated tissue preparations"},{"label":"E","text":"Used to determine the statistical variation (standard deviation) of the maximal response to the drug"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"e6173bf264e2c6c0ef1774584f339b186922628c"},{"id":"q-315fe2575d00","stem":"In the absence of other drugs, pindolol causes an increase in heart rate by activating beta adrenoceptors. In the presence of highly effective beta stimulants, however, pindolol causes a dose-dependent, reversible decrease in hearl rate. Therefore. pindolol should be classified as","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"An irreversible antagonist"},{"label":"B","text":"A physiologic antagonist"},{"label":"C","text":"A chemical antagonist"},{"label":"D","text":"A partial agonist"},{"label":"E","text":"A spare receptor agonist"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"]},{"id":"q-66c7c50380f7","stem":"Which of the following statements about spare receptors is MOST correct ?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Spare receptors, in the absence of drug, are sequestered in the cytoplasm"},{"label":"B","text":"Spare receptors will be detected if the intracellular effect of drug-receptor interaction lasts longer than the drug-receptor interaction itself"},{"label":"C","text":"Spare receptors influence the maximal efficacy of the drug-receptor system"},{"label":"D","text":"Spare receptors activate the effector machinery of the cell without the need for a drug"},{"label":"E","text":"Spare receptors may be detected by the finding that the EC50 is greater than the Kd for the agonist"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"79cf854a2aafe757f11d470a812c52acb9ebe0e8"},{"id":"q-4dd32195e144","stem":"Two drugs, \"A'\" and \"B,'\" were studied in a large group of patients and the percentages of the group showing a specific therapeutic effect were determined. The results are shown in the table: Which of the following statements about these results is MOST correct ?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Drug A is safer than drug B"},{"label":"B","text":"Drug B is more effective than drug A"},{"label":"C","text":"The two drugs act on the same receptors"},{"label":"D","text":"Drug A is less potent than drug B"},{"label":"E","text":"The therapeutic index of drug B is 10"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7747ec04b420","stem":"Which of the following terms best describes the antagonism of leukotriene's bronchoconstrictor effect (mediated at leukotriene receptors) by terbutaline (acting at adrenoceptors) in a patient with asthma?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Pharmacologic antagonist"},{"label":"B","text":"Partial agonist"},{"label":"C","text":"Physiologic antagonist"},{"label":"D","text":"Chemical antagonist"},{"label":"E","text":"Noncompetitive antagonist"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-940843a555e6","stem":"Which of the following terms best describes an antagonist that interacts directly with the agonist and not at all, or only incidentally, with the receptor?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Pharmacologic antagonist"},{"label":"B","text":"Partial agonist"},{"label":"C","text":"Physiologic antagonist"},{"label":"D","text":"Chemical antagonist"},{"label":"E","text":"Noncompetitive antagonist"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"],"duplicateStemGroup":"e39b539b81d7a1132bd38a3d353fac8af34a6094"},{"id":"q-1de63f6378a9","stem":"Which of the following terms best describes a drug that blocks the action of epinephrine at its receptors by occupying those receptors without activating them?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Pharmacologic antagonist"},{"label":"B","text":"Partial agonist"},{"label":"C","text":"Physiologic antagonist"},{"label":"D","text":"Chemical antagonist"},{"label":"E","text":"Noncompetitive antagonist"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"2178e6f59238adbcdd49d78f53d434e5e1237189"},{"id":"q-a831eb5c189d","stem":"Which of the following provides information about the variation in sensitivity to the drug within the population studied ?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Maximal efficacy"},{"label":"B","text":"Therapeutic index"},{"label":"C","text":"Drug potency"},{"label":"D","text":"Graded dose-response curve"},{"label":"E","text":"Quantal dose-response curve"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-90f9de13468d","stem":"Which of the following most accurately describes the transmembrane signaling process involved in steroid hormone action ?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Action on a membrane-spanning tyrosine kinase"},{"label":"B","text":"Activation of a G protein, which activates or inhibits adenylyl cyclase"},{"label":"C","text":"Diffusion into the cytoplasm and binding to an intracellular receptor"},{"label":"D","text":"Diffusion of \"STAT\" molecules across the membrane"},{"label":"E","text":"Opening of transmembrane ion channels"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"9377d4b3c7563a23fe66468d70683fcb01110e7f"},{"id":"q-799fefdde9b8","stem":"Which of the following provides information about the largest response a drug can produce, regardless of dose ?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Drug potency"},{"label":"B","text":"Maximal efficacy"},{"label":"C","text":"Mechanism of receptor action"},{"label":"D","text":"Therapeutic index"},{"label":"E","text":"Therapeutic window"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-56410f59f6b2","stem":"Verapamil and phenytoin are both eliminated from the body by metabolism in the liver. Verapamil has a clearance of 1.5 L/min, approximately equal to liver blood flow, whereas phenytoin has a clearance of 0.1 L/min. When these compounds are administered along with rifampin, a drug that increases hepatic drug-metabolizing enzymes, which of the following is most likely?","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Proteins and Enzymes","topicOriginal":"Proteins and Enzymes","subtopic":"Enzyme","suggestedTopic":null,"options":[{"label":"A","text":"The clearance of both verapamil and phenytoin will be increased"},{"label":"B","text":"The clearance of both verapamil and phenytoin will be decreased"},{"label":"C","text":"The clearance of verapamil will be unchanged, whereas the clearance of phenytoin will be increased"},{"label":"D","text":"The clearance of phenytoin will be unchanged, whereas the clearance of verapamil will be increased"},{"label":"E","text":"The clearance of both drugs will be unchanged"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Proteins and Enzymes","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"]},{"id":"q-55fac8b45f1a","stem":"Describes the percentage binding of a full agonist to its receptors as the concentration of a partial agonist is increased from low to very high levels","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"curve 1"},{"label":"B","text":"curve 2"},{"label":"C","text":"curve 3"},{"label":"D","text":"curve 4"},{"label":"E","text":"curve 5"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-6d8dacf414e4","stem":"Describes the percentage effect when a full agonist is present throughout the experiment, and the concentration of a partial agonist is increased from low to very high levels","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"curve 1"},{"label":"B","text":"curve 2"},{"label":"C","text":"curve 3"},{"label":"D","text":"curve 4"},{"label":"E","text":"curve 5"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-91dc9eacffd0","stem":"Describes the percentage binding of the partial agonist whose effect is shown by curve 4. if the system has many spare receptors","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"curve 1"},{"label":"B","text":"curve 2"},{"label":"C","text":"curve 3"},{"label":"D","text":"curve 4"},{"label":"E","text":"curve 5"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-c469dc07a304","stem":"A city clinic is considering the substitution of generic drugs in order to save money. The clinical pharmacologist is asked to advise on the bioavailability of the generic products. She informs the head of the clinic that the bioavailability of drugs is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"Established by FDA regulation al 100% for preparations for intramuscular injection"},{"label":"B","text":"100% for oral preparations that are not metabolized in the liver"},{"label":"C","text":"Calculated from the peak concentration of drug divided by the dose administered"},{"label":"D","text":"Important because bioavailability determines what fraction of the administered dose reaches the systemic circulation"},{"label":"E","text":"Equal to 1 (100%) only for drugs administered by any parenteral route"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"]},{"id":"q-802c309c1c24","stem":"You have diagnosed asthma in a 19-year-old patient with recurrent, episodic attacks of bronchospasm with wheezing. You are concerned about drug interactions caused by changes in drug metabolism in this patient. Drug metabolism usually results in a product that is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"More likely to distribute intracellulary"},{"label":"B","text":"Less lipid-soluble than the original drug"},{"label":"C","text":"More likely to be reabsorbed by kidney tubules"},{"label":"D","text":"More lipid-soluble than the original drug"},{"label":"E","text":"More likely to produce adverse effects"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-838d495c3f87","stem":"If therapy with multiple drugs causes induction of drug metabolism in your asthma patient, it will","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Result in increased smooth endoplasmic reticulum"},{"label":"B","text":"Result in increased rough endoplasmic reticulum"},{"label":"C","text":"Result in decreased enzymes in the soluble cytoplasmic fraction"},{"label":"D","text":"Require 3-4 months to reach completion"},{"label":"E","text":"Be irreversible"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"d6fb121ba42e9615597d03e9c84428d26e83d538"},{"id":"q-397440a8c805","stem":"A factor that is likely to increase the duration of action of a drug that is partially metabolized by CYP3A4 in the liver is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Chronic administration of phenobarbital prior to and during therapy with the drug in question"},{"label":"B","text":"Chronic therapy with cimetidine prior to and during therapy with the drug in question"},{"label":"C","text":"Displacement from tissue binding sites by another drug"},{"label":"D","text":"Increased cardiac output"},{"label":"E","text":"Chronic administration of rifampin"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a52c532eb33e","stem":"Which of the following is a phase II drug-metabolizing reaction?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Acetylation"},{"label":"B","text":"Deamination"},{"label":"C","text":"Hydrolysis"},{"label":"D","text":"Oxidation"},{"label":"E","text":"Reduction"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"provisional_independently_reasoned","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"4a1ff2fa9056197c51a62f024f7ef52af238f8e3"},{"id":"q-5cc36d2b372e","stem":"Reports of cardiac arrhythmias caused by unusually high blood levels of two antihistamines terfenadine and astemizole, led to their removal from the market. These effects were best explained by","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Concomitant treatment with phenobarbital"},{"label":"B","text":"Use of these drugs by smokers"},{"label":"C","text":"A genetic predisposition to metabolize succinylcholine slowly"},{"label":"D","text":"Treatment of these patients with ketoconazole, an antifungal agent"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d4e84ee10737","stem":"Which of the following drugs is associated with slower metabolism in Caucasians and African - Americans than in most Asians?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cimetidine"},{"label":"B","text":"Procainamide"},{"label":"C","text":"Quinidine"},{"label":"D","text":"Rifampin"},{"label":"E","text":"Succinylcholine"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"]},{"id":"q-a11673dcadb5","stem":"Which of the following drugs may inhibit the hepatic microsomal P450 responsible for warfarin metabolism?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Cardiovascular Drugs · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Cardiovascular Drugs","options":[{"label":"A","text":"Cimetidine"},{"label":"B","text":"Ethanol"},{"label":"C","text":"Phenobarbital"},{"label":"D","text":"Procainamide"},{"label":"E","text":"Rifampin"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular Drugs · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-41f9dc22fe13","stem":"Which of the following drugs is hydrolyzed by a plasma esterase that is abnormally low in activity in about one out of every 2500 humans?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cimetidine"},{"label":"B","text":"Ethanol"},{"label":"C","text":"Procainamide"},{"label":"D","text":"Rifampin"},{"label":"E","text":"Succinylcholine"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8f0075bbc689","stem":"Chronic use of which of the following drugs may increase the toxicity of acetaminophen?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cimetidine"},{"label":"B","text":"Ethanol"},{"label":"C","text":"Ketoconazole"},{"label":"D","text":"Procainanmide"},{"label":"E","text":"Quinidine"},{"label":"F","text":"Ritonavir"},{"label":"G","text":"Succinylcholine"},{"label":"H","text":"Verapmil"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["too_many_options","topic_generic"],"cleaningOperations":[]},{"id":"q-6b39752848dd","stem":"Which of the following drugs has higher first-pass metabolism in men than in women ?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"Cimetidine"},{"label":"B","text":"Ethanol"},{"label":"C","text":"Ketoconazole"},{"label":"D","text":"Procainanmide"},{"label":"E","text":"Quinidine"},{"label":"F","text":"Ritonavir"},{"label":"G","text":"Succinylcholine"},{"label":"H","text":"Verapmil"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["too_many_options","topic_generic"],"cleaningOperations":[]},{"id":"q-70f50aaeb780","stem":"Which of the following drugs is an established inhibitor of P-glycoprotein (P-gp) drug transporters ?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cimetidine"},{"label":"B","text":"Ethanol"},{"label":"C","text":"Ketoconazole"},{"label":"D","text":"Procainanmide"},{"label":"E","text":"Quinidine"},{"label":"F","text":"Ritonavir"},{"label":"G","text":"Succinylcholine"},{"label":"H","text":"Verapmil"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["too_many_options","topic_generic"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"]},{"id":"q-c5926f71faa9","stem":"Which of the following agents, when used in combination with other anti-HIV drugs permits dose reduction ?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cimetidine"},{"label":"B","text":"Ethanol"},{"label":"C","text":"Ketoconazole"},{"label":"D","text":"Procainanmide"},{"label":"E","text":"Quinidine"},{"label":"F","text":"Ritonavir"},{"label":"G","text":"Succinylcholine"},{"label":"H","text":"Verapmil Problem Solving Questions ( Katzung ) : Mr. Jones is admitted to General Hospital with pneumonia due to gram-negative bacteria. The antibiotic tobramycin is ordered. The CL and Vd of tobramycin in Mr. Jones are 80 mL/min and 40 L, respectively."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["too_many_options","topic_generic"],"cleaningOperations":[]},{"id":"q-162d9398b6f0","stem":"What maintenance dose should be administered intravenously every 6 hours to eventually obtain average steady-state plasma concentrations of 4 mg/L?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"0.32 mg"},{"label":"B","text":"19.2 mg"},{"label":"C","text":"115 mg"},{"label":"D","text":"160 mg"},{"label":"E","text":"230 mg"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-871652acaecf","stem":"If you wish to give Mr. Jones an IV loading dose to achieve the therapeutic plasma concentration of 4 mg/L rapidly, how much should be given?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"0.1 mg"},{"label":"B","text":"10 mg"},{"label":"C","text":"115.2 mg"},{"label":"D","text":"160 mg"},{"label":"E","text":"None of the above"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9a5e6ce44fce","stem":"6 days. How long should you withhold digoxin in order to reach a safer yet probably therapeutic level of 1 mg/mL?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Cardiovascular Drugs · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Cardiovascular Drugs","options":[{"label":"A","text":"1.6 days"},{"label":"B","text":"2.4 days"},{"label":"C","text":"3.2 days"},{"label":"D","text":"4.8 days"},{"label":"E","text":"6.4 days"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular Drugs · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"]},{"id":"q-6a7861166fd9","stem":"A 60-year-old man enters the hospital with a myocardial infarction and a severe ventricular arrhythmia. The antiarrhythmic drug chosen has a narrow therapeutic window: the minimum toxic plasma concentration is 1.5 times the minimum therapeutic plasma concentration. The half-life is 6 hours. It is essential to maintain the plasma concentration above the minimum therapeutic level to prevent a possibly lethal arrhythmia. Of the following, the most appropriate dosing regimen would be","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Cardiovascular Drugs","topicOriginal":"Cardiovascular Drugs","subtopic":"Antiarrhythmic","suggestedTopic":null,"options":[{"label":"A","text":"Once a day"},{"label":"B","text":"Twice a day"},{"label":"C","text":"Three times a day"},{"label":"D","text":"Four times a day"},{"label":"E","text":"Constant IV infnsion"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Cardiovascular Drugs","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-9c42b1f00c64","stem":"A 50-year-old woman with metastatic breast cancer has elected to participate in the trial of a new chemotherapeutic agent. It is given by constant 1V infnsion of 8 mg/hour. Plasma concentrations (Cp) are measured with the results shown in the table. Time After Plasma Start of Concentration Infusion (mg/L) (hours) 1 0.8 2 1.3 4 2.0 8 3.0 10 3.6 16 3.7 20 3.84 25 3.95 30 4.0 40 4.0 From these data it may be concluded that","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Volume of distribution is 30 L"},{"label":"B","text":"Clearance is 2 L/h"},{"label":"C","text":"Elimination follows zero-order kinetics"},{"label":"D","text":"Half-life is 8 hours"},{"label":"E","text":"Doubling the rate of infnsion would result in a plasma concentration of 16 mg/L at 40 hours"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ffe70629f14b","stem":"A nineteen-year-old woman is brought to the hospital with severe asthmatic wheezing. You decide to use IV theophylline for treatment. The pharmacokinetics of theophylline include the following average parameters: Vd 35 L; CL 48 mL/min; half-life 8 hours. If an IV infnsion of theophylline is started at a rate of 0.48 mg/min, how long will it take to reach 93.75% of the final steady state concentration?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Pharmacokinetic","suggestedTopic":null,"options":[{"label":"A","text":"Approximately 48 minutes"},{"label":"B","text":"Approximately 7.4 hours"},{"label":"C","text":"Approximately 8 hours"},{"label":"D","text":"Approximately 24 hours"},{"label":"E","text":"Approximately 32 hours"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"]},{"id":"q-a5c64e0970e5","stem":"Your 74-year-old patient with a myocardial infarction has a severe cardiac arrhythmia. You have decided to give lidocaine to correct the arrhythmia .A continuous IV infnsion of lidocaine, 1.92 mg/min, is started at 8 am. The average pharmacokinetic parameters of lidocaine are: Vd 77 L: CL 640 mL/min: half-life 1.4 hours. The expected steady-state plasma concentration is approximately","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Pharmacokinetic","suggestedTopic":null,"options":[{"label":"A","text":"40 mg/L"},{"label":"B","text":"3.0 mg/L"},{"label":"C","text":"0.025 mg/L"},{"label":"D","text":"7.2 mg/L"},{"label":"E","text":"3.46 mg/L"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-dde9e02f6771","stem":"Your patient has been receiving lidocaine for 8 hours and you decide to obtain a plasma concentration measurement. When the results come back, the plasma level is exactly twice of what you expected. The infusion rate should","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"be changed to 0.48 mg/min"},{"label":"B","text":"be changed to 0.96 mg/min"},{"label":"C","text":"be halted for 1.4 h and then restarted at 0.96 mg/min"},{"label":"D","text":"be halted for 1.4 h and then restarted at 1.92 mg/min"},{"label":"E","text":"not be changed but the plasma level should be measured again"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-163988078ee2","stem":"A patient requires an infusion of procainamide, lts half-life is 2 hours. The infusion is begun at 9 AM. At 1 PM the same day a blood sample is taken; the drug concentration is found to be 3 mg/L. What is the probable steady-state drug concentration, eg, after 12 hours of infnsion?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"3 mg/L"},{"label":"B","text":"4 mg/L"},{"label":"C","text":"6 mg/L"},{"label":"D","text":"9.9 mg/L"},{"label":"E","text":"15 mg/L"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-dfcd5f347cc0","stem":"A young man is brought to the emergency room in a deep coma. His friends state that he took a large dose of morphine 6 hours earlier. An immediate blood analysis shows a morphine blood level of 0.25 mg/L. Assuming that the pharmacokinetics of morphine in this patient are Vd 200 L and half-life is 3 hours, how much morphine did the patient inject 6 hours earlier ؟","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Pharmacokinetic","suggestedTopic":null,"options":[{"label":"A","text":"25 mg"},{"label":"B","text":"50 mg"},{"label":"C","text":"100 mg"},{"label":"D","text":"200 mg"},{"label":"E","text":"not enough data to predict"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-6820c426e351","stem":"A normal volunteer will receive a new drug in a phase 1 clinical trial. The clearance and volume of distribution of the drug in this subject are 1.386 L/h and 80 L, respectively. The half-life of the drug in this subject will be approximately","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"83 hours"},{"label":"B","text":"77 hours"},{"label":"C","text":"58 hours"},{"label":"D","text":"40 hours"},{"label":"E","text":"0.02 hours"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["answer-leak or footer removed","option_whitespace_normalization"],"duplicateStemGroup":"1fa558200b70dafbbde6c7a294e1d3f51d664c5a"},{"id":"q-964fa5507066","stem":"Gentamicin is often given in intermittent IV bolus doses of 100 mg three times a day to achieve target peak plasma concentration of about 5 mg/L. Gentamicin's clearance (normally 5.4 L/h/70kg) is almost entirely by glomerular filtration. Your patient, however, is found to have a creatinine clearance one-third of normal. Your initial dosage regimen for this patient would probably be","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"20 mg three times a day"},{"label":"B","text":"33 mg three times a day"},{"label":"C","text":"72 mg three times a day"},{"label":"D","text":"100 mg twice a day"},{"label":"E","text":"150 mg twice a day A new drug was studied in 20 healthy volunteers to determine basic pharmacokinetic parameters. A dose of 100 mg was administered as an intravenous bolus to each volunteer and blood samples were analyzed at intervals as shown in the graph below. The average plasma concentrations at each time are shown by the solid circles at 10 and 30 minutes and at 1, 2, 3, 4, 6, and 8 hours after administration."}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"67cce4232607f5e9b26367a3cfaec20787530788"},{"id":"q-a76961230786","stem":"The elimination half-life of the new drug is approximately","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"1.5 hours"},{"label":"B","text":"2 hours"},{"label":"C","text":"4 hours"},{"label":"D","text":"6 hours"},{"label":"E","text":"8 hours"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-cf4c824b71d8","stem":"The volume of distribution of the new drug is approximately","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"0.05 L"},{"label":"B","text":"0.1L"},{"label":"C","text":"5 L"},{"label":"D","text":"10 L"},{"label":"E","text":"20 L"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e5f4bcf97b83","stem":"The clearance of the new drug is approximately","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Pharmacokinetics and Dynamics · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Pharmacokinetics and Dynamics","options":[{"label":"A","text":"0.43 L/h"},{"label":"B","text":"0.86 L/h"},{"label":"C","text":"1.15L/h"},{"label":"D","text":"2.3 L/h"},{"label":"E","text":"Too few data to answer"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Pharmacokinetics and Dynamics · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["answer-leak or footer removed"]},{"id":"q-e28a0d3e2c49","stem":"1 `Essential drugs’ are","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Life saving drugs"},{"label":"B","text":"Drugs that meet the priority health care needs of the population"},{"label":"C","text":"Drugs that must be present in the emergency bag of a doctor"},{"label":"D","text":"Drugs that are listed in the pharmacopoia of a country (p. 5)"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-695265a3dca5","stem":"2 An 'orphan drug' is","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A very cheap drug"},{"label":"B","text":"A drug which has no therapeutic use"},{"label":"C","text":"A drug needed for treatment or prevention of a rare disease"},{"label":"D","text":"A drug which acts on Orphanin receptors (p. 5, 6)"}],"priori