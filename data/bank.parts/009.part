s":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-27f8a6cae54e","stem":"Which of the following statements regarding aminoglycoside antibiotics are correct? (Check all that apply)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"They are mainly bacteriostatic for sensitive organisms"},{"label":"B","text":"They are mainly used for infections caused by gram-negative bacteria"},{"label":"C","text":"They are frequently used in combination with macrolides"},{"label":"D","text":"They can cause vestibular toxicity"},{"label":"E","text":"Superinfection is the most common problem related to the clinical use of these drugs"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-3a9703536d8d","stem":"The mechanism of action of aminoglycoside antibiotics is characterized by which of the following molecular events? (Check all that apply)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Blockade of the formation of initiation complex"},{"label":"B","text":"Inhibition of transpeptidase enzymes"},{"label":"C","text":"Incorrect amino acid incorporation into the bacterial polypeptide chain"},{"label":"D","text":"Blockade of elongation of peptidoglycan chain"},{"label":"E","text":"Inhibition of DNA-dependent RNA polymerase"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-77653c8572f9","stem":"Which of the following is the primary step ofthe mechanism of action of aminoglycosides?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antimicrobials","options":[{"label":"A","text":"Binding to the 30S ribosomal subunit"},{"label":"B","text":"Binding to topoisomerase II"},{"label":"C","text":"Binding to peptidyl transferase"},{"label":"D","text":"Inhibition of the synthesis of mycolic acids"},{"label":"E","text":"Inhibition of peptidoglycan transpeptidation"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"c44d81dfbc5382cdfecf75f903eeff64f14f9274"},{"id":"q-e5b47aeafbe2","stem":"Whichof the following microorganisms are sensitive to aminoglycoside antibiotics? (Check all that apply)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Clostridium difficile"},{"label":"B","text":"Pseudomonas aeruginosa"},{"label":"C","text":"Bacteroides fragilis"},{"label":"D","text":"Borrelia recurrentis"},{"label":"E","text":"Neisseria gonorrhea"},{"label":"F","text":"Klebsiella pneumoniae"},{"label":"G","text":"Escherichia coli"},{"label":"H","text":"Mycoplasma pneumoniae I) Legionella pneumophila"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","too_many_options"],"cleaningOperations":[],"duplicateStemGroup":"f8810fbdd99114006f6f2ccc69d81670499f970a"},{"id":"q-48c4c97657bf","stem":"Bacterial resistance to the aminoglycosides is most likely mediated by","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"growth of the bacteria under anaerobic conditions."},{"label":"B","text":"growth of the bacteria in an alkaline environment."},{"label":"C","text":"inactivation of the drug."},{"label":"D","text":"production of beta-lactamases."},{"label":"E","text":"alteration of the target."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"newly_reasoned_provisional","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-9b2213eb2b89","stem":"Which of the following statements about the pharmacokinetics of aminoglycosides are correct? (Check all that apply)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Pharmacokinetic","suggestedTopic":null,"options":[{"label":"A","text":"They are well absorbed when given by oral route"},{"label":"B","text":"Therapeutic concentrations can be achieved in urine"},{"label":"C","text":"Concentrations in the cerebrospinal fluid are about one-half of those in plasma"},{"label":"D","text":"They readily penetrate mammalian cell membranes and are concentrated inside the cells"},{"label":"E","text":"Their Half-lives can be 20-40 times longer in case of kidney failure"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-861306c80866","stem":"Which of the following statements regarding the toxicity of aminoglycosides are cor rect? (Check all that apply)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antimicrobials","options":[{"label":"A","text":"Allergic reactions are very common and often serious"},{"label":"B","text":"The risk of toxicity of thesedrugs is increased in patients with auditory impairment"},{"label":"C","text":"The risk of ototoxicity is increased in patients with renal failure"},{"label":"D","text":"Ototoxicity is irreversible"},{"label":"E","text":"Nephrotoxicity is reversible"},{"label":"E","text":"Nephrotoxicity is reversible if the drug is discontinued, but can otherwise lead to renal insufficiency"}],"priority":2,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"edbcf22cb3920bf50463366df330bd2df4bf90b5"},{"id":"q-e2540dc395de","stem":"Aminoglycosides are often used in combination with which of the following drug classes, to treat life-threatening infections in immunosuppressed patients?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antimicrobials","options":[{"label":"A","text":"Tetracycline"},{"label":"B","text":"Macrolides"},{"label":"C","text":"Quinolones"},{"label":"D","text":"Reverse transcriptase inhibitors"},{"label":"E","text":"Cephalosporins"},{"label":"F","text":"Rifamycins"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8b46d857f4e8","stem":"A 33-year-old woman with type I diabetes is admitted to the hospital with fever (1 02F), shaking chills, nausea and vomiting, flank pain and hematuria. She has been suffering from chro nic lower urinary tract infection for one year. The predominant pathogen of the infection was found to be Pseudomonas aeruginosa. The most appropriate treatment for this patient would include which of the following pairs of drugs? ys history of fever, shaking chills, rigors and night sweats. His vital sings were: BP 100/60 mm Hg, pulse 120 bpm, respirations 24/min, temperature 103.7 F. Two-dimensional echocardiography revealed three small vegetations on the prosthetic valve. Empir c therapy with amphotericin B, vancomycin and gentamicin was initiated. Three blood cultures were drawn and they were positive for Pseudomonas aeruginosa. A surgical excision of the infected valve and a 6 week postoperative treatment was planned. Which of the following pairs of drugs would be most appropriate for this patient?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Piperacillin and tobramycin"},{"label":"B","text":"Ampicillin and gentamicin"},{"label":"C","text":"Imipenem and erythromycin"},{"label":"D","text":"Cephalothin and amikacin"},{"label":"E","text":"Ampicillin and doxycycline 10 ) A 30-year-old male heroin addict, who had his tricuspid valve replaced 8 months ago, was readmitted to the hospital with a two da i"},{"label":"A","text":"Amphotericin B and clindamycin"},{"label":"B","text":"Cefotaxime and tobramycin"},{"label":"C","text":"Metronidazole and gentamicin"},{"label":"D","text":"Vancomycin and erythromycin"},{"label":"E","text":"Piperacillin and cefazolin"}],"priority":2,"status":"review","flags":["topic_generic","too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","too_many_options","too_many_options_possible_merge","topic_generic"],"cleaningOperations":[]},{"id":"q-6061e7f4da3f","stem":"Which of the following statements best explains the mechanism of action of macrolides? ) Which of the following is the primary cellular site of action of clarithromycin? ) Which of the following drugs can be used to treat infections due to Mycobacterium avium complex in patients with AIDS? ) Which of the following statements correctly pairs the binding site of clindamycin with the action that follows that binding? The primary clinical use of clindamycin is to treat which of the following infections? ) A 15-year-old girl complained of watery diarrhea. She was recently diagnosed with streptococcal pharyngitis and started treatment with erythromycin three days ago. Which of the following statements best explains the cause of the diarrhea in this patient ?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Inhibition of DNA-dependent RNA polymerase"},{"label":"B","text":"Blockade of the formation of ribosomal initiation complex"},{"label":"C","text":"Blockade of peptide bond formation"},{"label":"D","text":"Blockade of translocation"},{"label":"E","text":"Inhibition oftranspeptidase enzymes 12"},{"label":"A","text":"The cytoplasmic bacterial membranes"},{"label":"B","text":"The outer bacterial membrane"},{"label":"C","text":"The porin channels"},{"label":"D","text":"The peptidoglycan layer"},{"label":"E","text":"The microsomes"},{"label":"F","text":"The mitochondria"},{"label":"G","text":"The ribosomes 13 ) Which of the following microorganisms are sensitive to macrolides? (check all that apply)"},{"label":"A","text":"Pseudomonas aeruginosa"},{"label":"B","text":"Helicobacter pylori"},{"label":"C","text":"Shigella dysenteriae"},{"label":"D","text":"Klebsiella pneumoniae"},{"label":"E","text":"Bacteroides fragilis"},{"label":"F","text":"Bordetella pertussis"},{"label":"G","text":"Herpes simplex virus 14 ) Which of the following microorganisms are sensitive to azithromycin? (Check all that apply)"},{"label":"A","text":"Mycoplasma pneumoniae"},{"label":"B","text":"Klebsiella pneumoniae"},{"label":"C","text":"Chlamydia pneumoniae"},{"label":"D","text":"Candida albicans"},{"label":"E","text":"Mycobacterium avium complex"},{"label":"F","text":"Giardia lamblia 15 ) Bacterial resistance to macrolides may be due to which of the following mechanisms? (Check all that apply)"},{"label":"A","text":"Active drug efflux from the bacterial cell"},{"label":"B","text":"Reduced uptake of the drug by the bacterial cell"},{"label":"C","text":"Altered ribosomal binding site which prevents drug binding"},{"label":"D","text":"Production of acetyl transferase enzymes that inactivate the drug"},{"label":"E","text":"Production of phosphoryl transferase enzymes that inactivate the drug 16 ) Which of the following statements about the resistance to macrolide antibiotics are correct? (Check all that apply)"},{"label":"A","text":"It is exceedingly rare"},{"label":"B","text":"It is completely crossed among different macrolides"},{"label":"C","text":"It is partially crossed between macrolides and aminoglycosides"},{"label":"D","text":"It is common for Bacteroides fragilis and Pseudomonas aeruginosa"},{"label":"E","text":"It is usually acquired by a plasmid-mediated transfer 17"},{"label":"A","text":"Ampicillin"},{"label":"B","text":"Tetracycline"},{"label":"C","text":"Clarithromycin"},{"label":"D","text":"Metronidazole"},{"label":"E","text":"Vancomycin 18"},{"label":"A","text":"30S ribosomal subunit - increased synthesis of lethal proteins"},{"label":"B","text":"Cytoplasmic membrane - depolarization"},{"label":"C","text":"30S ribosomal subunit - misreading of mRNA template"},{"label":"D","text":"50S ribosomal subunit - blockade of peptide bond formation"},{"label":"E","text":"Cell wall - blockade of cross-linking of the peptidoglycan chain 19)"},{"label":"A","text":"Legionella"},{"label":"B","text":"Klebsiella"},{"label":"C","text":"Clostridium"},{"label":"D","text":"Mycobacterial"},{"label":"E","text":"Proteus 20"},{"label":"A","text":"Erythromycin kills most bacteria of the intestinal flora"},{"label":"B","text":"Erythromycin inhibits water reabsorption by colonic mucosa"},{"label":"C","text":"Erythromycin stimulates motilin receptors in the gut"},{"label":"D","text":"It is caused by an allergic reaction to erythromycin"}],"priority":2,"status":"review","flags":["topic_generic","too_many_options_possible_merge","duplicate_option_labels","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","duplicate_option_text","nonunique_option_labels","nonunique_option_text","prior_structural_review_flag","too_many_options","too_many_options_possible_merge","topic_generic"],"cleaningOperations":[]},{"id":"q-b3627d12975e","stem":"A 22-year-old woman presented with fever and a very painful sore throat. The woman was otherwise healthy, but medical history was significant for a congenital long QT syndrome discovered six years ago. On physical examination the throat was erythematous with exudative patches. A Gram stain of the exudate showed many gram-positive bacteria. The patient was prescribed an antibiotic treatment. Which of the following drugs would be contraindicated in this woman? ) A 15-day-old baby was admitted to pediatric ward with mucopurulent ocular discharge, edema of the eyelids and pseudomembrane formation. A Gram stain of the exudate revealed no microorganisms. A Giemsa's stain showed cytoplasmic in clusions consistent with an infection by Chlamydia trachomatis. Which of the following drugs would be most appropriate for this patient?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Vancomycin"},{"label":"B","text":"Amoxicillin"},{"label":"C","text":"Cefepime"},{"label":"D","text":"Erythromycin"},{"label":"E","text":"Meropenem"},{"label":"F","text":"Rifampin 22"},{"label":"A","text":"Tetracycline"},{"label":"B","text":"Erythromycin"},{"label":"C","text":"Metronidazole"},{"label":"D","text":"Vancomycin"},{"label":"E","text":"Ampicillin"},{"label":"F","text":"Tobramycin"}],"priority":2,"status":"review","flags":["too_many_options_possible_merge","duplicate_option_labels","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","duplicate_option_text","nonunique_option_labels","nonunique_option_text","prior_structural_review_flag","too_many_options","too_many_options_possible_merge"],"cleaningOperations":[]},{"id":"q-056d48281cd4","stem":"Which of the following statements about tetracyclines are correct? (Check all that apply)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"They are mainly bactericidal drugs for susceptible bacteria"},{"label":"B","text":"They are active against mycoplasma and chlamydia"},{"label":"C","text":"Most compounds do not cross the blood brain barrier even when meningesare inflamed"},{"label":"D","text":"They may cause the gray baby syndrome when given to the newborn"},{"label":"E","text":"They are chelating agents that bind to several cations including calcium"},{"label":"F","text":"They may accumulate in bone, dentine and teeth enamel 24 ) Which of the following microorganisms are sensitive to tetracyclines? (Check all that apply)"},{"label":"A","text":"Bacillus anthrancis"},{"label":"B","text":"Helicobacter pylori"},{"label":"C","text":"Bordetella pertussis"},{"label":"D","text":"Legionella pneumophila"},{"label":"E","text":"Clostridium difficile"},{"label":"F","text":"Borrelia burgdorferi"},{"label":"G","text":"Mycoplama pneumoniae 25 ) Bacterial resistance to tetracyclines may be due to which of the following mechanisms? (Check all that apply)"},{"label":"A","text":"Production of an effusion pump that extrudes the drug from the bacterial cell"},{"label":"B","text":"Production of acetyl transferase enzymes that inactivate the drug"},{"label":"C","text":"Reduced permeability of the outer bacterial membrane to the drug"},{"label":"D","text":"Production of phosphoryl transferase enzymes that inactivate the drug"},{"label":"E","text":"Altered binding of the transpeptidase enzyme"}],"priority":2,"status":"review","flags":["topic_generic","too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","too_many_options","too_many_options_possible_merge","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"ebef7c6ece1709cdc18669e1f95628f5f7cc416e"},{"id":"q-4d3e94b42795","stem":"Which of the following are most likely adve rse effects of tetracyclines? (Check all that apply)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Impairment of liver function"},{"label":"B","text":"Gray baby syndrome"},{"label":"C","text":"Seizures"},{"label":"D","text":"Dystonic reactions"},{"label":"E","text":"Tooth discoloration in young children"},{"label":"F","text":"Kernicterus in the newborn infants"},{"label":"G","text":"Photosensitivity"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"0a71a736efc7ae93704e251460ef2996ebd816ec"},{"id":"q-8d9ac84863f0","stem":"Which of the following statements best describes the mechanism of action of chloramphenicol? ) Which of the following diseases is most likely caused by an idiosyncratic reaction to chloramphenicol? ) Which of the following antibiotics binds to the 50S ribosomal subunit and inhibits the formation of the initiation complex? ular skin lesion started at the bite site, expanded to 15 cm or so, and was followed by multiple, painless rashes. Which of the following drugs would be most appropriate for this patient? ) A 36-year-old man is admitted to the hospital with high fever, chills, tachycardia, vomiting and muscle pain. He had the same symptoms 10 days ago, just after a staying in a campground near the border with Mexico. The feve r was high for 3 days, then cleared abruptly. A thick blood smear with Giemsa stain revealed many threadlike bacteria with large, irregular coils. Which of the following drugs would be most appropriate for this patient?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Inhibition of cross linking of linear peptidoglycan chains"},{"label":"B","text":"Blockade of the peptide bond formation"},{"label":"C","text":"Inhibition of relaxation of supercoiled bacterial DNA"},{"label":"D","text":"Inhibition of ergosterol synthesis in the bacterial cell membrane"},{"label":"E","text":"Misreading of the mRNA template in the ribosomal subunit 28"},{"label":"A","text":"Acute renal failure"},{"label":"B","text":"Acute liver necrosis"},{"label":"C","text":"Optic neuritis"},{"label":"D","text":"Gray baby syndrome"},{"label":"E","text":"Aplastic anemia 29"},{"label":"A","text":"Tetracycline"},{"label":"B","text":"Erythromycin"},{"label":"C","text":"Chloramphenicol"},{"label":"D","text":"Gentamicin"},{"label":"E","text":"Linezolid"},{"label":"F","text":"Rifampin 30 ) Which of the following microorganisms are most sensitive to both macrolides and tetracyclines? (Check all that apply)"},{"label":"A","text":"Bacillus anthrancis"},{"label":"B","text":"Mycoplasma pneumoniae"},{"label":"C","text":"Chlamydia pneumoniae"},{"label":"D","text":"Helicobacter pylori"},{"label":"E","text":"Borrelia burgdorferi 31 ) A 33-year-old woman presents with fatigue, low grade fever, muscle and joint pain, and multiple red rashes with a clear center. She stated that 20 days ago she was bitten on a arm by a tiny tick and that a circ"},{"label":"A","text":"Gentamicin"},{"label":"B","text":"Ciprofloxacin"},{"label":"C","text":"Trimethoprim/sulfamethoxazole"},{"label":"D","text":"Doxycycline"},{"label":"E","text":"Vancomycin 32"},{"label":"A","text":"Streptomycin"},{"label":"B","text":"Vancomycin"},{"label":"C","text":"Doxycycline"},{"label":"D","text":"Daptomycin"},{"label":"E","text":"Fluconazole Nucleic Acid Syn Inhibitors 33\\* SEQ CHAPTER \\\\1 ) Which of the following statements regarding sulfonamides are correct? (Check all that apply)"},{"label":"A","text":"They usually abruptly kill susceptible bacteria"},{"label":"B","text":"They are effective against Toxoplasma gondii"},{"label":"C","text":"They compete with para-aminobenzoic acid for the enzyme peptidyl transferase"},{"label":"D","text":"They are often given together with a dihydrofolate reductase inhibitor"},{"label":"E","text":"Most of them cannot cross the blood brain barrier even when meninges are inflamed"}],"priority":2,"status":"review","flags":["topic_generic","too_many_options_possible_merge","duplicate_option_labels","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","duplicate_option_text","nonunique_option_labels","nonunique_option_text","prior_structural_review_flag","too_many_options","too_many_options_possible_merge","topic_generic"],"cleaningOperations":[]},{"id":"q-1899b870cfe9","stem":"The mechanism of action of sulfonamides includes a competitive inhibition of which of the following enzymes?","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Water, pH and Buffers","topicOriginal":"Water, pH and Buffers","subtopic":"Acid","suggestedTopic":null,"options":[{"label":"A","text":"Purine phosphoribosyl transferase"},{"label":"B","text":"Transpeptidase"},{"label":"C","text":"Topoisomerase II"},{"label":"D","text":"Dihydropteroate synthetase"},{"label":"E","text":"Dihydrofolate reductase"},{"label":"F","text":"RNA polymerase"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Water, pH and Buffers","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-6e0479395841","stem":"Which of the following statements about the pharmacokinetics of sulfonamides are correct? (Check all that apply)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Pharmacokinetic","suggestedTopic":null,"options":[{"label":"A","text":"Oral bioavailability of systemically used compounds is very good"},{"label":"B","text":"The half-life of all compounds is less than 2 hours"},{"label":"C","text":"Concentrations in CSF are negligible in most cases, even when the meninges are inflamed"},{"label":"D","text":"Therapeutic concentrations can be achieved in urine"},{"label":"E","text":"When given to the pregnant woman, concentrations in fetal blood are very low"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-addd9efe69f9","stem":"The antibacterial activity of trimethoprim is mainly mediated by the blockade of the synthesis of which of the following molecules?","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Peptidoglycan"},{"label":"B","text":"PABA"},{"label":"C","text":"Dihydropteroic acid"},{"label":"D","text":"Folic acid"},{"label":"E","text":"Purines and pyrimidines"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"reasoned_without_reference","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[],"manualEdits":{}},{"id":"q-e46a6d0f4e76","stem":"Which of the following microorganisms sensitive to trimethoprim-sulfamethoxazole? (Check all that apply)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Neisseria meninigiditis"},{"label":"B","text":"Pseudomonas aeruginosa"},{"label":"C","text":"Rickettsia rickettsii"},{"label":"D","text":"Treponema pallidum"},{"label":"E","text":"Pneumocystis carinii"},{"label":"F","text":"Enterococcus faecalis"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ba5a0260312e","stem":"Which of the following antibacterial drugs may cause bone marrow suppression in patients taking methotrexate?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antimicrobials","options":[{"label":"A","text":"Isoniazid"},{"label":"B","text":"Vancomycin"},{"label":"C","text":"Metronidazole"},{"label":"D","text":"Trimethoprim"},{"label":"E","text":"Doxycycline"},{"label":"F","text":"Cefotaxime"},{"label":"G","text":"Piperacillin"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a9a6536e2869","stem":"Which of the following statements regarding fluoroquinolones are correct? (Check all that apply)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antimicrobials","options":[{"label":"A","text":"They prevent the relaxation of supercoiled DNA"},{"label":"B","text":"Their ultimate effect is mainly bacteriostatic"},{"label":"C","text":"Resistance is completely crossed between quinolones and sulfonamides"},{"label":"D","text":"They are effective against Rickettsia rickettsii"},{"label":"E","text":"They are considered drugs of choice for bacteroides infections"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8fd7bf6a5b16","stem":"Which of the following antibacterial drugs is effective against most gram-negative bacteria, including Pseudomonas aeruginosa, as well as against Salmonella, Shigella, and Rickettsiae?","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Piperacillin"},{"label":"B","text":"Cefotaxime"},{"label":"C","text":"Ciprofloxacin"},{"label":"D","text":"Erythromycin"},{"label":"E","text":"Vancomycin"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"226a8349e5697d3ed9abeb747c1b5b522c0726ec"},{"id":"q-634af664dbc4","stem":"A 34-year-old woman with AIDS presents to the emergency room reporting 2 seizures in the past 24 hours. Ph ysical signs include fever, altered mental status and a visual field defect. A magnetic resonance imaging of the head reveals several ring-shaped lesions in the brainstem. A brain biopsy shows crescent-shaped trophozoites within macrophages. Which of the following drug combinations would be appropriate to cure the patient's infection?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Gentamicin and piperacillin"},{"label":"B","text":"Sulfadiazine and pyrimethamine"},{"label":"C","text":"Vancomycin and ceftazidime"},{"label":"D","text":"Isoniazid and rifampin"},{"label":"E","text":"Streptomycin and tetracycline"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"36d7a9c1a21f0282502fc0b5452787a729b7ec5a"},{"id":"q-85710cf8b895","stem":"A 61-year-old woman developed watery diarrhea, nausea and vomiting and abdominal cramps after a dinner with her family at a fast-food restaurant. The next day several other family members developed the same symptoms. Her medical history is significant for a right hip p r osthesis. Stool aerobic cultures yielded lactose-negative, gram-negative rods which produced hydrogen disulfide. Which of the following drugs would be an appropriate treatment for this patient?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Erythromycin"},{"label":"B","text":"Oxacillin"},{"label":"C","text":"Ciprofloxacin"},{"label":"D","text":"Ketoconazole"},{"label":"E","text":"Vancomycin"},{"label":"F","text":"Ribavirin"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"fa6708fe0319030da5030089629f63819d04a8f5"},{"id":"q-062ee3989b35","stem":"The antibacterial effects of metronidazole are mediated by which of the following mechanisms? (Check all that apply)","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Reduction of nitroimidazole group"},{"label":"B","text":"Inhibition of transpeptidase"},{"label":"C","text":"Formation of cytotoxic intermediates"},{"label":"D","text":"Depolarization of the cell membrane"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-864d9b3dad38","stem":"Daptomycin inhibits DNA and RNA synthesis in bacterial cells by","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"depolarizing the cell membrane."},{"label":"B","text":"blocking dihydropteroate synthetase."},{"label":"C","text":"blocking dihyrofolate reductase."},{"label":"D","text":"inhibiting DNA gyrase. \\*504b030414000600080000002100e9de0fbfff0000001c020000130000005b436f6e74656e745f54797065735d2e786d6cac91cb4ec3301045f748fc83e52d4a 9cb2400825e982c78ec7a27cc0c8992416c9d8b2a755fbf74cd25442a820166c2cd933f79e3be372bd1f07b5c3989ca74aaff2422b24eb1b475da5df374fd9ad 5689811a183c61a50f98f4babebc2837878049899a52a57be670674cb23d8e90721f90a4d2fa3802cb35762680fd800ecd7551dc18eb899138e3c943d7e503b6 b01d583deee5f99824e290b4ba3f364eac4a430883b3c092d4eca8f946c916422ecab927f52ea42b89a1cd59c254f919b0e85e6535d135a8de20f20b8c12c3b0 0c895fcf6720192de6bf3b9e89ecdbd6596cbcdd8eb28e7c365ecc4ec1ff1460f53fe813d3cc7f5b7f020000ffff0300504b030414000600080000002100a5d6 a7e7c0000000360100000b0000005f72656c732f2e72656c73848fcf6ac3300c87ef85bd83d17d51d2c31825762fa590432fa37d00e1287f68221bdb1bebdb4f c7060abb0884a4eff7a93dfeae8bf9e194e720169aaa06c3e2433fcb68e1763dbf7f82c985a4a725085b787086a37bdbb55fbc50d1a33ccd311ba548b6309512 0f88d94fbc52ae4264d1c910d24a45db3462247fa791715fd71f989e19e0364cd3f51652d73760ae8fa8c9ffb3c330cc9e4fc17faf2ce545046e37944c69e462 a1a82fe353bd90a865aad41ed0b5b8f9d6fd010000ffff0300504b0304140006000800000021006b799616830000008a0000001c0000007468656d652f746865 6d652f7468656d654d616e616765722e786d6c0ccc4d0ac3201040e17da17790d93763bb284562b2cbaebbf600439c1a41c7a0d29fdbd7e5e38337cedf14d59b 4b0d592c9c070d8a65cd2e88b7f07c2ca71ba8da481cc52c6ce1c715e6e97818c9b48d13df49c873517d23d59085adb5dd20d6b52bd521ef2cdd5eb9246a3d8b 4757e8d3f729e245eb2b260a0238fd010000ffff0300504b03041400060008000000210096b5ade296060000501b0000160000007468656d652f7468656d652f 7468656d65312e786d6cec594f6fdb3614bf0fd87720746f6327761a07758ad8b19b2d4d1bc46e871e698996d850a240d2497d1bdae38001c3ba618715d86d87"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"1b881246d6b4e29c0e94b4229d8afaf4937be2e7"},{"id":"q-35e226cd00ec","stem":") Which of the following microorganisms are sensitive to azithromycin?","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e427a6ce6aaa","stem":") Bacterial resistance to macrolides may be due to which of the following mechanisms?","type":"Short Answer","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-9d7833d28af0","stem":") Which of the following statements about the resistance to macrolide antibiotics are correct?","type":"Short Answer","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-14a61d365a82","stem":") Which of the following drugs can be used to treat infections due to Mycobacterium avium complex in patients with AIDS?","type":"Clinical Vignette","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"1661b811efccd75de920777b41eff62f1df5445b"},{"id":"q-559436c5ca23","stem":") Which of the following statements correctly pairs the binding site of clindamycin with the action that follows that binding?","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"e8ee58bac535503a66f53b71b4eaf2e8b4f98946"},{"id":"q-860aab4fa3db","stem":"The primary clinical use of clindamycin is to treat which of the following infections?","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"fdaae3b1886ba864994569316157573836ca0dbb"},{"id":"q-e3feef2f5d40","stem":") Bacterial resistance to tetracyclines may be due to which of the following mechanisms?","type":"Short Answer","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-2d7b03729486","stem":") Which of the following microorganisms are most sensitive to both macrolides and tetracyclines?","type":"Short Answer","subject":"Pharmacology","topic":"Antimicrobials · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antimicrobials","options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-37464a74111e","stem":"ular skin lesion started at the bite site, expanded to 15 cm or so, and was followed by multiple, painless rashes. Which of the following drugs would be most appropriate for this patient?","type":"Clinical Vignette","subject":"Dermatology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Dermatology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6621e02d5960","stem":"r was high for 3 days, then cleared abruptly. A thick blood smear with Giemsa stain revealed many threadlike bacteria with large, irregular coils. Which of the following drugs would be most appropriate for this patient?","type":"Clinical Vignette","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-598c2f96614a","stem":") Which of the following statements regarding sulfonamides are correct?","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a1292c92d8e7","stem":"D Aminoglycoside are mainly active against aerobic gram-negative bacteria. Activity against cocci is significant only when they are given together with a beta-lactam antibiotic, because the beta-lactam drug damages the bacterial cell wall so increasing the p enetration of the aminoglycoside inside the bacterial cell. Aminoglycosides in chronic doses can cause ototoxicity and nephrotoxicity, since they concentrate in the renal cortex and in the inner ear.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Aminoglycosides are bactericidal drugs."},{"label":"C","text":"Aminoglyc osides are not currently used in combination with macrolides. In general (but there are few exceptions) a combination of a bactericidal with a bacteriostatic antibiotic leads to antagonistic effects."},{"label":"E","text":"Aminoglycosides rarely cause superinfections since they have a narrow antibacterial spectrum."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-627e31ade9af","stem":"Resistance to aminoglycosides is mainly due to a plasmid-mediated production of bacterial transferases that phosphorylat e, acetylate and adenylate the drug. Resistance appear mostly to gentamicin and the least to amikacin which is susceptible to only a few transferase enzymes. A, B) The activity of the aminoglycosides is reduced in an anaerobic environment since the penetra tion of the drug into the bacterial cell is dependent upon oxygen. An acidic environment as well as cations and hyperosmolar environments reduce the efficacy of the aminoglycosides.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antimicrobials","options":[{"label":"D","text":"Beta-lactamases inactivate beta-lactam antibiotics."},{"label":"E","text":"Alteration of the target is a mechanism of resistance to other inhibitors of protein synthesis."}],"priority":2,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-8b4e43cb543a","stem":"Which of the following statements regarding the toxicity of aminoglycosides are co rrect? (Check all that apply)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antimicrobials","options":[{"label":"A","text":"Allergic reactions are very common and often serious"},{"label":"B","text":"The risk of toxicity of thesedrugs is increased in patients with auditory impairment"},{"label":"C","text":"The risk of ototoxicity is increased in patients with renal failure"},{"label":"D","text":"Ototoxicity is irreversible"},{"label":"E","text":"Nephrotoxicity is reversible"},{"label":"E","text":"Nephrotoxicity is reversible if the drug is discontinued, but can otherwise lead to renal insufficiency"}],"priority":2,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"edbcf22cb3920bf50463366df330bd2df4bf90b5"},{"id":"q-6f784811fa7d","stem":"A 33-year-old woman with type I diabetes is admitted to the hospital with fever ( 1 02F), shaking chills, nausea and vomiting, flank pain and hematuria. She has been suffering from chro nic lower urinary tract infection for one year. The predominant pathogen of the infection was found to be Pseudomonas aeruginosa. The most appropriate treatment for this patient would include which of the following pairs of drugs?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Piperacillin and tobramycin"},{"label":"B","text":"Ampicillin and gentamicin"},{"label":"C","text":"Imipenem and erythromycin"},{"label":"D","text":"Cephalothin and amikacin"},{"label":"E","text":"Ampicillin and doxycycline"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"1be8d8c85acbb2c38193c3c2272f088a335939bb"},{"id":"q-e1dd398dfc9d","stem":"The clinical picture and the past history of the patient suggest that the woman is affected by acute pyel onephritis, which is a well known complication of lower chronic urinary tract infections. Among patients aged 20 to 50 years, urinary tract infections are about fifty-fold greater in women. In women, pyelonephritis occurs by the ascending route despite th edynamics of urine flow. In the present patient diabetes could predispose her to renal infections, possibly because diabetics have altered antibacterial defense mechanisms. Since the patient is acutely ill and P. aeruginosa is most likely the causative age nt of pyelonephritis, she should be treated with an antipseudomonal penicillin plus an aminoglycoside. Both drugs are bactericidal against P. aeruginosa and, moreover, penicillins are synergistic with aminoglycosides. B, C , D) Only one of the two listed antibiotics is effective against P. aeruginosa. ys history of fever, shaking chills, rigors and night sweats. His vital sings were: BP 100/60 mm Hg, pulse 120 bpm, respirations 24/min, temperature 103.7 F. Two-dimensional echocardiography revealed three small vegetations on the prosthetic valve. Empir c therapy with amphotericin B, vancomycin and gentamicin was initiated. Three blood cultures were drawn and they were positive for Pseudomonas aeruginosa. A surgical excision of the infected valve and a 6 week postoperative treatment was planned. Which of the following pairs of drugs would be most appropriate for this patient?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"E","text":"Ampicillin and tetracyclines are not effective against P. aeruginosa. 10 ) A 30-year-old male heroin addict, who had his tricuspid valve replaced 8 months ago, was readmitted to the hospital with a two da i"},{"label":"A","text":"Amphotericin B and clindamycin"},{"label":"B","text":"Cefotaxime and tobramycin"},{"label":"C","text":"Metronidazole and gentamicin"},{"label":"D","text":"Vancomycin and erythromycin"},{"label":"E","text":"Piperacillin and cefazolin"}],"priority":2,"status":"review","flags":["duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","long_stem_manual_review","nonunique_option_labels","prior_structural_review_flag"],"cleaningOperations":[]},{"id":"q-575207c9bb6c","stem":"The clinical picture strongly suggests that the patient has a prosthetic valve endocarditis. Endocarditis occurring in in jection drug users, especially when infection involves the tricuspid valve, is commonly caused by S. aureus strains, many of which are methicillin resistant (MR). Therefore the empiric therapy with amphotericin B, (because of the possibility of candida en d ocarditis) vancomycin (the drug of first choice for MR staphylococci) and gentamicin was a rational one. After the result of susceptibility testing the therapy must be changed since P. aeruginosa is the most likely cause of prosthetic valve endocarditis. C efotaxime and tobramycin both are effective against P. Aeruginosa. Moreover there is substantial evidence that a beta-lactam and an aminoglycoside antibiotic exert a synergistic effect in serious infections caused by a number of gram-negative bacteria, in cluding P. aeruginosa, likely because beta-lactam drugs increase the cellular uptake of aminoglycosides into these bacteria. 11 ) Which of the followingstatements best explains the mechanism of action of macrolides? ) Which of the following is the primary cellular site of action of clarithromycin?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Inhibition of DNA-dependent RNA polymerase"},{"label":"B","text":"Blockade of the formation of ribosomal initiation complex"},{"label":"C","text":"Blockade of peptide bond formation"},{"label":"D","text":"Blockade of translocation"},{"label":"E","text":"Inhibition oftranspeptidase enzymes ) Macrolide antibiotics inhibit bacterial protein synthesis by blocking the translocation of the newly synthesized peptidyl-tRNA from the acceptor side to the donor s ite of the ribosome. They Are mainly bacteriostatic."},{"label":"A","text":"This would be the mechanism of action of rifampin."},{"label":"B","text":"This would be a part of the mechanism of action of aminoglycosides."},{"label":"C","text":"This would be the mechanism of action of chloramphenicol, clindamycin, and quinupristin/dalfopristin."},{"label":"E","text":"This would be the mechanism of action of beta-lactam antibiotics 12"},{"label":"A","text":"The cytoplasmic bacterial membranes"},{"label":"B","text":"The outer bacterial membrane"},{"label":"C","text":"The porin channels"},{"label":"D","text":"The peptidoglycan layer"},{"label":"E","text":"The microsomes"},{"label":"F","text":"The mitochondria"},{"label":"G","text":"The ribosomes 12 ) Clarithromycin is a macrolide antibiotic. These drugs act by binding reversibly to the 50S subunit of the bacterial ribosome which is therefore their primary cellular site of action. A, B, C, D) Since macrolides act inside the bacterial cell, they must cross all of these structures. These sites are important for the pharmacokinetics of these drugs but they are not the sites of action of macrolides. E, F) Macrolides do not affect mitochondria or microsomes. 13 ) Which of the following microorganisms are sensitive to macrolides? (check all that apply)"},{"label":"A","text":"Pseudomonas aeruginosa"},{"label":"B","text":"Helicobacter pylori"},{"label":"C","text":"Shigella dysenteriae"},{"label":"D","text":"Klebsiella pneumoniae"},{"label":"E","text":"Bacteroides fragilis"},{"label":"F","text":"Bordetella pertussis"},{"label":"G","text":"Herpes simplex virus 13 ) F Antibacterial spectrum of macrolides includes gram-positive bacteria (cocci and clostridia), some gram-negative bacteria (Neisseriae, Haemophilus, Helicobacter pylori, Legionella pneumophila, and Bordetella pertussis) as well as some mycobacteria, mycoplasmas, and chlamydiae. A, C, D, E) Macrolides are not effective against these organisms."},{"label":"G","text":"Viruses are not sensitive to macrolides 14 ) Which of the following microorganisms are sensitive to azithromycin? (Check all that apply)"},{"label":"A","text":"Mycoplasma pneumoniae"},{"label":"B","text":"Klebsiella pneumoniae"},{"label":"C","text":"Chlamydia pneumoniae"},{"label":"D","text":"Candida albicans"},{"label":"E","text":"Mycobacterium avium complex"},{"label":"F","text":"Giardia lamblia ) CE Macrolide antibiotics are effective against chlamydiae and mycoplasmas. In addition azithromycin and clarithromycin are also active against Mycobacterium avium complex. B, D, F) These microorganisms are not sensitive to macrolides. 15 ) Bacterial resistance to macrolides may be due to which of the following mechanisms? (Check all that apply)"},{"label":"A","text":"Active drug efflux from the bacterial cell"},{"label":"B","text":"Reduced uptake of the drug by the bacterial cell"},{"label":"C","text":"Altered ribosomal binding site which prevents drug binding"},{"label":"D","text":"Production of acetyl transferase enzymes that inactivate the drug"},{"label":"E","text":"Production of phosphoryl transferase enzymes that inactivate the drug"}],"priority":2,"status":"review","flags":["too_many_options_possible_merge","duplicate_option_labels","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","duplicate_option_text","long_option_manual_review","nonunique_option_labels","nonunique_option_text","prior_structural_review_flag","too_many_options","too_many_options_possible_merge"],"cleaningOperations":[]},{"id":"q-2cdd8172333a","stem":"BC Resistance to macrolides is mainly p lasmid-mediated and include1) increased active efflux of the drug, 2) decreased uptake of the drug, 3) modification of the binding site on the 50S ribosomal subunit. D, E) These are not mechanisms of bacterial resistance to macrolides but they can be hydrolyzed by esterases. 16 ) Which of the following statements about the resistance to macrolide antibiotics are correct? (Check all that apply)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"It is exceedingly rare"},{"label":"B","text":"It is completely crossed among different macrolides"},{"label":"C","text":"It is partially crossed between macrolides and aminoglycosides"},{"label":"D","text":"It is common for Bacteroides fragilis and Pseudomonas aeruginosa"},{"label":"E","text":"It is usually acquired by a plasmid-mediated transfer"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-606dcf2204fa","stem":"DE Resistance to macrolides is crossed between different macrolides and between macrolides and clindamycin. It is usually plasmid-encoded and transferred by conjugation. Bacteroides fragilis and Pseudomonas aeruginosa are intrinsically resistant to macrolides ) Which of the following drugs can be used to treat infections due to Mycobacterium avium complex in patients with AIDS?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antimicrobials","options":[{"label":"A","text":"Resistance to macrolides is frequent for some bacteria, and may emerge during treatment of an individual patient."},{"label":"C","text":"Resistance is usually crossed between agents that are closely related chemically (i.e. differen t macrolides) or that have a similar mechanism of action (i.e. macrolides and clindamycin). This is not the case between macrolides and aminoglycosides. 17"},{"label":"A","text":"Ampicillin"},{"label":"B","text":"Tetracycline"},{"label":"C","text":"Clarithromycin"},{"label":"D","text":"Metronidazole"},{"label":"E","text":"Vancomycin"}],"priority":2,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-663e8299ca61","stem":"Clarithromycin and azithromycin are active against many atypical mycobacteria, including Mycobacterium avium complex, which is the most common cause of disseminated opportunistic infection in AIDS patients. A, B; D; E) These antibiotics are not active against Mycobacterium avium complex 18 ) Which of the following statements correctly pairs the binding site of clindamycin with the action that follows that binding?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"30S ribosomal subunit - increased synthesis of lethal proteins"},{"label":"B","text":"Cytoplasmic membrane - depolarization"},{"label":"C","text":"30S ribosomal subunit - misreading of mRNA template"},{"label":"D","text":"50S ribosomal subunit - blockade of peptide bond formation"},{"label":"E","text":"Cell wall - blockade of cross-linking of the peptidoglycan chain"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f88915858c81","stem":"Clindamycin is the prototype of a class of antibiotics called lincosamides. Clindamycin has a site of action very close to that of macrolides. They bind to the 50S ribosomal subunit and block peptide bond formation. A, C) These would be mechanisms of action of aminoglycosides The primary clinical use of clindamycin is to treat which of the following infections?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"B","text":"This is the mechanism for daptomycin"},{"label":"E","text":"This is a mechanism of action of beta-lactam antibiotic 19)"},{"label":"A","text":"Legionella"},{"label":"B","text":"Klebsiella"},{"label":"C","text":"Clostridium"},{"label":"D","text":"Mycobacterial"},{"label":"E","text":"Proteus"}],"priority":2,"status":"review","flags":["duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag"],"cleaningOperations":[]},{"id":"q-2f4c67c58f05","stem":"Clindamycin is active against clostridium and bacteroides (including C. perfringens and B. fragilis). Clindamycin is th e drug of first choice for C. perfringens and an alternative to metronidazole for B. fragilis. A; B, D, E) Clindamycin is not effective in infections caused by most gram-negative bacteria and mycobacteria. 20 ) A 15-year-old girl complained of watery diarrhea. She was recently diagnosed with streptococcal pharyngitis and started treatment with erythromycin three days ago. Which of the following statements best explains the cause of the diarrhea in this patient ?","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Erythromycin kills most bacteria of the intestinal flora"},{"label":"B","text":"Erythromycin inhibits water reabsorption by colonic mucosa"},{"label":"C","text":"Erythromycin stimulates motilin receptors in the gut"},{"label":"D","text":"It is caused by an allergic reaction to erythromycin"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-14252aa492b0","stem":"Nausea, vomiting and diarrhea and abdominal pain may accompany the administration of macrolides by activating motilin receptors in the gut.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"Erythromycin is not active against most enterobacteriaceae. In fact superinfections are exceedingly rare. The drug also is bacteriostatic."},{"label":"B","text":"Erythromycin does not affect water reabsorption by colonic mucosa."},{"label":"D","text":"Allergic reactions to macrolide antibiotics are extremely rare."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"General Pharmacology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-bedae1005899","stem":"A 22-year-old woman presented with fever and a very painful sore throat. The woman was otherwise healthy, but medical history was significant for a congenital long QT syndrome discovered six years ago. On physical examination the throat was erythematous with exudative patches. A Gram stain of the exudate showed many gram-positive bacteria. The patient was prescribed an antibiotic treatment. Which of the following drugs would be contraindicated in this woman? f bacterial pharyngitis and they are sensitive to all the listed antibiotics. However the long QT syndrome contraindicates the use of macrolides since it has been shown that these antibiotics can increase the risk of polymorphic ventricular tachycardia wh ) A 15-day-old baby was admitted to pediatric ward with mucopurulent ocular discharge, edema of the eyelids and pseudomembrane formation. A Gram stain of the exudate revealed no microorganisms. A Giemsa's stain showed cytoplasmic in clusions consistent with an infection by Chlamydia trachomatis. Which of the following drugs would be most appropriate for this patient?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Vancomycin"},{"label":"B","text":"Amoxicillin"},{"label":"C","text":"Cefepime"},{"label":"D","text":"Erythromycin"},{"label":"E","text":"Meropenem"},{"label":"F","text":"Rifampin 21 ) The woman most likely had bacterial pharyngitis. Group A beta-hemolytic streptococci are the most common cause o en given to a person with long QT interval by any cause. A, B, C, E, F) These drugs are not contraindicated in patients with a long QT interval. 22"},{"label":"A","text":"Tetracycline"},{"label":"B","text":"Erythromycin"},{"label":"C","text":"Metronidazole"},{"label":"D","text":"Vancomycin"},{"label":"E","text":"Ampicillin"},{"label":"F","text":"Tobramycin ."}],"priority":2,"status":"review","flags":["too_many_options_possible_merge","duplicate_option_labels","duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","duplicate_option_text","nonunique_option_labels","nonunique_option_text","prior_structural_review_flag","too_many_options","too_many_options_possible_merge"],"cleaningOperations":[]},{"id":"q-3bcdbaf17cec","stem":"Which of the following statements about tetracyclines are correct? (Check all that apply)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"They are mainly bactericidal drugs for susceptible bacteria"},{"label":"B","text":"They are active against mycoplasma and chlamydia"},{"label":"C","text":"Most compounds do not cross the blood brain barrier even when meningesare inflamed"},{"label":"D","text":"They may cause the gray baby syndrome when given to the newborn"},{"label":"E","text":"They are chelating agents that bind to several cations including calcium"},{"label":"F","text":"They may accumulate in bone, dentine and teeth enamel"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"ebef7c6ece1709cdc18669e1f95628f5f7cc416e"},{"id":"q-0968b459f621","stem":"EF Tetracyclines are broad spectrum antibiotics. They are active against many gram-positive and gram-negative bacteria as wel l as against rickettsiae, mycoplasmas, and chlamydia. They are chelating agents that bind to several cations including calcium and this has two consequences. First, the binding can impair oral absorption of these drugs and, second, they may accumulate in teeth causing discoloration of the teeth in young children.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"Tetracyclines are mainly bacteriostatic for susceptible bacteria"},{"label":"C","text":"Tetracyclines cross the blood brain barrier even when meninges are not inflamed"},{"label":"D","text":"This would be an adverse effect of chloramphenicol. 24 ) Which of the following microorganisms are sensitive to tetracyclines? (Check all that apply)"},{"label":"A","text":"Bacillus anthrancis"},{"label":"B","text":"Helicobacter pylori"},{"label":"C","text":"Bordetella pertussis"},{"label":"D","text":"Legionella pneumophila"},{"label":"E","text":"Clostridium difficile"},{"label":"F","text":"Borrelia burgdorferi"},{"label":"G","text":"Mycoplama pneumoniae"}],"priority":2,"status":"review","flags":["too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","too_many_options","too_many_options_possible_merge"],"cleaningOperations":[]},{"id":"q-500b1e53e8af","stem":"BFG Tetracyclines are broad spectrum antibiotics active against many gram-positive and gram-n egative bacilli. They also have activity against rickettsiae, mycoplasmas, chlamydiae, and helicobacter. The latter is treated with a combination of tetracycline with metronidazole and a proton pump inhibitor. C, D; E) Infections by these bacteria are treated with macrolides. 25 ) Bacterial resistance to tetracyclines may be due to which of the following mechanisms? (Check all that apply)","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Production of an effusion pump that extrudes the drug from the bacterial cell"},{"label":"B","text":"Production of acetyl transferase enzymes that inactivate the drug"},{"label":"C","text":"Reduced permeability of the outer bacterial membrane to the drug"},{"label":"D","text":"Production of phosphoryl transferase enzymes that inactivate the drug"},{"label":"E","text":"Altered binding of the transpeptidase enzyme"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f250dac5040b","stem":"C Resistance to tetracyclines is mainly plasmid-mediated. Main mechanisms are: 1) increased active efflux of the drug, and 2) decreased uptake of the drug. B, D, E) These are not mechanisms of bacterial resistance to tetracyclines 26 ) Which of the following are most likely adverse effects of tetracyclines? (Check all that apply)","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Impairment of liver function"},{"label":"B","text":"Gray baby syndrome"},{"label":"C","text":"Seizures"},{"label":"D","text":"Dystonic reactions"},{"label":"E","text":"Tooth discoloration in young children"},{"label":"F","text":"Kernicterus in the newborn infants"},{"label":"G","text":"Photosensitivity"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-71dee86915e1","stem":"Which of the following statements best describes the mechanism of action of chloramphenicol?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Inhibition of cross linking of linear peptidoglycan chains"},{"label":"B","text":"Blockade of the peptide bond formation"},{"label":"C","text":"Inhibition of relaxation of supercoiled bacterial DNA"},{"label":"D","text":"Inhibition of ergosterol synthesis in the bacterial cell membrane"},{"label":"E","text":"Misreading of the mRNA template in the ribosomal subunit"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-dad5a8c9b75f","stem":"Chloramphenicol binds with the 50s ribosomal subunit at the peptidyl transferase site inhibiting peptide bond formation. ) Which of the following diseases is most likely caused by an idiosyncratic reaction to chloramphenicol? Chloramphenicol can cause very rarely aplastic anemia that is not dose-related and is most likely due to a genetically-induced abnormal reaction (idiosyncratic reaction) to the drug. The disease is frequently fatal. Because of its toxicity and t ) Which of the following antibiotics binds to the 50S ribosomal subunit and inhibits the formation of the initiation complex?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[{"label":"A","text":"This would be the mechanism of action of beta-lactam antibiotics."},{"label":"C","text":"This would be the mechanism of action of quinolones"},{"label":"D","text":".This would be the mechanism of action of antifungal azoles."},{"label":"E","text":"This would be one of the mechanisms of action of aminoglycosides 28"},{"label":"A","text":"Acute renal failure"},{"label":"B","text":"Acute liver necrosis"},{"label":"C","text":"Optic neuritis"},{"label":"D","text":"Gray baby syndrome"},{"label":"E","text":"Aplastic anemia 28) he availability of other effective antibiotics, chloramphenicol is now very rarely used as a systemic drug. A, B, C, D) These are not idiosyncratic reactions to chloramphenicol 29"},{"label":"A","text":"Tetracycline"},{"label":"B","text":"Erythromycin"},{"label":"C","text":"Chloramphenicol"},{"label":"D","text":"Gentamicin"},{"label":"E","text":"Linezolid"},{"label":"F","text":"Rifampin"}],"priority":2,"status":"review","flags":["too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","too_many_options","too_many_options_possible_merge"],"cleaningOperations":[]},{"id":"q-c1bc07a7c44b","stem":"Linezolid inhibits protein synthesis by binding to the P site on the 50S ribosomal subunit and preventing the formation of the initiation complex. The ultimate effect is mainly bacteriostatic.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Tetracyclines bind to the 30S ribosomal subunit and prevent binding of the aminoacyl-tRNA to the acceptor site."},{"label":"B","text":"Macrolides bind to the 50S ribosomal subunit and prevent translocation of the peptidyl tRNA from the acceptor site to the donor site."},{"label":"C","text":"Chloramphenicol binds to the 50S ribosomal subunit and prevents peptide bond formation."},{"label":"D","text":"Aminoglycosides prevent the formation of the initiation complex, but bind to the 30S, not the 50S, ribosomal subunit."},{"label":"F","text":"Rifampin does not inhibit protein synthesis. 30 ) Which of the following microorganisms are most sensitive to both macrolides and tetracyclines? (Check all that apply)"},{"label":"A","text":"Bacillus anthrancis"},{"label":"B","text":"Mycoplasma pneumoniae"},{"label":"C","text":"Chlamydia pneumoniae"},{"label":"D","text":"Helicobacter pylori"},{"label":"E","text":"Borrelia burgdorferi"}],"priority":2,"status":"review","flags":["topic_generic","too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","too_many_options","too_many_options_possible_merge","topic_generic"],"cleaningOperations":[]},{"id":"q-1a494355ff8d","stem":"CD Macrolides and tetracylines overlap in terms of some of the atypical o rganisms that they are effective against. Thus, they are drugs of first choice for mycoplasma, chlamydia, and helicobacter. ular skin lesion started at the bite site, expanded to 15 cm or so, and was followed by multiple, painless rashes. Which of the following drugs would be most appropriate for this patient?","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antimicrobials","options":[{"label":"A","text":"Macrolides are the drug of first choice for Bacillus anthrancis."},{"label":"E","text":"Tetracyclines are the drug of first choice for Borrelia burgorferi. 31 ) A 33-year-old woman presents with fatigue, low grade fever, muscle and joint pain, and multiple red rashes with a clear center. She stated that 20 days ago she was bitten on a arm by a tiny tick and that a circ"},{"label":"A","text":"Gentamicin"},{"label":"B","text":"Ciprofloxacin"},{"label":"C","text":"Trimethoprim/sulfamethoxazole"},{"label":"D","text":"Doxycycline"},{"label":"E","text":"Vancomycin"}],"priority":2,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-fe446dd75dd7","stem":"The history and the symptoms of the patient indicate that she is most likely suffering from Lyme disease, a tick borne borreliosis caused by Borrelia burgdorferi. The first stage of the disease begins as a red macule that expands, of ten with a central clearing, to a diameter as large as 50 cm (hence the name, erythema chronicum migrans). The second stage occurs within weeks to months of the onset of erythema and is characterized by arthritis (about 50% of patients) and/or neurologica land cardiac abnormalities (less than 20% of patients). Borrelia burgdorferi is susceptible to the action of tetracyclines, penicillins and third generation cephalosporins. A, B, C, E) These drugs are not effective against B. burgdorferi 32 ) A 36-year-old man is admitted to the hospital with high fever, chills, tachycardia, vomiting and muscle pain. He had the same symptoms 10 days ago, just after a staying in a campground near the border with Mexico. The feve r was high for 3 days, then cleared abruptly. A thick blood smear with Giemsa stain revealed many threadlike bacteria with large, irregular coils. Which of the following drugs would be most appropriate for this patient?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Streptomycin"},{"label":"B","text":"Vancomycin"},{"label":"C","text":"Doxycycline"},{"label":"D","text":"Daptomycin"},{"label":"E","text":"Fluconazole Nucleic Acid Syn Inhibitors"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-083763c816f9","stem":"The lab results indicate that spirochetes are the offending pathogens and the symptoms of the patient are consistent with the diagnosis of relapsing fever. The disease is caused by several Borrelia species and transmitted by lice or ticks. In the USA the disease is endemic in areas where there are ticks that arbor Borrelia (usually remote settings in the mountains and semiarid plains of the far west). The disease is characterized by recurrent febrile paroxysms lasting 3-5 days and separated by intervals o fapparent recovery. Borrelia are sensitive to tetracyclines, penicillins and third generation cephalosporins. Doxycycline is the drug of choice. A, B, D) These drugs are not effective against spirochetes.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antimicrobials","options":[{"label":"E","text":"This drug is an antifungal and is not effective against spirochetes. Nucleic Acid Syn Inhibitors Explanations 33\\* SEQ CHAPTER \\\\1 ) Which of the following statements regarding sulfonamides are correct? (Check all that apply)"},{"label":"A","text":"They usually abruptly kill susceptible bacteria"},{"label":"B","text":"They are effective against Toxoplasma gondii"},{"label":"C","text":"They compete with para-aminobenzoic acid for the enzyme peptidyl transferase"},{"label":"D","text":"They are often given together with a dihydrofolate reductase inhibitor"},{"label":"E","text":"Most of them cannot cross the blood brain barrier even when meninges are inflamed"}],"priority":2,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-e60c56ce4e6e","stem":"D Antibacterial spectrum of sulfonamides includes also some protozoa, namely Toxoplasma gondii. Sulfonamides are used very rarely alone. Most often they are given with trimethopri m, a dihydrofolate reductase inhibitor, since a synergistic activity is obtained.","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Sulfonamides alone do not kill susceptible bacteria, they only stop bacterial growth."},{"label":"C","text":"Sulfonamides compete with para-aminobenzoic acid for the bacterial enzyme dihydropteroate synthetase, not peptidyl transferase."},{"label":"E","text":"Many sulfonamides cross very well the blood brain barrier even when meninges are not inflamed (concentrations in CSF are 10-80% of those in plasma)"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-04f87e616df9","stem":"Sulfonamides are competitive inhibitors of the bacterial enzyme dihydropteroate synthetase, responsible for the incorporation of PABA into dihydropteroic acid, the immediate precursor of folic acid. Since bacterial cells utilize PABA to synthesize folic acid, the synthesis of folic acid is inhibit e","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"D","text":"This in turn inhibits the synthesis of bacterial purines that are needed for the synthesis of nucleic acids. On the contrary mammalian cells use preformed folic acid that is present in the diet and therefore are not sensitive to the action of sulfonami des."},{"label":"A","text":"These enzymes are not inhibited by sulfonamides."}],"priority":2,"status":"review","flags":["mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag"],"cleaningOperations":[]},{"id":"q-ca2ee522022e","stem":"Oral nonabsorbable agents, used for enteric infections only. Their oral bioavailability is negligible Sulfonamides are excreted as such in the urine at a variable degree, but the urine concentration of many compounds is enough to have an antibacterial effect in urinary tract infections.","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"The half-life of sulfonamides is very variable. Some compounds have a very long half-life."},{"label":"C","text":"Concentrations in CSF of the oral absorbable sulfonamides are 10-80% of those in plasma, even when the meninges are not inflamed."},{"label":"E","text":"Oral absorbable sulfonamides cross very easily the place"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ed7bd1f8f6b1","stem":"D Quinolones inhibit DNA gyrase, the enzyme that catalyzes the relaxation of supercoiled DNA and topoisomerase IV, the enzyme that catalyzes the separation of replicated DNA during cell division. Fluoroquinolones have a broad antibacterial spectrum which al so includes Rickettsiae spp.","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Water, pH and Buffers","topicOriginal":"Water, pH and Buffers","subtopic":"Acid","suggestedTopic":null,"options":[{"label":"B","text":"Fluoroquinolones are usually bactericidal against susceptible microorganisms."},{"label":"C","text":"Cross resistance usually occurs between structurally similar antibiotics. Fluoroquinolone resistance is not crossed with sulfonamides."},{"label":"E","text":"Fluoroquinolones are not effective against Bacteroides."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Water, pH and Buffers","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-9fdc0a6fd3ec","stem":"Which of the following antibacterial drugs is effective against most gram-negative bacteria, including Pseudomonas aer uginosa, as well as against Salmonella, Shigella, and Rickettsiae?","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Piperacillin"},{"label":"B","text":"Cefotaxime"},{"label":"C","text":"Ciprofloxacin"},{"label":"D","text":"Erythromycin"},{"label":"E","text":"Vancomycin"}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"226a8349e5697d3ed9abeb747c1b5b522c0726ec"},{"id":"q-0b92f8e77a2b","stem":"Older fluoroquinolones (e.g., ciprofloxacin) are effective against many gram-negative bacteria including Pseudomonas. Newer drugs in this class (e.g., moxifloxacin) maintain activity against many gram-negative bacteria (except Pseudomonas) and are also effective against gram-positive organisms. Drugs in this class are the drugs of first choice for Salmonella and Shigella, and are alternatives to doxycycline for Rickettsia. A, B) Piperacillin and cefotaxime are effective against Pseudomonas aeruginosa but not against the others.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Antimicrobials · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antimicrobials","options":[{"label":"D","text":"Erythromycin is not effective against these organisms."},{"label":"E","text":"Vancomycin is effective only against gram-positive bacteria."}],"priority":2,"status":"review","flags":["topic_generic","mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag","topic_generic"],"cleaningOperations":[]},{"id":"q-e2aac84d6f8c","stem":"A 34-year-old woman with AIDS presents to the emergency room reporting 2 seizures in the past 24 hours. Ph ysical signs include fever, altered mental status and a visual field defect. A magnetic resonance imaging of the head reveals several ring-shaped lesions in the brainstem. A brain biopsy shows crescent-shaped trophozoites within macrophages. Which of the following drug combinations would be appropriate to cure the patient's infection? he finding of intracellular trophozoites in the brain strongly suggest the diagnosis of toxoplasma encephalitis that is today the most common opportunistic CNS infection in patients with AIDS.. Toxoplasma gondii is a small intracellular protozoan that can infect people worldwide. Asymptomatic infections are common in immunocompetent persons, but the disease can be life-threatening in newborns and in immunosuppressed patients. A combination of sulfadiazine and pyrimethamine represents the treatment of choic for toxoplasma infection. The best alternative therapy for patients intolerant to sulfonamides is clindamycin plus pyrimethamine. Other alternative therapies include trimethoprim-sulfamethoxazole, azithromycin and doxycycline.","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Gentamicin and piperacillin"},{"label":"B","text":"Sulfadiazine and pyrimethamine"},{"label":"C","text":"Vancomycin and ceftazidime"},{"label":"D","text":"Isoniazid and rifampin"},{"label":"E","text":"Streptomycin and tetracycline 41 )"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-11fd0c504fed","stem":"A 61-year-old woman developed watery diarrhea, nausea and vomiting and abdominal cramps after a dinner with her family at a fast-food restaurant. The next day several other family members developed the same symptoms. Her medical history is significant for a right hip p r osthesis. Stool aerobic cultures yielded lactose-negative, gram-negative rods which produced hydrogen disulfide. Which of the following drugs would be an appropriate treatment for this patient? s. In fact other enterobacteriaceae either are lactose positive (i.e. Escherichia, Enterobacter) or do not produce hydrogen disulfide (i.e. Shigella). Campylobacter is another lactose-negative, gram-negative bacillus which frequently causes enterocolitis","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Erythromycin"},{"label":"B","text":"Oxacillin"},{"label":"C","text":"Ciprofloxacin"},{"label":"D","text":"Ketoconazole"},{"label":"E","text":"Vancomycin"},{"label":"F","text":"Ribavirin 42 )"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-56d07ac16010","stem":"C Anaerobic bacteria reduce the nitroimidazole group in metronidazole by two pathways, during the conversion of pyruvate to Acetyl CoA or by the enzyme nitroreductase. The reduced metronidazole forms reactive intermediates which damage DNA, RNA, and prote ins.","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Water, pH and Buffers","topicOriginal":"Water, pH and Buffers","subtopic":"Acid","suggestedTopic":null,"options":[{"label":"B","text":"Beta-lactam antibiotics inhibit transpeptidase."},{"label":"D","text":"Daptomycin causes membrane depolarization."}],"priority":2,"status":"review","flags":["mcq_missing_options"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Water, pH and Buffers","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["mcq_missing_options","not_enough_options","prior_structural_review_flag"],"cleaningOperations":[]},{"id":"q-c376893a6c55","stem":"Daptomycin inhibits DNA and RNA synthesis in bacterial cells by","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Microorganisms and Infection","topicOriginal":"Microorganisms and Infection","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"depolarizing the cell membrane."},{"label":"B","text":"blocking dihydropteroate synthetase."},{"label":"C","text":"blocking dihyrofolate reductase."},{"label":"D","text":"inhibiting DNA gyrase."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Microorganisms and Infection","answerAuditStatus":"newly_reasoned_provisional","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"1b881246d6b4e29c0e94b4229d8afaf4937be2e7"},{"id":"q-f2cc325e5157","stem":"Daptomycin causes depolarization of the bacterial cell membrane inhibiting DNA, RNA, and protein synthesis. This drug causes a concentration-dependent bactericidal effect.","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Sulfonamides inhibit dihydropteroate synthetase."},{"label":"C","text":"Trimethoprim and pyrimethamine inhibit dihydrofolate reductase."},{"label":"D","text":"Fluoroquinolones inhibit DNA gyrase and topoisomerase IV. \\*504b030414000600080000002100828abc13fa0000001c020000130000005b436f6e74656e745f54797065735d2e786d6cac91cb6ac3301045f785fe83d0b6d8 72ba28a5d8cea249777d2cd20f18e4b12d6a8f843409c9df77ecb850ba082d74231062ce997b55ae8fe3a00e1893f354e9555e6885647de3a8abf4fbee29bbd7 2a3150038327acf409935ed7d757e5ee14302999a654e99e393c18936c8f23a4dc072479697d1c81e51a3b13c07e4087e6b628ee8cf5c4489cf1c4d075f92a0b 44d7a07a83c82f308ac7b0a0f0fbf90c2480980b58abc733615aa2d210c2e02cb04430076a7ee833dfb6ce62e3ed7e14693e8317d8cd0433bf5c60f53fea2fe7 065bd80facb647e9e25c7fc421fd2ddb526b2e9373fed4bb902e182e97b7b461e6bfad3f010000ffff0300504b030414000600080000002100a5d6a7e7c00000 00360100000b0000005f72656c732f2e72656c73848fcf6ac3300c87ef85bd83d17d51d2c31825762fa590432fa37d00e1287f68221bdb1bebdb4fc7060abb08 84a4eff7a93dfeae8bf9e194e720169aaa06c3e2433fcb68e1763dbf7f82c985a4a725085b787086a37bdbb55fbc50d1a33ccd311ba548b63095120f88d94fbc 52ae4264d1c910d24a45db3462247fa791715fd71f989e19e0364cd3f51652d73760ae8fa8c9ffb3c330cc9e4fc17faf2ce545046e37944c69e462a1a82fe353 bd90a865aad41ed0b5b8f9d6fd010000ffff0300504b0304140006000800000021006b799616830000008a0000001c0000007468656d652f7468656d652f7468 656d654d616e616765722e786d6c0ccc4d0ac3201040e17da17790d93763bb284562b2cbaebbf600439c1a41c7a0d29fdbd7e5e38337cedf14d59b4b0d592c9c 070d8a65cd2e88b7f07c2ca71ba8da481cc52c6ce1c715e6e97818c9b48d13df49c873517d23d59085adb5dd20d6b52bd521ef2cdd5eb9246a3d8b4757e8d3f7 29e245eb2b260a0238fd010000ffff0300504b03041400060008000000210096b5ade296060000501b0000160000007468656d652f7468656d652f7468656d65 312e786d6cec594f6fdb3614bf0fd87720746f6327761a07758ad8b19b2d4d1bc46e871e698996d850a240d2497d1bdae38001c3ba618715d86d87615b8116d8"}],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["long_option_manual_review","topic_generic"],"cleaningOperations":[]},{"id":"q-aed0bd3aa0ef","stem":") Which of the following is the primary cellular site of action of clarithromycin?","type":"Short Answer","subject":"Pharmacology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"80b6b535ff8490f57153972d72c92a2c109a69bd"},{"id":"q-c2bf6aa70aba","stem":") Which of the following microorganisms are sensitive to macrolides?","type":"Short Answer","subject":"Pharmacology","topic":"Antimicrobials · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Antimicrobials","options":[],"priority":2,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9a35bc22e2c4","stem":") Which of the following antibiotics binds to the 50S ribosomal subunit and inhibits the formation of the initiation complex?","type":"Short Answer","subject":"Pharmacology","topic":"Antimicrobials","topicOriginal":"Antimicrobials","subtopic":"Antibiotic","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pharmacology","displayTopic":"Antimicrobials","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"50897b94152432ac58441d1c7bc0b3642b78166b"},{"id":"q-9ed9e99f3424","stem":"mazepine, 21. Ganciclovir .........T...... use is limited to life or site threatening CMV infection in immunocompromised patients .........F...... is effective only against Influenza A .........F...... Nucleotide reverse transcriptase inhibitor .........T...... competes with guanosine triphosphate for incorporation into viral DNA .........T...... concomitant use of potential bone marrow depressant drugs should be avoided 22. Angiotensin converting enzyme inhibitor .........T......reduce preload .........F......is positive inotrope .........F......do not cause cough .........F......no effect on after load ............F...causes muscles fasiculation 23 Which of the following induces microsomal enzymes ......T.........Phenobarbitone ......T.........Ethanol ......T.........Diazepam .........F......Ketaconazole .........T......Nevirapine 24. Tolerance and physiological dependence occur for which of the following?","type":"Clinical Vignette","subject":"Human Anatomy","topic":"Upper Limb","topicOriginal":"Upper Limb","subtopic":"Arm","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":fal