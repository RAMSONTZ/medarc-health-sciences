Subject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-56a543e0e9f1","stem":".Leukocyte adhesion with transmigration involves all of the following EXCEPT","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"migration of leukocytes as a result of stasis of blood flow in the microvasculature."},{"label":"B","text":"interaction of integrins with immunoglobulin found on endothelial cells."},{"label":"C","text":"the selectins found only on endothelial cells."},{"label":"D","text":"ICAM-1 and VCAM-1 adhesive molecules on the endothelial cells."},{"label":"E","text":"neutrophils in the first 6-24 hours of acute inflammation."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"928c04d22837f6bc840d25dc5d14b1060a5d6692"},{"id":"q-ab68ad218933","stem":".The directional movement of a cell or organism in response to a chemical gradient is best called","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"diapedesis."},{"label":"B","text":"emigration."},{"label":"C","text":"cytopempsis."},{"label":"D","text":"chemotaxis."},{"label":"E","text":"margination."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"aa64cd32ceeb536146e53e5f018882a8cadaa169"},{"id":"q-3cc02d60618e","stem":"The chemical mediator NOT responsible for chemotaxis is","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"cytokines."},{"label":"B","text":"C5a."},{"label":"C","text":"bradykinin."},{"label":"D","text":"bacterial products."},{"label":"E","text":"LTB4."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"c1760dce3c99b40e10e4136a8592e9bfaac0549a"},{"id":"q-0c7202007435","stem":".Histamine exerts its effect during inflammation by","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"vasoconstriction of post capillary sphincters."},{"label":"B","text":"constriction of large arteries."},{"label":"C","text":"acting on H2 receptors on mast cells."},{"label":"D","text":"causing venular endothelial contraction."},{"label":"E","text":"its direct effect on macrophages."}],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"Gener