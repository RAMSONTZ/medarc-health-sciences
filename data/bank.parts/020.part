he scapular line"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-ece4a8e96a23","stem":"Which of the following is NOT a vertebral problem?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"sacralization of L5"},{"label":"B","text":"lumbarization of S1"},{"label":"C","text":"lumbarization of T12"},{"label":"D","text":"lumbar spinal stenosis"},{"label":"E","text":"hemisacralization of L5"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-353631694400","stem":"Which of the following statements is true?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"In spina bifida cystica, the laminae of L5 and possibly S1 do not fuse properly."},{"label":"B","text":"In spina bifida occulta, one or more vertebral arches do not develop, allowing meninges and even the spinal cord to herniate."},{"label":"C","text":"Paralysis of the limbs and problems with bladder/bowel control may be associated with meningomyelocele."},{"label":"D","text":"Some cases of spina bifida result from an improper closure of the neural tube during the 8th week of embryonic development."},{"label":"E","text":"A meningocele is a spina bifida associated with brain herniation."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"248a6c54f8445b675f896816d3de20b31c35fe86"},{"id":"q-9ba45f445ddb","stem":"Shortly after week four of development, dorsal primary rami begin to innervate which of the following?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"ventral axial skeletal musculature"},{"label":"B","text":"vertebral joints"},{"label":"C","text":"skin of the upper limb"},{"label":"D","text":"sweat glands of the lateral back region"},{"label":"E","text":"erector pili muscles"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-a56f9a40e590","stem":"Which of the following is NOT true?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Variations in vertebrae are affected by race, sex, genetic factors, and environmental factors."},{"label":"B","text":"An increased number of vertebrae occurs more often in males, and a reduced number occurs more often in females."},{"label":"C","text":"The number of cervical vertebrae can be 6, 7, or 8."},{"label":"D","text":"Some people have more than five lumbar vertebrae and therefore fewer thoracic vertebrae."},{"label":"E","text":"The sacrum is typically composed of five fused vertebrae."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"6bf59dd369bced723f8e7d95ea92533316a7bad6"},{"id":"q-2ccee3f3b28d","stem":"Which of the following does NOT give rise to arteries supplying the spinal cord?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"ascending cervical artery"},{"label":"B","text":"deep cervical artery"},{"label":"C","text":"intercostal arteries"},{"label":"D","text":"lumbar arteries"},{"label":"E","text":"thoracoacromial artery"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-65cb7eb17507","stem":"ALL of the following extend the atlanto-occipital joint EXCEPT","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"rectus capitis posterior major and minor"},{"label":"B","text":"semispinalis capitis"},{"label":"C","text":"longus capitis"},{"label":"D","text":"splenius capitis"},{"label":"E","text":"longissimus capitis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6a21ec3922b8","stem":"Which of the following is NOT included in the condyle of the humerus?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"radial, coronoid, and olecranon fossae"},{"label":"B","text":"epicondyles"},{"label":"C","text":"trochlea"},{"label":"D","text":"capitulum"},{"label":"E","text":"greater tubercle"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-bf5a0a03791e","stem":"The numbered anatomical features indicated on the art below are","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"91. Lateral cord, 92. musculocutaneous nerve, 89. medial antebrachial cutaneous nerve"},{"label":"B","text":"92. ulnar nerve, 93. lateral pectoral nerve, 89. Lateral cord"},{"label":"C","text":"89. Lateral cord, 90. musculocutaneous nerve, 91. medial antebrachial cutaneous nerve"},{"label":"D","text":"89. Lateral cord, 90. musculocutaneous nerve, 91. lateral pectoral nerve"},{"label":"E","text":"92. musculocutaneous nerve, 91. medial antebrachial cutaneous nerve, 92. ulnar nerve,"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9f8454324bf7","stem":"All of the following are medial rotators of the arm EXCEPT","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"latissimus dorsi"},{"label":"B","text":"teres major"},{"label":"C","text":"subscapularis"},{"label":"D","text":"infraspinatus"},{"label":"E","text":"anterior part of deltoid"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-06a16d061808","stem":"The radial nerve does NOT do which of the following?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"give a superficial branch that innervates the dorsum of the hand"},{"label":"B","text":"innervate the brachioradialis and extensor carpi radialis longus"},{"label":"C","text":"give a deep branch that innervates the extensor carpi radialis brevis and supinator"},{"label":"D","text":"give a posterior interosseous branch that innervates all remaining extensor muscles in the posterior compartment of the forearm"},{"label":"E","text":"innervate the glenohumeral joint"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b33a2a74a61b","stem":"Which of the following is NOT true in respect to the flexor pollicis brevis?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It is located medial to the abductor pollicis brevis."},{"label":"B","text":"It flexes the thumb at the carpometacarpal joint."},{"label":"C","text":"It flexes the thumb at the metacarpophalangeal joint."},{"label":"D","text":"Its tendon typically contains a sesamoid bone."},{"label":"E","text":"It is innervated by C5–C6."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-decac859243e","stem":"The scapula on one side of a patient is located farther from the midline than that on the normal side. What might be the problem?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"paralysis of the rhomboids on one side"},{"label":"B","text":"injury to the long thoracic nerve"},{"label":"C","text":"a lesion of C7–C8"},{"label":"D","text":"dislocated shoulder"},{"label":"E","text":"separated shoulder"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-46b354ab71f4","stem":"A patient tries to make a fist, but digits 2 and 3 remain partially extended. What nerve is injured?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"ulnar nerve"},{"label":"B","text":"radial nerve"},{"label":"C","text":"median nerve"},{"label":"D","text":"musculocutaneous nerve"},{"label":"E","text":"axillary nerve"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4a4665039b21","stem":"Which limb defect is correctly matched with its definition?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"meromelia . . . complete absence of one or more extremities"},{"label":"B","text":"phocomelia . . . all segments of extremities are present but abnormally short"},{"label":"C","text":"micromelia . . . partial absence of one or more extremities"},{"label":"D","text":"amelia . . . long bones are absent, and small hands or feet are attached to the trunk by short, irregular bones"},{"label":"E","text":"cleft hand (lobster claw deformity) absent third metacarpal, fusion of digits 1–2 and 4–5"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"209cf10828543eba8b24efc8dd1d7fa4045b55ab"},{"id":"q-fd259c278b65","stem":"Syndactylyl involves","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Extra fingers or toes."},{"label":"B","text":"Absence of a digit or limb."},{"label":"C","text":"Abnormal fusion of fingers and toes."},{"label":"D","text":"Small hands or feet being attached to trunk by short bones instead of long bones."},{"label":"E","text":"Congenital dislocation of glenohumeral joint."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-21b478f2679b","stem":"Which of the following correctly describes the development of the lungs, in order?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"pseudoglandular period, canalicular period, terminal sac period, alveolar period"},{"label":"B","text":"canalicular period, pseudoglandular period, terminal sac period, alveolar period"},{"label":"C","text":"alveolar period, pseudoglandular period, canalicular period, terminal sac period"},{"label":"D","text":"pseudoglandular period, terminal sac period, alveolar period, canalicular period"},{"label":"E","text":"terminal sac period, alveolar period, pseudoglandular period, canalicular period"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-c50a9c1c06a5","stem":"The fibers of the greater splanchnic nerve synapse in which ganglion?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"celiac ganglion"},{"label":"B","text":"inferior mesenteric ganglion"},{"label":"C","text":"paravertebral ganglia"},{"label":"D","text":"pulmonary plexus"},{"label":"E","text":"adrenal cortex"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-961e868b5ec4","stem":"Which of the following is NOT a result of sympathetic stimulation in the lungs?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"inhibition of parasympathetic system"},{"label":"B","text":"bronchodilation"},{"label":"C","text":"reduced secretion"},{"label":"D","text":"maximum air exchange"},{"label":"E","text":"surfactant production"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-84da4bdfe4a0","stem":"Which of the following is a result of sympathetic stimulation in the heart?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"decrease in the rate and strength of contraction"},{"label":"B","text":"inhibition of the effect of parasympathetic system on coronary arteries, allowing them to dilate"},{"label":"C","text":"production of atrial natriuretic factor"},{"label":"D","text":"opening and closing of mitral valve"},{"label":"E","text":"glandular secretion"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","so