"text":"Marjolin ulcer"},{"label":"C","text":"Curling’s ulcer"},{"label":"D","text":"Tropical ulcer"},{"label":"E","text":"None of the above"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Trauma and Emergency Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2e39acba4ed6","stem":"The following are correct about burn wound except","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Trauma and Emergency Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Trauma and Emergency Surgery","options":[{"label":"A","text":"Partial thickness burns heals by reepithilialization"},{"label":"B","text":"Second degree burns heals with minimal scarring and are painless"},{"label":"C","text":"First degree burn involve only the epidermis and is characterized by erytheme"},{"label":"D","text":"Superficial burns are often characterized by blister formation"},{"label":"E","text":"None of the above"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Trauma and Emergency Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0b732917dfa2","stem":"The following are major burn injuries except","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Trauma and Emergency Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Trauma and Emergency Surgery","options":[{"label":"A","text":"Second degree burn of > 25% BSA in adults"},{"label":"B","text":"Second degree burn of > 25% BSA 