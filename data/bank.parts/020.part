ft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Upper Limb · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-35cec8472358","stem":"Inability to extend the leg at the knee joint wound indicate paralysis of the: indicate the most correct option.","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Lower Limb","topicOriginal":"Lower Limb","subtopic":"Leg","suggestedTopic":null,"options":[{"label":"A","text":"Semitendinosus and semimembranosus"},{"label":"B","text":"Sartorius muscle"},{"label":"C","text":"Gracilis muscle"},{"label":"D","text":"Quadriceps femoris muscle"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Lower Limb","answerAuditStatus":"independent_no_source_key_bulk_v4","sourceAnswerTrusted":false,"publicationStatus":"provisional_answer","auditFlags":[],"cleaningOperations":[]},{"id":"q-b8af7465d520","stem":"Which of the following muscles does not contribute to the stability of the knee joint? indicate the most correct option.","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Lower Limb","topicOriginal":"Lower Limb","subtopic":"Knee","suggestedTopic":null,"options":[{"label":"A","text":"Soleus"},{"label":"B","text":"Semimembranosus"},{"label":"C","text":"Sartorius"},{"label":"D","text":"Biceps femoris"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Lower Limb","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7f0f1302bb95","stem":"The ligament of the hip joint that transmits medial epiphyseal vessels to the head of femur is the: indicate the most correct option.","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Head","suggestedTopic":null,"options":[{"label":"A","text":"Transverse acetabular ligament"},{"label":"B","text":"Pubofemoral"},{"label":"C","text":"Ischiofemoral ligament"},{"label":"D","text":"Ligamentum teres"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d891fc8d8776","stem":"The neuro-muscular-physiologic function of the locomotor body system is about: indicate the most incorrect option.","type":"Single Best Answer MCQ","subject":"Human Physiology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Nerves excite muscles and muscles move joints"},{"label":"B","text":"Bones and joints are arranged according to lever systems"},{"label":"C","text":"All serve to keep the body in the upright position, walk and do things"},{"label":"D","text":"If one is not functioning well the others will do well to maintain function ."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Physiology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-eda1ec48453d","stem":"These are the characteristics of synovial joints: indicate the most incorrect option.","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"United by an articular fibrous capsule"},{"label":"B","text":"The fibrous capsule is lined by a synovial membrane"},{"label":"C","text":"Have a joint cavity which contains synovial fluid, fat and blood"},{"label":"D","text":"The bone ends are covered by articular cartilage 8 These statements apply to fibrous joints: indicate the most incorrect option."},{"label":"A","text":"Are united by fibrous tissue"},{"label":"B","text":"Have free movements"},{"label":"C","text":"Examples include the sutures of the skull, tibial-fibular syndesmosis, interosseous membranes of the ulna-radius, fibula- tibia"},{"label":"D","text":"Also exemplified by a gomphosis (dental socket)"}],"priority":0,"status":"review","flags":["topic_generic","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","too_many_options","topic_generic"],"cleaningOperations":[]},{"id":"q-d0a11a89467a","stem":"Ball and socket joints are: indicate the most incorrect option.","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Multi-axial joints, move in multiple axes and planes"},{"label":"B","text":"Articulating surfaces consist of a ball and socket, and hinges"},{"label":"C","text":"Are highly movable"},{"label":"D","text":"Abduction, adduction, flexion, extension, rotation, circumduction movements are all possible"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answ