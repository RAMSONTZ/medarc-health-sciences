:["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"02b562dd366768db4386dd15c5365cea073b7488"},{"id":"q-a3d89df53e8d","stem":"Elastase, an endopeptidase, cuts peptide bonds next to which amino acids?","type":"Short Answer","subject":"Medical Biochemistry","topic":"Water, pH and Buffers","topicOriginal":"Water, pH and Buffers","subtopic":"Acid","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Water, pH and Buffers","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"b7ff4b4e1cf1966e8b01df9399721c1f3649969e"},{"id":"q-7cb57b4f7d02","stem":"Which of the following glucose transporters is Na+-dependent?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":2,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"3f01b0f0adef2947d6263e9d7963140c34aa096d"},{"id":"q-93ab9687856b","stem":"03xPCO2 Acidosis occurs when the ratio of HCO3 −to CO2 decreases Metabolic acidosis: fall of HCO3 − Respiratory acidosis: increase in CO2 CO2 volatile acid Question 20 What brain center has neurons that fire mainly during inspiration and have input to the spinal motor neurons that activate the diaphragm and inspiratory intercostal muscles? ventilation under normal circumstances? high altitude?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Neuroanatomy","topicOriginal":"Neuroanatomy","subtopic":"Brain","suggestedTopic":null,"options":[{"label":"A","text":"the ventral respiratory group of the medulla oblongata"},{"label":"B","text":"the dorsal respiratory group of the medulla oblongata"},{"label":"C","text":"the pneumotaxic center of the pons"},{"label":"D","text":"the apneustic center of the pons Question 21 What is the primary regulator of the magnitude of alveolar"},{"label":"A","text":"the H+ concentration in the brain extracellular fluid, which is monitored by central chemoreceptors"},{"label":"B","text":"The PO2 of the arterial blood, which is monitored by central chemoreceptors"},{"label":"C","text":"The PO2 of the arterial blood, which is monitored by peripheral chemoreceptors"},{"label":"D","text":"stretch receptors in the lung Question 22 Which correctly describes the cause of the increase in alveolar ventilation that occurs when a person ascends to"},{"label":"A","text":"The decrease in PCO2 of inspired air decreases alveolar PCO2, stimulating the peripheral chemoreceptors."},{"label":"B","text":"The decrease in PCO2 of inspired air decreases alveolar PCO2, stimulating the central chemoreceptors."},{"label":"C","text":"The decrease in PO2 of inspired air decreases alveolar and arterial PO2, stimulating the peripheral chemoreceptors."},{"label":"D","text":"The decrease in total atmospheric pressure causes a greater negative pressure in the intrapleural space, resulting in deeper and more frequent breathing. Question"}],"priority":0,"status":"review","flags":["too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Neuroanatomy","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","too_many_options","too_many_options_possible_merge"],"cleaningOperations":["option_whitespace_normalization","whitespace/page_marker_normalization"]},{"id":"q-72f08eb47aa6","stem":"What is the primary regulator of the magnitude of alveolar","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-714f46d773e6","stem":"Which of the following bones are carpal bones?","type":"Short Answer","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-edfffcedd04c","stem":"The following statements are true EXCEPT: (a) The elbow joint is an articulation principally between the humerus and the ulna. (b) The wrist joint is an articulation principally between the radius and carpus bone. (c) The metacarpophalangeal joints do not permit rotation. (d) The inferior radioulnar joint consists of the articulation between the heads of the radius and ulna. (e) The interphalangeal joints permit only flexion and extension Section B: Matching Item Questions/ Filling blanks Answer all questions.","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Head","suggestedTopic":null,"options":[{"label":"A","text":"Match the following from column A to column B by writing the correct number from column B in the answer book provided. Each correct respond carries 1 mark Column A Column B"},{"label":"A","text":"______Peromelia (1) the hand or part of it directly adjoin the shoulder"},{"label":"B","text":"______Amelia (2) Part of a tubular bone is missing while the hand is intact"},{"label":"C","text":"______ Phocomelia (3) congenital presence of extra finger"},{"label":"D","text":"______ scaphoid (4) a condition characterized by the fusion of two fingers"},{"label":"E","text":"______ Madelung’s (5) parts of the arm are missing"},{"label":"F","text":"______ Ectromelia (6) most lateral bone of the proximal row"},{"label":"G","text":"______ Polydactylism (7) a deformity at the wrist"},{"label":"H","text":"______ Sprengel’s shoulder (8) The complete arm is missing i) ______ Syndactylism (9) congenital elevation of the scapula j) ______ Trapezium, Trapezoid (10) bones of the proximal row of carpal bones (11) bones of the distal row of carpal bones"},{"label":"B","text":"Filling blanks Fill the missing words in the answer book provided. This part has a total of 25 marks"}],"priority":0,"status":"review","flags":["too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","too_many_options","too_many_options_possible_merge"],"cleaningOperations":[]},{"id":"