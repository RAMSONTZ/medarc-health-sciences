hort Answer","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e64a8f6a4ad9","stem":"28 Which statement considering the relations of nerves to the humerus is the most accurate?","type":"Short Answer","subject":"Human Anatomy","topic":"Upper Limb · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Upper Limb","options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Upper Limb · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":[],"duplicateStemGroup":"b1f3f8db345b5c0f761e4650bb4e5cab81a28233"},{"id":"q-13267f5f8a6f","stem":"29 Consider the dermatomes of the upper limb. Which of the following statements best completes this sentence?","type":"Short Answer","subject":"Human Anatomy","topic":"Upper Limb","topicOriginal":"Upper Limb","subtopic":"Upper Limb","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Upper Limb","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b4e0afa29049","stem":"30 Which of the following statements ends this sentence correctly?","type":"Short Answer","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":true,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-08a90020a699","stem":"30 a The biceps jerk principally tests the C5 reflex arc, with a contribution from C6. Explanations","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Thoracic Wall and Mediastinum · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Thoracic Wall and Mediastinum","options":[{"label":"B","text":"The supinator jerk corresponds primarily to the C6 reflex arc, with a contribution from C5."},{"label":"C","text":"The triceps jerk is principally mediated by C7, with a con- tribution from C8."},{"label":"D","text":"This reflex may be of occasional use, and is elicited by placing the examiner’s index finger across the tip of the shoulder on the deltoid muscle belly, and tapping the fin- ger. It solely tests the reflex arc of spinal cord segment C5."},{"label":"E","text":"The pectoral reflex is elicited by placing the examiner’s index and middle fingers on the lateral border of pectoralis major and tapping them with a tendon hammer. It tests the reflex arc of C7. 2 Lower Limb QUESTIONS"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Thoracic Wall and Mediastinum · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"f0f4b6ea2450bc4d