my","displayTopic":"Upper Limb","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-2635ff5ad6b8","stem":"The equation V = Vmax [S] / Km is part of which the following plot?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Lineweaver-Burk"},{"label":"B","text":"Michaelis-Menten"},{"label":"C","text":"Both a) and b)"},{"label":"D","text":"None of the above"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-cd6093a9d89e","stem":"Which of the following statements about enzyme kinetics is false?","type":"Single Best Answer MCQ","subject":"Medical Biochemistry","topic":"Proteins and Enzymes","topicOriginal":"Proteins and Enzymes","subtopic":"Enzyme","suggestedTopic":null,"options":[{"label":"A","text":"A reaction may not occur at a detectable rate even though it has a favorable equilibrium."},{"label":"B","text":"After a reaction, the enzyme involved becomes available to catalyze the reaction again."},{"label":"C","text":"Lowering the temperature of a reaction will lower the reaction rate."},{"label":"D","text":"Substrate binds to an enzyme’s active site."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Biochemistry","displayTopic":"Proteins and Enzymes","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationSt