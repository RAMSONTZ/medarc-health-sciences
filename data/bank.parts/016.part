":"E","text":"Ischemic cardiomyopathy"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2baac6e251a8","stem":"An ultrastructural examination of a salivary gland revealed within cells pieces of the nuclei surrounded by a membrane. Also condensate fragments of nuclear material and separate organelles were found. An inflammatory reaction around these cells was missing. Which term most correctly defines these alteration? А. *Apoptosis","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Karyorrhexis"},{"label":"C","text":"Coagulation necrosis"},{"label":"D","text":"Karyopyknosis"},{"label":"E","text":"Karyolysis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4e11944a99a3","stem":"A patient with tuberculosis has a kidney biopsy performed. Histological inves- tigation revealed the caseous necrosis of the tissue accompanied by disorderly ar- 24 ranged fine grains of a chromatin. Which term most correctly defines describe le- sion? А. * Karyorrhexis","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Karyolysis"},{"label":"C","text":"Karyopyknosis"},{"label":"D","text":"Mitotic activity of nuclei"},{"label":"E","text":"Apoptosis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-8b2c2af772cd","stem":"A postmortem of a 48-year-old male who had a history of typhoid fever re- vealed that the rectus abdominis at the wall was dense, a whitish colour, and re- sembled a candle. Which is the most likely diagnosis? А. * Waxy necrosis","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Fibrinoid necrosis"},{"label":"C","text":"Colliquative necrosis"},{"label":"D","text":"Caseous necrosis"},{"label":"E","text":"Apoptosis"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-5ed87a200bca","stem":"A 44 year old ill patient died due to the severe chronic heart failure. Pathologist diagnosed rheumatic granulomatous myocarditis. Microscopic evaluation of the myocardium indicated the presence of granulomas which consisted of macrophages with hyperchromatic nuclei and clear cytoplasm. Also necrosis was seen in the cen- ter of a lesion. Which is the most likely type of necrosis in the center of the lesion? А. * Fibrinoid necrosis.","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Waxy necrosis."},{"label":"C","text":"Caseous necrosis."},{"label":"D","text":"Colliquative necrosis."},{"label":"E","text":"Fatty dystrophy."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-19105324d3ed","stem":"A 57-year-old patient has a long history of the type II diabetes mellitus. Physi- cal examination revealed the alteration of the right foot tissues. They are dense, black with precise boundaries from normal tissues. Which term most correctly de- scribe the lesion? А. *Dry gangrene.","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"Diabet","suggestedTopic":null,"options":[{"label":"B","text":"Wet (moist) gangrene."},{"label":"C","text":"Gas gangrene."},{"label":"D","text":"Decubitus."},{"label":"E","text":"Trophic ulcer."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Endocrinology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-698ab07873f9","stem":"A postmortem examination of a dead body revealed a cloudy corneas, dry skin with yellowish - brown lesion. Which term most correctly identifies describes a post-mortem alterations? А. *Cadaver desiccation","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Clotting of blood"},{"label":"C","text":"Livor mortis"},{"label":"D","text":"Rigor mortis"},{"label":"E","text":"Algor mortis 25"}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-8a00d8363293","stem":"The postmortem of a 48-year-old male reveals in the right temporal lobe of the brain a large grey lesion with a softening, porridge-like texture. The basal arteries of the brain had numerous white - yellow thickenings of an intima which signifi- cantly decreased lumen. Which is the most likely diagnosis? А. *Ischemic infarct","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Abscess of a brain"},{"label":"C","text":"Hematoma"},{"label":"D","text":"Hemorrhagic infarct"},{"label":"E","text":"Edema of the brain"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-fffcbab1791a","stem":"At post-mortem, a 60-years-old man, with a history of typhoid fever, is found to have rectus muscles of the anterior abdominal wall dense, whitish, and look like a stearic candle. What is the most likely diagnose?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Zenker's necrosis."},{"label":"B","text":"Fibrinoid necrosis."},{"label":"C","text":"Colliquative necrosis."},{"label":"D","text":"Caseous necrosis."},{"label":"E","text":"Apoptosis."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3693de5a3495","stem":"A 65-year-old female, with a long history of diabetes mellitus, presented her black, edematous and painful thumb of the right foot. Gross inspection revealed a focal epidermal detachment and malodorous discharge. What is the most likely clinicopathologic form of necrosis?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Moist (wet) gangrene."},{"label":"B","text":"Decubitus ulcer."},{"label":"C","text":"Sequester."},{"label":"D","text":"Dry gangrene."},{"label":"E","text":"Infarction."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-4467cbfe1432","stem":"A 5-year-old boy with measles presents to his pediatrician with necrotic changes of his cheeks. Gross inspection revealed that the cheeks soft tissues were edematous with reddish black fluctuated indistinctly outlined foci. What is the most likely complication of a measles?","type":"Single Best Answer MCQ","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Moist gangrene."},{"label":"B","text":"Dry gangrene. C Gas gangrene."},{"label":"D","text":"Decubitus ulcer."},{"label":"E","text":"Trophic ulcer."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f27a89cf66ec","stem":"A physical examination of 67-year old lady, with a history of femoral bone frac- ture, revealed a sequester formation accompanied with chronic inflammation of a bone marrow and adjacent tissues. What is the most likely disease caused such le- sions?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"*Osteomyelitis."},{"label":"B","text":"Reticulosarcoma."},{"label":"C","text":"Multiple myeloma."},{"label":"D","text":"Osteoclastoma. 26"},{"label":"E","text":"Periostitis."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-2f0a8d7ee718","stem":"An elderly woman with a history of a stroke one year ago complains of a left limbs immobility. A computer tomography examination revealed a cavity filled with liquor, at right hemisphere of her brain. What is the most likely diagnose?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Postinfarction cyst."},{"label":"B","text":"Hydrocephaly."},{"label":"C","text":"Grey encephalomalacia."},{"label":"D","text":"Cerebral infarction."},{"label":"E","text":"Hematoma."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-271b813c7cf8","stem":"A section of the left lung was found to have an area of dense red tissue. The area was cone-shaped, stood out distinctly from the healthy tissue, with its base directed to the pleura. The dissected tissue was granular, dark-red. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Haemorrhagic infarction"},{"label":"B","text":"Lung gangrene"},{"label":"C","text":"Lung abscess"},{"label":"D","text":"Croupous pneumonia"},{"label":"E","text":"Primary tuberculous affection"}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-4c5eabd4ea1a","stem":"An autopsy of a dead patient with typhoid fever revealed firm, fragile, whitish- yellow, and waxy muscles of the anterior abdominal wall and thighs. What is the most likely pathology of muscles?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Lower Limb","topicOriginal":"Lower Limb","subtopic":"Thigh","suggestedTopic":null,"options":[{"label":"A","text":"*Zenker necrosis."},{"label":"B","text":"Fibrinoid necrosis."},{"label":"C","text":"Caseous necrosis."},{"label":"D","text":"Colliquative necrosis."},{"label":"E","text":"Apoptosis."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Lower Limb","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b5b73c9ae834","stem":"A 55-year-old patient with 12 years history of hypertensive disease presented to a hospital with disturbances of cerebral blood circulation resulted in right-side hemiplegia. He died shortly after arrival. A postmortem revealed systemic hyali- nosis of small blood vessels and thrombosis of medial cerebral artery. There was also a focus of a structureless grayish tissue in the temporal lode of left hemis- phere. The focus was interpreted as","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Ischemic infarction"},{"label":"B","text":"Hemorrhage"},{"label":"C","text":"Abscess"},{"label":"D","text":"Hemorrhagic infarction"},{"label":"E","text":"Edema"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d9f72f00da26","stem":"A 59-year-old patient with transmural myocardial infarction died of cardiac tamponade due to ruptured myocardial infarct. Which process resulted in a heart‘s wall rupture?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Autolytic process leading to myocardial softening (myomalacia)"},{"label":"B","text":"Replacement of infracted areas by connective tissue (organization)"},{"label":"C","text":"Increasing of blood pressure in pulmonary circulation 27"},{"label":"D","text":"Myocarditis"},{"label":"E","text":"Chronic aneurism"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-88843ca62c5a","stem":"A 58-years-old smoker with a 5-year history of angina pectoris died during the heart attack. An autopsy revealed atherosclerosis of the coronary arteries with thrombosis, uneven color of anterior wall of the left ventricle and flabbiness of the myocardium. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Myocardial infarction"},{"label":"B","text":"Angina pectoris"},{"label":"C","text":"Myocarditis"},{"label":"D","text":"Postinfarction cardiosclerosis"},{"label":"E","text":"Myocardial aneurysm"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8e129c72ab24","stem":"A 74-year-old patient with a history of hypertensive syndrome developed col- lapse and died of increased disturbances of respiration and heart activity. An autop- sy revealed a dark-red 2x1x5 cm bloody focus in the trunk of the brain. Vessels of the brain base were considerably thickened, whitish-yellow, with narrowed lumen. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Hemorrhagic infarct"},{"label":"B","text":"Cyst of the brain"},{"label":"C","text":"Gumma of brain"},{"label":"D","text":"Ischemic infarct"},{"label":"E","text":"Meningioma Blood and lymph circulation disorders."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9417e5a43102","stem":"The postmortem of a 48-year-old male, with a long history of a chronic heart failure, revealed an enlarged liver. Grossly, a liver had a motley pattern. Macros- copically, the sectional view looked like a nutmeg on incision. Which term most correctly defines these alteration? А. * General venous plethora","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"General arterial plethora"},{"label":"C","text":"Anemia"},{"label":"D","text":"Hemorrhage"},{"label":"E","text":"Bleeding"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6485c4febec0","stem":"A post-mortem of a 43-year-old female revealed multiple, hemorrhagic infarcts in lungs. Some lungs‘ vessels had reddish-brown dense masses within lumens, which were not attached to the vessel walls. Varicose phlebectasia of the legs with thromboses of some veins were also determined. Which pathological process oc- curred in this case? А. * Thromboembolism of pulmonary artery.","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"B","text":"Fat embolism of pulmonary artery."},{"label":"C","text":"Tissue embolism of pulmonary artery."},{"label":"D","text":"Foreign bodies embolism of pulmonary artery."},{"label":"E","text":"Gas embolism. 28"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-2de0d0f26955","stem":"A male patient died after a abdominal surgery. During the postmortem numerous thrombuses were found in the veins of the pelvis. Thromboembolic syndrome was diagnosed. Where it is necessary to search for thromboembolies? А. *Lungs artery","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"B","text":"Portal vein"},{"label":"C","text":"Left ventricle of heart"},{"label":"D","text":"Brain"},{"label":"E","text":"Veins of the lower extremity"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-5cc1641f5bf4","stem":"The histological investigation of a liver detects venous plethora of center lobules, dystrophy and atrophy of hepatocytes in the venous plethora‘s area, fatty a dystro- phy of hepatocytes on the periphery of a lobe. The replacement fibrosis in places of an atrophy of the hepatocytes was also revealed. Which pathological process does this refer to? А. * ̳Nutmeg‘ liver with precirrhotic phenomena.","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Biliary hepatic cirrhosis. C Fatty hepatosis."},{"label":"D","text":"Hepatitis."},{"label":"E","text":"Toxic dystrophy of a liver."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-743081e1e3e7","stem":"A 35-year-old patient complains of repeated vomiting, diarrhea, decreased arteri- al pressure and tachycardia. He supposes this condition related to the food poison- ing. Laboratory tests detected Salmonella‘s infection. Hematological examination revealed an increased number of erythrocytes per unit volume. Which circulatory disturbance took place to create this pathology? А. *Clotting of a blood.","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Hemolysis of erythrocytes and compensatory induction of a hemogenesis"},{"label":"C","text":"General arterial plethora"},{"label":"D","text":"Polycythemia"},{"label":"E","text":"Hyperchromatic anemia"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-4ceda9c31c11","stem":"A male with a history of myocardial infarct died of cardiovascular failure. A post-mortem revealed a replacement fibrosis, hypertrophy of the myocardium and dilatation of the cavities, especially the right ventricle. The liver was enlarged. Its surface was smooth. Grossly, a motley pattern with dark red dots on the grey a background was revealed. Histologically, central zones of the lobules were hyper- emic. On the periphery, around of periportal tracts hepatocytes demonstrated fatty dystrophy. Name these liver changes. А. *‖Nutmeg‖ liver (chronic venous plethora)","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Pseudo ̳nut-meg‘ liver"},{"label":"C","text":"Amyloidosis"},{"label":"D","text":"Cirrhosis of a liver"},{"label":"E","text":"Steatosis of a liver"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-42a4d6b98c01","stem":"A male patient involved in the traffic accident received a wound in the neck due to broken glass. The bleeding was small, but a short time after the accident he died 29 of acute dyspnea. A post-mortem of the heart revealed bubbles excretion when pe- ricardium filled with water. Indicate which pathological process took place: А. *Air embolism","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Gas embolism"},{"label":"C","text":"Fat embolism"},{"label":"D","text":"Thromboembolism"},{"label":"E","text":"Foreign bodies embolism"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-5f6e0f1fedfc","stem":"A 52-year-old male with long history of rheumatic heart disease died of chronic heart failure. A post-mortem revealed brown colour, enlarged dense lungs. Name the changes in lungs. А. *Brown induration of lungs","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Acute bronchitis"},{"label":"C","text":"Horny-comb lungs"},{"label":"D","text":"Chronic bronchitis"},{"label":"E","text":"Chronic emphysema"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-56a3ba41c6c4","stem":"A patient, who had fast elimination of 10 liters of an ascitic liquid from abdo- men, suddenly lost his consciousness. What was the cause of this phenomenon? А. *Anemia of the brain","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Thrombosis of the cerebral arteries"},{"label":"C","text":"Brain hemorrhage"},{"label":"D","text":"Arterial hyperemia"},{"label":"E","text":"Thrombosis of the cerebral veins"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-1cce28ebbe96","stem":"A young male with a history of rheumatic heart disease since childhood, grad- ually develops mitral stenosis, accompanied with episodes of heart failure. He presents to a hospital complaining of coughing with a reddish-brown sputum. Name probable changes at patient‘s lungs. А. *Brown induration of lungs","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Emphysema of lungs"},{"label":"C","text":"Atelectasis of lungs"},{"label":"D","text":"Pneumosclerosis"},{"label":"E","text":"Bronchiectasis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-511a3b9e795b","stem":"At autopsy an elderly female is found to have a blood clot in the femoral artery, which grossly had a striped pattern. Microscopy revealed a congestions of fibrin fibers and broken down red and white cells. Which is the most likely type of thrombus ? А. *Mixed thrombus","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Lower Limb","topicOriginal":"Lower Limb","subtopic":"Femoral","suggestedTopic":null,"options":[{"label":"B","text":"Postmortem convolutions of a blood"},{"label":"C","text":"Thromboemboli"},{"label":"D","text":"Hyaline thrombus"},{"label":"E","text":"Red thrombus"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Lower Limb","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-c7bcb41a9ac0","stem":"A patient has a purulent otitis and thrombosis of a sigmoid sinus of a dura ma- ter. Name the complication if thrombus breaks down and fragments circulate to distal vessels. 30 А. *Thromboembolism of branches of pulmonary artery","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Histology and Tissues","topicOriginal":"Histology and Tissues","subtopic":"Artery","suggestedTopic":null,"options":[{"label":"B","text":"Thromboembolism of vessels of a brain with development of a grey softening of the brain"},{"label":"C","text":"Thromboembolism of vessels of a retina of an eye and development of blindness"},{"label":"D","text":"Thromboembolism of coronary arteries"},{"label":"E","text":"Local anemia"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Histology and Tissues","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-b7ea2706a4f7","stem":"A 43-year-old male, with a history of traffic accident and poly trauma, includ- ing multiple bone fractures, presented to the hospital. On the second day after the trauma, he complained of a pain in the right half of the chest, heavy breathing. At night, he died due to progressive heart and respiratory failure. Microscopic investigation revealed Sudan-positive orange drops in pulmonary and cerebral ves- sels that completely occlude the lumens of microcirculatory vessels. What is the most likely complication led to a patient‘s death?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Fat embolism."},{"label":"B","text":"Gaseous embolism."},{"label":"C","text":"Medicamentous embolism."},{"label":"D","text":"Microbial embolism."},{"label":"E","text":"Thromboembolism."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1f222ad33b56","stem":"A 62-year-old patient had a surgery due to acute appendicitis. She had been placed in a bed for 5 days. After she decided to get out of bed she experienced a shortage of air, her face became cyanotic and she lost her consciousness. After un- successful resuscitation the patient died. A post-mortem revealed a thromboembol- ism of the pulmonary artery. Which of the following is most likely source of thromboembolism? А. *Thrombosis of veins of the lower extremity","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"B","text":"Thrombosis of a portal vein"},{"label":"C","text":"Thrombosis of mesenteric arteries"},{"label":"D","text":"Thrombosis in a left ventricle of heart"},{"label":"E","text":"Ball-shaped thrombus of an auricle"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-675c30ed5b00","stem":"A male with a fracture of the shoulder bone carried on overlapped plaster ban- dage. Suddenly, an arm and the visible part of the forearm became cyanotic, cold, and edematous. Which of the following is most likely happened? А. *Local venous plethora","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"B","text":"Local arterial plethora"},{"label":"C","text":"Local anemia"},{"label":"D","text":"Stasis"},{"label":"E","text":"Thrombosis"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-90656c3f6f64","stem":"An elderly female develops acute disorder of the cerebral blood circulation, followed with coma, resulted in fatal outcome. A post-mortem revealed in the right hemisphere of the brain a large cavity, filled with blood. Which pathological process took place in the brain? А. *Hematoma","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Hemorrhagic infiltration 31"},{"label":"C","text":"Infarct of the brain"},{"label":"D","text":"Diapedesis"},{"label":"E","text":"Edema of the brain"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-b33a07bc58f0","stem":"A male suddenly died after an open fracture of the clavicle. A post-mortem revealed in the right ventricle of the heart and pulmonary arteries the foamy blood. Which one was the cause of death? А. *Air embolism","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Trauma and Emergency Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Trauma and Emergency Surgery","options":[{"label":"B","text":"Bacterial embolism"},{"label":"C","text":"Hemorrhage"},{"label":"D","text":"Tissue embolism"},{"label":"E","text":"Fat embolism"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Trauma and Emergency Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-27e1fa1bc198","stem":"A male with a history of the decompression sickness developed symptoms of acute cerebral circulation disorder and died soon. A post-mortem revealed in the left hemisphere of the brain the locus of a grey softening of the brain, which was 6х5х3 cm. Which one is most likely to cause the death of the patient? А. *Gas embolism.","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Fat embolism."},{"label":"C","text":"Thrombosis."},{"label":"D","text":"Thromboembolism."},{"label":"E","text":"Atherosclerosis of the vessels."}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-7590bb138a01","stem":"A post-mortem of an elderly man with a long history of the ischemic heart dis- ease and heart failure revealed a nutmeg liver, brown induration of lungs, cyanotic induration of kidney and spleen. Indicate, what type of the blood circulation dis- order is most likely? А. * Chronic general venous plethora.","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Arterial hyperemia."},{"label":"C","text":"Acute general venous plethora."},{"label":"D","text":"Acute anemia."},{"label":"E","text":"Chronic anemia."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-baf9bbf7f794","stem":"A 50-year-old male with a myocardial infarction died from the heart failure. A post-mortem revealed the edema of the lungs and petechial hemorrhages at serous and mucus membranes. Microscopic examination indicated marked dystrophic alte- rations of the nephron‘s epithelium at proximal canaliculi of kidneys. Also, the centrolobular hemorrhage and necrotic zones were found in the liver. Name the type of the blood circulation disorder. А. * Acute general venous plethora.","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Arterial hyperemia."},{"label":"C","text":"Chronic general venous plethora."},{"label":"D","text":"Acute anemia."},{"label":"E","text":"Chronic anemia."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f56628adfe32","stem":"A neonate died of intoxication. A microscopic examination of an umbilical vein revealed a diffuse inflammatory infiltration of the vessel‘s wall. Also, its lumen was filled with thrombus, rich with leucocytes and bacterial colonies. Karyorrhexis 32 was detected in many leucocytes. Which is most likely outcome of a thrombus in that case? А. * Septic autolysis.","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Histology and Tissues","topicOriginal":"Histology and Tissues","subtopic":"Vein","suggestedTopic":null,"options":[{"label":"B","text":"Aseptic autolysis."},{"label":"C","text":"Organization and vascularization of the thrombus."},{"label":"D","text":"Thromboembolism."},{"label":"E","text":"Calcification of a thrombus."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Histology and Tissues","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-d9dd5e32e3e4","stem":"A 68-year-old female is admitted to the hospital for treatment of deep vein thromboses. The next day she suddenly died. At autopsy a large plug of laminated blood clot is found to occlude the main pulmonary artery. Which is likely to be found in her lungs? А. *Thromboembolism","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"B","text":"Thrombosis"},{"label":"C","text":"Tissue embolism"},{"label":"D","text":"Foreign bodies embolism"},{"label":"E","text":"Fat embolism"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-2c0404cb8291","stem":"A 77-years-old female with unstable angina presents to physician with slowly increasing heart failure symptoms. On the night of admission to the hospital she dies. A post-mortem examination revealed the enlarged liver with dense texture and the rounded edges. Sectional view had a nutmeg pattern with dark red dots on the yellowish background. Which pathological process resulted in liver‘s alteration? А. * Chronic venous plethora","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Acute venous plethora"},{"label":"C","text":"Arterial plethora"},{"label":"D","text":"Arterial anemia"},{"label":"E","text":"Chronic hemorrhage"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-854bd3b77476","stem":"A post-mortem of a 53-year-old male with a long history of hypertension re- vealed the cavity in the occipital lobe of the brain. It measured 2х1 cm, had a brownish smooth walls and filled with transparent liquid. Which is the most likely diagnosis? А. * Cyst after hemorrhages","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Cardiology","topicOriginal":"Cardiology","subtopic":"Hypertension","suggestedTopic":null,"options":[{"label":"B","text":"Softening of the brain"},{"label":"C","text":"Abscess of a brain"},{"label":"D","text":"Developmental defect of a brain"},{"label":"E","text":"Cyst after softening of the brain"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Cardiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-3040c2018263","stem":"A 65-years-old patient, who presented with a 10 years history of ischemic heart disease, died due to heart failure. An autopsy revealed the cyanotic induration of both spleen and kidneys, brown induration of lungs and ―nutmeg‖ liver. Which is the most likely type of the blood circulation disorder, resulted in such changes of internal organs? А. *General chronic venous hyperemia","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"General acute venous hyperemia"},{"label":"C","text":"General arterial hyperemia after an anemia 33"},{"label":"D","text":"Arterial ischemia as a result of reallocating a blood"},{"label":"E","text":"Local chronic venous hyperemia"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-ae77651c41fa","stem":"A 63-year-old patient with long history of ischemic heart disease and repeated myocardial infarction died due to progressive cardiovascular failure. A post- mortem revealed an enlarged, dense spleen with the dark red colour of the sectional view. At the microscopic examination of spleen the pulp‘s sclerosis and atrophy of the follicles were found. Which term most correctly defines theses changes? А. *Cyanotic induration of a spleen","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Sago spleen"},{"label":"C","text":"Waxy spleen"},{"label":"D","text":"Porphyry spleen"},{"label":"E","text":"Septic spleen"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4780289f6b8a","stem":"A young male fractures his pelvis and femur in a motor vehicle accident. On the third day he dies after respiratory distress and cerebral dysfunction. A histological examination revealed Sudan-positive orange globules scattered within cerebral cor- tex, kidneys and lung microcirculatory vessels. Which is most likely diagnoses? А. * Fat embolism","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Neuroanatomy","topicOriginal":"Neuroanatomy","subtopic":"Cerebr","suggestedTopic":null,"options":[{"label":"B","text":"Gas embolism"},{"label":"C","text":"Tissue embolism"},{"label":"D","text":"Microbial embolism"},{"label":"E","text":"Thromboembolism"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Neuroanatomy","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-9150152a26f9","stem":"A cosmonaut died due to the air-tightless of the space-shuttle cabin. Microscop- ic examination of the vessels of the internal organs revealed multiple bubbles. Liver cells developed fatty dystrophy. In the brain and spinal cord multiple small, grey, soft lesions were discovered. Indicate the most probable cause of such alterations. А. *Gas embolism","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Air embolism"},{"label":"C","text":"Fat embolism"},{"label":"D","text":"Thromboembolism"},{"label":"E","text":"Tissue embolism"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7657b09cc97c","stem":"A patient with a long history of rheumatic disease died of cardiopulmonary failure. A post-mortem revealed a stenosis of the mitral orifice as well as a brown induration of lungs. Which term most correctly defines this blood circulation dis- order? А. *Chronic left ventricular failure.","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Chronic right ventricular failure."},{"label":"C","text":"Acute left ventricular failure."},{"label":"D","text":"Acute right ventricular failure."},{"label":"E","text":"Portal hypertension."}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-82b513a688a3","stem":"A post-mortem of a 59-year-old patient with long history of idiopathic hyper- tension revealed in brain a cavity with rusty colour walls. Which process preceded these changes? А. *Hematoma 34","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Diapedesis"},{"label":"C","text":"Ischemic infarct"},{"label":"D","text":"Plasmorrhagia"},{"label":"E","text":"Abscess"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-6bced5db9d13","stem":"A 65-year-old- patient presented with liver cirrhosis. The removal from his ab- dominal cavity of 10 liters of ascitic liquid resulted a collapse. Grossly his perito- neum was hyperemic. Define the type of hyperemia in peritoneum. А. * Post-anemic hyperemia","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"B","text":"Collateral hyperemia"},{"label":"C","text":"Complementary hyperemia"},{"label":"D","text":"Inflammatory hyperemia"},{"label":"E","text":"Caused by arteriovenous fistula"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b8acf46c1066","stem":"A post-mortem of a 60-year-old female with a history of secondary hyperten- sion revealed a cavity at the right hemisphere of the brain 4х2,5 cm, filled with red clots of blood and softened brain tissue. What term best characterized the brain changes? А. *Hematoma.","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Hemorrhagic impregnation."},{"label":"C","text":"Ischemic infarct."},{"label":"D","text":"Cyst."},{"label":"E","text":"Abscess."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-bfdc64d8f35e","stem":"An inexperienced scuba diver ascends from a depth of 55 meters to the surface in about 5 minutes. Shortly after surfacing he complains of severe muscle contrac- tion and intense abdominal pain. What is most likely diagnose? А. *Gas embolism","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Face","suggestedTopic":null,"options":[{"label":"B","text":"Air embolism"},{"label":"C","text":"Fat embolism"},{"label":"D","text":"Thromboembolism"},{"label":"E","text":"Tissue embolism"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d3f437701b6c","stem":"A 78-year-old male, with a history of stroke 2 years ago, died of pneumonia as a complication of severe influenza. At post-mortem, gross investigation of his brain revealed a cerebral cyst with rusty color of its walls. Perls' test was positive. Name the process reveled within a cystic wall.","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Local hemosiderosis."},{"label":"B","text":"Common hemosiderosis."},{"label":"C","text":"Local hemomelanosis."},{"label":"D","text":"Infiltration of bilirubin."},{"label":"E","text":"Primary hemochromatosis."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d7cc391d1bc4","stem":"A 54-years old male with a history of ischemic heart disease presents at hospital with recurrent myocardial infarction. Few days later, he died due to cardiac failure. Post-mortem revealed an enlarged solid spleen of dark cherry color on the cut sur- face. Microscopically, pulp sclerosis and follicles atrophy were found out. What is the most likely term to define spleen‘s alterations?? 35","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Cyanotic induration of spleen."},{"label":"B","text":"Sago spleen."},{"label":"C","text":"Lardaceous spleen."},{"label":"D","text":"Porphyry spleen."},{"label":"E","text":"Septic splenitis."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-16eb81863cca","stem":"A post-mortem of 77-year-old male, with a long history of cerebral atheroscle- rosis, revealed an atrophy of his cerebral cortex. What was the most likely cause of cortex alterations?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Insufficiency of blood supply."},{"label":"B","text":"Pressure."},{"label":"C","text":"Physical and chemical factors."},{"label":"D","text":"Neurotic."},{"label":"E","text":"Dysfunctional."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-261bfb1c4517","stem":"A 56-year-old male with a history of cerebral atherosclerosis suddenly dies. At a there is a thrombus within a middle cerebral artery's lumen. Gross inspection re- vealed a grey flabby focus at the parietotemporal part of the left hemisphere of his brain .What are the most likely alterations diagnosed in a brain tissues?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Infarction."},{"label":"B","text":"Sequestrum."},{"label":"C","text":"Gangrene."},{"label":"D","text":"Caseous necrosis."},{"label":"E","text":"Fibrinoid necrosis."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-71e8987ed08b","stem":"An autopsy of a patient who died suddenly at emergency room revealed in his brain a cavity of irregular shape (5 x 3.5 cm) filled with blood clots and macerated cerebral tissue. An area of cavitary destruction had a rim of brown discoloration. This lesion was found within the subcortex nuclei at the right hemisphere of brain. What is the most likely definition of described pathology?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Hematoma."},{"label":"B","text":"Hemorrhagic impregnation."},{"label":"C","text":"Ischemic infarction."},{"label":"D","text":"Cyst."},{"label":"E","text":"Abscess."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-9cda9ca97fa6","stem":"2 hours after a skeletal extension was performed to a 27 year old patient with multiple traumas (closed injury of chest, closed fracture of right thigh) his condi- tion abruptly became worse and the patient died from acute cardiopulmonary de- compensation. Histological examination of pulmonary and cerebral vessels stained with Sudan III revealed orange drops occluding the vessel lumen. What complica- tion of polytrauma was developed?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Fat embolism"},{"label":"B","text":"Thromboembolism"},{"label":"C","text":"Air embolism"},{"label":"D","text":"Microbal embolism"},{"label":"E","text":"Gaseous embolism 36"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-00744d77f2d1","stem":"A 65-year-old patient died of chronic heart failure due to rheumatic valve de- fect. An autopsy revealed the enlarged, dense, brown lungs. What are the most like- ly changes in the lungs","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Brown induration of the lungs."},{"label":"B","text":"Acute venous congestion"},{"label":"C","text":"Honeycomb lungs."},{"label":"D","text":"Chronic bronchitis."},{"label":"E","text":"Chronic emphysema."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-582870a1bef9","stem":"A 55-year-old patient had a prolonged immobilization due to the surgery opera- tion. Once, after getting up from a bed he developed sudden onset of dyspnea, breathing difficulties and cyanosis. Shortly after that he got unconscious state and then died. A post-mortem revealed a pulmonary thromboembolism. Choose the most probable source of thromboembolism","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Veins of lower extremities"},{"label":"B","text":"Portal vein"},{"label":"C","text":"Mesenterial arteries"},{"label":"D","text":"Left heart ventricle"},{"label":"E","text":"Left atrium"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-716449eeb588","stem":"A patient died of a heart failure. An autopsy revealed enlarged and hyperemic liver, with dark red foci surrounded by paler yellow- brownish zones on its cut sur- face. Microscopical investigation showed congestion of central veins and fat dy- strophy of hepatocytes on the periphery of lobules. Specify the most probable pa- thology of a liver.","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"*Nutmeg liver"},{"label":"B","text":"False nutmeg liver"},{"label":"C","text":"Hepatic amyloidosis"},{"label":"D","text":"Liver cirrhosis"},{"label":"E","text":"Liver steatosis"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-da8360a49011","stem":"An autopsy of 86-year-old female with a long history of a chronic coronary disease followed with heart failure revealed ̳nutmeg‘ liver, brown induration of lungs, cyanotic induration of the kidneys and spleen. Name the kind of a circulatory disturbance.","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Chronic general venous plethora"},{"label":"B","text":"Acute anaemia"},{"label":"C","text":"Chronic anaemia"},{"label":"D","text":"Arterial hyperaemia"},{"label":"E","text":"Acute general venous plethora Inflammation."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-77ab8a72efc3","stem":"A histological investigation of enlarged neck lymphatic node revealed a conges- tion of epithelial cells, lymphocytes and giant Pirogov-Langhan‘s cells. In the cen- ter of lesion a caseous necrosis was present. Which pattern of inflammation do the lymphatic node display? 37 А. * Tuberculosis","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Rhinoscleroma"},{"label":"C","text":"Sarcoidosis"},{"label":"D","text":"Glanders."},{"label":"E","text":"Syphilis."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-99c8405aa7f8","stem":"A 3-year-old child died of a meningococcal fever. A macroscopic study revealed swallowed meninges which had yellow-green colouring. Which pattern of inflam- mation was most likely in meninges? А. *Fibrinous-purulent inflammation","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Serous inflammation"},{"label":"C","text":"Hemorrhagic inflammation"},{"label":"D","text":"Catarrhal inflammation"},{"label":"E","text":"Necrotic inflammation"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7150e118a733","stem":"A 37-year-old male presents with a fever, dyspnea and pain in the right part of the chest. The pleurocentesis gave 700 mls of thick yellow-greenish liquid. What pathological process was diagnosed in a pleural cavity? А. *Empyema of a pleura","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Bronchopneumonia"},{"label":"C","text":"Serous pleuritis"},{"label":"D","text":"Hemorrhagic pleuritis"},{"label":"E","text":"Carcinomatosis of a pleura"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d01d33514572","stem":"A 25 years old male presents with a 2-day history of itching and redness in the buccal area that appeared after shaving. Physical examination by family physician revealed vesicles filled with transparent fluid on the background the hyperemic buccal area. What is the most likely type of fluid in the vesicles?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Serous exudate."},{"label":"B","text":"Transsudate."},{"label":"C","text":"Purulent effluent."},{"label":"D","text":"Mucous exudate."},{"label":"E","text":"Hemorrhagic exudate."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-dfb9c2b794dd","stem":"An autopsy of a 34-years old female, with a history of croupous pneumonia re- vealed opaque fluid in her pleural cavity. There was also a grey membrane on the visceral pleura. What is the most likely type of the pleura‘s inflammation?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Fibrinous."},{"label":"B","text":"Catarrhal."},{"label":"C","text":"Suppurative."},{"label":"D","text":"Granulomatous."},{"label":"E","text":"Hemorrhagic."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e3db3bcfea9e","stem":"A 4-year-old girl with 3 days history of diphtheria presents to the emergency with croup symptoms. Intensive care was unsuccessful and child died at the hospit- al. A post-mortem revealed thickened, edematous, dull mucous tunic of the larynx, trachea, and bronchi covered by grayish membrane easily separated from tissues underneath. What is the most likely type of inflammation? 38","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Fibrinous."},{"label":"B","text":"Serous."},{"label":"C","text":"Suppurative."},{"label":"D","text":"Mixed."},{"label":"E","text":"Catarrhal."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-3d88dc7e88a4","stem":"At post-mortem a 5-year-old boy is found to have a severe tracheobronchitis complicated with asphyxia. Grossly, a thick, gray, leathery membrane covered the mucous tunic of trachea and bronchi. The membrane loosely attached to underlying tissues and easily removed with forceps. The lumen of the segmental bronchi was blocked with gray masses of tissue debris, which microscopically consisted with necrotic tissues, neutrophils, fibrin and bacteria. What is the most likely type of inflammation?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Croupous."},{"label":"B","text":"Catarrhal."},{"label":"C","text":"Diphtheritic."},{"label":"D","text":"Purulent."},{"label":"E","text":"Serous"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d7e98e59673c","stem":"An autopsy of a 50-year-old male, who died of dysentery, revealed the hyperem- ic mucosa of the colon, coated with grey membranes, which can be removed from tissues underneath with some effort. Which type of an inflammation described in the intestine? А. *Diphtheroid inflammation","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Croupous inflammation"},{"label":"C","text":"Hemorrhagic inflammation"},{"label":"D","text":"Serous inflammation"},{"label":"E","text":"Catarrhal inflammation"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-0c71598fc123","stem":"A 30-year-old male has a neck lymph node removed for examination. Histologi- cal investigation revealed granulomas, which consisted of epithelioid, lymphoid and multinuclear Langhans giant cells. Granulomas‘ centers were presented with necrosis. What causative agent needs to be revealed in the necrosis zone for support of the diagnosis of tuberculosis? А. *Mycobacterium tuberculosis","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Treponema pallidum"},{"label":"C","text":"Staphylococcus"},{"label":"D","text":"Frisch bacillus"},{"label":"E","text":"Salmonella"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3e4ca27e91fb","stem":"An autopsy of a 53-year-old male, with a history of crupous pneumonia, re- vealed in his dextral pleural cavity 900 ml of cloudy, grey-yellowish colored liquid. Pleural membranes were found to be dim and plethoric. Name the clinical - morphological form of the inflammation in the pleural cavity? А. * Empyema.","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Fibrinous inflammation."},{"label":"C","text":"Phlegmon. 39"},{"label":"D","text":"Chronic abscess."},{"label":"E","text":"Acute abscess."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-f15029536d01","stem":"An autopsy of a 53-year-old male, who died from chronic renal failure, re- vealed the colon‘s mucosa, covered with grey – yellow membranes, densely cohe- rent to tissues underneath. The removal of the membranes resulted in ulcers forma- tion. Name a type of an inflammation? А. *Diphtheroid","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Serous"},{"label":"C","text":"Catarrhal"},{"label":"D","text":"Croupous"},{"label":"E","text":"Purulent"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-65dcfa9c56aa","stem":"A 65-year-old female with a long history of chronic glomerulonephritis died from chronic renal failure. A post-mortem revealed on the surface of the epicar- dium and pericardium grey-whitish villous membranes. Which pathological process took place in the pericardium? А. *Fibrinous inflammation","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Organization"},{"label":"C","text":"Proliferative inflammation"},{"label":"D","text":"Hemorrhagic inflammation"},{"label":"E","text":"Arterial plethora"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-66c7f01d0197","stem":"An elderly man presented to his physician with the complicated nasal breathing. The histological investigation of a biopsy from his nose septum revealed granulo- matous inflammation in the mucosa with groups of large vacuolated histiocytes containing bacteria (Mikulicz‘s cells). What is the most likely diagnosis? А. *Rhinoscleroma","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Syphilis"},{"label":"C","text":"Tuberculosis"},{"label":"D","text":"Malleus"},{"label":"E","text":"Lepra"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ef0e5165a641","stem":"An elderly man, with a history of an operation, presented with a sepsis, devel- oped on a background of a decreased immune reactivity of an organism. A disease resulted in fatal outcome. Microscopical investigation of the abdominal wall re- vealed the diffuse segmentonuclear leukocyte‘s infiltration of intermuscular spaces, edema of a tissue and lysis of muscle fibers. Define the type of inflammation? А. *Phlegmon.","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"B","text":"Diphtheroid inflammation."},{"label":"C","text":"Abscess."},{"label":"D","text":"Necrosis."},{"label":"E","text":"Catarrhal inflammation."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-6fff8933d796","stem":"A 64-years-old male died of rheumatism. An autopsy revealed epicardium cov- ered with villiferous grey color membranes, which were easily separated from tis- sues underneath. The separation of membranes presented an edematous, hyperemic surface of epicardium. What type of an inflammation revealed in pericardium? 40 А. *Fibrinous pericarditis","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Purulent pericarditis"},{"label":"C","text":"Hemorrhagic pericarditis"},{"label":"D","text":"Proliferative pericarditis"},{"label":"E","text":"Catarrhal pericarditis"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-28d7711cea22","stem":"A 50-year-old male died of a pulmonary and cardiac insufficiency. An autopsy revealed in a left lung a 4 x 4 сm cavity, filled with pus. The wall of a cavity had a rough pattern, presented by pulmonary tissue. What is the most likely diagnose? А. *Acute abscess","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Chronic abscess"},{"label":"C","text":"Cavernous tuberculosis"},{"label":"D","text":"Hydatidosis"},{"label":"E","text":"Fibrosing alveolitis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9ddd8f000a02","stem":"A post-mortem of a man revealed in his abdominal cavity approximately 2.0 liters of a purulent exudate. A peritoneum was found to be dull, with a grayish tint. The intestinal serous membranes were covered with grayish membranes, which were removed easily. Which of the following is the most accurate diagnosis? А. * Fibro-purulent peritonitis","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Abdomen","topicOriginal":"Abdomen","subtopic":"Peritone","suggestedTopic":null,"options":[{"label":"B","text":"Hemorrhagic peritonitis"},{"label":"C","text":"Serous peritonitis"},{"label":"D","text":"Tuberculous peritonitis E."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Abdomen","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-83ffe2234ca9","stem":"A histological examination of the myocardium of a man, who died from heart failure, revealed a sclerosis of the pericardial connective tissue and diffuse infiltra- tion by lymphocytes, macrophages, plasmocytes and single neutrophils. What is the most likely type of inflammation in a heart? А. * Interstitial productive.","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Granulomatous."},{"label":"C","text":"Alterative."},{"label":"D","text":"Exudative diffuse."},{"label":"E","text":"Exudative focal."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-99b22450304b","stem":"A 28-year-old male presented to the hospital with a fever and weakness, (asthe- nia). A biopsy was taken from one of his enlarged neck lymph nodes for histologi- cal examination. Microscopic investigation revealed the foci of necrosis, sur- rounded by epithelioid cells, giant multinuclear Langhans' cells and also lympho- cytes. What is the most likely diagnosis? А. *Tuberculosis","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Hodgkin‘s disease"},{"label":"C","text":"Lympholeukemia"},{"label":"D","text":"Sarcoidosis"},{"label":"E","text":"Syphilis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8b9bfd73cc19","stem":"A microscopic examination of a kidney biopsy revealed foci with granular, eo- sinophilic masses in their centers. These lesions were surrounded by an infiltrate, 41 consisted of lymphocytes, epithelioid cells and giant Langhans' cells. What is the most likely pathological process? А. * Granulomatous inflammation","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Coagulative necrosis"},{"label":"C","text":"Caseous necrosis"},{"label":"D","text":"Alterative inflammation"},{"label":"E","text":"Proliferation and derivation of macrophages"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-4efe90cc72c3","stem":"A young male presented to his physician with considerably enlarged, hyperem- ic, painful tonsils. A gross examination of tonsils revealed dense, dirty-gray mem- branes on the surface. These membranes have spread to the hard palate and were intimately attached to tissues underneath. An attempt to remove the membranes resulted in bleeding. Which pathological process indicates these morphological changes? А. *Diphtheroid exudative inflammation.","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Croupous exudative inflammation."},{"label":"C","text":"Catarrhal exudative inflammation."},{"label":"D","text":"Purulent exudative inflammation."},{"label":"E","text":"Hemorrhagic exudative inflammation."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-dc4972b8ea2f","stem":"A 38-year-old man, with a history of chronic pyelonephritis, died from the chronic renal failure. Medical record showed that an auscultation in the hospital determined a patient‘s ―pericardial frictions rub‖. An autopsy revealed a dim, rough, and hairy – like epicardium. What type of pericarditis presented in that case? А. *Croupous","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Nephrology","topicOriginal":"Nephrology","subtopic":"Renal","suggestedTopic":null,"options":[{"label":"B","text":"Diphtheroid"},{"label":"C","text":"Purulent"},{"label":"D","text":"Ichorous"},{"label":"E","text":"Serous"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Nephrology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e8d9a96dd7dc","stem":"A child presented to a hospital with symptoms of asphyxia. A physical exami- nation revealed in the larynx whitish membranes, which obstructed lumen and were easily separated from tissues underneath. Name the most probable type of an inflammation in the larynx? А. *Croupous inflammation","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Hemorrhagic inflammation"},{"label":"C","text":"Diphtheroid inflammation"},{"label":"D","text":"Catarrhal inflammation"},{"label":"E","text":"Purulent inflammation"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-661cc35e9147","stem":"A macroscopic investigation of trachea revealed a dim, hyperemic mucosa, covered with grey - white membranes. Which one is the most likely form of the inflammation? А. *Fibrinous","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Purulent"},{"label":"C","text":"Serous"},{"label":"D","text":"Proliferative 42"},{"label":"E","text":"Mixed"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-6eb8f59b72e0","stem":"An elderly man presented with a decomposition of some segments of spongy and cortical layers of an anticnemion bones. The cavities are filled with creamy greenish-yellow masses. What is the type of inflammation? А. *Purulent","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Catarrhal"},{"label":"C","text":"Serous"},{"label":"D","text":"Proliferative"},{"label":"E","text":"Mixed"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f2e433be138f","stem":"A female patient presented to the hospital with a fever, asphyxia and pain in the right part of her chest. During a pleurocentesis procedure 700 ml of a viscid yellow-green liquid was removed. What is the most likely diagnosis? А. *Empyema of a pleura","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Carcinomatosis of a pleura"},{"label":"C","text":"Serous pleurisy"},{"label":"D","text":"Fibrinous pleurisy"},{"label":"E","text":"Hemorrhagic pleurisy"}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-0dc487befa87","stem":"An autopsy of the 58-year-old man, revealed in his liver a focus of tissue de- struction, 4 cm in diameter, filled with a yellow-green liquid. What is the most like- ly diagnose? А. *Abscess","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Phlegmon"},{"label":"C","text":"Anthrax"},{"label":"D","text":"Empyema"},{"label":"E","text":"Granuloma"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a140bb8e7e13","stem":"A histological examination of biopsy from the nose mucous revealed epithelio- id cells, plasmocytes, Mikulicz cells, and eosinophilic (acidophilic, Russell's) bo- dies. What is the most likely diagnosis? А. * Rhinoscleroma","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Syphilis"},{"label":"C","text":"Tuberculosis"},{"label":"D","text":"Droplet infection"},{"label":"E","text":"Allergic rhinitis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-17bfd134b1f5","stem":"A physical examination of a 5-year-old boy reveals the fauces and the tonsils enlarged, plethoric, and coated with irremovable whitish membranes. Which one of the following characterizes the changes in the fauces and tonsils? А. * Diphtheritic inflammation","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Caseous necrosis"},{"label":"C","text":"Fibrinous necrosis"},{"label":"D","text":"Croupous inflammation"},{"label":"E","text":"Purulent inflammation"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-361155f5898e","stem":"A 49-year-old man, with 14 days history of acute lobar staphylococcal pneu- monia in the left lower lobe of a lung, died of pulmonary and cardiac insufficiency. 43 A post-mortem revealed in the upper lobe of a right lung an oval cavity, approx- imately 5 cm in diameter, filled with pus and connected with bronchus. Which complication of acute pneumonia took place in this case? А. *Abscess of the lung","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Gangrene of the lung"},{"label":"C","text":"Thromboembolia of a pulmonary trunk"},{"label":"D","text":"Bronchiectasis disease"},{"label":"E","text":"Acute bronchitis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-7932e050caa4","stem":"An autopsy of an elderly male revealed a cavity with compacted walls filled with a thick, greenish liquid, which had a stinking odor. What is the most likely disease? А. * Abscess of the lung.","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Gangrene of the lung."},{"label":"C","text":"Infarct of the lung."},{"label":"D","text":"Cavern of the lung."},{"label":"E","text":"Tuberculoma of the lung."}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-d152cb575d1d","stem":"A 62-year-old man died of croupous pneumonia. A post-mortem revealed in the pleural cavity an opaque liquid and a grayish membrane on visceral pleura. What is the most likely type of inflammation on the visceral pleura? А. * Fibrinous inflammation","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Catarrhal inflammation"},{"label":"C","text":"Purulent inflammation"},{"label":"D","text":"Granulomatous inflammation"},{"label":"E","text":"Hemorrhagic inflammation"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-f1b516528328","stem":"A 5-year-old child has a fever and pain at swallowing. A physical examination revealed enlarged, dark-red palatine tonsils. They were coated with a grey - yellow membrane which was intimately attached to the surface of the tonsils. Which kind of inflammation described in the tonsils? А. * Diphtheritic inflammation","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Croupous inflammation"},{"label":"C","text":"Hemorrhagic inflammation"},{"label":"D","text":"Purulent inflammation"},{"label":"E","text":"Catarrhal inflammation"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e89af68bbb34","stem":"An autopsy of a dead body revealed 200 ml of a viscid yellow-green liquid in the abdominal cavity. What is the most likely form of exudate inflammation? А. * Purulent inflammation","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Serous inflammation"},{"label":"C","text":"Fibrinous inflammation."},{"label":"D","text":"Hemorrhagic inflammation."},{"label":"E","text":"Ichorous inflammation"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ab721c0ba9f6","stem":"A post-mortem of a young male revealed congested, thickened, opaque, yello- wish-green meninges. What type of exudative inflammation these changes are cha- racteristic for? 44 А. * Purulent inflammation","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Serous inflammation"},{"label":"C","text":"Hemorrhagic inflammation"},{"label":"D","text":"Fibrinous inflammation"},{"label":"E","text":"Catarrhal inflammation"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-793c0784ba48","stem":"A woman, with a history of her hands‘ skin thermal burn, presented to physi- cian painful blisters, filled with opaque liquid. What is the most likely type of in- flammation? А. * Serous inflammation","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Productive inflammation"},{"label":"C","text":"Croupous inflammation"},{"label":"D","text":"Granulomatous inflammation"},{"label":"E","text":"Diphtheritic inflammation"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-fcb15b8868c5","stem":"A 44-year-old male had a skin biopsy procedure. Histological investigation of a tissue sample showed a caseous necrosis surrounded by infiltrate, consisted from lymphocytes, some giant cells and the growth of connective tissue. In addition, the endovasculitis was diagnosed. What is the most likely pathological process? А. * Productive granulomatous inflammation.","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Productive interstitial inflammation."},{"label":"C","text":"Abscess."},{"label":"D","text":"Catarrhal inflammation."},{"label":"E","text":"Serous inflammation"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-081c3e92459b","stem":"A 7-year-old child, with a history of angina, presented with enlarged paratra- cheal, bifurcation and neck lymph nodes. A histological examination of his neck lymph node revealed the foci of necrosis, surrounded by lymphocytes, epithelioid cells and Pirogov-Langhans‘ cells. Which one is the most likely pathology? А. *Tuberculosis","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Sarcoidosis"},{"label":"C","text":"Rhinoscleroma"},{"label":"D","text":"Malleus"},{"label":"E","text":"Syphilis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d1881dede1b5","stem":"The histological examination of a lung tissue revealed a lesion presented with a locus of necrosis, surrounded by regular lines of epithelioid, lymphoid cells, plasma cells, macrophages and giant Pirogov-Langhans‘ cells. Define a kind of inflammation? А. *Tuberculosis inflammation","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Banal productive inflammation"},{"label":"C","text":"Inflammation at a lepra"},{"label":"D","text":"Exudative inflammation"},{"label":"E","text":"Alterative inflammation"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-c73316e50ae6","stem":"A 6-year-old child presented to infectious disease department with a body tem- perature 38С, punctulated, bright red rash on a skin. The scarlet fever diagnosis is made. The fauces mucosa was brightly hyperemic, edematous; tonsils were mar- 45 kedly enlarged, with the dim yellowish-grayish centers and sites of black color. What inflammation underlies changes in fauces? А. *Purulent-necrotic","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Fibrinous"},{"label":"C","text":"Hemorrhagic"},{"label":"D","text":"Serous"},{"label":"E","text":"Catarrhal"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-0da768bc8f9a","stem":"A rectoromanoscopy revealed edematous, reddish color mucosa of rectum and sigmoid colon, covered with a thick layer of mucus. Name the kind of inflamma- tion? Which pathological process took place in pia mater of meninges?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Catarrhal"},{"label":"B","text":"Purulent"},{"label":"C","text":"Mixed"},{"label":"D","text":"Hemorrhagic"},{"label":"E","text":"Fibrinous 42 A patient died with symptoms of the brain‘s edema and the dislocation of the stem. A post-mortem revealed thickened, opaque, grayish-green color pia mater. А. *Diffuse purulent leptomeningitis"},{"label":"B","text":"Meningococcal leptomeningitis"},{"label":"C","text":"Tuberculous leptomeningitis"},{"label":"D","text":"Malignant arachnoendothelioma"},{"label":"E","text":"Hydrocephalus"}],"priority":1,"status":"review","flags":["too_many_options_possible_merge","duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag","too_many_options","too_many_options_possible_merge"],"cleaningOperations":[]},{"id":"q-7ce3780cff1a","stem":"A 5-year-old child presented to a hospital with acute fever (up to 380 C), rhini- tis, cough, lacrimation, and a patchy rash on the skin. His pharyngeal mucosa was edematous and hyperemic, with whitish maculae on the cheeks. What type of in- flammation is the background of described changes? А. *Catarrhal","type":"Single Best Answer MCQ","subject":"Dermatology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Purulent"},{"label":"C","text":"Fibrinous"},{"label":"D","text":"Hemorrhagic"},{"label":"E","text":"Serous"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Dermatology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a1d51d6234c9","stem":"A 3-year-old child presented to a hospital with asphyxia. Examination of the larynx revealed whitish membranes, which occluded a lumen and easily extracted. Diphtheria was suspected. Which form of inflammation took place in the larynx? А. *Croupous inflammation","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Catarrhal inflammation"},{"label":"C","text":"Diphtheroid inflammation"},{"label":"D","text":"Serous inflammation"},{"label":"E","text":"Purulent inflammation"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2405c9b97847","stem":"A 47-year-old male presented with a sub-febrile temperature and enlarged lymph nodes. A biopsy investigation of a lymph node revealed numerous granulo- 46 mas with a caseous necrosis in the centers, surrounded by epithelioid cells, giant multinuclear Langhans' cells and lymphocytes. What is the most likely diagnosis? А. *Tuberculosis","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Lymphogranulomatosis"},{"label":"C","text":"Lymphosarcoma"},{"label":"D","text":"Lympholeukemia"},{"label":"E","text":"Simple lymphadenitis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-0d6eb55222e8","stem":"At a 45-year-old man the biopsy procedure of his nasal cavity‘s mucosa was performed. The diagnosis of rhinoscleroma made. What cells are typical for the disease? А. *Mikulicz‘s cells","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Pirogovs‘ – Langhans‘ cells"},{"label":"C","text":"Plasma cells"},{"label":"D","text":"Lymphocytes"},{"label":"E","text":"Schaumann‖s bodies"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4e77ea0c322d","stem":"An autopsy of a 53-year-old male showed many white, millet sized nodules in his lungs. A microscopic examination revealed granulomas with a necrosis in their centers and epithelioid, lymphoid, plasma cells, macrophages and numerous large multinucleated cells (Langhans' cells) on the periphery of a lesion. What is the most likely form of granuloma? А. *Giant - cell granuloma","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Macrophagal"},{"label":"C","text":"Foreign body granuloma"},{"label":"D","text":"Epithelioid cells E -"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-93f55296bee0","stem":"A patient presented to the hospital with combustion of his right hand. A physi- cal examination revealed a desquamation of epidermis with blisters formation. The blisters were filled with opaque liquid. What most probable inflammation described in that case? А. *Serous","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Purulent"},{"label":"C","text":"Catarrhal"},{"label":"D","text":"Putrefactive"},{"label":"E","text":"Fibrinous"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-2fa2e40b3a1f","stem":"A 43-year-old patient complains of hindered nasal breathing. Histological in- vestigation of a biopsy of his nasal cavity mucosa revealed lymphoid cells, epithe- lioid cells, plasma cells and Mikulicz‘s cells. What is the most likely diagnosis? А. *Rinoskleroma","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Glanders (malleus )"},{"label":"C","text":"Tuberculosis"},{"label":"D","text":"Lepra"},{"label":"E","text":"Syphilis 47"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-0c1f1ad9b17c","stem":"A 54-year-old patient complains of complicated nasal breathing. A nasal muco- sa was thickened. Histological investigation of a biopsy revealed Mikulicz‘s cells, epithelioid cells, plasma cells, lymphoid cells, and hyaline sphere- like aggregates. What is the most likely diagnosis? А. *Skleroma","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Adenoviral rhinitis"},{"label":"C","text":"Allergic rhinitis"},{"label":"D","text":"Rhinoviral infection"},{"label":"E","text":"Meningococcal nasopharyngitis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-615b58786265","stem":"A sample of cervix uteri was taken for histological examination. A microscopi- cal investigation revealed a tissue‘s inflammatory infiltration with vascular walls involvement of small vessels, arteries and veins. In addition, there were also de- termined a presence of plasma cells, lymphocytes, epithelioid cells in the infiltrate and foci of sclerosis and hyalinosis of tissue. What is the most likely disease? А. *Syphilis","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Tuberculosis"},{"label":"C","text":"Leukoplakia"},{"label":"D","text":"Erosio colli uteri"},{"label":"E","text":"Condyloma"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-915e61e88baa","stem":"A physical examination of tonsils and soft palate mucosa revealed white-grey color membranes, which are intimately attached to tissues underneath. An attempt to take out membranes results in formation of a deep tissue defect. Diagnose pa- thology on a mucosa of tonsils and a soft palate. А. *Diphtheritic inflammation B Serous inflammation","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"C","text":"Croupous inflammation"},{"label":"D","text":"Purulent inflammation"},{"label":"E","text":"Mixed inflammation"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-1aa47fa5f819","stem":"Histological investigation of a biopsy revealed a granuloma, consisted of lym- phocytes, plasma cells, macrophages with foamy cytoplasm (Mikulicz‘s cells) and numerous hyaline‘s sphere- like aggregates. About what disease it is possible to think? А. *Rinoskleroma","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Lepra C Syphilis"},{"label":"D","text":"Tuberculosis"},{"label":"E","text":"Actinomycosis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-cf0792c6962a","stem":"A 40-year-old woman, with a history of the right palm‘s burn, presented to her physician an acute pain, reddening and swelling of a palm. In a few minutes there was a bubble, filled with transparent yellowish liquid. The display of what patho- logical process the described changes are? А. *Exudative inflammation","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Traumatic edema 48"},{"label":"C","text":"Alterative inflammation"},{"label":"D","text":"Proliferative inflammation"},{"label":"E","text":"Vacuolar dystrophy"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-2aeaf98469cd","stem":"A 44-year-old man presented to the policlinic with a local pain in occipital area of a head and rise of a body temperature there. Gross investigation of a lesion zone revealed the cone-shaped cyanotic infiltration with a yellow-greenish apex, which rose above the surface of skin. What is the most likely diagnosis? А. *Furuncle","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Phlegmon"},{"label":"C","text":"Abscess"},{"label":"D","text":"Carbuncle"},{"label":"E","text":"Empyema."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-63a914c95338","stem":"A skin sample was taken for histological research. Microscopical investigation revealed granulomas, consisted of macrophages‘ knots with adding of lymphocytes and plasma cells. There were also determined large macrophages with fatty va- cuoles, which contained packed layers of causative agents of a disease (Virchow's cells). For what disease the given description is characteristic? А. *Lepra","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Tuberculosis"},{"label":"C","text":"Syphilis"},{"label":"D","text":"Rinoskleroma E Glanders (malleus)"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1e4dc5db2a57","stem":"Histological investigation of a skin biopsy revealed granulomas, which con- sisted of epithelioid cells, surrounded mainly by T-lymphocytes. In addition, few giant multinucleated cells (Langhans' cells) were determined among epithelioid cells. The caseous necrosis was diagnosed within the centers of granulomas. There was lack of blood vessels. What is the most likely disease? А. *Tuberculosis","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Syphilis"},{"label":"C","text":"Lepra"},{"label":"D","text":"Rinoskleroma"},{"label":"E","text":"Glanders (malleus)"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-71153c5c95cb","stem":"A histological investigation of a liver biopsy revealed granulomas, consisted of plasma cells and lymphoid cells. Small vessels were characterized by endo - and perivasculitis. Some foci of caseous necrosis were also determined. Such granulo- mas are typical for: А. *Syphilis","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Tuberculosis"},{"label":"C","text":"Lepra"},{"label":"D","text":"Rinoskleroma"},{"label":"E","text":"Glanders (malleus)"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a3be5b8f2cc2","stem":"A young man had a removal of mucous membrane new growths in his nasal cavity. A histological investigation revealed diffuse lymphocytes, plasma cells and 49 macrophages infiltration. Name the type of inflammation. А. *Inflammation with formation of polyps","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Inflammation with formation pointed condyloma"},{"label":"C","text":"Interstitial inflammation"},{"label":"D","text":"granulomatous inflammation"},{"label":"E","text":"Exudative inflammation"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-a5a1ef376801","stem":"A 4-year-old child presented to his physician with a cold, high temperature, nausea and vomiting. He was hospitalized and died in two days. An autopsy re- vealed thickened, dim, edematous, congested, greenish-yellow pia mater of me- ninges. What variety of exudative inflammation developed in pia maters? А. *Purulent","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Catarrhal"},{"label":"C","text":"Hemorrhagic"},{"label":"D","text":"Fibrinous"},{"label":"E","text":"Serous"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-cb0cbcd3f4a3","stem":"A young man was operated because of phimosis. Histological investigation of a removed prepuce revealed polymorphic infiltrates, consisted of randomly located plasmocytes, epithelioid and lymphoid cells. The vasculitis was diagnosed in ves- sels. What disease such changes are characteristic for? А. *Syphilis","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Tuberculosis"},{"label":"C","text":"Actinomycosis"},{"label":"D","text":"Periarteritis nodosa"},{"label":"E","text":"Lepra"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3adee156c05c","stem":"Microscopic investigation an elderly man‘s lungs revealed the foci of necrosis, surrounded by the bank of epithelioid cells and lymphocytes. Between lymphocytes and epithelioid cells the rounded giant cells, with a considerable quantity of nuclei, located on a periphery of a lesion were determined. Give the name for these changes: А. *Tuberculous granuloma","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Sarcoid granuloma"},{"label":"C","text":"Syphilitic granuloma"},{"label":"D","text":"Lepromatous granuloma"},{"label":"E","text":"Scleromatous granuloma"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ab9f59db9940","stem":"A 6-year-old child presented to department of infectious diseases with acute pain in a throat, difficulty at swallowing, rise of body temperature up to 390С and edema of neck. A gross oral investigation revealed enlarged, hyperemic tonsils, covered with plenty of yellow membranes, which intimately attached to the mucous membrane. An attempt to take off membrane results in deep, bleeding defect for- mation. What type of inflammation takes place? А. *Diphtheritic","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Purulent"},{"label":"C","text":"Serous 50"},{"label":"D","text":"Croupous"},{"label":"E","text":"Hemorrhagic"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-7ffed74926a3","stem":"A fragment of a stomach mucosa was taken for histology during endoscopy procedure. A microscopic investigation revealed intact mucous membrane, cov- ered by mucus, thickened, edematous and hyperemic with a numerous tiny hemorr- hages. Define the type of acute gastritis? А. *Catarrhal (simple)","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Erosive"},{"label":"C","text":"Fibrinous"},{"label":"D","text":"Purulent"},{"label":"E","text":"Necrotic"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1c5b5037583b","stem":"An operatively removed appendix was sent to pathology department. Macros- copical investigation revealed markedly enlarged appendix. His serous membrane was dim, congested, covered by fibrin‘s membranes. The appendix‘ walls were thickened. On a cut section pus in the lumen was detected. Microscopical investiga- tion showed a plethora of vessels, edema of all appendixes‘ layers and diffuses in- filtration by leucocytes. What is the type of inflammation? А. *Phlegmonous","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Apostematous"},{"label":"C","text":"Simple"},{"label":"D","text":"Superficial"},{"label":"E","text":"Gangrenous"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ba497a0f97ca","stem":"A 18-year-old girl had a neck lymphatic node removal at the biopsy procedure. Histological investigation showed nodules, consisted of banks of epithelioid, lym- phoid cells and large multinucleated cells (Langhans' cells), located between them. In the centers of nodes a caseous necrosis was determined. What causative agent needs to be revealed in the necrosis zone for making final diagnosis? А. *Koch‘s mycobacterium","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Mycobacterium leprae"},{"label":"C","text":"Treponema pallidum"},{"label":"D","text":"Rickettsia"},{"label":"E","text":"Fungi"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-914f82ba8d53","stem":"A young man complains of an itch and a skin reddening, which has appeared after shaving. Objectively: a cheek skin is hyperemic; the blisters, filled with a transparent liquid, were detected. What character of a liquid in blisters? А. *Serous exudate","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Transudate"},{"label":"C","text":"Purulent exudate"},{"label":"D","text":"Mucosal exudate"},{"label":"E","text":"Hemorrhagic exudate"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f6acf8f29130","stem":"A 4-year-old boy presented to a hospital with pain in a throat at swallowing and malaise. A physical examination revealed grayish - whitish membranes on a pha- rynx and tonsils on a background of moderate edema and hyperemia. These mem- 51 branes were intimately attached to tissues underneath. What pathology the de- scribed changes testify to? А. *Inflammation","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Dystrophy"},{"label":"C","text":"Necrosis"},{"label":"D","text":"Metaplasia"},{"label":"E","text":"Reganerative process"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-7e89241a8086","stem":"A 68-year-old man died from meningitis. An autopsy revealed thickened, con- gested, dim, edematous meninges (pia maters), which were saturated by creamy greenish-yellow exudate. Define the type of inflammation? А. *Purulent","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Serous"},{"label":"C","text":"Fibrinous croupous"},{"label":"D","text":"Fibrinous diphtheritic"},{"label":"E","text":"Hemorrhagic"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-eaebb0b3dbc3","stem":"Biopsy of an oral cavity‘s ulcer presented for a histological research. A micro- scopical investigation revealed areas of caseous necrosis, surrounded by plasmo- cytes, epithelioid, lymphoid cells and few giant multinuclear Pirogov-Langhans cells. There were also small vessels with signs of endo- and perivasculitis. Choose the most likely diagnosis. А. *Syphilis","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Tuberculosis"},{"label":"C","text":"Lepra"},{"label":"D","text":"Rinoskleroma"},{"label":"E","text":"Glanders (malleus)"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b5a428511192","stem":"An autopsy of 32-year-old male revealed slightly swollen and hyperemic lungs, covered with numerous millet-like grayish nodules. Histological investigation de- termined lesions consisted of lymphoid, epithelioid and Langhans giant cells. What is the most likely diagnosis? А. *Tuberculosis","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Croupous pneumonia"},{"label":"C","text":"Bronchopneumonia"},{"label":"D","text":"Interstitial pneumonia"},{"label":"E","text":"Bronchiectatic disease"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-24336b0e6429","stem":"An operatively removed appendix was sent for histological examination. Ma- croscopical investigation revealed thickened appendix. His serous membrane was dim, congested, with whitish, loose membranes; the lumen contained turbid, whi- tish-yellow exudate. Histological study showed the diffuse neutrophil‘s infiltration of the appendix wall. Choose the most likely type of appendicitis. А. *Phlegmonous","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Gangrenous C Simple"},{"label":"D","text":"Superficial 52"},{"label":"E","text":"Chronic"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-fa6055e732b5","stem":"A 17 year old boy fell seriously ill, the body temperature rose up to 38,5°C, there appeared cough, rhinitis, lacrimation, nasal discharges. What inflammation is it?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Catarrhal"},{"label":"B","text":"Purulent"},{"label":"C","text":"Fibrinous"},{"label":"D","text":"Hemorrhagic"},{"label":"E","text":"Serous"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ef5ce47619de","stem":"Histological examination of a skin tissue sampling revealed granulomas con- sisting of macrophagal nodules with lymphocytes and plasmatic cells. There are also some big macrophages with fatty vacuoles containing causative agents of a disease packed up in form of spheres (Virchow's cells). Granulation tissue is well vascularized. What disease is this granuloma typical for?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Lepra"},{"label":"B","text":"Syphilis"},{"label":"C","text":"Rhinoscleroma"},{"label":"D","text":"Tuberculosis"},{"label":"E","text":"Glanders"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a9b704a284af","stem":"A 5 year-old child is found to have meningococcal meningitis. He died of a brain edema shortly after admission to the hospital. An autopsy revealed that pia mater of a brain was thickened, opaque, green-yellowish, and edematous. Name the kind of inflammation in pia mater?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Purulent"},{"label":"B","text":"Serous"},{"label":"C","text":"Hemorrhagic"},{"label":"D","text":"Catarrhal"},{"label":"E","text":"Putrescent"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-117780bca779","stem":"An autopsy of a 34-year-old man with a medical history of rheumatic fever revealed the epicardium, covered with grayish membranes, producing shaggy pat- tern. A removal of these membranes displayed edematous plethoric epicardium. What is the most likely kind of inflammation?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Fibrinous pericarditis"},{"label":"B","text":"Purulent pericarditis"},{"label":"C","text":"Hemorrhagic pericarditis"},{"label":"D","text":"Proliferative pericarditis"},{"label":"E","text":"Catarrhal pericarditis"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-4d678dd24def","stem":"A post-mortem of a 47-years-old patient, who died of cardiopulmonary failure, revealed a cavity in his left lung. A lesion was 4 cm in diameter, with uneven walls, composed by lung tissue and filled with pus. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Acute abscess"},{"label":"B","text":"Chronic abscess"},{"label":"C","text":"Cavernous tuberculosis 53"},{"label":"D","text":"Echinococcus"},{"label":"E","text":"Diffuse fibrosing alveolitis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-cc9deda049a2","stem":"A male with purulent otitis died on the 9th day at hospital of a brain oedema. An autopsy revealed a cavity at the temporal region of his left hemisphere. A lesion had uneven rough inner walls and was filled with yellow-greenish thick fluid. The outer walls of the cavity were presented with the cerebral tissues. Name the most likely pathological process?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Acute abscess"},{"label":"B","text":"Colliquative necrosis"},{"label":"C","text":"Phlegmon"},{"label":"D","text":"Empyema"},{"label":"E","text":"Chronic abscess Immunopathological processes"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e20d934eb878","stem":"A 15 year old boy died of the heart failure. He had a history of rheumatic heart disease in his medical record. Histological investigation of the left auricle of the heart revealed the rheumatic granuloma (the Aschoff-Talalayev body) with a cen- tral fibrinous focus associated, with a perimeter plasma cells, macrophages and giant cells. Which of following best describe the type of immune response?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Cell mediated (Type IV, delayed hyper sensitivity reaction)"},{"label":"B","text":"Anaphylactic (Type I, immediate)"},{"label":"C","text":"Cytolytic (Type II, immediate)"},{"label":"D","text":"Immune complex (Type III, immediate)"},{"label":"E","text":"Reaction of transplant rejection."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-aa7387c7efa5","stem":"A 4-yers-old boy presents with multiple malformation of craniofacial bones. He died soon due to sepsis, resulted from bronchopneumonia. Blood test revealed the immunoglobulins within normal range. At autopsy the thymical aplasia was identi- fied. Name the mane cause of death.","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Cellular immunodeficiency"},{"label":"B","text":"Combined immunodeficiency"},{"label":"C","text":"Secondary immunodeficiency"},{"label":"D","text":"Acute leukemia"},{"label":"E","text":"Chronic intoxication"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-472625bef44b","stem":"A 48-year-old women with asthma presents with viral respiratory infection. The infection caused a status asthmaticus with a fatal outcome. Histological investiga- tion of lung tissue revealed a contracted bronchus and a luminal plug containing mucus and cell debris. The submucosa was edematous and contained a mixed in- flammatory infiltrate, including a lot of eosinophils and degranulated must cells. What is the mechanism of hypersensitivity presented in this case?","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Respiratory Medicine","topicOriginal":"Respiratory Medicine","subtopic":"Asthma","suggestedTopic":null,"options":[{"label":"A","text":"*Humoral immunity (Type I, anaphylactic reaction)"},{"label":"B","text":"Inflammatory reaction"},{"label":"C","text":"Autoimmune reaction"},{"label":"D","text":"Immune complex reaction (Type III of reaction) 54"},{"label":"E","text":"Cell-mediated immunity (Type IV of reaction)"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Respiratory Medicine","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-9fe51107c44c","stem":"A young man presents with the enlargement of the regional lymph nodes next to his inflamed wound. Histological investigation of the lymph node biopsy revealed the increased number of macrophages, lymphocytes and lymphoid follicules within cortex zone. Plasma cells number also increased. These alterations are most likely result of","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Antigen stimulation"},{"label":"B","text":"The acquired insufficiency of lymphoid tissue (secondary immunodeficiency state)"},{"label":"C","text":"Hereditary immunodeficiency state"},{"label":"D","text":"Neoplastic transformation"},{"label":"E","text":"Hypersensitivity reaction"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-15cc842cb6de","stem":"A newborn died after 3 days of life, as a result of a lethal outcome of intrauterine pneumonia. At autopsy a newborn is sound have a great reduction of his thymic weight and it‘s sizes. Histological investigation of thymus revealed the unclear boundary between cortex and medulla zone as a result of lymphocytes amount re- duction. A few Hassall corpuscles were found. They were focally keratinized and had concentric aggregated of epithelial cells. The gland was also exhibited lobe atrophy and sclerosis. What pattern of reaction did the thymus demonstrate?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Accidental thymus transformation (involution)"},{"label":"B","text":"Thymus atrophy"},{"label":"C","text":"Thymus hypotrophy"},{"label":"D","text":"Thymus aplasia (agenesis)"},{"label":"E","text":"Thymus neoplasia"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-2a59f4b0a30a","stem":"A 3-month-old child died because of sepsis. An autopsy revealed thymic hypop- lasia, both sizes and mass of spleen reduction. Histologically, in spleen there was lack of the periarterial follicular T-zone and remarkable absence of cells at a red spleeny pulp. Lymph nodes investigation showed also absence of cells within para- cortical (T-cells area). B-cells areas in immune system organs looked normal. What term best characterizes described above changes?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Di George‘s syndrome"},{"label":"B","text":"Combined immunodeficiency syndrome"},{"label":"C","text":"Bruton‘s disease (X-linked agammaglobulinemia)"},{"label":"D","text":"Accidental thymus transformation"},{"label":"E","text":"Acquired immunodeficiency syndrome (AIDS)"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7bfb986ab913","stem":"A morphological investigation of a kidney graft revealed a diffuse stromal infil- tration by lymphocytes, plasmocytes, lymphoblasts, plasmablasts, and also a ne- crotic arteriitis. What pathology has developed in a graft?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Immunological graft rejection"},{"label":"B","text":"Glomerulonephritis"},{"label":"C","text":"Ischemic kidney damage"},{"label":"D","text":"Tubular necroses"},{"label":"E","text":"Pyelonephritis 55"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-a378fce83ad3","stem":"An 8-year-old girl, with a history of acute tonsillitis 3 weeks before the applica- tion, presented with nephrotic syndrome (proteinuria, haematuria and cylindruria). These testify the glomerular basal membrane‘s lesion. What is the mechanism of the basal membrane pathology?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Immune complex mechanism"},{"label":"B","text":"Granulomatous mechanism"},{"label":"C","text":"Antibody-mediated mechanism"},{"label":"D","text":"Reagin-mediated mechanism"},{"label":"E","text":"Cytotoxical mechanism"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-ab843f093cfa","stem":"At 46-year-old patient with autoimmune gastritis a biopsy was taken. Histologi- cally, there was an infiltration by lymphocytes and macrophages of a gastric muc- ous membrane. What type of hypersensitivity presented in that case?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Type IY (cell-mediated hypersensitivity)"},{"label":"B","text":"Type  (reagin type)"},{"label":"C","text":"Type II (antibody-mediated cytotoxicity)"},{"label":"D","text":"Type III (immune complex cytotoxicity)"},{"label":"E","text":"Type V (granulomatous)"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-09c8143c3101","stem":"Histological investigation of a lymph node revealed a considerable quantity of the enlarged lymphoid follicles with big germinal centers, and plenty of mitotic figures. What pathology these changes are characteristic for?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Antigen stimulation with follicle hyperplasia"},{"label":"B","text":"Atrophy of lymphoid tissue"},{"label":"C","text":"Lymphosarcoma"},{"label":"D","text":"Lymphogranulomatosis"},{"label":"E","text":"Lympholeukemia"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-09ae3d44ac81","stem":"A child had a subcutaneous injection of tuberculin for a testing. Twenty-four hours later a physical examination revealed the expressed hyperemia and induration of tissues in the place of injection. What was the mechanism of these changes?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Cellular cytotoxicity"},{"label":"B","text":"Reagin cytotoxicity"},{"label":"C","text":"Antibody cytotoxicity"},{"label":"D","text":"Granulomas formation"},{"label":"E","text":"Immune complex"}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-545cb0ac19b5","stem":"A 6-year-old child had the Mantoux test. In 3 days there was an inflammatory induration and a reddening of a skin 15 mm in diameter. That was considered as the positive test. What type of hypersensitivity reaction presented in that case?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Hypersensitivity of slow type"},{"label":"B","text":"Immune complex hypersensitivity"},{"label":"C","text":"Complement-mediated cytotoxicity"},{"label":"D","text":"Hypersensitivity immediate type E."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9ff8b285d125","stem":"Physical examination of a pregnant woman with an Rh-negative blood revealed a high level of antierythrocyte antibodies. The cutaneous flap of her Rh-positive 56 husband applied for depression of antibodies. In 2 weeks a flap was rejected. Mi- croscopical investigation showed a disturbance of blood circulation, edema and cellular infiltration mainly by lymphocytes, neutrophils and macrophages. What is the most probable pathology?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Transplantation immunity"},{"label":"B","text":"Hypersensitivity reaction immediate type"},{"label":"C","text":"Hypersensitivity reaction slow type"},{"label":"D","text":"Granulomatous inflammation"},{"label":"E","text":"Interstitial inflammation"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-86756d58b6be","stem":"A 3-year-old child died of an acute destructive staphylococcal pneumonia. Ma- croscopically, thymus mass reduced to 3,0 gr. Microscopical investigation of thy- mus showed reduction of lobules, considerable decline of lymphocytes quantity, stromal collapse, and inversion of layers with cystic enlargement of the Hassall‘s bodies. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Accidental thymus involution"},{"label":"B","text":"Thymomegaly"},{"label":"C","text":"Thymus hypoplasia"},{"label":"D","text":"Thymus dysplasia"},{"label":"E","text":"Thymus agnenesia"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5f745c7892c5","stem":"The experiment animal with a history of previous sensibilization received the next subcutaneous dose of antigen. In the place of injection a fibrinous inflamma- tion with alteration of vessels walls, matrix and fiber structures of connective tissue (mucoid and fibrinoid swelling) and fibrinoid necrosis developed. What immuno- logical reaction takes place?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Hypersensitivity reaction immediate type"},{"label":"B","text":"Hypersensitivity reaction slow type"},{"label":"C","text":"Reaction of transplantation immunity"},{"label":"D","text":"Normergic reaction"},{"label":"E","text":"Granulomatosis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-bb3dab5b84ac","stem":"A man with a history of bronchial asthma died of asphyxia. Microscopical in- vestigation of lungs revealed excess of mucus with lots of eosinophils in the bron- chial lumen, sclerosis of interalveolar septas and alveoli dilatation. What mechan- ism of hypersensitivity reaction presented in that case?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Reagin reaction"},{"label":"B","text":"Cytotoxic reaction"},{"label":"C","text":"Immune complex reaction"},{"label":"D","text":"Cytolysis, conditioned by lymphocytes"},{"label":"E","text":"Granulomatosis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3c7ee8283e81","stem":"The infiltration anesthesia by ultracain with adrenaline solution has been done to a young man. Then redness, edema of the skin with itchy blisters suddenly de- veloped. What type of hypersensitivity took place?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Anaphylaxis"},{"label":"B","text":"Cytotoxicity"},{"label":"C","text":"Immune complex damage 57"},{"label":"D","text":"Hypersensitivity slow type"},{"label":"E","text":"Granulomatosis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-0e26bdfac6d1","stem":"A 33-year-old patient with a history of acute tonsillitis presented with the uri- nary syndrome (haematuria, proteinuria and leukocyturia). Kidneys biopsy revealed an intracapillary proliferative glomerulonephritis. Electronic microscopy deter- mined large subepithelial deposits. What is the pathogenesis of this disease?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Immune complex mechanism"},{"label":"B","text":"Atopy"},{"label":"C","text":"Cytotoxic, cytolytic action of antibodies"},{"label":"D","text":"Cellularally caused cytolysis"},{"label":"E","text":"Granulomatosis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f765c08925a6","stem":"A 10-month-old child has developed pneumonia. Clinical and laboratory tests revealed absence of mature B-lymphocytes in peripheral blood and in B-zones of lymph nodes, acute reduction of immunoglobulins in serum. In peripheral blood a total quantity of lymphocytes was normal. What kind of an immunodeficiency de- veloped in that case?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Brutone sindrome"},{"label":"B","text":"Neselof syndrome"},{"label":"C","text":"Severe combined immunodeficiency"},{"label":"D","text":"Di-George syndrome"},{"label":"E","text":"Viskotta-Oldrich syndrome"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5c6bdcb1d41a","stem":"A patient with a history of serious radioactive irradiation had bone marrow transplantation. In 2 months a rush on the skin and diarrhea developed. Clinical and laboratory tests showed hepatic insufficiency, local necrosis of the skin‘s epithelial cells, intestinal crypts and liver parenchymal cells. What was the reason for symp- toms aggravation?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Abdomen","topicOriginal":"Abdomen","subtopic":"Intestin","suggestedTopic":null,"options":[{"label":"A","text":"* ‖Graft against the owner‖ disease"},{"label":"B","text":"Sepsis development"},{"label":"C","text":"An acute graft rejection"},{"label":"D","text":"A chronic graft rejection"},{"label":"E","text":"An exacerbation of a chronic hepatitis"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Abdomen","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-405e8bbdf387","stem":"A 7-month-old child died of severe pneumonia complicated by sepsis. A post- mortem revealed an absence of thymus. In lymph nodes there were no lymphoid follicles and cortical substance, in a spleen follicles were markedly reduced, ger- minal centers were absent. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Thymus agenesia"},{"label":"B","text":"Thymus aplasia"},{"label":"C","text":"Thymus atrophy"},{"label":"D","text":"Thymus hypoplasia"},{"label":"E","text":"Acidental thymus involution"}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic","subject_suggestion_available"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_suggestion_available","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-33d68eb5115b","stem":"A 1-year-old child died of a relapsing pneumonia. A post-mortem revealed hy- poplasia of a thymus and peripheral lymphoid tissue, atrophy of cerebellum cortex, 58 angiotelectasis of bulbar conjunctiva. Immunohistochemistry revealed decreased level of immunoglobulins. What is the most likely disease?","type":"Single Best Answer MCQ","subject":"Neurology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Louis-Bar‘s syndrome"},{"label":"B","text":"Di-George syndrome"},{"label":"C","text":"Nezelof syndrome"},{"label":"D","text":"West‘s syndrome"},{"label":"E","text":"Brutone syndrome"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Neurology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-fff11ae045b6","stem":"A 20-year-old woman died of postnatal sepsis. A post-mortem revealed en- larged congested spleen with abundant curettage from a cut section. Microscopical investigation showed hyperplasia and infiltration by plasmocytes of the red pulp and spleen‘s follicles. The red pulp was also rich with macrophages. What patholo- gy resulted in spleen‘s alteration?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Antigenic stimulation of an organism"},{"label":"B","text":"Hereditary insufficiency of a peripheric lymphoid tissue"},{"label":"C","text":"Reaction of hypersensitivity of immediate type"},{"label":"D","text":"Reaction of hypersensitivity of the slowed type"},{"label":"E","text":"Autoimmunization"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-28d2ff2999e2","stem":"Microscopical investigation of arterioles showed plasmatic saturation, mucoid and fibrinoid swelling, fibrinoid necrosis of walls, diffuse infiltration by lympho- cytes, plasmocytes and monocytes. In addition, the focal proliferation of hysti- ocytes, endotheliocytes and pericytes were determined. The final diagnosis was the ―periarteritis nodosa‖. What type of inflammation took place in arterioles?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Acute immune inflammation"},{"label":"B","text":"Acute not immune inflammation"},{"label":"C","text":"Focal exudative inflammation"},{"label":"D","text":"Diffusive exudative inflammation"},{"label":"E","text":"Fibrinous inflammation"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-c3c95fcad2c3","stem":"During operation of kidney transplantation in 15 minutes after vascular anasto- moses application, transplant became flabby, cyanotic and spotty; the pulsation was absent. Microscopical investigation of a kidney specimen revealed periendothelial accumulation of neutrophils in glomeruli vessels. In addition there were also a thrombosis and necrosis of some glomeruli. Specify the type of graft rejection.","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Hyperacute rejection"},{"label":"B","text":"Accelerated rejection"},{"label":"C","text":"Acute intersticial rejection"},{"label":"D","text":"Acute vascular rejection"},{"label":"E","text":"Chronic rejection"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-41fb28195da6","stem":"A 30 year old woman has applied a lipstick with a fluorescent substance for a long time. Then she got a limited erythema and slight peeling on her lip border, later there appeared transversal striae and cracks. Special methods of microscopic examination of the affected area helped to reveal sensibilized lymphocytes and ma- crophages in the connective tissue; cytolysis. What type of immunological hyper- sensitivity was developed? 59","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*IV type (cellular cytotoxicity)"},{"label":"B","text":"I type (reaginic)"},{"label":"C","text":"III type (immune complex cytotoxicity)"},{"label":"D","text":"II type (antibody cytotoxicity)"},{"label":"E","text":"Granulomatosis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-d4dc86f9424a","stem":"48 hours after tuberculine test (Mantoux test) a child had a papule 10 mm in diameter on the spot of tuberculine injection. What hypersensitivity mechanism underlies these changes?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Cellular cytotoxicity"},{"label":"B","text":"Granulomatosis"},{"label":"C","text":"Antibody-dependent cytotoxicity"},{"label":"D","text":"Anaphylaxy"},{"label":"E","text":"Immunocomplex cytotoxicity Adaptation and compensation."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5c364dc2c2d9","stem":"A young male complains of diminishing leg muscles in size and volume as a result of the complicated femoral fracture. The innervations of the muscles was not lost. Name the type of atrophy?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Lower Limb","topicOriginal":"Lower Limb","subtopic":"Leg","suggestedTopic":null,"options":[{"label":"A","text":"*Disuse atrophy"},{"label":"B","text":"Degeneration atrophy"},{"label":"C","text":"Ischemic atrophy"},{"label":"D","text":"Atrophy due to compression"},{"label":"E","text":"Atrophy due to chemical and physical influence."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Lower Limb","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-afe89f4dabf8","stem":"At autopsy a male is found to have big kidneys with marked dilatation of the renal pelvis and calyces filled with transparent liquid. A thinning of the renal pa- renchyma accompanied above lesions. Which is the most likely finding?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Pelvis and Perineum","topicOriginal":"Pelvis and Perineum","subtopic":"Pelvi","suggestedTopic":null,"options":[{"label":"A","text":"*Hydronephrosis"},{"label":"B","text":"Glomerulonephritis"},{"label":"C","text":"Amyloidosis"},{"label":"D","text":"Tuberculosis"},{"label":"E","text":"Pyelonephritis"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Pelvis and Perineum","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-db99a8567e6c","stem":"An autopsy of an elderly male revealed the atherosclerosis of the brain arteries accompanied with the thinning of the brains cortex. Name the cause of the atrophy?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Ischemia"},{"label":"B","text":"Compression"},{"label":"C","text":"Chemical and physical factors"},{"label":"D","text":"Loss of innervations"},{"label":"E","text":"Decreased workload"}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-e007ec7acf10","stem":"A 62-yer-old male died at the hospital after developing heart failure. At autopsy the weight of the heart was 500gm, with thickened right ventricular wall and di- lated chamber. Name the alteration at the right ventriculum.","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Hypertrophy"},{"label":"B","text":"Hyperplasic alteration due to inflammation 60"},{"label":"C","text":"Metaplasia"},{"label":"D","text":"Atrophy"},{"label":"E","text":"Sclerosis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-1beb3849a06c","stem":"A young male presents with a large and lacerated wound covered with pus. The peripheral zone of the tissue defect was filled with large amount of granulation tis- sue. Name the type of healing?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Trauma and Emergency Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Trauma and Emergency Surgery","options":[{"label":"A","text":"*Healing by first intention"},{"label":"B","text":"Healing by second intention"},{"label":"C","text":"Healing under a scab"},{"label":"D","text":"Covering a tissue defect with epithelial cells"},{"label":"E","text":"Organization followed by scarring"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Trauma and Emergency Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-cd4397a3f5f9","stem":"An autopsy revealed marked enlargement of a kidney. Gross examination of a kidney‘s section presented with dilation of both renal pelvis and calyces resulted from renal stones. What from diagnoses is most faithful?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Pelvis and Perineum","topicOriginal":"Pelvis and Perineum","subtopic":"Pelvi","suggestedTopic":null,"options":[{"label":"A","text":"*Hydronephrosis"},{"label":"B","text":"Simple cysts"},{"label":"C","text":"Pyelonephritis"},{"label":"D","text":"Benign nephrosclerosis"},{"label":"E","text":"Polycystic kidney disease"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Pelvis and Perineum","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d0ddf723af97","stem":"A physical investigation of an elderly man with history of esophagus cancer with stenosis but without metastasis revealed an atrophy of skeletal muscles and subcu- taneous fat tissue. Skin was grayish-brown color, an epidermis was thinned, and size of the heart decreased. Myocardium and liver also had a brown coloring. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"*Alimentary cachexia."},{"label":"B","text":"Myasthenia."},{"label":"C","text":"Cancer cachexy"},{"label":"D","text":"Brown atrophy."},{"label":"E","text":"The Addisona Illness"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d60fd37d73fa","stem":"At the man with long history of smoking the bronchial biopsy is taken. Micro- scopical investigation showed the thickened mucous membrane with chronic in- flammation and transformation of ciliated epithelium into stratified one. What pa- thology such changes are characteristic for?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Metaplasia"},{"label":"B","text":"Hyperplasia of epithelium С. Planocellular cancer"},{"label":"D","text":"Leukoplakia"},{"label":"E","text":"Hypertrophy of epithelium"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e5e4c2278ace","stem":"A patient with a history of frequent hemorrhoid bleeding died of acute myocar- dial infarction. A post-mortem revealed a red, succulent bone marrow of a hip dia- physis. What pathology developed in a bone marrow?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Lower Limb","topicOriginal":"Lower Limb","subtopic":"Hip","suggestedTopic":null,"options":[{"label":"A","text":"*Compensatory hyperplasia"},{"label":"B","text":"Vicarious hypertrophy 61"},{"label":"C","text":"Hypertrophy excrescences"},{"label":"D","text":"Hormonal hyperplasia"},{"label":"E","text":"Work hypertrophy"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Lower Limb","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-ff79b31d87d6","stem":"A 59-year-old patient with a history of prostate glandular hyperplasia operated in the urology. An operation revealed a thickening of a urinary bladder wall up to 1 cm. It may be caused by","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Work hypertrophy"},{"label":"B","text":"Vicarious hypertrophy"},{"label":"C","text":"Hormonal hypertrophy"},{"label":"D","text":"Hormonal hyperplasia"},{"label":"E","text":"Protective hyperplasia"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1303fa94eacf","stem":"A 7-year-old child presented with a poliomyelitis. His somatic muscles are weak, their volume is reduced, and skin is dry and pale. Choose the most likely pathology, which takes place in the soft tissues?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"*Atrophy."},{"label":"B","text":"Hypertrophy."},{"label":"C","text":"Hyperplasia."},{"label":"D","text":"Metaplasia."},{"label":"E","text":"Hypoplasia."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-145a324ae826","stem":"An elderly man with a long history of smoking presented with a cough accom- panied by viscid mucous sputum, weakness after the insignificant physical activity and pale color of the skin. He lost 12,0 kg of weight for the last two months. Mi- croscopical investigation of endoscopic biopsy showed squamous cell carcinoma. What pathology preceded the tumor formation?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Metaplasia."},{"label":"B","text":"Hypoplasia."},{"label":"C","text":"Hyperplasia."},{"label":"D","text":"Necrosis."},{"label":"E","text":"Sclerosis."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-a006e3ae11fb","stem":"A 48-year-old patient with a history of a hypertensive disease died of heart fail- ure. An autopsy revealed an enlarged heart with dilated chambers. A thickness of the left ventricle wall was 2,5cm. Microscopically myocardial cells were consider- ably enlarged, with fatty dystrophy and hyperchromic barrel-shaped nuclei. What is the most likely pathology diagnosed in a heart?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Excentric hypertrophy"},{"label":"B","text":"Myocarditis"},{"label":"C","text":"Concentric hypertrophy"},{"label":"D","text":"Angiogenic cardiosclerosis"},{"label":"E","text":"Cardiomyopathy"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3b3520dcb660","stem":"A 60-year-old man has a history of chronic bronchitis. Histological investiga- tion of bronchus biopsy showed thinned mucous membrane, cystic transformation of mucous glands, and replacement of prismatic epithelium on stratified one. What of the listed pathological processes the most likely? 62","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Metaplasia."},{"label":"B","text":"Hyperplasia."},{"label":"C","text":"Heterotopia."},{"label":"D","text":"Heteroplasia."},{"label":"E","text":"Displasia."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-23b507b66c4e","stem":"Microscopical investigation of tissue from the edge of a chronic gastric ulcer showed necrosis, granulation tissue, abundant development of connective tissue and metaplasia of epithelium. What type of pathology takes place in that case?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Pathological regeneration with disorder of phases."},{"label":"B","text":"Hypertrophy."},{"label":"C","text":"Physiology regeneration."},{"label":"D","text":"Reparative regeneration (substitution)."},{"label":"E","text":"Reparative regeneration (restitution)."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-53579c2b19e0","stem":"At a patient with a chronic cystitis biopsy of urinary bladder mucosa was taken. Microscopical investigation revealed a transitional epithelium with foci of stratified epithelium without keratinization. What process underlies the described changes in an epithelium?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Metaplasia"},{"label":"B","text":"Dystrophy"},{"label":"C","text":"Hyperplasia"},{"label":"D","text":"Dysplasia"},{"label":"E","text":"Hyperkeratosis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-28ba83203a78","stem":"After traumatic damage of a liver, subsequently there was complete hepatic structural and functional restoration. Name the type of regeneration?","type":"Single Best Answer MCQ","subject":"Emergency Medicine","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Restitution"},{"label":"B","text":"Incomplete regeneration"},{"label":"C","text":"Pathological regeneration"},{"label":"D","text":"Physiological regeneration"},{"label":"E","text":"Substitution"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Emergency Medicine","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ccaa09dc33ba","stem":"At a patient with chronic bronchitis biopsy of bronchus mucous membrane was taken. Microscopical investigation revealed the areas of stratified epithelium with- out keratinization. What pathology takes place in the mucous membrane of bron- chus?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Metaplasia"},{"label":"B","text":"Atrophy"},{"label":"C","text":"Hyperplasia"},{"label":"D","text":"Dysplasia E."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0031ee279300","stem":"A 42-year-old woman presented to the gynecologist with acyclic, profuse he- morrhagic discharge. A histological investigation of a curettage material revealed increased quantity of glands and their cystic dilation. What is the most likely diag- nosis?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Endometrial hyperplasia 63"},{"label":"B","text":"Endometrial atrophy"},{"label":"C","text":"Endometrial hypertrophy"},{"label":"D","text":"Metaplasia"},{"label":"E","text":"Organization"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-e86e9b8cf66b","stem":"A post-mortem of a 64-year-old woman with a long story of hypertensive dis- ease revealed considerably diminished, dense kidneys with a fine-grained surface. What pathology such changes are characteristic for?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Blood insufficiency atrophy"},{"label":"B","text":"Atrophy from pressure"},{"label":"C","text":"Senile atrophy"},{"label":"D","text":"Dysfunctional atrophy"},{"label":"E","text":"Hypoplasia"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7646d300869c","stem":"An elderly man died of cardiac insufficiency. Twenty years ago he had the right lung pulmonectomy because of a cyst. A post-mortem revealed an enlarged left lung. Diagnose pathology in the left lung.","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Vicarious hypertrophy"},{"label":"B","text":"Neurohumoral hypertrophy"},{"label":"C","text":"Dysfunctional atrophy"},{"label":"D","text":"Dyscirculatory atrophy"},{"label":"E","text":"Neurotic atrophy"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8458a8b11ad6","stem":"A 42-year-old man had a lower extremity amputation. After a while painful knots appeared in a stump. Microscopical investigation revealed amputation neu- romas. What pathology such changes are characteristic for?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Pathological regeneration"},{"label":"B","text":"Complete reparative regeneration"},{"label":"C","text":"Inflammation"},{"label":"D","text":"Incomplete reparative regeneration"},{"label":"E","text":"Metaplasia"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-194ef1a0887e","stem":"A 38-year-old woman presented with complaints about the frequent uterine bleeding. The diagnostic curettage was performed. A histological investigation of a curettage material revealed increased quantity of coiled glands, some of them were with cystic dilation. What pathology these changes are characteristic for?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Glandular-cystic hyperplasia."},{"label":"B","text":"Atrophy"},{"label":"C","text":"Metaplasia"},{"label":"D","text":"Dysplasia"},{"label":"E","text":"Hypertrophic vegetations"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-bd9663e60a29","stem":"A man had the right lung pulmonectomy because of a tumor 7 years ago. Then the volume of the left lung increased on 40%. What process developed in the left lung?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Vicarious hypertrophy"},{"label":"B","text":"Neurohumoral hypertrophy"},{"label":"C","text":"False hypertrophy 64"},{"label":"D","text":"Work hypertrophy"},{"label":"E","text":"Hypertrophic vegetation"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-8237ab26e1b4","stem":"A histological investigation of an endometrium revealed coiled extended glands with ̳saw-‘ and a ̳spin-like‘ pattern. A stromal proliferation with hyperplasia of its cells was also determined. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Glandular hyperplasia of endometrium"},{"label":"B","text":"Acute endometritis"},{"label":"C","text":"Leiomyoma"},{"label":"D","text":"Hydatidiform mole"},{"label":"E","text":"Placental polyp"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-3a5774bad924","stem":"A patient presented with small knots on a thin peduncle in his rectum. Micro- scopical investigation of the biopsy material revealed a growth of connective tissue and glands. What is the most likely pathology?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Hyperplastic polyp."},{"label":"B","text":"Hypertrophy."},{"label":"C","text":"Metaplasia."},{"label":"D","text":"Atrophy."},{"label":"E","text":"Sclerosis."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b5129c7e013d","stem":"The biopsy of central bronchus mucosa of miner is taken. Microscopically, there is a transformation of a cylindrical epithelium to the mature stratified one. What pathology such changes are characteristic for? А.* Metaplasia В. Hyperplasia","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"C","text":"Leucoplakia"},{"label":"D","text":"Dysphasia"},{"label":"E","text":"Reparative regeneration"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-08d96f8a2aca","stem":"The biopsy of a vaginal portion of uterus cervix is taken. There is an augmenta- tion of quantity of cells, rising of mitotic activity and alteration of polarity of cells in basal part of an epithelial layer. What pathology such changes are characteristic for?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Dysphasia"},{"label":"B","text":"Metaplasia"},{"label":"C","text":"Atrophy"},{"label":"D","text":"Acantosis"},{"label":"E","text":"Hyperplasia"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-f85aad91f940","stem":"A 40-year-old man has a keloid scar after a treatment of the left arm burn. This process may be an example of","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Trauma and Emergency Surgery · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Trauma and Emergency Surgery","options":[{"label":"A","text":"*Pathologic regeneration"},{"label":"B","text":"Hyperplasia"},{"label":"C","text":"Metaplasia"},{"label":"D","text":"Reparative regeneration"},{"label":"E","text":"Vicarious hypertrophy"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Trauma and Emergency Surgery · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b929047e438c","stem":"A 70-years-old patient admitted to a hospital with acute lung abscess. He sud- 65 denly died of progressing cardiopulmonary failure shortly after admission. An au- topsy revealed an enlargement of mediastinal lymph nodes. They were pink-reddish and elastic. A spleen was enlarged and flabby with plentiful scrape of a pulp. What was the cause of lymph node and spleen‘s alterations?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"*Protective hyperplasia"},{"label":"B","text":"Compensatory hypertrophy"},{"label":"C","text":"Hormonal hyperplasia"},{"label":"D","text":"Venous congestion"},{"label":"E","text":"Purulent inflammation"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-dcc0b63bdc2d","stem":"A 70-year-old patient had a surgery due to severe prostatic hyperplasia. A sur- gery revealed a thickening of urinary bladder‘s wall up to one cm. What is the most likely cause of this thickening?","type":"Single Best Answer MCQ","subject":"General Surgery","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Workload hypertrophy"},{"label":"B","text":"Vicarious hypertrophy"},{"label":"C","text":"Hormonal hypertrophy"},{"label":"D","text":"Hormonal hyperplasia"},{"label":"E","text":"Compensatory hypertrophy"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Surgery","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d88ef050c7d2","stem":"A patient with a long history of the chronic cystitis had a cystoscopy and biopsy was performed. Histological examination of biopsy material revealed chronic cysti- tis and foci of transitional epithelium replaced by squamous - cell non - keratinized epithelium. These foci were the manifestations of","type":"OSCE / Practical Station","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Metaplasia"},{"label":"B","text":"Degeneration"},{"label":"C","text":"Hyperplasia"},{"label":"D","text":"Dysplasia"},{"label":"E","text":"Hyperkeratosis Epithelium neoplasms"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6f332033b06e","stem":"A teenager male presents with slowly enlarging, painless nodule on his right hand‘s skin. Microscopic examination of removed lesion revealed an increased number of epithelial layers, with a stroma underneath, with developed a papillo- matous pattern. Identify most likely type of atypia?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Tissue"},{"label":"B","text":"Cellular."},{"label":"C","text":"Metabolic."},{"label":"D","text":"Functional."},{"label":"E","text":"Hystochemical"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d59fa3e51296","stem":"A 35 year-old female with a family history of colon cancer inquires about screening. Colonoscopy revealed a tumor and a tissue sample was taken for histol- ogy. Microscopic investigation has shown cells were arranged in glandular-like pattern. They exhibit cell pleomorphism, atypia, invasive growth and pathologic mitosis‘s. What is the most likely diagnose?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Adenocarcinoma 66"},{"label":"B","text":"Basal-cell carcinoma"},{"label":"C","text":"Solid carcinoma"},{"label":"D","text":"Mucous carcinoma"},{"label":"E","text":"Undifferentiated carcinoma"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-69da2aa653e0","stem":"A 50-year-old female is found to have a urinary bladder neoplasm. Biopsy inves- tigation revealed that tumor consists of thin, branching out papillae, covered with few layers of transitional cell epithelium. What is the most likely diagnose?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Papilloma"},{"label":"B","text":"Basal cell"},{"label":"C","text":"Transitional cell carcinoma"},{"label":"D","text":"Squamous cell carcinoma"},{"label":"E","text":"Fibroadenoma"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-57885d4eeed9","stem":"A 60-year-old postmenopausal woman has been feel unhealthy and weak for about 3 month. A gross investigation of her cervix uteri revealed a lesion and a biopsy from this area was obtained. Microscopically, a lesion composed of atypical squamous cell, many of them displayed pathological mitoses. Keratin pearl forma- tion was also observed histologically. What is the most likely diagnose?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Squamous cells carcinoma with keratinisation"},{"label":"B","text":"Transitional cell carcinoma"},{"label":"C","text":"Squamous cells without keratinisation"},{"label":"D","text":"Adenocarcinoma"},{"label":"E","text":"Anaplastic carcinoma"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6fafdd69c133","stem":"A 48-year-old woman complains to her doctor of uterine bleeding. Endometrial biopsy investigation revealed a presence of gland-forming cells with enlarged hyperchromic nuclei, cell atypia, abnormal mitoses. These cells were also deter- mined at myometrium. What term most correctly identifies this pathological process?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Adenocarcinoma of uterus."},{"label":"B","text":"Adenomatous endometrial hyperplasia."},{"label":"C","text":"Acute endometritis."},{"label":"D","text":"Placental polyp."},{"label":"E","text":"Chorionepitelioma of uterus."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-4c98d4ca7d01","stem":"A 39-year-old woman presented in oncology with a stomach cancer. Physical investigation revealed metastatic tumors in ovaries (Krukenberg tumors). What is most likely pattern of spread in that case?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Lymphatic retrograde"},{"label":"B","text":"Lymphatic orthograde"},{"label":"C","text":"Gematogenous"},{"label":"D","text":"Implantation"},{"label":"E","text":"Along epithelium-lined surfaces"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-4d9561dd7c72","stem":"A 23-year-old female decided to have a surgeon‘s removal of a small nodule at her leg‘s skin. An operation material delivered to pathology department. A histological examination of a new growth has shown that parenchyma has been 67 formed of integumentary epithelium with an increased amount of layers. Stroma together with epithelial proliferation forms papillae. What is the most likely form of atypism?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Tissue."},{"label":"B","text":"Cellular."},{"label":"C","text":"Histochemical."},{"label":"D","text":"Functional."},{"label":"E","text":"Metabolic."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-01bb33174c34","stem":"A 45-year old male with a family history of a gastric cancer inquires about screening. A gastroscopic examination of a patient revealed a pedunculated tumor mass 1.5 cm in diameter in the area of the lesser curvature of stomach. What kind of growth does the tumor have?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Exophytic."},{"label":"B","text":"Expansive."},{"label":"C","text":"Infiltrating."},{"label":"D","text":"Appositional."},{"label":"E","text":"Endophytic."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-bd0d271beac7","stem":"A 70 year-old male is found to have a nodule at his right bronchus mucous membrane. A microscopic examination of the biopsy material from the tumor re- vealed the cell and tissue atypism, keratin pearls formation. What is the most likely pathologic process at biopsy material?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Malignant tumor."},{"label":"B","text":"Benign tumor."},{"label":"C","text":"Hyperplasia."},{"label":"D","text":"Metaplasia."},{"label":"E","text":"Hypoplasia."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-572ecd7878ea","stem":"A 57-year-old postmenopausal woman is found to have a chronic nonhealing lesion at her portio vaginalis uteri.A biopsy was taken form this area. A histological examination of the biopsy material revealed a cellular atypism within epithelial layer, but basic membrane was unchanged. What is the most likely diag- nosis?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Carcinoma in situ."},{"label":"B","text":"Erosion."},{"label":"C","text":"Adenocarcinoma."},{"label":"D","text":"Papilloma."},{"label":"E","text":"Endometriosis."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d33649e1ce5e","stem":"A 15-year-old boy is found to have a small, dense, nodule at his right forearm skin. Grossly it had a papillary surface, which looked like a cauliflower. Micro- scopically, the tumor consists of many papillae. Parenchyma formed of integumen- tary epithelium with an increased amount of layers. The polarity of epithelial cells, their stratification and membrane wholeness are preserved. A connective tissue forms a stroma within a center of papillae. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Papilloma. 68"},{"label":"B","text":"Fibroma."},{"label":"C","text":"Adenoma."},{"label":"D","text":"Fibroadenoma."},{"label":"E","text":"Cystadenoma."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-10b1d2ed292a","stem":"A 66-year old male lost his appetite and has been loosing his weight for about 5 months. X-ray study revealed a stomach neoplasm. Histological examination of a tumor‘s biopsy showed a great amount of signet-ring cells. Name the histological variant of cancer.","type":"Radiological Interpretation","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Adenocarcinoma."},{"label":"B","text":"Solid carcinoma."},{"label":"C","text":"Sarcoma."},{"label":"D","text":"Mucinous carcinoma."},{"label":"E","text":"Carcinoid."}],"priority":1,"status":"review","flags":["topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-ce82b90cf161","stem":"A 45-year-old woman has a small tumor of her left breast. Histological exami- nation of a breast biopsy revealed poorly differentiated atypical epithelial cells. They formed trabecules separated from one another by connective tissue. The cells and stroma proportion was approximately 1:1.What is the most likely histological variant of the cancer.","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Solid carcinoma."},{"label":"B","text":"Adenocarcinoma."},{"label":"C","text":"Epidermoid carcinoma."},{"label":"D","text":"Sccirrhous fibrocarcinoma."},{"label":"E","text":"Small cell carcinoma."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0531e4b8a477","stem":"Histological investigation of a node in the removed mammary gland revealed complexes of atypical polymorphic epithelial cells, which had various sizes and forms. There were clear spaces at the centers of complexes. The cells had large nuclei, with presence of atypical mitoses. Diagnose the pathology.","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Adenocarcinoma"},{"label":"B","text":"Squamous cell nonkeratinous carcinoma"},{"label":"C","text":"Solid carcinoma"},{"label":"D","text":"Fibroadenoma of breast"},{"label":"E","text":"Nondifferentiated polymorphocellular carcinoma"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-447d6bbdb468","stem":"A microscopical investigation of a tumour revealed signet-ring cells. Name a histological variant of a cancer.","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Mucinous carcinoma"},{"label":"B","text":"Adenocarcinoma"},{"label":"C","text":"Sarcoma"},{"label":"D","text":"Solid carcinoma"},{"label":"E","text":"Carcinoid"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-77159fd60794","stem":"A 34-year-old woman presented with a hoarseness of a voice. A laryngoscopy revealed a tumour of a larynx. The neoplasm had a grey-white color and papillary surface. Microscopical investigation showed a new growth of a connecting tissue, 69 covered by a stratified epithelium with the marked keratinization. Cellular atypia was absent. Most likely the tumor is","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Papilloma"},{"label":"B","text":"Fibroma"},{"label":"C","text":"Polyp"},{"label":"D","text":"Angioma"},{"label":"E","text":"Angiofibroma"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-d951f38fad52","stem":"A microscopical investigation of a 50-year-old woman‘s endometrial curettage material with the clinical diagnosis « ovarian – menstrual cycle‘s disorder » re- vealed growth of glandular structures. These glands consisted of polymorphic cells with hyperchromic nuclei and mitoses figures. For what pathology the revealed histological changes are characteristic?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Adenocarcinoma of uterus"},{"label":"B","text":"Placental polyps"},{"label":"C","text":"Acute endometritis"},{"label":"D","text":"Glandular hyperplasia of endometrium"},{"label":"E","text":"Chorioepithelioma of uterus"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-eee9fe28006b","stem":"A 52-year-old female patient with a history of the chronic bronchitis and pneu- mosclerosis presented to the hospital for biopsy diagnostics. A microscopical inves- tigation of a left bronchial‘s mucous from the suspicious site revealed cellular and tissue atypia. There were also found some structures in the form of‖ cancer pearls‖. What is the most likely pathology presented in that case?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Squamous cell keratinous carcinoma of bronchus"},{"label":"B","text":"Chronic polypous bronchitis"},{"label":"C","text":"Bronchiectasis"},{"label":"D","text":"Sharp bronchitis"},{"label":"E","text":"Squamous cell metaplasia of mucous of bronchus"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a3ae60a8353e","stem":"Histological investigation of a bronchial biopsy revealed a tumour which is constructed from nests of stratified epithelium‘s atypical cells with some characte- ristic \"pearls\". What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Squamous cell keratinous carcinoma"},{"label":"B","text":"Squamous cell nonkeratinous carcinoma"},{"label":"C","text":"Solid carcinoma"},{"label":"D","text":"Mucous carcinoma"},{"label":"E","text":"Scirrhous carcinoma"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b99665cfadca","stem":"A microscopical investigation of a breast tumour revealed that the neoplasm was constructed of undifferentiated atypical epithelial cells. These cells formed trabecules, separated by layers of a connective tissue. A parity of cells and stroma was approximately 1:1. Name a histological variant of a cancer.","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Solid carcinoma"},{"label":"B","text":"Adenocarcinoma"},{"label":"C","text":"Squamous cell carcinoma"},{"label":"D","text":"Fibrocarcinoma 70"},{"label":"E","text":"Small cell carcinoma"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-19a6cd485509","stem":"Histological investigation of the removed breast node revealed different sizes and the form complexes of atypical polymorphic epithelial cells among abundant stroma. The complexes had a clear space center. Cells were characterized by large nuclei, the increased number of nucleoli, nucleoli organizers and presence of atypi- cal mitoses. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Adenocarcinoma"},{"label":"B","text":"Fibroadenoma of breast"},{"label":"C","text":"Solid carcinoma"},{"label":"D","text":"Squamous cell nonkeratinous carcinoma"},{"label":"E","text":"Nondifferentiated polymorphic cells carcinoma"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d87ff2b39bf6","stem":"A post-mortem of a 59-year-old man, who died of a lung cancer, revealed plural metastases. What kind from the listed below metastases it is possible to regard as implantation (contact) one according to a mechanism of development?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Multiple tumorous nodules of pleura"},{"label":"B","text":"Metastasis in prebronchial, paratracheal lymphatic knots"},{"label":"C","text":"Metastasis in a brain"},{"label":"D","text":"Metastases in an adrenal gland"},{"label":"E","text":"Invasion of tumor from bronchus in an esophagus"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-baa873ea4db2","stem":"A 55-year-old man presented to a hospital with the atelectasis of a right lung‘s middle lobe, resulted from the obturation of a midlobar bronchus by a node of soft tissues. A bronchoscopy revealed a new growth within an obturation zone. A mi- croscopical investigation of a biopsy sample showed the growths of an atypical glandular epithelium with pathological mitoses, which spread in tissues underneath and a cartilage. What is the most likely disease?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Bronchogenic carcinoma of lungs"},{"label":"B","text":"Dysplasia of epithelium of bronchus"},{"label":"C","text":"Inflammatory polyps"},{"label":"D","text":"Deforming bronchitis"},{"label":"E","text":"Sarcoma of bronchus"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1560d8fc4a6a","stem":"A 65-year-old woman presented to the hospital with the menopausal bleeding. At histological investigation revealed in the curettage material from the mucosa of her cervix uteri revealed a new growth of atypical epithelium with formation so- called \" cancer pearls \". What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Squamous cell keratinous carcinoma"},{"label":"B","text":"Adenocarcinoma C Squamous cell nonkeratinous carcinoma"},{"label":"D","text":"Mucous cancer"},{"label":"E","text":"Nondifferentiated carcinoma"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9e4cf3148aab","stem":"A post-mortem of a 48-year-old woman with a history of an operated stomach tumour in the past revealed markedly enlarged, dense, whitish color ovary. Histo- logical investigation of the ovarian tissue showedutterly atypical epithelial cells, 71 placed among layers and cords of a connective tissue. What if the most likely dis- ease? А. *Krukenberg's carcinoma of ovary","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Serous cystadenocarcinoma"},{"label":"C","text":"Pseudomucinous cystcarcinoma"},{"label":"D","text":"Malignant thecoma"},{"label":"E","text":"Malignant granular cell tumor"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-2f976acce79c","stem":"A histological investigation of a lung biopsy revealed atypical cells which form plural acinar structures and produce mucus. What histological form of a cancer of lungs takes place at the patient?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*High differentiated adenocarcinoma"},{"label":"B","text":"Low differentiated adenocarcinoma"},{"label":"C","text":"Nondifferentiated carcinoma"},{"label":"D","text":"Differentiated"},{"label":"E","text":"Glandular squamous cell carcinoma"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d8db66188e27","stem":"A gastroscopy of a 37-year-old man revealed a tumorous formation 1,5 cm in diameter in a small curvature of his stomach. What character of a tumor growth?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Exophytic"},{"label":"B","text":"Expansive"},{"label":"C","text":"Invasive"},{"label":"D","text":"Infiltrating"},{"label":"E","text":"Endophytic"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-33ef71d538a4","stem":"Histological investigation of a biopsy from a tumor of the right bronchus‘ muc- ous membrane revealed a cellular and tissue atypia, appearance of structures in the form of ' cancer pearls '. Define the pathological process.","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Malignant tumor"},{"label":"B","text":"Benign tumor"},{"label":"C","text":"Hyperplasia"},{"label":"D","text":"Metaplasia"},{"label":"E","text":"Hypoplasia"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-54418d3c4ee2","stem":"A histological investigation of the biopsy from cervix uteri of a 45-year-old woman revealed signs of cellular atypia with intact basal membrane. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Carcinoma in situ"},{"label":"B","text":"Erosion"},{"label":"C","text":"Adenocarcinoma"},{"label":"D","text":"Papilloma"},{"label":"E","text":"Endometriosis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0978dbda184a","stem":"A physical examination of a 42-year-old patient revealed enlarged supraclavi- cular lymph nodes. A histological investigation of a lymph node biopsy showed the metastasis of a signet-ring cancer. Choose the most probable localization of a pri- mary tumour.","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Carcinoma of stomach 72"},{"label":"B","text":"Cancer of esophagus"},{"label":"C","text":"Cancer of thyroid gland"},{"label":"D","text":"Carcinoma of lungs"},{"label":"E","text":"Carcinoma of uterine cervix"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-1c9f22a0d72c","stem":"A female patient in a climacteric period presented with relapsing uterine bleed- ings. The diagnostic curettage of a uterus is executed. Microscopical investigation showed among blood glandular elements of different size and forms created by atypical cells with hyperchromatic nuclei numerous mitoses (including pathologi- cal). What is the most likely pathology?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Adenocarcinoma"},{"label":"B","text":"Glandular hyperplasia of endometrium"},{"label":"C","text":"Choriocarcinoma"},{"label":"D","text":"Adenomatous polypus"},{"label":"E","text":"Signs of the interrupted pregnancy"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-b9c7215e46c4","stem":"A bronchoscopy of a 65-year-old patient revealed a polyp-like formation, 1,0 cm in diameter, in the proximal part of the upper lobe bronchus of his right lung. A histological research revealed the tumour which consisted from fine lymphocyte- like cells with hyperchromic nuclei. The cells grew like layers and cords. Specify, what of the listed below kinds of tumors is the most authentic?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Nondifferentiated small cell carcinoma"},{"label":"B","text":"Nondifferentiated large cell carcinoma"},{"label":"C","text":"Squamous cell carcinoma"},{"label":"D","text":"Adenocarcinoma"},{"label":"E","text":"Glandular squamous cell carcinoma"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e2904773822e","stem":"A gastroscopic study of a 50-year-old patient revealed a crater-like lesion on small curvature in pre-pyloric zone of stomach. From a regional site of formation a biopsy is taken. биопсия. A histological investigation showed a tumor with glands- like structures of the various form and the sizes, growing into surrounding tissue. The cells had marked signs pf atypia. Name a histological variant of the presented tumor.","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Adenocarcinoma"},{"label":"B","text":"Squamous cell carcinoma"},{"label":"C","text":"Scirrhous carcinoma of stomach"},{"label":"D","text":"Mucous carcinoma of stomach"},{"label":"E","text":"Solid carcinoma of stomach"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b340701ba083","stem":"A patient presented to her physician with gradually developed plaque on a skin of a cheek. The formation had necrosis and an ulcer in the center. A histological investigation of a skin biopsy revealed a growth of atypical epithelial cells with a lot of pathological mitoses. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Carcinoma of skin"},{"label":"B","text":"Sarcoma"},{"label":"C","text":"Papilloma"},{"label":"D","text":"Trophic ulcer"},{"label":"E","text":"Fibroma 73"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-6a56fb1a618b","stem":"A 48- year-old man with a history of a chronic bronchitis has died of a cachexy. A post-mortem revealed in a lumen of the right bronchus an endophytic growth of a light- grey softish tissue. Microscopic investigation showed a development of an atypical stratified epithelium with a presence of an « epithelial [epidermic] pearl, pearly body ». What is the most likely diagnose.","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Squamous cell keratinous carcinoma"},{"label":"B","text":"Squamous cell nonkeratinous carcinoma"},{"label":"C","text":"Adenocarcinoma"},{"label":"D","text":"Nondifferentiated carcinoma"},{"label":"E","text":"Apudoma"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6cc53722adf5","stem":"An autopsy of a 50-year-old man, who died of cancer intoxication, revealed the thickening of a stomach‘s wall to 1, 2 cm. The mucosa was fixed, with ill-defined gastric folds. On a cut view a tissue was homogeneous, whitish with chondroid density. For what macroscopical form of a tumour the described changes are cha- racteristic?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Infiltrate"},{"label":"B","text":"Node"},{"label":"C","text":"Ulcer"},{"label":"D","text":"Ulcerous-infiltration"},{"label":"E","text":"Cyst"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-244a897d4f2a","stem":"A histological investigation of a breast tumor‘s biopsy revealed solid layers of fine epithelial cells with polymorphic nuclei and a considerable quantity of patho- logical mitoses. In addition, the tumor had very little stroma and a lymphocytic infiltration. Name the kind of presented tumor.","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Medullary carcinoma"},{"label":"B","text":"Scirrhous carcinoma"},{"label":"C","text":"Paget‘s disease"},{"label":"D","text":"Adenoma"},{"label":"E","text":"Adenofibroma"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-82833b354c32","stem":"A mucus membrane biopsy is taken from a bronchus of a 52-year-old patient. A histological investigation revealed cords of atypical epithelial cells, which grew into the tissues underneath. In the cord‘s center a concentric pink color formations were determined (―cancer pearls‖, ―epithelial [epidermic] pearl, pearly body‖). Name a kind of a tumor? А. *Squamous cell keratinous carcinoma В. Differentiated adenocarcinoma","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"C","text":"Squamous cell nonkeratinous carcinoma"},{"label":"D","text":"Melanoma"},{"label":"E","text":"Transitional cell carcinoma Tumours derived from a mixture of tissues"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-ba41f28563b0","stem":"A 55-year-old female is found to have asymptomatic microscopic hematuria. A plain radiograph of the abdomen revealed a neoplasm at her right kidney. A gross 74 investigation of removed kidney revealed a node 8cm in diameter at its upper pole. The cut surface of a tumor presented with multiple hemorrhages and necroses. Histologically, it consists of light cells that form alveolar and papillary structures. The invasive growth of the tumor is moderate. Many cells have hyperchromic nuc- lei and atypical mitoses figues. What is the most likely diagnosis?","type":"Radiological Interpretation","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Renal cell carcinoma."},{"label":"B","text":"Clear cell adenoma."},{"label":"C","text":"Adenocarcinoma."},{"label":"D","text":"Nephroblastoma."},{"label":"E","text":"Acidophilic adenoma with malignancy."}],"priority":1,"status":"review","flags":["requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","visual_asset_not_transcribed"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-2bb3ae7be936","stem":"A 60-year-old man noticed worsening urinary tract symptoms and thus inquires about screening tests for kidney pathology. Investigation revealed a node 8 cm in diameter at right kidney‘s apex. After surgery, grossly tumor presented a patchy pattern with hemorrhages and zones of necrosis. Histological study showed large anaplastic tumor cells with abundant foamy cytoplasm and with small central densely staining nucleus. Abnormal mitoses were also found. What is the most likely diagnose?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Clear -cell carcinoma"},{"label":"B","text":"Clear -cell adenoma"},{"label":"C","text":"Adenocarcinoma"},{"label":"D","text":"Nephroblastoma"},{"label":"E","text":"Acidophilic adenoma with malignization"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-03580549f164","stem":"A 45-yer-old female examined by her gynecologist due to uterine bleeding. A neoplasm was diagnosed and then removed at surgery department. The uterine le- sion presented with huge necrotic and hemorrhagic spongy masses. Microscopic investigation revealed large clear atypical epithelial cells and variety of abnormal dark cells, arranged around material blood spaces. Stroma was not defined. Atypi- cal cells resembled cytotrophoblast and syncytiotrophoblast cells. What is the most likely diagnose?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Choriocarcinoma"},{"label":"B","text":"Invasive hydatidiform mole"},{"label":"C","text":"Adenocarcinoma"},{"label":"D","text":"Cavernous haemangioma."},{"label":"E","text":"Medullary carcinoma"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d9ad4836a5fa","stem":"A 32-year-old woman with a history of abortion 8 months earlier presented to the emergency department complaining of uterine bleeding. Examination done by gy- necologist revealed a neoplasm of the uterus. Grossly, tumor had a spongy structure with multiple hemorrhages. Microscopically, atypical clear epithelial Langhan‘s cells and abnormal syncytiotrophoblast cells arranged around maternal blood spac- es were detected. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Choriocarcinoma"},{"label":"B","text":"Squamous cell carcinoma without keratinisation"},{"label":"C","text":"Adenocarcinoma 75"},{"label":"D","text":"Fibromyoma"},{"label":"E","text":"Hydatidiform mole"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-2a5fa347196c","stem":"A 45-year-old woman presented to oncology with a breast tumor. A biopsy re- vealed a tissue atypia with stromal predominance over neoplastic parenchyma. Breast ducts and ductules were variable, they had one or two layered epithelium without atypical mitotic activity. The intralobular stroma was dence. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Fibroadenoma"},{"label":"B","text":"Papilloma"},{"label":"C","text":"Non-invasive carcinoma"},{"label":"D","text":"Invasive carcinoma"},{"label":"E","text":"Mastitis"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d383ba2d8a6e","stem":"The patient on a face skin had a tumorous formation plaque-like form with an ulcer. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Basal cell epithelioma"},{"label":"B","text":"Carcinoid"},{"label":"C","text":"Thecoma"},{"label":"D","text":"Pinealoma"},{"label":"C","text":"Thymoma"}],"priority":1,"status":"review","flags":["duplicate_option_labels"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_labels","nonunique_option_labels","prior_structural_review_flag"],"cleaningOperations":[]},{"id":"q-adc7ef5bcf1b","stem":"A physical examination of a 22-year-old woman, with few years‘ history of myasthenia, revealed a big tumor at anterior mediastinum. Histologically a tumor consisted of the oblong (spindle-shaped) cells with oval dark nuclei, which form bands and nests and has little Hassall‘s bodies. After a surgical removal of a tumor symptoms of a myasthenia have started to disappear progressively. Diagnose a tu- mor which has etiological and pathogenic connection with a myasthenia.","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Thymoma"},{"label":"B","text":"Adenoma of thyroid gland"},{"label":"C","text":"Adenoma of parathyroid gland"},{"label":"D","text":"Paraganglioma"},{"label":"E","text":"Medulloblastoma"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-499331ed5a67","stem":"A 48-year-old man has presented to his physician a plaque-like formation on a neck. Histological investigation of a skin biopsy revealed tumorous cells located as nests, having round and oval form with narrow rim of basophilic cytoplasm. They reminded cells of a skin basal layer. Specify the tumor name.","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Basal cell epithelioma"},{"label":"B","text":"Epidermal cancer"},{"label":"C","text":"Hidroadenoma"},{"label":"D","text":"Trichoepithelioma"},{"label":"E","text":"Syringadenoma"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7f4230173f51","stem":"A physical investigation of a 25-year-old-woman revealed in her breast a dense node 1,0 cm in diameter. A biopsy research showed encapsulated growth of a con- nective tissue round a basal membrane of a mammary gland ducts. Glandular ele- 76 ments had different diameter, did not form lobes. What is the most likely diagno- sis?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Fibroadenama"},{"label":"B","text":"Fibroma"},{"label":"C","text":"Metastasis of a cancer"},{"label":"D","text":"Adenoma"},{"label":"E","text":"Fibrous cancer"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-ce97fc144168","stem":"A physical examination of a 39-year-old woman revealed a soaking area by her breast nipple, a superficial ulcer with inflammatory hyperemia and skin edema. A histological research of a biopsy from this area revealed in basal layer of thickened epidermis atypical big cells with light and optically empty cytoplasm, with absence of intercellular bridges. Such cells are found and in the ostium of the big ducts of a gland. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Paget‘s desease"},{"label":"B","text":"Intraductal cancer"},{"label":"C","text":"Basal cell cancer"},{"label":"D","text":"Epidermoid carcinoma"},{"label":"E","text":"Melanoma"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b85d16edfa1b","stem":"A 45 year old man consulted a doctor about a plaque-like formation on his neck. Histological examination of a skin bioptate revealed clusters of round and oval tumour cells with a narrow border of basophilic cytoplasm resembling of cells of basal epidermal layer. What tumour is it?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Basal cell carcinoma"},{"label":"B","text":"Hydroadenoma"},{"label":"C","text":"Trichoepithelioma"},{"label":"D","text":"Epidermal cancer"},{"label":"E","text":"Syringoadenoma"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-912ff36d5144","stem":"6 months after labour a woman had uterine hemorrhage. Gynecological exami- nation of uterine cavity revealed a dark-red tissue with multiple cavities resembling of a \"sponge\". Microscopic examination of a tumour revealed in blood lacunas atypical light epithelial Langhans cells and giant cells of syncytiotrophoblast. What tumour is it?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Chorioepithelioma"},{"label":"B","text":"Cystic mole"},{"label":"C","text":"Fibromyoma"},{"label":"D","text":"Adenocarcinoma"},{"label":"E","text":"Squamous cell nonkeratinous carcinoma Mesenchymal (connective tissue) tumors"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e45b8e86bee0","stem":"A 30-year-old man has a node on his left leg the skin. Physical investigation re- vealed dense, mobile tumor, circumscribed by a connective tissue capsule. Grossly it cut section was presented with dense witish fibres. Microscopically the tumor composed of mature fibroblasts and a collagenous stroma. What is the most likely 77 diagnosis?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Fibroma"},{"label":"B","text":"Myoma"},{"label":"C","text":"Histiocytoma"},{"label":"D","text":"Dermatofibroma"},{"label":"E","text":"Desmoid."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-f66c18f7a295","stem":"A 14x6x5 cm neoplasm excised from a retroperitoneum of a 66-year-old woman at surgery department. Microscopic investigation revealed atypical anaplastic cells, which contained round cytoplasmic vacuoles of lipid that scallop the nucleus. The majority of cells were pleomorphic, some of them were round with chromosomal abnormalities. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"*Liposarcoma"},{"label":"B","text":"Lipoma"},{"label":"C","text":"Myosarcoma"},{"label":"D","text":"Fibrosarcoma"},{"label":"E","text":"Mesothelioma"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-e43bdcd8a649","stem":"A physical examination of 47-year-old woman of gynecology department re- vealed that her uterus contained dicrete, firm, white nodules. Histological examina- tion excised lesion demonstrated a tissue atypia of a sample. It presented well- defferentiated mature cells of smooth muscules. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Obstetrics and Gynecology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Leiomyoma."},{"label":"B","text":"Carcinoma of the uterus."},{"label":"C","text":"Fibromyoma."},{"label":"D","text":"Chorionepithelioma."},{"label":"E","text":"Leiomyosarcoma"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Obstetrics and Gynecology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6812ca1e9b78","stem":"A 20-year-old man has had a slowly growing reddish nodule on his upper lip. He finally decides to have a surgeon remove it. Microscopically the nodule is com- posed of benign varying sized tiny blood vessels. What is the most likely diagno- sis?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Capillary hemangioma."},{"label":"B","text":"Venous hemangioma."},{"label":"C","text":"Cavernous hemangioma."},{"label":"D","text":"Hemangiopericytoma."},{"label":"E","text":"Glomus-angioma."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-cbffbe41ea49","stem":"The patient, a previously dealthy man of 25 years, presented with a painless neoplasm in a soft tissues of his left thigh. Grossly, a tumor had uneven boundaries and on cut section it looked like a fish flesh. Microscopic investigation revealed immature connective tissue cells with pleomorphism, numerous mitotic figures and lymphocyte infiltration at the edge of the tumor. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Fibrosarcoma"},{"label":"B","text":"Myosarcoma"},{"label":"C","text":"Fibroma"},{"label":"D","text":"Carcinoma 78"},{"label":"E","text":"Myoma"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-07df2bf94d08","stem":"A 40-year-old woman presented with a very slowly enlarging subcutaneous mass at the right side of the chest wall. Physical examination revealed a soft lobulated fluctuant swelling, not attached to the skin or underlying muscle. Histologically a neoplasm was well-encapsulated and consisted of mature cells with clear cytoplasm that varied considerably in size. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Lipoma."},{"label":"B","text":"Fibroma."},{"label":"C","text":"Hygroma."},{"label":"D","text":"Papilloma."},{"label":"E","text":"Hemangioma."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-35c586814f07","stem":"A macroscopical investigation of operatively removed uterus revealed a tumour with a soft consistence, hemorrhages and necroses. The tumor cut surface reminds ' the fish meat '. Histological research has found an expressed cellular and tissue atypia; there were cells with pathological mitoses figures. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Sarcoma."},{"label":"B","text":"Adenocarcinoma."},{"label":"C","text":"Angioma."},{"label":"D","text":"Fibroma."},{"label":"E","text":"Lipoma."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-81374eda3e2c","stem":"At the young man in a skin depth the dense, mobile tumour, is defined. A micro- scopical research revealed chaotically located fascicles of collagen fibers with a small amount of spindle-shaped cells. What tumour is removed?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Dense fibroma."},{"label":"B","text":"Leiomyoma."},{"label":"C","text":"Melanoma."},{"label":"D","text":"Lipoma."},{"label":"E","text":"Glomus-angioma."}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-673856cd07e7","stem":"A 4-year-old child presented with a flat red color knot on his neck skin, which turns pale at pressing by glass the knot. What is the most probable diagnosis? А. Hemangioma","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Pigmented nevus"},{"label":"C","text":"Melanoma"},{"label":"D","text":"Leiomyoma"},{"label":"E","text":"Lymphangioma"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-315f345340e9","stem":"A 28-year-old man with a history of an elbow bruise 3 years ago presented with a tumorous growth in the area of an epiphysis of a humeral bone. The formation did not have accurate borders. A histological investigation of biopsy material revealed a considerable quantity of polymorphic cells of osteoblastic type with numerous pathological mitoses. Make the presumable diagnosis.","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Osteosarcoma"},{"label":"B","text":"Chondrosarcoma"},{"label":"C","text":"Osteoid-osteoma 79"},{"label":"D","text":"Fibrosarcoma"},{"label":"E","text":"Sinovial sarcoma"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-355c758601be","stem":"A 48-year-old man presented to physician with mobile 1, 0 x 0, 7 cm formation under a skin of mandible. It had precise borders, dough-like consistence and slow growth. A histologic research of formation revealed fat tissue cells (lipocytes), which created lobules of different forms and the sizes, divided by thin layers of a connective tissue with vessels. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Lipoma"},{"label":"B","text":"Fibroma"},{"label":"C","text":"Angioma"},{"label":"D","text":"Liposarcoma"},{"label":"E","text":"Fibrosarcoma"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-162a30d36f32","stem":"A 33-year-old woman presented with a tumor-like formation on a white line of her abdomen, which during pregnancy has started to increase in sizes. A histologi- cal research revealed that a tumor is constructed of the differentiated connective tissue, in which collagen fibers prevail of cells. What tumor presented in this case?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Desmoid"},{"label":"B","text":"Dense fibroma"},{"label":"C","text":"Fibrosarcoma"},{"label":"D","text":"Soft fibroma"},{"label":"E","text":"Dermatofibroma"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-12d89c2f6775","stem":"A 15-year-old young man presented with a tumorous formation in the central site of his wrist bone. The node grew slowly within last 3 years. A histological re- search of a removed neoplasm revealed mature chondrocytes without mitoses, which randomly located in chondral lacunas. Cartilages of a capsule had different form and the sizes due to variable quantity of chondral cells, between which there were basic substance with liquid layers of a connective tissue. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Chondroma"},{"label":"B","text":"Chondroblastoma"},{"label":"C","text":"Chondrosarcoma"},{"label":"D","text":"Teratoma E."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-185d71234f52","stem":"A 50-year-old patient presented to the doctor with a ball-shaped, dense, motion- less neoplasm, 2 cm in diameter, under a skin in the right parietal site of his head. A histological research of a removed neoplasm revealed a chaotic osteal beams pattern with a connective tissue between. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Cancellous osteoma (Osteoma spongiosum)"},{"label":"B","text":"Compact osteoma (Osteoma durum)"},{"label":"C","text":"Osteoporosis"},{"label":"D","text":"Osteomalacia"},{"label":"E","text":"Osteosarcoma 80"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-6653a3f41375","stem":"At the young woman in the area of her distal extremity of a femur the tumor, which quickly grew, is removed. Grossly, it had a motley pattern – from white- sulphur to brown-red color and a quaggy consistence. Microscopical investigation revealed the basic tissue component of a tumor presented with osteal and the ossi- form structures covered by atypical osteoblasts, with numerous thin-walled vessels and atypical mitoses figures. Make a diagnosis.","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Osteocarcoma"},{"label":"B","text":"Chondroma"},{"label":"C","text":"Osteoma"},{"label":"D","text":"Саркома Юинга"},{"label":"E","text":"Angiosarcoma"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-2ea04640a8d6","stem":"A 16-year-old child presented with a painful softish node in his femur diaphy- sis. The formation grows quickly with destruction of a spongy layer of a bone. Mi- croscopical investigation revealed monomorphic round cells little bit bigger than mature lymphocytes, with jejunely light cytoplasm which contains glycogen. In some zones these cells form pseudo- rosettes with few mitoses. Between cells there are fibrinous membranes. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"*Ewing‘s sarcoma"},{"label":"B","text":"Limphoma"},{"label":"C","text":"Rhabdomyosarcoma"},{"label":"D","text":"Neuroblastoma"},{"label":"E","text":"Hemangioma"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-d6ea1f5c137f","stem":"Examination of a 55 year old woman revealed under the skin of submandibular area a movable slowly growing pasty formation with distinct borders 1,0x0,7 cm large. Histological examination revealed lipocytes that form segments of different forms and sizes separated from each other by thin layers of connective tissue with vessels. What is the most probable diagnosis?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Lipoma"},{"label":"B","text":"Fibroma"},{"label":"C","text":"Liposarcoma"},{"label":"D","text":"Fibrosarcoma"},{"label":"E","text":"Angioma"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8f3a47f3acd9","stem":"Examination of the anterior abdominal wall of a pregnant woman revealed a tumour-like formation that arose on the spot of a tumour that was removed two years ago. The neoplasm was well-defined, dense, 2x1 cm large. Histological ex- amination revealed that the tumour was composed of differentiated connective tis- sue with prevailing collagen fibres. What tumour might be suspected?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Desmoid"},{"label":"B","text":"Hibernoma"},{"label":"C","text":"Leiomyoma"},{"label":"D","text":"Fibrosarcoma"},{"label":"E","text":"Lipoma 81 Neoplasms of the nervous system (including meninges) and melanin producing tissues"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-313b5b4a0fc8","stem":"An eye of 53-year-old patient, excised at surgery due to neoplasm, presented in pathology department. Gross investigation reveled a 1×0,4 cm black lesion in the retina. Microscopic appearance of a tumor was characterized by nests of immature cell with eccentric nuclei, prominent macronucleoli and cytoplasm brown pigment. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Melanoma"},{"label":"B","text":"Neurinoma"},{"label":"C","text":"Angiosarcoma"},{"label":"D","text":"Neuroblastoma"},{"label":"E","text":"Ganglioneuroblastoma"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-c1e1bcd210d6","stem":"At autopsy a 8-year-old child is found to have a poorly circumscribed tumor of cerebellum. Histologically investigation reveled crowds of small immature cells with hyperchromatic, round-oval nuclei and scant cytoplasm. A few rosettes were also found by pathologist at slide examination. What is the most likely diagnosis in that case?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Medulloblastoma"},{"label":"B","text":"Astrocytoma"},{"label":"C","text":"metastasis of cancer"},{"label":"D","text":"metastasis of sarcoma"},{"label":"E","text":"Glioblastoma"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-64eea7bd7523","stem":"An elderly man with a 2-year history of right leg amputation presents with 2 cm encapsulated tumor at the area of a past surgical trauma of soft tissue. Histology investigation revealed disordered orientation of mature nerve fiber bundles inter mixed with connective tissue. Higher magnification showed bundles of axons, Schwann cells, fibroblasts and perineurial cells within tumor mass. What is most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Neurinoma"},{"label":"B","text":"Neurofibroma"},{"label":"C","text":"Malignant neurinoma"},{"label":"D","text":"Soft fibroma"},{"label":"E","text":"Fibrosarcoma"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-47c0fd2204d4","stem":"A 66-year-old woman present with right eye bad vision, ophtalmoscopy revealed a neoplasm of retina which was soon excised, at surgery together with an eye ball. Grossly, a neoplasm was soft, irregular in contour 1×1 cm in size and had a brown coloring. Under microscope a lesion demonstrated nodular aggregates of infiltrat- ing cells. There cells contained large brown pigment nuclei with chromatin clumped at the periphery of nuclear membrane and prominent nucleoli. Atypical mitoses figures were also revealed. What is most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Ophthalmology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Melanoma"},{"label":"B","text":"Schwannoma"},{"label":"C","text":"Glomus tumor 82"},{"label":"D","text":"Paraganglioma"},{"label":"E","text":"Angiosarcoma"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Ophthalmology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-9ee398ece24f","stem":"A 38-year-old woman has a seizure while shopping and is taken to the hospital. A scan of a brain demonstrated a poorly circumscribed 5 cm tumor at right parietal lobe. A biopsy of this area contains of increased number of glial cell nuclei and an interening feltwork of file cell processes that give the background a fibrillary ap- pearance. Abnormal mitoses and atypical central nervous system cells were absent within biopsy sample. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Astrocytoma"},{"label":"B","text":"Oligodendroglioma"},{"label":"C","text":"Ganglioneuroma"},{"label":"D","text":"Ependimoma"},{"label":"E","text":"Chorioid papilloma"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-5ea0d2164ccd","stem":"A 50-year-old woman presented with a pigmented painful skin lesion above the ankle. It had been present for many years but in recent months it had enlarged quite rapidly, its outline got irregularity. Microscopic investigation of a lesion biopsy revealed nests of atypical cells and single cells with eccentric nuclei, prominent macronucleoli and cytoplasmic brown pigment. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Melanoma"},{"label":"B","text":"Basal cell carcinoma"},{"label":"C","text":"Hemangioma."},{"label":"D","text":"Haematoma."},{"label":"E","text":"Carcinoid."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-399954a1250b","stem":"The man of 45 years has completely lost hearing on the right ear. Physical inves- tigation has not revealed any pathological changes in system of the right acoustic analyzer. The tomography of a brain has revealed a neoplasm, 7 cm in diameter, homogeneous, without precise contours in a site of cerebellopontine angle. Name a neoplasm.","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Neurilemmoma"},{"label":"B","text":"Gangliocytoma"},{"label":"C","text":"Astrocytoma"},{"label":"D","text":"Chorioidal papilloma"},{"label":"E","text":"Neuroblastoma"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-6a9b33061124","stem":"The tumor of a brain is diagnosed for the patient with neurologic disturbances. During operation the tumor, which looks like the dense node bound to a firm cere- bral membrane, is removed. Histological investigation revealed the neoplasm con- structed from endothelium-like cells closely adjoining to each other. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Meningioma"},{"label":"B","text":"Glioblastoma"},{"label":"C","text":"Anaplastic meningeoma"},{"label":"D","text":"Astrocytoma"},{"label":"E","text":"Neuroblastoma 83"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-d044248d698b","stem":"The tumour of a brain is diagnosed for the patient with quickly increasing intra- cranial hypertension. The removed tumor of a parietal -temporal part of brain had a soft consistence and a motley pattern of a cut surface. Histological investigation revealed neoplastic tissue constructed of polymorphic cells with sites of necroses and a hemorrhage. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Glioblastoma"},{"label":"B","text":"Oligodendroglioma"},{"label":"C","text":"Neuroblastoma"},{"label":"D","text":"Astrocytoma"},{"label":"E","text":"Meningioma"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-cfdf21176fbb","stem":"The woman on her face skin had a pigmental formation in the form of a nodule which quickly grew. The biopsy is made. Microscopical investigation of biopsy sample revealed fields of spindle-shaped and polymorphic cells which contain a brown pigment. In addition, there were diagnosed numerous mitoses. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Melanoma"},{"label":"B","text":"Nevus"},{"label":"C","text":"Cancer"},{"label":"D","text":"Papilloma"},{"label":"E","text":"Dermatofibroma"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7f1b5ed612a0","stem":"A physical investigation of a 60-year-old woman with one year history of a formation on a face revealed a brown skin plaque with irregular form and black impregnations. A histological research of a skin biopsy showed in epidermis and through all derma polymorphic big cells with pathological mitoses, large nucleoli and yellowy-brown pigment in a cytoplasm of many cells. The specified cells grow in a kind of fine groups and also alone. Make a diagnosis.","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Melanoma"},{"label":"B","text":"Nevus"},{"label":"C","text":"Papilloma"},{"label":"D","text":"Xeroderma"},{"label":"E","text":"Melanosis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-9494a2b663f2","stem":"Examination of a young woman revealed a node-like, soft and elastic homo- genous tumour of pinkish-white colour along the acoustic nerve. The tumour con- tains cell bundles with oval nuclei. Cellular fibrous bundles form rhythmic struc- tures made up by parallel rows of regularly oriented cells arranged in form of a palisade with cell-free homogenous zone (Verocay bodies) between them. What tumour is it?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Neurinoma"},{"label":"B","text":"Ganglioneuroblastoma"},{"label":"C","text":"Malignant neurinoma\""},{"label":"D","text":"Neuroblastoma"},{"label":"E","text":"Ganglioneurinoma 84"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":["option_whitespace_normalization"],"duplicateStemGroup":"adb6fd5f7482a225d527229531cd4a7101fa1c06"},{"id":"q-3284db28a339","stem":"Examination of a young woman revealed a node-like, soft and elastic homo- genous tumour of pinkish-white colour along the acoustic nerve. The tumour con- tains cell bundles with oval nuclei. Cellular fibrous bundles form rhythmic struc- tures made up by parallel rows of regularly oriented cells arranged in form of a palisade with cell-free homogenous zone (Verocay bodies) between them. What tumour is it?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Neurinoma"},{"label":"B","text":"Ganglioneuroblastoma"},{"label":"C","text":"Malignant neurinoma"},{"label":"D","text":"Neuroblastoma"},{"label":"E","text":"Ganglioneurinoma Diseases of haemopoetic and allied systems"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":[],"duplicateStemGroup":"adb6fd5f7482a225d527229531cd4a7101fa1c06"},{"id":"q-ff2b6c6d1b9a","stem":"A 34- year-old male is found to have weakness confusion, other neurologic ma- nifestation and polyuria X-ray examination revealed multifocal destructive bone lesions throughout the skeletal system. Electrophoretic analysis revealed increased level of Ig in the blood and Bence Jones protein in the urine. What is the most like- ly diagnosis?","type":"OSCE / Practical Station","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"*Myeloma"},{"label":"B","text":"Acute monocytic leukemia"},{"label":"C","text":"Chronic myeloleukemia"},{"label":"D","text":"Lymphogranulomatosis"},{"label":"E","text":"Histiocytosis"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-0987e459d8aa","stem":"A 42-year-old female is admitted to the hospital for treatment a blood disorder. A disease complicated with pneumonia led to lethal outcome. An autopsy revealed hyperplasia of a bone marrow with ―pus‖ – like appearance, splenomegaly (5 kg weight), hepatomegaly (6 kg weight), systemic lymph nodes enlargement. What is the most likely diagnosis? A* Chronic myeloleukemia","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"B","text":"Chronic lymphatic leukemia"},{"label":"C","text":"Myeloma"},{"label":"D","text":"Polycytemia vera (erythremia, Osler's disease)"},{"label":"E","text":"Lymphogranulomatosis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-dba6fe52a6f5","stem":"An elderly male is admitted to the hospital for treatment of humeral bone fruc- ture. His fracture‘s area X-ray showed a new growth and lytic zone within lesion. Histological examination of a biopsy revealed abnormal plasma cells. What is the most likely diagnosis?","type":"Radiological Interpretation","subject":"Human Anatomy","topic":"Histology and Tissues","topicOriginal":"Histology and Tissues","subtopic":"Histolog","suggestedTopic":null,"options":[{"label":"A","text":"* Myeloma"},{"label":"B","text":"Chronic osteomyelitis"},{"label":"C","text":"Chondrosarcoma."},{"label":"D","text":"Bone fibrous dysplasia"},{"label":"E","text":"Metastasis of adenocarcinoma"}],"priority":1,"status":"review","flags":["requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Human Anatomy","displayTopic":"Histology and Tissues","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-308bd3fe5310","stem":"At autopsy an elderly female is found to have enlarged groups of a neck, axillary 85 and mediastinal lymph nodes matted together. They were firm and rubbery. The cut surface was gray-white, producing a ―fish-flesh‖ appearance. Microscopy re- vealed heterogeneous cellular infiltrate wich contained lymphocytes, classic and mononuclear Reed-Berezovsky-Sternberg cells. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Lymphogranulomatosis"},{"label":"B","text":"Chronic lymphatic leukemia"},{"label":"C","text":"Lymphosarcoma"},{"label":"D","text":"Retikulosarcoma"},{"label":"E","text":"Mycosis fungoides"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-1b1669a41b26","stem":"A 67-year-old female presented with painless enlargement of lymph nodes. His- tological examination of a biopsy sample revealed that the whole lymph node pat- tern was unclear, with heterogeneous cellular infiltrate. It included abnormal, im- mature cells admixed with lymphocytes, eosinophils, plasma cells and macrophag- es. Binucleated Berezovsky-Reed-Sternberg cells, where surrounded by multiple cell types. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Lymphogranulomatosis"},{"label":"B","text":"Acute myeloleukemia"},{"label":"C","text":"Chronic myeloleukemia"},{"label":"D","text":"Mycosis fungoides"},{"label":"E","text":"Tuberculosis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a39f95db4162","stem":"A 25-year-old patient presented with peripheral adenopathy, involving a single cervical lymph node. A biopsy sample investigation revealed an unclear node pat- tern with mixed cellular infiltration. Histologycal study under higher magnification showed numerous variants of Berezovsky-Reed-Stenberg cells, lymphocytes, ne- crotic area and mild diffuse fibrosis. What is the most likely diagnosis?.","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Lymphogranulomatosis"},{"label":"B","text":"Nodular lymphoma"},{"label":"C","text":"Burkitt's lymphoma"},{"label":"D","text":"Lymphocytic lymphoma"},{"label":"E","text":"Chronic lymphatic leukemia"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-bfd084cdfe14","stem":"A 65-year-old female is noted to be anemic. He serum protein electrophoresis demonstration a large monoclonal Ig G kappa protein. In her bone marrow are in- creased numbers of atypical plasma cells. Her skull X-ray show multiple lytic areas. What is the most likely diagnosis?","type":"Radiological Interpretation","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"* Myeloma"},{"label":"B","text":"Polycytemia vera (erythremia, Osler's disease)"},{"label":"C","text":"Lymphocytic lymphoma"},{"label":"D","text":"Chondrosarcoma"},{"label":"E","text":"Bone fibrous dysplasia"}],"priority":1,"status":"review","flags":["requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-8e1f67f3f7c9","stem":"A thoracotomy of a 58-year-old woman revealed in her anterior mediastinum the enlarged and soldered together lymph nodes. Microscopical investigation revealed atypical cells with predominance of Hodgkin cells and giant Reed—Berezovsky - Sternberg cells. A sclerosis was absent. What is the most likely diagnosis? 86","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"*Lymphogranulomatosis with low-spirited development of lymphoid tissue"},{"label":"B","text":"Lymphogranulomatosis with predominance of nodularis sclerosis"},{"label":"C","text":"Lymphogranulomatosis with predominance of lymphoid tissue"},{"label":"D","text":"Lymphosarcoma"},{"label":"E","text":"Mixed-cellular variant of lymphogranulomatosis"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-f93dd51b53ac","stem":"A tomography revealed enlarged lymphatic nodes. A histological investigation of lymph node‘s biopsy showed a circular growths of a connective tissue, which surrounded a granuloma - like formation, made from lymphocytes, plasmocytes and giant double- nuclear cells. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Lymphogranulomatosis"},{"label":"B","text":"Lymphosarcoma"},{"label":"C","text":"Tuberculosis"},{"label":"D","text":"Sarcoidosis"},{"label":"E","text":"Lymphatic leukemia"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-4c088cecfac5","stem":"The young man presented to his physician with enlarged neck lymph nodes. A microscopical investigation of a lymph node biopsy sample revealed the lymphoid tissue proliferation with presence of a giant Reed—Berezovsky - Sternberg cells, eosinocytes, zones of necrosis and sclerosis. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Lymphogranulomatosis"},{"label":"B","text":"Chronic lymphatic leukemia"},{"label":"C","text":"Multiple myeloma"},{"label":"D","text":"Lymphosarcoma"},{"label":"E","text":"Histiocytosis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d635bf04dfa8","stem":"A biopsy of the enlarged lymph node was taken. A histological investigation revealed a diffuse growth of lymphoid cells with adding of eosinocytes, atypical histiocytes, solitary giant Reed—Berezovsky - Sternberg cells with two and more nuclei, cell‘s necrosis and sclerosis. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Lymphogranulomatosis"},{"label":"B","text":"Lymphatic leukemia"},{"label":"C","text":"Burkett‘s lymphoma"},{"label":"D","text":"Sarcoidosis"},{"label":"E","text":"Myeloleukemia"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6db23fa8306f","stem":"An autopsy of a 67-year-old man revealed the systemic enlargement of lymph nodes with formation of tumorous conglomerates. The spleen was also enlarged with a motley pattern of a cut surface. There were plural, tiny, yellowish-white spots on a red background of a spleen‘s pulp. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Lymphogranulomatosis"},{"label":"B","text":"Sarcoidosis"},{"label":"C","text":"Lymphosarcoma"},{"label":"D","text":"Carcinoma of lung"},{"label":"E","text":"Lymphatic leukemia"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-78f900b4d8b9","stem":"Clinical investigation of a patient revealed the enlarged lymph nodes, spleen and liver. A microscopical study of the enlarged cervical (neck) lymph node 87 showed the blurring of its structures and absence of lymphatic follicles. All micro- scopical views were presented by cells with round nuclei and narrow ring of a ba- sophilic cytoplasm. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Lymphatic leucosis"},{"label":"B","text":"Lymphogranulomatosis"},{"label":"C","text":"Lymphosarcoma"},{"label":"D","text":"Myeloleukemia"},{"label":"E","text":"Multiple myeloma"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-1d70a602297d","stem":"An autopsy of a 35-year-old woman revealed the enlarged spleen, (weight 800gm), liver (weight 4000 gm) and lymph nodes. A bone marrow of a femur dia- physis was juicy (succulent), crimson-red color. Microscopical study of a liver de- fined dense infiltrates within portal tracts, consisted of immature blood cells. These cells had a round nuclei and narrow ring of a cytoplasm. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"*Chronic lymphatic leukemia"},{"label":"B","text":"Chronic myeloid leucosis"},{"label":"C","text":"Generalizated form of lymphogranulomatosis"},{"label":"D","text":"Acute myeloblastic leucosis"},{"label":"E","text":"Acute lymphoblastic leucosis"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7b5caf026d35","stem":"A microscopic investigation of the enlarged neck lymph node biopsy revealed the blurring of its structures, plenty of proliferating lymphocytes with adding of solitary giant Reed—Berezovsky - Sternberg cells. What is the most likely diagno- sis?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Lymphogranulomatosis, with predominance of lymphatic tissue"},{"label":"B","text":"Lymphogranulomatosis, with exhaustion of lymphatic tissue"},{"label":"C","text":"Mixed cell variant of lymphogranulomatosis"},{"label":"D","text":"Lymphosarcoma"},{"label":"E","text":"Nodular sclerotic variant of lymphogranulomatosis"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-acc8073d55bd","stem":"At young men the increased cervical lymph node is removed. Microscopic in- vestigation revealed the altered node‘s structure, an absence of lymphoid follicles, sites of a sclerosis and necrosis. The cellular infiltrate is polymorphic with a pres- ence of lymphocytes, eosinocytes, and atypical one-nuclear cells and multinuclear giant cells (Reed—Berezovsky - Sternberg cells). What is the most likely diagno- sis?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Lymphogranulomatosis"},{"label":"B","text":"Acute lymphatic leukemia"},{"label":"C","text":"Chronic lymphatic leukemia"},{"label":"D","text":"Burkett‘s lymphoma"},{"label":"E","text":"Mycosis fungoides"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-6f68c46d8754","stem":"A liver biopsy was taken from a 66-year-old man, with a history of increased quantity of lymphocytes and pro-lymphocytes in his blood. A histological investi- gation of a liver sample revealed plural accumulations of the mentioned above 88 cells, mainly between hepatic segments. For what disease above listed changes are characteristic?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Chronic lymphatic leukemia"},{"label":"B","text":"Acute lymphatic leukemia"},{"label":"C","text":"Lymphogranulomatosis"},{"label":"D","text":"Chronic persistence hepatitis"},{"label":"E","text":"Hepatocellular carcinoma of liver"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-61e78303d94c","stem":"A 4-year-old girl died due to a post-hemorrhagic anemia, resulted from a ga- stro-intestinal profuse bleeding. An autopsy revealed an anemia of her organs, the enlargement of the different groups of lymph nodes, thymomegaly, mild hepato- megaly, splenomegaly and bright red bone marrow. Microscopical study showed hyper cellularity of a bone marrow with monomorphic blast cells infiltrate, diffuse inflammatory tumor-like infiltrates in a liver, a spleen, lymph nodes, meninges and substance of a brain. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"* Acute lymphoblastic leucosis"},{"label":"B","text":"Acute myeloblastic leucosis"},{"label":"C","text":"Acute nondifferentiated leucosis"},{"label":"D","text":"Acute monoblastic leucosis"},{"label":"E","text":"Acute plazmoblastic leucosis"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-25f853418f2b","stem":"A 14-year-old boy presented to a hospital with enlarged submaxillary and cer- vical lymph nodes. A biopsy procedure was performed. Microscopical investigation revealed the disorder of a lymph node typical structure, a heterogeneous cellular population with a presence of giant multinuclear cells and plural one-nuclear big cells. There were also eosinocytes, neutrophils and lymphocytes in the cell infil- trate. In addition, sites of necrosis and sclerosis were found. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Lymphogranulomatosis"},{"label":"B","text":"Hyperplasia of lymphatic nodes"},{"label":"C","text":"Granulomatous lymphadenitis"},{"label":"D","text":"Purulent lymphadenitis"},{"label":"E","text":"Non-Hodgkin‘s lymphoma"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-72c6c9769c42","stem":"A radiological investigation of a man‘s head revealed in his maxillary and mandibular bones numerous round defects with smooth walls. A histological study showed osteolysis and osteoporosis accompanied with insufficient bone repair. The laboratory test of the urine detected the Bence Jones protein. What is the most like- ly diagnosis?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Head","suggestedTopic":null,"options":[{"label":"A","text":"*Multiple myeloma"},{"label":"B","text":"Chronic myeloleukemia"},{"label":"C","text":"Chronic erythromyelosis"},{"label":"D","text":"Acute myeloleukemia"},{"label":"E","text":"Acute nondifferentiated leucosis"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-3fff9a26f799","stem":"A physical examination of a young men‘s oral cavity revealed the atrophy of mucous membrane and red spots on his tongue (atrophic; Hunter's; Moeller's glos- 89 sitis). Sclera had a yellow coloring. A blood test showed the color index above one. For what anemia these changes are characteristic?","type":"Single Best Answer MCQ","subject":"Hematology","topic":"Hematology","topicOriginal":"Hematology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Nutritional anemia due to vitamine B12 deficiency"},{"label":"B","text":"Asiderotic anemia"},{"label":"C","text":"Acute posthemorrhagic"},{"label":"D","text":"Chronic posthemorrhagic"},{"label":"E","text":"Hemolytic anemia"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Hematology","displayTopic":"Hematology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-5a80e1990078","stem":"A physical examination of a 42-year-old man revealed enlarged lymph nodes. A histological investigation of a lymph node showed lymphocytes, histiocytes, reti- cular cells, small and big Hodgkin‘s cells, multinuclear Berezovsky -Reed- Sternberg cells (Sternberg-Reed cells) infiltration with solitary necrotic areas. What disease such changes characteristic for?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Lymphogranulomatosis"},{"label":"B","text":"Lymphosarcoma"},{"label":"C","text":"Chronic leucosis"},{"label":"D","text":"Acute leucosis"},{"label":"E","text":"Metastasis of carcinoma of lungs"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1f7089302a38","stem":"A gross examination of a dead body revealed the skin‘s pallor and a yellowness of a sclera. Livores mortis were not defined. The volume of blood in a heart and large vessels was reduced. A blood looked aqueous. In a skin, mucosa and serous membranes there were petechial hemorrhages. The internal organs, especially a spleen, a liver and kidneys had a rusty color on a cut. A bone marrow of flat bones was a crimson-red and succulent. In cortical [tubular, cylindrical] bones it looked like a crimson jelly. Name the disease, connected with a deficiency of vitamin В12.","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"*Pernicious anemia"},{"label":"B","text":"Drepancytic (sickle-cell) anemia"},{"label":"C","text":"Panmyelophthisis"},{"label":"D","text":"Toxic anemia"},{"label":"E","text":"Acute posthemorrhagic anemia"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-67755dc47bcb","stem":"A post-mortem of a 56-year-old woman revealed the Hunter's (atrophic; Moel- ler's) glossitis, atrophy of mucous membrane of a stomach and liver‘s hemosidero- sis. A bone marrow in all investigated bones was red. A microscopical study showed hyper cellular infiltration in a lamina propria of a stomach with a presence of lymphatic follicles. In a spinal cord there was a funicular myelosis and also haemopoiesis foci detected in a spleen. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"*Addison-Biermer anemia"},{"label":"B","text":"Fanconi's (congenital aplastic) anemia"},{"label":"C","text":"Hypoplastic anemia"},{"label":"D","text":"Chronic gastritis (type A)"},{"label":"E","text":"Chronic gastritis (type B)"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-8920bec36e91","stem":"A post-mortem of a 4-year-old girl revealed plural petechial hemorrhages on her skin, serous and mucous membranes, large focal hemorrhage in a brain and necrotic tonsillitis. Microscopical study showed multiple cell infiltrates with pre- 90 vailing lymphocytes in a bone marrow, a liver, a spleen, a thymus, lymph nodes, tonsils and a skin. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"*Acute lymphatic leukemia"},{"label":"B","text":"Chronic lymphatic leukemia"},{"label":"C","text":"Hodgkin‘s lymphoma"},{"label":"D","text":"Follicular non-Hodgkin‘s lymphoma"},{"label":"E","text":"Mycosis fungoides"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["whitespace/page_marker_normalization"]},{"id":"q-ad490219507c","stem":"A post-mortem of a 15-year-old girl revealed enlarged neck, mediastinal and mesenteric lymph nodes, which were integrated in conglomerates. On a cut section, the tissue pattern of the nodes was non-uniform, with foci of necrosis. Microscopi- cal investigation showed the uneven structure of lymph nodes, foci of sclerosis and necrosis. The cell population was also heterogeneous and included uninuclear atyp- ical cells, giant multinuclear atypical cells, a significant amount of eosinocytes and neutrophils, and sparse lymphocytes. What is the most likely form of Hodgkin lymphoma (lymphogranulomatosis)?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* Lymphogranulomatosis, mixed cell variant"},{"label":"B","text":"Lymphogranulomatosis, lymphohistiocytic variant"},{"label":"C","text":"Lymphogranulomatosis, nodular sclerosis"},{"label":"D","text":"Lymphogranulomatosis, variant with low-spirited development of lymphoid tissue"},{"label":"E","text":"Hodgkin‘s sarcoma"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-0f63045f82cd","stem":"A 63-year-old man, with 20 years history of working as the engineer for the service of electronic microscopes, died of a sepsis. An autopsy revealed plural he- morrhages in serous and mucous membranes, a general hemosiderosis, a fatty dy- strophy of a myocardium, liver and kidneys, ulcerative –necrotic and purulent processes in a gastro –intestinal system. The red bone marrow was replaced by a fatty. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Hypoplastic anemia"},{"label":"B","text":"Megaloblastic anemia"},{"label":"C","text":"Posthemorrhagic anemia"},{"label":"D","text":"Iron deficiency anemia"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-36a7fa0ecf3f","stem":"A 38-year-old man, with a history of an ulcer, resulted in a stomach‘s resection, in his blood test had a normal quantity of erythrocytes, but reduced hemoglobin‘s concentration and decreased color index. An autopsy revealed pale skin and visible mucous membranes; bone marrow of long tubular bones was brightly red. Erythro- cytes in a smear had a normal form and the sizes. They look very pale because of bad staining by dyes. What pathological process took place in this case?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[{"label":"A","text":"* Hypochromic iron deficiency anemia"},{"label":"B","text":"В12-folic acid deficiency anemia"},{"label":"C","text":"Acute lymphoblast leukemia"},{"label":"D","text":"Sicklemia sickle cell anemia"},{"label":"E","text":"Aplastic anemia 91"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-ebedf482ee9e","stem":"A 44-year-old man presented to a gastroenterologist with pains in his epiga- strium. A physical examination revealed an icteritiousness of his skin and scleras, an alteration of a tongue‘s mucous membrane. A tongue grossly looked shining, smooth, with red spots. In peripheral blood‘s smear there were found enlarged erythrocytes (megaloblasts). A histological study of a gastrobiopsy from a body of a stomach showed a thinning of mucosa, a reduction of glands quantity, super- fluous growth of a connective tissue. Specify, what of diagnoses is the most proba- ble in this case","type":"Single Best Answer MCQ","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"* В12-folic acid deficiency anemia"},{"label":"B","text":"Chronic posthemorrhagic anemia"},{"label":"C","text":"Hemolytic anemia ."},{"label":"D","text":"Chronic myeloid leukemia."},{"label":"E","text":"Aplastic anemia"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c0e5a971c330","stem":"A man, with a history of getting a high doze of ionizing radiation, presented to his physician with marked stomatorrhagia (gingival hemorrhage), spontaneous skin and mucosas‘ haemorrhages. A blood test showed a normochromal anemia and pancytopenia. The concentration of iron in blood‘s serum was normal. A histologi- cal investigation of a bone marrow puncture sample revealed a replacement of a hemopoietic tissue by the fatty tissue. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Histology and Tissues","topicOriginal":"Histology and Tissues","subtopic":"Histolog","suggestedTopic":null,"options":[{"label":"A","text":"* Aplastic anemia"},{"label":"B","text":"В12-folic acid deficiency anemia"},{"label":"C","text":"Hemolytic anemia"},{"label":"D","text":"Myelodysplastic syndrome"},{"label":"E","text":"Immune cytopenia"}],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Histology and Tissues","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-62231a1b3480","stem":"A patient presented with an infiltrative, plaque-like polymorphic skin rash, which had various contours, sizes and a congested -cyanotic color. The lesions tended to peripheral growth and fusion. A microscopical investigation of a skin biopsy revealed massive lymphocytes‘ proliferation, which occupied the entire derma and a hypodermic fatty layer. What is the most likely diagnosis?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Limphoma of skin"},{"label":"B","text":"Systemic lupus erythematosus"},{"label":"C","text":"Mycosis fungoi‘des"},{"label":"D","text":"Intradermal nevus E."}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7959da016876","stem":"A patient has a cluster of matted together dense lymph nodes on his neck. His- tological examination of a removed lymph node revealed proliferation of reticular cells, presense of Reed-Sternberg cells. What disease is meant?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Lymphogranulomatosis"},{"label":"B","text":"Myeloblastic leukosis"},{"label":"C","text":"Lymphoblastic leukosis"},{"label":"D","text":"Myelocytic leukosis"},{"label":"E","text":"Lymphocytic leukosis 92"}],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["option_whitespace_normalization"]},{"id":"q-b1ef20334fc7","stem":"Microscopical examination of an enlarged cervical lymph node revealed blur- ring of its structure, absence of lymphoid follicles; all the microscopic fields showed cells with roundish nuclei and thin limbus of basophil cytoplasm. It is known from the clinical data that other groups of lymph nodes are also enlarged as well as spleen and liver. What disease might be suspected?","type":"Single Best Answer MCQ","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"*Lymphoid leukosis"},{"label":"B","text":"Myeloid leukosis"},{"label":"C","text":"Lymphosarcoma"},{"label":"D","text":"Multiple myeloma"},{"label":"E","text":"Lymphogranulomatosis 93"}],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-19d26bb76464","stem":"when<00:00:33.780><c> I<\/c><00:00:33.809><c> say<\/c><00:00:34.020><c> small<\/c><00:00:34.079><c> samples<\/c><00:00:34.649><c> I<\/c><00:00:34.739><c> mean<\/c><00:00:34.950><c> less<\/c>","type":"Short Answer","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a02e3b89cac0","stem":"when I say small samples I mean less","type":"Short Answer","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8e497899b1f0","stem":"what<00:01:24.270><c> column<\/c><00:01:24.689><c> do<\/c><00:01:24.810><c> you<\/c><00:01:24.900><c> stop<\/c><00:01:25.290><c> at<\/c><00:01:25.560><c> it<\/c><00:01:26.070><c> basically<\/c>","type":"Short Answer","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-073ac823cad3","stem":"what column do you stop at it basically","type":"Short Answer","subject":"Biostatistics and Research","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Biostatistics and Research","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-793f2fbcc79a","stem":"A 52-year-old woman has noted a lump in her breast for the past 2 months. On physical examiantion there is a firm 2 to 3 cm mass palpable in the upper outer quadrant of the right breast. There are no palpable axillary nodes. A lumpectomy with axillary node dissection is performed. The breast lesion is found to have positive immunohistochemical staining for HER2/neu (c-erb B2). Staining for estrogen and progesterone receptors is negative. Which of the following additional treatment options is most likely to be efficacious in this woman?","type":"Short Answer","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-a37d0285aefd","stem":"A 47-year-old woman undergoes routine mammographic screening and has an abnormal mammogram with multiple small areas of increased density, though a single distinctive mass lesion is not detectable either by palpation or by mammography. A fine needle aspiration biopsy of a suspicious area reveals cells suspicious for a malignancy. An excisional breast biopsy yields a diagnosis of lobular carcinoma in situ of the breast. Which of the following is the most likely finding associated with this woman's carcinoma?","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d0df5e719bf5","stem":"A 15-year-old healthy girl of normal height and weight for age is concerned because her right breast has developed to twice the size of her left breast since the onset of puberty at age 12. On physical examination both breasts have a similar consistency on palpation, and there is no tenderness. The nipples and areolae appear normally formed. Which of the following is the most likely cause for these findings?","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1601a2efe844","stem":"A 20-year-old woman notes a mass in her right breast after following the directions for breast self-examination provided by her health clinic. Her physician palpates a firm, 1 to 2 cm mass. There is no nipple discharge and no pain. No axillary adenopathy is present. The overlying skin of the breast appears normal. Her right breast is slightly larger than the left, a condition she says has been present since puberty. Her urine pregnancy test is negative. Mammography confirms the presence of an rounded density, which has no microcalcifications, and reveals no lesions of the opposite breast. Which of the following is the most likely diagnosis?","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-7f1e90345d51","stem":"A 19-year-old woman gave birth to a healty male infant at term following an uncomplicated pregnancy. She has now been breast feeding the baby for a month, but notes that her left breast has gradually become swollen and painful to touch over the past week. On physical examination her temperature is 38.2 C. Which of the following is the most likely diagnosis?","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-e063a79cd710","stem":"A 35-year-old woman has noted a palpably firm, irregular mass in her right breast for the past 3 months. On physical examination there is no tenderness or swelling. By mammography there is an irregular 2 cm density that demonstrates scattered microcalcifications. Biopsy of this mass reveals extensive fat necrosis. Which of the following is the most likely cause for this breast lesion?","type":"Short Answer","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-fa1577b7d027","stem":"A 29-year-old woman has been taking oral contraceptives for the past 12 years. She now has a palpable \"lump\" in the left breast that has persisted for the past 3 months. Which of the following breast lesions is most likely to be associated with her oral contraceptive use?","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-cbf54cae85d9","stem":"A 49-year-old woman notes increasing size to her right breast over the past year. This breast is not painful, but the heaviness causes some discomfort. On physical examination the overlying skin and nipple appear normal. There is no nipple discharge. There is no axillary lymphadenopathy. Mammography reveals a solid 12-cm circumscribed mass. The mass is biopsied, and on microscopic examination shows a cellular stromal component along with an epithelial component. Which of the following is the most likely diagnosis?","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-68bad99cd740","stem":"A 46-year-old woman has a silicone breast implant placed following a right mastectomy for treatment of an infiltrating ductal carcinoma a year ago. She is advised of potential complications, including leakage of the silicone breast implant. Which of the following is most likely to be caused by breast implant leakage?","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d3bd94b0a51b","stem":"A 52-year-old woman feels a lump in her right breast on self-examination and goes to her physician. On physical examination the 4 cm mass is not freely movable and feels quite hard. A fine needle aspirate is performed and cytologic examination shows cells are present consistent with carcinoma. Which of the following features of this carcinoma is most likely to suggest a worse prognosis?","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-3d388e681c17","stem":"A 45-year-old woman feels a \"lump\" in her left breast. Her physician palpates a 2 cm irregular area in the upper outer quadrant. A biopsy is performed and microscopic examination shows no evidence for carcinoma. Which of the following microscopic findings in this biopsy is most likely to suggest an increased risk for subsequent development of breast carcinoma?","type":"Short Answer","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-08801f76fec8","stem":"A 20-year-old woman give birth to a term girl infant following an uncomplicated pregnancy. She breast feeds the infant. Six weeks later, her left breast becomes painful and slightly swollen. On physical examination there is a tender 3-cm mass in the left breast beneath a nipple that shows several painful fissures. Which of the following pathologic findings is most likely to be present in this breast?","type":"Short Answer","subject":"Pediatrics and Child Health","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Pediatrics and Child Health","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d21ecd17b700","stem":"A 25-year-old woman palpates a left breast \"lump\" on self-examination. Her physician palpates an ill-defined mass. There is no pain or tenderness. No axillary lymphadenopathy is noted. Fine needle aspiration is performed and cytologic examination shows cells that appear benign. The lesion persists, and 6 months later another biopsy is taken and shows ductal epithelial proliferation with ductal apocrine metaplasia, stromal fibrosis, and sclerosing adenosis. Which of the following is the most likely diagnosis?","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-8d79da250aff","stem":"A 39-year-old woman has noted red, scaling area on her breast for 3 months. On physical examination there is an eczematous 1 cm diameter area on the skin of the right breast areola. There is no palpable lump in this breast. Biopsy of the skin lesion is performed and on microscopic examination shows large cells at the dermal-epidermal junction that stain positively for mucin. Which of the following is the most likely diagnosis?","type":"Short Answer","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-466f95fc86b6","stem":"A 39-year-old woman has noted a bloody nipple discharge from the right breast for the past 5 week. On physical examination there is no palpable mass or tenderness. The skin of this breast shows no lesions. A small amount of bloody fluid can be expressed from the right nipple. Which of the following is the most likely diagnosis?","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-60f3589fc0f4","stem":"A 61-year-old woman has noted a rough, reddened appearance increasing in size over the skin of her right breast for the past 5 months. This persists despite application of a corticosteroid cream. On physical examination the skin over the right breast is indurated, roughened, and reddish-orange. There is nipple retraction. A firm, irregular 5 cm mass is palpable in this breast. Which of the following is the most likely risk factor for this woman's condition?","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-b1417f4f0a03","stem":"A 41-year-old woman has felt a large breast lump that has increased slowly in size for the past 3 years. On physical examination there is a 9 cm firm, movable mass present in her left breast. The overlying skin appears normal; there is no axillary lymphadenopathy. The mass is exccised and grossly appears soft and fleshy. On microscopic examination this mass has a lymphoid stroma with little fibrosis surrounding sheets of large vesicular cells with frequent mitoses. Which of the following is the most likely diagnosis?","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-1aa126b2c1d4","stem":"A clinical study is peformed involving subjects who are women ranging in age from 15 to 45 years who palpated breast \"lumps\" on self-examination. The presence of breast mass lesions in these subjects was subsequently confirmed by physical examination and by mammography. All subjects had a biopsy or excision of their lesion performed, with a definitive pathologic diagnosis made. Which of the following diagnoses is likely to be the most frequent in these subjects?","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-418008aa3bbe","stem":"A pathologic study is made of phyllodes tumor and fibroadenoma in the breast. The demographic findings in the patients, the mammographic findings, and the gross and microscopic pathologic appearances are analyzed. Which of the following features is most likely to have a greater frequency in the phyllodes tumor than the fibroadenoma?","type":"Clinical Vignette","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-501100d627dd","stem":"A 30-year-old woman has felt a mass in her right breast for 6 months. On physical examination there is a 5 cm right breast mass and firm, non-tender lymphadenopathy. A fine needle aspiration is performed and cytologic examination shows carcinoma cells. A right mastectomy with axillary lymph node dissection is performed. Microscopic examination shows a poorly differentiated carcinoma that is negative for estrogen and progesterone receptors, but is positive for HER2/neu. One axillary lymph node demonstrates micrometastases. Her 32 year old sister is found to have a similar lesion. Which of the following is the most likely risk factor for this woman's breast cancer?","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-c894df66eef0","stem":"A 45-year-old woman has noted a mass in her right breast for 7 months. On physical examination there is a 5 cm diameter right breast mass. A biopsy of the mass is performed and on microscopic examination a carcinoma is present. Which of the following pathologic findings suggests a better prognosis for this woman?","type":"Short Answer","subject":"Histology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Histology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-30488a37533c","stem":"A 51-year-old healthy man has noted bilaterally enlarged breasts for the past 35 years. On physical examination his breasts are enlarged to 3 times normal size, with no masses present, no tenderness, and no axillary lymphadenopathy. Which of the following conditions is most likely to cause his breast enlargement?","type":"Short Answer","subject":"ENT","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"ENT","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":[]},{"id":"q-d65c2a12efdc","stem":"Which of the following patients is most likely to have a breast lesion consisting of a solitary well-circumscribed 1 cm firm nodule palpated in the lower outer quadrant on physical examination","type":"Clinical Vignette","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-356d26eafb1d","stem":"A 49-year-old woman goes to her physician for a routine health maintenance examination. A screening mammogram is performed and shows a 3 cm area in her left breast that has microcalcifications and irregular densities. A needle biopsy of this area shows ducts containing solid sheets of malignant cells, with central necrosis and calcification. There is no invasion. A lumpectomy with wide excision to clear margins is performed along with axillary lymph node sampling that shows no metastases. Immunohistochemical staining of the tumor cells shows them to be estrogen receptor and HER2 (c-erb B2) negative. She receives radiation therapy. Which of the following is the most likely outcome for this woman?","type":"Short Answer","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-1e57a9caf74a","stem":"A 69-year-old woman has a screening mammogram that shows an irregular 1 to 2 cm density in her right breast. She has no axillary lymphadenopathy. A needle biopsy is performed and on microscopic examination shows malignant cells floating in mucinous lakes. The nuclei show minimal pleomorphism and no mitoses are seen. The cells are positive for estrogen receptor and negative for HER2 (c-erb B2). A chest x-ray shows no abnormal findings. A bone scan is negative. What is the most likely designation for grade and stage of this neoplasm?","type":"Radiological Interpretation","subject":"Human Anatomy","topic":"Head and Neck","topicOriginal":"Head and Neck","subtopic":"Ear","suggestedTopic":null,"options":[],"priority":1,"status":"review","flags":["requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Human Anatomy","displayTopic":"Head and Neck","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","visual_asset_not_transcribed"],"cleaningOperations":[]},{"id":"q-59126df9201c","stem":"neoplasms is he most likely to have?","type":"Short Answer","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-effa4b9d611a","stem":"neoplasia in these men?","type":"Short Answer","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-07e2910b9ea6","stem":"organisms is most likely to result in non-ulcerated lesions?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-2c7f23c910da","stem":"conditions is this man most likely to have?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-633ba47d019c","stem":"Which of the following pathologic findings is most likely to be present on prostate biopsy","type":"Short Answer","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"General Pathology","displayTopic":"General and Systemic Pathology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-1428ca6d0492","stem":"following complications is he most likely to develop as a consequence of his disease?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-f52530f1d532","stem":"large nuclei. Which of the following is the most likely diagnosis?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-1995eee97647","stem":"the following lesions is he most likely to develop?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":[]},{"id":"q-4cad8b11d38f","stem":"infectious agents is most likely to produce the condition seen in this subset of subjects?","type":"Short Answer","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[],"priority":1,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Una