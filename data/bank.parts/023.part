_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-e0340b1b0a6f","stem":"The following are true concerning coronary artery anatomy","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Histology and Tissues","topicOriginal":"Histology and Tissues","subtopic":"Artery","suggestedTopic":null,"options":[{"label":"A","text":"blood supply to the sinus node may occasionaly come from the left main coronary artery"},{"label":"B","text":"the left coronary artery arises from the anterior aortic sinus"},{"label":"C","text":"the left main coronary artery is usually 4-5 cm in length"},{"label":"D","text":"the left anterior descending artery supplies the anterior two thirds of the interventricular septum"},{"label":"E","text":"the atrioventricular node is typically supplied by the right coronary artery"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Histology and Tissues","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-4e82f19e95cf","stem":"Recognised features of left atrial myxoma include","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"myalgia"},{"label":"B","text":"loud S1"},{"label":"C","text":"systemic embolism"},{"label":"D","text":"syncope"},{"label":"E","text":"an apical systolic murmur"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-c96405c4f150","stem":"The following are true of mitral valve prolapse","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It is associated with Ehler's-Danlos syndrome."},{"label":"B","text":"The murmur is loudest on sudden standing."},{"label":"C","text":"It is associated with ventricular tachycardia."},{"label":"D","text":"May lead to cerebral embolism in young people."},{"label":"E","text":"Antibiotic prophylaxis is required even in the absence of an audible murmur."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-2ab87453d1a4","stem":"The following are true in acute renal failure in humans","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Nephrology","topicOriginal":"Nephrology","subtopic":"Renal","suggestedTopic":null,"options":[{"label":"A","text":"'renal-dose' dopamine (2 - 5 mcg/kg/min) increases renal blood flow"},{"label":"B","text":"loop diuretics decrease the metabolic requirements of the kidney"},{"label":"C","text":"loop diuretics have been shown to accelerate recovery of glomerular filtration"},{"label":"D","text":"the use of 'renal-dose' dopamine may cause ischaemia of the gut"},{"label":"E","text":"changing oliguric renal failure to polyuric renal failure by the use of diuretics has been shown to have a survival benefit"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Nephrology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-b0816abdd3cb","stem":"A lesion of the sciatic nerve causes","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Lower Limb · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Lower Limb","options":[{"label":"A","text":"loss of sensation along the medial border of the foot"},{"label":"B","text":"loss of ankle jerk"},{"label":"C","text":"loss of knee jerk"},{"label":"D","text":"diminished power of knee flexion"},{"label":"E","text":"an inability to stand on the heels of the affected foot"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Lower Limb · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-0bd23998612d","stem":"The carotid body chemoreceptors are","type":"Single Best Answer MCQ","subject":"Pharmacology","topic":"General Pharmacology","topicOriginal":"General Pharmacology","subtopic":"Receptor","suggestedTopic":null,"options":[{"label":"A","text":"stimulated by a decrease in pO2 of arterial blood"},{"label":"B","text":"stimulation leads to bradycardia"},{"label":"C","text":"stimulated in a hypotensive subject at rest"},{"label":"D","text":"responsible for production of reflex peripheral vasoconstiction"},{"label":"E","text":"have a 