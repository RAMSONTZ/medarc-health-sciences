ic physique"},{"label":"E","text":"early age of onset"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Psychiatry","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-2eceae4f711d","stem":"The following conditions usually occur after puberty","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"anorexia nervosa"},{"label":"B","text":"schizophrenia"},{"label":"C","text":"infantile autism"},{"label":"D","text":"school refusal"},{"label":"E","text":"elective mutism"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-1dd4af0dedb4","stem":"There is a recognised association between cataract and","type":"Single Best Answer MCQ","subject":"Ophthalmology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"dystrophia myotonica"},{"label":"B","text":"scleroderma"},{"label":"C","text":"galactosaemia"},{"label":"D","text":"Down's syndrome"},{"label":"E","text":"Hurler's syndrome"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"O