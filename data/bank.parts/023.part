itology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-de45357d731f","stem":"All of the following are true about Trichomonas vaginals except","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It reproduces by longitudinal binary fission"},{"label":"B","text":"It succumbs to a temperature above 40C"},{"label":"C","text":"It causes erosion of the vaginal epithelium"},{"label":"D","text":"Most males are asymptomatic"},{"label":"E","text":"Exit as a trophozoite only"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-7e85ba5f853e","stem":"Diagnosis of Trichomonas vaginalis can be made by examination of","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Urine"},{"label":"B","text":"Prostatic secretions"},{"label":"C","text":"Fresh vaginal discharge"},{"label":"D","text":"All of the above"},{"label":"E","text":"None of the above"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-55a7c79bb866","stem":"All of the following are true about Balandidium coli except","type":"Singl