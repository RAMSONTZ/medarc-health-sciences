"},{"label":"B","text":"directly involves the aortic cusps by the inflammatory process"},{"label":"C","text":"commonly produces syphilitic myocarditis histologically"},{"label":"D","text":"producing angina, often responds less effectively to nitrates"},{"label":"E","text":"may produce left ventricular aneurysm"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-b0938c14282d","stem":"The median nerve supplies","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Upper Limb · Suggested","topicOriginal":"General","subtopic":"","suggestedTopic":"Upper Limb","options":[{"label":"A","text":"the lateral two interossei"},{"label":"B","text":"half flexor digitorum profundus"},{"label":"C","text":"abductor pollicis longus"},{"label":"D","text":"medial lumbricals"},{"label":"E","text":"flexor pollicis brevis"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Upper Limb · Suggested","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-4b756d94392f","stem":"The following are true","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"carbimazole is teratogenic and must be avoided in pregna