eaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-1ced92cd6a04","stem":"A long corrected QT interval in the ECG","type":"ECG Interpretation","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"is a recognised consequence of hypokalaemia"},{"label":"B","text":"may be due to amiodarone"},{"label":"C","text":"is seen in Jervell-Lang-Nielson syndrome"},{"label":"D","text":"is a recognised consequence of rheumatic carditis"},{"label":"E","text":"is a recognised consequence of hypercalcaemia"}],"priority":0,"status":"review","flags":["subject_unclassified","topic_generic","requires_visual_review"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":true,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["prior_structural_review_flag","requires_visual_review","subject_needs_classification","subject_unclassified","topic_generic","visual_asset_not_transcribed"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-69e57247529e","stem":"Acute idiopathic pericarditis","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"is caused by a virus in about 90% of cases"},{"label":"B","text":"is usually sporadic"},{"label":"C","text":"is associated with encephalitis"},{"label":"D","text":"often follows a relapsing course"},{"label":"E","text":"is associated with an increased incidence of ventricular dysrhythmias"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"U