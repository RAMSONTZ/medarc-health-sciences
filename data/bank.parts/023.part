d"},{"label":"C","text":"the spleen is frequently enlarged"},{"label":"D","text":"symptoms of anaemia are usually limiting when Hb = 8g/dl"},{"label":"E","text":"a painful shoulder joint will respond to intra-articular corticosteroid injection"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"],"duplicateStemGroup":"e793c08d5df0d9539824a0ff00675ab12a33ba84"},{"id":"q-ed1d161c7bad","stem":"Diabetes insipidus","type":"Single Best Answer MCQ","subject":"Internal Medicine","topic":"Endocrinology","topicOriginal":"Endocrinology","subtopic":"Diabet","suggestedTopic":null,"options":[{"label":"A","text":"only occurs in the presence of diabetes mellitus but not vice-versa"},{"label":"B","text":"may occur transiently following intracranial surgery, especially pituitary resection"},{"label":"C","text":"of cranial origin is inherited in a sex linked recessive manner"},{"label":"D","text":"water deprivation test can be used to distinguish between cranial and nephrogenic diabetes insipidus"},{"label":"E","text":"nephrogenic diabetes insipidus can be treated with high dose desmopressin"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Endocrinology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-cd682da95162","stem":"Features of water intoxicatio