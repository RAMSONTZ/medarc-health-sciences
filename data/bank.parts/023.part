ral","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"isolated systolic hypertension is commoner in men"},{"label":"B","text":"cough caused by ACE inhibitors is commoner in women"},{"label":"C","text":"women are likely to live longer than men from the date of onset of angina"},{"label":"D","text":"prevalence of coronary artery disease in women with chest pain is less than in men with chest pain"},{"label":"E","text":"women presenting with coronary artery disease tend to have more severe disease"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-9d52a278fbef","stem":"Campylobacter jejuni","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"attack rates are highest in the elderly"},{"label":"B","text":"infections are treated with ciprofloxacin"},{"label":"C","text":"is a recognised pathogen in domestic animals"},{"label":"D","text":"is readily isolated in stool culture"},{"label":"E","text":"causes colitis"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/