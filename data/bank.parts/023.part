ags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Internal Medicine","displayTopic":"Cardiology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem"],"cleaningOperations":["source answer/boilerplate removed from option E"],"duplicateStemGroup":"ce8e3a5db231b03117e5138bdc1f519ceb6dcf70"},{"id":"q-03a943bc09b5","stem":"Thiazide diuretics","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"act on the loop of Henle distal to the major site of sodium reabsorption"},{"label":"B","text":"cause hypokalaemia by blocking the sodium-potassium exchange site in the distal tubule"},{"label":"C","text":"increase the renal excretion of calcium"},{"label":"D","text":"increase the renal excretion of magnesium"},{"label":"E","text":"elevate LDL cholesterol in long-term use"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"],"duplicateStemGroup":"3063f356560d6619bc519b80e37173c8189ebbe1"},{"id":"q-746d9c6882da","stem":"Causes of renal papillary necrosis include","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General Pathology","topicOriginal":"General Pathology","subtopic":"Cell Injury and Inflammation","suggestedTopic":null,"options":[{"label":"A","text":"Sickle cell disease"},{"label":"B","text":"salicylate therapy"},{"label":"