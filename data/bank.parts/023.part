ation of cartilage"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Radiography and Medical Imaging","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["repeated_question_stem","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"],"duplicateStemGroup":"b40ac0d58d8e4a9bb725d6c55e9534c67497bad7"},{"id":"q-a2447c559a19","stem":"Pseudohypoparathyroidism is characterised by","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"low serum calcium, high phosphate and normal alkaline phosphatase"},{"label":"B","text":"low serum PTH levels"},{"label":"C","text":"shortening of the 4th and 5th metacarpals"},{"label":"D","text":"ectopic calcification"},{"label":"E","text":"normal serum calcium and phosphate"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-67ece8af1d1f","stem":"Multiple endocrine neoplasia type II consists of","type":"Single Best Answer MCQ","subject":"General Pathology","topic":"General and Systemic Pathology","topicOriginal":"General and Systemic Pathology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"phaeochromocytoma"},{"label":"B","text":"pituitary tumour"},{"label":"C","text":"medullary carcinoma of the thyroid