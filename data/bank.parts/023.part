amoeba coli"},{"label":"C","text":"Entamoeba hatmanii"},{"label":"D","text":"Lodamoeba butschlii"},{"label":"E","text":"All of the above"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-28ca4fa1e6e3","stem":"The following are characteristic features of Amoebic dysentery except","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Non prodomal features"},{"label":"B","text":"Patient is usually ambulant"},{"label":"C","text":"Low abdominal cramps"},{"label":"D","text":"Stool is with fishy odour"},{"label":"E","text":"Severe vomiting"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-2b62c3e3daa1","stem":"Choose one statement that is untrue for amoebic liver absess","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Medical Parasitology","topicOriginal":"Medical Parasitology","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Pain and tenderness over the liver"},{"label":"B","text":"Fever"},{"label":"C","text":"Aspiration will show trophozoites & cysts"},{"label":"D","text":"Hepatomegaly"},{"label":"E","text":"Raised ESR"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"