","text":"Phylum, Class order. Family Genus, species"},{"label":"E","text":"None of the above"}],"priority":0,"status":"review","flags":["duplicate_option_text"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Medical Parasitology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["duplicate_option_text","nonunique_option_text","prior_structural_review_flag"],"cleaningOperations":[]},{"id":"q-f00ffabda3d5","stem":"In the pathogenesis/pathology of Plasmodium falciparum malaria all of the following are true except","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Protozoology","topicOriginal":"Protozoology","subtopic":"Malaria","suggestedTopic":null,"options":[{"label":"A","text":"Agglutination of RBCs"},{"label":"B","text":"Metabolism of the haemoglobin"},{"label":"C","text":"Hyposplenism of the haemoglobin"},{"label":"D","text":"Haemolysis of RBCs"},{"label":"E","text":"Jaundice"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Protozoology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":[]},{"id":"q-dcae769da0bd","stem":"In human malaria, the female Anopheles is","type":"Single Best Answer MCQ","subject":"Parasitology","topic":"Protozoology","topicOriginal":"Protozoology","subtopic":"Malaria","suggestedTopic":null,"options":[{"label":"A","text":"Mechanical host"},{"label":"B","text":"Transport host"},{"label":"C","text":"Compromised host"},{"label":"D","text":"Definitive host"},{"label":"E","text":"Intermediate host"}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Parasitology","displayTopic":"Protozoology","answerAuditStatus":"