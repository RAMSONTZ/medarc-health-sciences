xt":"increased cardiac contractility"},{"label":"B","text":"increased speed of conduction through the AV node"},{"label":"C","text":"increased tone in the systemic arterial system"},{"label":"D","text":"increased renin secretion"},{"label":"E","text":"increased tone of bronchial muscle"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-8da583ef8fe9","stem":"The facial nerve","type":"Single Best Answer MCQ","subject":"Human Anatomy","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"carries preganglionic parasympathetic fibres to the submandibular gland"},{"label":"B","text":"the nucleus receives fibres from both cerebral cortices"},{"label":"C","text":"supplies taste sensation to the posterior 1/3 of the tongue"},{"label":"D","text":"supplies motor fibres to the stapedius muscle"},{"label":"E","text":"supplies touch sensation to the external auditory meatus"}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Human Anatomy","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-c265fd1bd934","stem":"In congenital adrenal hyperplasia caused by 21-hydroxylase deficiency the following are seen in increased amounts in the serum","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"17 alpha hydroxyprogesterone"},{"label":"B","text":"cortisol"},{"label":"C","text":"aldosterone"},{"label":"D","text":"11-deoxy corticosterone"},{"label":"E","text":"ACTH"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-d74a9c48a844","stem":"Are the following true or false?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Chlamydia are obligate intracellular parasites."},{"label":"B","text":"Bacteria replicate by binary fusion."},{"label":"C","text":"Mycoplasmas possess a peptidoglycan cell wall."},{"label":"D","text":"Pseudomonads are Gram negative."},{"label":"E","text":"Bacteria of medical importance are only transmitted by direct contact between humans."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"],"duplicateStemGroup":"ad3da8ad1b42f9b5b8433cb6b0958580f182f4a5"},{"id":"q-94770b713d19","stem":"MHC class I molecules","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Are encoded by the genes HLA-A, -B and -C in humans."},{"label":"B","text":"Are a heterodimer of two MHC-encoded polypeptide chains termed alpha and beta."},{"label":"C","text":"Present short peptides derived from cytosolic proteins."},{"label":"D","text":"Present antigen to helper T lymphocytes."},{"label":"E","text":"Are involved in the recognition and rejection of allografts."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-86163abd3fca","stem":"In the T cell response to antigen","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"A process of affinity maturation of the T cell receptor occurs."},{"label":"B","text":"Intact antigen is presented in association with self MHC molecules."},{"label":"C","text":"Co-operation with other cell types is required for T cell recognition of antigen."},{"label":"D","text":"gamma/delta + T cells respond to antigen presented in association with MHC class II molecules."},{"label":"E","text":"Interactions of the TcR with an appropriate Ag/MHC complex activates a resting T cell."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-bde54d573546","stem":"Which of the following are involved in the pathway of antigen processing for presentation of antigen by MHC class II?","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Proteosome."},{"label":"B","text":"Invariant chain."},{"label":"C","text":"Peptide transporters (TAP)."},{"label":"D","text":"Exogenous protein antigen."},{"label":"E","text":"beta 2-microglobulin."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-efdb020ee106","stem":"T cells recognise antigen","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"By TcR interaction with antigen in the extracellular fluid."},{"label":"B","text":"As conformational epitope at the cell surface."},{"label":"C","text":"As linear peptide sequences bound covalently to self MHC class I or class II at the cell surface."},{"label":"D","text":"Derived from protein, carbohydrate or lipid molecules."},{"label":"E","text":"Only when presented by \"professional\" antigen presenting cells."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-9c3152cfed98","stem":"For antigen presentation to CD4+ T lymphocytes","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Antigen is processed via the endogenous pathway"},{"label":"B","text":"Specialised antigen presenting cells are required for the induction of the T cell immune response"},{"label":"C","text":"Short antigen-derived peptides associate with MHC class II molecules in the endoplasmic reticulum"},{"label":"D","text":"Exogenously added synthetic peptide corresponding to the antigenic epitope can substitute for processed antigen for T cell recognition."},{"label":"E","text":"The antigen must be synthesised within the antigen presenting cell in order to be processed and presented by MHC."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-f376567badf8","stem":"In the thymus","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The majority of cortical thymocytes express either CD4 or CD8."},{"label":"B","text":"CD4/CD8 double positive cells are eliminated by a process of negative selection."},{"label":"C","text":"A proportion of alpha/beta+ thymocytes undergo isotype switching to produce gamma/delta+ T cells."},{"label":"D","text":"Thymocytes whose TcR bind with high affinity to self Ag/MHC complexes are clonally detected."},{"label":"E","text":"Mature thymocytes express surface IgM and IgD."}],"priority":0,"status":"practice_draft","flags":["short_or_incomplete_stem","subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["short_or_incomplete_stem","short_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-6b66bb32b4d4","stem":"Match up the following into the most appropriate pairs","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"CD8+ lymphocyte : Cytotoxic T cell"},{"label":"B","text":"CD4+ lymphocyte : B cell"},{"label":"C","text":"surface Ig+ lymphocyte : B cell"},{"label":"D","text":"alpha/beta+ lymphocyte : Major T cell population"},{"label":"E","text":"gamma/delta+ lymphocyte : Helper T cell"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-72b9bbcf6765","stem":"Self tolerance is achieved by","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Clonal deletion of potentially autoreactive T cells during thymic development."},{"label":"B","text":"Suppression or anergy of autoreactive T cells in the periphery."},{"label":"C","text":"Absence of germ line T cell receptor genes which recognise self antigens."},{"label":"D","text":"Presence of cytotoxic T cells in the thymus which recognise and kill potentially autoreactive T cells."},{"label":"E","text":"Somatic mutation of potentially autoreactive T cell receptors in the thymus."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-31d5717fc11f","stem":"CD4+ T cells","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Are cytotoxic for virally infected cells."},{"label":"B","text":"Are restricted in antigen recognition by MHC class II molecules."},{"label":"C","text":"Release cytokines in response to antigen stimulation."},{"label":"D","text":"Are a major target cell for infection with HIV."},{"label":"E","text":"Are involved in delayed type hypersensitivity."}],"priority":0,"status":"practice_draft","flags":["short_or_incomplete_stem","subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["short_or_incomplete_stem","short_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-6c7266a14701","stem":"In the immune response to extracellular bacteria","type":"Single Best Answer MCQ","subject":"Microbiology","topic":"Bacteriology","topicOriginal":"Bacteriology","subtopic":"Bacterial Pathogens","suggestedTopic":null,"options":[{"label":"A","text":"Antigen specific cytotoxic T lymphocytes play a major role."},{"label":"B","text":"T cell help is involved in the induction of high affinity antibodies."},{"label":"C","text":"Helper T cells release cytokines in response to antigen stimulation."},{"label":"D","text":"T cell recognition of bacterial antigens is independent of MHC molecules."},{"label":"E","text":"Antigen specific T and B cells need to recognise the same epitopes on bacterial antigens for effective help to occur."}],"priority":0,"status":"practice_draft","flags":[],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Microbiology","displayTopic":"Bacteriology","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":[],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-4b944e764b65","stem":"The following are compatible with a diagnosis of auto-immunity","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Pernicious anaemia."},{"label":"B","text":"Delayed type hypersensitivity in tuberculosis."},{"label":"C","text":"Juvenile onset diabetes mellitus."},{"label":"D","text":"Maturity onset diabetes mellitus."},{"label":"E","text":"Thyroid antibodies in a healthy person."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-d4bea52abea0","stem":"Self tolerance","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Is established in the bone marrow during foetal life."},{"label":"B","text":"Does not involve exposure to self MHC."},{"label":"C","text":"Can be broken as a consequence of cytokine release by T lymphocytes."},{"label":"D","text":"Is broken in allergic asthma."},{"label":"E","text":"Is broken in SLE."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["short_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-162a74cc63ee","stem":"In rheumatoid arthritis","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"We have an example of an organ specific disease."},{"label":"B","text":"Joint damage is the consequence of mast cell degranulation."},{"label":"C","text":"It is likely that joint specific antigens have been sequestered during the time when immunological tolerance was"},{"label":"D","text":"Rheumatoid factor is detected by a test utilising the patients B lymphocytes."},{"label":"E","text":"Rheumatoid factor is an antibody with reactivity to the heavy chain of IgG."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-d22b0e3e330e","stem":"Severe combined immunodeficiency","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"is an X-linked hereditary immunodeficiency."},{"label":"B","text":"is associated with low levels of serum complement factors."},{"label":"C","text":"results from a failure of the 3rd and 4th pharyngeal pouches to form fully."},{"label":"D","text":"involves defects of both humoral and cell mediated immunity."},{"label":"E","text":"is best treated by bone marrow transplantation."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-00717388c209","stem":"Chronic granulomatous disease","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"affects B cells, T cells and macrophages."},{"label":"B","text":"rarely presents before adulthood."},{"label":"C","text":"affects male more than females."},{"label":"D","text":"is characterised by a lack of intracellular killing of phagocytosed bacteria."},{"label":"E","text":"is usually accompanied by polymorphonuclear leukocytosis."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-96cb980847d6","stem":"Defective T cell function is characteristic of","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"X-linked agammaglobulinaemia"},{"label":"B","text":"di George syndrome"},{"label":"C","text":"severe combined immunodeficiency"},{"label":"D","text":"infection with HIV"},{"label":"E","text":"sarcoidosis"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-d9b59e2c8483","stem":"Which of the following statements are true","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"HIV infection is associated with selective depletion of CD4+ T cells."},{"label":"B","text":"IgA deficiency should be treated by immunoglobulin replacement therapy."},{"label":"C","text":"X-linked agammaglobulinaemia is commoner in girls than boys."},{"label":"D","text":"intravenous immunoglobulin therapy is effective in T cell immunodeficiencies."},{"label":"E","text":"primary immunodeficiencies are more common than secondary immunodeficiencies."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"],"duplicateStemGroup":"6bf9ead4ae2bf3e9e3630756a8163f216bc34034"},{"id":"q-84ee1b9165a9","stem":"In complement deficiencies","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"hereditary angioedema is caused by acongenital deficiency of the C1 inhibitor."},{"label":"B","text":"deficiencies of the 3rd complement component (C3) are associated with recurrent viral infections."},{"label":"C","text":"deficiencies of the late complement components (C5-C9) are associated with recurrent infections with gonococci or meningococci."},{"label":"D","text":"in patients with C1, C4 or C2 deficiency, IgM and IgG antibodies bound to micro-organisms can activate the alternative pathway, and so compensate for the defect."},{"label":"E","text":"properdin deficiency is commoner in males than females."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-bcb27afb2354","stem":"Are the following true or false?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cryptococcus neoformans is found in pigeon droppings."},{"label":"B","text":"Candida albicans is the only species of Candida that can be found in the female genital tract."},{"label":"C","text":"Ergot poisoning is caused by a fungus."},{"label":"D","text":"Sporotrichosis is an occupational hazard of gardeners."},{"label":"E","text":"Candidal infections are more common in diabetic patients."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"],"duplicateStemGroup":"ad3da8ad1b42f9b5b8433cb6b0958580f182f4a5"},{"id":"q-232216dd4ed5","stem":"Clonal selection in the immune response implies that","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"An individual lymphocyte has the ability to recognize a wide range of antigenic determinants."},{"label":"B","text":"Molecules bearing a single antigenic determinant can be recognised by lymphocytes bearing different receptors."},{"label":"C","text":"The structure (shape) of the antigen receptor on the cell is determined by the structure of the antigen."},{"label":"D","text":"Binding of the antigenic determinant to the receptor at the cell surface stimulates the cell to divide."},{"label":"E","text":"Proliferation is accompanied by differentiation into effector cells (such as plasma cells secreting antibody)."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-82321b459d93","stem":"The Fc portion of an immunoglobulin molecule","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"May facilitate phagocytosis of bacteria."},{"label":"B","text":"If of IgE class will bind to a receptor present on mast cells."},{"label":"C","text":"May be involved in complement activation."},{"label":"D","text":"Is responsible for binding to antigens for which the whole molecule has specificity."},{"label":"E","text":"Is one of the fragments produced when the whole immunoglobulin molecule is digested by papain."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-7524ce74ead6","stem":"Concerning IgG","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It has a molecular weight of 50,000 kd."},{"label":"B","text":"It is monovalent."},{"label":"C","text":"It comprises the majority of circulating antibody in serum."},{"label":"D","text":"It differs from other isotypes in not being able to cross the placental barrier."},{"label":"E","text":"It is the major antibody produced during the primary response."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["short_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-df540ca23c62","stem":"Which of the following prevent microbial invasion of body surfaces?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Mucus secretion."},{"label":"B","text":"Polymorphonuclear leukocytes."},{"label":"C","text":"Epithelial integrity."},{"label":"D","text":"Mucociliary clearance."},{"label":"E","text":"Urine flow."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-83e06a320ac4","stem":"Which of the following predispose to microbial invasion?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Urinary obstruction."},{"label":"B","text":"Ciliary dyskinesia."},{"label":"C","text":"Cystic fibrosis."},{"label":"D","text":"Skin ulceration."},{"label":"E","text":"Neutrophil deficiency."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-140a3a59c26d","stem":"Which of the following are characteristics of innate immunity?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Efficiency increases on subsequent exposure to the same organism."},{"label":"B","text":"Involves lymphocytes."},{"label":"C","text":"Is present from birth."},{"label":"D","text":"Includes opsonisation."},{"label":"E","text":"May involve the acute inflammatory response."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-7b402e3f4235","stem":"Regarding acquired (adaptive) immunity, which are the following are true?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Immunological recognition is an important component."},{"label":"B","text":"Antibody is produced by T cells."},{"label":"C","text":"Recognition of antigen by B cells is mediated by antibody."},{"label":"D","text":"Antibodies produced in response to infection recognise more than one epitope on the surface of the invading micro- organisms."},{"label":"E","text":"Elimination of intracellular micro-organisms is dependent on antibody."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-820ef18e91d3","stem":"Which of the following features of the immune system is present at birth?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Cell-mediated immunity to micro-organisms."},{"label":"B","text":"Complement."},{"label":"C","text":"Serum immunoglobulin."},{"label":"D","text":"Inflammatory response."},{"label":"E","text":"Neutrophils."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-e2d3d468ebe6","stem":"Within lymph nodes","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"B lymphocytes predominate in the paracortex."},{"label":"B","text":"Primary follicles are aggregates of B cells."},{"label":"C","text":"Secondary follicles develop following antigenic stimulation."},{"label":"D","text":"Lymph flows from the hilum of the node outwards to the marginal sinus."},{"label":"E","text":"The medulla is rich in plasma cells."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-2b240b10c9f8","stem":"Concerning secondary lymphoid follicles","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The cells of the follicle centre are exclusively B cells."},{"label":"B","text":"Immunoblasts are numerous."},{"label":"C","text":"A mantle zone surrounds the follicle centre."},{"label":"D","text":"Centrocytes result from mitotic division of centroblasts."},{"label":"E","text":"Antigen presenting cells are present."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-236e371132ef","stem":"Mucosa associated lymphoid tissue","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Is found exclusively in the GI tract."},{"label":"B","text":"Increases with age in the stomach."},{"label":"C","text":"Consists entirely of B cells."},{"label":"D","text":"Is important in the response to luminal antigen."},{"label":"E","text":"Includes cells which are able to home back to their mucosal site."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-64d17ae5863a","stem":"Lymphocyte recirculation","type":"Single Best Answer MCQ","subject":"Immunology","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Occurs between lymphoid tissues only."},{"label":"B","text":"Depends on adhesion molecule expression by endothelium."},{"label":"C","text":"Involves substances known as addressins."},{"label":"D","text":"Is a feature of T cells and not B cells."},{"label":"E","text":"Cannot occur between the lymph nodes and spleen."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Immunology","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-f55573533cb0","stem":"Are the following true or false?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Chloroquine resistant malaria is only found in Africa."},{"label":"B","text":"Diphyllobothrum latum can grow in excess of 20 feet long."},{"label":"C","text":"Hookworms may cause appendicitis."},{"label":"D","text":"Trichinosis may be acquired from eating poorly cooked hamburgers."},{"label":"E","text":"Entamoeba histolytica cysts are resistant to stomach acid."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"],"duplicateStemGroup":"ad3da8ad1b42f9b5b8433cb6b0958580f182f4a5"},{"id":"q-5fb2caec9ae7","stem":"Are the following true or false?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"All viruses posses nucleic acid"},{"label":"B","text":"Azidothymidine is an inhibitor of viral entry"},{"label":"C","text":"Cytomegalovirus is a herpesvirus"},{"label":"D","text":"Rotaviruses characteristically cause common colds"},{"label":"E","text":"ELISA tests can be used to detect IgM antibody to rubella virus"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["repeated_question_stem","subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"],"duplicateStemGroup":"ad3da8ad1b42f9b5b8433cb6b0958580f182f4a5"},{"id":"q-801b9918949b","stem":"The following endocrine diseases are associated with the stated disorders","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"pancreatic tumour secreting vasoactive intestinal polypeptide: hypokalaemic acidosis"},{"label":"B","text":"hypothyroidism: macrocytic anaemia"},{"label":"C","text":"thyrotoxicosis: hypercalciuria and elevated serum alkaline phosphatase"},{"label":"D","text":"Addison's disease: hypokalaemia"},{"label":"E","text":"glucagonoma: normochromic anaemia and venous thromboembolism"}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-4916da4710be","stem":"Which of the following statements regarding DNA is/are true/false ?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Attached to the 1' position of the sugar ring is one of four bases."},{"label":"B","text":"The bases lie stacked on each other 3.4 A apart."},{"label":"C","text":"During transcription each daughter DNA contains one newly synthesised strand."},{"label":"D","text":"The guanine - cytosine bonds are made of two hydrogen bonds."},{"label":"E","text":"The DNA from a single cell is nearly 2 meters long."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-16ae712d5776","stem":"Which of the following statements regarding meiosis is/are true/false ?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"In meiosis II, whole chromosomes separate."},{"label":"B","text":"In spermatogenesis, meiosis begins at puberty."},{"label":"C","text":"Exchange of paternal and maternal DNA takes place in meiosis II."},{"label":"D","text":"Anaphase lag leads to numerical chromosome aberrations."},{"label":"E","text":"Pairing of X and Y chromosomes in spermatogenesis is end to end."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-3a9fb9a88adf","stem":"Familial Hypercholesterolaemia","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"is produced by a mutation of a dominant gene on the X chromosome."},{"label":"B","text":"may lead to early coronary heart disease."},{"label":"C","text":"never arises as a new mutation in a family."},{"label":"D","text":"in a homozygous state usually leads to a severe form of the disease."},{"label":"E","text":"is not associated with late maternal age."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-a4ededefa3de","stem":"Which of the following statements regarding the Y chromosome is / are, true / false ?","type":"Single Best Answer MCQ","subject":"Medical Genetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"It carries a few loci concerned with metabolism."},{"label":"B","text":"It is the only acrocentric chromosome seen in humans."},{"label":"C","text":"It carries the Testis Determining Factor on its short arms."},{"label":"D","text":"Klinefelter syndrome has two Y chromosomes."},{"label":"E","text":"It may be detected in some phenotypic females."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Genetics","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-73aaf3b0d4fb","stem":"The X chromosome","type":"Single Best Answer MCQ","subject":"Medical Genetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"carries the the gene for sickle cell anaemia."},{"label":"B","text":"of the male can be demonstrated in a buccal smear test."},{"label":"C","text":"is not found in the nuclei of all spermatozoa."},{"label":"D","text":"may show an increased fragility in some conditions."},{"label":"E","text":"carries the gene for the Xg blood group."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Genetics","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-86c86cc59404","stem":"Which of the following statements regarding HLA is/are, true/false ?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The genes for HLA are on chromosome No. 6."},{"label":"B","text":"HLA is a multiple allelic system."},{"label":"C","text":"The inheritance of HLA alleles follow a codominant Mendelian system."},{"label":"D","text":"The HLA proteins are found inside the cell."},{"label":"E","text":"HLA B37 is associated with ankylosing spondylitis."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-a995e2577a1b","stem":"Turner syndrome","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"is seen only in females."},{"label":"B","text":"may have one chromosome as an isochromosome."},{"label":"C","text":"is usually associated with severe mental retardation."},{"label":"D","text":"patients usually present with primary amenorrhoea."},{"label":"E","text":"cannot be detected at birth."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-d73de46aab58","stem":"Which of these statements regarding carriers is / are, true / false ?.","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"In classical haemophilia A, carriers may show clinical features."},{"label":"B","text":"In Duchenne muscular dystrophy, carriers never produces affected males, if the husband is normal."},{"label":"C","text":"In cystic fibrosis a mating between carriers has a 25% risk of producing an affected child."},{"label":"D","text":"Carrier states are seen in achondroplasia."},{"label":"E","text":"Certain carrier states can be detected using DNA studies."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-c2ef8ebfad4c","stem":"Which of the following conditions are chromosome aberrations ?","type":"Single Best Answer MCQ","subject":"Medical Genetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Fragile X syndrome."},{"label":"B","text":"Penylketonuria."},{"label":"C","text":"Cri du chat syndrome."},{"label":"D","text":"Osteogenesis imperfecta."},{"label":"E","text":"Down syndrome."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Genetics","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-a290c6e2c13b","stem":"Which of these statements are true or false ?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"The two pyrimidene bases in RNA are uracil and cytosine."},{"label":"B","text":"The termination codons are the same for both nuclear and mitochondrial DNA."},{"label":"C","text":"The hydrogen bonds in DNA link the bases of the two strands."},{"label":"D","text":"Each human somatic cell contains 23 pairs of autosomes."},{"label":"E","text":"In DNA the fourth carbon in the sugar molecule has the phosphodiester bond."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-fcb8cbf22a7c","stem":"The human X chromosome","type":"Single Best Answer MCQ","subject":"Medical Genetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"has the gene for Duchenne Muscular Dystrophy on its short arm."},{"label":"B","text":"is associated with the Y chromosome side by side during synapse formation in spermatogenesis."},{"label":"C","text":"in the female somatic cell is never completely inactivated."},{"label":"D","text":"is a metacentric chromosome."},{"label":"E","text":"in normal females may be seen as a chromatin body in a buccal smear analysis."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Genetics","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-80d2d1b31215","stem":"In Down syndrome","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the karyotype may be 47,XX, +21."},{"label":"B","text":"mental retardation is a common feature."},{"label":"C","text":"the extra chromosome is due to nondisjunction."},{"label":"D","text":"hypertonia is seen at birth."},{"label":"E","text":"dermatoglyphic studies show a Sydney crease."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-df2f109cb679","stem":"Autosomal dominant inheritance","type":"Single Best Answer MCQ","subject":"Medical Genetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"has surviving affected individuals, in a heterozygous state."},{"label":"B","text":"is the mode of inheritance in multiple neurofibromatosis."},{"label":"C","text":"affects both sexes equally."},{"label":"D","text":"shows a pattern of vertical inheritance in a pedigree."},{"label":"E","text":"always manifests at birth."}],"priority":0,"status":"practice_draft","flags":["topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Medical Genetics","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"unverified_draft","auditFlags":["topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-90faa7acf674","stem":"In X linked mental retardation","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"the X chromosome shows a fragile site at the tip of its short arm."},{"label":"B","text":"males show enlarged testes."},{"label":"C","text":"the patients present with moderate educational subnormality."},{"label":"D","text":"the ears are small and low set."},{"label":"E","text":"there are less females."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-3fc4cde62e42","stem":"Which of the following disorders match the karyotypes ?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Patau syndrome - 47,XX,+13."},{"label":"B","text":"Testicular Feminization syndrome - 46,XY."},{"label":"C","text":"Klinefelter syndrome - 47,XYY."},{"label":"D","text":"Turner syndrome - 45,X."},{"label":"E","text":"Cri du Chat syndrome - 46, XY, Del 4p- ."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-6b02057cec75","stem":"Which of the following statements are true or false ?","type":"Single Best Answer MCQ","subject":"Unclassified Health Sciences","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","suggestedTopic":null,"options":[{"label":"A","text":"Familial hypercholesterolaemia is autosomal dominant."},{"label":"B","text":"Alpha thalassemia is autosomal recessive."},{"label":"C","text":"Adult polycystic kidney disease is autosomal dominant."},{"label":"D","text":"Hurler syndrome is autosomal recessive."},{"label":"E","text":"Sickle cell anaemia is inherited as an autosomal dominant condition."}],"priority":0,"status":"practice_draft","flags":["subject_unclassified","topic_generic"],"keyVerified":false,"hasSourceAnswer":false,"needsFigure":false,"displaySubject":"Unclassified Health Sciences","displayTopic":"Unassigned topic","answerAuditStatus":"not_adjudicated","sourceAnswerTrusted":false,"publicationStatus":"review_required","auditFlags":["subject_needs_classification","subject_unclassified","topic_generic"],"cleaningOperations":["source answer/boilerplate removed from option E"]},{"id":"q-bb3cee2e563f","stem":"Which of the following statements regarding multifactorial inheritance are true or false ?","type":"Single Best Answer MCQ","subject":"Medical Genetics","topic":"Unassigned topic","topicOriginal":"General","subtopic":"","sugges